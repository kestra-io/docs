{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "rules": {
      // oxlint 1.82 stopped exempting `_` on its own, so name the convention.
      "no-unused-vars": [
          "error",
          {
              "argsIgnorePattern": "^_",
              "varsIgnorePattern": "^_",
              "destructuredArrayIgnorePattern": "^_",
          },
      ],
      "no-console": ["error", { "allow": ["warn", "error"] }],
  },
  "env": {
      "builtin": true,
  },
  "overrides": [
      {
          "files": ["scripts/*.mjs", "src/middleware.ts"],
          "rules": {
              "no-console": "off",
          },
      },
      {
          "files": ["src/components/common/animations/*.astro"],
          "rules": {
              "no-unused-expressions": "off",
          },
      },
  ],
}
