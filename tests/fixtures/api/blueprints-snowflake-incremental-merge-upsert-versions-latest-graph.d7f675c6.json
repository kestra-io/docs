n.jdbc.snowflake.Query","description":"Create the persistent staging table once (DDL, outside the transaction).","url":"{{ secret('SNOWFLAKE_URL') }}","username":"{{ secret('SNOWFLAKE_USERNAME') }}","password":"{{ secret('SNOWFLAKE_PASSWORD') }}","sql":"CREATE TRANSIENT TABLE IF NOT EXISTS KESTRA.PUBLIC.CUSTOMERS_STAGING LIKE KESTRA.PUBLIC.CUSTOMERS;"},"relationType":"SEQUENTIAL"},{"uid":"root.merge_upsert","type":"io.kestra.core.models.hierarchies.GraphTask","task":{"id":"merge_upsert","type":"io.kestra.plugin.jdbc.snowflake.Queries","description":"Reset staging, COPY the delta, and MERGE into the target as one DML transaction.","url":"{{ secret('SNOWFLAKE_URL') }}","username":"{{ secret('SNOWFLAKE_USERNAME') }}","password":"{{ secret('SNOWFLAKE_PASSWORD') }}","sql":"DELETE FROM KESTRA.PUBLIC.CUSTOMERS_STAGING;\nCOPY INTO KESTRA.PUBLIC.CUSTOMERS_STAGING\n  FROM @KESTRA.PUBLIC.%CUSTOMERS\n  FILE_FORMAT = (type = csv field_optionally_enclosed_by='\"' skip_header = 1)\n  PATTERN = '.*delta/.*'\n  ON_ERROR = 'abort_statement';\nMERGE INTO KESTRA.PUBLIC.CUSTOMERS AS target\n  USING (\n    SELECT * FROM KESTRA.PUBLIC.CUSTOMERS_STAGING\n    QUALIFY ROW_NUMBER() OVER (PARTITION BY CUSTOMER_ID ORDER BY UPDATED_AT DESC) = 1\n  ) AS source\n  ON target.CUSTOMER_ID = source.CUSTOMER_ID\n  WHEN MATCHED AND source.UPDATED_AT > target.UPDATED_AT THEN UPDATE SET\n    target.EMAIL = source.EMAIL,\n    target.CITY = source.CITY,\n    target.UPDATED_AT = source.UPDATED_AT\n  WHEN NOT MATCHED THEN INSERT (CUSTOMER_ID, EMAIL, CITY, UPDATED_AT)\n    VALUES (source.CUSTOMER_ID, source.EMAIL, source.CITY, source.UPDATED_AT);\n","queryTag":"kestra-incremental-merge-{{ execution.id }}"},"relationType":"SEQUENTIAL"},{"uid":"root.notify","type":"io.kestra.core.models.hierarchies.GraphTask","task":{"id":"notify","type":"io.kestra.plugin.slack.notifications.SlackIncomingWebhook","description":"Confirm the incremental merge completed.","payload":"{\n  \"text\": \"Snowflake incremental merge complete for {{ inputs.stage_file }} (execution {{ execution.id }}).\"\n}\n","url":"{{ secret('SLACK_WEBHOOK_URL') }}"},"relationType":"SEQUENTIAL"},{"uid":"root.alert_on_failure","type":"io.kestra.core.models.hierarchies.GraphTask","branchType":"ERROR","task":{"id":"alert_on_failure","type":"io.kestra.plugin.slack.notifications.SlackIncomingWebhook","description":"Alert Slack if the load or merge fails (the transaction rolls back).","payload":"{\n  \"text\": \"Snowflake incremental merge failed and rolled back (execution {{ execution.id }}).\"\n}\n","url":"{{ secret('SLACK_WEBHOOK_URL') }}"},"relationType":"ERROR"}],"edges":[{"source":"root.ensure_staging","target":"root.merge_upsert","relation":{"relationType":"SEQUENTIAL"}},{"source":"root.alert_on_failure","target":"root.end-43qqbj4Hs4K4xFP6TF779a","relation":{}},{"source":"root.merge_upsert","target":"root.notify","relation":{"relationType":"SEQUENTIAL"}},{"source":"root.stage_upload","target":"root.ensure_staging","relation":{"relationType":"SEQUENTIAL"}},{"source":"root.root-53tBxd37B801mZc0ZJ9m0z","target":"root.fetch_delta","relation":{}},{"source":"root.fetch_delta","target":"root.stage_upload","relation":{"relationType":"SEQUENTIAL"}},{"source":"root.notify","target":"root.end-43qqbj4Hs4K4xFP6TF779a","relation":{}},{"source":"root.root-53tBxd37B801mZc0ZJ9m0z","target":"root.alert_on_failure","relation":{"relationType":"ERROR"}},{"source":"root.Triggers.end-5Rlvj0BHWphpZvR4A6hEXm","target":"root.root-53tBxd37B801mZc0ZJ9m0z","relation":{}},{"source":"root.Triggers.root-6DoiV3Iy7BfyfzJmGjnr8D","target":"root.Triggers.daily","relation":{}},{"source":"root.Triggers.daily","target":"root.Triggers.end-5Rlvj0BHWphpZvR4A6hEXm","relation":{}}],"clusters":[{"cluster":{"uid":"cluster_root.Triggers","type":"io.kestra.core.models.hierarchies.GraphCluster","finally":{"uid":"root.Triggers.finally-yuYAHhep8KpSiLtYUOyIX","type":"io.kestra.core.models.hierarchies.GraphClusterFinally"}},"nodes":["root.Triggers.root-6DoiV3Iy7Bfyf