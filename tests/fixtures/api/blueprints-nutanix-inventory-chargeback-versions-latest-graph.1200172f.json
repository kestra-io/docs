{"path":"/v1/blueprints/nutanix-inventory-chargeback/versions/latest/graph","status":200,"contentType":"application/json","body":{"nodes":[{"uid":"root.root-3JJatp2I7gkXMNFnzl9Yzp","type":"io.kestra.core.models.hierarchies.GraphClusterRoot"},{"uid":"root.end-JiFff1PP4p1p5xopG65R7","type":"io.kestra.core.models.hierarchies.GraphClusterEnd"},{"uid":"root.Triggers.root-1YAL91aTa3uFoxcbp4cvDp","type":"io.kestra.core.models.hierarchies.GraphClusterRoot"},{"uid":"root.Triggers.end-26CAyDBTuUaFNkfavAKwKZ","type":"io.kestra.core.models.hierarchies.GraphClusterEnd"},{"triggerDeclaration":{"id":"monthly_report","type":"io.kestra.plugin.core.trigger.Schedule","description":"Produce the chargeback report monthly. Adjust or disable as needed.","disabled":true,"cron":"0 6 1 * *"},"uid":"root.Triggers.monthly_report","type":"io.kestra.core.models.hierarchies.GraphTrigger"},{"uid":"root.list_vms","type":"io.kestra.core.models.hierarchies.GraphTask","task":{"id":"list_vms","type":"io.kestra.plugin.ee.nutanix.ahv.ListVms","description":"List all AHV VMs with their resource configuration.","host":"{{ secret('NUTANIX_HOST') }}","token":"{{ secret('NUTANIX_TOKEN') }}"},"relationType":"SEQUENTIAL"},{"uid":"root.compute_chargeback","type":"io.kestra.core.models.hierarchies.GraphTask","task":{"id":"compute_chargeback","type":"io.kestra.plugin.scripts.python.Script","description":"Compute per-VM cost and write a CSV chargeback report.","taskRunner":{"type":"io.kestra.plugin.scripts.runner.docker.Docker"},"beforeCommands":"[\"pip install kestra\"]","inputFiles":{"vms.json":"{{ outputs.list_vms.rows }}"},"outputFiles":"[\"chargeback.csv\"]","containerImage":"python:3.11-slim","script":"import csv\nimport json\nfrom kestra import Kestra\n\nrate = float(\"{{ inputs.core_hour_rate }}\")\nwith open(\"vms.json\") as f:\n    vms = json.load(f)\n\ntotal = 0.0\nwith open(\"chargeback.csv\", \"w\", newline=\"\") as out:\n    writer = csv.writer(out)\n    for vm in vms:\n        name = vm.get(\"name\", \"unknown\")\n        cores = (vm.get(\"numSockets\", 1) or 1) * (vm.get(\"numCoresPerSocket\", 1) or 1)\n        cost = round(cores * rate, 2)\n        total += cost\n        writer.writerow([name, cores, cost])\n\nKestra.outputs({\"vm_count\": len(vms), \"total_cost\": round(total, 2)})\n"},"relationType":"SEQUENTIAL"},{"uid":"root.append_to_sheet","type":"io.kestra.core.models.hierarchies.GraphTask","task":{"id":"append_to_sheet","type":"io.kestra.plugin.googleworkspace.sheets.Load","description":"Append the chargeback rows to the finance spreadsheet.","serviceAccount":"{{ secret('GCP_SERVICE_ACCOUNT') }}","spreadsheetId":"{{ inputs.spreadsheet_id }}","from":"{{ outputs.compute_chargeback.outputFiles['chargeback.csv'] }}","range":"Chargeback","insertType":"APPEND"},"relationType":"SEQUENTIAL"},{"uid":"root.notify","type":"io.kestra.core.models.hierarchies.GraphTask","task":{"id":"notify","type":"io.kestra.plugin.slack.notifications.SlackIncomingWebhook","description":"Post the chargeback summary to Slack.","payload":"{\n  \"text\": \"Nutanix chargeback: {{ outputs.compute_chargeback.vars.vm_count }} VMs, total {{ outputs.compute_chargeback.vars.total_cost }} for the period.\"\n}\n","url":"{{ secret('SLACK_WEBHOOK_URL') }}"},"relationType":"SEQUENTIAL"}],"edges":[{"source":"root.notify","target":"root.end-JiFff1PP4p1p5xopG65R7","relation":{}},{"source":"root.Triggers.end-26CAyDBTuUaFNkfavAKwKZ","target":"root.root-3JJatp2I7gkXMNFnzl9Yzp","relation":{}},{"source":"root.append_to_sheet","target":"root.notify","relation":{"relationType":"SEQUENTIAL"}},{"source":"root.root-3JJatp2I7gkXMNFnzl9Yzp","target":"root.list_vms","relation":{}},{"source":"root.list_vms","target":"root.compute_chargeback","relation":{"relationType":"SEQUENTIAL"}},{"source":"root.compute_chargeback","target":"root.append_to_sheet","relation":{"relationType":"SEQUENTIAL"}},{"source":"root.Triggers.root-1YAL91aTa3uFoxcbp4cvDp","target":"root.Triggers.monthly_report","relation":{}},{"source":"root