els.hierarchies.GraphTask","task":{"id":"merge_and_advance_watermark","type":"io.kestra.plugin.jdbc.sqlserver.Queries","description":"MERGE the staged rows into the target with dedup on the merge key, then advance the watermark, both in one transaction (transaction defaults to true), so a failed MERGE rolls back and the watermark is never advanced past what committed.\n","url":"{{ secret('SQLSERVER_URL') }}","username":"{{ secret('SQLSERVER_USERNAME') }}","password":"{{ secret('SQLSERVER_PASSWORD') }}","sql":"MERGE dbo.inventory_current AS target\nUSING dbo.inventory_staging AS source\nON target.sku = source.sku AND target.warehouse_id = source.warehouse_id\nWHEN MATCHED THEN\n  UPDATE SET quantity = source.quantity, updated_at = source.updated_at\nWHEN NOT MATCHED THEN\n  INSERT (sku, warehouse_id, quantity, updated_at)\n  VALUES (source.sku, source.warehouse_id, source.quantity, source.updated_at);\n","afterSQL":"UPDATE dbo.merge_watermarks\nSET watermark = (SELECT MAX(updated_at) FROM dbo.inventory_staging)\nWHERE job_name = 'inventory_merge';\n","trustServerCertificate":"true"},"relationType":"SEQUENTIAL"},{"uid":"root.row_check.root-4gKGk4xzlRlKiSl1QfrRmB","type":"io.kestra.core.models.hierarchies.GraphClusterRoot"},{"uid":"root.row_check.end-3JpItjwXNxYmU0HIUVDnHY","type":"io.kestra.core.models.hierarchies.GraphClusterEnd"},{"uid":"root.row_check","type":"io.kestra.core.models.hierarchies.GraphTask","task":{"id":"row_check","type":"io.kestra.plugin.core.flow.If","description":"Sanity-check that the merge actually touched rows when the stage extracted some.","condition":"{{ outputs.stage_new_rows.size > 0 and (outputs.merge_and_advance_watermark.outputs | length) == 0 }}","then":[{"id":"alert_no_op_merge","type":"io.kestra.plugin.slack.notifications.SlackIncomingWebhook","description":"Flag a suspicious run where rows were staged but the MERGE reported no output.","payload":"{\n  \"text\": \"SQL Server merge upsert staged {{ outputs.stage_new_rows.size }} rows 