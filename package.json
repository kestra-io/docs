{
  "name": "kestra.io",
  "version": "1.0.0",
  "private": true,
  "description": "Kestra.io website",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "astro": "astro",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "workers:dev": "wrangler dev -- npm run dev",
    "workers:dev-build": "npm run build && wrangler dev",
    "workers:build": "npm run build",
    "workers:deploy": "wrangler deploy",
    "workers:deploy-dryrun": "wrangler deploy --dry-run",
    "workers:build-deploy": "npm run workers:build && npm run workers:deploy",
    "cf-typegen": "wrangler types",
    "svgo": "node scripts/svgo-batch.mjs",
    "svgo:check": "node scripts/svgo-batch.mjs --check",
    "lint": "oxlint --fix",
    "format": "oxfmt . --write && prettier --write **/*.astro",
    "test:visual:capture": "playwright test",
    "test:unit": "vitest run",
    "test:visual:report": "node scripts/visual-diff-report.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vue": "^7.1.2",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@gtm-support/vue-gtm": "^3.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@kestra-io/topology": "^0.0.2",
    "@popperjs/core": "^2.11.8",
    "@types/aos": "^3.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@usal/vue": "^2.0.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.4.4",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "astro-loading-indicator": "^0.9.0",
    "countries-list": "^3.4.1",
    "dayjs": "^1.11.23",
    "eventsource-parser": "^4.1.3",
    "expressive-code-collapsible": "^1.1.0",
    "github-slugger": "^2.0.0",
    "jose": "^6.2.14",
    "lodash": "^4.18.1",
    "lottie-web": "^5.13.0",
    "marked": "^18.1.2",
    "marked-highlight": "^2.2.4",
    "mdast-util-to-string": "^4.0.0",
    "medium-zoom": "^1.1.2",
    "mermaid": "^12.2.0",
    "modern-normalize": "^3.0.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "posthog-js": "^1.442.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-vue": "^1.1.6",
    "rapidoc": "^11.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-link-rewrite": "^1.0.7",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sass": "^1.107.0",
    "sass-embedded": "^1.107.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "slugify": "^1.6.9",
    "strip-indent": "^4.1.1",
    "svgo": "4.1.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vanilla-cookieconsent": "^3.1.0",
    "vue": "^3.5.44",
    "vue-material-design-icons": "^5.4.0",
    "vue3-carousel": "^0.19.0",
    "wrangler": "^4.155.0"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.9",
    "@playwright/test": "1.64.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "odiff-bin": "^4.5.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">= 26",
    "npm": ">= 10"
  },
  "overrides": {
    "astro-loading-indicator": {
      "astro": "$astro"
    },
    "astro-expressive-code": {
      "astro": "$astro"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.66.0",
    "@rollup/rollup-darwin-x64": "^4.66.0",
    "@rollup/rollup-linux-x64-gnu": "^4.66.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "@tree-sitter-grammars/tree-sitter-yaml@0.7.1": true,
    "tree-sitter@0.22.4": true,
    "tree-sitter@0.21.1": true,
    "vue-demi@0.14.10": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "tree-sitter-json@0.24.8": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260907.1": true
  }
}
