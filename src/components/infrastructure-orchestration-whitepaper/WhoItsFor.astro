---
import SectionTitle from "~/components/security/SectionTitle.astro"

// Same presentation as How it works on the vRA migration assistant page
// (vra-migration-guide/assistant/HowItWorks.astro).
const PERSONAS = [
    {
        tag: "Platform and infrastructure automation leads",
        text: "You run Terraform, Ansible, and a patch platform, and the chain between them lives in scripts and in people. You want one control plane above the tools you already trust, and a way to retire the glue without rewriting what works.",
    },
    {
        tag: "Heads of infrastructure and operations",
        text: "Every node the AI buildout adds moves a license meter, the next renewal may reprice the stack, and auditors now ask for proof that each change ran as approved. You want to know which costs you can stop growing, and what evidence one control plane gives you.",
    },
    {
        tag: "Enterprise architects",
        text: "You own the target architecture. You need a clear boundary between the tools that execute work and the layer that coordinates it, and a way to test which platforms can carry data, application, and agent workloads later.",
    },
]
---

<section class="who">
    <div class="container">
        <SectionTitle title="Who this is for" />

        <ul class="list-unstyled">
            {
                PERSONAS.map((persona) => (
                    <li>
                        <span class="tag">{persona.tag}</span>
                        <p>{persona.text}</p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    @use "/src/components/vra-migration-guide/shared" as *;

    .who {
        @include squared-grid-backdrop;
        @include assistant-section(var(--ks-background-secondary));
        border-top: 1px solid var(--ks-border-primary);
    }

    .container {
        @include guide-container;
    }

    ul {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        margin: 2rem 0 0;

        @include media-breakpoint-up(lg) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    li {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
        @include calc-card;
        box-shadow: $calc-shadow-surface;

        p {
            margin: 0;
            color: var(--ks-content-primary);
        }
    }

    // The step number chip of How it works.
    .tag {
        padding: 0.125rem 0.5rem;
        border-radius: 6px;
        background: color-mix(
            in srgb,
            var(--blue-300) 10%,
            var(--ks-background-body)
        );
        font-size: $font-size-sm;
        font-weight: 600;
        line-height: 1.25rem;
        color: var(--blue-400);

        :global(html.dark) & {
            color: var(--blue-300);
        }
    }
</style>
