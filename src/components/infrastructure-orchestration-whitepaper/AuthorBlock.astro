---
import { Image } from "astro:assets"
import portrait from "./assets/kai-waehner.jpg"
import { AUTHOR } from "~/components/unified-orchestration-whitepaper/author"
---

<section class="author">
    <div class="container">
        <div class="author-grid">
            <figure>
                <Image
                    src={portrait}
                    alt={`Portrait of ${AUTHOR.name}`}
                    widths={[360, 720]}
                    sizes="(min-width: 992px) 360px, 100vw"
                    loading="lazy"
                />
            </figure>
            <div class="body">
                <p class="eyebrow">About the author</p>
                <h2>{AUTHOR.name}</h2>
                <p class="role">{AUTHOR.role}</p>
                <p class="bio">{AUTHOR.bio}</p>
                <ul class="links list-unstyled">
                    {
                        AUTHOR.links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noopener"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/components/vra-migration-guide/shared" as *;

    .author {
        padding: 2rem 0 5rem;

        @include media-breakpoint-down(lg) {
            padding: 1rem 0 3.5rem;
        }
    }

    .container {
        @include guide-container;
    }

    .author-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;
        padding-top: 3rem;
        border-top: 1px solid var(--ks-border-primary);

        @include media-breakpoint-up(md) {
            grid-template-columns: 240px minmax(0, 1fr);
            align-items: start;
            gap: 2.5rem;
        }

        @include media-breakpoint-up(lg) {
            grid-template-columns: 315px minmax(0, 1fr);
            gap: 4rem;
        }
    }

    // The square is the dot of the Kestra wordmark, as on the About us page.
    figure {
        position: relative;
        margin: 0;
        max-width: 220px;
        aspect-ratio: 4 / 5;

        @include media-breakpoint-up(md) {
            max-width: none;
        }
        overflow: hidden;
        background: var(--ks-background-tertiary);

        &::before {
            content: "";
            position: absolute;
            z-index: 1;
            top: 0;
            left: 0;
            width: 10px;
            height: 10px;
            background: #fe0071;
        }

        :global(img) {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 20%;
        }
    }

    .body {
        max-width: 46rem;
    }

    .eyebrow {
        margin: 0 0 0.75rem;
        font-size: $font-size-sm;
        font-weight: 600;
        color: var(--ks-content-color-highlight);
    }

    h2 {
        margin: 0;
        font-size: clamp(2rem, 1.25rem + 2vw, #{$font-size-4xl});
        line-height: 1.15;
        letter-spacing: -0.015em;
        color: var(--ks-content-primary);
    }

    .role {
        margin: 0.5rem 0 1.5rem;
        font-size: $font-size-lg;
        color: var(--ks-content-secondary);
    }

    .bio {
        margin: 0 0 1.5rem;
        font-size: $font-size-lg;
        line-height: 1.75rem;
        color: var(--ks-content-primary);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin: 0;

        a {
            font-weight: 600;
            color: var(--ks-content-link);
            text-decoration: underline;
            text-underline-offset: 3px;
        }
    }
</style>
