---
/**
 * Section — ROI. Four ranges with the mechanism behind each one, then one
 * customer sentence that says the same thing in a buyer's words.
 *
 * Content mirrors the "Kestra ROI — Typical Impact After Standardizing
 * Orchestration" slide of the enterprise sales deck (provided by Virgile,
 * 2026-08-05). The ranges are framed as typical impact, never as a promise —
 * that framing is load-bearing, keep it.
 */
import { Icon } from "astro-icon/components"
import type { LpRoiStat } from "~/contents/lp/types"
import leroyMerlinLogo from "~/contents/customer-stories/datamesh-at-scale-increased-its-data-production-by-900percent/logo.svg?raw"
import usccaLogo from "~/assets/quotes-companies/USCCA.svg?raw"
import quadisLogo from "~/contents/customer-stories/quadis-drives-innovation-transforming-car-retail-operations-with-kestra/logo.svg?raw"

interface RoiQuote {
    logo: string
    text: string
    attribution: string
}

interface Props {
    header: string
    intro: string
    stats: readonly LpRoiStat[]
    quotes: readonly RoiQuote[]
}

const { header, intro, stats, quotes } = Astro.props

const LOGOS: Record<string, string> = {
    leroymerlin: leroyMerlinLogo,
    uscca: usccaLogo,
    quadis: quadisLogo,
}
---

<section class="lp-section lp-roi">
    <div class="lp-container">
        <h2 class="lp-h2">{header}</h2>
        <p class="lp-lead lp-roi__intro">{intro}</p>

        <ul class="lp-roi__grid">
            {
                stats.map((stat) => (
                    <li class="lp-roi__card">
                        <p class="lp-roi__label">{stat.label}</p>
                        <p class="lp-roi__value">
                            <Icon
                                name={
                                    stat.direction === "up"
                                        ? "mdi:arrow-up"
                                        : "mdi:arrow-down"
                                }
                                class:list={[
                                    "lp-roi__arrow",
                                    `lp-roi__arrow--${stat.direction}`,
                                ]}
                                aria-hidden="true"
                            />
                            <span class="lp-visually-hidden">
                                {stat.direction === "up" ? "up" : "down"}
                            </span>
                            {stat.value}
                        </p>
                        <p class="lp-roi__why">{stat.why}</p>
                    </li>
                ))
            }
        </ul>

        {
            /*
          Auto-scrolling quotes. Pure CSS marquee: the track renders twice and
          slides by 50%, so the loop is seamless; the clone is aria-hidden.
          Pauses on hover/focus; `prefers-reduced-motion` freezes it via the
          global animation kill in lp.scss.
        */
        }
        <div class="lp-roi__carousel">
            <div class="lp-roi__track">
                {
                    [false, true].map((clone) => (
                        <ul aria-hidden={clone || undefined}>
                            {quotes.map((quote) => (
                                <li>
                                    <figure class="lp-roi__quote">
                                        <blockquote>{quote.text}</blockquote>
                                        <figcaption class="lp-roi__attribution">
                                            <span>{quote.attribution}</span>
                                            {LOGOS[quote.logo] && (
                                                <span
                                                    class="lp-roi__logo"
                                                    role="img"
                                                    aria-label={
                                                        quote.attribution
                                                    }
                                                >
                                                    <Fragment
                                                        set:html={
                                                            LOGOS[quote.logo]
                                                        }
                                                    />
                                                </span>
                                            )}
                                        </figcaption>
                                    </figure>
                                </li>
                            ))}
                        </ul>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .lp-roi {
        background-color: var(--ks-background-secondary);
    }

    .lp-roi__intro {
        margin-top: 0.875rem;
        max-width: 42rem;
    }

    .lp-roi__grid {
        display: grid;
        gap: 1rem;
        margin-top: 2rem;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.5rem;
        }

        @include media-breakpoint-up(xl) {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .lp-roi__card {
        height: 100%;
        padding: 1.5rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);
    }

    .lp-roi__label {
        font-size: 0.9375rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .lp-roi__value {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.5rem;
        font-size: clamp(1.75rem, 2.6vw, 2.25rem);
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.01em;
        color: var(--ks-content-color-highlight);
        font-variant-numeric: tabular-nums;
    }

    .lp-roi__arrow {
        flex: 0 0 auto;
        width: 1.375rem;
        height: 1.375rem;
    }

    .lp-roi__arrow--up {
        color: var(--ks-content-alert-success);
    }

    .lp-roi__arrow--down {
        color: var(--ks-content-color-highlight);
    }

    .lp-roi__why {
        margin-top: 0.75rem;
        color: var(--ks-content-secondary);
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .lp-roi__carousel {
        margin-top: 1.5rem;
        overflow: hidden;
        /* Fade the cut edges so cards slide in and out softly. */
        mask-image: linear-gradient(
            90deg,
            transparent,
            #000 4rem,
            #000 calc(100% - 4rem),
            transparent
        );
    }

    .lp-roi__track {
        display: flex;
        width: max-content;
        gap: 1.25rem;
        animation: lp-roi-scroll 45s linear infinite;

        ul {
            display: flex;
            gap: 1.25rem;
        }

        &:hover,
        &:focus-within {
            animation-play-state: paused;
        }
    }

    @keyframes lp-roi-scroll {
        to {
            /* One full set + its gap — lands exactly on the clone. */
            transform: translateX(calc(-50% - 0.625rem));
        }
    }

    .lp-roi__quote {
        display: flex;
        flex-direction: column;
        width: min(82vw, 33rem);
        height: 100%;
        padding: 1.5rem 1.75rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);

        blockquote {
            font-size: 1.0625rem;
            line-height: 1.55;

            &::before {
                content: "“";
            }

            &::after {
                content: "”";
            }
        }
    }

    .lp-roi__attribution {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding-top: 0.875rem;
        color: var(--ks-content-secondary);
        font-size: 0.875rem;
    }

    .lp-roi__logo :global(svg) {
        height: 1.5rem;
        width: auto;
        filter: brightness(0);
        opacity: 0.7;
    }
</style>
