---
/**
 * Section — Outcomes. The page's core value proposition: three cards, each an
 * icon, a bold lead and its supporting line, with the pain implicit inside the
 * gain (PR #5276 review rule — never re-explain the pain).
 *
 * Visually the loudest content section on the page: brand-gradient keyline on
 * top of each card, icon chip in the brand purple, oversized leads. Everything
 * is tokens already used on kestra.io — no new colours, no JavaScript.
 */
import { Icon } from "astro-icon/components"
import type { LpBenefitCard } from "~/contents/lp/types"

interface Props {
    header: string
    cards: readonly LpBenefitCard[]
}

const { header, cards } = Astro.props
---

<section class="lp-section lp-section--muted lp-benefits">
    <div class="lp-container">
        <h2 class="lp-h2 lp-benefits__header">{header}</h2>

        <ul class="lp-benefits__grid">
            {
                cards.map((card) => (
                    <li class="lp-benefits__card">
                        <span class="lp-benefits__chip" aria-hidden="true">
                            <Icon name={card.icon} class="lp-benefits__icon" />
                        </span>
                        <p class="lp-benefits__lead">{card.lead}</p>
                        <p class="lp-benefits__body">{card.body}</p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    /* No max-width: the 40rem cap forced "One platform. Every workflow.
       Your infrastructure." onto two lines — review wants it on one. */
    .lp-benefits__header {
        max-width: none;
    }

    .lp-benefits__grid {
        display: grid;
        gap: 1rem;
        margin-top: 2rem;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.5rem;
            align-items: stretch;
        }
    }

    .lp-benefits__card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        height: 100%;
        padding: 1.75rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);
        overflow: hidden;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;

        /* Brand keyline — the same purple ramp the site uses elsewhere
           (#a796ff is the ClientRouter loading-indicator hue). */
        &::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 3px;
            background: linear-gradient(
                90deg,
                var(--ks-content-color-highlight),
                #a796ff
            );
        }

        &:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px var(--ks-shadows-light);
        }
    }

    .lp-benefits__chip {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        margin-bottom: 0.5rem;
        border-radius: 0.75rem;
        background-color: var(--ks-background-purple-light);
    }

    .lp-benefits__icon {
        width: 1.5rem;
        height: 1.5rem;
        color: var(--ks-content-color-highlight);
    }

    .lp-benefits__lead {
        font-size: 1.1875rem;
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: -0.01em;
        text-wrap: balance;
    }

    .lp-benefits__body {
        color: var(--ks-content-secondary);
        font-size: 0.9375rem;
        line-height: 1.6;
    }
</style>
