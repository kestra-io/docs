---
/**
 * Section 6 — Enterprise-grade. Reassurance, placed here on purpose: after the
 * visitor knows what the product is and does, never as the opener.
 *
 * 4×2 on desktop, 2×4 on mobile. Icons come from the repo's existing
 * `astro-icon` + `@iconify-json/mdi` set — same source as the rest of the site,
 * no new icon dependency.
 */
import { Icon } from "astro-icon/components"

interface Props {
    header: string
    intro: string
    items: readonly { label: string; icon: string }[]
}

const { header, intro, items } = Astro.props
---

<section class="lp-section lp-section--muted lp-enterprise">
    <div class="lp-container">
        <h2 class="lp-h2">{header}</h2>
        <p class="lp-lead lp-enterprise__intro">{intro}</p>

        <ul class="lp-enterprise__grid">
            {
                items.map((item) => (
                    <li class="lp-enterprise__item">
                        <Icon
                            name={item.icon}
                            class="lp-enterprise__icon"
                            aria-hidden="true"
                        />
                        <span>{item.label}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    .lp-enterprise__intro {
        margin-top: 0.875rem;
        max-width: 40rem;
    }

    .lp-enterprise__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin-top: 2rem;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
        }
    }

    .lp-enterprise__item {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        min-height: 3.25rem;
        padding: 0.75rem 0.875rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: 0.5rem;
        background-color: var(--ks-background-primary);
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.3;
    }

    .lp-enterprise__icon {
        flex: 0 0 auto;
        width: 1.25rem;
        height: 1.25rem;
        color: var(--ks-content-color-highlight);
    }
</style>
