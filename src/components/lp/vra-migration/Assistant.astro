---
/* Stage 1 made concrete: what the Migration Assistant hands back. The visual
 * is the guide's sample brief (lb-usecase) cut down to its two headline
 * figures and the mapping table, rebuilt in HTML: the screenshot is 2,360px
 * wide and its text is unreadable at this column's width. Keep the figures in
 * step with assistant-brief-front.webp. The CTA stays on this page: the paid
 * visitor books the run with us rather than leaving for the tool's page (the
 * FAQ links to it). */
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"

import BrowserFrame from "~/components/vra-migration-guide/assistant/BrowserFrame.astro"
import cubes from "~/components/vra-migration-guide/assets/assistant-cubes.webp"

const mapping = [
    {
        from: "F5 BIG-IP actions",
        to: "Kestra F5 plugin",
        direct: true,
        count: 14,
    },
    {
        from: "Avi actions",
        to: "HTTP tasks on Avi's API",
        direct: true,
        count: 13,
    },
    { from: "Lifecycle workflows", to: "Kestra flows", direct: true, count: 9 },
    {
        from: "State and settings",
        to: "KV store and secrets",
        direct: true,
        count: 14,
    },
    {
        from: "Catalog item and template",
        to: "A Kestra App and a flow",
        direct: false,
        count: 4,
    },
]

const points = [
    "What each workflow does, what starts it and which systems it calls",
    "Whether a Kestra plugin already covers each of those systems",
    "Retire, merge, keep as a wrapper, convert or rebuild, workflow by workflow",
    "A migration plan in waves, ordered by risk and dependency",
]
---

<section class="assistant">
    <div class="inner">
        <div class="copy" data-usal="fade-r delay-0 duration-500 ease-out">
            <h2>See what's inside your vRO package</h2>
            <p class="lead-copy">
                The open-source Kestra Migration Assistant reads your vRealize
                Orchestrator package and vRA export locally, sends nothing to
                Kestra, and writes a migration brief you open in a browser.
            </p>
            <ul class="points">
                {
                    points.map((point) => (
                        <li>
                            <Icon
                                name="mdi:check-circle-outline"
                                class="check"
                            />
                            <span>{point}</span>
                        </li>
                    ))
                }
            </ul>
            <a href="#contact-sales" class="cta">Run it with us</a>
        </div>

        <figure
            class="visual"
            data-usal="fade-l delay-100 duration-500 ease-out"
        >
            <Image
                src={cubes}
                alt=""
                aria-hidden="true"
                widths={[480, 960]}
                sizes="(min-width: 992px) 420px, 260px"
                loading="lazy"
                class="cubes"
            />
            <BrowserFrame path="kestra-assessment / index.html">
                <div class="brief">
                    <p class="brief-title">Migration brief: lb-usecase</p>
                    <div class="figures">
                        <div class="figure">
                            <strong>50 of 59</strong>
                            <span>have a path to Kestra</span>
                        </div>
                        <div class="figure">
                            <strong>9 answers</strong>
                            <span>to start Wave 1</span>
                        </div>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">In vRA and vRO</th>
                                <th scope="col">In Kestra</th>
                                <th scope="col">How</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                mapping.map((row) => (
                                    <tr>
                                        <td>
                                            {row.from}{" "}
                                            <span class="count">
                                                ×{row.count}
                                            </span>
                                        </td>
                                        <td>{row.to}</td>
                                        <td>
                                            <span
                                                class:list={[
                                                    "badge-how",
                                                    { wait: !row.direct },
                                                ]}
                                            >
                                                {row.direct
                                                    ? "Direct"
                                                    : "Your call"}
                                            </span>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </BrowserFrame>
            <figcaption>
                An excerpt from a sample brief, generated from one vRO package
                and one vRA export.
            </figcaption>
        </figure>
    </div>
</section>

<style lang="scss">
    .assistant {
        position: relative;
        overflow: clip;
        padding: 5rem 1rem;
        background-color: var(--lp-bg-dark);
        background-image: radial-gradient(
            60% 55% at 85% 50%,
            rgba(109, 40, 217, 0.45) 0%,
            rgba(17, 17, 21, 0) 75%
        );
    }

    .inner {
        display: flex;
        flex-direction: column;
        gap: 3rem;
        max-width: 1140px;
        margin-inline: auto;
        @include media-breakpoint-up(lg) {
            flex-direction: row;
            align-items: center;
            gap: 3rem;
        }
    }

    .copy {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        @include media-breakpoint-up(lg) {
            flex: 0 0 440px;
        }
    }

    h2 {
        margin: 0;
        color: #ffffff;
        font-size: 1.875rem;
        font-weight: 600;
        line-height: 1.0417;
        letter-spacing: -0.045rem;
        @include media-breakpoint-up(lg) {
            font-size: 3rem;
        }
    }

    .lead-copy {
        margin: 0;
        color: var(--lp-content-dark-secondary);
        font-size: 1.125rem;
        line-height: 1.5;
    }

    .points {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;

        li {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            color: #ffffff;
            font-size: $font-size-md;
            line-height: 1.5;
        }
    }

    .check {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        margin-top: 0.125rem;
        color: var(--lp-purple-mid);
    }

    .cta {
        display: inline-flex;
        align-self: flex-start;
        align-items: center;
        justify-content: center;
        min-width: 160px;
        height: 50px;
        padding: 0.5rem 1.25rem;
        border: 1px solid #ffffff;
        border-radius: 8px;
        background-color: var(--lp-purple);
        color: #ffffff;
        font-size: $font-size-lg;
        font-weight: 700;
        text-decoration: none;
        box-shadow:
            inset 0 0 14px 0 #be62ff,
            2px 2px 5.5px rgba(0, 0, 0, 0.1);
        &:hover {
            background-color: #7737fe;
        }
    }

    .visual {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
        margin: 0;
    }

    /* The assistant page's cubes, breaking out of the frame's top-right
     * corner. The PNG is mostly transparent margin, so the offsets place its
     * ink, not its box. The section clips, so the overhang never scrolls. */
    .visual :global(.cubes) {
        position: absolute;
        z-index: 2;
        top: -60px;
        right: -40px;
        width: 240px;
        height: auto;
        pointer-events: none;
        @include media-breakpoint-up(lg) {
            top: -80px;
            right: -110px;
            width: 420px;
        }
    }

    .visual {
        figcaption {
            margin-top: 0.75rem;
            color: var(--lp-content-muted);
            font-size: $font-size-sm;
            text-align: center;
        }
    }

    /* The brief's own dark palette, so the mock reads as the tool's output. */
    .brief {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 1.5rem;
        background: #111113;
        color: #e6e6eb;
    }

    .brief-title {
        margin: 0;
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .figures {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .figure {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem;
        border: 1px solid #2c2c33;
        border-radius: 8px;
        background: #18181c;

        strong {
            color: #ffffff;
            font-size: 1.375rem;
            font-weight: 600;
            line-height: 1.1;
            @include media-breakpoint-up(sm) {
                font-size: 1.75rem;
            }
        }

        span {
            color: #9a9aab;
            font-size: $font-size-sm;
        }
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: $font-size-sm;
        line-height: 1.35;
    }

    th {
        padding: 0 0.5rem 0.5rem 0;
        border-bottom: 1px solid #2c2c33;
        color: #9a9aab;
        font-weight: 500;
        text-align: left;
    }

    td {
        padding: 0.625rem 0.5rem 0.625rem 0;
        border-bottom: 1px solid #222228;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    .count {
        color: #7e7e9b;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .badge-how {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border: 1px solid #3fb950;
        border-radius: 999px;
        color: #56d364;
        font-size: $font-size-xs;
        white-space: nowrap;

        &.wait {
            border-color: #d4a72c;
            color: #e3b341;
        }
    }
</style>
