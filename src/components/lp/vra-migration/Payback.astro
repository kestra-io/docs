---
/* The guide's payback calculator, embedded so a paid visitor can run their
 * numbers without leaving the page. Its proof-of-concept button lands on this
 * page's form, and the case-study link is dropped to keep exits off. */
import CalculatorPayback from "~/components/vra-migration-guide/calculator/CalculatorPayback.vue"
---

<section class="payback" id="payback">
    <div class="head" data-usal="fade-u delay-50 duration-500 ease-out">
        <h2>What leaving vRA costs, and when it pays back</h2>
        <p>
            The migration is the investment, and the vRA renewal you do not sign
            pays it back. The calculator works out both sides from your own
            workflow counts, rates and renewal date.
        </p>
    </div>

    <details
        class="calculator"
        data-usal="fade-u delay-100 duration-500 ease-out"
    >
        <summary class="cta">
            <span class="when-closed">Calculate my payback</span>
            <span class="when-open">Hide the calculator</span>
        </summary>
        <div class="calculator-body">
            <CalculatorPayback
                client:visible
                idPrefix="lp-calc-payback"
                shareAnchor="payback"
                pocHref="#contact-sales"
                storyHref={null}
            />
        </div>
    </details>

    <figure class="quote" data-usal="fade-u delay-150 duration-500 ease-out">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>
            We eliminated the high cost and risk of VMware vRA. What used to
            take 6 months now takes 6 days with Kestra.
        </blockquote>
        <figcaption>
            <strong>Fortune 500 manufacturer</strong>
            <span class="sep" aria-hidden="true">|</span>
            <span>Principal Hosting</span>
        </figcaption>
    </figure>
</section>

<style lang="scss">
    /* Same lavender wash as the template's ROI block, which this replaces. */
    .payback {
        padding: 5rem 1rem;
        background-color: #ffffff;
        background-image:
            radial-gradient(
                90% 70% at 50% -10%,
                #f0e8ff 0%,
                rgba(243, 237, 255, 0.55) 45%,
                rgba(255, 255, 255, 0) 85%
            ),
            radial-gradient(
                55% 60% at -5% 45%,
                rgba(243, 237, 255, 0.9) 0%,
                rgba(255, 255, 255, 0) 100%
            ),
            radial-gradient(
                40% 50% at 100% 5%,
                rgba(240, 240, 254, 0.9) 0%,
                rgba(255, 255, 255, 0) 100%
            );
    }

    .head {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        max-width: 900px;
        margin: 0 auto;
        text-align: center;

        h2 {
            margin: 0;
            color: var(--lp-content-primary);
            font-size: 1.875rem;
            font-weight: 600;
            line-height: 1.0417;
            letter-spacing: -0.045rem;
            @include media-breakpoint-up(lg) {
                font-size: 3rem;
            }
        }

        p {
            max-width: 720px;
            margin: 0;
            color: var(--lp-content-secondary);
            font-size: 1.25rem;
            line-height: 1.4;
        }
    }

    .calculator {
        max-width: 1140px;
        margin: 2rem auto 0;
        /* The calculator's result panel sticks under the campaign header, not
         * the site header it was built for. */
        --calc-sticky-top: calc(var(--top-bar-height, 80px) + 1rem);
    }

    .calculator-body {
        margin-top: 2rem;
        text-align: left;
    }

    summary.cta {
        list-style: none;
        cursor: pointer;
        &::-webkit-details-marker {
            display: none;
        }
    }

    .when-open,
    .calculator[open] .when-closed {
        display: none;
    }

    .calculator[open] .when-open {
        display: inline;
    }

    .cta {
        display: flex;
        width: fit-content;
        margin-inline: auto;
        align-items: center;
        justify-content: center;
        min-width: 160px;
        height: 50px;
        padding: 0.5rem 1.25rem;
        border: 1px solid #ffffff;
        border-radius: 8px;
        background-color: var(--lp-purple);
        color: #ffffff;
        font-size: $font-size-lg;
        font-weight: 700;
        text-decoration: none;
        user-select: none;
        box-shadow:
            inset 0 0 14px 0 #be62ff,
            2px 2px 5.5px rgba(0, 0, 0, 0.1);
        &:hover {
            background-color: #7737fe;
        }
    }

    /* The template carousel's quote, held still: there is one vRA quote. */
    .quote {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        max-width: 646px;
        margin: 4.5rem auto 0;
    }

    .quote-mark {
        color: var(--lp-purple);
        font-size: 3.5rem;
        font-weight: 700;
        line-height: 1;
        margin-bottom: -1.5rem;
    }

    blockquote {
        margin: 0;
        color: var(--lp-content-primary);
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.167;
        letter-spacing: -0.0075rem;
        text-align: center;
        text-wrap: balance;
        @include media-breakpoint-up(lg) {
            font-size: 1.5rem;
        }
    }

    figcaption {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding-top: 1rem;
        color: var(--lp-content-secondary);
        font-size: $font-size-md;
        font-weight: 600;
        text-align: center;
    }

    .sep {
        color: var(--lp-border);
        font-weight: 300;
    }
</style>

<script>
    /* A shared calculator link carries #payback: open the calculator so the
     * recipient lands on the numbers rather than on a closed toggle. */
    function openSharedCalculator() {
        if (window.location.hash !== "#payback") return
        document
            .querySelector<HTMLDetailsElement>(".payback .calculator")
            ?.setAttribute("open", "")
    }

    openSharedCalculator()
    document.addEventListener("astro:page-load", openSharedCalculator)
</script>
