---
/* The guide's case studies (section 2.5), anonymised. The status line stays on
 * every card: only the first estate has finished migrating, and a paid page
 * must not imply otherwise. Figures for the first card are the public ones
 * from /customers/fortune-500-company. */
const cases = [
    {
        status: "Migration complete",
        title: "Fortune 500 manufacturer, off Aria Automation across IT and OT",
        stats: [
            {
                value: "90%",
                label: "lower licensing cost than Aria Automation",
            },
            { value: "30×", label: "faster delivery" },
            { value: "4 + 1", label: "isolated platforms, for OT and IT" },
        ],
        body: "vRA and vRO replaced together: catalog, request forms, orchestration and the vCenter integration. Ansible and ServiceNow stayed.",
    },
    {
        status: "Go-live targeted January 2027",
        title: "EU federal agency, fully air-gapped",
        stats: [
            { value: "1,600", label: "vRO workflows" },
            { value: "2,000", label: "vRO actions" },
            { value: "50,000+", label: "cloud resources supported" },
        ],
        body: "On-premises with no outbound connectivity. Kestra Apps for the catalog, Kestra Assets for the resource inventory.",
    },
    {
        status: "Assessed",
        title: "Global systems integrator, several vRO instances",
        stats: [
            { value: "3,000", label: "workflows" },
            { value: "3", label: "production vRO nodes" },
            { value: "100+", label: "services in its ServiceNow catalog" },
        ],
        body: "The assessment sized several thousand workflows spread across instances and tied to an established service catalog.",
    },
]
---

<section class="proof">
    <div class="head" data-usal="fade-u delay-50 duration-500 ease-out">
        <h2>Enterprise vRA estates, at every stage</h2>
        <p>From assessment to completed migration.</p>
    </div>

    <div class="cards">
        {
            cases.map((item, index) => (
                <article
                    class="card-fancy"
                    data-usal={`fade-u duration-350 delay-${100 + index * 50} ease-out`}
                >
                    <p class="status">{item.status}</p>
                    <h3>{item.title}</h3>
                    <dl class="stats">
                        {item.stats.map((stat) => (
                            <div class="stat">
                                <dt>{stat.value}</dt>
                                <dd>{stat.label}</dd>
                            </div>
                        ))}
                    </dl>
                    <p class="body">{item.body}</p>
                </article>
            ))
        }
    </div>
</section>

<style lang="scss">
    /* Same card as the template's Trusted block, with a status line where the
     * logo was: these estates are anonymised. */
    .proof {
        padding: 2.5rem 1rem 7.5rem;
        background-color: #ffffff;
    }

    .head {
        max-width: 900px;
        margin: 0 auto 2.5rem;
        text-align: center;

        h2 {
            margin: 0 0 2rem;
            color: var(--lp-content-primary);
            font-size: 1.875rem;
            font-weight: 600;
            line-height: 1.0417;
            letter-spacing: -0.045rem;
            @include media-breakpoint-up(lg) {
                font-size: 3rem;
            }
        }

        p {
            margin: 0;
            color: var(--lp-content-secondary);
            font-size: 1.25rem;
            line-height: 1.4;
        }
    }

    .cards {
        display: grid;
        gap: 1rem;
        max-width: 1145px;
        margin-inline: auto;
        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .card-fancy {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        overflow: hidden;
        padding: 1.5rem 1.5rem 2rem;
        border: 1px solid var(--lp-purple);
        border-radius: 12px;
        background:
            radial-gradient(
                120% 90% at -10% -20%,
                rgba(12, 40, 255, 0.06) 0%,
                rgba(12, 40, 255, 0) 100%
            ),
            #ffffff;
        box-shadow: 2px 3px 16px 0 var(--lp-shadow-light);
    }

    .status {
        align-self: flex-start;
        margin: 0;
        padding: 0.25rem 0.625rem;
        border-radius: 4px;
        background-color: var(--lp-purple-light);
        color: var(--lp-purple);
        font-family: $font-family-monospace;
        font-size: $font-size-xs;
        font-weight: 600;
        line-height: 1.33;
        text-transform: uppercase;
    }

    h3 {
        margin: 0;
        color: var(--lp-content-primary);
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.167;
        letter-spacing: -0.0075rem;
    }

    .stats {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 0;
        padding: 1rem 0;
        border-top: 1px solid var(--lp-border);
        border-bottom: 1px solid var(--lp-border);
    }

    .stat {
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }

    dt {
        flex-shrink: 0;
        color: var(--lp-purple);
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.00625rem;
    }

    dd {
        margin: 0;
        color: var(--lp-content-secondary);
        font-family: $font-family-monospace;
        font-size: $font-size-xs;
        line-height: 1.33;
    }

    .body {
        margin: 0;
        color: var(--lp-content-secondary);
        font-size: $font-size-md;
        line-height: 1.5;
    }
</style>
