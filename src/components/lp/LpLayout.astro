---
import Layout from "~/components/layout.astro"
import LpHeader from "~/components/lp/shared/LpHeader.astro"
import type { Props as LpHeaderProps } from "~/components/lp/shared/LpHeader.astro"
import LpFooter from "~/components/lp/shared/LpFooter.astro"

interface Props {
    title: string
    description: string
    header?: LpHeaderProps
}

const { title, description, header } = Astro.props
---

<Layout {title} {description} noindex bareChrome forceTheme="light">
    <div class="lp-page">
        <LpHeader {...header} />
        <slot />
        <LpFooter />
    </div>
</Layout>

<style lang="scss">
    /* An ad landing page has to look identical for every visitor, so these
     * pages pin literal values instead of the theme-aware --ks-* tokens (which
     * all shift in dark mode) — the same approach the homepage takes with
     * --hp-*. The values below that DO have a token are the light-theme value
     * of it; the rest come from the newer Figma set that the palette doesn't
     * carry yet. Swap them for --ks-* once that set lands in
     * _color-palette.scss. */
    .lp-page {
        --lp-purple: #631bff; /* --ks-content-color-highlight */
        --lp-purple-light: #f1efff; /* --ks-background-purple-light */
        --lp-purple-rail: #cdc5ff; /* --ks-background-purple-hover */
        --lp-shadow-light: #3952f21a; /* --ks-shadows-light */

        /* Figma-only, no palette equivalent yet. */
        --lp-bg-dark: #111115;
        /* Figma's `border-focus`. The design reaches for it wherever #631bff
         * would go muddy: ticks on the dark ground, the Stack rules. */
        --lp-purple-mid: #9869f7;
        /* Figma's `content-secondary`, distinct from `text-secondary` above —
         * the design uses this one for body copy inside white cards. */
        --lp-content-on-card: #3b3a41;
        /* Only the open FAQ answer panel uses this; every other light section in
         * the design is flat white. */
        --lp-bg-base: #f7f7f8;
        --lp-content-primary: #08090a;
        --lp-content-secondary: #5f5f7c;
        --lp-content-muted: #7e7e9b;
        --lp-content-dark-secondary: #adadbf;
        --lp-border: #d0d0da;
        --lp-border-subtle: #e9e9ee;

        background-color: #ffffff;
        overflow-x: clip;
    }

    :global(html) {
        --top-bar-height: 80px;
    }
</style>
