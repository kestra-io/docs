---
import { Icon } from "astro-icon/components"

import Meeting from "~/components/demo/Meeting.vue"

export interface Props {
    /** Passed to HubSpot as the originating page URI. */
    routePath: string
    /** Each line renders on its own row. */
    headingLines: string[]
    bullets: { text: string; strong: boolean }[]
    /** Forwarded to the form, e.g. its button label. */
    formProps?: Record<string, unknown>
}

const { routePath, headingLines, bullets, formProps = {} } = Astro.props
---

<section class="use-cases">
    <div class="inner">
        <div class="copy">
            <h2 data-usal="fade-r delay-0 duration-500 ease-out">
                {
                    headingLines.map((line, index) => (
                        <>
                            {index > 0 && <br />}
                            {line}
                        </>
                    ))
                }
            </h2>
            <ul
                class="bullets"
                data-usal="fade-r delay-100 duration-500 ease-out"
            >
                {
                    bullets.map((bullet) => (
                        <li>
                            <Icon
                                name="mdi:check-circle-outline"
                                class="check"
                            />
                            {bullet.strong ? (
                                <strong>{bullet.text}</strong>
                            ) : (
                                <span>{bullet.text}</span>
                            )}
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="form-card" id="contact-sales">
            <slot name="form">
                <Meeting
                    {routePath}
                    variant="plain"
                    {...formProps}
                    client:visible
                />
            </slot>
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/components/lp/shared/lp" as *;

    .use-cases {
        position: relative;
        overflow: clip;
        @include lp-section(var(--lp-bg-dark));
        background-image:
            radial-gradient(
                70% 60% at 12% 8%,
                rgba(109, 40, 217, 0.75) 0%,
                rgba(60, 25, 140, 0.4) 42%,
                rgba(17, 17, 21, 0) 78%
            ),
            radial-gradient(
                55% 45% at 45% 105%,
                rgba(99, 27, 255, 0.35) 0%,
                rgba(17, 17, 21, 0) 72%
            );
    }

    .inner {
        display: flex;
        flex-direction: column;
        gap: 3rem;
        @include lp-container;
        @include media-breakpoint-up(lg) {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }
    }

    .copy {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        @include media-breakpoint-up(lg) {
            max-width: 605px;
        }
    }

    h2 {
        margin: 0;
        @include lp-heading($color: #ffffff, $size: 2.25rem);
    }

    .bullets {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
        @include media-breakpoint-up(lg) {
            /* The design hangs 24px of clearance under the last bullet so the
             * copy column stays optically centred against the taller form card. */
            padding-bottom: 1.5rem;
            max-width: 498px;
        }
        li {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            color: #ffffff;
            font-size: $font-size-lg;
            line-height: 1.5556;
        }
        strong {
            font-weight: 700;
        }
        .check {
            flex-shrink: 0;
            width: 20px;
            height: 20px;
            margin-top: 0.25rem;
            color: var(--lp-purple-mid);
        }
    }

    .form-card {
        width: 100%;
        padding: 1.5rem 1.75rem;
        border: 1.2px solid #8c56ff;
        border-radius: 8px;
        background-color: #ffffff;
        box-shadow:
            0 2.767px 1.107px rgba(0, 0, 0, 0.1),
            0 6.65px 2.66px rgba(0, 0, 0, 0.15),
            0 22.336px 8.935px rgba(0, 0, 0, 0.22),
            0 100px 40px rgba(0, 0, 0, 0.37);
        @include media-breakpoint-up(lg) {
            flex-shrink: 0;
            width: 417px;
            max-width: 417px;
        }
    }
</style>
