---
import { Icon } from "astro-icon/components"

export interface Props {
    heading: string
    cards: { kicker: string; title: string; body: string; icon: string }[]
}

const { heading, cards } = Astro.props
---

<section class="platform">
    <h2 data-usal="fade-u delay-50 duration-500 ease-out">{heading}</h2>

    <div class="cards">
        {
            cards.map((card, index) => (
                <article
                    class="card-fancy"
                    data-usal={`fade-u duration-350 delay-${100 + index * 50} ease-out`}
                >
                    <Icon name={card.icon} class="watermark" />
                    <p class="kicker">{card.kicker}</p>
                    <h3>{card.title}</h3>
                    <p class="body">{card.body}</p>
                </article>
            ))
        }
    </div>
</section>

<style lang="scss">
    @use "/src/components/lp/shared/lp" as *;

    .platform {
        /* The design's stack of white-to-transparent washes composites to flat
         * white here — verified against the Figma render. */
        @include lp-section;
    }

    h2 {
        @include lp-section-head(1140px);
        @include lp-heading;
    }

    .cards {
        display: grid;
        gap: 1rem;
        max-width: 1146px;
        margin-inline: auto;
        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .card-fancy {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        overflow: hidden;
        padding: 1.5rem 1.5rem 2rem;
        border: 1px solid var(--lp-purple);
        border-radius: 12px;
        background-color: #ffffff;
        box-shadow: 2px 3px 16px 0 var(--lp-shadow-light);
    }

    .watermark {
        position: absolute;
        /* Sized and placed to land the glyph where the design does: a ~190px
         * mark centred just above the card's top-right corner. */
        top: -3.75rem;
        right: -3.5rem;
        width: 190px;
        height: 190px;
        /* The design layers a faint two-stop purple wash here; at this alpha
         * a single tint is indistinguishable from it. */
        color: var(--lp-purple);
        opacity: 0.09;
        transform: rotate(-18deg);
        pointer-events: none;
    }

    .kicker {
        position: relative;
        margin: 0;
        color: var(--lp-purple);
        font-size: $font-size-md;
        font-weight: 600;
        line-height: 1.5;
    }

    h3 {
        position: relative;
        margin: 0;
        color: var(--lp-content-primary);
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.167;
        letter-spacing: -0.0075rem;
    }

    .body {
        position: relative;
        margin: 0.5rem 0 0;
        color: var(--lp-content-secondary);
        font-size: $font-size-sm;
        line-height: 1.43;
    }
</style>
