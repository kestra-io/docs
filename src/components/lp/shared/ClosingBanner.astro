---
import Link from "~/components/common/Link.astro"

export interface Props {
    heading: string
    sub: string
    cta?: { text: string; href: string }
    reassurance?: string
}

const {
    heading,
    sub,
    cta = { text: "Book a demo", href: "/demo" },
    reassurance = "Self-managed or air-gapped. Your data never leaves your network.",
} = Astro.props
---

<section class="closing">
    <div class="banner" data-usal="fade-u delay-50 duration-500 ease-out">
        <div class="copy">
            <h2>{heading}</h2>
            <p>{sub}</p>
        </div>
        <Link href={cta.href} class="cta" text={cta.text} />
    </div>

    <p class="reassurance" data-usal="fade-u delay-150 duration-500 ease-out">
        {reassurance}
    </p>
</section>

<style lang="scss">
    @use "/src/components/lp/shared/lp" as *;

    .closing {
        padding: 0 1rem 5rem;
        background-color: #ffffff;
    }

    .banner {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        overflow: hidden;
        @include lp-container;
        padding: 2.5rem;
        border-radius: 8px;
        /* Near-black slab lit by a soft purple bloom off the top edge, plus a
         * fainter one to its right. */
        background:
            radial-gradient(
                55% 150% at 46% -25%,
                rgba(158, 76, 255, 0.55) 0%,
                rgba(99, 27, 255, 0.22) 40%,
                rgba(19, 19, 19, 0) 72%
            ),
            radial-gradient(
                26% 90% at 88% -10%,
                rgba(140, 86, 255, 0.28) 0%,
                rgba(19, 19, 19, 0) 70%
            ),
            linear-gradient(180deg, #131313 50%, #212732 111.37%);
        @include media-breakpoint-up(md) {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            padding: 2.5rem 3.75rem 2.5rem 2.5rem;
        }
    }

    .copy {
        position: relative;
        min-width: 0;

        h2 {
            margin: 0;
            color: #ffffff;
            font-size: 1.75rem;
            font-weight: 600;
            line-height: 1.2222;
            letter-spacing: -0.0225rem;
            @include media-breakpoint-up(lg) {
                font-size: 2.25rem;
            }
        }

        p {
            margin: 0;
            color: var(--lp-content-dark-secondary);
            font-size: $font-size-lg;
            line-height: 1.56;
        }
    }

    .reassurance {
        @include lp-container;
        margin-block: 1rem 0;
        color: var(--lp-content-secondary);
        font-size: $font-size-md;
        font-style: italic;
        line-height: 1.5;
        text-align: center;
    }

    .closing :global(.cta) {
        position: relative;
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        @include lp-cta;
    }
</style>
