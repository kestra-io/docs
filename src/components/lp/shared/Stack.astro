---
import { Icon } from "astro-icon/components"
import type { SvgComponent } from "astro/types"

export interface Props {
    heading: string
    sub?: string
    columns: {
        Glyph: SvgComponent
        title: string
        items: string[]
    }[]
    /** Rendered glyph size in px; thin-stroke icons read better smaller. */
    glyphSize?: number
}

const { heading, sub, columns, glyphSize = 120 } = Astro.props
---

<section class="stack" style={`--glyph-size: ${glyphSize}px`}>
    <div class="head" data-usal="fade-u delay-50 duration-500 ease-out">
        <h2>{heading}</h2>
        {sub && <p>{sub}</p>}
    </div>

    <div class="columns">
        {
            columns.map((column, index) => (
                <article
                    class="column"
                    data-usal={`fade-u duration-350 delay-${100 + index * 50} ease-out`}
                >
                    <column.Glyph class="glyph" role="presentation" />
                    <h3>{column.title}</h3>
                    <ul>
                        {column.items.map((item) => (
                            <li>
                                <Icon
                                    name="mdi:check-circle-outline"
                                    class="check"
                                />
                                <span>{item}</span>
                            </li>
                        ))}
                    </ul>
                </article>
            ))
        }
    </div>
</section>

<style lang="scss">
    @use "/src/components/lp/shared/lp" as *;

    .stack {
        padding: 2.5rem 1rem 5rem;
        background-color: #ffffff;
    }

    .head {
        /* Wide enough to keep the heading on one line, as the design has it. */
        @include lp-section-head(1140px);

        h2 {
            margin: 0 0 0.5rem;
            @include lp-heading;
        }

        p {
            margin: 0;
            @include lp-lead;
        }
    }

    .columns {
        display: grid;
        --columns-gap: 2rem;
        gap: var(--columns-gap);
        max-width: 1164px;
        margin-inline: auto;
        @include media-breakpoint-up(sm) {
            grid-template-columns: repeat(2, 1fr);
        }
        @include media-breakpoint-up(lg) {
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
        }
    }

    .column {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem;

        /* The design's dividers are not flat hairlines, and they are not
         * anchored at the top either: each 1px rule fades up out of nothing
         * beside the glyph, holds solid down the length of the list, then fades
         * back out at the foot of the column — so neither a border-left nor a
         * one-way gradient will do. Stops are sampled off the Figma render,
         * where the rule is clear by its own top edge, fully opaque across the
         * middle 36–77% of its own span, and clear again by the bottom. */
        @include media-breakpoint-up(lg) {
            & + &::before {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                width: 1px;
                background-image: linear-gradient(
                    180deg,
                    rgba(152, 105, 247, 0) 10%,
                    var(--lp-purple-mid) 43%,
                    var(--lp-purple-mid) 79%,
                    rgba(152, 105, 247, 0) 100%
                );
            }
        }

        @include media-breakpoint-down(sm) {
            & + &::before {
                content: "";
                position: absolute;
                top: calc(var(--columns-gap) / -2);
                left: 15%;
                width: 70%;
                height: 1px;
                background-image: linear-gradient(
                    90deg,
                    rgba(152, 105, 247, 0) 0%,
                    var(--lp-purple-mid) 30%,
                    var(--lp-purple-mid) 70%,
                    rgba(152, 105, 247, 0) 100%
                );
            }
        }

        h3 {
            margin: 0;
            color: var(--lp-content-primary);
            font-size: 1.5rem;
            font-weight: 600;
            line-height: 1.167;
            letter-spacing: -0.0075rem;
            text-align: center;
        }

        ul {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            width: 100%;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            color: var(--lp-content-secondary);
            font-size: $font-size-sm;
            line-height: 1.43;
        }
    }

    .glyph {
        width: var(--glyph-size, 120px);
        height: var(--glyph-size, 120px);
    }

    .check {
        flex-shrink: 0;
        width: 16px;
        height: 16px;
        margin-top: 0.15rem;
        color: var(--lp-purple);
    }
</style>
