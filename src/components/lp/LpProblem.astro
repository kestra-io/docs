---
/**
 * Section 3 — Problem. Qualification, not persuasion: deliberately quieter
 * than the Benefits section that answers it (smaller header, muted text, no
 * cards, no background fill).
 */
interface Props {
    header: string
    pains: readonly string[]
}

const { header, pains } = Astro.props
---

<section class="lp-section lp-problem">
    <div class="lp-container">
        <h2 class="lp-problem__header">{header}</h2>

        <ul class="lp-problem__list">
            {
                pains.map((pain) => (
                    <li class="lp-problem__item">
                        <span class="lp-problem__marker" aria-hidden="true" />
                        <p>{pain}</p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    .lp-problem {
        padding-block: 2.5rem;

        @include media-breakpoint-up(md) {
            padding-block: 3.5rem;
        }
    }

    .lp-problem__header {
        font-size: 1.125rem;
        font-weight: 600;
        line-height: 1.35;
        color: var(--ks-content-primary);

        @include media-breakpoint-up(md) {
            font-size: 1.25rem;
        }
    }

    .lp-problem__list {
        display: grid;
        gap: 1.25rem;
        margin-top: 1.5rem;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 2rem;
        }
    }

    .lp-problem__item {
        display: flex;
        gap: 0.75rem;

        p {
            /* Quieter than the Benefits cards through size and layout, not
               through low contrast — this text still has to be readable. */
            color: var(--ks-content-secondary);
            font-size: 0.9375rem;
            line-height: 1.55;
        }
    }

    .lp-problem__marker {
        flex: 0 0 auto;
        width: 0.375rem;
        height: 0.375rem;
        margin-top: 0.6rem;
        border-radius: 50%;
        background-color: var(--ks-content-tertiary);
    }
</style>
