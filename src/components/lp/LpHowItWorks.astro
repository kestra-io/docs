---
/**
 * Section 5 — How it works. Two columns: the claim on the left, a real
 * syntax-highlighted YAML flow on the right. Never a screenshot: this is the
 * one section whose job is technical credibility, and a technical reader will
 * try to read the code.
 *
 * Uses the repo's existing highlighter (Expressive Code / Shiki, configured in
 * `ec.config.mjs`) so the colours match every code block on kestra.io. The
 * global `wrap: true` default is overridden in `lp.scss`: the sample scrolls
 * horizontally instead of wrapping, because wrapped YAML reads as broken YAML.
 */
import { Code } from "astro-expressive-code/components"

interface Props {
    header: string
    body: string
    yaml: string
}

const { header, body, yaml } = Astro.props
---

<section class="lp-section lp-how">
    <div class="lp-container lp-how__grid">
        <div class="lp-how__copy">
            <h2 class="lp-h2">{header}</h2>
            <p class="lp-lead lp-how__body">{body}</p>
        </div>

        <div class="lp-code lp-how__code">
            <Code code={yaml} lang="yaml" frame="none" meta="nocollapse" />
        </div>
    </div>
</section>

<style lang="scss">
    .lp-how__grid {
        display: grid;
        gap: 2rem;

        @include media-breakpoint-up(lg) {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
            align-items: center;
            gap: 3rem;
        }
    }

    .lp-how__body {
        margin-top: 1rem;
        max-width: 32rem;
    }

    .lp-how__code {
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        overflow: hidden;

        :global(.expressive-code) {
            font-size: 0.8125rem;

            @include media-breakpoint-up(md) {
                font-size: 0.875rem;
            }
        }

        :global(pre) {
            padding-block: 1.25rem;
        }
    }
</style>
