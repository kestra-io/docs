---
/**
 * Section 7 — Proof. Both states are built and selected by content, not code:
 *   state: "case"  → case-study card (metric + summary + quote + attribution)
 *   state: "stats" → three-stat fallback row
 *
 * Everything currently renders PENDING_CLEARANCE placeholders. Nothing in this
 * section is approved for publication — see the TODO in `contents/lp/shared.ts`.
 * The placeholder strings are visually marked so nobody mistakes the page for
 * launch-ready while they are still there.
 */
import type { LpProof } from "~/contents/lp/types"

interface Props {
    header: string
    proof: LpProof
}

const { header, proof } = Astro.props
const isPending = (value: string) => value.includes("PENDING_CLEARANCE")
---

<section class="lp-section lp-proof">
    <div class="lp-container">
        <h2 class="lp-h2">{header}</h2>

        {
            proof.state === "case" ? (
                <figure class="lp-proof__card">
                    <p
                        class:list={[
                            "lp-proof__metric",
                            { "is-pending": isPending(proof.case.metric) },
                        ]}
                    >
                        {proof.case.metric}
                    </p>
                    <p
                        class:list={[
                            "lp-proof__summary",
                            { "is-pending": isPending(proof.case.summary) },
                        ]}
                    >
                        {proof.case.summary}
                    </p>
                    <blockquote
                        class:list={[
                            "lp-proof__quote",
                            { "is-pending": isPending(proof.case.quote) },
                        ]}
                    >
                        {proof.case.quote}
                    </blockquote>
                    <figcaption class="lp-proof__attribution">
                        {proof.case.attribution}
                    </figcaption>
                </figure>
            ) : (
                <ul class="lp-proof__stats">
                    {proof.stats.map((stat) => (
                        <li class="lp-proof__stat">
                            <p
                                class:list={[
                                    "lp-proof__stat-value",
                                    { "is-pending": isPending(stat.value) },
                                ]}
                            >
                                {stat.value}
                            </p>
                            <p class="lp-proof__stat-label">{stat.label}</p>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</section>

<style lang="scss">
    .lp-proof__card {
        margin-top: 1.75rem;
        padding: 1.75rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);

        @include media-breakpoint-up(md) {
            padding: 2.25rem;
        }
    }

    .lp-proof__metric {
        font-size: clamp(1.5rem, 3.2vw, 2rem);
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--ks-content-color-highlight);
    }

    .lp-proof__summary {
        margin-top: 0.75rem;
        max-width: 42rem;
        color: var(--ks-content-secondary);
        font-size: 1rem;
    }

    .lp-proof__quote {
        margin-top: 1.5rem;
        padding-left: 1rem;
        border-left: 2px solid var(--ks-border-primary);
        font-size: 1.0625rem;
        line-height: 1.55;
    }

    .lp-proof__attribution {
        margin-top: 0.875rem;
        padding-left: 1rem;
        color: var(--ks-content-secondary);
        font-size: 0.875rem;
    }

    .lp-proof__stats {
        display: grid;
        gap: 1rem;
        margin-top: 1.75rem;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.5rem;
        }
    }

    .lp-proof__stat {
        padding: 1.5rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);
    }

    .lp-proof__stat-value {
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.1;
        color: var(--ks-content-color-highlight);
    }

    .lp-proof__stat-label {
        margin-top: 0.375rem;
        color: var(--ks-content-secondary);
        font-size: 0.9375rem;
    }

    /* Unmistakable while the copy is not cleared. Delete nothing: the marker
       disappears on its own once the strings no longer say PENDING_CLEARANCE. */
    .is-pending {
        color: var(--ks-content-secondary);
        font-family: var(--font-family-jetbrains-mono), monospace;
        font-size: 0.8125rem;
        font-weight: 400;
        letter-spacing: 0;
        text-transform: none;
    }
</style>
