---
/**
 * Section 1 — Hero: H1 and sub on the left with the product UI underneath, the
 * demo form directly on the right. No CTA button — the form is the call to
 * action, one field away from the ad click.
 *
 * The H1's ad-group keyword renders in the brand purple (`h1Highlight`), so the
 * message-match phrase is also the visual accent.
 *
 * Under the copy, on large viewports only: the homepage's animated "Kestra
 * Way" widget — the Kestra card orchestrating Data / Infra / AI, wordmark and
 * brand baked in. Inline SVG + two small canvases, so it costs no image bytes;
 * on mobile it is not rendered visually (display:none) and its rAF loop is the
 * only idle cost. Swapped in for the UI screenshot per review (2026-08-06).
 */
import LpDemoForm from "./LpDemoForm.vue"
import { LP_SHARED } from "~/contents/lp/shared"
// The homepage's animated "Kestra Way" widget (SVG + particle canvases):
// the Kestra card orchestrating Data / Infra / AI, with the wordmark baked in.
// Self-contained (inline script, no imports) and a singleton — its script
// queries the first `.kestra-widget` on the page, so never render it twice.
import KestraWayAnimation from "~/components/home/assets/comparison/kestra-way-animated.astro"

interface Props {
    h1: string
    h1Highlight?: string
    sub: string
    microcopy: string
    variant: string
}

const { h1, h1Highlight, sub, microcopy, variant } = Astro.props

// Split the H1 around the highlight phrase; fall back to the plain string.
const highlightIndex = h1Highlight ? h1.indexOf(h1Highlight) : -1
const before = highlightIndex >= 0 ? h1.slice(0, highlightIndex) : h1
const after =
    highlightIndex >= 0 ? h1.slice(highlightIndex + h1Highlight!.length) : ""
---

<section class="lp-hero" data-lp-hero-form>
    <div class="lp-container lp-hero__grid">
        <div class="lp-hero__copy">
            <h1 class="lp-hero__title">
                {before}{
                    highlightIndex >= 0 && (
                        <span class="lp-hero__accent">{h1Highlight}</span>
                    )
                }{after}
            </h1>
            <p class="lp-hero__sub">{sub}</p>

            <div class="lp-hero__visual">
                <KestraWayAnimation class="lp-hero__widget" />
            </div>
        </div>

        <div class="lp-hero__form">
            <p class="lp-hero__form-title">{LP_SHARED.hero.formTitle}</p>
            <p class="lp-hero__microcopy">{microcopy}</p>
            <LpDemoForm variant={variant} idPrefix="hero" client:load />
        </div>
    </div>
</section>

<style lang="scss">
    .lp-hero {
        padding-block: 1.5rem 2.5rem;

        @include media-breakpoint-up(lg) {
            padding-block: 3rem 3.5rem;
        }
    }

    .lp-hero__grid {
        display: grid;
        gap: 2rem;

        @include media-breakpoint-up(lg) {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            align-items: start;
            gap: 4rem;
        }
    }

    .lp-hero__title {
        font-size: clamp(2rem, 4.6vw, 3.25rem);
        line-height: 1.08;
        font-weight: 600;
        letter-spacing: -0.02em;
        text-wrap: balance;
    }

    .lp-hero__accent {
        color: var(--ks-content-color-highlight);
    }

    .lp-hero__sub {
        margin-top: 1.125rem;
        max-width: 34rem;
        color: var(--ks-content-secondary);
        font-size: 1.0625rem;

        @include media-breakpoint-up(md) {
            font-size: 1.1875rem;
        }
    }

    .lp-hero__visual {
        display: none;

        @include media-breakpoint-up(lg) {
            display: flex;
            justify-content: center;
            margin-top: 2rem;
        }

        /* The widget is a fixed 554×396 card; keep the same footprint the
           homepage gives it, rounded and capped to the column. */
        :global(.lp-hero__widget) {
            width: auto;
            height: 396px;
            max-width: 100%;
            border-radius: 0.5rem;
        }
    }

    .lp-hero__form {
        padding: 1.5rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);
        box-shadow: 0 4px 24px var(--ks-shadows-light);

        @include media-breakpoint-up(md) {
            padding: 1.75rem;
        }

        @include media-breakpoint-up(lg) {
            max-width: 26rem;
            justify-self: end;
            width: 100%;
            position: sticky;
            top: 5rem;
        }
    }

    .lp-hero__form-title {
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.2;
    }

    .lp-hero__microcopy {
        margin: 0.375rem 0 1.25rem;
        color: var(--ks-content-secondary);
        font-size: 0.9375rem;
    }
</style>
