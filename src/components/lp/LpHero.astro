---
/**
 * Section 1 — Hero: H1 and sub on the left, the demo form directly on the
 * right. No CTA button and no product visual — the form *is* the call to
 * action, so the ad click lands one field away from converting instead of one
 * scroll and one click away.
 *
 * The form card carries its own small heading + microcopy so it reads as an
 * offer ("book a demo, 30 minutes with an engineer"), not as a toll booth.
 *
 * Mobile: H1 → sub → form card. The top of the card (heading + first field)
 * is what must clear the fold at 375×667 — the submit button sits one short
 * scroll down, and the sticky bar covers the rest of the page.
 */
import LpDemoForm from "./LpDemoForm.vue"
import { LP_SHARED } from "~/contents/lp/shared"

interface Props {
    h1: string
    sub: string
    microcopy: string
    variant: string
}

const { h1, sub, microcopy, variant } = Astro.props
---

<section class="lp-hero" data-lp-hero-form>
    <div class="lp-container lp-hero__grid">
        <div class="lp-hero__copy">
            <h1 class="lp-hero__title">{h1}</h1>
            <p class="lp-hero__sub">{sub}</p>
        </div>

        <div class="lp-hero__form">
            <p class="lp-hero__form-title">{LP_SHARED.hero.cta}</p>
            <p class="lp-hero__microcopy">{microcopy}</p>
            <LpDemoForm variant={variant} idPrefix="hero" client:load />
        </div>
    </div>
</section>

<style lang="scss">
    .lp-hero {
        padding-block: 1.5rem 2.5rem;

        @include media-breakpoint-up(lg) {
            padding-block: 3rem 3.5rem;
        }
    }

    .lp-hero__grid {
        display: grid;
        gap: 2rem;

        @include media-breakpoint-up(lg) {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            align-items: start;
            gap: 4rem;
        }
    }

    .lp-hero__title {
        font-size: clamp(2rem, 4.6vw, 3.25rem);
        line-height: 1.08;
        font-weight: 600;
        letter-spacing: -0.02em;
        text-wrap: balance;
    }

    .lp-hero__sub {
        margin-top: 1.125rem;
        max-width: 34rem;
        color: var(--ks-content-secondary);
        font-size: 1.0625rem;

        @include media-breakpoint-up(md) {
            font-size: 1.1875rem;
        }
    }

    .lp-hero__form {
        padding: 1.5rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);
        box-shadow: 0 4px 24px var(--ks-shadows-light);

        @include media-breakpoint-up(md) {
            padding: 1.75rem;
        }

        @include media-breakpoint-up(lg) {
            max-width: 26rem;
            justify-self: end;
            width: 100%;
        }
    }

    .lp-hero__form-title {
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.2;
    }

    .lp-hero__microcopy {
        margin: 0.375rem 0 1.25rem;
        color: var(--ks-content-secondary);
        font-size: 0.9375rem;
    }
</style>
