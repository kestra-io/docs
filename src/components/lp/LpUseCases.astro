---
/**
 * Section — What people orchestrate. Four columns, four concrete items each.
 *
 * This is the section that substantiates the H1's "entire stack": a visitor who
 * only sees three benefit cards has to take the claim on faith, and a Google Ads
 * landing page with 400 words of copy scores badly on landing-page experience.
 * It is also where the category vocabulary lives — dbt, Terraform, Ansible,
 * cron, schedulers, directory, LLM tasks — so the page matches its ad group on
 * more than the headline.
 */
import { Icon } from "astro-icon/components"
import type { LpUseCase } from "~/contents/lp/types"

interface Props {
    header: string
    intro: string
    columns: readonly LpUseCase[]
}

const { header, intro, columns } = Astro.props
---

<section class="lp-section lp-section--muted lp-usecases">
    <div class="lp-container">
        <h2 class="lp-h2">{header}</h2>
        <p class="lp-lead lp-usecases__intro">{intro}</p>

        <ul class="lp-usecases__grid">
            {
                columns.map((column) => (
                    <li class="lp-usecases__card">
                        <div class="lp-usecases__head">
                            <Icon
                                name={column.icon}
                                class="lp-usecases__icon"
                                aria-hidden="true"
                            />
                            <h3 class="lp-usecases__title">{column.title}</h3>
                        </div>
                        <ul class="lp-usecases__items">
                            {column.items.map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    .lp-usecases__intro {
        margin-top: 0.875rem;
        max-width: 44rem;
    }

    .lp-usecases__grid {
        display: grid;
        gap: 1rem;
        margin-top: 2rem;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.5rem;
        }

        @include media-breakpoint-up(lg) {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .lp-usecases__card {
        height: 100%;
        padding: 1.5rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-primary);
    }

    .lp-usecases__head {
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }

    .lp-usecases__icon {
        flex: 0 0 auto;
        width: 1.375rem;
        height: 1.375rem;
        color: var(--ks-content-color-highlight);
    }

    .lp-usecases__title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .lp-usecases__items {
        margin-top: 1rem;
        display: grid;
        gap: 0.75rem;

        li {
            position: relative;
            padding-left: 1rem;
            color: var(--ks-content-secondary);
            font-size: 0.875rem;
            line-height: 1.5;

            &::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0.55em;
                width: 0.3125rem;
                height: 0.3125rem;
                border-radius: 50%;
                background-color: var(--ks-content-color-highlight);
                opacity: 0.55;
            }
        }
    }
</style>
