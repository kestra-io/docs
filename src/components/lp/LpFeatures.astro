---
/**
 * Section — Features, Redwood-style split (Martin's review, 2026-08-07): the
 * product screenshot on the left, three checkmarked feature groups on the
 * right (Security & Compliance / Governance & Productivity / Scalability &
 * Infrastructure). This is also the page's one real product image — the hero
 * carries the animated brand widget, this carries the actual UI.
 *
 * On mobile the screenshot stacks above the list, Redwood-style.
 */
import { Icon } from "astro-icon/components"

interface Props {
    header: string
    blocks: readonly { icon: string; title: string; body: string }[]
}

const { header, blocks } = Astro.props
---

<section class="lp-section lp-features">
    <div class="lp-container">
        <h2 class="lp-h2">{header}</h2>

        <div class="lp-features__grid">
            {
                /*
              Placeholder at the exact 16/10 footprint the screenshot will
              occupy — TODO(virgile): swap for the dashboard capture when it
              lands (an Astro <Image loading="lazy">, nothing else moves).
            */
            }
            <div class="lp-features__visual">
                <div class="lp-features__placeholder" aria-hidden="true">
                    <span>DASHBOARD_SCREENSHOT</span>
                </div>
            </div>

            <ul class="lp-features__list">
                {
                    blocks.map((block) => (
                        <li class="lp-features__item">
                            <Icon
                                name="mdi:check-circle"
                                class="lp-features__check"
                                aria-hidden="true"
                            />
                            <div>
                                <h3 class="lp-features__title">
                                    {block.title}
                                </h3>
                                <p class="lp-features__body">{block.body}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    .lp-features__grid {
        display: grid;
        gap: 2rem;
        margin-top: 2rem;

        @include media-breakpoint-up(lg) {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            align-items: center;
            gap: 3.5rem;
        }
    }

    .lp-features__placeholder {
        aspect-ratio: 16 / 10;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed var(--ks-border-primary);
        border-radius: var(--lp-radius);
        background-color: var(--ks-background-secondary);

        span {
            font-family: var(--font-family-jetbrains-mono), monospace;
            font-size: 0.75rem;
            letter-spacing: 0.06em;
            color: var(--ks-content-secondary);
        }
    }

    .lp-features__list {
        display: grid;
        gap: 1.5rem;
    }

    .lp-features__item {
        display: flex;
        align-items: flex-start;
        gap: 0.875rem;
    }

    .lp-features__check {
        flex: 0 0 auto;
        width: 1.375rem;
        height: 1.375rem;
        /* No offset: the icon's 1.375rem matches the title's line box, so it
           sits centred on the "Security & Compliance" line. */
        color: var(--ks-content-color-highlight);
    }

    .lp-features__title {
        font-size: 1.0625rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .lp-features__body {
        margin-top: 0.375rem;
        color: var(--ks-content-secondary);
        font-size: 0.9375rem;
        line-height: 1.6;
    }
</style>
