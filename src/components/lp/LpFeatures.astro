---
/**
 * Section — Features, Redwood-style split (Martin's review, 2026-08-07): the
 * product screenshot on the left, three checkmarked feature groups on the
 * right (Security & Compliance / Governance & Productivity / Scalability &
 * Infrastructure). This is the page's one real product image — the dashboard
 * capture (provided 2026-08-07).
 *
 * On mobile the screenshot stacks above the list, Redwood-style.
 */
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import dashboardUi from "./assets/dashboard-lp.png"

interface Props {
    header: string
    blocks: readonly { icon: string; title: string; body: string }[]
}

const { header, blocks } = Astro.props
---

<section class="lp-section lp-features">
    <div class="lp-container">
        <h2 class="lp-h2">{header}</h2>

        <div class="lp-features__grid">
            <div class="lp-features__visual">
                <Image
                    src={dashboardUi}
                    alt="The Kestra dashboard: success ratio, executions over time, and upcoming runs across namespaces, in one view."
                    widths={[720, 1080, 1440]}
                    sizes="(min-width: 992px) 50vw, 100vw"
                    loading="lazy"
                />
            </div>

            <ul class="lp-features__list">
                {
                    blocks.map((block) => (
                        <li class="lp-features__item">
                            <Icon
                                name="mdi:check-circle"
                                class="lp-features__check"
                                aria-hidden="true"
                            />
                            <div>
                                <h3 class="lp-features__title">
                                    {block.title}
                                </h3>
                                <p class="lp-features__body">{block.body}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    .lp-features__grid {
        display: grid;
        gap: 2rem;
        margin-top: 2rem;

        @include media-breakpoint-up(lg) {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            align-items: center;
            gap: 3.5rem;
        }
    }

    .lp-features__visual :global(img) {
        width: 100%;
        height: auto;
        border: 1px solid var(--ks-border-primary);
        border-radius: var(--lp-radius);
        box-shadow: 0 12px 40px var(--ks-shadows-light);
    }

    .lp-features__list {
        display: grid;
        gap: 1.5rem;
    }

    .lp-features__item {
        display: flex;
        align-items: flex-start;
        gap: 0.875rem;
    }

    .lp-features__check {
        flex: 0 0 auto;
        width: 1.375rem;
        height: 1.375rem;
        /* No offset: the icon's 1.375rem matches the title's line box, so it
           sits centred on the "Security & Compliance" line. */
        color: var(--ks-content-color-highlight);
    }

    .lp-features__title {
        font-size: 1.0625rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .lp-features__body {
        margin-top: 0.375rem;
        color: var(--ks-content-secondary);
        font-size: 0.9375rem;
        line-height: 1.6;
    }
</style>
