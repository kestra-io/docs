---
import { Icon } from "astro-icon/components"
import { API_URL } from "astro:env/client"

const NODES = [
    {
        id: "flow",
        plugin: "terraform.cli.TerraformCLI",
        name: "provision-stack",
        kind: "flow",
        owner: "Platform team",
        x: 1.5,
        y: 12,
    },
    {
        id: "vpc",
        plugin: "aws",
        name: "vpc-staging",
        kind: "aws vpc",
        owner: "Platform team",
        x: 18.5,
        y: 5,
    },
    {
        id: "db",
        plugin: "jdbc.postgresql.Query",
        name: "stg-orders-db",
        kind: "postgresql",
        owner: "Data team",
        x: 18.5,
        y: 19,
    },
    {
        id: "api",
        plugin: "kubernetes.core.PodCreate",
        name: "dev-payments-api",
        kind: "deployment",
        owner: "Payments team",
        x: 35.5,
        y: 12,
    },
    {
        id: "dns",
        plugin: "cloudflare",
        name: "api.staging.acme",
        kind: "dns record",
        owner: "Web team",
        x: 35.5,
        y: 19,
    },
] as const

const EDGES = [
    {
        kind: "edge",
        path: "M14.5 13.9 H15.9 Q16.5 13.9 16.5 13.3 V7.5 Q16.5 6.9 17.1 6.9 H18.35",
    },
    {
        kind: "edge",
        path: "M14.5 13.9 H15.9 Q16.5 13.9 16.5 14.5 V20.3 Q16.5 20.9 17.1 20.9 H18.35",
    },
    {
        kind: "edge",
        path: "M31.5 6.9 H32.9 Q33.5 6.9 33.5 7.5 V13.3 Q33.5 13.9 34.1 13.9 H35.35",
    },
    {
        kind: "edge",
        path: "M31.5 20.9 H32.9 Q33.5 20.9 33.5 20.3 V14.5 Q33.5 13.9 34.1 13.9 H35.35",
    },
    { kind: "edge", path: "M37.4 15.8 V18.85" },
    {
        kind: "edge hot e-db",
        path: "M31.5 20.9 H32.9 Q33.5 20.9 33.5 20.3 V14.5 Q33.5 13.9 34.1 13.9 H35.35",
    },
    { kind: "edge hot e-api", path: "M37.4 15.8 V18.85" },
] as const

const icons = Object.fromEntries(
    await Promise.all(
        NODES.map(async (node) => {
            try {
                const response = await fetch(
                    `${API_URL}/plugins/icons/io.kestra.plugin.${node.plugin}`,
                )
                if (!response.ok) return [node.id, null]
                const svg = Buffer.from(await response.arrayBuffer())
                return [
                    node.id,
                    `data:image/svg+xml;base64,${svg.toString("base64")}`,
                ]
            } catch {
                return [node.id, null]
            }
        }),
    ),
)

const IMPACTED = NODES.filter((node) => node.id === "api" || node.id === "dns")
---

<div class="ui-mock inventory-mock" aria-hidden="true" data-ui-mock>
    <div class="stage">
        <svg class="edges" viewBox="0 0 50 38.8">
            <defs>
                <marker
                    id="inventory-arrow"
                    viewBox="0 0 10 10"
                    refX="9"
                    refY="5"
                    markerWidth="0.5"
                    markerHeight="0.5"
                    markerUnits="userSpaceOnUse"
                    orient="auto"
                >
                    <path d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z" class="tip" />
                </marker>
                <marker
                    id="inventory-arrow-hot"
                    viewBox="0 0 10 10"
                    refX="9"
                    refY="5"
                    markerWidth="0.5"
                    markerHeight="0.5"
                    markerUnits="userSpaceOnUse"
                    orient="auto"
                >
                    <path
                        d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z"
                        class="tip hot"
                    />
                </marker>
                <marker
                    id="inventory-dot"
                    viewBox="0 0 6 6"
                    refX="3"
                    refY="3"
                    markerWidth="0.4"
                    markerHeight="0.4"
                    markerUnits="userSpaceOnUse"
                >
                    <circle cx="3" cy="3" r="3" class="tip" />
                </marker>
            </defs>
            {EDGES.map((edge) => (
                <path class={edge.kind} d={edge.path} />
            ))}
        </svg>
        {NODES.map((node) => (
            <div
                class={`node n-${node.id}`}
                style={`--x: ${node.x}; --y: ${node.y}`}
            >
                <span class="ico">
                    {icons[node.id] && <img src={icons[node.id]} alt="" />}
                </span>
                <span class="txt">
                    <b>{node.name}</b>
                    <small>
                        {node.kind} · {node.owner}
                    </small>
                </span>
                {node.id === "db" && (
                    <span class="act">
                        <Icon name="mdi:timer-sand-complete" /> Retire
                    </span>
                )}
                {(node.id === "api" || node.id === "dns") && (
                    <i class="hit">Impacted</i>
                )}
            </div>
        ))}
        <div class="impact">
            <p class="head">
                <Icon name="mdi:alert-outline" />
                Retiring stg-orders-db affects 2 resources
            </p>
            {IMPACTED.map((node) => (
                <p class="dep">
                    <span class="mini">
                        {icons[node.id] && <img src={icons[node.id]} alt="" />}
                    </span>
                    <b>{node.name}</b>
                    <span class="owner">{node.owner}</span>
                </p>
            ))}
            <p class="foot">
                <span>Retire stays blocked until they move</span>
                <span class="notify">
                    <Icon name="mdi:bell-outline" /> Notify owners
                </span>
            </p>
        </div>
        <p class="toast">
            <Icon name="mdi:check-circle" />
            Payments and Web teams notified
        </p>
        <span class="cursor">
            <svg viewBox="0 0 10 10">
                <path d="M0 0 L10 4 L5.5 5.5 L4 10 Z"></path>
            </svg>
            <span class="who">
                <Icon name="mdi:account-cog-outline" />
                Platform team
            </span>
        </span>
    </div>
</div>

<style lang="scss">
    @use "../enterprise/mocks/tokens" as *;

    .inventory-mock {
        --loop: 16s;
        --select: color-mix(in srgb, var(--text) 18%, transparent);
        --edge: #d0d0da;
        --rest: 3em 33em;
        --at-retire: 29.6em 23.5em;
        --at-notify: 34.6em 32.2em;

        @include tokens;
        @include soft;

        :global(html.dark) & {
            --edge: #4a4a5a;
        }
    }

    .stage {
        position: relative;
        min-height: 38.8em;
        font-size: calc(100cqw / 50);
        line-height: 1.3;
        color: var(--text);
    }

    p {
        margin: 0;
    }

    [data-icon] {
        flex: none;
        width: 1.1em;
        height: 1.1em;
    }

    .edges {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;

        .edge {
            fill: none;
            stroke: var(--edge);
            stroke-width: 0.1;
            stroke-dasharray: 0.3 0.3;
            marker-start: url(#inventory-dot);
            marker-end: url(#inventory-arrow);
        }

        .hot {
            stroke: var(--wait);
            marker-end: url(#inventory-arrow-hot);
            opacity: 0;
        }

        .tip {
            fill: var(--edge);

            &.hot {
                fill: var(--wait);
            }
        }
    }

    .node {
        position: absolute;
        top: calc(var(--y) * 1em);
        left: calc(var(--x) * 1em);
        display: flex;
        align-items: center;
        gap: 0.7em;
        width: 13em;
        height: 3.8em;
        padding: 0 0.7em;
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--panel);
        box-shadow: 0 1px 4px 0 var(--ks-shadows-light);

        &::after {
            content: "";
            position: absolute;
            inset: -1px;
            border-radius: inherit;
            box-shadow: 0 0 0 0.22em var(--select);
            opacity: 0;
            pointer-events: none;
        }
    }

    .ico,
    .mini {
        display: grid;
        flex: none;
        place-items: center;
        background: #ffffff;

        img {
            width: 80%;
            height: 80%;
        }
    }

    .ico {
        width: 2.4em;
        height: 2.4em;
        border-radius: 0.5em;
    }

    .mini {
        width: 1.7em;
        height: 1.7em;
        border-radius: 0.3em;
    }

    .txt {
        display: grid;
        gap: 0.2em;
        min-width: 0;
        line-height: 1.2;

        b {
            overflow: hidden;
            font-size: 0.7em;
            font-weight: 500;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        small {
            overflow: hidden;
            font-size: 0.6em;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--muted);
        }
    }

    .act {
        position: absolute;
        top: calc(100% + 0.5em);
        right: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        padding: 0.45em 0.7em;
        border: 1px solid var(--line);
        border-radius: 0.32em;
        background: var(--panel);
        box-shadow: var(--shadow);
        font-size: 0.58em;
        font-weight: 600;
        opacity: 0;
    }

    .hit {
        position: absolute;
        top: -0.75em;
        right: 0.7em;
        padding: 0.25em 0.55em;
        border-radius: 0.21em;
        background: var(--wait-bg);
        font-size: 0.52em;
        font-style: normal;
        font-weight: 600;
        color: var(--wait);
        opacity: 0;
    }

    .impact {
        position: absolute;
        right: 0;
        bottom: 5.2em;
        left: 0;
        width: 27em;
        margin-inline: auto;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--panel);
        box-shadow: var(--shadow);
        opacity: 0;
    }

    .head {
        display: flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.8em 1em;
        border-bottom: 1px solid var(--line);
        font-size: 0.68em;
        font-weight: 600;

        [data-icon] {
            color: var(--wait);
        }
    }

    .dep {
        display: flex;
        align-items: center;
        gap: 0.6em;
        padding: 0.55em 1.6em;
        font-size: 0.62em;

        b {
            font-weight: 600;
        }

        .owner {
            margin-left: auto;
            color: var(--muted);
        }
    }

    .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1em;
        margin-top: 0.4em;
        padding: 0.7em 1em;
        border-top: 1px solid var(--line);
        font-size: 0.6em;
        color: var(--muted);
    }

    .notify {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        padding: 0.55em 0.9em;
        border-radius: 0.32em;
        background: #18181e;
        font-weight: 600;
        white-space: nowrap;
        color: #ffffff;

        :global(html.dark) & {
            background: #cfcfd8;
            color: #18181e;
        }
    }

    .toast {
        position: absolute;
        right: 0;
        bottom: 1.2em;
        left: 0;
        display: flex;
        align-items: center;
        gap: 0.6em;
        width: max-content;
        margin-inline: auto;
        padding: 0.8em 1.3em;
        border-radius: 0.5em;
        background: #18181e;
        box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.45);
        font-size: 0.86em;
        font-weight: 600;
        color: #ffffff;
        opacity: 0;

        :global(html.dark) & {
            background: #ffffff;
            color: #18181e;
        }

        [data-icon] {
            width: 1.3em;
            height: 1.3em;
            color: #2fd197;
        }
    }

    .cursor {
        --tone: 38, 112, 214;

        position: absolute;
        top: 0;
        left: 0;
        z-index: 4;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1em;
        translate: var(--rest);
        pointer-events: none;

        :global(html.dark) & {
            --tone: 140, 196, 255;
        }

        svg {
            width: 1.1em;
            height: 1.1em;
            fill: rgb(var(--tone));
            filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
        }
    }

    .who {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        margin-left: 0.7em;
        padding: 0.15em 0.55em;
        border-radius: 0.32em;
        background: rgb(var(--tone));
        font-size: 0.7em;
        font-weight: 600;
        white-space: nowrap;
        color: #ffffff;

        :global(html.dark) & {
            border: 1px solid rgba(var(--tone), 0.45);
            background: rgb(20, 20, 24);
            color: rgb(var(--tone));
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .inventory-mock:not([data-play]) * {
            animation-play-state: paused !important;
        }

        .stage {
            animation: inventory-stage var(--loop) linear infinite both;
        }

        .cursor {
            animation:
                inventory-cursor var(--loop) infinite both,
                inventory-cursor-show var(--loop) linear infinite both;
        }

        .act {
            animation:
                inventory-act var(--loop) ease-out infinite both,
                inventory-press-retire var(--loop) linear infinite both;
        }

        .n-db::after {
            animation: inventory-ring var(--loop) linear infinite both;
        }

        .e-db {
            animation:
                inventory-hot-db var(--loop) linear infinite both,
                inventory-flow 0.5s linear infinite;
        }

        .e-api {
            animation:
                inventory-hot-api var(--loop) linear infinite both,
                inventory-flow 0.5s linear infinite;
        }

        .n-api {
            animation:
                inventory-hit-api-border var(--loop) linear infinite both,
                inventory-glow-api var(--loop) linear infinite both;
        }

        .n-dns {
            animation:
                inventory-hit-dns-border var(--loop) linear infinite both,
                inventory-glow-dns var(--loop) linear infinite both;
        }

        .n-api .hit {
            animation: inventory-hit-api var(--loop) ease-out infinite both;
        }

        .n-dns .hit {
            animation: inventory-hit-dns var(--loop) ease-out infinite both;
        }

        .impact {
            animation: inventory-impact var(--loop) ease-out infinite both;
        }

        .notify {
            animation: inventory-press-notify var(--loop) linear infinite both;
        }

        .toast {
            animation: inventory-toast var(--loop) ease-out infinite both;
        }
    }

    @keyframes inventory-stage {
        0%,
        94% {
            opacity: 1;
        }
        96%,
        97% {
            opacity: 0;
        }
        100% {
            opacity: 1;
        }
    }

    @keyframes inventory-cursor {
        0%,
        14% {
            translate: var(--rest);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        20%,
        24% {
            translate: var(--at-retire);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        40% {
            translate: var(--at-retire);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        46%,
        49% {
            translate: var(--at-notify);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        57%,
        100% {
            translate: var(--rest);
        }
    }

    @keyframes inventory-act {
        0%,
        16% {
            opacity: 0;
            translate: 0 -0.3em;
        }
        18%,
        24% {
            opacity: 1;
            translate: 0 0;
        }
        26%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes inventory-cursor-show {
        0%,
        11% {
            opacity: 0;
        }
        13%,
        57% {
            opacity: 1;
        }
        60%,
        100% {
            opacity: 0;
        }
    }

    @keyframes inventory-press-retire {
        0%,
        22.5% {
            scale: 1;
        }
        23% {
            scale: 0.92;
        }
        23.5%,
        100% {
            scale: 1;
        }
    }

    @keyframes inventory-ring {
        0%,
        23% {
            opacity: 0;
        }
        24.5%,
        86% {
            opacity: 1;
        }
        87.5%,
        100% {
            opacity: 0;
        }
    }

    @keyframes inventory-hot-db {
        0%,
        24% {
            opacity: 0;
        }
        25.5%,
        86% {
            opacity: 1;
        }
        87.5%,
        100% {
            opacity: 0;
        }
    }

    @keyframes inventory-hot-api {
        0%,
        28.5% {
            opacity: 0;
        }
        30%,
        86% {
            opacity: 1;
        }
        87.5%,
        100% {
            opacity: 0;
        }
    }

    @keyframes inventory-flow {
        to {
            stroke-dashoffset: -0.6;
        }
    }

    @keyframes inventory-hit-api-border {
        0%,
        27% {
            border-color: var(--line);
        }
        28.5%,
        86% {
            border-color: var(--wait);
        }
        87.5%,
        100% {
            border-color: var(--line);
        }
    }

    @keyframes inventory-hit-dns-border {
        0%,
        31.5% {
            border-color: var(--line);
        }
        33%,
        86% {
            border-color: var(--wait);
        }
        87.5%,
        100% {
            border-color: var(--line);
        }
    }

    @keyframes inventory-glow-api {
        0%,
        27% {
            box-shadow: 0 1px 4px 0 var(--ks-shadows-light);
        }
        28.5%,
        86% {
            box-shadow: 0 0 0 0.22em var(--wait-bg);
        }
        87.5%,
        100% {
            box-shadow: 0 1px 4px 0 var(--ks-shadows-light);
        }
    }

    @keyframes inventory-glow-dns {
        0%,
        31.5% {
            box-shadow: 0 1px 4px 0 var(--ks-shadows-light);
        }
        33%,
        86% {
            box-shadow: 0 0 0 0.22em var(--wait-bg);
        }
        87.5%,
        100% {
            box-shadow: 0 1px 4px 0 var(--ks-shadows-light);
        }
    }

    @keyframes inventory-hit-api {
        0%,
        26.5% {
            opacity: 0;
            translate: 0 0.8em;
        }
        29.5%,
        86% {
            opacity: 1;
            translate: 0 0;
        }
        89%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes inventory-hit-dns {
        0%,
        31% {
            opacity: 0;
            translate: 0 0.8em;
        }
        34%,
        86% {
            opacity: 1;
            translate: 0 0;
        }
        89%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes inventory-impact {
        0%,
        33.5% {
            opacity: 0;
            translate: 0 0.8em;
        }
        36.5%,
        84% {
            opacity: 1;
            translate: 0 0;
        }
        87%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes inventory-press-notify {
        0%,
        47% {
            scale: 1;
        }
        47.5% {
            scale: 0.92;
        }
        48%,
        100% {
            scale: 1;
        }
    }

    @keyframes inventory-toast {
        0%,
        48.5% {
            opacity: 0;
            translate: 0 0.8em;
        }
        51.5%,
        82% {
            opacity: 1;
            translate: 0 0;
        }
        85%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .impact,
        .hit,
        .n-db::after {
            opacity: 1;
        }

        .hot {
            opacity: 1;
        }

        .n-api,
        .n-dns {
            border-color: var(--wait);
        }
    }
</style>
