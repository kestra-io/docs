---
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"
import kestraMark from "~/components/home/assets/ai/kestra-logo-mark-on-dark.svg"

const STAGES = [
    {
        icon: "mdi:file-document-outline",
        title: "Request",
        detail: "Linux VM · staging",
    },
    {
        icon: "mdi:account-check-outline",
        title: "Approve",
        detail: "m.chen approved",
        tone: "done",
    },
    {
        icon: "mdi:layers-outline",
        title: "Provision",
        detail: "Terraform · Ansible",
        tone: "live",
    },
    {
        icon: "mdi:server-outline",
        title: "Running",
        detail: "owner j.kim · 14-day lease",
        tone: "done",
    },
    {
        icon: "mdi:power",
        title: "Retire",
        detail: "lease ended · cleaned up",
    },
]
---

<section class="infra-hero" aria-labelledby="infra-hero-title">
    <PixelEdges left="tall" right="wide" />
    <div class="frame surface-dark" data-header-dark>
        <div class="container-xl">
            <div class="stage">
                <p class="eyebrow">
                    <img src={kestraMark.src} alt="" width="16" height="16" />
                    Kestra for Infrastructure
                </p>
                <h1 id="infra-hero-title">
                    Scale infrastructure requests in minutes
                </h1>
                <p class="lead">
                    Kestra automates every request, approval, and action on the
                    Terraform and Ansible code you already have.
                </p>
                <div class="buttons">
                    <a href="/demo" class="btn-solid">
                        Talk to our team <Icon name="mdi:chevron-right" />
                    </a>
                    <a href="#as-code" class="btn-ghost">
                        See how it works
                    </a>
                </div>

                <ol
                    class="life"
                    aria-label="The life of an infrastructure request, from request to retirement"
                >
                    {STAGES.map((stage) => (
                        <li class={stage.tone}>
                            <span class="glyph">
                                <Icon name={stage.icon} />
                            </span>
                            <strong>{stage.title}</strong>
                            <span>{stage.detail}</span>
                        </li>
                    ))}
                </ol>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .infra-hero {
        position: relative;
        margin-top: -67px;
        background: var(--ks-background-body);
    }

    .frame {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                46% 52% at 50% 104%,
                rgba(112, 88, 255, 0.5),
                rgba(70, 58, 235, 0.2) 50%,
                transparent 76%
            ),
            radial-gradient(
                40% 55% at 100% 0%,
                rgba(40, 110, 255, 0.22),
                transparent 62%
            ),
            radial-gradient(
                36% 50% at 0% 100%,
                rgba(70, 50, 210, 0.2),
                transparent 68%
            ),
            linear-gradient(165deg, #010103 0%, #05051a 52%, #010104 100%);
        color: #ffffff;

        &::after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent 10%,
                rgba(118, 100, 255, 0.75) 50%,
                transparent 90%
            );
        }
    }

    .stage {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 11rem clamp(1.5rem, 4vw, 3.5rem) 5.5rem;
        text-align: center;

        @include media-breakpoint-down(md) {
            padding: 8rem 0 3.5rem;
        }
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4375rem;
        margin: 0 0 1.5rem;
        padding: 0.3125rem 0.75rem 0.3125rem 0.5625rem;
        border: 1px solid rgba(190, 170, 255, 0.28);
        border-radius: 999px;
        background: linear-gradient(
            160deg,
            rgba(130, 115, 190, 0.16),
            rgba(22, 21, 30, 0.5)
        );
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: #ffffff;
    }

    h1 {
        max-width: 15em;
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.05;
        text-wrap: balance;
        color: #ffffff;
    }

    .lead {
        max-width: 38rem;
        margin: 1.5rem 0 0;
        font-size: 1.1875rem;
        line-height: 1.55;
        text-wrap: balance;
        color: rgba(255, 255, 255, 0.72);
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2.25rem;
    }

    .life {
        --glyph: 3.5rem;

        position: relative;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1rem;
        width: 100%;
        max-width: 64rem;
        margin: 5rem 0 0;
        padding: 0;
        list-style: none;

        &::before {
            content: "";
            position: absolute;
            top: calc(var(--glyph) / 2);
            right: 10%;
            left: 10%;
            height: 1px;
            background: linear-gradient(
                90deg,
                rgba(185, 166, 255, 0.2),
                #8f7bff,
                rgba(185, 166, 255, 0.2)
            );
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.25rem;
            max-width: 20rem;
            margin-top: 3.5rem;

            &::before {
                top: 0.5rem;
                right: auto;
                bottom: 0.5rem;
                left: calc(var(--glyph) / 2);
                width: 1px;
                height: auto;
            }
        }
    }

    li {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 0.25rem;
        font-size: 0.875rem;
        line-height: 1.4;
        color: rgba(255, 255, 255, 0.62);

        strong {
            margin-top: 0.75rem;
            font-size: 1.0625rem;
            font-weight: 600;
            color: #ffffff;
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: var(--glyph) minmax(0, 1fr);
            justify-items: start;
            column-gap: 1rem;
            text-align: left;

            strong {
                align-self: end;
                margin-top: 0;
            }

            .glyph {
                grid-row: span 2;
            }
        }
    }

    .glyph {
        display: grid;
        place-items: center;
        width: var(--glyph);
        height: var(--glyph);
        border: 1px solid rgba(185, 166, 255, 0.32);
        border-radius: 0.875rem;
        background: #121118;
        color: #c9b8ff;

        [data-icon] {
            width: 1.5rem;
            height: 1.5rem;
        }
    }

    .done .glyph {
        border-color: rgba(94, 227, 174, 0.5);
        color: #5ee3ae;
    }

    .live .glyph {
        border-color: #8f7bff;
        background: #6a2bf5;
        color: #ffffff;
        box-shadow: 0 0 0 0.375rem rgba(132, 92, 255, 0.2);
    }

    @media (prefers-reduced-motion: no-preference) {
        .live .glyph {
            animation: infra-hero-pulse 2.4s ease-in-out infinite;
        }
    }

    @keyframes infra-hero-pulse {
        50% {
            box-shadow: 0 0 0 0.75rem rgba(132, 92, 255, 0.06);
        }
    }
</style>
