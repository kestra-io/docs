---
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"
import kestraMark from "~/components/home/assets/ai/kestra-logo-mark-on-dark.svg"

const STAGES = [
    {
        icon: "mdi:file-document-outline",
        title: "Request",
        notes: {
            pending: "Linux VM · staging",
            live: "Linux VM · staging",
            done: "submitted by j.kim",
        },
    },
    {
        icon: "mdi:account-check-outline",
        title: "Approve",
        notes: {
            pending: "sign-off required",
            live: "waiting for m.chen",
            done: "m.chen approved",
        },
    },
    {
        icon: "mdi:layers-outline",
        title: "Provision",
        notes: {
            pending: "Terraform · Ansible",
            live: "Terraform · Ansible running",
            done: "provisioned in 4 min",
        },
    },
    {
        icon: "mdi:server-outline",
        title: "Running",
        notes: {
            pending: "14-day lease",
            live: "owner j.kim · 14-day lease",
            done: "lease ended",
        },
    },
    {
        icon: "mdi:power",
        title: "Retire",
        notes: {
            pending: "when the lease ends",
            live: "cleaning up",
            done: "cleaned up",
        },
    },
]

const ACTIVE = 2
const ARC = "M0 102.4 A131.1 1342.5 0 0 1 100 102.4"
---

<section class="infra-hero" aria-labelledby="infra-hero-title">
    <PixelEdges left="tall" right="wide" />
    <div class="frame surface-dark" data-header-dark>
        <div class="container-xl">
            <div class="stage">
                <p class="eyebrow">
                    <img src={kestraMark.src} alt="" width="16" height="16" />
                    Kestra for Infrastructure
                </p>
                <h1 id="infra-hero-title">
                    Scale infrastructure requests in minutes
                </h1>
                <p class="lead">
                    Kestra automates every request, approval, and action on the
                    Terraform and Ansible code you already have.
                </p>
                <div class="buttons">
                    <a href="/demo" class="btn-solid">
                        Talk to our team <Icon name="mdi:chevron-right" />
                    </a>
                    <a href="#as-code" class="btn-ghost">
                        See how it works
                    </a>
                </div>

                <div class="life" data-life style="--step: 2.4">
                    <div class="planet" aria-hidden="true"></div>
                    <svg
                        class="trail"
                        viewBox="0 0 100 100"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path d={ARC} />
                    </svg>
                    <ol
                        aria-label="The life of an infrastructure request, from request to retirement"
                    >
                        {STAGES.map((stage, index) => (
                            <li
                                class:list={{
                                    done: index < ACTIVE,
                                    live: index === ACTIVE,
                                }}
                            >
                                <span class="glyph">
                                    <Icon name={stage.icon} />
                                    <span class="sparks" aria-hidden="true">
                                        <i /><i /><i /><i />
                                    </span>
                                </span>
                                <strong>{stage.title}</strong>
                                <span class="note">
                                    {Object.entries(stage.notes).map(
                                        ([when, note]) => (
                                            <span
                                                data-when={when}
                                                aria-hidden={when !== "done"}
                                            >
                                                {note}
                                            </span>
                                        ),
                                    )}
                                </span>
                            </li>
                        ))}
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .infra-hero {
        position: relative;
        margin-top: -67px;
        background: var(--ks-background-body);
    }

    .frame {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                46% 52% at 50% 104%,
                rgba(112, 88, 255, 0.5),
                rgba(70, 58, 235, 0.2) 50%,
                transparent 76%
            ),
            radial-gradient(
                40% 55% at 100% 0%,
                rgba(40, 110, 255, 0.22),
                transparent 62%
            ),
            radial-gradient(
                36% 50% at 0% 100%,
                rgba(70, 50, 210, 0.2),
                transparent 68%
            ),
            linear-gradient(165deg, #010103 0%, #05051a 52%, #010104 100%);
        color: #ffffff;

        &::after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent 10%,
                rgba(118, 100, 255, 0.75) 50%,
                transparent 90%
            );
        }
    }

    .stage {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 11rem clamp(1.5rem, 4vw, 3.5rem) 5.5rem;
        text-align: center;

        @include media-breakpoint-down(md) {
            padding: 8rem 0 3.5rem;
        }
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4375rem;
        margin: 0 0 1.5rem;
        padding: 0.3125rem 0.75rem 0.3125rem 0.5625rem;
        border: 1px solid rgba(190, 170, 255, 0.28);
        border-radius: 999px;
        background: linear-gradient(
            160deg,
            rgba(130, 115, 190, 0.16),
            rgba(22, 21, 30, 0.5)
        );
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: #ffffff;
    }

    h1 {
        max-width: 15em;
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.05;
        text-wrap: balance;
        color: #ffffff;
    }

    .lead {
        max-width: 38rem;
        margin: 1.5rem 0 0;
        font-size: 1.1875rem;
        line-height: 1.55;
        text-wrap: balance;
        color: rgba(255, 255, 255, 0.72);
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2.25rem;
    }

    .life {
        --glyph: 3.5rem;
        --sag: 6.25cqw;
        container-type: inline-size;

        position: relative;
        width: 100%;
        max-width: 64rem;
        margin: 5rem 0 0;

        @include media-breakpoint-down(md) {
            max-width: 20rem;
            margin-top: 3.5rem;
        }
    }

    .planet {
        position: absolute;
        top: calc(var(--glyph) / 2);
        left: 50%;
        width: 262.2cqw;
        aspect-ratio: 1;
        border: 1px solid rgba(185, 166, 255, 0.4);
        border-radius: 50%;
        background:
            radial-gradient(
                52cqw 20cqw at 50% 0,
                rgba(88, 66, 220, 0.45),
                transparent
            ),
            #04040c;
        box-shadow:
            0 0 6rem rgba(112, 88, 255, 0.34),
            0 0 1rem rgba(165, 148, 255, 0.3),
            inset 0 0.5rem 2.5rem rgba(143, 123, 255, 0.22);
        transform: translateX(-50%);

        @include media-breakpoint-down(md) {
            display: none;
        }
    }

    .trail {
        --at: calc(10% + 20% * var(--step));

        position: absolute;
        top: calc(var(--glyph) / 2);
        left: 0;
        width: 100%;
        height: calc(var(--sag) * 1.5625);
        overflow: visible;
        filter: drop-shadow(0 0 0.375rem rgba(143, 123, 255, 0.9));
        mask-image:
            linear-gradient(
                90deg,
                transparent calc(var(--at) - 28%),
                #000 var(--at),
                transparent var(--at)
            ),
            linear-gradient(
                90deg,
                transparent 10%,
                #000 22%,
                #000 90%,
                transparent 94%
            );
        mask-composite: intersect;

        path {
            fill: none;
            stroke: #b9a6ff;
            stroke-width: 2;
            vector-effect: non-scaling-stroke;
        }

        @include media-breakpoint-down(md) {
            display: none;
        }
    }

    ol {
        position: relative;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        align-items: start;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.25rem;

            &::before {
                content: "";
                position: absolute;
                top: 0.5rem;
                bottom: 0.5rem;
                left: calc(var(--glyph) / 2);
                width: 1px;
                background: rgba(185, 166, 255, 0.28);
            }
        }
    }

    li {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 0.25rem;
        font-size: 0.8125rem;
        line-height: 1.4;
        color: rgba(255, 255, 255, 0.4);
        transition: color 0.6s ease;

        &:nth-child(1),
        &:nth-child(5) {
            margin-top: var(--sag);
        }

        &:nth-child(2),
        &:nth-child(4) {
            margin-top: calc(var(--sag) * 0.25);
        }

        strong {
            margin-top: calc(
                0.75rem + (var(--scale, 1) - 1) * var(--glyph) / 2
            );
            font-size: calc(1.0625rem * (0.6 + 0.4 * var(--scale, 1)));
            font-weight: 600;
            color: rgba(255, 255, 255, 0.6);
            transition: color 0.6s ease;
        }

        &.done,
        &.live {
            color: rgba(255, 255, 255, 0.72);

            strong {
                color: #ffffff;
            }
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: var(--glyph) minmax(0, 1fr);
            justify-items: start;
            column-gap: 1rem;
            text-align: left;

            &:nth-child(n) {
                margin-top: 0;
            }

            strong {
                align-self: end;
                margin-top: 0;
            }

            .glyph {
                grid-row: span 2;
            }
        }
    }

    @include media-breakpoint-up(md) {
        li:nth-child(1),
        li:nth-child(5) {
            --scale: 0.9;
        }

        li:nth-child(2),
        li:nth-child(4) {
            --scale: 1.15;
        }

        li:nth-child(3) {
            --scale: 1.4;
        }
    }

    li::before {
        content: "";
        position: absolute;
        top: calc(var(--glyph) / 2);
        left: 50%;
        width: calc(var(--glyph) * 2.8 * var(--scale, 1));
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(
            closest-side,
            rgba(143, 123, 255, 0.55),
            rgba(112, 88, 255, 0.16) 55%,
            transparent
        );
        opacity: 0;
        scale: 0.6;
        translate: -50% -50%;
        transition:
            opacity 0.6s ease,
            scale 0.6s ease;

        @include media-breakpoint-down(md) {
            left: calc(var(--glyph) / 2);
        }
    }

    .live::before {
        opacity: 1;
        scale: 1;
    }

    .note {
        display: grid;

        span {
            grid-area: 1 / 1;
            opacity: 0;
            transition: opacity 0.2s ease;
        }
    }

    li:not(.live, .done) [data-when="pending"],
    .live [data-when="live"],
    .done [data-when="done"] {
        opacity: 1;
        transition: opacity 0.35s ease 0.2s;
    }

    .glyph {
        position: relative;
        display: grid;
        transform: scale(var(--scale, 1));
        place-items: center;
        width: var(--glyph);
        height: var(--glyph);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 0.625rem;
        background: linear-gradient(
            180deg,
            rgba(48, 48, 58, 0.55),
            rgba(24, 24, 30, 0.55)
        );
        backdrop-filter: blur(0.75rem);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.12),
            0 10px 30px rgba(0, 0, 0, 0.5);
        color: rgba(255, 255, 255, 0.45);
        transition:
            transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
            border-color 0.6s ease,
            color 0.6s ease,
            box-shadow 0.6s ease;

        [data-icon] {
            width: 1.5rem;
            height: 1.5rem;
        }

        &::after {
            content: "";
            position: absolute;
            inset: -1px;
            padding: 1.5px;
            border-radius: inherit;
            background: conic-gradient(
                from var(--infra-hero-spin),
                transparent 0 55%,
                #b9a6ff 78%,
                #ffffff 92%,
                transparent
            );
            mask:
                linear-gradient(#000 0 0) content-box exclude,
                linear-gradient(#000 0 0);
            opacity: 0;
            transition: opacity 0.6s ease;
        }
    }

    .sparks {
        position: absolute;
        inset: 0;
    }

    .sparks i {
        position: absolute;
        width: var(--size, 0.5rem);
        aspect-ratio: 1;
        background: #ffffff;
        clip-path: polygon(
            50% 0,
            60% 40%,
            100% 50%,
            60% 60%,
            50% 100%,
            40% 60%,
            0 50%,
            40% 40%
        );
        opacity: 0;
        transition: opacity 0.6s ease;

        &:nth-child(1) {
            top: -0.875rem;
            left: -0.625rem;
        }

        &:nth-child(2) {
            --size: 0.3125rem;
            --delay: -0.5s;

            top: -0.5rem;
            right: -0.875rem;
        }

        &:nth-child(3) {
            --size: 0.375rem;
            --delay: -1s;

            bottom: -0.625rem;
            left: -1rem;
        }

        &:nth-child(4) {
            --size: 0.5625rem;
            --delay: -1.4s;

            right: -0.75rem;
            bottom: -0.875rem;
        }
    }

    .live .glyph::after {
        opacity: 1;
    }

    .live .sparks i {
        opacity: 0.8;
    }

    @media (prefers-reduced-motion: no-preference) {
        .live::before {
            animation: infra-hero-breathe 2.4s ease-in-out infinite;
        }

        .live .glyph::after {
            animation: infra-hero-spin 2.4s linear infinite;
        }

        .live .sparks i {
            animation: infra-hero-twinkle 1.8s ease-in-out infinite;
            animation-delay: var(--delay, 0s);
        }
    }

    @property --infra-hero-spin {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
    }

    @keyframes infra-hero-spin {
        to {
            --infra-hero-spin: 360deg;
        }
    }

    @keyframes infra-hero-breathe {
        50% {
            scale: 1.15;
        }
    }

    @keyframes infra-hero-twinkle {
        0%,
        100% {
            opacity: 0;
            scale: 0.4;
        }

        50% {
            opacity: 1;
            scale: 1;
        }
    }

    .done .glyph {
        color: #b9a6ff;
    }

    .live .glyph {
        border-color: rgba(255, 255, 255, 0.45);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.3),
            0 0 22px rgba(255, 255, 255, 0.12),
            0 10px 30px rgba(0, 0, 0, 0.5);
        color: #ffffff;
        transform: scale(calc(var(--scale, 1) * 1.14));
    }
</style>

<script>
    const life = document.querySelector<HTMLElement>("[data-life]")
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    if (life && !still) {
        const stages = [...life.querySelectorAll("li")]
        const LAP = 12000

        const frame = (now: number) => {
            const step = ((now % LAP) / LAP) * 5 - 0.5
            life.style.setProperty("--step", step.toFixed(3))
            const reached = Math.floor(step + 0.13)
            stages.forEach((stage, index) => {
                stage.classList.toggle("done", index < reached)
                stage.classList.toggle("live", index === reached)
            })
            requestAnimationFrame(frame)
        }

        requestAnimationFrame(frame)
    }
</script>
