---
import { Icon } from "astro-icon/components"
---

<section
    class="infra-closing surface-dark"
    aria-labelledby="infra-closing"
    data-header-dark
>
    <div class="haze" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
    </div>
    <div class="container-xl">
        <div class="rails">
            <h2 id="infra-closing">
                See Kestra for Infrastructure on your own code.
            </h2>
            <p>
                Talk to our sales and solution engineering team. We’ll walk
                through your requests, your code and the tools you want to
                replace.
            </p>
            <div class="ctas">
                <a href="/demo" class="btn-solid">
                    Talk to our team <Icon name="mdi:chevron-right" />
                </a>
                <a
                    href="/resources/whitepapers/infrastructure-orchestration"
                    class="btn-ghost"
                >
                    Read the whitepaper
                </a>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    @use "../about/style/section" as *;

    .infra-closing {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background: linear-gradient(180deg, #000000 30%, #17181e 100%);
        color: #ffffff;

        &::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
            height: 1px;
            background: rgba(255, 255, 255, 0.11);
        }
    }

    .rails {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 7.5rem clamp(1.5rem, 4vw, 3.5rem);
        border-inline: 1px solid rgba(255, 255, 255, 0.11);
        text-align: center;

        @include media-breakpoint-down(xl) {
            border-inline: 0;
        }

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem;
        }
    }

    .haze {
        position: absolute;
        inset: 0;
        z-index: -1;
        filter: blur(90px);

        i {
            position: absolute;
            width: 42%;
            aspect-ratio: 1.6;
            border-radius: 50%;
            background: #8a8c9c;
            opacity: 0.22;
            animation: infra-closing-drift 22s ease-in-out infinite alternate;
        }

        i:nth-child(1) {
            top: -40%;
            left: -6%;
        }

        i:nth-child(2) {
            top: 15%;
            right: -8%;
            background: #5c5e6c;
            opacity: 0.3;
            animation-duration: 27s;
            animation-delay: -9s;
        }

        i:nth-child(3) {
            bottom: -50%;
            left: 22%;
            background: #c9cbd8;
            opacity: 0.14;
            animation-duration: 31s;
            animation-delay: -15s;
        }

        i:nth-child(4) {
            top: -25%;
            left: 44%;
            width: 26%;
            background: #a3a5b6;
            opacity: 0.18;
            animation-duration: 19s;
            animation-delay: -5s;
        }
    }

    @keyframes infra-closing-drift {
        0% {
            transform: translate(-12%, -8%) scale(0.9);
        }

        50% {
            transform: translate(18%, 14%) scale(1.15);
        }

        100% {
            transform: translate(34%, -6%) scale(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .haze i {
            animation: none;
        }
    }

    h2 {
        @include title;
        max-width: 16em;
        font-size: clamp(2rem, 3.6vw, 3rem);
        color: #ffffff;
    }

    p {
        @include lead;
        max-width: 40rem;
        color: rgba(255, 255, 255, 0.72);
    }

    .ctas {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2.25rem;

        > a {
            max-width: 100%;
            white-space: normal;
            text-align: center;
        }

        @include media-breakpoint-down(sm) {
            flex-direction: column;
            align-self: stretch;

            > a {
                justify-content: center;
            }
        }
    }
</style>
