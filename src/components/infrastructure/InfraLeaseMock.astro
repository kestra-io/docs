---
import { Icon } from "astro-icon/components"
import kestraMark from "~/components/home/assets/ai/kestra-logo-mark-on-dark.svg"

const ROWS = [
    {
        id: "r-extend",
        icon: "mdi:server-outline",
        name: "dev-payments-api",
        owner: "Requester",
    },
    {
        id: "r-steady",
        icon: "mdi:database-outline",
        name: "stg-orders-db",
        owner: "a.diaz",
        lease: "21 days left",
    },
    {
        id: "r-retire",
        icon: "mdi:kubernetes",
        name: "qa-k8s-ns-42",
        owner: "r.patel",
    },
    {
        id: "r-steady",
        icon: "mdi:wall-fire",
        name: "edge-fw-rules",
        owner: "platform",
        lease: "No expiry",
    },
]

const OPTIONS = ["+7 days", "+14 days", "+30 days"]

const CODE = [
    { indent: 0, key: "id", value: "lease-cleanup" },
    { indent: 0, key: "namespace", value: "infra.lifecycle" },
    { indent: 0, key: "tasks" },
    { indent: 1, dash: true, key: "id", value: "destroy", task: 1 },
    {
        indent: 2,
        key: "type",
        value: "io.kestra.plugin.terraform.cli.TerraformCLI",
        group: 1,
    },
    { indent: 2, key: "commands", group: 1 },
    {
        indent: 3,
        dash: true,
        value: "terraform destroy -auto-approve",
        group: 1,
    },
    { indent: 1, dash: true, key: "id", value: "release", task: 2 },
    {
        indent: 2,
        key: "type",
        value: "io.kestra.plugin.core.kv.Delete",
        group: 2,
    },
    { indent: 2, key: "key", pebble: "inputs.deployment", group: 2 },
]
---

<div class="ui-mock lease-mock" aria-hidden="true" data-ui-mock>
    <div class="stage">
        <div class="list">
            <p class="head">
                <span>Deployment</span>
                <span>Owner</span>
                <span>Status</span>
                <span>Lease</span>
                <span></span>
            </p>
            {ROWS.map((row) => (
                <div class={`entry ${row.id}`}>
                    <span class="name">
                        <Icon name={row.icon} />
                        <b>{row.name}</b>
                    </span>
                    <span class="owner">{row.owner}</span>
                    <span class="status">
                        {row.id === "r-retire" ? (
                            <>
                                <i class="chip ok s-running">Running</i>
                                <i class="chip fail s-expired">Expired</i>
                                <i class="chip off s-retired">Retired</i>
                            </>
                        ) : (
                            <i class="chip ok">Running</i>
                        )}
                    </span>
                    <span class="lease">
                        {row.id === "r-extend" ? (
                            <>
                                <em class="warn l-before">2 days left</em>
                                <em class="l-after">16 days left</em>
                            </>
                        ) : row.id === "r-retire" ? (
                            <>
                                <em class="warn l-before">Ends today</em>
                                <em class="l-after">Ended</em>
                            </>
                        ) : (
                            <em>{row.lease}</em>
                        )}
                    </span>
                    <span class="action">
                        {row.lease !== "No expiry" && (
                            <span class="extend">
                                Extend <Icon name="mdi:chevron-down" />
                                {row.id === "r-extend" && (
                                    <span class="menu">
                                        {OPTIONS.map((option) => (
                                            <i
                                                class:list={{
                                                    on: option === "+14 days",
                                                }}
                                            >
                                                {option}
                                            </i>
                                        ))}
                                    </span>
                                )}
                            </span>
                        )}
                    </span>
                </div>
            ))}
        </div>
        <div class="cleanup">
            <p class="tabs">
                <span class="tab">
                    <span class="logo">
                        <img src={kestraMark.src} alt="" />
                    </span>
                    YAML
                </span>
                <span class="meta">qa-k8s-ns-42</span>
                <span class="state">
                    <i class="chip ok c-running">Running</i>
                    <i class="chip ok c-done">Success</i>
                </span>
            </p>
            <pre class="code">{
                CODE.map((line, idx) => (
                    <span
                        class:list={[
                            "ln",
                            line.task && `g${line.task}`,
                            line.group && `g${line.group}`,
                        ]}
                        style={`--indent: ${line.indent}`}
                    >
                        <i class="no">{idx + 1}</i>
                        {line.dash && <i class="dash">-</i>}
                        {line.key && (
                            <>
                                <i class="key">{line.key}</i>
                                <i class="punct">:</i>
                            </>
                        )}
                        {line.value && <i class="value">{line.value}</i>}
                        {line.pebble && (
                            <i class="value string">
                                "<i>{`{{ ${line.pebble} }}`}</i>"
                            </i>
                        )}
                        {line.task && (
                            <span class={`tick t${line.task}`}>
                                <Icon name="mdi:loading" class="spin" />
                                <Icon name="mdi:check" class="done" />
                            </span>
                        )}
                    </span>
                ))
            }</pre>
        </div>
        <p class="toast n1">
            <Icon name="mdi:check-circle" />
            dev-payments-api lease extended to 16 days
        </p>
        <p class="toast n2">
            <Icon name="mdi:check-circle" />
            qa-k8s-ns-42 retired by the cleanup flow
        </p>
        <span class="cursor">
            <svg viewBox="0 0 10 10">
                <path d="M0 0 L10 4 L5.5 5.5 L4 10 Z"></path>
            </svg>
            <span class="who">
                <Icon name="mdi:account-outline" />
                Requester
            </span>
        </span>
    </div>
</div>

<style lang="scss">
    @use "../enterprise/mocks/tokens" as *;

    .lease-mock {
        --loop: 20s;
        --fail: #c8322d;
        --fail-bg: #fdecec;
        --select: color-mix(in srgb, var(--text) 28%, transparent);
        --lift: -10.4em;

        @include tokens;
        @include soft;

        :global(html.dark) & {
            --fail: #ff8a84;
            --fail-bg: rgba(255, 107, 107, 0.14);
        }
    }

    .stage {
        position: relative;
        display: grid;
        align-content: center;
        gap: 1.2em;
        min-height: 38.8em;
        font-size: calc(100cqw / 50);
        line-height: 1.3;
        color: var(--text);
    }

    p {
        margin: 0;
    }

    [data-icon] {
        flex: none;
        width: 1.1em;
        height: 1.1em;
    }

    .list {
        position: relative;
        z-index: 1;
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--panel);
        box-shadow: var(--shadow);
    }

    .head,
    .entry {
        display: grid;
        grid-template-columns: 1.5fr 0.8fr 0.9fr 1fr 5.4em;
        align-items: center;
        gap: 0.8em;
        padding: 0 1.1em;
    }

    .head {
        height: 2.4em;
        border-bottom: 1px solid var(--line);

        span {
            font-size: 0.56em;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);
        }
    }

    .entry {
        position: relative;
        z-index: 0;
        height: 3.2em;

        &.r-extend {
            z-index: 2;
        }

        & + .entry {
            border-top: 1px solid var(--line);
        }

        &::after {
            content: "";
            position: absolute;
            inset: -0.15em -0.5em;
            z-index: -1;
            border: 1.5px solid var(--select);
            border-radius: 0.5em;
            background: var(--panel);
            box-shadow: var(--shadow);
            opacity: 0;
            pointer-events: none;
        }
    }

    .name {
        display: flex;
        align-items: center;
        gap: 0.55em;
        min-width: 0;

        [data-icon] {
            color: var(--soft);
        }

        b {
            overflow: hidden;
            font-size: 0.68em;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }

    .owner {
        font-size: 0.66em;
        color: var(--soft);
    }

    .status,
    .lease {
        display: grid;

        > * {
            grid-area: 1 / 1;
            justify-self: start;
        }
    }

    .chip {
        padding: 0.3em 0.6em;
        border-radius: 0.21em;
        font-size: 0.58em;
        font-style: normal;
        font-weight: 600;
        white-space: nowrap;

        &.ok {
            background: var(--ok-bg);
            color: var(--ok);
        }

        &.fail {
            background: var(--fail-bg);
            color: var(--fail);
        }

        &.off {
            background: var(--chip);
            color: var(--muted);
        }
    }

    .lease em {
        font-size: 0.66em;
        font-style: normal;
        font-weight: 500;
        white-space: nowrap;

        &.warn {
            color: var(--wait);
        }
    }

    .l-after,
    .s-expired,
    .s-retired,
    .c-done {
        opacity: 0;
    }

    .action {
        justify-self: end;
    }

    .extend {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
        padding: 0.35em 0.5em 0.35em 0.75em;
        border: 1px solid var(--line);
        border-radius: 0.24em;
        font-size: 0.62em;
        font-weight: 600;

        [data-icon] {
            color: var(--muted);
        }
    }

    .menu {
        position: absolute;
        top: calc(100% + 0.4em);
        right: 0;
        z-index: 2;
        display: grid;
        width: 8em;
        padding: 0.35em;
        font-size: 1.15em;
        font-weight: 500;
        border: 1px solid var(--line);
        border-radius: 0.32em;
        background: var(--panel);
        box-shadow: var(--shadow);
        opacity: 0;

        i {
            padding: 0.5em 0.6em;
            border-radius: 0.21em;
            font-style: normal;
        }

        .on {
            background: var(--chip);
        }
    }

    .cleanup {
        position: absolute;
        right: 0;
        bottom: 5.2em;
        left: 0;
        width: 27em;
        margin-inline: auto;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--panel);
        box-shadow: var(--shadow);
        opacity: 0;
    }

    .tabs {
        display: flex;
        align-items: flex-end;
        gap: 0.6em;
        height: 2.6em;
        padding: 0 0.9em;
        border-bottom: 1px solid var(--line);
        background: var(--deep);
    }

    .tab {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        height: 2.1em;
        margin-bottom: -1px;
        padding: 0 0.75em;
        border: 1px solid var(--line);
        border-bottom: 0;
        border-radius: 0.42em 0.42em 0 0;
        background: var(--panel);
        font-size: 0.72em;
        font-weight: 500;

        .logo {
            display: grid;
            place-items: center;
            width: 1.4em;
            height: 1.4em;
            border-radius: 0.32em;
            background: #0d0d10;

            img {
                width: 1em;
                height: 1em;
            }
        }
    }

    .meta {
        align-self: center;
        margin-left: auto;
        font-size: 0.62em;
        color: var(--muted);
    }

    .state {
        display: grid;
        align-self: center;

        > * {
            grid-area: 1 / 1;
            justify-self: end;
        }
    }

    .code {
        --c-key: #6d52f5;
        --c-text: #4a4a57;
        --c-string: #1c7e57;
        --c-no: #6d6d86;

        display: grid;
        margin: 0;
        padding: 0.8em 0 1.1em;
        font-family: var(--ks-font-monospace);
        font-size: 0.62em;
        line-height: 1.7;
        white-space: nowrap;

        :global(html.dark) & {
            --c-key: #b9a6ff;
            --c-text: #d6d6e0;
            --c-string: #7fd8b0;
            --c-no: #9696a5;
        }
    }

    .ln {
        position: relative;
        display: flex;
        align-items: center;
        padding-right: 1.6em;

        i {
            font-style: normal;
        }

        .no {
            box-sizing: border-box;
            flex: none;
            width: calc(3em + var(--indent) * 1.6em);
            padding-right: calc(1.4em + var(--indent) * 1.6em);
            text-align: right;
            color: var(--c-no);
        }

        .dash {
            margin-right: 1ch;
            color: var(--c-no);
        }

        .key,
        .punct {
            color: var(--c-key);
        }

        .punct + .value {
            margin-left: 1ch;
        }

        .value {
            color: var(--c-text);
        }

        .string {
            color: var(--c-string);
        }

        .tick {
            margin-left: auto;
            font-size: 1.4em;
        }
    }

    .tick {
        display: grid;
        width: 1.1em;
        height: 1.1em;

        > * {
            grid-area: 1 / 1;
        }

        .spin {
            color: var(--muted);
        }

        .done {
            color: var(--ok);
            opacity: 0;
        }
    }

    .toast {
        position: absolute;
        right: 0;
        bottom: 1.2em;
        left: 0;
        display: flex;
        align-items: center;
        gap: 0.6em;
        width: max-content;
        margin-inline: auto;
        padding: 0.8em 1.3em;
        border-radius: 0.5em;
        background: #18181e;
        box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.45);
        font-size: 0.86em;
        font-weight: 600;
        color: #ffffff;
        opacity: 0;

        :global(html.dark) & {
            background: #ffffff;
            color: #18181e;
        }

        [data-icon] {
            width: 1.3em;
            height: 1.3em;
            color: #2fd197;
        }
    }

    .cursor {
        --tone: 24, 24, 30;

        position: absolute;
        top: 0;
        left: 0;
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1em;
        translate: 3em 31em;
        pointer-events: none;

        :global(html.dark) & {
            --tone: 247, 247, 248;
        }

        svg {
            width: 1.1em;
            height: 1.1em;
            fill: rgb(var(--tone));
            filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
        }
    }

    .who {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        margin-left: 0.7em;
        padding: 0.15em 0.55em;
        border-radius: 0.32em;
        background: rgb(var(--tone));
        font-size: 0.7em;
        font-weight: 600;
        white-space: nowrap;
        color: #ffffff;

        :global(html.dark) & {
            border: 1px solid rgba(var(--tone), 0.45);
            background: rgb(20, 20, 24);
            color: rgb(var(--tone));
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .lease-mock:not([data-play]) * {
            animation-play-state: paused !important;
        }

        .stage {
            animation: lease-stage var(--loop) linear infinite both;
        }

        .cursor {
            animation: lease-cursor var(--loop) infinite both;
        }

        .entry.r-extend .extend {
            animation: lease-press var(--loop) linear infinite both;
        }

        .menu {
            animation: lease-menu var(--loop) ease-out infinite both;
        }

        .list {
            animation: lease-list var(--loop) ease-in-out infinite both;
        }

        .entry.r-extend::after {
            animation: lease-ring-extend var(--loop) linear infinite both;
        }

        .entry.r-extend .l-before {
            animation: lease-out-extend var(--loop) linear infinite both;
        }

        .entry.r-extend .l-after {
            animation: lease-in-extend var(--loop) linear infinite both;
        }

        .s-running,
        .entry.r-retire .l-before {
            animation: lease-out-expire var(--loop) linear infinite both;
        }

        .entry.r-retire .l-after {
            animation: lease-in-expire var(--loop) linear infinite both;
        }

        .s-expired {
            animation: lease-expired var(--loop) linear infinite both;
        }

        .s-retired {
            animation: lease-in-retire var(--loop) linear infinite both;
        }

        .entry.r-retire {
            animation: lease-fade-retire var(--loop) linear infinite both;
        }

        .cleanup {
            animation: lease-cleanup var(--loop) ease-out infinite both;
        }

        .ln.g1 {
            animation: lease-line-1 var(--loop) linear infinite both;
        }

        .ln.g2 {
            animation: lease-line-2 var(--loop) linear infinite both;
        }

        .t1 .spin {
            animation:
                lease-spin 1s linear infinite,
                lease-spin-1 var(--loop) linear infinite both;
        }

        .t2 .spin {
            animation:
                lease-spin 1s linear infinite,
                lease-spin-2 var(--loop) linear infinite both;
        }

        .t1 .done {
            animation: lease-done-1 var(--loop) linear infinite both;
        }

        .t2 .done {
            animation: lease-done-2 var(--loop) linear infinite both;
        }

        .c-running {
            animation: lease-out-cleanup var(--loop) linear infinite both;
        }

        .c-done {
            animation: lease-in-cleanup var(--loop) linear infinite both;
        }

        .toast.n1 {
            animation: lease-toast-1 var(--loop) ease-out infinite both;
        }

        .toast.n2 {
            animation: lease-toast-2 var(--loop) ease-out infinite both;
        }
    }

    @keyframes lease-list {
        0%,
        41% {
            translate: 0 0;
        }
        44%,
        90% {
            translate: 0 var(--lift);
        }
        94%,
        100% {
            translate: 0 0;
        }
    }

    @keyframes lease-stage {
        0%,
        94% {
            opacity: 1;
        }
        96%,
        97% {
            opacity: 0;
        }
        100% {
            opacity: 1;
        }
    }

    @keyframes lease-cursor {
        0%,
        4% {
            translate: 3em 31em;
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        9%,
        11% {
            translate: 46.85em 15.85em;
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        14%,
        16% {
            translate: 45.9em 19.55em;
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        24%,
        100% {
            translate: 3em 31em;
        }
    }

    @keyframes lease-press {
        0%,
        10% {
            scale: 1;
        }
        10.6% {
            scale: 0.9;
        }
        11.2%,
        100% {
            scale: 1;
        }
    }

    @keyframes lease-menu {
        0%,
        11% {
            opacity: 0;
            translate: 0 -0.3em;
        }
        12%,
        16% {
            opacity: 1;
            translate: 0 0;
        }
        17%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes lease-ring-extend {
        0%,
        10% {
            opacity: 0;
            scale: 0.97;
        }
        11%,
        20% {
            opacity: 1;
            scale: 1;
        }
        22%,
        100% {
            opacity: 0;
            scale: 0.97;
        }
    }

    @keyframes lease-out-extend {
        0%,
        16.5% {
            opacity: 1;
        }
        17%,
        100% {
            opacity: 0;
        }
    }

    @keyframes lease-in-extend {
        0%,
        16.5% {
            opacity: 0;
        }
        17%,
        100% {
            opacity: 1;
        }
    }

    @keyframes lease-toast-1 {
        0%,
        18% {
            opacity: 0;
            translate: 0 0.8em;
        }
        21%,
        31% {
            opacity: 1;
            translate: 0 0;
        }
        34%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes lease-out-expire {
        0%,
        39.5% {
            opacity: 1;
        }
        40%,
        100% {
            opacity: 0;
        }
    }

    @keyframes lease-in-expire {
        0%,
        39.5% {
            opacity: 0;
        }
        40%,
        100% {
            opacity: 1;
        }
    }

    @keyframes lease-expired {
        0%,
        39.5% {
            opacity: 0;
        }
        40%,
        63.5% {
            opacity: 1;
        }
        64%,
        100% {
            opacity: 0;
        }
    }

    @keyframes lease-in-retire {
        0%,
        63.5% {
            opacity: 0;
        }
        64%,
        100% {
            opacity: 1;
        }
    }

    @keyframes lease-fade-retire {
        0%,
        65% {
            opacity: 1;
        }
        68%,
        100% {
            opacity: 0.45;
        }
    }

    @keyframes lease-cleanup {
        0%,
        43% {
            opacity: 0;
            translate: 0 0.8em;
        }
        46%,
        84% {
            opacity: 1;
            translate: 0 0;
        }
        87%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes lease-line-1 {
        0%,
        45.5%,
        53.5%,
        100% {
            background: transparent;
        }
        46%,
        53% {
            background: var(--chip);
        }
    }

    @keyframes lease-line-2 {
        0%,
        53%,
        60.5%,
        100% {
            background: transparent;
        }
        53.5%,
        60% {
            background: var(--chip);
        }
    }

    @keyframes lease-spin {
        to {
            rotate: 360deg;
        }
    }

    @keyframes lease-spin-1 {
        0%,
        52.5% {
            opacity: 1;
        }
        53%,
        100% {
            opacity: 0;
        }
    }

    @keyframes lease-spin-2 {
        0%,
        52.5% {
            opacity: 0.35;
        }
        53%,
        59.5% {
            opacity: 1;
        }
        60%,
        100% {
            opacity: 0;
        }
    }

    @keyframes lease-done-1 {
        0%,
        52.5% {
            opacity: 0;
        }
        53%,
        100% {
            opacity: 1;
        }
    }

    @keyframes lease-done-2 {
        0%,
        59.5% {
            opacity: 0;
        }
        60%,
        100% {
            opacity: 1;
