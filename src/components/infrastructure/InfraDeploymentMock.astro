---
import { Icon } from "astro-icon/components"

const FIELDS = [
    { label: "Namespace", value: "infrastructure.examples" },
    { label: "Owner", value: "Payments team" },
    { label: "Type", value: "Deployment", chip: true },
    { label: "Cost center", value: "CC-1042" },
]

const RESOURCES = [
    { name: "web-staging-api-1", kind: "VM" },
    { name: "web-staging-api-2", kind: "VM" },
    { name: "web.sessions", kind: "Table" },
]

const RUNS = [
    { id: "r-provision", name: "provision", when: "Oct 13" },
    { id: "r-configure", name: "configure", when: "Oct 13" },
    { id: "r-extend", name: "extend-lease", when: "Today" },
    { id: "r-snapshot", name: "snapshot", when: "Today" },
]
---

<div class="ui-mock deploy-mock" aria-hidden="true" data-ui-mock>
    <div class="stage">
        <p class="title">
            <b>web-platform-staging</b>
            <i class="kind">Deployment</i>
            <span class="live">
                <i class="dot"></i>Active
            </span>
        </p>
        <div class="box c-info">
            <p class="ch">Web platform (staging)</p>
            <div class="kv">
                {FIELDS.map((field) => (
                    <span class="field">
                        <span class="label">{field.label}</span>
                        {field.chip ? (
                            <i class="kind">{field.value}</i>
                        ) : (
                            <span class="val">{field.value}</span>
                        )}
                    </span>
                ))}
            </div>
        </div>
        <div class="box c-lease">
            <p class="ch">
                TTL &amp; Lease
                <span class="left">
                    <span class="swap">
                        <em class="e-before">Expires in 2w 3d</em>
                        <em class="e-after">Expires in 4w 3d</em>
                    </span>
                    <span class="bar">
                        <i></i>
                    </span>
                </span>
            </p>
            <div class="strip">
                <span class="field">
                    <span class="label">Expires</span>
                    <span class="val">
                        <span class="swap">
                            <em class="d-before">Nov 21, 2026</em>
                            <em class="d-after">Dec 5, 2026</em>
                        </span>
                        <span class="pen">
                            <Icon name="mdi:pencil-outline" />
                            <span class="menu m-lease">
                                <i>+7 days</i>
                                <i class="on">+14 days</i>
                                <i>+30 days</i>
                            </span>
                        </span>
                    </span>
                </span>
                <span class="hooks">
                    <span class="pill">
                        <Icon name="mdi:clock-alert-outline" /> On expiring
                    </span>
                    <span class="pill">
                        <Icon name="mdi:clock-remove-outline" /> On expired
                    </span>
                </span>
            </div>
        </div>
        <div class="box c-actions">
            <p class="ch">Actions</p>
            <div class="strip">
                <span class="muted">3 actions configured</span>
                <span class="open">
                    <Icon name="mdi:play-circle-outline" /> Open actions
                    <span class="menu m-actions">
                        <i class="on">
                            <Icon name="mdi:camera-outline" /> Snapshot
                        </i>
                        <i>
                            <Icon name="mdi:arrow-expand-all" /> Resize
                        </i>
                        <i>
                            <Icon name="mdi:restart" /> Restart
                        </i>
                    </span>
                </span>
            </div>
        </div>
        <div class="box c-inv">
            <p class="ch">Inventory</p>
            {RESOURCES.map((resource) => (
                <p class="res">
                    <i class="dot"></i>
                    <span>{resource.name}</span>
                    <i class="tag">{resource.kind}</i>
                </p>
            ))}
        </div>
        <div class="box c-exec">
            <p class="ch">Executions</p>
            {RUNS.map((run) => (
                <p class={`run ${run.id}`}>
                    <span class="state">
                        <Icon name="mdi:check-circle" class="done" />
                        <Icon name="mdi:loading" class="spin" />
                    </span>
                    <span class="name">{run.name}</span>
                    <span class="when">{run.when}</span>
                </p>
            ))}
        </div>
        <p class="toast t1">
            <Icon name="mdi:check-circle" />
            Lease extended to Dec 5, 2026
        </p>
        <p class="toast t2">
            <Icon name="mdi:check-circle" />
            Snapshot of web-platform-staging completed
        </p>
        <span class="cursor">
            <svg viewBox="0 0 10 10">
                <path d="M0 0 L10 4 L5.5 5.5 L4 10 Z"></path>
            </svg>
            <span class="who">
                <Icon name="mdi:account-outline" />
                Requester
            </span>
        </span>
    </div>
</div>

<style lang="scss">
    @use "../enterprise/mocks/tokens" as *;

    .deploy-mock {
        --loop: 18s;
        --rest: 3em 35em;
        --at-pen: 6.9em 20.4em;
        --at-option: 8.6em 23.5em;
        --at-open: 26.3em 28.4em;
        --at-snap: 26.4em 30.3em;

        @include tokens;
        @include soft;
    }

    .stage {
        --lift: 3em;

        position: relative;
        min-height: 38.8em;
        translate: 0 var(--lift);
        font-size: calc(100cqw / 50);
        line-height: 1.3;
        color: var(--text);
    }

    p {
        margin: 0;
    }

    [data-icon] {
        flex: none;
        width: 1.1em;
        height: 1.1em;
    }

    i {
        font-style: normal;
    }

    .title {
        position: absolute;
        top: 2.4em;
        right: 1.5em;
        left: 1.5em;
        display: flex;
        align-items: center;
        gap: 0.6em;

        b {
            font-size: 0.86em;
            font-weight: 600;
        }
    }

    .kind {
        justify-self: start;
        width: fit-content;
        padding: 0.2em 0.5em;
        border-radius: 0.21em;
        background: var(--chip);
        font-size: 0.56em;
        font-weight: 600;
        color: var(--soft);
    }

    .live {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        margin-left: auto;
        font-size: 0.6em;
        font-weight: 600;
        color: var(--ok);
    }

    .dot {
        width: 0.5em;
        height: 0.5em;
        border-radius: 99em;
        background: currentColor;
    }

    .box {
        position: absolute;
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--panel);
        box-shadow: var(--shadow);
    }

    .c-info {
        top: 5.5em;
        left: 1.5em;
        width: 29em;
        height: 9.6em;
    }

    .c-lease {
        top: 16.3em;
        left: 1.5em;
        z-index: 2;
        width: 29em;
        height: 7.6em;
    }

    .c-actions {
        top: 25.1em;
        left: 1.5em;
        z-index: 1;
        width: 29em;
        height: 5.4em;
    }

    .c-inv {
        top: 5.5em;
        left: 31.7em;
        width: 16.8em;
        height: 9.6em;
    }

    .c-exec {
        top: 16.3em;
        left: 31.7em;
        width: 16.8em;
        height: 14.2em;
    }

    .ch {
        display: flex;
        align-items: center;
        gap: 0.8em;
        height: 2.6em;
        padding: 0 1em;
        border-bottom: 1px solid var(--line);
        font-size: 0.66em;
        font-weight: 600;
    }

    .kv {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.9em 1em;
        padding: 0.9em 1em;
    }

    .field {
        display: grid;
        gap: 0.35em;
    }

    .label {
        font-size: 0.5em;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .val {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-size: 0.62em;
    }

    .swap {
        display: grid;

        > * {
            grid-area: 1 / 1;
            font-style: normal;
            white-space: nowrap;
        }
    }

    .e-after,
    .d-after {
        opacity: 0;
    }

    .left {
        display: grid;
        justify-items: end;
        gap: 0.35em;
        margin-left: auto;
        font-size: 0.85em;
        font-weight: 600;
        color: var(--muted);
    }

    .bar {
        position: relative;
        width: 9em;
        height: 0.32em;
        overflow: hidden;
        border-radius: 99em;
        background: var(--chip);

        i {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: var(--text);
            transform: scaleX(0.35);
            transform-origin: left;
        }
    }

    .strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1em;
        padding: 0.9em 1em;
    }

    .pen {
        position: relative;
        display: grid;
        place-items: center;
        width: 1.7em;
        height: 1.7em;
        border-radius: 0.3em;
        color: var(--muted);
    }

    .hooks {
        display: flex;
        gap: 0.4em;
    }

    .pill,
    .open {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        padding: 0.45em 0.7em;
        border: 1px solid var(--line);
        border-radius: 0.32em;
        font-size: 0.56em;
        font-weight: 600;
        white-space: nowrap;
    }

    .open {
        position: relative;
        font-size: 0.6em;
    }

    .muted {
        font-size: 0.6em;
        color: var(--muted);
    }

    .menu {
        position: absolute;
        top: calc(100% + 0.4em);
        left: 0;
        z-index: 3;
        display: grid;
        width: max-content;
        min-width: 8em;
        padding: 0.35em;
        border: 1px solid var(--line);
        border-radius: 0.32em;
        background: var(--panel);
        box-shadow: var(--shadow);
        font-size: 1.15em;
        font-weight: 500;
        color: var(--text);
        opacity: 0;

        i {
            display: flex;
            align-items: center;
            gap: 0.45em;
            padding: 0.5em 0.6em;
            border-radius: 0.21em;
        }
    }

    .m-lease {
        font-size: 1em;
    }

    .m-actions {
        right: 0;
        left: auto;
        font-size: 1em;
    }

    .res,
    .run {
        display: flex;
        align-items: center;
        gap: 0.55em;
        margin: 0 0.9em;
        padding: 0.62em 0;
        font-size: 0.6em;

        & + & {
            border-top: 1px solid var(--line);
        }
    }

    .res .dot {
        color: var(--ok);
    }

    .tag {
        margin-left: auto;
        padding: 0.15em 0.45em;
        border-radius: 0.21em;
        background: var(--chip);
        font-size: 0.85em;
        font-weight: 600;
        color: var(--muted);
    }

    .run {
        .name {
            font-family: var(--ks-font-monospace);
            font-size: 0.95em;
        }

        .when {
            margin-left: auto;
            color: var(--muted);
        }
    }

    .state {
        display: grid;
        width: 1.2em;
        height: 1.2em;

        > * {
            grid-area: 1 / 1;
            width: 100%;
            height: 100%;
        }

        .done {
            color: var(--ok);
        }

        .spin {
            color: var(--muted);
            opacity: 0;
        }
    }

    .r-extend,
    .r-snapshot {
        opacity: 0;
    }

    .toast {
        position: absolute;
        right: 0;
        bottom: calc(1.6em + var(--lift));
        left: 0;
        display: flex;
        align-items: center;
        gap: 0.6em;
        width: max-content;
        margin-inline: auto;
        padding: 0.8em 1.3em;
        border-radius: 0.5em;
        background: #18181e;
        box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.45);
        font-size: 0.86em;
        font-weight: 600;
        color: #ffffff;
        opacity: 0;

        :global(html.dark) & {
            background: #ffffff;
            color: #18181e;
        }

        [data-icon] {
            width: 1.3em;
            height: 1.3em;
            color: #2fd197;
        }
    }

    .cursor {
        --tone: 204, 62, 138;

        position: absolute;
        top: 0;
        left: 0;
        z-index: 4;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1em;
        translate: var(--rest);
        opacity: 0;
        pointer-events: none;

        :global(html.dark) & {
            --tone: 240, 140, 190;
        }

        svg {
            width: 1.1em;
            height: 1.1em;
            fill: rgb(var(--tone));
            filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
        }
    }

    .who {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        margin-left: 0.7em;
        padding: 0.15em 0.55em;
        border-radius: 0.32em;
        background: rgb(var(--tone));
        font-size: 0.7em;
        font-weight: 600;
        white-space: nowrap;
        color: #ffffff;

        :global(html.dark) & {
            border: 1px solid rgba(var(--tone), 0.45);
            background: rgb(20, 20, 24);
            color: rgb(var(--tone));
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .deploy-mock:not([data-play]) * {
            animation-play-state: paused !important;
        }

        .title {
            animation: deploy-enter-0 var(--loop) ease-out infinite both;
        }

        .c-info {
            animation: deploy-enter-1 var(--loop) ease-out infinite both;
        }

        .c-inv {
            animation: deploy-enter-2 var(--loop) ease-out infinite both;
        }

        .c-lease {
            animation: deploy-enter-3 var(--loop) ease-out infinite both;
        }

        .c-exec {
            animation: deploy-enter-4 var(--loop) ease-out infinite both;
        }

        .c-actions {
            animation: deploy-enter-5 var(--loop) ease-out infinite both;
        }

        .cursor {
            animation:
                deploy-cursor var(--loop) infinite both,
                deploy-cursor-show var(--loop) linear infinite both;
        }

        .pen {
            animation:
                deploy-press-pen var(--loop) linear infinite both,
                deploy-pen-focus var(--loop) linear infinite both;
        }

        .m-lease {
            animation: deploy-menu-lease var(--loop) ease-out infinite both;
        }

        .m-lease .on {
            animation: deploy-option-lease var(--loop) linear infinite both;
        }

        .e-before,
        .d-before {
            animation: deploy-out-extend var(--loop) linear infinite both;
        }

        .e-after,
        .d-after {
            animation: deploy-in-extend var(--loop) linear infinite both;
        }

        .bar i {
            animation: deploy-bar var(--loop) cubic-bezier(0.22, 1, 0.36, 1)
                infinite both;
        }

        .r-extend {
            animation: deploy-run-extend var(--loop) ease-out infinite both;
        }

        .open {
            animation: deploy-press-open var(--loop) linear infinite both;
        }

        .m-actions {
            animation: deploy-menu-actions var(--loop) ease-out infinite both;
        }

        .m-actions .on {
            animation: deploy-option-actions var(--loop) linear infinite both;
        }

        .r-snapshot {
            animation: deploy-run-snapshot var(--loop) ease-out infinite both;
        }

        .r-snapshot .spin {
            animation:
                deploy-spin 1s linear infinite,
                deploy-snap-spin var(--loop) linear infinite both;
        }

        .r-snapshot .done {
            animation: deploy-snap-done var(--loop) linear infinite both;
        }

        .toast.t1 {
            animation: deploy-toast-1 var(--loop) ease-out infinite both;
        }

        .toast.t2 {
            animation: deploy-toast-2 var(--loop) ease-out infinite both;
        }
    }

    @keyframes deploy-enter-0 {
        0%,
        0% {
            opacity: 0;
            translate: 0 0.8em;
        }
        4%,
        94% {
            opacity: 1;
            translate: 0 0;
        }
        96%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-enter-1 {
        0%,
        1% {
            opacity: 0;
            translate: 0 0.8em;
        }
        5%,
        94% {
            opacity: 1;
            translate: 0 0;
        }
        96%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-enter-2 {
        0%,
        2% {
            opacity: 0;
            translate: 0 0.8em;
        }
        6%,
        94% {
            opacity: 1;
            translate: 0 0;
        }
        96%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-enter-3 {
        0%,
        3% {
            opacity: 0;
            translate: 0 0.8em;
        }
        7%,
        94% {
            opacity: 1;
            translate: 0 0;
        }
        96%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-enter-4 {
        0%,
        4% {
            opacity: 0;
            translate: 0 0.8em;
        }
        8%,
        94% {
            opacity: 1;
            translate: 0 0;
        }
        96%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-enter-5 {
        0%,
        5% {
            opacity: 0;
            translate: 0 0.8em;
        }
        9%,
        94% {
            opacity: 1;
            translate: 0 0;
        }
        96%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-cursor {
        0%,
        14% {
            translate: var(--rest);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        20%,
        22% {
            translate: var(--at-pen);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        25%,
        27% {
            translate: var(--at-option);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        45%,
        48% {
            translate: var(--at-open);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        52%,
        54% {
            translate: var(--at-snap);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        62%,
        100% {
            translate: var(--rest);
        }
    }

    @keyframes deploy-cursor-show {
        0%,
        12% {
            opacity: 0;
        }
        14%,
        60% {
            opacity: 1;
        }
        63%,
        100% {
            opacity: 0;
        }
    }

    @keyframes deploy-press-pen {
        0%,
        20.5% {
            scale: 1;
        }
        21% {
            scale: 0.92;
        }
        21.5%,
        100% {
            scale: 1;
        }
    }

    @keyframes deploy-pen-focus {
        0%,
        21% {
            background: transparent;
        }
        22%,
        27% {
            background: var(--chip);
        }
        28%,
        100% {
            background: transparent;
        }
    }

    @keyframes deploy-menu-lease {
        0%,
        21.5% {
            opacity: 0;
            translate: 0 -0.3em;
        }
        22.5%,
        27% {
            opacity: 1;
            translate: 0 0;
        }
        28%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-option-lease {
        0%,
        24.5% {
            background: transparent;
        }
        25%,
        100% {
            background: var(--chip);
        }
    }

    @keyframes deploy-out-extend {
        0%,
        27% {
            opacity: 1;
        }
        27.5%,
        100% {
            opacity: 0;
        }
    }

    @keyframes deploy-in-extend {
        0%,
        27% {
            opacity: 0;
        }
        27.5%,
        100% {
            opacity: 1;
        }
    }

    @keyframes deploy-bar {
        0%,
        27.5% {
            transform: scaleX(0.35);
        }
        32%,
        100% {
            transform: scaleX(0.7);
        }
    }

    @keyframes deploy-run-extend {
        0%,
        28% {
            opacity: 0;
            translate: 0 0.4em;
        }
        30%,
        100% {
            opacity: 1;
            translate: 0 0;
        }
    }

    @keyframes deploy-toast-1 {
        0%,
        28% {
            opacity: 0;
            translate: 0 0.8em;
        }
        31%,
        39% {
            opacity: 1;
            translate: 0 0;
        }
        42%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-press-open {
        0%,
        46.5% {
            scale: 1;
        }
        47% {
            scale: 0.92;
        }
        47.5%,
        100% {
            scale: 1;
        }
    }

    @keyframes deploy-menu-actions {
        0%,
        47.5% {
            opacity: 0;
            translate: 0 -0.3em;
        }
        48.5%,
        54% {
            opacity: 1;
            translate: 0 0;
        }
        55%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @keyframes deploy-option-actions {
        0%,
        51.5% {
            background: transparent;
        }
        52%,
        100% {
            background: var(--chip);
        }
    }

    @keyframes deploy-run-snapshot {
        0%,
        54.5% {
            opacity: 0;
            translate: 0 0.4em;
        }
        56.5%,
        100% {
            opacity: 1;
            translate: 0 0;
        }
    }

    @keyframes deploy-spin {
        to {
            rotate: 360deg;
        }
    }

    @keyframes deploy-snap-spin {
        0%,
        63.5% {
            opacity: 1;
        }
        64%,
        100% {
            opacity: 0;
        }
    }

    @keyframes deploy-snap-done {
        0%,
        63.5% {
            opacity: 0;
        }
        64%,
        100% {
            opacity: 1;
        }
    }

    @keyframes deploy-toast-2 {
        0%,
        64% {
            opacity: 0;
            translate: 0 0.8em;
        }
        67%,
        88% {
            opacity: 1;
            translate: 0 0;
        }
        91%,
        100% {
            opacity: 0;
            translate: 0 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .e-before,
        .d-before {
            opacity: 0;
