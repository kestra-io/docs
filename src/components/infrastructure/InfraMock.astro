---
import { Icon } from "astro-icon/components"

interface Props {
    view: "inventory"
}

const { view } = Astro.props

const NAV = [
    { id: "catalog", icon: "mdi:view-grid-outline" },
    { id: "requests", icon: "mdi:file-document-outline" },
    { id: "deployments", icon: "mdi:server-outline" },
    { id: "runs", icon: "mdi:refresh" },
    { id: "cases", icon: "mdi:alert-outline" },
    { id: "inventory", icon: "mdi:layers-outline" },
]

const VIEWS = {
    inventory: {
        crumb: "Inventory",
        title: "Inventory",
        sub: "Every resource you create, its owner and what depends on it.",
    },
}

const ASSETS = [
    { id: "vpc", name: "vpc-staging", kind: "network", icon: "mdi:web" },
    {
        id: "api",
        name: "dev-payments-api",
        kind: "server",
        icon: "mdi:server-outline",
        focus: true,
    },
    {
        id: "dns",
        name: "api.staging.acme",
        kind: "dns record",
        icon: "mdi:web",
    },
    {
        id: "db",
        name: "stg-orders-db",
        kind: "database",
        icon: "mdi:database-outline",
    },
    {
        id: "flow",
        name: "deploy_payments",
        kind: "flow",
        icon: "mdi:file-tree-outline",
    },
]

const current = VIEWS[view]
---

<div class={`ui-mock infra-mock ${view}`} aria-hidden="true" data-ui-mock>
    <div class="window">
        <p class="bar">
            <span class="brand">kestra</span>
            <span class="crumb">
                infra / <b>{current.crumb}</b>
            </span>
        </p>
        <div class="body">
            <p class="nav">
                {NAV.map((item) => (
                    <span class:list={{ on: item.id === view }}>
                        <Icon name={item.icon} />
                    </span>
                ))}
            </p>
            <div class="main">
                <p class="title">{current.title}</p>
                <p class="sub">{current.sub}</p>

                {view === "inventory" && (
                    <div class="map">
                        <svg viewBox="0 0 100 60" preserveAspectRatio="none">
                            <path d="M31 30 C35 30 33 15 37 15" />
                            <path d="M31 30 C35 30 33 45 37 45" />
                            <path d="M65 15 H71" />
                            <path d="M65 15 C69 15 67 45 71 45" />
                            <path d="M65 45 H71" />
                        </svg>
                        {ASSETS.map((asset) => (
                            <p
                                class:list={[
                                    "asset",
                                    asset.id,
                                    { focus: asset.focus },
                                ]}
                            >
                                <Icon name={asset.icon} />
                                <span>
                                    <b>{asset.name}</b>
                                    <small>{asset.kind}</small>
                                </span>
                            </p>
                        ))}
                        <p class="owner">Owner j.kim · lease 3d</p>
                    </div>
                )}
            </div>
        </div>
    </div>
</div>

<style lang="scss">
    @use "../enterprise/mocks/tokens" as *;

    .infra-mock {
        @include tokens;
        @include soft;
    }

    .window {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 0.64em;
        background: var(--panel);
        box-shadow: var(--shadow);
        font-size: calc(100cqw / 50);
        line-height: 1.3;
        color: var(--text);
    }

    p {
        margin: 0;
    }

    b {
        font-weight: 600;
    }

    small {
        display: block;
        font-size: 0.62em;
        color: var(--muted);
    }

    [data-icon] {
        flex: none;
        width: 1.1em;
        height: 1.1em;
    }

    .bar {
        display: flex;
        align-items: center;
        gap: 1.4em;
        padding: 0.8em 1.2em;
        border-bottom: 1px solid var(--line);
        background: var(--deep);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-size: 0.9em;
        font-weight: 700;

        &::before {
            content: "";
            width: 0.7em;
            height: 0.7em;
            border-radius: 0.1em;
            background: var(--tile-ink);
            rotate: 45deg;

            :global(html.dark) & {
                background: var(--run);
            }
        }
    }

    .crumb {
        font-size: 0.68em;
        color: var(--muted);

        b {
            color: var(--text);
        }
    }

    .body {
        display: grid;
        grid-template-columns: 3.4em minmax(0, 1fr);
    }

    .nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7em;
        padding-top: 1em;
        border-right: 1px solid var(--line);
        background: var(--deep);
        color: var(--muted);

        span {
            display: grid;
            place-items: center;
            width: 2em;
            height: 2em;
            border-radius: 0.36em;
        }

        .on {
            background: var(--chip);
            color: var(--run);
        }
    }

    .main {
        min-height: 36em;
        padding: 1.4em 1.5em 1.6em;
    }

    .title {
        font-size: 1em;
        font-weight: 700;
    }

    .sub {
        margin: 0.2em 0 1.1em;
        font-size: 0.66em;
        color: var(--muted);
    }

    .map {
        position: relative;
        height: 19em;
        border-radius: 0.5em;
        background: radial-gradient(var(--line) 1px, transparent 1.5px) 0 0 /
            1.1em 1.1em;

        > svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        path {
            fill: none;
            stroke: var(--ring);
            stroke-width: 1.5;
            vector-effect: non-scaling-stroke;
            opacity: 0.55;
        }
    }

    .asset {
        position: absolute;
        translate: 0 -50%;
        display: flex;
        align-items: center;
        gap: 0.6em;
        width: 28%;
        padding: 0.7em 0.8em;
        border: 1px solid var(--line);
        border-radius: 0.42em;
        background: var(--panel);

        [data-icon] {
            color: var(--run);
        }

        b {
            display: block;
            overflow: hidden;
            font-size: 0.64em;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        span {
            min-width: 0;
        }

        &.focus {
            --select: color-mix(in srgb, var(--text) 28%, transparent);

            border-color: var(--select);
            box-shadow: 0 0 0 1px var(--select);
        }

        &.vpc {
            top: 50%;
            left: 3%;
        }

        &.api {
            top: 25%;
            left: 37%;
        }

        &.db {
            top: 75%;
            left: 37%;
        }

        &.dns {
            top: 25%;
            left: 71%;
        }

        &.flow {
            top: 75%;
            left: 71%;
        }
    }

    .owner {
        position: absolute;
        top: 2%;
        left: 37%;
        padding: 0.35em 0.8em;
        border: 1px solid var(--line);
        border-radius: 0.36em;
        background: var(--deep);
        font-size: 0.58em;
        font-weight: 600;
        color: var(--muted);
    }
</style>
