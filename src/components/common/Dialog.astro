---
// A `dialog.modal` shell (src/assets/styles/components/_modal.scss): the
// scrim, a centred `.modal-content` and a close button. Open it from any
// element with `data-modal-target="#id"`; src/scripts/modal.ts opens it and
// closes it from the button or the scrim.
interface Props {
    id: string
    label: string
    class?: string
    /** Overrides the modal's `--ks-modal-width` (default 500px). */
    width?: string
}

const { id, label, class: className, width } = Astro.props
---

<dialog
    class:list={["modal ks-dialog", className]}
    {id}
    aria-label={label}
    closedby="any"
    style={width ? `--ks-modal-width: ${width}` : undefined}
>
    <div class="modal-dialog">
        <div class="modal-content">
            <button
                type="button"
                class="btn-close"
                commandfor={id}
                command="close"
                aria-label="Close">X</button
            >
            <slot />
        </div>
    </div>
</dialog>

<style lang="scss">
    .ks-dialog {
        .modal-dialog {
            display: flex;
            align-items: center;
            min-height: calc(100% - var(--ks-modal-margin) * 2);
        }

        .btn-close {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            z-index: 2;
            border: 0;
            background: transparent;
            color: var(--ks-content-secondary);
            font-size: $font-size-md;

            &:hover {
                color: var(--ks-content-primary);
            }
        }
    }
</style>
