---
interface Props {
    group: string
    index: number
    selected?: number
}

const { group, index, selected = 1 } = Astro.props
---

<div
    class="ks-tab-panel"
    role="tabpanel"
    id={`${group}-panel-${index}`}
    aria-labelledby={`${group}-tab-${index}`}
    tabindex="0"
    hidden={index !== selected}
>
    <slot />
</div>

<style lang="scss">
    .ks-tab-panel {
        padding: 1rem 1.25rem;
        border: 1px solid var(--ks-border-secondary);
        border-radius: $border-radius-lg;

        > :global(:first-child) {
            margin-top: 0;
        }

        > :global(:last-child) {
            margin-bottom: 0;
        }
    }
</style>
