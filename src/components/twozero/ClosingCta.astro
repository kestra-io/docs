---
import Cta from "./Cta.astro"
import twoZero from "./assets/two-zero.svg?no-inline"
import squares from "./assets/hero-squares.svg?url"

/* Both CTAs carry the lp2_0 campaign tags requested by marketing. */
const BUTTONS = [
    {
        text: "Get started",
        href: "/get-started?utm_source=landing&utm_medium=cta&utm_campaign=lp2_0",
        variant: "primary" as const,
    },
    {
        text: "Book a 2.0 demo",
        href: "/demo?utm_source=landing&utm_medium=cta&utm_campaign=lp2_0",
        arrow: true,
    },
]
---

<section class="closing" aria-labelledby="closing">
    <div class="inner">
        <span
            class="wordmark"
            aria-hidden="true"
            data-usal="zoomin duration-500 ease-out"></span>

        <div class="copy">
            <h2 id="closing" data-usal="fade-u delay-50 duration-500 ease-out">
                The Foundation for<br />
                What Comes Next
            </h2>
            <p data-usal="fade-u delay-100 duration-500 ease-out">
                Kestra 2.0 is where the platform stops carrying 1.x constraints
                and starts building on a clean architecture.
                <strong>First LTS release.</strong>
                <strong>Bug and security fixes backported for a year.</strong>
                Upgrade once, then build.
            </p>
        </div>

        <Cta theme="dark" buttons={BUTTONS} />
    </div>
</section>

<style
    lang="scss"
    define:vars={{ squares: `url(${squares})`, twoZero: `url("${twoZero}")` }}
>
    .closing {
        position: relative;
        padding-block: 5rem 11.875rem;
        border-top: 1px solid transparent;
        border-image: linear-gradient(
                90deg,
                rgba(128, 143, 237, 0),
                #808fed 51%,
                rgba(128, 143, 237, 0)
            )
            1;
        background:
            radial-gradient(
                    45% 40% at 50% 8%,
                    rgba(99, 27, 255, 0.45) 0%,
                    rgba(99, 27, 255, 0) 100%
                )
                no-repeat,
            linear-gradient(180deg, #000000 36.8%, #1a1c22 100%);
        color: $white;
        overflow: clip;

        @include media-breakpoint-down(lg) {
            padding-block: 3rem 5rem;
        }

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            /* The asset was drawn for the hero: 50% black squares with a
             * thin dark-blue stroke, which vanish on this near-black panel.
             * Using it as a mask and painting a pale tint through it turns
             * the fill into the soft grey boxes and the stroke into the
             * lighter outline the design shows. */
            -webkit-mask:
                var(--squares) no-repeat left -100px bottom -96px / 520px auto,
                var(--squares) no-repeat right -260px bottom 140px / 520px auto;
            mask:
                var(--squares) no-repeat left -100px bottom -96px / 520px auto,
                var(--squares) no-repeat right -260px bottom 140px / 520px auto;
            background: rgba(196, 200, 255, 0.22);
            pointer-events: none;

            @include media-breakpoint-down(lg) {
                display: none;
            }
        }
    }

    .inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2.5rem;
        padding-inline: 1.5rem;
        text-align: center;
    }

    .wordmark {
        position: relative;
        display: block;
        width: 264px;
        max-width: 80%;
        aspect-ratio: 261 / 146;
        filter: drop-shadow(0 0 24px rgba(103, 182, 251, 0.5))
            drop-shadow(-3px -3px 12px rgba(117, 39, 215, 0.6))
            drop-shadow(0 60px 28px rgba(79, 46, 185, 0.45));

        &::before,
        &::after {
            content: "";
            position: absolute;
            inset: 0;
            -webkit-mask: var(--twoZero) center / contain no-repeat;
            mask: var(--twoZero) center / contain no-repeat;
        }

        &::before {
            background: #010003;
            translate: 0 5px;
        }

        &::after {
            background: linear-gradient(
                180deg,
                #b996ff 28%,
                #ba98fc 75%,
                #5500ff 84%
            );
        }
    }

    .copy {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 816px;
    }

    .copy p {
        margin: 0;
        color: #cfd3d6;
        font-size: clamp(1rem, 1.4vw, 1.25rem);
        line-height: 1.4;

        strong {
            color: $white;
            font-weight: 600;
        }

        a {
            color: #a796ff;
            text-decoration: underline;
            text-underline-offset: 0.15em;

            &:hover {
                color: $white;
            }
        }
    }
</style>
