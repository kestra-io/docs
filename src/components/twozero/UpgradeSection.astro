---
import QuoteCard from "./QuoteCard.astro"
import Cta from "./Cta.astro"
/* Figma uses the colour Amdocs brand mark here, not the white `amdocs.svg`. */
import amdocsLogo from "~/components/home/assets/companies/amdocs-color.svg?raw"
import twoZero from "./assets/two-zero.svg?no-inline"

const STATS = [
    { value: "LTS", label: "First long-term support release" },
    { value: "1 year", label: "Bug and security fixes backported" },
    { value: "0", label: "Major upgrades in that window" },
]

const LINKS = [
    {
        text: "Migration Guide",
        href: "/docs/migration-guide",
        variant: "primary" as const,
    },
    {
        text: "Releases Notes",
        href: "https://github.com/kestra-io/kestra/releases",
    },
    { text: "Join us on Slack", href: "https://kestra.io/slack" },
]
---

<section class="upgrade" aria-labelledby="upgrade">
    <div class="inner">
        <header class="head">
            <h2 id="upgrade" data-usal="fade-u delay-50 duration-500 ease-out">
                Upgrade With Confidence
            </h2>
            <p
                class="standfirst"
                data-usal="fade-u delay-100 duration-500 ease-out"
            >
                One year of LTS support. A migration tool that does the heavy
                lifting.
            </p>
            <p
                class="wordmark"
                data-usal="zoomin delay-150 duration-500 ease-out"
            >
                <span class="from">1.x</span>
                <span class="visually-hidden">to 2.0</span>
                <span class="to" aria-hidden="true"></span>
            </p>
        </header>

        <div class="columns">
            <div class="story">
                <p data-usal="fade-u delay-50 duration-500 ease-out">
                    2.0 requires Kestra 1.3.x. kestra-migrate rewrites most
                    flows automatically; ForEach and pluginDefaults are flagged
                    for review because they need a judgment call. Every breaking
                    change has a dedicated before/after guide in the v2.0.0
                    migration hub.
                </p>
                <dl class="stats">
                    {
                        STATS.map((stat, index) => (
                            <div
                                class="stat"
                                data-usal={`fade-u duration-350 delay-${100 + index * 50} ease-out`}
                            >
                                <dt>{stat.value}</dt>
                                <dd>{stat.label}</dd>
                            </div>
                        ))
                    }
                </dl>
            </div>

            <pre
                class="terminal"
                data-usal="fade-u delay-100 duration-500 ease-out"><span class="prompt">$</span> kestra-migrate --check ./flows/
<span class="comment"># scope the work, nothing written</span>
<span class="ok">✓</span> 214 flows scanned · 187 auto-rewritable
<span class="warn">!</span> 27 flagged for review (ForEach, pluginDefaults)
<span class="prompt">$</span> kestra-migrate -o v2-flows/ ./flows/
<span class="ok">✓</span> written to v2-flows/</pre>
        </div>

        <QuoteCard
            dark
            logoSvg={amdocsLogo}
            quote="Half a gigabyte of heart imaging per patient, twelve ML services on GPU, three regions. HeartFlow set out to cut orchestration overhead by 85%, and did. Putting GPU workloads into production on Kestra is what unlocked their international expansion."
            company="HeartFlow"
            meta="Clinical imaging ML platform"
        />

        <Cta theme="dark" buttons={LINKS} />
    </div>
</section>

<style lang="scss" define:vars={{ twoZero: `url("${twoZero}")` }}>
    .upgrade {
        padding-block: 10.625rem 7.5rem;
        background: #000000 url("~/assets/header-grid.svg") no-repeat top
            center / 1720px auto;
        color: $white;
        overflow: clip;

        @include media-breakpoint-down(lg) {
            padding-block: 4rem 3rem;
        }
    }

    .inner {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        max-width: 1140px;
        margin-inline: auto;
        padding-inline: 1.5rem;

        @include media-breakpoint-down(lg) {
            gap: 2.5rem;
        }
    }

    .head {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-align: center;
    }

    /* Larger than the shared `.twozero-page h2` scale, so scoped to outrank it. */
    .upgrade h2 {
        margin: 0;
        font-size: clamp(2.25rem, 4.5vw, 4rem);
        font-weight: 600;
        font-feature-settings: "ss01", "ss06", "ss07";
        letter-spacing: -0.02em;
        line-height: 0.9375;
    }

    .standfirst {
        margin: 0;
        color: #cccbce;
        font-size: $font-size-lg;
        line-height: 1.4444;
    }

    .wordmark {
        position: relative;
        display: flex;
        align-items: center;
        margin: 0.5rem 0 0;
        line-height: 1;
        /* Keeps the `.to::before` body layer behind the digits but in front of
         * the section background. */
        isolation: isolate;

        /* The detached chevron. Drawn here rather than on `.from`, whose
         * clip-path would cut it off. */
        &::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 138px;
            width: 63px;
            height: 94px;
            background: linear-gradient(90deg, #141523, #3c3c3c);
            translate: 0 -50%;
            clip-path: polygon(
                25.4% 0,
                100% 50%,
                25.4% 100%,
                0 83.3%,
                49.4% 50.3%,
                0 17.1%
            );
        }
    }

    .from {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: 154px;
        height: 70px;
        padding-right: 36px;
        background: linear-gradient(90deg, #000000 20%, #141523 90%, #1f1f2a);
        font-size: 42.7px;
        font-weight: 700;
        clip-path: polygon(0 0, 77.3% 0, 100% 50%, 77.3% 100%, 0 100%);
    }

    .to {
        position: relative;
        flex: 0 0 auto;
        width: 100px;
        aspect-ratio: 261 / 146;
        margin-left: 56px;
        filter: drop-shadow(0 0 14px rgba(103, 182, 251, 0.55))
            drop-shadow(-2px -2px 8px rgba(117, 39, 215, 0.7))
            drop-shadow(0 22px 10px rgba(79, 46, 185, 0.45));

        &::before,
        &::after {
            content: "";
            position: absolute;
            inset: 0;
            -webkit-mask: var(--twoZero) center / contain no-repeat;
            mask: var(--twoZero) center / contain no-repeat;
        }

        &::before {
            background: #010003;
            translate: 0 3px;
        }

        &::after {
            background: linear-gradient(
                180deg,
                #b996ff 28%,
                #ba98fc 75%,
                #5500ff 84%
            );
        }
    }

    .columns {
        display: grid;
        gap: 2.375rem;
        grid-template-columns: 1fr;

        @include media-breakpoint-up(lg) {
            grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        }
    }

    .story {
        display: flex;
        flex-direction: column;
        gap: 1rem;

        p {
            margin: 0;
            font-size: $font-size-lg;
            line-height: 1.5556;
        }
    }

    .stats {
        display: grid;
        gap: 1rem;
        margin: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));

        @include media-breakpoint-down(sm) {
            grid-template-columns: 1fr;
        }
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 2rem 1rem;
        border: 1.2px solid #3b3a41;
        border-radius: $border-radius-lg;
        background: #131316;
        text-align: center;

        dt {
            font-size: clamp(1.75rem, 2.3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.01em;
            line-height: 1.2222;
        }

        dd {
            margin: 0;
            color: #cccbce;
            font-size: $font-size-sm;
            line-height: 1.4286;
        }
    }

    .terminal {
        margin: 0;
        padding: 1rem 2rem;
        border: 1px solid transparent;
        border-radius: $border-radius-lg;
        background:
            linear-gradient(#171717, #171717) padding-box,
            linear-gradient(180deg, #316dee, #666666) border-box;
        box-shadow: 0 24px 24px 0 rgba(90, 47, 213, 0.22);
        color: $white;
        font-family: $font-family-monospace;
        font-size: $font-size-sm;
        line-height: 1.7143;
        white-space: pre-wrap;
        overflow-wrap: anywhere;

        .prompt {
            color: #718bfe;
        }

        .comment {
            color: #727272;
        }

        .ok {
            color: #06f0b1;
        }

        .warn {
            color: #eeb06e;
        }
    }
</style>
