---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import Link from "~/components/common/Link.astro"
import soc2Img from "~/components/layout/assets/soc2.png"
import gdprImg from "~/components/layout/assets/gdpr.svg"
import SectionTitle from "./SectionTitle.astro"
import {
    DEPLOYMENT_ARCHITECTURE_URL,
    HARDENING_GUIDE_URL,
    TRUST_CENTER_POLICIES,
    TRUST_CENTER_URL,
} from "./securityData"

const REPORTS = [
    {
        logo: soc2Img,
        name: "SOC 2 Type 2",
        description:
            "Security, Availability and Confidentiality trust services criteria. Independently audited.",
    },
    {
        logo: gdprImg,
        name: "GDPR",
        description:
            "Article 5 requirements, audited alongside SOC 2. DPA available on request.",
    },
]
---

<section class="security-section compliance" aria-labelledby="compliance-title">
    <div class="container">
        <SectionTitle
            id="compliance-title"
            title="Compliance and certifications"
        >
            Available from the Trust Center. Each copy is issued to the
            requester.
        </SectionTitle>

        <div class="reports">
            {
                REPORTS.map((report) => (
                    <article class="security-card report" data-usal="fade-u">
                        <Image
                            src={report.logo}
                            alt=""
                            width={70}
                            height={70}
                            class="logo"
                        />
                        <div class="body">
                            <h3>{report.name}</h3>
                            <p>{report.description}</p>
                            <Link
                                href={TRUST_CENTER_URL}
                                text="Download from the Trust Center"
                                target="_blank"
                                rel="noopener"
                            />
                        </div>
                        <span class="status">
                            <Icon name="mdi:check-circle-outline" />
                            Audited
                        </span>
                    </article>
                ))
            }
        </div>

        <div class="security-card audit" data-usal="fade-u">
            <div class="scope">
                <h3>
                    <Icon name="mdi:shield-check-outline" class="icon" />
                    What the audit covers
                </h3>
                <p>
                    The SOC 2 report examines Kestra Technologies and our
                    managed service: how we build the software, and how we
                    operate as a vendor. That includes secure development, code
                    review, vulnerability management, access control, incident
                    response and change management.
                </p>
                <p>
                    If you self-host, your deployment runs in your
                    infrastructure and stays under your control. The <a
                        href={HARDENING_GUIDE_URL}
                        target="_blank"
                        rel="noopener">hardening guide</a
                    >{" "}
                    and the <a
                        href={DEPLOYMENT_ARCHITECTURE_URL}
                        target="_blank"
                        rel="noopener">deployment architecture documentation</a
                    > cover that side.
                </p>
            </div>
            <div class="policies">
                <p>
                    The Trust Center also publishes live control monitoring, our
                    subprocessor list, and downloadable policies:
                </p>
                <ul>
                    {TRUST_CENTER_POLICIES.map((policy) => <li>{policy}</li>)}
                </ul>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .reports {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .report {
        position: relative;
        display: flex;
        gap: 2rem;
        align-items: flex-start;
        padding: 2rem;

        @include media-breakpoint-down(md) {
            flex-direction: column;
            gap: 1rem;
            padding: 2.5rem 1.5rem 1.5rem;
        }

        .logo {
            flex-shrink: 0;
            width: 70px;
            height: 70px;
            object-fit: contain;
        }

        .body {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-width: 500px;
        }

        h3 {
            margin: 0;
            color: var(--ks-content-primary);
            font-size: $font-size-lg;
            line-height: 28px;
        }

        p {
            margin: 0 0 0.5rem;
            color: var(--ks-content-secondary);
            font-size: $font-size-sm;
            line-height: 20px;
        }
    }

    .status {
        position: absolute;
        top: 9px;
        right: 8px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 6px;
        background: var(--ks-background-tag-success);
        color: var(--ks-content-tag-success);
        font-size: $font-size-sm;
        font-weight: 600;
        line-height: 20px;

        :global(svg) {
            width: 14px;
            height: 14px;
        }
    }

    .audit {
        display: flex;
        gap: 2rem;
        align-items: center;
        padding: 4rem 2rem;
        box-shadow: 0 8px 24px 0 var(--security-shadow-elevated);

        @include media-breakpoint-down(lg) {
            flex-direction: column;
            align-items: stretch;
            padding: 2rem 1.5rem;
        }

        .scope {
            display: flex;
            flex: 1;
            flex-direction: column;
            gap: 1rem;
        }

        h3 {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            color: var(--ks-content-primary);
            font-size: $font-size-2xl;
            line-height: 38px;

            .icon {
                flex-shrink: 0;
                width: 48px;
                height: 48px;
                color: var(--blue-400);
            }
        }

        p {
            margin: 0;
            color: var(--ks-content-primary);
            line-height: 24px;
        }

        a {
            color: var(--ks-content-link);
            text-decoration: underline;
        }

        .policies {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            width: 475px;
            padding-inline: 2rem;
            border-left: 1px solid var(--ks-border-primary);

            @include media-breakpoint-down(lg) {
                width: auto;
                padding: 1.5rem 0 0;
                border-top: 1px solid var(--ks-border-primary);
                border-left: 0;
            }
        }

        ul {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            padding: 2px 8px;
            border-radius: 6px;
            background: color-mix(in srgb, var(--blue-300) 10%, transparent);
            color: var(--ks-content-property);
            font-family: $font-family-monospace;
            font-size: $font-size-sm;
            font-weight: 600;
            line-height: 20px;
        }
    }
</style>
