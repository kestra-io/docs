---
import { Icon } from "astro-icon/components"
import pipedreamMark from "./assets/pipedream.png"
import kestraMark from "~/components/home/assets/ai/kestra-logo-mark-on-dark.svg"

const SCRIPT = [
    { cmd: "unzip project_export-proj_abc123.zip -d export" },
    { out: "  inflating: export/invoice-intake-p_abc123.json" },
    { cmd: 'claude "Convert ./export to Kestra flows"' },
    { out: "# wrote flows/finance/invoice_intake.yaml", note: true },
    { cmd: "kestractl flows deploy ./flows/ --override" },
]
---

<figure
    class="hero-cli"
    aria-label="A Pipedream workflow converted to a Kestra flow from the command line"
    data-hero-cli
>
    <figcaption>
        <span class="dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
        </span>
        <span class="tab">
            <span class="logo">
                <img src={kestraMark.src} alt="" width="16" height="16" />
            </span>
            Terminal
        </span>
    </figcaption>
    <pre data-screen>{SCRIPT.map((line) =>
        line.cmd ? (
            <span class="line"><span class="ps">$ </span><span class="cmd">{line.cmd}</span></span>
        ) : (
            <span class:list={["line", line.note ? "note" : "out"]}>{line.out}</span>
        ),
    )}</pre>
    <div class="track" aria-hidden="true">
        <span class="end from">
            <img src={pipedreamMark.src} alt="" />
            invoice-intake
        </span>
        <span class="rail">
            <i></i>
        </span>
        <span class="end to">
            <img src={kestraMark.src} alt="" class="k" />
            finance.invoice_intake
            <Icon name="mdi:check-circle" class="ok" />
        </span>
    </div>
    <script
        type="application/json"
        data-script
        set:html={JSON.stringify(SCRIPT)}
    />
</figure>

<script>
    type Line = { cmd?: string; out?: string; note?: boolean }

    function wire() {
        document
            .querySelectorAll<HTMLElement>("[data-hero-cli]:not([data-wired])")
            .forEach((root) => {
                root.dataset.wired = ""
                const screen = root.querySelector<HTMLElement>("[data-screen]")!
                const script: Line[] = JSON.parse(
                    root.querySelector("[data-script]")!.textContent ?? "[]",
                )
                if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    root.style.setProperty("--progress", "1")
                    root.dataset.done = ""
                    return
                }
                const commands = script.filter((line) => line.cmd).length
                const sleep = (ms: number) =>
                    new Promise((resolve) => setTimeout(resolve, ms))

                const loop = async () => {
                    while (root.isConnected) {
                        screen.textContent = ""
                        delete root.dataset.done
                        root.style.setProperty("--progress", "0")
                        let done = 0
                        for (const line of script) {
                            const row = document.createElement("span")
                            row.className = "line"
                            screen.appendChild(row)
                            if (line.cmd) {
                                const ps = document.createElement("span")
                                ps.className = "ps"
                                ps.textContent = "$ "
                                const cmd = document.createElement("span")
                                cmd.className = "cmd typing"
                                row.append(ps, cmd)
                                for (let c = 1; c <= line.cmd.length; c++) {
                                    cmd.textContent = line.cmd.slice(0, c)
                                    await sleep(32)
                                }
                                cmd.classList.remove("typing")
                                await sleep(450)
                                done++
                                root.style.setProperty(
                                    "--progress",
                                    String(done / commands),
                                )
                            } else {
                                row.classList.add(line.note ? "note" : "out")
                                row.textContent = line.out ?? ""
                                await sleep(350)
                            }
                        }
                        root.dataset.done = ""
                        await sleep(3200)
                    }
                }
                loop()
            })
    }

    wire()
    document.addEventListener("astro:page-load", wire)
</script>

<style lang="scss">
    .hero-cli {
        --line: #2e2e3c;
        --progress: 1;
        margin: 0;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        background: #18181e;
        box-shadow: 0 30px 80px -24px rgba(0, 0, 0, 0.6);
        text-align: left;
    }

    figcaption {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 3rem;
        padding: 0 1rem;
        border-bottom: 1px solid var(--line);
        background: #1e1e26;
        font-size: 0.875rem;
        color: #adadbf;
    }

    .dots {
        display: inline-flex;
        align-self: center;
        gap: 0.375rem;

        i {
            width: 0.625rem;
            height: 0.625rem;
            border-radius: 50%;
            background: var(--line);
        }
    }

    .tab {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        height: 2.375rem;
        margin-bottom: -1px;
        padding: 0 0.875rem 0 0.5rem;
        border: 1px solid var(--line);
        border-bottom: 0;
        border-radius: 8px 8px 0 0;
        background: #18181e;
        font-weight: 500;
        color: #ffffff;
    }

    .logo {
        display: grid;
        place-items: center;
        width: 1.375rem;
        height: 1.375rem;
        border-radius: 6px;
        background: #0d0d10;

        img {
            width: 1rem;
            height: 1rem;
        }
    }

    pre {
        height: 12.5rem;
        margin: 0;
        padding: 1.25rem 1.5rem;
        overflow: hidden;
        border: 0;
        border-radius: 0;
        background: transparent;
        font-family: $font-family-monospace;
        font-size: 0.8125rem;
        line-height: 1.8;
        color: #d6d6e0 !important;
        white-space: pre-wrap;
        word-break: break-word;
    }

    pre :global(.line) {
        display: block;
    }

    pre :global(.ps) {
        color: #80fac5;
    }

    pre :global(.cmd) {
        color: #ffffff;
    }

    pre :global(.out) {
        color: #adadbf;
    }

    pre :global(.note) {
        color: #cdb6fb;
    }

    pre :global(.typing)::after {
        content: "";
        display: inline-block;
        width: 0.5rem;
        height: 1rem;
        margin-left: 1px;
        vertical-align: -0.15rem;
        background: #ffffff;
        animation: hero-caret 1s steps(1) infinite;
    }

    @keyframes hero-caret {
        50% {
            opacity: 0;
        }
    }

    .track {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--line);
        background: #121216;
        font-size: 0.8125rem;
        color: #d6d6e0;
    }

    .end {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;

        img {
            width: 1.375rem;
            height: 1.375rem;
            border-radius: 5px;
        }

        .k {
            padding: 0.1875rem;
            background: #0d0d10;
        }
    }

    .to {
        opacity: 0.45;
        transition: opacity 0.4s ease;

        [data-done] & {
            opacity: 1;
        }
    }

    .ok {
        color: #06f0b1;
        opacity: 0;
        transition: opacity 0.4s ease;

        [data-done] & {
            opacity: 1;
        }
    }

    .rail {
        position: relative;
        flex: 1;
        height: 2px;
        border-radius: 2px;
        background: #2e2e3c;

        i {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: linear-gradient(90deg, #34d28b, #9869f7);
            transform: scaleX(var(--progress));
            transform-origin: left;
            transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        }
    }

    @media (max-width: 575px) {
        .track {
            flex-wrap: wrap;
        }

        .rail {
            flex-basis: 100%;
            order: 2;
        }

        .to {
            order: 3;
        }
    }
</style>
