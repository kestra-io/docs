                                            <Icon name="mdi:code-tags" /> Code
                                            examples
                                        </span>
                                        <span class="pd-chip">
                                            <Icon name="mdi:creation-outline" />{" "}
                                            Edit with AI <b>BETA</b>
                                        </span>
                                    </div>
                                    <pre class="pd-code">{PD_CODE.map((line, i) => (
                                        <span class="ln"><i>{i + 1}</i><Fragment set:html={line} /></span>
                                    ))}</pre>
                                    <div class="pd-sec">RESULTS</div>
                                    <div class="pd-ok">
                                        <strong>Success</strong>
