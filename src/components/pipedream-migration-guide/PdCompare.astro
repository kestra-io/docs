                    output goes through Kestra.outputs(), and the connected
                    account becomes a secret.
                </p>
            </header>
            <div class="stage">
                <div class="compare" data-compare>
                    <div
                        class="layer pd"
                        role="img"
                        aria-label="The invoice workflow in the Pipedream builder: a trigger and two Python steps, with the transform step's code open."
                    >
                        <aside class="pd-rail">
                            <img src={pipedreamMark.src} alt="" />
                            <Icon name="mdi:magnify" />
                            <Icon name="mdi:format-list-bulleted" />
                            <Icon name="mdi:application-cog-outline" />
                        </aside>
                        <div class="pd-main">
                            <div class="pd-top">
                                <Icon name="mdi:cube-outline" />
                                <span>finance</span>
                                <Icon name="mdi:chevron-right" class="sep" />
                                <strong>invoice-intake</strong>
                                <span class="pd-btn">Deploy</span>
                            </div>
                            <div class="cols">
                                <div class="pd-canvas">
                                    <div class="pd-node">
                                        <span class="pd-icon hook">
                                            <Icon name="mdi:webhook" />
                                        </span>
                                        <span>
                                            <strong>trigger</strong>
                                            <small>
                                                https://eo3k9x2m1v8p4.m.pipedream.net
                                            </small>
                                        </span>
                                    </div>
                                    <span class="pd-link"></span>
                                    <div class="pd-node on">
                                        <span class="pd-icon py">
                                            <Icon name="mdi:language-python" />
                                        </span>
                                        <span>
                                            <strong>transform</strong>
                                        </span>
                                    </div>
                                    <span class="pd-link"></span>
                                    <div class="pd-node">
                                        <span class="pd-icon py">
                                            <Icon name="mdi:language-python" />
                                        </span>
                                        <span>
                                            <strong>post_to_netsuite</strong>
                                        </span>
                                    </div>
                                    <span class="pd-link"></span>
                                    <span class="pd-add">
                                        <Icon name="mdi:plus" />
                                    </span>
                                </div>
                                <div class="pd-panel">
                                    <div class="pd-tab">
                                        <Icon name="mdi:language-python" />
