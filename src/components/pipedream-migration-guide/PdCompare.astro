                                            <u>View the details</u> of the
                                            execution below
                                        </span>
                                    </div>
                                    <div class="pd-tabs">
                                        <span class="on">Exports</span>
                                        <span>Inputs</span>
                                        <span>Logs</span>
                                        <span>Details</span>
                                    </div>
                                    <pre class="pd-exports">steps.transform
  $return_value
    invoice_id: "INV-1042"
    amount: 1280.5</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div
                        class="layer ks"
                        role="img"
                        aria-label="The same workflow in the Kestra flow editor, with Topology and Flow Code open side by side while an execution runs through webhook, transform and post_to_netsuite."
                        data-ks
                    >
