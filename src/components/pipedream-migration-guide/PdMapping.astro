---
import { Icon } from "astro-icon/components"
import { MAPPING } from "./guide"

const parts = (text: string) =>
    text.split("`").map((value, idx) => ({ value, code: idx % 2 === 1 }))
---

<section class="pd-map" aria-labelledby="pd-map-title">
    <div class="container-xl">
        <div class="rails">
            <header>
                <h2 id="pd-map-title">Pipedream to Kestra mapping</h2>
                <p>
                    Every Pipedream construct, the Kestra feature that replaces
                    it, and what you write in the flow YAML.
                </p>
            </header>
            <table>
                <thead>
                    <tr>
                        <th scope="col">Pipedream</th>
                        <th scope="col">Kestra</th>
                        <th scope="col">In the flow YAML</th>
                    </tr>
                </thead>
                {MAPPING.map((group) => (
                    <tbody>
                        <tr class="group">
                            <th scope="rowgroup" colspan="3">
                                <span>
                                    <Icon name={group.icon} />
                                    {group.title}
                                </span>
                            </th>
                        </tr>
                        {group.rows.map(([pipedream, kestra, yaml, href]) => (
                            <tr>
                                <th scope="row">
                                    {parts(pipedream).map((part) =>
                                        part.code ? (
                                            <code>{part.value}</code>
                                        ) : (
                                            part.value
                                        ),
                                    )}
                                </th>
                                <td class="kestra">
                                    <a {href}>{kestra}</a>
                                </td>
                                <td class="yaml">
                                    {parts(yaml).map((part) =>
                                        part.code ? (
                                            <code>{part.value}</code>
                                        ) : (
                                            part.value
                                        ),
                                    )}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                ))}
            </table>
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/components/about/style/section" as *;

    .pd-map {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-bottom: var(--rule);
        background: var(--ks-background-body);
    }

    .rails {
        padding-bottom: 5rem;
        border-inline: var(--rule);

        @include media-breakpoint-down(xl) {
            border-inline: 0;
        }

        @include media-breakpoint-down(md) {
            padding-bottom: 3rem;
        }
    }

    header {
        display: grid;
        gap: 1rem;
        padding: 6rem var(--inset) 3rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 2rem;
        }

        h2 {
            @include title;
            font-size: clamp(2rem, 3.6vw, 3rem);
            color: var(--ks-content-primary);
        }

        p {
            max-width: 40rem;
            margin: 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: var(--ks-content-tertiary);
        }
    }

    table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

    th,
    td {
        padding: 0.875rem 1rem;
        border-bottom: var(--rule);
        vertical-align: top;
        text-align: left;
        font-size: $font-size-md;
        line-height: 1.45;

        &:first-child {
            padding-left: var(--inset);
        }

        &:last-child {
            padding-right: var(--inset);
        }

        @include media-breakpoint-up(md) {
            &:not(:first-child) {
                border-left: var(--rule);
            }
        }
    }

    thead th {
        position: sticky;
        top: 59px;
        z-index: 2;
        padding-block: 1.125rem;
        border-top: var(--rule);
        background: var(--ks-background-body);
        font-weight: 600;
        color: var(--ks-content-primary);

        @include media-breakpoint-down(xl) {
            top: 55px;
        }

        &:first-child {
            width: 30%;
        }

        &:nth-child(2) {
            width: 32%;
        }
    }

    .group th {
        padding-block: 1.5rem 1rem;
        background: var(--ks-background-secondary);
        font-weight: 700;
        color: var(--ks-content-primary);

        span {
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }

        :global(svg) {
            width: 1.25rem;
            height: 1.25rem;
            color: var(--ks-content-tertiary);
        }
    }

    tbody th[scope="row"] {
        font-weight: 400;
        color: var(--ks-content-secondary);
    }

    .kestra a {
        font-weight: 500;
        color: var(--ks-content-primary);
        text-decoration: none;

        &:hover {
            color: var(--ks-content-link);
            text-decoration: underline;
        }
    }

    .yaml {
        color: var(--ks-content-tertiary);
    }

    code {
        padding: 0.0625rem 0.375rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: 4px;
        background: var(--ks-background-secondary);
        font-family: $font-family-monospace;
        font-size: 0.8125rem;
        color: var(--ks-content-primary);
        overflow-wrap: anywhere;
    }

    @media (hover: hover) {
        tbody tr:not(.group):hover > * {
            background: var(--ks-background-secondary);
        }
    }

    @include media-breakpoint-down(md) {
        thead {
            display: none;
        }

        table,
        tbody,
        tr,
        th,
        td {
            display: block;
            width: auto;
        }

        tbody tr:not(.group) {
            padding: 0.875rem var(--inset);
            border-bottom: var(--rule);

            > * {
                padding: 0;
                border: 0;
            }

            > .kestra {
                margin-top: 0.25rem;
            }

            > .yaml {
                margin-top: 0.5rem;
            }
        }

        .group th {
            padding-inline: var(--inset);
        }
    }
</style>
