---
import { Icon } from "astro-icon/components"

const NAV = [
    {
        group: "Tenant",
        items: [
            { icon: "mdi:monitor-dashboard", label: "System Overview" },
            { icon: "mdi:shield-check-outline", label: "Policies" },
            { icon: "mdi:database-outline", label: "KV Store" },
            { icon: "mdi:lock-outline", label: "Secrets" },
            { icon: "mdi:lightning-bolt-outline", label: "Triggers" },
        ],
    },
    {
        group: "Administration",
        items: [
            { icon: "mdi:server-network", label: "Instance", on: true },
            { icon: "mdi:domain", label: "Tenants" },
            { icon: "mdi:account-group-outline", label: "IAM" },
            { icon: "mdi:text-box-search-outline", label: "Audit Logs" },
            { icon: "mdi:power", label: "Kill Switch" },
            { icon: "mdi:bullhorn-outline", label: "Announcements" },
        ],
    },
]

const TABS = ["Overview", "Tenants", "Worker groups", "Health"]

const SERVICES = ["executor-1", "executor-2", "scheduler", "webserver"]

const TENANTS = [
    {
        name: "data-platform",
        namespaces: 12,
        group: "eu-west · k8s",
        quota: 0.72,
    },
    {
        name: "infrastructure",
        namespaces: 9,
        group: "on-prem dc1",
        quota: 0.56,
    },
    { name: "finance-ops", namespaces: 6, group: "sap-zone", quota: 0.38 },
    {
        name: "ml-agents",
        namespaces: 4,
        group: "gpu-pool",
        quota: 0.82,
        high: true,
    },
]
---

<div class="ui-mock ops-mock" aria-hidden="true" data-ui-mock>
    <div class="stage">
        <div class="ui">
            <div class="bar">
                <img src="/icon.svg" alt="" width="24" height="24" />
                <span class="slash">/</span>
                <Icon name="mdi:server-network" />
                <strong>Instance</strong>
                <span class="mode">
                    <Icon name="mdi:wrench-outline" /> Maintenance mode
                    <i></i>
                </span>
            </div>
            <div class="nav">
                {NAV.map((section) => (
                    <div>
                        <span class="group">{section.group}</span>
                        {section.items.map((item) => (
                            <span class:list={["item", { on: item.on }]}>
                                <Icon name={item.icon} />
                                {item.label}
                            </span>
                        ))}
                    </div>
                ))}
            </div>
            <div class="main">
                <div class="tabs">
                    {TABS.map((tab) => (
                        <span class:list={{ on: tab === "Tenants" }}>
                            {tab}
                        </span>
                    ))}
                </div>
                <p class="title">Cluster health</p>
                <div class="services">
                    {SERVICES.map((service, idx) => (
                        <span style={`--k: ${idx}`}>
                            <i />
                            {service}
                        </span>
                    ))}
                </div>
                <p class="title">Tenants and worker groups</p>
                <div class="table">
                    <div class="head">
                        <span>Tenant</span>
                        <span>Namespaces</span>
                        <span>Worker group</span>
                        <span>Quota</span>
                    </div>
                    {TENANTS.map((tenant, idx) => (
                        <div class="line" style={`--k: ${idx}`}>
                            <code>{tenant.name}</code>
                            <span>{tenant.namespaces}</span>
                            <span>
                                <span class="group">{tenant.group}</span>
                            </span>
                            <span
                                class:list={["quota", { high: tenant.high }]}
                                style={`--v: ${tenant.quota}`}
                            >
                                <i />
                            </span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</div>

<style lang="scss">
    @use "./tokens" as *;

    .ops-mock {
        --loop: 12s;

        @include tokens;
    }

    .stage {
        position: relative;
        padding-block: 2.4em;
        font-size: calc(100cqw / 50);
        line-height: 1.3;
        color: var(--text);
    }

    .ui {
        display: grid;
        grid-template-columns: 9.5em minmax(0, 1fr);
        grid-template-rows: 3em auto;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 1.1em;
        background: var(--deep);
        box-shadow: var(--shadow);
    }

    .bar {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 0.6em;
        padding: 0 1em 0 0.7em;
        border-bottom: 1px solid var(--line);
        background: var(--chrome);

        img {
            width: 1.7em;
            height: 1.7em;
            border-radius: 0.35em;
        }

        .slash {
            color: var(--muted);
            opacity: 0.6;
        }

        > [data-icon] {
            width: 1.05em;
            height: 1.05em;
            color: var(--muted);
        }

        strong {
            font-size: 0.82em;
            font-weight: 600;
        }
    }

    .mode {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        height: 2.5em;
        margin-left: auto;
        padding: 0 0.8em;
        border: 1px solid var(--line);
        border-radius: 0.4em;
        font-size: 0.68em;
        font-weight: 600;
        color: var(--soft);

        [data-icon] {
            width: 1.2em;
            height: 1.2em;
            color: var(--muted);
        }

        i {
            position: relative;
            width: 2.1em;
            height: 1.2em;
            border-radius: 999px;
            background: var(--chip);

            &::after {
                content: "";
                position: absolute;
                top: 0.15em;
                left: 0.15em;
                width: 0.9em;
                height: 0.9em;
                border-radius: 50%;
                background: var(--muted);
            }
        }
    }

    .nav {
        display: flex;
        flex-direction: column;
        gap: 0.9em;
        padding: 0.9em 0.6em 1.2em;
        border-right: 1px solid var(--line);
        background: var(--chrome);

        div {
            display: flex;
            flex-direction: column;
            gap: 0.1em;
        }

        .group {
            margin-bottom: 0.3em;
            padding-left: 0.4em;
            font-size: 0.68em;
            color: var(--muted);
        }

        .item {
            display: flex;
            align-items: center;
            gap: 0.6em;
            padding: 0.42em 0.5em;
            border-radius: 0.4em;
            font-size: 0.72em;
            font-weight: 600;
            white-space: nowrap;
            color: var(--soft);

            &.on {
                background: var(--chip);
                color: var(--text);
            }
        }

        [data-icon] {
            flex: none;
            width: 1.3em;
            height: 1.3em;
            color: var(--muted);
        }
    }

    .main {
        padding: 0.4em 1.25em 1.4em;
    }

    .tabs {
        display: flex;
        gap: 1.6em;
        margin: 0 -1.25em;
        padding: 0 1.25em;
        border-bottom: 1px solid var(--line);

        span {
            padding: 0.9em 0;
            border-bottom: 2px solid transparent;
            font-size: 0.74em;
            font-weight: 600;
            color: var(--muted);

            &.on {
                border-color: var(--ring);
                color: var(--text);
            }
        }
    }

    .title {
        margin: 1.4em 0 0.7em;
        font-size: 0.8em;
        font-weight: 600;
    }

    .services {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.6em;

        span {
            display: flex;
            align-items: center;
            gap: 0.6em;
            padding: 0.8em 0.8em;
            border: 1px solid var(--line);
            border-radius: 0.5em;
            background: var(--panel);
            font-family: var(--bs-font-monospace);
            font-size: 0.68em;
            white-space: nowrap;
        }

        i {
            position: relative;
            flex: none;
            width: 0.7em;
            height: 0.7em;
            border-radius: 50%;
            background: var(--ok);

            &::after {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: 50%;
                background: var(--ok);
                opacity: 0;
            }
        }
    }

    .table {
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--panel);
        overflow: hidden;
    }

    .head,
    .line {
        display: grid;
        grid-template-columns: 1.25fr 0.85fr 1.15fr 1fr;
        align-items: center;
        gap: 1em;
        padding: 0 1em;
    }

    .head {
        height: 2.6em;
        background: var(--field);
        font-size: 0.62em;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .line {
        height: 2.75em;
        border-top: 1px solid var(--line);
        font-size: 0.74em;
        font-weight: 600;

        code {
            font-size: 0.95em;
            font-weight: 400;
            color: var(--text);
        }

        .group {
            display: inline-block;
            padding: 0.3em 0.8em;
            border-radius: 999px;
            background: var(--tile);
            font-size: 0.86em;
            white-space: nowrap;
            color: var(--tile-ink);

            :global(html.dark) & {
                background: rgba(152, 105, 247, 0.18);
                color: #b9a6ff;
            }
        }
    }

    .quota {
        position: relative;
        height: 0.5em;
        border-radius: 999px;
        background: var(--chip);
        overflow: hidden;

        i {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: var(--ring);
            transform: scaleX(var(--v));
            transform-origin: left;

            &::after {
                content: "";
                position: absolute;
                inset: 0;
                background: #e8a23a;
                opacity: 0;
            }
        }

        &.high i::after {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .ops-mock:not([data-play]) * {
            animation-play-state: paused !important;
        }

        .services i::after {
            animation: ops-mock-beat 2.4s ease-out infinite;
            animation-delay: calc(var(--k) * 0.45s);
        }

        .line {
            animation: ops-mock-line var(--loop) linear infinite both;
            animation-delay: calc(var(--k) * 0.3s);
        }

        .quota i {
            animation: ops-mock-fill var(--loop) linear infinite both;
            animation-delay: calc(var(--k) * 0.3s);
        }

        .quota.high i {
            animation-name: ops-mock-fill-high;
        }

        .quota.high i::after {
            animation: ops-mock-warn var(--loop) linear infinite both;
        }
    }

    @keyframes ops-mock-beat {
        0% {
            opacity: 0.5;
            transform: scale(1);
        }
        70%,
        100% {
            opacity: 0;
            transform: scale(2.8);
        }
    }

    @keyframes ops-mock-line {
        0%,
        3% {
            opacity: 0;
            transform: translateY(0.5em);
            animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }
        9%,
        94% {
            opacity: 1;
            transform: none;
        }
        98%,
        100% {
            opacity: 0;
            transform: none;
        }
    }

    @keyframes ops-mock-fill {
        0%,
        8% {
            transform: scaleX(0);
            animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }
        24%,
        100% {
            transform: scaleX(var(--v));
        }
    }

    @keyframes ops-mock-fill-high {
        0%,
        8% {
            transform: scaleX(0);
            animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }
        24%,
        46% {
            transform: scaleX(0.5);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        60%,
        100% {
            transform: scaleX(var(--v));
        }
    }

    @keyframes ops-mock-warn {
        0%,
        54% {
            opacity: 0;
        }
        60%,
        100% {
            opacity: 1;
        }
    }
</style>
