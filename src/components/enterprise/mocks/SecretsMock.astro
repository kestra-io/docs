---
import { Icon } from "astro-icon/components"

const ADDED = {
    key: "POSTGRES_PASSWORD",
    namespace: "acme.data",
    description: "Orders database",
}

const SECRETS = [
    {
        key: "STRIPE_API_KEY",
        namespace: "acme.finance",
        description: "Billing sync",
    },
    { key: "SLACK_WEBHOOK", namespace: "acme", description: "Alerts channel" },
    {
        key: "AWS_ACCESS_KEY",
        namespace: "acme.data",
        description: "S3 data lake",
    },
    {
        key: "GITHUB_TOKEN",
        namespace: "acme.platform",
        description: "Git sync",
    },
]

const FLOW = [
    [
        ["k", "id"],
        ["p", ": postgres_to_s3"],
    ],
    [
        ["k", "namespace"],
        ["p", ": acme.data"],
    ],
    [],
    [
        ["k", "tasks"],
        ["p", ":"],
    ],
    [
        ["p", "  - "],
        ["k", "id"],
        ["p", ": fetch"],
    ],
    [
        ["p", "    "],
        ["k", "type"],
        ["p", ": io.kestra.plugin.jdbc.postgresql.Query"],
    ],
    [
        ["p", "    "],
        ["k", "password"],
        ["p", ': "'],
        ["x", "{{ secret('POSTGRES_PASSWORD') }}"],
        ["p", '"'],
    ],
]
---

<div class="ui-mock secrets-mock" aria-hidden="true" data-ui-mock>
    <div class="stage">
        <div class="sheet">
            <p class="head">
                <Icon name="mdi:lock-outline" />
                <strong>Secrets</strong>
                <span class="vault">
                    <i />
                    HashiCorp Vault
                </span>
                <span class="go">
                    <Icon name="mdi:plus" />
                    Create New Secret
                </span>
            </p>
            <p class="cols">
                <span>Key</span>
                <span>Namespace</span>
                <span>Description</span>
            </p>
            <div class="rows">
                {[ADDED, ...SECRETS].map((secret, idx) => (
                    <p class:list={["secret", { added: idx === 0 }]}>
                        <span class="key">
                            <Icon name="mdi:key-variant" />
                            <code>{secret.key}</code>
                        </span>
                        <span>
                            <code class="ns">{secret.namespace}</code>
                        </span>
                        <span class="about">{secret.description}</span>
                    </p>
                ))}
            </div>
        </div>
        <div class="modal">
            <p class="title">
                Create
                <Icon name="mdi:close" />
            </p>
            <div class="form">
                <p class="field">
                    <span class="label">
                        <b>*</b> Namespace
                    </span>
                    <span class="box">
                        <code>{ADDED.namespace}</code>
                        <Icon name="mdi:chevron-down" />
                    </span>
                </p>
                <p class="field">
                    <span class="label">
                        <b>*</b> Name
                    </span>
                    <span class="box">
                        <code class="val v1">{ADDED.key}</code>
                    </span>
                </p>
                <p class="field">
                    <span class="label">
                        <b>*</b> Secret value
                    </span>
                    <span class="box">
                        <span class="val v2">••••••••••••••••</span>
                    </span>
                </p>
                <p class="field wide">
                    <span class="label">Description</span>
                    <span class="box area">Describe this secret</span>
                </p>
            </div>
            <p class="actions">
                <span class="cancel">Cancel</span>
                <span class="save">
                    <Icon name="mdi:content-save" />
                    Save
                </span>
            </p>
        </div>
        <div class="flow">
            <p class="file">
                <Icon name="mdi:file-tree-outline" />
                <code>postgres_to_s3</code>
                <span>Flow</span>
            </p>
            <pre>{FLOW.map((line) => (
                <span class="ln">{line.map(([kind, text]) => (
                    <span class={kind}>{text}</span>
                ))}</span>
            ))}</pre>
        </div>
        <span class="cursor">
            <svg viewBox="0 0 10 10">
                <path d="M0 0 L10 4 L5.5 5.5 L4 10 Z"></path>
            </svg>
            <span class="who">
                <Icon name="mdi:shield-account-outline" />
                Admin
            </span>
        </span>
    </div>
</div>

<style lang="scss">
    @use "./tokens" as *;

    .secrets-mock {
        --loop: 16s;

        @include tokens;
    }

    .stage {
        position: relative;
        padding-block: 2.4em;
        font-size: calc(100cqw / 50);
        line-height: 1.3;
        color: var(--text);
    }

    p {
        margin: 0;
    }

    code {
        font-family: var(--ks-font-monospace);
        color: inherit;
    }

    .sheet {
        margin-right: 2.4em;
        border: 1px solid var(--line);
        border-radius: 0.9em;
        background: var(--panel);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .head {
        display: flex;
        align-items: center;
        gap: 0.6em;
        padding: 0.8em 0.9em 0.8em 1.3em;
        border-bottom: 1px solid var(--line);

        > [data-icon] {
            width: 1.1em;
            height: 1.1em;
            color: var(--muted);
        }

        strong {
            font-size: 0.86em;
            font-weight: 600;
        }
    }

    .vault {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        margin-left: 0.6em;
        font-size: 0.64em;
        font-weight: 500;
        color: var(--muted);

        i {
            width: 0.6em;
            height: 0.6em;
            border-radius: 50%;
            background: var(--ok);
        }
    }

    .go,
    .save {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        height: 2.7em;
        padding: 0 1em;
        border-radius: 0.5em;
        background: var(--primary);
        font-size: 0.66em;
        font-weight: 600;
        white-space: nowrap;
        color: #ffffff;

        [data-icon] {
            width: 1.2em;
            height: 1.2em;
        }
    }

    .go {
        margin-left: auto;
    }

    .cols,
    .secret {
        display: grid;
        grid-template-columns: 1.35fr 1fr 1fr;
        align-items: center;
        gap: 1em;
        padding: 0 1.3em;
    }

    .cols {
        height: 2.3em;
        background: var(--field);

        span {
            font-size: 0.58em;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--muted);
        }
    }

    .rows {
        height: 15em;
    }

    .secret {
        height: 3em;
        border-top: 1px solid var(--line);
        overflow: hidden;
    }

    .key {
        display: flex;
        align-items: center;
        gap: 0.6em;
        min-width: 0;

        [data-icon] {
            flex: none;
            width: 0.95em;
            height: 0.95em;
            color: var(--muted);
        }

        code {
            font-size: 0.7em;
            font-weight: 600;
            white-space: nowrap;
        }
    }

    .ns {
        display: inline-block;
        padding: 0.25em 0.7em;
        border-radius: 0.4em;
        background: var(--chip);
        font-size: 0.62em;
        white-space: nowrap;
        color: var(--soft);
    }

    .about {
        font-size: 0.68em;
        white-space: nowrap;
        color: var(--muted);
    }

    .modal {
        position: absolute;
        top: 50%;
        right: 0;
        width: 23em;
        border: 1px solid var(--line);
        border-radius: 0.9em;
        background: var(--panel);
        box-shadow: var(--shadow);
        opacity: 0;
        overflow: hidden;
        transform: translateY(-50%);
    }

    .title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1em 1.4em 0.4em;
        font-size: 0.92em;
        font-weight: 600;

        [data-icon] {
            width: 1em;
            height: 1em;
            color: var(--muted);
        }
    }

    .form {
        display: flex;
        flex-direction: column;
        gap: 0.7em;
        padding: 0.8em 1.4em 1.3em;
    }

    .field {
        display: grid;
        grid-template-columns: 7.2em minmax(0, 1fr);
        align-items: center;

        &.wide {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.5em;
            margin-top: 0.2em;
        }
    }

    .label {
        font-size: 0.68em;
        font-weight: 600;

        b {
            font-weight: 600;
            color: #e36a7a;
        }
    }

    .box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 2.5em;
        padding: 0 0.8em;
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--field);

        code,
        .val {
            font-size: 0.68em;
            white-space: nowrap;
        }

        .v2 {
            letter-spacing: 0.12em;
            color: var(--soft);
        }

        [data-icon] {
            width: 1em;
            height: 1em;
            color: var(--muted);
        }

        &.area {
            align-items: flex-start;
            height: 3.4em;
            padding-top: 0.6em;
            font-size: 0.66em;
            color: var(--muted);
        }
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.6em;
        padding: 0.8em 1.1em;
        border-top: 1px solid var(--line);
        background: var(--deep);
    }

    .cancel {
        display: inline-flex;
        align-items: center;
        height: 2.7em;
        padding: 0 1em;
        border: 1px solid var(--line);
        border-radius: 0.5em;
        background: var(--panel);
        font-size: 0.66em;
        font-weight: 600;
        color: var(--soft);
    }

    .flow {
        position: absolute;
        right: 0;
        bottom: 0.4em;
        width: 24.5em;
        border: 1px solid var(--line);
        border-radius: 0.9em;
        background: var(--panel);
        box-shadow: var(--shadow);
        overflow: hidden;

        pre {
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0.9em 1.2em 1.1em;
            overflow: hidden;
            font-family: var(--ks-font-monospace);
            font-size: 0.62em;
            line-height: 1.75;
            color: var(--text);
        }

        .ln {
            min-height: 1.75em;
            white-space: pre;
        }

        .k {
            color: var(--ring);

            :global(html.dark) & {
                color: #b9a6ff;
            }
        }

        .x {
            padding: 0.15em 0.3em;
            border-radius: 0.3em;
            background: var(--wait-bg);
            color: var(--wait);
        }
    }

    .file {
        display: flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.7em 1.2em;
        border-bottom: 1px solid var(--line);

        [data-icon] {
            width: 1em;
            height: 1em;
            color: var(--muted);
        }

        code {
            font-size: 0.72em;
            font-weight: 600;
        }

        span {
            margin-left: auto;
            font-size: 0.58em;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--muted);
        }
    }

    .cursor {
        --tone: 38, 112, 214;

        position: absolute;
        top: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1em;
        opacity: 0;

        :global(html.dark) & {
            --tone: 140, 196, 255;
        }

        svg {
            width: 0.95em;
            height: 0.95em;
            fill: rgb(var(--tone));
        }
    }

    .who {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        margin-left: 0.6em;
        padding: 0.15em 0.55em;
        border: 1px solid rgb(var(--tone));
        border-radius: 0.45em;
        background: rgb(var(--tone));
        font-size: 0.7em;
        font-weight: 600;
        white-space: nowrap;
        color: #ffffff;

        :global(html.dark) & {
            border-color: rgba(var(--tone), 0.45);
            background: rgb(20, 20, 24);
            color: rgb(var(--tone));
        }

        [data-icon] {
            width: 1.1em;
            height: 1.1em;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .secrets-mock:not([data-play]) * {
            animation-play-state: paused !important;
        }

        .sheet {
            animation: secrets-mock-veil var(--loop) linear infinite both;
        }

        .go {
            animation: secrets-mock-press-1 var(--loop) linear infinite both;
        }

        .save {
            animation: secrets-mock-press-2 var(--loop) linear infinite both;
        }

        .modal {
            animation: secrets-mock-modal var(--loop) linear infinite both;
        }

        .v1 {
            animation: secrets-mock-type-1 var(--loop) linear infinite both;
        }

        .v2 {
            animation: secrets-mock-type-2 var(--loop) linear infinite both;
        }

        .secret.added {
            animation: secrets-mock-added var(--loop) linear infinite both;
        }

        .flow {
            animation: secrets-mock-flow var(--loop) linear infinite both;

            .x {
                animation: secrets-mock-use var(--loop) linear infinite both;
            }
        }

        .cursor {
            animation: secrets-mock-cursor var(--loop) linear infinite both;
        }
    }

    @keyframes secrets-mock-veil {
        0%,
        10% {
            opacity: 1;
        }
        13%,
        45% {
            opacity: 0.5;
        }
        48%,
        100% {
            opacity: 1;
        }
    }

    @keyframes secrets-mock-modal {
        0%,
        10% {
            opacity: 0;
            transform: translateY(-46%) scale(0.96);
            animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }
        14%,
        45% {
            opacity: 1;
            transform: translateY(-50%);
        }
        48%,
        100% {
            opacity: 0;
            transform: translateY(-50%) scale(0.97);
        }
    }

    @keyframes secrets-mock-press-1 {
        0%,
        8%,
        11%,
        100% {
            transform: none;
            filter: none;
        }
        9.5% {
            transform: scale(0.94);
            filter: brightness(0.9);
        }
    }

    @keyframes secrets-mock-press-2 {
        0%,
        42.5%,
        45.5%,
        100% {
            transform: none;
            filter: none;
        }
        44% {
            transform: scale(0.94);
            filter: brightness(0.9);
        }
    }

    @keyframes secrets-mock-type-1 {
        0%,
        18% {
            clip-path: inset(0 100% 0 0);
            animation-timing-function: steps(17, end);
        }
        27%,
        100% {
            clip-path: inset(0);
        }
    }

    @keyframes secrets-mock-type-2 {
        0%,
        29% {
            clip-path: inset(0 100% 0 0);
            animation-timing-function: steps(16, end);
        }
        37%,
        100% {
            clip-path: inset(0);
        }
    }

    @keyframes secrets-mock-added {
        0%,
        48% {
            height: 0;
            border-top-width: 0;
            background: color-mix(in srgb, var(--ring) 14%, var(--panel));
            animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }
        53%,
        60% {
            height: 3em;
            border-top-width: 1px;
            background: color-mix(in srgb, var(--ring) 14%, var(--panel));
        }
        66%,
        96% {
            height: 3em;
            border-top-width: 1px;
            background: var(--panel);
            opacity: 1;
        }
        99%,
        100% {
            height: 3em;
            border-top-width: 1px;
            background: var(--panel);
            opacity: 0;
        }
    }

    @keyframes secrets-mock-flow {
        0%,
        63% {
            opacity: 0;
            transform: translateY(1.2em) scale(0.97);
            animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }
        68%,
        96% {
            opacity: 1;
            transform: none;
        }
        99%,
        100% {
            opacity: 0;
            transform: none;
        }
    }

    @keyframes secrets-mock-use {
        0%,
        70% {
            background: transparent;
            color: var(--text);
        }
        74%,
        100% {
            background: var(--wait-bg);
            color: var(--wait);
        }
    }

    @keyframes secrets-mock-cursor {
        0% {
            opacity: 0;
            transform: translate(30em, 20em);
        }
        3% {
            opacity: 1;
            transform: translate(30em, 20em);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        8%,
        12% {
            opacity: 1;
            transform: translate(42.5em, 4.4em);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        17%,
        38% {
            opacity: 1;
            transform: translate(45.5em, 10.3em);
            animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }
        43%,
        47% {
            opacity: 1;
            transform: translate(46.9em, 22.1em);
        }
        52%,
        100% {
            opacity: 0;
            transform: translate(46.9em, 22.1em);
        }
    }
</style>
