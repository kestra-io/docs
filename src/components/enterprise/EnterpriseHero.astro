---
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"
import kestraMark from "~/components/home/assets/ai/kestra-logo-mark-on-dark.svg"
import ProductOverline from "~/components/common/ProductOverline.astro"

const CARDS = [
    {
        id: "governance",
        label: "Governance",
        states: [
            { value: "Audit logs", tag: "Logged", tone: "success" },
            { value: "Approvals", tag: "Approved", tone: "success" },
        ],
    },
    {
        id: "security",
        label: "Security",
        states: [
            { value: "SSO", tag: "Signed in", tone: "success" },
            { value: "Secrets", tag: "Encrypted", tone: "running" },
        ],
    },
    {
        id: "control",
        label: "Control",
        states: [
            { value: "RBAC", tag: "Allowed", tone: "success" },
            { value: "Policies", tag: "Enforced", tone: "success" },
        ],
    },
    {
        id: "scalability",
        label: "Scalability",
        states: [
            { value: "Worker groups", tag: "Running", tone: "running" },
            { value: "HA queues", tag: "Healthy", tone: "success" },
        ],
    },
]

const TARGETS = [
    { name: "On premise", angle: 45 },
    { name: "Cloud", angle: 135 },
    { name: "Hybrid", angle: 225 },
    { name: "Air-gapped", angle: 315 },
]
const beam = (angle: number, r: number) => {
    const rad = (angle * Math.PI) / 180
    return [(Math.sin(rad) * r).toFixed(1), (-Math.cos(rad) * r).toFixed(1)]
}

const WHEEL = CARDS
const STEP = 360 / WHEEL.length
const RINGS = [{ r: 590 }, { r: 372, dash: "3 13", k: 1 }]
let seed = 7
const random = () => {
    seed = (seed * 16807) % 2147483647
    return seed / 2147483647
}
const dust = (count: number, size: number) =>
    Array.from({ length: count }, () => ({
        x: +(random() * 1600).toFixed(1),
        y: +(random() * 800).toFixed(1),
        s: +(size * (0.7 + random() * 0.6)).toFixed(1),
        o: +(0.35 + random() * 0.65).toFixed(2),
    }))
const DUST = [
    { depth: "far", squares: dust(70, 3) },
    { depth: "mid", squares: dust(30, 6) },
    { depth: "near", squares: dust(9, 16) },
]
---

<section class="ee-hero" aria-labelledby="ee-hero-title">
    <PixelEdges left="tall" right="wide" />
    <div class="frame surface-dark" data-header-dark data-ee-orbit>
        <div class="depth" aria-hidden="true">
            {DUST.map((layer) => (
                <svg
                    class={layer.depth}
                    viewBox="0 0 1600 800"
                    preserveAspectRatio="xMidYMid slice"
                >
                    {layer.squares.map((square) => (
                        <rect
                            x={square.x}
                            y={square.y}
                            width={square.s}
                            height={square.s}
                            opacity={square.o}
                        />
                    ))}
                </svg>
            ))}
        </div>
        <div class="container-xl">
            <div class="stage">
                <div class="copy">
                    <ProductOverline align="responsive">
                        Kestra Enterprise
                    </ProductOverline>
                    <h1 id="ee-hero-title">
                        Scale orchestration across teams.
                    </h1>
                    <p class="lead">
                        Kestra Enterprise gives your teams the security,
                        governance, and operational capabilities to automate
                        workflows across your organization.
                    </p>
                    <div class="buttons">
                        <a href="/demo" class="btn-solid">
                            Book a demo <Icon name="mdi:chevron-right" />
                        </a>
                        <a href="/pricing#comparison-table" class="btn-ghost">
                            Compare editions
                        </a>
                    </div>
                </div>

                <div class="orbit" aria-hidden="true">
                    <div class="hub" data-hub>
                        <svg class="rings" viewBox="-480 -480 960 960">
                            {RINGS.map((ring) => (
                                <circle
                                    r={ring.r}
                                    class:list={{ dashed: !!ring.dash }}
                                    style={
                                        ring.dash
                                            ? `--k: ${ring.k}; stroke-dasharray: ${ring.dash}`
                                            : undefined
                                    }
                                />
                            ))}
                            {TARGETS.map((target) => (
                                <line
                                    class="beam"
                                    x1={beam(target.angle, 96)[0]}
                                    y1={beam(target.angle, 96)[1]}
                                    x2={beam(target.angle, 520)[0]}
                                    y2={beam(target.angle, 520)[1]}
                                    pathLength="1"
                                />
                            ))}
                        </svg>
                        <ul class="targets">
                            {TARGETS.map((target, idx) => (
                                <li
                                    style={`--x: ${Math.sin((target.angle * Math.PI) / 180).toFixed(4)}; --y: ${(-Math.cos((target.angle * Math.PI) / 180)).toFixed(4)}; --i: ${idx}`}
                                >
                                    <i />
                                    {target.name}
                                </li>
                            ))}
                        </ul>
                        <span class="plane">Control plane</span>
                        <div class="wheel" data-wheel>
                            {WHEEL.map((card, idx) => (
                                <div
                                    class="glimpse"
                                    style={`--a: ${idx * STEP}deg`}
                                    data-card
                                    data-angle={idx * STEP}
                                    data-states={JSON.stringify(card.states)}
                                    data-tone={card.states[0].tone}
                                >
                                    <p class="label">{card.label}</p>
                                    <div class="live">
                                        <p class="value" data-value>
                                            {card.states[0].value}
                                        </p>
                                        <p class="state" data-tag>
                                            {card.states[0].tag}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                        <span class="core" data-core>
                            <span class="pips">
                                {CARDS.map(() => (
                                    <i data-pip />
                                ))}
                            </span>
                            <img
                                src={kestraMark.src}
                                alt=""
                                width="44"
                                height="44"
                            />
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const ADVANCE_MS = 720
    const FLIGHT_MS = 620

    interface State {
        value: string
        tag: string
        tone: string
    }

    function playOrbit(frame: HTMLElement) {
        const core = frame.querySelector<HTMLElement>("[data-core]")
        const hub = frame.querySelector<HTMLElement>("[data-hub]")
        const wheel = frame.querySelector<HTMLElement>("[data-wheel]")
        if (!core || !hub || !wheel) return
        const pips = [...core.querySelectorAll<HTMLElement>("[data-pip]")]
        const cards = [
            ...wheel.querySelectorAll<HTMLElement>("[data-card]"),
        ].map((el) => ({
            el,
            value: el.querySelector<HTMLElement>("[data-value]")!,
            tag: el.querySelector<HTMLElement>("[data-tag]")!,
            states: JSON.parse(el.dataset.states!) as State[],
            angle: Number(el.dataset.angle),
            step: 0,
            spentAt: -1,
        }))
        const flash = (el: HTMLElement, name: string, ms: number) => {
            el.classList.add(name)
            window.setTimeout(() => el.classList.remove(name), ms)
        }
        const setLevel = (level: number) => {
            core.style.setProperty("--level", String(level))
            core.classList.toggle("full", level >= pips.length)
            pips.forEach((pip, idx) => pip.classList.toggle("on", idx < level))
        }

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            hub.style.setProperty("--turn", "0deg")
            setLevel(pips.length)
            hub.classList.add("firing")
            return
        }

        let level = 0
        let holding = false
        let index = 0

        const absorb = (card: (typeof cards)[number]) => {
            if (holding) return
            const radius = parseFloat(
                getComputedStyle(hub).getPropertyValue("--rc-px"),
            )
            const ghost = card.el.cloneNode(true) as HTMLElement
            ghost.removeAttribute("data-card")
            ghost.removeAttribute("style")
            ghost.classList.add("flying")
            hub.insertBefore(ghost, core)
            const target = core.offsetTop + core.offsetHeight / 2
            ghost.animate(
                [
                    {
                        transform: `translateY(${-radius}px) scale(1)`,
                        opacity: 1,
                    },
                    { opacity: 1, offset: 0.8 },
                    {
                        transform: `translateY(${target}px) scale(0.16)`,
                        opacity: 0.2,
                    },
                ],
                {
                    duration: FLIGHT_MS,
                    easing: "cubic-bezier(0.6, 0, 0.9, 0.6)",
                    fill: "forwards",
                },
            ).onfinish = () => {
                ghost.remove()
                level = Math.min(level + 1, pips.length)
                setLevel(level)
                flash(core, "ping", 500)
                if (level < pips.length) return
                holding = true
                hub.classList.add("firing")
                window.setTimeout(() => {
                    level = 0
                    setLevel(0)
                    hub.classList.remove("firing")
                    holding = false
                }, 3200)
            }
            card.el.classList.add("spent")
            card.spentAt = index
        }

        const refill = (card: (typeof cards)[number]) => {
            card.step = (card.step + 1) % card.states.length
            const state = card.states[card.step]
            card.value.textContent = state.value
            card.tag.textContent = state.tag
            card.el.dataset.tone = state.tone
            card.el.classList.remove("spent")
            card.spentAt = -1
            flash(card.el, "fresh", 600)
        }

        const measure = () => {
            const probe = document.createElement("span")
            probe.style.cssText =
                "position:absolute;visibility:hidden;width:var(--rc)"
            hub.appendChild(probe)
            hub.style.setProperty("--rc-px", String(probe.offsetWidth))
            probe.remove()
        }
        measure()
        new ResizeObserver(measure).observe(frame)

        const count = cards.length
        const step = 360 / count
        const wait = (ms: number) =>
            new Promise<void>((resolve) => window.setTimeout(resolve, ms))
        let running = false
        let looping = false

        const loop = async () => {
            if (looping) return
            looping = true
            while (running) {
                if (holding) {
                    await wait(200)
                    continue
                }
                index++
                hub.style.setProperty("--turn", `${index * step}deg`)
                for (const spent of cards)
                    if (spent.spentAt >= 0 && index - spent.spentAt >= 1)
                        refill(spent)
                await wait(ADVANCE_MS)
                if (!running) break
                const locked = cards[(count - (index % count)) % count]
                if (!holding) flash(locked.el, "ping", 420)
                await wait(260)
                const card = cards[(count - (index % count)) % count]
                if (!card.el.offsetParent) continue
                hub.style.setProperty("--spin", `${index * -40}deg`)
                if (!holding) {
                    absorb(card)
                    await wait(FLIGHT_MS + 260)
                } else {
                    await wait(420)
                }
            }
            looping = false
        }

        new IntersectionObserver(([entry]) => {
            running = entry.isIntersecting
            if (running) loop()
        }).observe(frame)
    }

    function startOrbits() {
        document
            .querySelectorAll<HTMLElement>("[data-ee-orbit]:not([data-wired])")
            .forEach((frame) => {
                frame.dataset.wired = ""
                playOrbit(frame)
            })
    }

    document.addEventListener("astro:page-load", startOrbits)
    startOrbits()

    function clearMenu() {
        if (!document.querySelector("[data-ee-orbit]")) return
        document.body.setAttribute("data-header-clear", "")
        document.addEventListener(
            "astro:before-swap",
            () => document.body.removeAttribute("data-header-clear"),
            { once: true },
        )
    }

    document.addEventListener("astro:page-load", clearMenu)
    clearMenu()
</script>

<style lang="scss">
    .ee-hero {
        position: relative;
        margin-top: -67px;
        background: var(--ks-background-body);
    }

    .frame {
        --success: #5ee3ae;
        --running: #b39aff;
        --warning: #f28c5c;
        --danger: #ff6b6b;
        --neutral: #b9b9c6;
        --card: rgb(52, 44, 118);

        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                34% 48% at 72% 52%,
                rgba(112, 88, 255, 0.62),
                rgba(70, 58, 235, 0.26) 48%,
                transparent 74%
            ),
            radial-gradient(
                46% 60% at 100% 0%,
                rgba(40, 110, 255, 0.3),
                transparent 62%
            ),
            radial-gradient(
                40% 55% at 58% 118%,
                rgba(96, 70, 240, 0.42),
                transparent 70%
            ),
            radial-gradient(
                36% 50% at 0% 100%,
                rgba(70, 50, 210, 0.2),
                transparent 68%
            ),
            linear-gradient(165deg, #0c0a2a 0%, #151040 52%, #0c0a2a 100%);
        color: #ffffff;

        &::after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent 10%,
                rgba(118, 100, 255, 0.75) 50%,
                transparent 90%
            );
            pointer-events: none;
        }

        &::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(
                    90deg,
                    rgba(0, 0, 0, 0.15) 0%,
                    rgba(0, 0, 0, 0.06) 34%,
                    transparent 58%
                ),
                radial-gradient(
                    62% 78% at 72% 52%,
                    transparent 40%,
                    rgba(0, 0, 4, 0.18) 76%,
                    rgba(0, 0, 0, 0.3) 100%
                );
            pointer-events: none;

            @include media-breakpoint-down(lg) {
                background: radial-gradient(
                    95% 52% at 50% 74%,
                    transparent 40%,
                    rgba(0, 0, 4, 0.18) 78%,
                    rgba(0, 0, 0, 0.3) 100%
                );
            }
        }

        > .container-xl {
            position: relative;
            z-index: 1;
        }
    }

    .depth {
        position: absolute;
        inset: -4rem;
        pointer-events: none;

        svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            will-change: transform;
        }

        .far {
            fill: rgba(205, 200, 255, 0.45);
            animation: drift 46s ease-in-out infinite alternate;
        }

        .mid {
            fill: rgba(170, 155, 255, 0.4);
            animation: drift 34s ease-in-out -8s infinite alternate;
        }

        .near {
            fill: rgba(140, 120, 255, 0.16);
            animation: drift 26s ease-in-out -14s infinite alternate;
        }
    }

    @keyframes drift {
        from {
            transform: translate3d(-1.25%, 0.75%, 0);
        }

        to {
            transform: translate3d(1.25%, -0.75%, 0);
        }
    }

    .core {
        --level: 0;

        position: absolute;
        display: grid;
        place-items: center;
        width: 4.75rem;
        height: 4.75rem;
        z-index: 2;
        top: calc(var(--drop) - var(--rc));
        left: 0;
        margin: -2.375rem;
        border: 2px solid rgba(255, 255, 255, calc(0.3 + var(--level) * 0.08));
        border-radius: 0.875rem;
        background: var(--card);
        box-shadow:
            0 0 calc(18px + var(--level) * 16px) calc(var(--level) * 2px)
                rgba(124, 102, 255, calc(0.16 + var(--level) * 0.19)),
            0 0 0 1px rgba(0, 0, 0, 0.5);
        transform: translateZ(90px) scale(calc(1 + var(--level) * 0.04));
        transition:
            transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.6s ease,
            border-color 0.6s ease;

        img {
            position: relative;
            display: block;
            width: 92%;
            height: auto;
        }

        &::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: -130%;
            border-radius: 50%;
            background: radial-gradient(
                closest-side,
                rgba(112, 92, 255, calc(0.06 + var(--level) * 0.11)),
                transparent
            );
            transition: background 0.6s ease;
            pointer-events: none;
        }

        &::after {
            content: "";
            position: absolute;
            inset: -2px;
            padding: 2px;
            border-radius: inherit;
            background: conic-gradient(
                from var(--holo),
                transparent 0deg,
                rgba(91, 107, 255, 0.6) 80deg,
                #8f7bff 140deg,
                #ffffff 175deg,
                transparent 190deg,
                transparent 360deg
            );
            mask:
                linear-gradient(#000 0 0) content-box exclude,
                linear-gradient(#000 0 0);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }

        &:global(.ping) {
            transition-duration: 0.12s;
            transform: translateZ(90px) scale(calc(1.08 + var(--level) * 0.04));
        }

        &:global(.full)::after {
            opacity: 1;
            animation: holo 1.3s linear infinite;
        }
    }

    .pips {
        position: absolute;
        inset: 0;
    }

    .pips i {
        position: absolute;
        width: 0.375rem;
        height: 0.375rem;
        margin-top: -0.1875rem;
        background: rgba(255, 255, 255, 0.2);
        transition:
            background-color 0.4s ease,
            box-shadow 0.4s ease;

        &:nth-child(-n + 2) {
            left: -1.25rem;
        }

        &:nth-child(n + 3) {
            right: -1.75rem;
        }

        &:nth-child(odd) {
            top: 34%;
        }

        &:nth-child(even) {
            top: 66%;
        }

        &:global(.on) {
            background: #d9ceff;
            box-shadow:
                0 0 6px #ffffff,
                0 0 18px 3px rgba(143, 123, 255, 0.95);
        }
    }

    @property --spin {
        syntax: "<angle>";
        inherits: true;
        initial-value: 0deg;
    }

    @property --turn {
        syntax: "<angle>";
        inherits: true;
        initial-value: 0deg;
    }

    .orbit {
        --rc: 13.5rem;
        --drop: var(--rc);

        position: relative;
        height: 39rem;
        perspective: 1100px;

        @include media-breakpoint-up(lg) {
            translate: -3rem 0;
        }

        @include media-breakpoint-between(lg, xl) {
            height: 32rem;
            translate: 0 0;
            scale: 0.76;
        }

        @include media-breakpoint-down(lg) {
            margin-top: 2rem;
        }

        @include media-breakpoint-down(md) {
            --rc: 9.5rem;

            order: 1;
            width: 100%;
            height: 21rem;
            margin-top: 0.5rem;
        }
    }

    .hub {
        --turn: 0deg;
        --spin: 0deg;

        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        transform: rotateX(15deg) rotateY(-13deg);
        transform-style: preserve-3d;
        transition:
            --turn 0.72s cubic-bezier(0.16, 1, 0.3, 1),
            --spin 0.9s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);

        @include media-breakpoint-down(md) {
            transform: rotateX(10deg) rotateY(-10deg) scale(0.7);
        }

        &::after {
            content: "";
            position: absolute;
            inset: calc(var(--rc) * -0.78);
            border-radius: 50%;
            background: radial-gradient(
                closest-side,
                rgba(140, 120, 255, 0.34),
                rgba(98, 78, 255, 0.12) 60%,
                transparent
            );
            pointer-events: none;
            transform: translateZ(-40px);
        }
    }

    .rings {
        position: absolute;
        width: calc(var(--rc) * 2);
        height: calc(var(--rc) * 2);
        margin: calc(var(--rc) * -1);
        overflow: visible;
        pointer-events: none;
        transform: translateZ(-8px);

        filter: drop-shadow(0 0 7px rgba(126, 104, 255, 0.75));
        transition: filter 0.6s ease;

        :global(.firing) & {
            filter: drop-shadow(0 0 5px rgba(226, 218, 255, 0.9))
                drop-shadow(0 0 22px rgba(126, 104, 255, 1));
            transition-delay: 0.2s;
        }

        circle {
            fill: none;
            stroke: rgba(206, 198, 255, 0.85);
            stroke-width: 2.5;
            vector-effect: non-scaling-stroke;
        }

        .dashed {
            stroke: rgba(196, 184, 255, 0.8);
            stroke-width: 3;
            stroke-linecap: round;
            transform: rotate(calc(var(--spin) * var(--k)));
        }

        .beam {
            stroke: #b9a6ff;
            stroke-width: 2.5;
            stroke-dasharray: 1;
            stroke-dashoffset: 1;
            opacity: 0;
            transition:
                stroke-dashoffset 0.4s ease,
                opacity 0.4s ease;

            :global(.firing) & {
                stroke: #e2daff;
                stroke-dashoffset: 0;
                opacity: 1;
                filter: drop-shadow(0 0 6px #8f7bff);
                transition:
                    stroke-dashoffset 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
                    opacity 0.2s ease 0.2s;
            }
        }
    }

    .targets {
        margin: 0;
        padding: 0;
        list-style: none;

        li {
            position: absolute;
            top: calc(var(--y) * var(--rc) * 1.235);
            left: calc(var(--x) * var(--rc) * 1.235);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.625rem;
            border-radius: 0.5rem;
            translate: -50% -50%;
            background: var(--card);
            box-shadow: inset 0 0 0 1px rgba(214, 204, 255, 0.45);
            font-size: 0.8125rem;
            font-weight: 500;
            white-space: nowrap;
            color: rgba(255, 255, 255, 0.78);
            transition:
                color 0.4s ease,
                filter 0.5s ease,
                scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);

            i {
                width: 0.375rem;
                height: 0.375rem;
                background: rgba(255, 255, 255, 0.3);
                transition:
                    background-color 0.4s ease,
                    box-shadow 0.4s ease;
            }

            :global(.firing) & {
                color: #ffffff;
                scale: 1.06;
                filter: drop-shadow(0 0 14px rgba(143, 123, 255, 0.85));
                transition-delay: calc(0.75s + var(--i) * 0.08s);

                i {
                    background: #5ee3ae;
                    box-shadow:
                        0 0 6px #ffffff,
                        0 0 16px 3px rgba(94, 227, 174, 0.9);
                    transition-delay: calc(0.75s + var(--i) * 0.08s);
                }
            }
        }
    }

    .plane {
        position: absolute;
        top: -4.25rem;
        left: 0;
        translate: -50% 0;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        white-space: nowrap;
        color: rgba(255, 255, 255, 0.6);
        transform: translateZ(90px);
        transition:
            color 0.4s ease,
            text-shadow 0.4s ease;

        :global(.firing) & {
            color: #ffffff;
            text-shadow:
                0 0 6px rgba(226, 218, 255, 0.7),
                0 0 18px rgba(143, 123, 255, 0.95);
            transition-delay: 0.2s;
        }
    }

    .wheel {
        position: absolute;
        width: 0;
        height: 0;
        transform-style: preserve-3d;
    }

    .wheel .glimpse {
