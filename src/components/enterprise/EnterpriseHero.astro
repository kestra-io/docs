---
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"
import kestraMark from "~/components/home/assets/ai/kestra-logo-mark-on-dark.svg"

const CARDS = [
    {
        id: "governance",
        label: "Governance",
        states: [
            { value: "Audit logs", tag: "Logged", tone: "success" },
            { value: "Approvals", tag: "Approved", tone: "success" },
        ],
    },
    {
        id: "security",
        label: "Security",
        states: [
            { value: "SSO", tag: "Signed in", tone: "success" },
            { value: "Secrets", tag: "Encrypted", tone: "running" },
        ],
    },
    {
        id: "control",
        label: "Control",
        states: [
            { value: "RBAC", tag: "Allowed", tone: "success" },
            { value: "Policies", tag: "Enforced", tone: "success" },
        ],
    },
    {
        id: "scalability",
        label: "Scalability",
        states: [
            { value: "Worker groups", tag: "Running", tone: "running" },
            { value: "HA queues", tag: "Healthy", tone: "success" },
        ],
    },
]

const TARGETS = [
    { name: "On premise", angle: 45 },
    { name: "Cloud", angle: 135 },
    { name: "Hybrid", angle: 225 },
    { name: "Air-gapped", angle: 315 },
]
const beam = (angle: number, r: number) => {
    const rad = (angle * Math.PI) / 180
    return [(Math.sin(rad) * r).toFixed(1), (-Math.cos(rad) * r).toFixed(1)]
}

const WHEEL = CARDS
const STEP = 360 / WHEEL.length
const RINGS = [{ r: 590 }, { r: 372, dash: "3 13", k: 1 }]
---

<section class="ee-hero" aria-labelledby="ee-hero-title">
    <PixelEdges left="tall" right="wide" />
    <div class="frame surface-dark" data-header-dark data-ee-orbit>
        <div class="container-xl">
            <div class="stage">
                <div class="copy">
                    <p class="eyebrow" data-edition>
                        <span class="sheen" />
                        <img
                            class="kestra"
                            src={kestraMark.src}
                            alt=""
                            width="16"
                            height="16"
                        />
                        <span class="name">Kestra Enterprise</span>
                    </p>
                    <h1 id="ee-hero-title">
                        Scale orchestration across teams.
                    </h1>
                    <p class="lead">
                        Kestra Enterprise adds security, governance and
                        SLA-backed support on top of the Apache 2.0 core. Run it
                        self-hosted, in your cloud or air-gapped.
                    </p>
                    <div class="buttons">
                        <a href="/demo" class="btn-solid">
                            Book a demo <Icon name="mdi:chevron-right" />
                        </a>
                        <a href="/pricing#compare" class="btn-ghost">
                            Find your edition
                        </a>
                    </div>
                </div>

                <div class="orbit" aria-hidden="true">
                    <div class="hub" data-hub>
                        <svg class="rings" viewBox="-480 -480 960 960">
                            {RINGS.map((ring) => (
                                <circle
                                    r={ring.r}
                                    class:list={{ dashed: !!ring.dash }}
                                    style={
                                        ring.dash
                                            ? `--k: ${ring.k}; stroke-dasharray: ${ring.dash}`
                                            : undefined
                                    }
                                />
                            ))}
                            {TARGETS.map((target) => (
                                <line
                                    class="beam"
                                    x1={beam(target.angle, 96)[0]}
                                    y1={beam(target.angle, 96)[1]}
                                    x2={beam(target.angle, 520)[0]}
                                    y2={beam(target.angle, 520)[1]}
                                    pathLength="1"
                                />
                            ))}
                        </svg>
                        <ul class="targets">
                            {TARGETS.map((target, idx) => (
                                <li
                                    style={`--x: ${Math.sin((target.angle * Math.PI) / 180).toFixed(4)}; --y: ${(-Math.cos((target.angle * Math.PI) / 180)).toFixed(4)}; --i: ${idx}`}
                                >
                                    <i />
                                    {target.name}
                                </li>
                            ))}
                        </ul>
                        <span class="plane">Control plane</span>
                        <div class="wheel" data-wheel>
                            {WHEEL.map((card, idx) => (
                                <div
                                    class="glimpse"
                                    style={`--a: ${idx * STEP}deg`}
                                    data-card
                                    data-angle={idx * STEP}
                                    data-states={JSON.stringify(card.states)}
                                    data-tone={card.states[0].tone}
                                >
                                    <p class="label">{card.label}</p>
                                    <div class="live">
                                        <p class="value" data-value>
                                            {card.states[0].value}
                                        </p>
                                        <p class="state" data-tag>
                                            {card.states[0].tag}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                        <span class="core" data-core>
                            <span class="pips">
                                {CARDS.map(() => (
                                    <i data-pip />
                                ))}
                            </span>
                            <img
                                src={kestraMark.src}
                                alt=""
                                width="44"
                                height="44"
                            />
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const ADVANCE_MS = 720
    const FLIGHT_MS = 620

    interface State {
        value: string
        tag: string
        tone: string
    }

    function playOrbit(frame: HTMLElement) {
        const core = frame.querySelector<HTMLElement>("[data-core]")
        const hub = frame.querySelector<HTMLElement>("[data-hub]")
        const wheel = frame.querySelector<HTMLElement>("[data-wheel]")
        if (!core || !hub || !wheel) return
        const pips = [...core.querySelectorAll<HTMLElement>("[data-pip]")]
        const cards = [
            ...wheel.querySelectorAll<HTMLElement>("[data-card]"),
        ].map((el) => ({
            el,
            value: el.querySelector<HTMLElement>("[data-value]")!,
            tag: el.querySelector<HTMLElement>("[data-tag]")!,
            states: JSON.parse(el.dataset.states!) as State[],
            angle: Number(el.dataset.angle),
            step: 0,
            spentAt: -1,
        }))
        const edition = frame.querySelector<HTMLElement>("[data-edition]")
        const flash = (el: HTMLElement, name: string, ms: number) => {
            el.classList.add(name)
            window.setTimeout(() => el.classList.remove(name), ms)
        }
        const setLevel = (level: number) => {
            core.style.setProperty("--level", String(level))
            core.classList.toggle("full", level >= pips.length)
            pips.forEach((pip, idx) => pip.classList.toggle("on", idx < level))
        }

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            hub.style.setProperty("--turn", "0deg")
            setLevel(pips.length)
            hub.classList.add("firing")
            return
        }

        let level = 0
        let holding = false
        let index = 0

        const absorb = (card: (typeof cards)[number]) => {
            if (holding) return
            const radius = parseFloat(
                getComputedStyle(hub).getPropertyValue("--rc-px"),
            )
            const ghost = card.el.cloneNode(true) as HTMLElement
            ghost.removeAttribute("data-card")
            ghost.removeAttribute("style")
            ghost.classList.add("flying")
            hub.insertBefore(ghost, core)
            const target = core.offsetTop + core.offsetHeight / 2
            ghost.animate(
                [
                    {
                        transform: `translateY(${-radius}px) scale(1)`,
                        opacity: 1,
                    },
                    {
                        transform: `translateY(${target}px) scale(0.16)`,
                        opacity: 0.2,
                    },
                ],
                {
                    duration: FLIGHT_MS,
                    easing: "cubic-bezier(0.6, 0, 0.9, 0.6)",
                    fill: "forwards",
                },
            ).onfinish = () => {
                ghost.remove()
                level = Math.min(level + 1, pips.length)
                setLevel(level)
                flash(core, "ping", 500)
                if (level < pips.length) return
                holding = true
                hub.classList.add("firing")
                if (edition) flash(edition, "ping", 1600)
                window.setTimeout(() => {
                    level = 0
                    setLevel(0)
                    hub.classList.remove("firing")
                    holding = false
                }, 3200)
            }
            card.el.classList.add("spent")
            card.spentAt = index
        }

        const refill = (card: (typeof cards)[number]) => {
            card.step = (card.step + 1) % card.states.length
            const state = card.states[card.step]
            card.value.textContent = state.value
            card.tag.textContent = state.tag
            card.el.dataset.tone = state.tone
            card.el.classList.remove("spent")
            card.spentAt = -1
            flash(card.el, "fresh", 600)
        }

        const measure = () => {
            const probe = document.createElement("span")
            probe.style.cssText =
                "position:absolute;visibility:hidden;width:var(--rc)"
            hub.appendChild(probe)
            hub.style.setProperty("--rc-px", String(probe.offsetWidth))
            probe.remove()
        }
        measure()
        new ResizeObserver(measure).observe(frame)

        const count = cards.length
        const step = 360 / count
        const wait = (ms: number) =>
            new Promise<void>((resolve) => window.setTimeout(resolve, ms))
        let running = false
        let looping = false

        const loop = async () => {
            if (looping) return
            looping = true
            while (running) {
                if (holding) {
                    await wait(200)
                    continue
                }
                index++
                hub.style.setProperty("--turn", `${index * step}deg`)
                for (const spent of cards)
                    if (spent.spentAt >= 0 && index - spent.spentAt >= 1)
                        refill(spent)
                await wait(ADVANCE_MS)
                if (!running) break
                const locked = cards[(count - (index % count)) % count]
                if (!holding) flash(locked.el, "ping", 420)
                await wait(260)
                const card = cards[(count - (index % count)) % count]
                if (!card.el.offsetParent) continue
                hub.style.setProperty("--spin", `${index * -40}deg`)
                if (!holding) {
                    absorb(card)
                    await wait(FLIGHT_MS + 260)
                } else {
                    await wait(420)
                }
            }
            looping = false
        }

        new IntersectionObserver(([entry]) => {
            running = entry.isIntersecting
            if (running) loop()
        }).observe(frame)
    }

    function startOrbits() {
        document
            .querySelectorAll<HTMLElement>("[data-ee-orbit]:not([data-wired])")
            .forEach((frame) => {
                frame.dataset.wired = ""
                playOrbit(frame)
            })
    }

    document.addEventListener("astro:page-load", startOrbits)
    startOrbits()

    function clearMenu() {
        if (!document.querySelector("[data-ee-orbit]")) return
        document.body.setAttribute("data-header-clear", "")
        document.addEventListener(
            "astro:before-swap",
            () => document.body.removeAttribute("data-header-clear"),
            { once: true },
        )
    }

    document.addEventListener("astro:page-load", clearMenu)
    clearMenu()
</script>

<style lang="scss">
    .ee-hero {
        position: relative;
        margin-top: -67px;
        background: var(--ks-background-body);
    }

    .frame {
        --success: #5ee3ae;
        --running: #9d78ff;
        --warning: #f28c5c;
        --danger: #ff6b6b;
        --neutral: #b9b9c6;

        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                50% 68% at 74% 50%,
                rgba(98, 78, 255, 0.55),
                rgba(58, 60, 235, 0.22) 46%,
                transparent 70%
            ),
            radial-gradient(
                65% 85% at 100% 0%,
                rgba(33, 136, 255, 0.42),
                transparent 64%
            ),
            radial-gradient(
                60% 80% at 0% 100%,
                rgba(84, 62, 230, 0.5),
                transparent 66%
            ),
            radial-gradient(
                55% 60% at 55% 115%,
                rgba(70, 90, 177, 0.55),
                transparent 70%
            ),
            linear-gradient(160deg, #0a0b28 0%, #131747 55%, #0d0f36 100%);
        color: #ffffff;

        &::after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent 10%,
                rgba(118, 100, 255, 0.75) 50%,
                transparent 90%
            );
            pointer-events: none;
        }

        > .container-xl {
            position: relative;
            z-index: 1;
        }
    }

    .core {
        --level: 0;

        position: absolute;
        display: grid;
        place-items: center;
        width: 4.75rem;
        height: 4.75rem;
        z-index: 2;
        top: calc(var(--drop) - var(--rc));
        left: 0;
        margin: -2.375rem;
        border: 1px solid rgba(255, 255, 255, calc(0.18 + var(--level) * 0.07));
        border-radius: 0.875rem;
        background: linear-gradient(180deg, #2a2a31, #151519);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.18),
            0 0 calc(16px + var(--level) * 9px)
                rgba(110, 90, 255, calc(0.12 + var(--level) * 0.1)),
            0 18px 44px rgba(0, 0, 0, 0.6);
        transform: scale(calc(1 + var(--level) * 0.04));
        transition:
            transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.6s ease,
            border-color 0.6s ease;

        img {
            position: relative;
            display: block;
            width: 92%;
            height: auto;
        }

        &::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: -130%;
            border-radius: 50%;
            background: radial-gradient(
                closest-side,
                rgba(95, 77, 255, calc(0.05 + var(--level) * 0.055)),
                transparent
            );
            transition: background 0.6s ease;
            pointer-events: none;
        }

        &::after {
            content: "";
            position: absolute;
            inset: -2px;
            padding: 2px;
            border-radius: inherit;
            background: conic-gradient(
                from var(--holo),
                transparent 0deg,
                rgba(91, 107, 255, 0.6) 80deg,
                #8f7bff 140deg,
                #ffffff 175deg,
                transparent 190deg,
                transparent 360deg
            );
            mask:
                linear-gradient(#000 0 0) content-box exclude,
                linear-gradient(#000 0 0);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }

        &:global(.ping) {
            transition-duration: 0.12s;
            transform: scale(calc(1.08 + var(--level) * 0.04));
        }

        &:global(.full)::after {
            opacity: 1;
            animation: holo 1.3s linear infinite;
        }
    }

    .pips {
        position: absolute;
        inset: 0;
    }

    .pips i {
        position: absolute;
        width: 0.375rem;
        height: 0.375rem;
        margin-top: -0.1875rem;
        background: rgba(255, 255, 255, 0.2);
        transition:
            background-color 0.4s ease,
            box-shadow 0.4s ease;

        &:nth-child(-n + 2) {
            left: -0.875rem;
        }

        &:nth-child(n + 3) {
            right: -0.875rem;
        }

        &:nth-child(odd) {
            top: 34%;
        }

        &:nth-child(even) {
            top: 66%;
        }

        &:global(.on) {
            background: #b9a6ff;
            box-shadow: 0 0 10px rgba(143, 123, 255, 0.9);
        }
    }

    @property --spin {
        syntax: "<angle>";
        inherits: true;
        initial-value: 0deg;
    }

    @property --turn {
        syntax: "<angle>";
        inherits: true;
        initial-value: 0deg;
    }

    .orbit {
        --rc: 13.5rem;
        --drop: var(--rc);

        position: relative;
        height: 39rem;

        @include media-breakpoint-up(lg) {
            translate: -3rem 0;
        }

        @include media-breakpoint-down(lg) {
            margin-top: 2rem;
        }

        @include media-breakpoint-down(md) {
            --rc: 9.5rem;

            height: 25rem;
        }
    }

    .hub {
        --turn: 0deg;
        --spin: 0deg;

        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        transition:
            --turn 0.72s cubic-bezier(0.16, 1, 0.3, 1),
            --spin 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .rings {
        position: absolute;
        width: calc(var(--rc) * 2);
        height: calc(var(--rc) * 2);
        margin: calc(var(--rc) * -1);
        overflow: visible;
        pointer-events: none;

        circle {
            fill: none;
            stroke: rgba(170, 160, 255, 0.3);
            vector-effect: non-scaling-stroke;
        }

        .dashed {
            stroke: rgba(185, 170, 255, 0.55);
            transform: rotate(calc(var(--spin) * var(--k)));
        }

        .beam {
            stroke: #b9a6ff;
            stroke-width: 1.5;
            stroke-dasharray: 1;
            stroke-dashoffset: 1;
            opacity: 0;
            transition:
                stroke-dashoffset 0.4s ease,
                opacity 0.4s ease;

            :global(.firing) & {
                stroke-dashoffset: 0;
                opacity: 0.9;
                transition:
                    stroke-dashoffset 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
                    opacity 0.2s ease 0.2s;
            }
        }
    }

    .targets {
        margin: 0;
        padding: 0;
        list-style: none;

        li {
            position: absolute;
            top: calc(var(--y) * var(--rc) * 1.235);
            left: calc(var(--x) * var(--rc) * 1.235);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.625rem;
            translate: -50% -50%;
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(14px);
            font-size: 0.8125rem;
            font-weight: 500;
            white-space: nowrap;
            color: rgba(255, 255, 255, 0.55);
            transition:
                color 0.4s ease,
                scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);

            i {
                width: 0.375rem;
                height: 0.375rem;
                background: rgba(255, 255, 255, 0.3);
                transition:
                    background-color 0.4s ease,
                    box-shadow 0.4s ease;
            }

            :global(.firing) & {
                color: #ffffff;
                scale: 1.06;
                transition-delay: calc(0.75s + var(--i) * 0.08s);

                i {
                    background: #5ee3ae;
                    box-shadow: 0 0 10px rgba(94, 227, 174, 0.8);
                    transition-delay: calc(0.75s + var(--i) * 0.08s);
                }
            }
        }
    }

    .plane {
        position: absolute;
        top: -4.25rem;
        left: 0;
        translate: -50% 0;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        white-space: nowrap;
        color: rgba(255, 255, 255, 0.6);
    }

    .wheel {
        position: absolute;
        width: 0;
        height: 0;
    }

    .wheel .glimpse {
        --t: calc(var(--a) + var(--turn));
        --c: cos(var(--t));

        top: 0;
        left: 0;
        translate: -50% -50%;
        transform: translate(
                calc(sin(var(--t)) * var(--rc)),
                calc(var(--c) * var(--rc) * -1)
            )
            scale(calc(0.88 + 0.12 * var(--c)));
        opacity: calc(0.7 + 0.3 * var(--c));

        &:global(.spent) {
            visibility: hidden;
        }

        &:global(.fresh) {
            animation: fresh 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @include media-breakpoint-down(md) {
            width: 8.25rem;
        }
    }

    @keyframes fresh {
        from {
            opacity: 0;
            scale: 0.7;
        }
    }

    .hub > .glimpse:global(.flying) {
        z-index: 1;
        top: 0;
        left: 0;
        translate: -50% -50%;
        pointer-events: none;
        will-change: transform, opacity;

        @include media-breakpoint-down(md) {
            width: 8.75rem;
        }
    }

    .stage {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 38rem);
        align-items: center;
        gap: 2rem 3rem;
        padding: 7.5rem clamp(1.5rem, 4vw, 3.5rem) 4rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
            padding: 7rem 0 2rem;
        }
    }

    .copy {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 36rem;

        @include media-breakpoint-down(lg) {
            align-items: center;
            margin-inline: auto;
            text-align: center;
        }
    }

    .eyebrow {
        position: relative;
        isolation: isolate;
        display: inline-flex;
        align-items: center;
        margin: 0 0 1.5rem;
        gap: 0.4375rem;
        padding: 0.3125rem 0.75rem 0.3125rem 0.5625rem;
        border-radius: 999px;
        overflow: hidden;
        background:
            radial-gradient(
                120% 140% at 0% 0%,
                rgba(255, 255, 255, 0.08),
                transparent 55%
            ),
            linear-gradient(
                160deg,
                rgba(130, 115, 190, 0.12),
                rgba(22, 21, 30, 0.5)
            );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.14),
            inset 0 -8px 14px -10px rgba(143, 91, 255, 0.14),
            0 10px 30px -12px rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(14px) saturate(1.5);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: #ffffff;
        transition: box-shadow 0.9s ease;

        &::before,
        &::after {
            content: "";
            position: absolute;
            z-index: 1;
            inset: 0;
            padding: 1.5px;
            border-radius: inherit;
            mask:
                linear-gradient(#000 0 0) content-box exclude,
                linear-gradient(#000 0 0);
            pointer-events: none;
        }

        &::before {
            background: linear-gradient(
                150deg,
                rgba(255, 255, 255, 0.45),
                rgba(190, 170, 255, 0.2) 40%,
                rgba(255, 255, 255, 0.08) 60%,
                rgba(180, 150, 255, 0.3)
            );
        }

        &::after {
            background: conic-gradient(
                from var(--holo),
                transparent 0deg,
                rgba(91, 107, 255, 0.5) 70deg,
                #8f7bff 120deg,
                #d9ceff 150deg,
                transparent 170deg,
                transparent 360deg
            );
            opacity: 0;
            transition: opacity 0.9s ease;
        }

        .kestra {
            position: relative;
            width: 1rem;
            height: 1rem;
        }

        .name {
            position: relative;
        }

        &:global(.ping) {
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.14),
                inset 0 -8px 14px -10px rgba(143, 91, 255, 0.14),
                0 0 16px -8px rgba(110, 120, 255, 0.4);
            transition-duration: 0.25s;

            &::after {
                opacity: 1;
                transition-duration: 0.2s;
                animation: holo 1.6s linear;
            }
        }
    }

    h1 {
        margin: 0;
