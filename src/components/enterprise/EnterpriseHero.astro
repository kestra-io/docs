---
import PixelEdges from "~/components/about/PixelEdges.astro"
import EnterpriseLayers from "~/components/home/EnterpriseLayers.astro"

const LAYERS = [
    { name: "Open source", note: "the core" },
    { name: "Secure", note: "SSO · RBAC · secrets" },
    { name: "Govern", note: "audit logs · approvals · policies" },
    { name: "Control", note: "who can do what, where" },
    { name: "Scale", note: "worker groups · tenants · HA queues" },
]
---

<section class="ee-hero" aria-labelledby="ee-hero-title">
    <PixelEdges left="tall" right="wide" />
    <div class="frame surface-dark" data-header-dark>
        <div class="container-xl">
            <div class="stage">
                <div class="copy">
                    <p class="eyebrow">Kestra Enterprise</p>
                    <h1 id="ee-hero-title">
                        Scale orchestration across teams.
                    </h1>
                    <p class="lead">
                        Kestra Enterprise gives your teams the security,
                        governance, and operational capabilities to automate
                        workflows across your organization.
                    </p>
                    <div class="buttons">
                        <a href="/demo" class="btn-solid">Book a demo</a>
                        <a href="/pricing#compare" class="btn-ghost">
                            Compare editions
                        </a>
                        <a href="/docs/getting-started" class="btn-ghost">
                            Try Open Source
                        </a>
                    </div>
                </div>
                <EnterpriseLayers layers={LAYERS} />
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .ee-hero {
        position: relative;
        margin-top: -1rem;
        border-bottom: 1px solid var(--ks-border-primary);
        background: var(--ks-background-body);
    }

    .frame {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                70% 80% at 85% 20%,
                rgba(132, 5, 255, 0.16),
                transparent 60%
            ),
            radial-gradient(
                90% 80% at 85% 10%,
                rgba(255, 255, 255, 0.06),
                transparent 60%
            ),
            #111114;
        color: #ffffff;
    }

    .stage {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        align-items: center;
        gap: 2rem 3rem;
        min-height: min(78vh, 760px);
        padding: 9rem clamp(1.5rem, 4vw, 3.5rem) 6rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
            min-height: 0;
        }

        @include media-breakpoint-down(md) {
            padding-block: 7rem 4rem;
        }
    }

    .eyebrow {
        margin: 0 0 1.25rem;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #b9a6ff;
    }

    h1 {
        max-width: 40rem;
        margin: 0;
        font-size: clamp(2.5rem, 5.2vw, 4.25rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.04;
        color: #ffffff;
        text-wrap: balance;
    }

    .lead {
        max-width: 36rem;
        margin: 1.5rem 0 0;
        font-size: 1.1875rem;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.68);
        text-wrap: pretty;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2.25rem;
    }
</style>
