---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import { toSlug } from "~/utils/stories"
import brainlab from "~/components/home/assets/companies/brainlab.svg"
import bloomberg from "~/components/home/assets/companies/bloomberg.svg"
import fila from "~/components/home/assets/companies/fila.svg"
import apple from "~/components/home/assets/companies/apple.svg"
import amdocs from "~/components/home/assets/companies/amdocs.svg"
import apotek from "~/components/demo/assets/logos/apotek.svg"

const COMPANIES = [
    { logo: brainlab, name: "Brainlab", scale: 1.1 },
    { logo: bloomberg, name: "Bloomberg", scale: 0.86 },
    { logo: fila, name: "FILA", story: "Fila", scale: 0.72 },
    { logo: apple, name: "Apple", story: "Apple", scale: 1, lift: 0.12 },
    { logo: amdocs, name: "Amdocs", story: "Amdocs", scale: 0.9 },
    { logo: apotek, name: "Apotek Hjärtat", scale: 0.95 },
]

const stories = await getCollection("customerStories")
const storyHref = (company?: string) => {
    const entry = company && stories.find((e) => e.data.companyName === company)
    return entry ? `/stories/${toSlug(entry)}` : undefined
}

const height = (logo: ImageMetadata, scale: number) =>
    (
        Math.min(1.75, 1.3 / Math.sqrt(logo.width / logo.height / 4.5)) * scale
    ).toFixed(3)
---

<section class="ee-logos" aria-label="Trusted by leading companies">
    <ul>
        {COMPANIES.map((company) => {
            const href = storyHref(company.story)
            const image = (
                <Image
                    src={company.logo}
                    alt={company.name}
                    style={`--h: ${height(company.logo, company.scale)}rem; translate: 0 ${-(company.lift ?? 0)}rem`}
                />
            )
            return (
                <li>
                    {href ? (
                        <a class="has-story" href={href}>
                            {image}
                            <span class="read">
                                Read story <span class="arrow">→</span>
                            </span>
                        </a>
                    ) : (
                        image
                    )}
                </li>
            )
        })}
    </ul>
</section>

<style lang="scss">
    .ee-logos {
        border-bottom: 1px solid var(--ks-border-primary);
        background: var(--ks-background-body);
        padding: clamp(2.5rem, 4vw, 3.5rem) var(--bs-gutter-x, 1.5rem);

        ul {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 1.75rem clamp(2rem, 5vw, 4.5rem);
            max-width: 80rem;
            margin: 0 auto;
            padding: 0;
            list-style: none;
        }

        li {
            display: flex;
        }

        .has-story {
            position: relative;
            display: flex;
            justify-content: center;
            color: inherit;
            text-decoration: none;

            .read {
                position: absolute;
                top: 100%;
                left: 50%;
                padding-top: 0.5rem;
                font-size: 0.75rem;
                font-weight: 500;
                white-space: nowrap;
                color: var(--ks-content-secondary);
                opacity: 0;
                translate: -50% -4px;
                transition:
                    opacity 0.2s ease,
                    translate 0.2s ease;
            }

            .arrow {
                display: inline-block;
                transition: transform 0.2s ease;
            }

            &:hover .read,
            &:focus-visible .read {
                color: var(--ks-content-primary);
                opacity: 1;
                translate: -50% 0;
            }

            &:hover .arrow {
                transform: translateX(0.2em);
            }

            @media (hover: none) {
                .read {
                    display: none;
                }
            }

            @include media-breakpoint-down(md) {
                .read {
                    display: none;
                }
            }
        }

        :global(img) {
            width: auto;
            height: calc(var(--h) * 1.3);
            filter: brightness(0);

            @include media-breakpoint-down(xl) {
                height: calc(var(--h) * 1.1);
            }

            @include media-breakpoint-down(md) {
                height: calc(var(--h) * 0.75);
            }
        }

        :global(html.dark) & :global(img) {
            filter: brightness(0) invert(1);
        }
    }
</style>
