---
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"
import HairlineFigure from "~/components/partners/HairlineFigure.astro"

const DEPLOYMENTS = [
    {
        figure: "servers" as const,
        title: "Self-hosted",
        text: "Kubernetes or VMs in your data center or your cloud account. The reference deployment for regulated industries.",
    },
    {
        figure: "padlock" as const,
        title: "Air-gapped",
        text: "No outbound connection required. Plugins and updates delivered offline.",
    },
    {
        figure: "deploy" as const,
        title: "Hybrid",
        text: "Control plane in one place, worker groups next to the systems they act on: on-prem, in each cloud, at the edge.",
    },
]

const CLOUD = [
    "Hosting, scaling and upgrades handled by Kestra",
    "SSO, RBAC and audit logs included",
    "Run tasks on your own compute",
    "14 days free, no credit card",
]
---

<section
    class="ee-deployments surface-dark"
    aria-labelledby="where-kestra-runs"
    data-header-dark
>
    <PixelEdges />
    <div class="container-xl">
        <div class="rails">
            <header>
                <div>
                    <h2 id="where-kestra-runs">Where Kestra runs</h2>
                    <p>
                        Run Kestra where you need it: your data center, your
                        cloud accounts, across network zones, fully air-gapped,
                        or managed by us.
                    </p>
                </div>
                <a
                    href="https://hs.kestra.io/hubfs/kestra-deployment-options-enterprise-edition.pdf"
                    class="btn-ghost"
                    target="_blank"
                    rel="noopener"
                >
                    Download the PDF
                </a>
            </header>
            <ul>
                {DEPLOYMENTS.map((deployment) => (
                    <li>
                        <HairlineFigure
                            name={deployment.figure}
                            dark="var(--card)"
                        />
                        <div>
                            <h3>{deployment.title}</h3>
                            <p>{deployment.text}</p>
                        </div>
                    </li>
                ))}
            </ul>
            <aside class="cloud" aria-labelledby="ee-cloud">
                <HairlineFigure name="cloud" dark="var(--tint)" />
                <div class="pitch">
                    <p class="label">Prefer not to run it?</p>
                    <h3 id="ee-cloud">Kestra Cloud</h3>
                    <p>
                        Kestra managed by the team that built it, with a
                        selection of Enterprise features and usage-based
                        pricing.
                    </p>
                </div>
                <ol>
                    {CLOUD.map((point) => (
                        <li>
                            <Icon name="mdi:check" />
                            {point}
                        </li>
                    ))}
                </ol>
                <a href="/cloud" class="btn-ghost">
                    Explore Kestra Cloud <Icon name="mdi:chevron-right" />
                </a>
            </aside>
        </div>
    </div>
</section>

<style lang="scss">
    @use "../about/style/section" as *;

    .ee-deployments {
        --rule-color: rgba(255, 255, 255, 0.11);
        --rule: 1px solid var(--rule-color);
        --muted: #9a9aa8;

        position: relative;
        border-block: var(--rule);
        background: linear-gradient(180deg, #000000 30%, #17181e 100%);
        color: #ffffff;
    }

    .rails {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-inline: var(--rule);

        > header {
            position: relative;
            padding: 7.5rem var(--inset) 4rem;

            @include media-breakpoint-down(md) {
                padding-block: 4.5rem 2.5rem;
            }
        }
    }

    header {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 1.5rem 3rem;

        h2 {
            @include title;
            font-size: clamp(2rem, 3.6vw, 3rem);
            color: #ffffff;
        }

        p {
            @include lead;
            max-width: 40rem;
            color: var(--muted);
        }
    }

    ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        border-top: var(--rule);
        list-style: none;

        @include media-breakpoint-down(lg) {
            grid-template-columns: 1fr;
        }
    }

    ul > li {
        display: grid;
        grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
        align-items: center;
        gap: 0.5rem 1.25rem;
        padding: 2rem 2rem 2rem 1.25rem;
        --card: #040405;

        background: var(--card);
        transition: background-color 0.3s ease;

        &:hover {
            --card: #0b0b0e;
        }

        @include media-breakpoint-up(lg) {
            & + li {
                border-left: var(--rule);
            }
        }

        @include media-breakpoint-down(lg) {
            & + li {
                border-top: var(--rule);
            }
        }

        @include media-breakpoint-between(lg, xl) {
            grid-template-columns: minmax(0, 1fr);
            padding: 0.5rem 1.25rem 1.5rem;

            :global(.hairline-figure) {
                max-width: 13rem;
            }
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: minmax(0, 1fr);
            padding: 0.5rem 1.25rem 1.5rem;

            :global(.hairline-figure) {
                max-width: 13rem;
            }
        }

        :global(.hairline-figure[data-hairline-theme="dark"]) {
            --hairline-edge: #a5a3b6;
            --hairline-mid: #6a6879;
            --hairline-lo: #45434f;
        }

        :global([data-figure="deploy"]) {
            scale: 1.2;
        }

        h3 {
            margin: 0 0 0.5rem;
            font-size: 1.25rem;
            font-weight: 600;
            line-height: 1.3;
            color: #ffffff;
        }

        p {
            margin: 0;
            font-size: 0.9375rem;
            line-height: 1.55;
            color: var(--muted);
        }
    }

    .cloud {
        --tint: #0d0d10;

        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr) auto auto;
        align-items: center;
        gap: 1.5rem clamp(1.5rem, 3vw, 3rem);
        padding: 1.5rem var(--inset) 1.5rem 1.25rem;
        border-top: var(--rule);
        background: var(--tint);

        @include media-breakpoint-down(xl) {
            grid-template-columns: 9rem minmax(0, 1fr) auto;

            ol {
                grid-column: 2 / -1;
                grid-row: 2;
            }
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
            padding: 1rem 1.25rem 2rem;

            ol {
                grid-column: auto;
                grid-row: auto;
            }

            :global(.hairline-figure) {
                max-width: 12rem;
                margin-inline: 0;
            }

            .btn-ghost {
                justify-self: start;
            }
        }

        :global(.hairline-figure[data-hairline-theme="dark"]) {
            --hairline-edge: #a5a3b6;
            --hairline-mid: #6a6879;
            --hairline-lo: #45434f;
        }

        .label {
            margin: 0 0 0.375rem;
            font-size: $font-size-sm;
            font-weight: 600;
            color: #b9a6ff;
        }

        h3 {
            margin: 0 0 0.5rem;
            font-size: 1.25rem;
            font-weight: 600;
            line-height: 1.3;
            color: #ffffff;
        }

        .pitch > p:not(.label) {
            max-width: 26rem;
            margin: 0;
            font-size: 0.9375rem;
            line-height: 1.55;
            color: var(--muted);
        }

        ol {
            display: grid;
            gap: 0.375rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        ol li {
            display: flex;
            align-items: start;
            gap: 0.5rem;
            font-size: $font-size-sm;
            line-height: 1.4;
            color: #c9c8d4;
        }

        ol [data-icon] {
            flex: none;
            width: 1rem;
            height: 1rem;
            margin-top: 0.125rem;
            color: #b9a6ff;
        }
    }
</style>
