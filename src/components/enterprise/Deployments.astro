---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"
import cloudVisual from "~/components/cloud/assets/cloud.webp"

const DEPLOYMENTS = [
    {
        title: "Self-hosted",
        text: "Kubernetes or VMs in your data center or your cloud account. The reference deployment for regulated industries.",
    },
    {
        title: "Air-gapped",
        text: "No outbound connection required. Plugins and updates delivered offline.",
    },
    {
        title: "Hybrid",
        text: "Control plane in one place, worker groups next to the systems they act on: on-prem, in each cloud, at the edge.",
    },
]

const CLOUD = [
    "Hosting, scaling and upgrades handled by Kestra",
    "SSO, RBAC and audit logs included",
    "Run tasks on your own compute",
    "14 days free, no credit card",
]
---

<section class="ee-deployments" aria-labelledby="where-kestra-runs">
    <PixelEdges />
    <div class="container-xl">
        <div class="rails">
            <header>
                <div>
                    <h2 id="where-kestra-runs">Where Kestra runs</h2>
                    <p>
                        Run Kestra where you need it: your data center, your
                        cloud accounts, across network zones, fully air-gapped,
                        or managed by us.
                    </p>
                </div>
                <a
                    href="https://hs.kestra.io/hubfs/kestra-deployment-options-enterprise-edition.pdf"
                    class="btn-ghost"
                    target="_blank"
                    rel="noopener"
                >
                    Download the PDF
                </a>
            </header>
            <ul>
                {DEPLOYMENTS.map((deployment) => (
                    <li>
                        <h3>{deployment.title}</h3>
                        <p>{deployment.text}</p>
                    </li>
                ))}
            </ul>
            <aside class="cloud" aria-labelledby="ee-cloud">
                <div class="pitch">
                    <p class="label">Prefer not to run it?</p>
                    <h3 id="ee-cloud">Kestra Cloud</h3>
                    <p>
                        Kestra managed by the team that built it, with a
                        selection of Enterprise features and usage-based
                        pricing.
                    </p>
                    <a href="/cloud" class="btn-solid">
                        Explore Kestra Cloud <Icon name="mdi:chevron-right" />
                    </a>
                </div>
                <Image src={cloudVisual} alt="" />
                <ol>
                    {CLOUD.map((point) => (
                        <li>
                            <Icon name="mdi:check" />
                            {point}
                        </li>
                    ))}
                </ol>
            </aside>
        </div>
    </div>
</section>

<style lang="scss">
    @use "../about/style/section" as *;

    .ee-deployments {
        position: relative;
        border-bottom: 1px solid var(--ks-border-primary);
        background: var(--ks-background-body);
    }

    .rails {
        position: relative;
        border-inline: 1px solid var(--ks-border-primary);

        > * {
            position: relative;
            padding-inline: clamp(1.5rem, 4vw, 3.5rem);
        }

        > header {
            padding-top: 7.5rem;
        }

        padding-bottom: 7.5rem;

        > .cloud {
            margin-inline: clamp(1.5rem, 4vw, 3.5rem);
        }

        @include media-breakpoint-down(md) {
            padding-bottom: 4.5rem;

            > header {
                padding-top: 4.5rem;
            }
        }
    }

    header {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 1.5rem 3rem;

        h2 {
            @include title;
            font-size: clamp(2rem, 3.6vw, 3rem);
        }

        p {
            @include lead;
            max-width: 40rem;
        }
    }

    ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin: 3rem 0 0;
        list-style: none;

        @include media-breakpoint-down(md) {
            grid-template-columns: 1fr;
        }
    }

    ul > li {
        padding: 1.5rem 1.5rem 2rem;
        border-radius: 8px;
        background: var(--ks-background-secondary);

        @include media-breakpoint-down(md) {
            padding: 1.25rem 1.25rem 1.5rem;
        }

        h3 {
            margin: 0 0 1rem;
            font-size: $font-size-xl;
            font-weight: 600;
            color: var(--ks-content-primary);

            @include media-breakpoint-down(md) {
                margin-bottom: 0.5rem;
            }
        }

        p {
            margin: 0;
            font-size: $font-size-md;
            line-height: 1.6;
            color: var(--ks-content-secondary);
        }
    }

    .cloud {
        --tint: #eef1ff;
        --edge: #dfe4ff;

        display: grid;
        grid-template-columns: minmax(0, 1.15fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 2.5rem clamp(2rem, 4vw, 4rem);
        overflow: hidden;
        margin-top: 1rem;
        padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem);
        border: 1px solid var(--edge);
        border-radius: 8px;
        background:
            radial-gradient(
                60% 120% at 50% 50%,
                rgba(132, 5, 255, 0.07),
                transparent 70%
            ),
            var(--tint);

        :global(html.dark) & {
            --tint: #14162a;
            --edge: #262a4a;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr) auto;

            ol {
                grid-column: 1 / -1;
            }
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: 1fr;
            padding: 2rem 1.25rem;

            img {
                order: -1;
            }
        }

        img {
            width: clamp(9rem, 15vw, 13rem);
            height: auto;

            @include media-breakpoint-down(sm) {
                width: 7rem;
            }
        }

        .label {
            margin: 0 0 0.75rem;
            font-size: $font-size-sm;
            font-weight: 600;
            color: var(--ks-content-link);
        }

        h3 {
            margin: 0 0 1rem;
            font-size: clamp(1.75rem, 2.6vw, 2.25rem);
            font-weight: 600;
            line-height: 1.15;
            color: var(--ks-content-primary);
        }

        .pitch p:not(.label) {
            max-width: 26rem;
            margin: 0 0 2rem;
            font-size: $font-size-md;
            line-height: 1.6;
            color: var(--ks-content-secondary);
        }

        ol {
            display: grid;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        ol li {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding-block: 0.875rem;
            font-size: $font-size-md;
            color: var(--ks-content-primary);

            & + li {
                border-top: 1px solid var(--edge);
            }
        }

        ol [data-icon] {
            flex: none;
            color: var(--ks-content-link);
        }
    }
</style>
