---
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"
import HairlineFigure from "~/components/partners/HairlineFigure.astro"

type Figure =
    | "deploy"
    | "plugins"
    | "padlock"
    | "servers"
    | "patch"
    | "opensource"

interface Props {
    id?: string
    items?: { figure: Figure; title: string; text: string }[]
    extras?: boolean
}

const DEFAULT_DEPLOYMENTS = [
    {
        figure: "servers" as const,
        title: "Self-hosted",
        text: "Kubernetes or VMs in your data center or your cloud account. The reference deployment for regulated industries.",
    },
    {
        figure: "padlock" as const,
        title: "Air-gapped",
        text: "No outbound connection required. Plugins and updates delivered offline.",
    },
    {
        figure: "deploy" as const,
        title: "Hybrid",
        text: "Control plane in one place, worker groups next to the systems they act on: on-prem, in each cloud, at the edge.",
    },
]

const {
    id = "where-kestra-runs",
    items: DEPLOYMENTS = DEFAULT_DEPLOYMENTS,
    extras = true,
} = Astro.props
---

<section
    class="ee-deployments surface-dark"
    aria-labelledby={id}
    data-header-dark
>
    <PixelEdges />
    <div class="container-xl">
        <div class="rails">
            <header>
                <div>
                    <h2 {id}><slot name="title">Where Kestra runs</slot></h2>
                    <p>
                        <slot name="lead">
                            Run Kestra Enterprise in any environment you choose:
                            your data center, your cloud accounts, across
                            network zones, or fully air-gapped.
                        </slot>
                    </p>
                </div>
                {
                    extras && (
                        <a
                            href="https://hs.kestra.io/hubfs/kestra-deployment-options-enterprise-edition.pdf"
                            class="btn-ghost"
                            target="_blank"
                            rel="noopener"
                        >
                            Download the PDF
                        </a>
                    )
                }
            </header>
            <ul>
                {DEPLOYMENTS.map((deployment) => (
                    <li>
                        <HairlineFigure
                            name={deployment.figure}
                            dark="var(--card)"
                        />
                        <div>
                            <h3>{deployment.title}</h3>
                            <p>{deployment.text}</p>
                        </div>
                    </li>
                ))}
            </ul>
            {
                extras && (
                    <aside class="cloud" aria-labelledby="ee-cloud">
                        <Icon name="mdi:cloud-outline" class="glyph" />
                        <p>
                            <strong id="ee-cloud">Looking for a managed Kestra?</strong>
                            Kestra Cloud takes care of hosting, scaling and upgrades,
                            with a selection of Enterprise features and usage-based
                            pricing.
                        </p>
                        <a href="/cloud">
                            Explore Kestra Cloud <Icon name="mdi:arrow-right" />
                        </a>
                    </aside>
                )
            }
        </div>
    </div>
</section>

<style lang="scss">
    @use "../about/style/section" as *;

    .ee-deployments {
        --rule-color: rgba(255, 255, 255, 0.11);
        --rule: 1px solid var(--rule-color);
        --muted: #9a9aa8;
        --bg: #0d0d10;
        --lift: #141419;

        position: relative;
        border-block: var(--rule);
        background: linear-gradient(180deg, #000000 0, var(--bg) 18rem);
        color: #ffffff;
    }

    .rails {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        padding-bottom: 5rem;
        border-inline: var(--rule);

        @include media-breakpoint-down(md) {
            padding-bottom: 3rem;
        }

        > header {
            position: relative;
            padding: 7.5rem var(--inset) 4rem;

            @include media-breakpoint-down(md) {
                padding-block: 4.5rem 2.5rem;
            }
        }
    }

    header {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 1.5rem 3rem;

        h2 {
            @include title;
            font-size: clamp(2rem, 3.6vw, 3rem);
            color: #ffffff;
        }

        p {
            @include lead;
            max-width: 40rem;
            color: var(--muted);
        }
    }

    ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        border-top: var(--rule);
        list-style: none;

        @include media-breakpoint-down(md) {
            grid-template-columns: 1fr;
        }
    }

    ul > li {
        display: grid;
        grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
        align-items: center;
        gap: 0.5rem 1.25rem;
        padding: 3.5rem 2rem 3.5rem 1.25rem;
        --card: var(--bg);

        background: var(--card);
        transition: background-color 0.3s ease;

        &:hover {
            --card: var(--lift);
        }

        @include media-breakpoint-up(md) {
            & + li {
                border-left: var(--rule);
            }
        }

        @include media-breakpoint-down(md) {
            padding-block: 2rem;

            & + li {
                border-top: var(--rule);
            }
        }

        @include media-breakpoint-between(md, xl) {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: 12rem auto;
            align-items: start;
            padding: 1rem 1.5rem 2.25rem;

            :global(.hairline-figure) {
                align-self: center;
                justify-self: center;
                max-width: 13rem;
            }
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: minmax(0, 1fr);
            padding: 0.5rem 1.25rem 1.5rem;

            :global(.hairline-figure) {
                max-width: 13rem;
            }
        }

        :global(.hairline-figure[data-hairline-theme="dark"]) {
            --hairline-edge: #a5a3b6;
            --hairline-mid: #6a6879;
            --hairline-lo: #45434f;
        }

        :global([data-figure="deploy"]) {
            scale: 1.2;
        }

        h3 {
            margin: 0 0 0.5rem;
            font-size: 1.25rem;
            font-weight: 600;
            line-height: 1.3;
            color: #ffffff;
        }

        p {
            margin: 0;
            font-size: 0.9375rem;
            line-height: 1.55;
            color: var(--muted);
        }
    }

    .cloud {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1rem;
        position: relative;
        padding: 2.25rem var(--inset);
        border-top: var(--rule);
        transition: background-color 0.3s ease;

        &:hover {
            background: var(--lift);
        }
        font-size: 0.9375rem;
        line-height: 1.55;

        .glyph {
            flex: none;
            width: 1.375rem;
            height: 1.375rem;
            align-self: flex-start;
            margin-top: 0.0625rem;
            color: #b9a6ff;
        }

        p {
            flex: 1 1 24rem;
            margin: 0;
            color: var(--muted);
        }

        strong {
            display: block;
            margin-bottom: 0.125rem;
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
        }

        a {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            font-weight: 600;
            color: #b9a6ff;
            text-decoration: none;
            white-space: nowrap;

            &::after {
                content: "";
                position: absolute;
                inset: 0;
            }

            [data-icon] {
                width: 1rem;
                height: 1rem;
                transition: translate 0.2s ease;
            }
        }

        &:hover a {
            color: #ffffff;

            [data-icon] {
                translate: 0.1875rem 0;
            }
        }
    }
</style>
