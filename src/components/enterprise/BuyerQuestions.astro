---
import Faq from "~/components/common/Faq.vue"

interface Props {
    items: { question: string; answer: string }[]
}

const { items } = Astro.props
---

<section class="ee-faq" aria-labelledby="ee-faq">
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="ee-faq">Questions buyers ask</h2>
            </header>
            <div class="list">
                <Faq {items} showHeader={false} client:visible />
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .ee-faq {
        position: relative;
        background: var(--ks-background-body);
        border-bottom: 1px solid var(--ks-border-primary);
    }

    .grid {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        border-left: var(--rule);
        border-right: var(--rule);

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .head {
        padding: 8.5rem var(--inset) 4rem;

        @include media-breakpoint-down(lg) {
            padding-bottom: 1rem;
        }

        @include media-breakpoint-down(md) {
            padding-top: 4.5rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--ks-content-primary);
        }
    }

    .list {
        padding: 8rem var(--inset) clamp(4rem, 6vw, 5.5rem);

        @include media-breakpoint-down(lg) {
            padding-top: 1.5rem;
        }

        :global(section.faq) {
            padding: 0;
            background: transparent;
        }

        :global(.container.content) {
            max-width: none;
            padding: 0;
        }
    }
</style>
