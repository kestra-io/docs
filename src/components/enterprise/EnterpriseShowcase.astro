---
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import appsCatalog from "~/contents/docs/07.enterprise/04.scalability/apps/apps_catalog.png"
import workerGroups from "~/components/twozero/assets/run-worker-groups.png"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"
import GovMock from "~/components/enterprise/mocks/GovMock.astro"
import OpsMock from "~/components/enterprise/mocks/OpsMock.astro"
import AppsMock from "~/components/enterprise/mocks/AppsMock.astro"
import auditLogs from "~/contents/docs/07.enterprise/02.governance/06.audit-logs/audit_logs.png"

const PANELS = [
    {
        id: "ux",
        tab: "User experience",
        icon: "mdi:account-group-outline",
        title: "Apps, Copilot and approvals",
        intro: "More people build and operate workflows, each in the way that suits them.",
        points: [
            "Build self-service Apps on top of flows: a service catalog for your teams, with governed workflows behind every request.",
            "Choose which models Copilot uses, including self-hosted ones, so prompts and code stay inside your network.",
            "Build workflows with human-in-the-loop approvals, reusable inputs, custom blueprints, and an app catalog.",
            "Test and maintain workflows with unit testing, plugin versioning, and hot reload.",
        ],
        mock: "apps",
        image: appsCatalog,
        alt: "The Kestra Apps catalog",
    },
    {
        id: "ops",
        tab: "Operations",
        icon: "mdi:server-network",
        title: "Tenants, worker groups and environments",
        intro: "Run many teams and environments on one platform.",
        points: [
            "Multi-tenancy, namespace management, storage isolation.",
            "Compute where the data and the network live with worker groups and task runners.",
            "Apply and manage policies, promote workflows between environments, and enforce quotas.",
            "Support high throughput and availability with Kafka, Redis or AMQP queues.",
            "Manage operations with cluster health monitoring, backup and restore, and maintenance mode.",
        ],
        mock: "ops",
        image: workerGroups,
        alt: "An execution routed to worker groups in Kestra",
    },
    {
        id: "gov",
        tab: "Governance",
        icon: "mdi:shield-check-outline",
        title: "Identity, secrets and audit",
        intro: "Security and governance that satisfy the auditor without slowing the engineer.",
        points: [
            'Connect your identity provider, secret manager and SIEM. Details in the <a href="https://hs.kestra.io/hubfs/kestra-security-overview-enterprise-edition.pdf" target="_blank" rel="noopener">security overview</a>.',
            "SSO (OIDC), LDAP, SCIM, RBAC, service accounts and API tokens.",
            "Secrets manager integration, namespace and tenant secrets.",
            "Audit logs, log export to your SIEM, system announcements.",
            "Allowed and restricted plugins, kill switch.",
        ],
        mock: "gov",
        image: auditLogs,
        alt: "The Kestra audit logs",
    },
]
---

<section class="ee-showcase" aria-labelledby="ee-showcase" data-showcase>
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="ee-showcase">
                    What Enterprise adds, feature by feature.
                </h2>
                <p>
                    Grouped by who uses it: the people who build flows, the
                    platform team, and security.
                </p>
            </header>

            <div class="tabs" role="tablist" aria-label="Enterprise features">
                {PANELS.map((panel, idx) => (
                    <button
                        type="button"
                        role="tab"
                        id={`ee-tab-${panel.id}`}
                        class:list={["tab", { active: idx === 0 }]}
                        aria-selected={idx === 0 ? "true" : "false"}
                        aria-controls={`ee-panel-${panel.id}`}
                        tabindex={idx === 0 ? 0 : -1}
                    >
                        <Icon name={panel.icon} />
                        {panel.tab}
                    </button>
                ))}
            </div>

            <div class="panels">
                {PANELS.map((panel, idx) => (
                    <div
                        id={`ee-panel-${panel.id}`}
                        role="tabpanel"
                        aria-labelledby={`ee-tab-${panel.id}`}
                        class:list={["panel", { active: idx === 0 }]}
                    >
                        <div class="copy">
                            <h3>{panel.title}</h3>
                            <p class="intro">{panel.intro}</p>
                            <ul>
                                {panel.points.map((point, i) => (
                                    <li
                                        style={`--i: ${i + 2}`}
                                        set:html={point}
                                    />
                                ))}
                            </ul>
                        </div>
                        <div
                            class:list={["media", { mock: panel.mock }]}
                            data-tone={panel.id}
                        >
                            {panel.mock ? (
                                <Fragment>
                                    <span
                                        class="pixels"
                                        aria-hidden="true"
                                        style={`--pixels: url("${pixelCluster}")`}
                                    />
                                    {panel.mock === "apps" && <AppsMock />}
                                    {panel.mock === "ops" && <OpsMock />}
                                    {panel.mock === "gov" && <GovMock />}
                                </Fragment>
                            ) : (
                                <Image
                                    src={panel.image}
                                    alt={panel.alt}
                                    widths={[640, 960, 1280]}
                                    sizes="(max-width: 992px) 100vw, 50vw"
                                    loading="lazy"
                                />
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<script>
    function wireShowcase() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-showcase]:not([data-wired])",
        )) {
            root.dataset.wired = "true"
            const tabs = [...root.querySelectorAll<HTMLElement>(".tab")]
            const panels = [...root.querySelectorAll<HTMLElement>(".panel")]
            const stack = root.querySelector<HTMLElement>(".panels")
            const open = (idx: number, focus = false) => {
                const from = tabs.findIndex((tab) =>
                    tab.classList.contains("active"),
                )
                stack?.style.setProperty("--dir", idx < from ? "-1" : "1")
                tabs.forEach((tab, i) => {
                    tab.classList.toggle("active", i === idx)
                    tab.setAttribute("aria-selected", String(i === idx))
                    tab.tabIndex = i === idx ? 0 : -1
                })
                panels.forEach((panel, i) =>
                    panel.classList.toggle("active", i === idx),
                )
                if (focus) tabs[idx].focus()
            }
            tabs.forEach((tab, idx) => {
                tab.addEventListener("click", () => open(idx))
                tab.addEventListener("keydown", (event) => {
                    const step =
                        event.key === "ArrowRight"
                            ? 1
                            : event.key === "ArrowLeft"
                              ? -1
                              : 0
                    if (!step) return
                    event.preventDefault()
                    open((idx + step + tabs.length) % tabs.length, true)
                })
            })
        }
    }

    function wireMocks() {
        const mocks = document.querySelectorAll<HTMLElement>(
            "[data-ui-mock]:not([data-wired])",
        )
        if (!mocks.length) return
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    ;(entry.target as HTMLElement).toggleAttribute(
                        "data-play",
                        entry.isIntersecting,
                    )
                }
            },
            { threshold: 0.25 },
        )
        for (const mock of mocks) {
            mock.dataset.wired = "true"
            observer.observe(mock)
        }
    }

    document.addEventListener("astro:page-load", () => {
        wireShowcase()
        wireMocks()
    })
    wireShowcase()
    wireMocks()
</script>

<style lang="scss">
    .ee-showcase {
        position: relative;
        background: var(--ks-background-body);
        border-bottom: 1px solid var(--ks-border-primary);
    }

    .grid {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);
        --surface: var(--ks-background-body);
        --accent: #7448e8;

        :global(html.dark) & {
            --surface: var(--ks-background-body);
            --accent: #b9a6ff;
        }

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);
        padding-bottom: clamp(4rem, 6vw, 5.5rem);
    }

    .head {
        text-align: center;
        padding: 8.5rem var(--inset) 3.5rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 2.5rem;
        }

        h2 {
            max-width: 18em;
            margin: 0 auto;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--ks-content-primary);
            text-wrap: balance;
        }

        p {
            max-width: 36rem;
            margin: 1.25rem auto 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: var(--ks-content-tertiary);
        }
    }

    .tabs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        border-block: var(--rule);
        background: var(--ks-border-primary);
    }

    .tab {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        height: 4.5rem;
        padding: 0 1rem;
        border: 0;
        background: var(--ks-background-secondary);
        font-size: 1rem;
        font-weight: 500;
        color: var(--ks-content-tertiary);
        cursor: pointer;
        transition:
            background-color 0.25s ease,
            color 0.25s ease;

        :global(svg) {
            width: 1.25rem;
            height: 1.25rem;
            flex: none;
        }

        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }

        &:hover {
            color: var(--ks-content-primary);
        }

        &.active {
            background: var(--surface);
            color: var(--ks-content-primary);

            &::before {
                transform: none;
            }
        }

        &:focus-visible {
            outline: 2px solid var(--ks-border-active);
            outline-offset: -2px;
        }

        @include media-breakpoint-down(md) {
            flex-direction: column;
            gap: 0.25rem;
            font-size: 0.875rem;
        }
    }

    .panels {
        display: grid;
        border-bottom: var(--rule);
    }

    .panel {
        grid-area: 1 / 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        background: var(--surface);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.35s ease,
            visibility 0s 0.35s;

        &.active {
            opacity: 1;
            visibility: visible;
            transition: opacity 0.35s ease;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .copy {
        align-self: center;
        padding: 3.5rem var(--inset);

        h3 {
            margin: 0;
            font-size: clamp(1.5rem, 2.4vw, 1.875rem);
            font-weight: 600;
            letter-spacing: -0.01em;
            color: var(--ks-content-primary);
        }

        .intro {
            margin: 0.75rem 0 1.75rem;
            font-size: 1.0625rem;
            line-height: 1.55;
            color: var(--ks-content-secondary);
        }

        ul {
            display: grid;
            gap: 0.875rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            position: relative;
            padding-left: 1.5rem;
            font-size: 0.9375rem;
            line-height: 1.55;
            color: var(--ks-content-secondary);

            &::before {
                content: "";
                position: absolute;
                top: 0.6em;
                left: 0;
                width: 0.5rem;
                height: 0.5rem;
                border-radius: 2px;
                background: var(--accent);
            }

            :global(a) {
                color: var(--ks-content-link);
            }
        }
    }

    .media {
        position: relative;
        align-self: end;
        padding: 3rem 0 0 1.5rem;
        overflow: hidden;

        @include media-breakpoint-down(lg) {
            padding: 0 0 0 var(--inset);
        }

        &.mock {
            --tint: #8405ff;

            display: flex;
            align-items: center;
            align-self: stretch;
            padding: 1.5rem var(--inset);
            border-left: var(--rule);
            background:
                radial-gradient(
                    80% 90% at 100% 0%,
                    color-mix(in srgb, var(--tint) 20%, transparent),
                    transparent 70%
                ),
                radial-gradient(
                    60% 70% at 0% 100%,
                    color-mix(in srgb, var(--tint) 10%, transparent),
                    transparent 70%
                ),
                color-mix(in srgb, var(--tint) 3%, var(--ks-background-body));

            :global(html.dark) & {
                --tint: #9869f7;

                background:
                    radial-gradient(
                        80% 90% at 100% 0%,
                        color-mix(in srgb, var(--tint) 12%, transparent),
                        transparent 70%
                    ),
                    radial-gradient(
                        60% 70% at 0% 100%,
                        color-mix(in srgb, var(--tint) 6%, transparent),
                        transparent 70%
                    ),
                    color-mix(
                        in srgb,
                        var(--tint) 3%,
                        var(--ks-background-body)
                    );
            }

            @include media-breakpoint-down(lg) {
                padding: 2rem var(--inset);
                border-left: 0;
                border-top: var(--rule);
            }
        }

        &.mock[data-tone="ops"] {
            --tint: #2f6df2;

            :global(html.dark) & {
                --tint: #6f93fb;
            }
        }

        &.mock[data-tone="gov"] {
            --tint: #12a06c;

            :global(html.dark) & {
                --tint: #1fc48a;
            }
        }

        .pixels {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            width: 96px;
            aspect-ratio: 194 / 168;
            background: var(--tint);
            mask: var(--pixels) no-repeat center / contain;
            opacity: 0.3;
            pointer-events: none;
        }

        :global(img) {
            display: block;
            width: 100%;
            height: auto;
            border: 1px solid var(--ks-border-primary);
            border-right: 0;
            border-bottom: 0;
            border-radius: 0.75rem 0 0 0;
            box-shadow: -10px -10px 40px rgba(60, 30, 120, 0.12);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .panel.active {
            .copy h3,
            .copy .intro,
            .copy li {
                animation: ee-showcase-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1)
                    both;
                animation-delay: calc(var(--i, 0) * 55ms + 60ms);
            }

            .copy .intro {
                --i: 1;
            }

            .media > :global(.ui-mock),
            .media > :global(img) {
                animation: ee-showcase-slide 0.75s
                    cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
            }
        }
    }

    @keyframes ee-showcase-rise {
        from {
            opacity: 0;
            transform: translateY(0.75rem);
        }
    }

    @keyframes ee-showcase-slide {
        from {
            opacity: 0;
            transform: translateX(calc(var(--dir, 1) * 2.5rem)) scale(0.98);
        }
    }

    .panel:not(.active) :global(.ui-mock *) {
        animation: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
        .panel,
        .tab::before {
            transition: none;
        }
    }
</style>
