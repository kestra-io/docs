---
import { Icon } from "astro-icon/components"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"
import SecretsMock from "~/components/enterprise/mocks/SecretsMock.astro"
import OpsMock from "~/components/enterprise/mocks/OpsMock.astro"
import AppsMock from "~/components/enterprise/mocks/AppsMock.astro"

interface Panel {
    id: string
    tab: string
    icon: string
    title: string
    intro: string
    points?: string[]
    mock?: string
}

interface Props {
    id?: string
    label?: string
    panels?: Panel[]
    align?: "center" | "start"
}

const DEFAULT_PANELS: Panel[] = [
    {
        id: "ux",
        tab: "User experience",
        icon: "mdi:account-group-outline",
        title: "Apps, Copilot and approvals",
        intro: "More people build and operate workflows, each in the way that suits them.",
        points: [
            "Build self-service Apps on top of flows: a service catalog for your teams, with governed workflows behind every request.",
            "Choose which models Copilot uses, including self-hosted ones, so prompts and code stay inside your network.",
            "Build workflows with human-in-the-loop approvals, reusable inputs, custom blueprints, and an app catalog.",
            "Test and maintain workflows with unit testing, plugin versioning, and hot reload.",
        ],
        mock: "apps",
    },
    {
        id: "ops",
        tab: "Operations",
        icon: "mdi:server-network",
        title: "Tenants, worker groups and environments",
        intro: "Run many teams and environments on one platform.",
        points: [
            "Isolate each team with its own tenant, namespaces and storage.",
            "Run tasks next to the data with worker groups and task runners.",
            "Apply and manage policies, promote workflows between environments, and enforce quotas.",
            "Scale the queue on Kafka, Redis or AMQP.",
            "Monitor cluster health, back up and restore, and upgrade in maintenance mode.",
        ],
        mock: "ops",
    },
    {
        id: "gov",
        tab: "Governance",
        icon: "mdi:shield-check-outline",
        title: "Identity, secrets and audit",
        intro: "Security and governance that satisfy the auditor without slowing the engineer.",
        points: [
            'Connect your identity provider, secret manager and SIEM. Details in the <a href="https://hs.kestra.io/hubfs/kestra-security-overview-enterprise-edition.pdf" target="_blank" rel="noopener">security overview</a>.',
            "SSO (OIDC), LDAP and SCIM, with RBAC on every user, service account and API token.",
            "Secrets from your own secrets manager, scoped by namespace or tenant.",
            "Audit logs for every change, exported to your SIEM.",
            "Allow or restrict plugins, and stop any execution with the kill switch.",
        ],
        mock: "gov",
    },
]

const {
    id = "ee-showcase",
    label = "Enterprise features",
    panels: PANELS = DEFAULT_PANELS,
    align = "center",
} = Astro.props

const MOCKS: Record<string, string> = {}
for (const panel of PANELS) {
    if (Astro.slots.has(panel.id))
        MOCKS[panel.id] = await Astro.slots.render(panel.id)
}
---

<section class="ee-showcase" aria-labelledby={id} data-showcase>
    <div class="container-xl">
        <div class="grid">
            <header class:list={["head", align]}>
                <h2 {id}>
                    <slot name="title">
                        Give every team the power to automate at scale.
                    </slot>
                </h2>
                <p>
                    <slot name="lead">
                        Customize the user experience, simplify operations, and
                        strengthen governance to scale.
                    </slot>
                </p>
            </header>

            <div
                class="tabs"
                role="tablist"
                aria-label={label}
                style={`--tabs: ${PANELS.length}`}
            >
                {PANELS.map((panel, idx) => (
                    <button
                        type="button"
                        role="tab"
                        id={`${id}-tab-${panel.id}`}
                        class:list={["tab", { active: idx === 0 }]}
                        aria-selected={idx === 0 ? "true" : "false"}
                        aria-controls={`${id}-panel-${panel.id}`}
                        tabindex={idx === 0 ? 0 : -1}
                    >
                        <Icon name={panel.icon} />
                        {panel.tab}
                    </button>
                ))}
            </div>

            <div class="panels">
                {PANELS.map((panel, idx) => (
                    <div
                        id={`${id}-panel-${panel.id}`}
                        role="tabpanel"
                        aria-labelledby={`${id}-tab-${panel.id}`}
                        class:list={["panel", { active: idx === 0 }]}
                    >
                        <div class="copy">
                            <h3>{panel.title}</h3>
                            <p class="intro">{panel.intro}</p>
                            {panel.points && (
                                <ul>
                                    {panel.points.map((point, i) => (
                                        <li
                                            style={`--i: ${i + 2}`}
                                            set:html={point}
                                        />
                                    ))}
                                </ul>
                            )}
                        </div>
                        <div class="media mock" data-tone={panel.id}>
                            <span
                                class="pixels"
                                aria-hidden="true"
                                style={`--pixels: url("${pixelCluster}")`}
                            />
                            {MOCKS[panel.id] && (
                                <Fragment set:html={MOCKS[panel.id]} />
                            )}
                            {panel.mock === "apps" && <AppsMock />}
                            {panel.mock === "ops" && <OpsMock />}
                            {panel.mock === "gov" && <SecretsMock />}
                        </div>
                    </div>
                ))}
            </div>

            {Astro.slots.has("foot") && (
                <div class="foot">
                    <slot name="foot" />
                </div>
            )}
        </div>
    </div>
</section>

<script>
    function wireShowcase() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-showcase]:not([data-wired])",
        )) {
            root.dataset.wired = "true"
            const tabs = [...root.querySelectorAll<HTMLElement>(".tab")]
            const panels = [...root.querySelectorAll<HTMLElement>(".panel")]
            const stack = root.querySelector<HTMLElement>(".panels")
            const open = (idx: number, focus = false) => {
                const from = tabs.findIndex((tab) =>
                    tab.classList.contains("active"),
                )
                stack?.style.setProperty("--dir", idx < from ? "-1" : "1")
                tabs.forEach((tab, i) => {
                    tab.classList.toggle("active", i === idx)
                    tab.setAttribute("aria-selected", String(i === idx))
                    tab.tabIndex = i === idx ? 0 : -1
                })
                panels.forEach((panel, i) =>
                    panel.classList.toggle("active", i === idx),
                )
                if (focus) tabs[idx].focus()
            }
            tabs.forEach((tab, idx) => {
                tab.addEventListener("click", () => open(idx))
                tab.addEventListener("keydown", (event) => {
                    const step =
                        event.key === "ArrowRight"
                            ? 1
                            : event.key === "ArrowLeft"
                              ? -1
                              : 0
                    if (!step) return
                    event.preventDefault()
                    open((idx + step + tabs.length) % tabs.length, true)
                })
            })
        }
    }

    function wireMocks() {
        const mocks = document.querySelectorAll<HTMLElement>(
            "[data-ui-mock]:not([data-wired])",
        )
        if (!mocks.length) return
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    ;(entry.target as HTMLElement).toggleAttribute(
                        "data-play",
                        entry.isIntersecting,
                    )
                }
            },
            { threshold: 0.25 },
        )
        for (const mock of mocks) {
            mock.dataset.wired = "true"
            observer.observe(mock)
        }
    }

    document.addEventListener("astro:page-load", () => {
        wireShowcase()
        wireMocks()
    })
    wireShowcase()
    wireMocks()
</script>

<style lang="scss">
    .ee-showcase {
        position: relative;
        background: var(--ks-background-body);
        border-bottom: 1px solid var(--ks-border-primary);
    }

    .grid {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);
        --surface: var(--ks-background-body);
        --accent: #7448e8;

        :global(html.dark) & {
            --surface: var(--ks-background-body);
            --accent: #b9a6ff;
        }

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);
        padding-bottom: clamp(4rem, 6vw, 5.5rem);

        @include media-breakpoint-down(xl) {
            padding-bottom: 0;
        }
    }

    .head {
        text-align: center;
        padding: 8.5rem var(--inset) 3.5rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 2.5rem;
        }

        h2 {
            max-width: 18em;
            margin: 0 auto;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--ks-content-primary);
            text-wrap: balance;
        }

        p {
            max-width: 36rem;
            margin: 1.25rem auto 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: var(--ks-content-tertiary);
        }

        &.start {
            text-align: left;

            h2 {
                margin: 0;
            }

            p {
                max-width: 38rem;
                margin: 1.5rem 0 0;
            }
        }
    }

    .foot {
        display: flex;
        justify-content: center;
        padding: clamp(2.5rem, 4vw, 3.5rem) var(--inset) 0;

        @include media-breakpoint-down(xl) {
            padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
        }
    }

    .tabs {
        display: grid;
        grid-template-columns: repeat(var(--tabs), minmax(0, 1fr));
        gap: 1px;
        border-block: var(--rule);
        background: var(--ks-border-primary);
    }

    .tab {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        height: 4.5rem;
        padding: 0 1rem;
        border: 0;
        background: var(--ks-background-body);
        font-size: 1rem;
        font-weight: 500;
        color: var(--ks-content-tertiary);
        cursor: pointer;
        transition:
            background-color 0.25s ease,
            color 0.25s ease;

        :global(svg) {
            width: 1.25rem;
            height: 1.25rem;
            flex: none;
        }

        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }

        &:hover {
            background: color-mix(
                in srgb,
                var(--accent) 4%,
                var(--ks-background-body)
            );
            color: var(--ks-content-primary);
        }

        &.active {
            background: var(--surface);
            color: var(--ks-content-primary);

            &::before {
                transform: none;
            }
        }

        &:focus-visible {
            outline: 2px solid var(--ks-border-active);
            outline-offset: -2px;
        }

        @include media-breakpoint-down(md) {
            flex-direction: column;
            gap: 0.25rem;
            font-size: 0.875rem;
        }
    }

    .panels {
        display: grid;
        border-bottom: var(--rule);

        @include media-breakpoint-down(xl) {
            border-bottom: 0;
        }
    }

    .panel {
        grid-area: 1 / 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        background: var(--surface);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.35s ease,
            visibility 0s 0.35s;

        &.active {
            opacity: 1;
            visibility: visible;
            transition: opacity 0.35s ease;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
            padding: 3rem var(--inset);
        }
    }

    .copy {
        align-self: center;
        padding: 3.5rem var(--inset);

        @include media-breakpoint-down(lg) {
            display: contents;

            ul {
                order: 2;
            }
        }

        h3 {
            margin: 0;
            font-size: clamp(1.5rem, 2.4vw, 1.875rem);
            font-weight: 600;
            letter-spacing: -0.01em;
            color: var(--ks-content-primary);
        }

        .intro {
            margin: 0.75rem 0 0;

            &:not(:last-child) {
                margin-bottom: 1.75rem;
            }

            font-size: 1.0625rem;
            line-height: 1.55;
            color: var(--ks-content-secondary);
        }

        ul {
            display: grid;
            gap: 0.875rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            position: relative;
            padding-left: 1.5rem;
            font-size: 0.9375rem;
            line-height: 1.55;
            color: var(--ks-content-secondary);

            &::before {
                content: "";
                position: absolute;
                top: 0.6em;
                left: 0;
                width: 0.5rem;
                height: 0.5rem;
                border-radius: 2px;
                background: var(--accent);
            }

            :global(a) {
                color: var(--ks-content-link);
            }
        }
    }

    .media {
        position: relative;
        align-self: end;
        padding: 3rem 0 0 1.5rem;
        overflow: hidden;

        @include media-breakpoint-down(lg) {
            padding: 0 0 0 var(--inset);
        }

        &.mock {
            --tint: #8405ff;

            display: flex;
            align-items: center;
            align-self: stretch;
            padding: 1.5rem var(--inset);
            border-left: var(--rule);
            background:
                radial-gradient(
                    80% 90% at 100% 0%,
                    color-mix(in srgb, var(--tint) 20%, transparent),
                    transparent 70%
                ),
                radial-gradient(
                    60% 70% at 0% 100%,
                    color-mix(in srgb, var(--tint) 10%, transparent),
                    transparent 70%
                ),
                color-mix(in srgb, var(--tint) 3%, var(--ks-background-body));

            :global(html.dark) & {
                --tint: #9869f7;

                background:
                    radial-gradient(
                        80% 90% at 100% 0%,
                        color-mix(in srgb, var(--tint) 12%, transparent),
                        transparent 70%
                    ),
                    radial-gradient(
                        60% 70% at 0% 100%,
                        color-mix(in srgb, var(--tint) 6%, transparent),
                        transparent 70%
                    ),
                    color-mix(
                        in srgb,
                        var(--tint) 3%,
                        var(--ks-background-body)
                    );
            }

            @include media-breakpoint-down(lg) {
                order: 1;
                margin-bottom: 2rem;
                padding: 1rem 1.5rem;
                border: var(--rule);
                border-radius: 0.75rem;
            }

            @include media-breakpoint-down(sm) {
                --zoom: 1;
                --shift: 0%;

                padding: 0.5rem 0;

                > :global(.ui-mock) {
                    flex: none;
                    width: calc(var(--zoom) * 100%);
                    margin-left: var(--shift);
                }

                &[data-tone="ops"] {
                    --zoom: 0.92;
                    --shift: 4%;
                }

                &[data-tone="gov"] {
                    --zoom: 1.16;
                    --shift: 4%;
                }
            }
        }

        &.mock[data-tone="ops"] {
            --tint: #2f6df2;

            :global(html.dark) & {
                --tint: #6f93fb;
            }
        }

        &.mock[data-tone="catalog"] {
            --tint: #8405ff;
        }

        &.mock[data-tone="requests"] {
            --tint: #2f6df2;

            :global(html.dark) & {
                --tint: #6f93fb;
            }
        }

        &.mock[data-tone="deployments"] {
            --tint: #12a06c;

            :global(html.dark) & {
                --tint: #1fc48a;
            }
        }

        &.mock[data-tone="cases"] {
            --tint: #e8590c;

            :global(html.dark) & {
                --tint: #ff8a4c;
            }
        }

        &.mock[data-tone="inventory"] {
            --tint: #0f9fb3;

            :global(html.dark) & {
                --tint: #3cc8db;
            }
        }

        &.mock[data-tone="gov"] {
            --tint: #12a06c;

            :global(html.dark) & {
                --tint: #1fc48a;
            }
        }

        .pixels {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            width: 96px;
            aspect-ratio: 194 / 168;
            background: var(--tint);
            mask: var(--pixels) no-repeat center / contain;
            opacity: 0.3;
            pointer-events: none;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .panel.active {
            .copy h3,
            .copy .intro,
            .copy li {
                animation: ee-showcase-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1)
                    both;
                animation-delay: calc(var(--i, 0) * 55ms + 60ms);
            }

            .copy .intro {
                --i: 1;
            }

            .media > :global(.ui-mock) {
                animation: ee-showcase-slide 0.75s
                    cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
            }
        }
    }

    @keyframes ee-showcase-rise {
        from {
            opacity: 0;
            transform: translateY(0.75rem);
        }
    }

    @keyframes ee-showcase-slide {
        from {
            opacity: 0;
            transform: translateX(calc(var(--dir, 1) * 2.5rem)) scale(0.98);
        }
    }

    .panel:not(.active) :global(.ui-mock *) {
        animation: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
        .panel,
        .tab::before {
            transition: none;
        }
    }
</style>
