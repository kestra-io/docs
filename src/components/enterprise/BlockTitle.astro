---
interface Props {
    text: string
    prefix: string
}

const { text, prefix } = Astro.props

const GLYPHS: Record<string, string[]> = {
    I: ["111", "010", "010", "010", "111"],
    N: ["10001", "11001", "10101", "10011", "10001"],
    C: ["0111", "1000", "1000", "1000", "0111"],
    L: ["1000", "1000", "1000", "1000", "1111"],
    U: ["1001", "1001", "1001", "1001", "0110"],
    D: ["1110", "1001", "1001", "1001", "1110"],
    E: ["1111", "1000", "1110", "1000", "1111"],
    H: ["1001", "1001", "1111", "1001", "1001"],
    O: ["0110", "1001", "1001", "1001", "0110"],
    W: ["10001", "10001", "10101", "10101", "01010"],
    T: ["111", "010", "010", "010", "010"],
    S: ["0111", "1000", "0110", "0001", "1110"],
    "0": ["0110", "1001", "1001", "1001", "0110"],
    "4": ["1001", "1001", "1111", "0001", "0001"],
    A: ["0110", "1001", "1111", "1001", "1001"],
    F: ["1111", "1000", "1110", "1000", "1000"],
    R: ["1110", "1001", "1110", "1010", "1001"],
    K: ["1001", "1010", "1100", "1010", "1001"],
    V: ["10001", "10001", "10001", "01010", "00100"],
    " ": ["00", "00", "00", "00", "00"],
}
const GRID: { x: number; y: number }[] = []
let column = 0
for (const letter of text) {
    const rows = GLYPHS[letter]
    rows.forEach((row, y) =>
        [...row].forEach((cell, x) => {
            if (cell === "1") GRID.push({ x: column + x, y })
        }),
    )
    column += rows[0].length + 1
}
const PITCH = 1000 / (column + 1)
const GAP = PITCH * 0.123
const SIDE = (PITCH - GAP).toFixed(2)
const HEIGHT = PITCH * 5 - GAP
const MID = (HEIGHT / 2).toFixed(2)
const CELLS = GRID.map((cell) => ({ x: cell.x * PITCH, y: cell.y * PITCH }))
const DOT = { x: column * PITCH, y: 4 * PITCH }
---

<svg
    viewBox={`0 0 ${(1000 - GAP).toFixed(2)} ${HEIGHT.toFixed(2)}`}
    aria-hidden="true"
    data-blocks
    data-mid={MID}
    style={`--sweep: url(#${prefix}-sweep); --near: url(#${prefix}-near); --sweep-dot: url(#${prefix}-sweep-dot); --near-dot: url(#${prefix}-near-dot)`}
>
    <defs>
        <linearGradient
            id={`${prefix}-sweep`}
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1={MID}
            x2="1000"
            y2={MID}
        >
            <stop offset="0.38" stop-color="#a39cc4" stop-opacity="0"></stop>
            <stop offset="0.46" stop-color="#c9c3e6"></stop>
            <stop offset="0.5" stop-color="#ffffff"></stop>
            <stop offset="0.54" stop-color="#c9c3e6"></stop>
            <stop offset="0.62" stop-color="#a39cc4" stop-opacity="0"></stop>
            <animateTransform
                attributeName="gradientTransform"
                type="rotate"
                from={`0 500 ${MID}`}
                to={`360 500 ${MID}`}
                dur="14s"
                repeatCount="indefinite"
            ></animateTransform>
        </linearGradient>
        <radialGradient
            id={`${prefix}-near`}
            gradientUnits="userSpaceOnUse"
            cx="500"
            cy={MID}
            r="210"
        >
            <stop offset="0" stop-color="#eceaf8"></stop>
            <stop offset="0.4" stop-color="#d3c6f5"></stop>
            <stop offset="1" stop-color="#a39cc4" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient
            id={`${prefix}-sweep-dot`}
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1={MID}
            x2="1000"
            y2={MID}
        >
            <stop offset="0.38" stop-color="#f62e76" stop-opacity="0"></stop>
            <stop offset="0.46" stop-color="#f62e76"></stop>
            <stop offset="0.5" stop-color="#ff7fab"></stop>
            <stop offset="0.54" stop-color="#f62e76"></stop>
            <stop offset="0.62" stop-color="#f62e76" stop-opacity="0"></stop>
            <animateTransform
                attributeName="gradientTransform"
                type="rotate"
                from={`0 500 ${MID}`}
                to={`360 500 ${MID}`}
                dur="14s"
                repeatCount="indefinite"
            ></animateTransform>
        </linearGradient>
        <radialGradient
            id={`${prefix}-near-dot`}
            gradientUnits="userSpaceOnUse"
            cx="500"
            cy={MID}
            r="210"
        >
            <stop offset="0" stop-color="#ff7fab"></stop>
            <stop offset="0.4" stop-color="#f62e76"></stop>
            <stop offset="1" stop-color="#f62e76" stop-opacity="0"></stop>
        </radialGradient>
    </defs>
    {["base", "sweep", "near"].map((layer) => (
        <g class={layer}>
            {CELLS.map((cell) => (
                <rect
                    x={cell.x.toFixed(2)}
                    y={cell.y.toFixed(2)}
                    width={SIDE}
                    height={SIDE}
                />
            ))}
        </g>
    ))}
    {["base", "sweep", "near"].map((layer) => (
        <rect
            class={`dot ${layer}`}
            x={DOT.x.toFixed(2)}
            y={DOT.y.toFixed(2)}
            width={SIDE}
            height={SIDE}
        />
    ))}
</svg>
<script>
    function wire() {
        for (const svg of document.querySelectorAll<SVGSVGElement>(
            "[data-blocks]:not([data-wired])",
        )) {
            svg.dataset.wired = ""
            const section = svg.closest("section")
            const lights = svg.querySelectorAll("radialGradient")
            if (!section) continue
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
                svg.pauseAnimations()
            section.addEventListener("pointermove", (event) => {
                const box = svg.getBoundingClientRect()
                const scale = 1000 / box.width
                for (const light of lights) {
                    light.setAttribute(
                        "cx",
                        String((event.clientX - box.left) * scale),
                    )
                    light.setAttribute(
                        "cy",
                        String((event.clientY - box.top) * scale),
                    )
                }
                svg.classList.add("is-near")
            })
            section.addEventListener("pointerleave", () =>
                svg.classList.remove("is-near"),
            )
            if (
                !window.matchMedia("(hover: none)").matches ||
                window.matchMedia("(prefers-reduced-motion: reduce)").matches
            )
                continue
            let frame = 0
            const pass = () => {
                const start = performance.now()
                svg.classList.add("is-near")
                const step = (now: number) => {
                    const t = Math.min((now - start) / 1800, 1)
                    const eased = t < 0.5 ? 2 * t * t : 1 - (2 - 2 * t) ** 2 / 2
                    for (const light of lights) {
                        light.setAttribute("cx", String(-220 + eased * 1440))
                        light.setAttribute("cy", svg.dataset.mid ?? "60")
                    }
                    if (t < 1) frame = requestAnimationFrame(step)
                    else svg.classList.remove("is-near")
                }
                cancelAnimationFrame(frame)
                frame = requestAnimationFrame(step)
            }
            new IntersectionObserver(
                ([entry]) => entry.isIntersecting && pass(),
                { threshold: 0.9 },
            ).observe(svg)
        }
    }

    document.addEventListener("astro:page-load", wire)
    wire()
</script>

<style lang="scss">
    svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .base {
        fill: var(--block-title-base, rgba(216, 214, 236, 0.13));
    }

    .sweep {
        fill: var(--sweep);
        filter: drop-shadow(0 0 0.5rem rgba(206, 198, 240, 0.35));
    }

    .near {
        fill: var(--near);
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .dot.base {
        fill: rgba(246, 46, 118, 0.3);
    }

    .dot.sweep {
        fill: var(--sweep-dot);
        filter: drop-shadow(0 0 0.5rem rgba(246, 46, 118, 0.5));
    }

    .dot.near {
        fill: var(--near-dot);
    }

    :global(svg.is-near) .near {
        opacity: 1;
    }
</style>
