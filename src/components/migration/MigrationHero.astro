---
interface Cta {
    label: string
    href: string
    solid?: boolean
}

interface Props {
    id: string
    title: string
    lead: string
    ctas: Cta[]
    stacked?: boolean
}

const { id, title, lead, ctas, stacked = false } = Astro.props
---

<section
    class="mig-hero surface-dark"
    aria-labelledby={id}
    data-header-dark
    data-mig-hero
>
    <div class="container-xl">
        <div class:list={["rails", { stacked }]}>
            <div class="copy">
                <h1 {id}>{title}</h1>
                <p>{lead}</p>
                <div class="ctas">
                    {ctas.map((cta) => (
                        <a
                            href={cta.href}
                            class={cta.solid ? "btn-solid" : "btn-ghost"}
                        >
                            {cta.label}
                        </a>
                    ))}
                </div>
            </div>
            <div class="visual">
                <slot />
            </div>
        </div>
    </div>
</section>

<script>
    function clearMenu() {
        if (!document.querySelector("[data-mig-hero]")) return
        document.body.setAttribute("data-header-clear", "")
        document.addEventListener(
            "astro:before-swap",
            () => document.body.removeAttribute("data-header-clear"),
            { once: true },
        )
    }

    document.addEventListener("astro:page-load", clearMenu)
    clearMenu()
</script>

<style lang="scss">
    @use "/src/components/about/style/section" as *;
    @use "./migration" as *;

    .mig-hero {
        @include band;
        margin-top: -67px;
        @include dark-band;
        color: #ffffff;
        border-bottom-color: $dark-band-line;
    }

    .rails {
        @include rails;
        --rule: 1px solid #{$dark-band-line};
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
        gap: 2rem;
        padding: 10rem var(--inset) 6rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
            padding-block: 7rem 4rem;
        }
    }

    .rails.stacked {
        grid-template-columns: minmax(0, 1fr);
        gap: 3.5rem;
        padding-bottom: 5rem;

        .copy {
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: end;
            column-gap: 3rem;

            @include media-breakpoint-down(lg) {
                grid-template-columns: minmax(0, 1fr);
            }

            h1 {
                grid-column: 1;
            }

            p {
                grid-column: 1;
            }

            .ctas {
                grid-column: 2;
                grid-row: 1 / span 2;
                align-self: end;

                @include media-breakpoint-down(lg) {
                    grid-column: 1;
                    grid-row: auto;
                }
            }
        }
    }

    .copy {
        display: grid;
        row-gap: 1.5rem;
        justify-items: start;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.05;
        text-wrap: balance;
    }

    p {
        max-width: 34rem;
        margin: 0;
        font-size: 1.1875rem;
        line-height: 1.55;
        color: #b9b8c4;
    }

    .ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }
</style>
