---
import { Icon } from "astro-icon/components"

export interface TableRow {
    cells: readonly string[]
    href?: string
}

export interface TableGroup {
    title: string
    icon: string
    rows: readonly TableRow[]
}

export interface TableColumn {
    label: string
    logo?: string
}

export type TableHead = string | TableColumn

export interface TableTab {
    id: string
    label: string
    columns: readonly TableHead[]
    widths?: readonly string[]
    groups: readonly TableGroup[]
}

interface Props {
    id: string
    title: string
    lead?: string
    columns?: readonly TableHead[]
    widths?: readonly string[]
    groups?: readonly TableGroup[]
    tabs?: readonly TableTab[]
}

const {
    id,
    title,
    lead,
    columns = [],
    widths = [],
    groups = [],
    tabs,
} = Astro.props

const parts = (text: string) =>
    text.split("`").map((value, idx) => ({ value, code: idx % 2 === 1 }))

const head = (column: TableHead): TableColumn =>
    typeof column === "string" ? { label: column } : column

const panels: readonly TableTab[] = tabs ?? [
    { id: `${id}-table`, label: title, columns, widths, groups },
]

const logos = [
    ...new Set(
        panels.flatMap((panel) =>
            panel.columns.map(head).flatMap((column) => column.logo ?? []),
        ),
    ),
].map((svg, idx) => ({
    svg,
    ref: `${id}-logo-${idx}`,
    viewBox: svg.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 100 100",
    body: svg.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, ""),
}))
const logoOf = (svg: string) => logos.find((logo) => logo.svg === svg)!
---

<section class="mig-table" aria-labelledby={id} data-mig-table>
    {logos.length > 0 && (
        <svg class="sprite" aria-hidden="true">
            {logos.map((logo) => (
                <symbol
                    id={logo.ref}
                    viewBox={logo.viewBox}
                    set:html={logo.body}
                />
            ))}
        </svg>
    )}
    <div class="container-xl">
        <div class="rails">
            <header>
                <h2 {id}>
                    <slot name="title">{title}</slot>
                </h2>
                {lead && <p set:html={lead} />}
            </header>
            {tabs && (
                <div
                    class="switch"
                    role="tablist"
                    aria-label={title}
                    style={`--n: ${tabs.length}; --i: 0`}
                >
                    <span class="thumb" aria-hidden="true" />
                    {tabs.map((tab, idx) => (
                        <button
                            type="button"
                            role="tab"
                            id={`${tab.id}-tab`}
                            aria-controls={tab.id}
                            aria-selected={idx === 0 ? "true" : "false"}
                            tabindex={idx === 0 ? 0 : -1}
                        >
                            {tab.label}
                        </button>
                    ))}
                </div>
            )}
            {panels.map((panel, idx) => {
                const grouped =
                    panel.groups.length > 1 || !!panel.groups[0]?.title
                return (
                    <div
                        class="panel"
                        id={panel.id}
                        role={tabs ? "tabpanel" : undefined}
                        aria-labelledby={tabs ? `${panel.id}-tab` : undefined}
                        hidden={idx !== 0}
                    >
                        <table>
                            <thead>
                                <tr>
                                    {panel.columns
                                        .map(head)
                                        .map((column, c) => (
                                            <th
                                                scope="col"
                                                class:list={[
                                                    { brand: !!column.logo },
                                                ]}
                                                style={
                                                    panel.widths?.[c]
                                                        ? `width: ${panel.widths[c]}`
                                                        : undefined
                                                }
                                            >
                                                {column.logo ? (
                                                    <svg
                                                        class="logo"
                                                        role="img"
                                                        aria-label={
                                                            column.label
                                                        }
                                                        viewBox={
                                                            logoOf(column.logo)
                                                                .viewBox
                                                        }
                                                    >
                                                        <use
                                                            href={`#${logoOf(column.logo).ref}`}
                                                        />
                                                    </svg>
                                                ) : (
                                                    column.label
                                                )}
                                            </th>
                                        ))}
                                </tr>
                            </thead>
                            {panel.groups.map((group) => (
                                <tbody>
                                    {grouped && (
                                        <tr class="group">
                                            <th
                                                scope="rowgroup"
                                                colspan={panel.columns.length}
                                            >
                                                <span>
                                                    <Icon name={group.icon} />
                                                    {group.title}
                                                </span>
                                            </th>
                                        </tr>
                                    )}
                                    {group.rows.map((row) => (
                                        <tr>
                                            {row.cells.map((cell, c) => {
                                                const content = parts(cell).map(
                                                    (part) =>
                                                        part.code ? (
                                                            <code>
                                                                {part.value}
                                                            </code>
                                                        ) : (
                                                            part.value
                                                        ),
                                                )
                                                return c === 0 ? (
                                                    <th scope="row">
                                                        {content}
                                                    </th>
                                                ) : (
                                                    <td
                                                        class:list={[
                                                            { main: c === 1 },
                                                        ]}
                                                        data-label={
                                                            head(
                                                                panel.columns[
                                                                    c
                                                                ],
                                                            ).label
                                                        }
                                                    >
                                                        {c === 1 && row.href ? (
                                                            <a href={row.href}>
                                                                {content}
                                                            </a>
                                                        ) : (
                                                            content
                                                        )}
                                                    </td>
                                                )
                                            })}
                                        </tr>
                                    ))}
                                </tbody>
                            ))}
                        </table>
                    </div>
                )
            })}
        </div>
    </div>
</section>

<script>
    function wire() {
        document
            .querySelectorAll<HTMLElement>("[data-mig-table]:not([data-wired])")
            .forEach((root) => {
                root.dataset.wired = ""
                const tabs = [
                    ...root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
                ]
                const bar = root.querySelector<HTMLElement>(".switch")
                const select = (tab: HTMLButtonElement) =>
                    tabs.forEach((other, i) => {
                        const on = other === tab
                        other.setAttribute("aria-selected", String(on))
                        other.tabIndex = on ? 0 : -1
                        if (on) bar?.style.setProperty("--i", String(i))
                        const panel = root.querySelector<HTMLElement>(
                            `#${other.getAttribute("aria-controls")}`,
                        )
                        if (panel) panel.hidden = !on
                    })
                tabs.forEach((tab, idx) => {
                    tab.addEventListener("click", () => select(tab))
                    tab.addEventListener("keydown", (event) => {
                        const step =
                            event.key === "ArrowRight"
                                ? 1
                                : event.key === "ArrowLeft"
                                  ? -1
                                  : 0
                        if (!step) return
                        const next =
                            tabs[(idx + step + tabs.length) % tabs.length]
                        select(next)
                        next.focus()
                    })
                })
            })
    }

    document.addEventListener("astro:page-load", wire)
    wire()
</script>

<style lang="scss">
    @use "/src/components/about/style/section" as *;

    .sprite {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
    }

    .mig-table {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-bottom: var(--rule);
        background: var(--ks-background-body);
    }

    .rails {
        padding-bottom: 5rem;
        border-inline: var(--rule);

        @include media-breakpoint-down(xl) {
            border-inline: 0;
        }

        @include media-breakpoint-down(md) {
            padding-bottom: 3rem;
        }
    }

    header {
        display: grid;
        gap: 1rem;
        padding: 6rem var(--inset) 2.5rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 2rem;
        }

        h2 {
            @include title;
            font-size: clamp(2rem, 3.6vw, 3rem);
            color: var(--ks-content-primary);
        }

        p {
            max-width: 44rem;
            margin: 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: var(--ks-content-tertiary);

            :global(a) {
                color: var(--ks-content-link);
            }
        }
    }

    .switch {
        position: relative;
        display: inline-grid;
        grid-template-columns: repeat(var(--n), minmax(0, 1fr));
        margin: 0 var(--inset) 2rem;
        padding: 0.25rem;
        border: var(--rule);
        border-radius: 0.625rem;
        background: var(--ks-background-body);

        button {
            position: relative;
            padding: 0.5rem 1.125rem;
            border: 0;
            border-radius: 0.375rem;
            background: transparent;
            font-size: 1rem;
            font-weight: 500;
            color: var(--ks-content-tertiary);
            cursor: pointer;
            transition: color 0.2s ease;

            &:hover {
                color: var(--ks-content-primary);
            }

            &:focus-visible {
                outline: 2px solid var(--ks-border-active);
                outline-offset: 1px;
            }

            &[aria-selected="true"] {
                color: var(--ks-content-primary);
                cursor: default;
            }
        }
    }

    .thumb {
        position: absolute;
        top: 0.25rem;
        bottom: 0.25rem;
        left: 0.25rem;
        width: calc((100% - 0.5rem) / var(--n));
        border-radius: 0.375rem;
        background: var(--ks-background-secondary);
        transform: translateX(calc(var(--i) * 100%));
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);

        @media (prefers-reduced-motion: reduce) {
            transition: none;
        }
    }

    .panel[hidden] {
        display: none;
    }

    table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

    th,
    td {
        padding: 0.875rem 1rem;
        border-bottom: var(--rule);
        vertical-align: top;
        text-align: left;
        font-size: $font-size-md;
        line-height: 1.45;
        overflow-wrap: anywhere;

        &:first-child {
            padding-left: var(--inset);
        }

        &:last-child {
            padding-right: var(--inset);
        }

        @include media-breakpoint-up(md) {
            &:not(:first-child) {
                border-left: var(--rule);
            }
        }
    }

    thead th {
        position: sticky;
        top: 59px;
        z-index: 2;
        padding-block: 1.125rem;
        border-top: var(--rule);
        background: var(--ks-background-body);
        font-weight: 600;
        color: var(--ks-content-primary);

        &.brand {
            padding-block: 1rem;
        }

        .logo {
            display: block;
            width: auto;
            height: 1.75rem;
            color: var(--ks-content-primary);
        }

        &.brand:first-child .logo {
            height: 2.5rem;
            margin-block: -0.375rem;
        }

        @include media-breakpoint-down(xl) {
            top: 55px;
        }
    }

    .group th {
        padding-block: 2rem 0.75rem;
        background: var(--ks-background-body);
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--ks-content-primary);

        span {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        :global(svg) {
            width: 1.125rem;
            height: 1.125rem;
            color: var(--ks-content-link);
        }
    }

    tbody th[scope="row"] {
        font-weight: 500;
        color: var(--ks-content-primary);
    }

    td {
        color: var(--ks-content-secondary);
    }

    td.main {
        font-weight: 500;
        color: var(--ks-content-primary);

        a {
            color: inherit;
            text-decoration: none;

            &:hover {
                color: var(--ks-content-link);
                text-decoration: underline;
            }
        }
    }

    code {
        padding: 0.0625rem 0.3125rem;
        border: 0;
        border-radius: 4px;
        background: var(--ks-background-secondary);
        font-family: $font-family-monospace;
        font-size: 0.8125rem;
        font-weight: 400;
        color: var(--ks-content-primary);
    }

    @media (hover: hover) {
        tbody tr:not(.group):hover > * {
            background: var(--ks-background-secondary);
        }
    }

    @include media-breakpoint-down(md) {
        thead {
            display: none;
        }

        table,
        tbody,
        tr,
        th,
        td {
            display: block;
            width: auto !important;
        }

        tbody tr:not(.group) {
            padding: 0.875rem var(--inset);
            border-bottom: var(--rule);

            > * {
                padding: 0;
                border: 0;
            }

            > td {
                margin-top: 0.375rem;
            }

            > td:not(.main)::before {
                content: attr(data-label) " · ";
                font-weight: 600;
                color: var(--ks-content-secondary);
            }
        }

        .group th {
            padding-inline: var(--inset);
        }
    }
</style>
