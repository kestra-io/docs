---
import Link from "~/components/common/Link.astro"
import awsSVG from "~/assets/enterprise/aws.svg?raw"
import azureSVG from "~/assets/enterprise/azure.svg?raw"
import googleSVG from "~/assets/enterprise/google.svg?raw"
import homeRoofSVG from "~/assets/enterprise/home-roof.svg?raw"

const CLOUDS = [
    {
        name: "AWS",
        logo: awsSVG,
        href: "/plugins/plugin-aws",
        cta: "Explore the AWS plugin",
        facts: [
            "60+ tasks and triggers: S3, Lambda, Glue, Athena, EMR, SQS, SNS, EventBridge, Kinesis, Bedrock and more.",
            "S3 as Kestra's internal storage for outputs and namespace files.",
            "AWS Secrets Manager as the secrets backend in the Enterprise Edition.",
        ],
    },
    {
        name: "Azure",
        logo: azureSVG,
        href: "/plugins/plugin-azure",
        cta: "Explore the Azure plugin",
        facts: [
            "80+ tasks and triggers: Blob Storage, Data Factory, Synapse, Functions, Event Hubs, Service Bus, Batch, AI Foundry and more.",
            "Blob Storage as Kestra's internal storage for outputs and namespace files.",
            "Azure Key Vault as the secrets backend in the Enterprise Edition.",
        ],
    },
    {
        name: "Google Cloud",
        logo: googleSVG,
        href: "/plugins/plugin-gcp",
        cta: "Explore the Google Cloud plugin",
        facts: [
            "80+ tasks and triggers: BigQuery, Cloud Storage, Pub/Sub, Dataproc, Dataflow, Vertex AI, Cloud Functions, GKE and more.",
            "Cloud Storage as Kestra's internal storage for outputs and namespace files.",
            "Google Secret Manager as the secrets backend in the Enterprise Edition.",
        ],
    },
]
---

<section class="clouds">
    <div class="container">
        <div class="heading">
            <h2>Partnering with the major cloud providers</h2>
            <p>
                To give you the best integrations, each cloud is a plugin group,
                a storage backend and a secrets backend, so workflows run next
                to the data and services they orchestrate.
            </p>
        </div>
        <div class="row g-4">
            {
                CLOUDS.map((cloud) => (
                    <div class="col-12 col-lg-4">
                        <article class="cloud">
                            <div class="head">
                                <span class="logo" set:html={cloud.logo} />
                                <h3>{cloud.name}</h3>
                            </div>
                            <ul>
                                {cloud.facts.map((fact) => (
                                    <li>{fact}</li>
                                ))}
                            </ul>
                            <Link href={cloud.href} class="more">
                                {cloud.cta}
                            </Link>
                        </article>
                    </div>
                ))
            }
        </div>
        <p class="anywhere">
            <span class="logo" set:html={homeRoofSVG} />
            Not on one of these? Kestra runs on any Kubernetes cluster, Docker host
            or bare metal server, in the cloud or on-premises.
        </p>
    </div>
</section>

<style lang="scss">
    .clouds {
        --clouds-border: var(--ks-border-default, #e9e9ee);

        padding: 5rem 0;
        // white, so it doesn't run into the grey "Join the program" block below
        background: var(--ks-background-body);

        :global(html.dark) & {
            --clouds-border: var(--ks-border-default, #2e2e3c);
        }

        .heading {
            max-width: 640px;
            margin-bottom: 2.5rem;

            h2 {
                font-size: clamp(1.75rem, 3vw, 2.25rem);
                font-weight: 600;
                letter-spacing: -0.015em;
                margin: 0 0 1rem;
                text-wrap: balance;
            }

            p {
                margin: 0;
                color: var(--ks-content-secondary);
                line-height: 1.6;
            }
        }

        .cloud {
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 1.5rem;
            border-radius: 0.8125rem;
            border: 1px solid var(--clouds-border);
            background: var(--ks-background-body);

            .head {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            h3 {
                font-size: $font-size-lg;
                font-weight: 600;
                margin: 0;
                color: var(--ks-content-primary);
            }

            ul {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 0.625rem;
            }

            li {
                position: relative;
                padding-left: 1rem;
                font-size: $font-size-sm;
                line-height: 1.5;
                color: var(--ks-content-secondary);

                &::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 0.6em;
                    width: 5px;
                    height: 5px;
                    border-radius: 50%;
                    background: var(--ks-content-tertiary);
                }
            }

            .more {
                margin-top: auto;
                font-size: $font-size-sm;
                font-weight: 600;
                color: var(--ks-content-link);
                text-decoration: none;
            }
        }

        .logo {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border-radius: 10px;
            // a light chip so the logo still stands out on the white card
            background: #f7f7f7;
            color: #232f3e;

            :global(svg) {
                width: 38px;
                height: 38px;
            }
        }

        .anywhere {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            margin: 2rem 0 0;
            font-size: $font-size-sm;
            color: var(--ks-content-secondary);

            .logo {
                width: 36px;
                height: 36px;

                :global(svg) {
                    width: 20px;
                    height: 20px;
                }
            }
        }
    }
</style>
