---
import { Icon } from "astro-icon/components"
import { PARTNERS, type PartnerType } from "./partners"

interface Props {
    type?: PartnerType
    limit?: number
}

const { type, limit } = Astro.props
const partners = PARTNERS.filter((p) => !type || p.type === type).slice(
    0,
    limit ?? PARTNERS.length,
)
---

<section class="lists">
    <div class="container overflow-visible">
        <div class="row g-3">
            {
                partners.map((partner) => {
                    const isExternal = partner.href.startsWith("http")
                    return (
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                            <div class="card">
                                <div
                                    class:list={[
                                        "badge",
                                        partner.type.toLowerCase(),
                                    ]}
                                >
                                    {partner.type}
                                </div>
                                <div class="placeholder">
                                    <img
                                        src={partner.logo.src}
                                        alt={partner.name}
                                    />
                                </div>
                                <h6 class="mb-0">{partner.name}</h6>
                                <p class="mb-0">{partner.description}</p>
                                <a
                                    href={partner.href}
                                    class="visit-link"
                                    target={isExternal ? "_blank" : undefined}
                                    rel={
                                        isExternal
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    <h6 class="mb-0">
                                        {isExternal ? (
                                            <>
                                                Visit {partner.name} website
                                                <Icon name="mdi:open-in-new" />
                                            </>
                                        ) : (
                                            `Visit ${partner.name} page`
                                        )}
                                    </h6>
                                </a>
                            </div>
                        </div>
                    )
                })
            }
        </div>
    </div>
</section>

<style lang="scss">
    .lists {
        padding-top: 64px;
        padding-bottom: 90px;
        background: var(--ks-background-body);

        .card {
            width: 100%;
            max-width: 273px;
            min-height: 356px;
            height: 100%;
            border-radius: 8px;
            padding: 16px;
            border: 1px solid var(--ks-border-secondary);
            background: var(--ks-background-primary);
            box-shadow: 2px 3px 16px 0px var(--ks-shadows-light);
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;

            .placeholder {
                width: 100%;
                height: 140px;
                border-radius: 8px;
                border: 1px solid var(--ks-border-primary);
                background: #f7f7f7;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;

                img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }
            }

            .badge {
                width: fit-content;
                padding: 2px 8px;
                border-radius: 40px;
                font-weight: 600;
                font-size: $font-size-xs;

                &.consulting {
                    background: var(--ks-background-tag-success);
                    color: var(--ks-content-tag-success);
                }

                &.technology {
                    background: var(--ks-background-tag-category);
                    color: var(--ks-content-tag-category);
                }
            }

            h6 {
                color: var(--ks-content-primary);
            }

            p {
                color: var(--ks-content-secondary);
                font-size: $font-size-xs;
            }

            .visit-link {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 0.25rem;
                text-decoration: none;
                margin-top: auto;

                h6 {
                    color: var(--ks-content-link);
                    font-size: $font-size-xs;
                    margin-top: 0.5rem;
                }
            }
        }
    }
</style>
