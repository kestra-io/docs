---
import { PARTNERS, type PartnerType } from "./partners"
import HairlineFigure from "./HairlineFigure.astro"

interface Props {
    type: PartnerType
    title: string
    text: string
    href: string
    cta: string
    reverse?: boolean
    figure?: "deploy" | "plugins"
}

const { type, title, text, href, cta, reverse = false, figure } = Astro.props
const partners = PARTNERS.filter((p) => p.type === type)
---

<section class="track">
    <div class="container">
        <div class="frame">
            <div class="panel">
                <div class:list={["inner", { reverse }]}>
                    <div class="content">
                        <h2>{title}</h2>
                        <p>{text}</p>
                        <a href={href} class="btn btn-secondary">{cta}</a>
                    </div>
                    <div class="visual">
                        {
                            figure ? (
                                <HairlineFigure name={figure} />
                            ) : (
                                <ul class="logos" aria-label={`${title} logos`}>
                                    {partners.map((partner) => (
                                        <li>
                                            <img
                                                src={partner.logo.src}
                                                alt={partner.name}
                                                loading="lazy"
                                            />
                                        </li>
                                    ))}
                                </ul>
                            )
                        }
                    </div>
                </div>
                {
                    figure && (
                        <ul class="members" aria-label={title}>
                            {partners.map((partner) => (
                                <li>
                                    <img
                                        src={partner.logo.src}
                                        alt={partner.name}
                                        loading="lazy"
                                    />
                                </li>
                            ))}
                        </ul>
                    )
                }
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    // the framed card of the infrastructure page: a light border, a thin gap, then the grey panel
    .track {
        padding: 0.8rem 0;

        // the run of cards gets air above and below, not between
        &:not(.track + .track) {
            padding-top: 1.5rem;
        }

        &:not(:has(+ .track)) {
            padding-bottom: 4rem;
        }

        .frame {
            border: 1px solid var(--ks-border-primary);
            padding: 0.375rem;
            border-radius: 0.8125rem;
            background: none;
        }

        .panel {
            border-radius: 0.5625rem;
            background: var(--ks-background-secondary);
        }

        .inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            padding: 2rem 1.5rem;

            @include media-breakpoint-up(lg) {
                flex-direction: row;
                gap: 3rem;
                padding: 1.5rem 2rem 1.5rem 3.5rem;

                &.reverse {
                    flex-direction: row-reverse;
                    padding: 1.5rem 3.5rem 1.5rem 2rem;
                }
            }
        }

        .content {
            @include media-breakpoint-up(lg) {
                flex: 0 0 38%;
            }
        }

        // who the track gathers: its partners' logos on one line along the bottom, small and greyed out
        .members {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 1rem 1.5rem;
            margin: 0;
            padding: 1.25rem 1.5rem 1.5rem;
            list-style: none;
            // a hairline that reads on the grey panel in both themes
            border-top: 1px solid
                color-mix(in srgb, var(--ks-content-primary) 8%, transparent);

            @include media-breakpoint-up(lg) {
                flex-wrap: nowrap;
                justify-content: space-between;
                padding: 1.25rem 3.5rem 1.5rem;
            }

            // logos give up width before the line overflows
            li {
                display: flex;
                align-items: center;
                flex: 0 1 auto;
                min-width: 0;
                height: 1.375rem;
            }

            img {
                height: 100%;
                max-width: min(6.5rem, 100%);
                object-fit: contain;
                filter: grayscale(1);
                opacity: 0.55;

                :global(html.dark) & {
                    filter: grayscale(1) brightness(0) invert(1);
                    opacity: 0.5;
                }
            }
        }

        .visual {
            flex: 1;
            width: 100%;
        }

        h2 {
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.015em;
            margin: 0 0 1rem;
        }

        p {
            color: var(--ks-content-secondary);
            line-height: 1.6;
            margin: 0 0 1.5rem;
        }

        .logos {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;

            @include media-breakpoint-down(md) {
                grid-template-columns: repeat(2, 1fr);
            }

            li {
                display: flex;
                align-items: center;
                justify-content: center;
                height: 84px;
                padding: 1rem 1.25rem;
                border-radius: 8px;
                background: #f7f7f7;
                border: 1px solid var(--ks-border-secondary);
            }

            img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }
        }
    }
</style>
