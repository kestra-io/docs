---
import { PARTNERS } from "./partners"

interface Featured {
    name: string
    text: string
    href: string
    cta: string
    /** the partner's brand colour, for the glow that lights its card */
    color: string
}

interface Props {
    title: string
    featured: Featured[]
}

const { title, featured } = Astro.props
const cards = featured.map((f) => ({
    ...f,
    logo: PARTNERS.find((p) => p.name === f.name)!.logo,
}))
---

<section class="featured">
    <div class="container">
        <div class="head">
            <h2>{title}</h2>
        </div>
        <ul>
            {
                cards.map((card) => (
                    <li>
                        <a
                            href={card.href}
                            class="partner-card"
                            style={`--brand: ${card.color}`}
                        >
                            <span class="inner">
                                <span class="logo">
                                    <img
                                        src={card.logo.src}
                                        alt={card.name}
                                        loading="lazy"
                                    />
                                </span>
                                <p>{card.text}</p>
                                <span class="more">
                                    {card.cta}
                                    <svg
                                        viewBox="0 0 6 9"
                                        fill="none"
                                        class="arrow-icon"
                                        aria-hidden="true"
                                    >
                                        <g class="arrow-head">
                                            <path
                                                d="M1 1C4.5 4 5 4.38484 5 4.5C5 4.61516 4.5 5 1 8"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            />
                                        </g>
                                        <g class="arrow-body">
                                            <path
                                                d="M3.5 4.5H0"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            />
                                        </g>
                                    </svg>
                                </span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    .featured {
        padding: 4rem 0 2rem;

        .head {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            text-align: center;
            margin-bottom: 3rem;
        }

        h2 {
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.015em;
            margin: 0;
            max-width: 640px;
            text-wrap: balance;
        }

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.5rem;

            @include media-breakpoint-down(lg) {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            @include media-breakpoint-down(sm) {
                grid-template-columns: 1fr;
            }
        }

        // the whole card is the panel, lit by the partner's colour
        .partner-card {
            display: block;
            height: 100%;
            color: inherit;
            text-decoration: none;
            transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);

            &:hover {
                transform: translateY(-4px);

                .inner::before {
                    opacity: 1;
                }
            }
        }

        .inner {
            position: relative;
            isolation: isolate;
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 21rem;
            padding: 1.5rem;
            overflow: hidden;
            border-radius: 0.8125rem;
            background:
                radial-gradient(
                    ellipse 90% 60% at 100% 0%,
                    color-mix(in srgb, var(--brand) 28%, transparent),
                    transparent 70%
                ),
                var(--ks-background-secondary);

            // a stronger glow that rises on hover
            &::before {
                content: "";
                position: absolute;
                inset: 0;
                z-index: -1;
                background: radial-gradient(
                    ellipse 110% 80% at 100% 0%,
                    color-mix(in srgb, var(--brand) 40%, transparent),
                    transparent 75%
                );
                opacity: 0;
                transition: opacity 400ms ease;
            }
        }

        // partner logos are drawn for light backgrounds, so they sit on a white chip
        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 4.5rem;
            padding: 0.875rem 1.125rem;
            border-radius: 0.75rem;
            background: #fff;
            box-shadow: 0 6px 20px
                color-mix(in srgb, var(--brand) 18%, transparent);

            img {
                height: 100%;
                max-width: 9rem;
                object-fit: contain;
            }
        }

        p {
            margin: auto 0 1rem;
            padding-top: 2rem;
            font-size: $font-size-lg;
            font-weight: 600;
            line-height: 1.4;
        }

        // the site's link arrow, which stretches when the card is hovered;
        // it stays inline so it follows the last word when the link wraps
        .more {
            color: var(--ks-content-color-highlight);
            font-weight: bold;
            text-wrap: balance;

            .arrow-icon {
                display: inline-block;
                overflow: visible;
                width: 12px;
                height: 12px;
                margin-left: 0.3rem;
                vertical-align: -0.05em;
            }

            .arrow-head {
                transition: transform 100ms ease-in-out;
            }

            .arrow-body {
                opacity: 0;
                transition:
                    transform 100ms ease-in-out,
                    opacity 100ms ease-in-out;
            }
        }

        .partner-card:hover .more {
            .arrow-head {
                transform: translateX(3px);
            }

            .arrow-body {
                opacity: 1;
                transform: scaleX(2);
            }
        }
    }
</style>
