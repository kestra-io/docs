---
import { Icon } from "astro-icon/components"
import { PARTNERS } from "./partners"

interface Featured {
    name: string
    text: string
    href: string
}

interface Props {
    title: string
    featured: Featured[]
    href: string
    cta: string
}

const { title, featured, href, cta } = Astro.props
const cards = featured.map((f) => ({
    ...f,
    logo: PARTNERS.find((p) => p.name === f.name)!.logo,
}))
---

<section class="featured">
    <div class="container">
        <div class="head">
            <h2>{title}</h2>
            <a href={href} class="btn btn-secondary">{cta}</a>
        </div>
        <ul>
            {
                cards.map((card) => (
                    <li>
                        <a href={card.href} class="partner-card">
                            <div class="logo">
                                <img
                                    src={card.logo.src}
                                    alt={card.name}
                                    loading="lazy"
                                />
                            </div>
                            <p>{card.text}</p>
                            <span class="more">
                                Learn more
                                <Icon name="mdi:arrow-right" />
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    .featured {
        padding: 4rem 0 5rem;

        .head {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            text-align: center;
            margin-bottom: 3rem;
        }

        h2 {
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.015em;
            margin: 0;
            max-width: 640px;
            text-wrap: balance;
        }

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;

            @include media-breakpoint-down(lg) {
                grid-template-columns: repeat(2, 1fr);
            }

            @include media-breakpoint-down(sm) {
                grid-template-columns: 1fr;
            }
        }

        .partner-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            color: inherit;
            text-decoration: none;

            &:hover .more {
                text-decoration: underline;
            }
        }

        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 9.25rem;
            padding: 1.5rem 1.75rem;
            border-radius: 8px;
            background: #f7f7f7;
            border: 1px solid var(--ks-border-default, #e9e9ee);

            img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }
        }

        p {
            flex: 1;
            margin: 1.25rem 0 1rem;
            font-weight: 600;
            line-height: 1.45;
        }

        .more {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            color: var(--ks-content-link);

            svg {
                width: 1rem;
                height: 1rem;
            }
        }
    }
</style>
