---
import Link from "~/components/common/Link.astro"

interface Props {
    track?: "consulting" | "technology"
}

const { track } = Astro.props

const COPY = {
    consulting: {
        title: "Sell and deliver Kestra with us",
        text: "Three steps, five minutes. The partnerships team answers within a week.",
        cta: "Apply to the program",
    },
    technology: {
        title: "Ship your integration with us",
        text: "Three steps, five minutes. Tell us what you build and where the integration stands, and the plugin team answers within a week.",
        cta: "Apply as a technology partner",
    },
    default: {
        title: "Become a Kestra partner",
        text: "Three steps, five minutes. Pick your track, tell us about your company, and the partnerships team answers within a week.",
        cta: "Apply now",
    },
}

const copy = COPY[track ?? "default"]
const href = track ? `/partners/apply?track=${track}` : "/partners/apply"
---

<section class="partner-cta" id="form">
    <div class="container">
        <div class="frame">
            <div class="panel">
                <h2>{copy.title}<span class="dot">.</span></h2>
                <p>{copy.text}</p>
                <div class="actions">
                    <Link href={href} class="btn btn-primary">{copy.cta}</Link>
                    {
                        !track && (
                            <a
                                href="/partners/consulting"
                                class="btn btn-secondary"
                            >
                                Find a partner
                            </a>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .partner-cta {
        padding: 4rem 0 5rem;
        background: var(--ks-background-body);

        // the framed card of the other blocks: a light border, a thin gap, then the panel
        .frame {
            padding: 0.375rem;
            border-radius: 1.25rem;
            border: 1px solid var(--ks-border-primary);
        }

        // a dark panel lit from the top by violet and blue glows, the same in both themes
        .panel {
            position: relative;
            overflow: hidden;
            padding: 7rem 1.5rem;
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.08);
            text-align: center;
            color: #fff;
            background:
                radial-gradient(
                    ellipse 55% 60% at 50% 0%,
                    rgba(146, 72, 220, 0.75),
                    transparent 70%
                ),
                radial-gradient(
                    ellipse 45% 70% at 12% 25%,
                    rgba(58, 64, 220, 0.6),
                    transparent 70%
                ),
                radial-gradient(
                    ellipse 45% 70% at 88% 25%,
                    rgba(58, 64, 220, 0.6),
                    transparent 70%
                ),
                radial-gradient(
                    ellipse 90% 80% at 50% 45%,
                    rgba(72, 52, 180, 0.55),
                    transparent 80%
                ),
                #121214;

            @include media-breakpoint-down(md) {
                padding: 4.5rem 1.25rem;
            }
        }

        h2 {
            max-width: 14ch;
            margin: 0 auto;
            font-size: clamp(2.25rem, 5vw, 3.75rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.08;
            color: inherit;
            text-wrap: balance;

            .dot {
                color: #fe0071;
            }
        }

        p {
            max-width: 620px;
            margin: 1.5rem auto 2.5rem;
            font-size: $font-size-md;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.85);
        }

        .actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;

            // white on the glow, the outlined one turns white on hover
            :global(.btn-primary) {
                --ks-btn-bg: #fff;
                --ks-btn-color: #0e0e10;
                --ks-btn-hover-bg: #e9e9ee;
                --ks-btn-hover-color: #0e0e10;
                --ks-background-button-primary: #fff;
                --ks-background-button-primary-hover: #e9e9ee;
                background: #fff;
                // the global .btn-primary forces white text
                color: #0e0e10 !important;
                border-color: #fff;
                box-shadow: none;
            }

            .btn-secondary {
                --ks-content-primary: #fff;
                --ks-background-button-secondary: transparent;
                --ks-content-btn-secondary-hover: #0e0e10;
                --ks-background-button-secondary-hover: #fff;
                border-color: rgba(255, 255, 255, 0.7);
            }
        }
    }
</style>
