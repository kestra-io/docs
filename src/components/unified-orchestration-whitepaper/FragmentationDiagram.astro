---
// Simplified, hero-sized version of the "four domains, four orchestrators,
// four audit trails" figure: four separate engines, four separate audit
// trails, handoffs that break in between, and an agent layer reaching across
// all of it with nothing governing it.
// Each domain gets its own shape as well as its own colour: the point of the
// figure is that these are four different tools, not four instances of one.
const DOMAINS = [
    { label: "Data", hue: "var(--d-data)", shape: "square" },
    { label: "Infra", hue: "var(--d-infra)", shape: "circle" },
    { label: "Apps", hue: "var(--d-apps)", shape: "diamond" },
    { label: "Business", hue: "var(--d-business)", shape: "pill" },
] as const

const COL_W = 105
const GAP = 20
const COL_Y = 74
const COL_H = 150
const x = (i: number) => i * (COL_W + GAP)
---

<figure class="diagram">
    <svg
        viewBox="0 0 480 262"
        role="img"
        aria-labelledby="frag-title frag-desc"
        xmlns="http://www.w3.org/2000/svg"
    >
        <title id="frag-title">Four domains, four orchestrators, four audit trails</title>
        <desc id="frag-desc">
            Data, infrastructure, applications and business processes each run
            their own orchestrator and keep their own audit trail. The handoffs
            between them break, and an agent layer reaches across all four with
            no single layer governing the actions.
        </desc>

        <!-- agent layer, reaching across all four -->
        <rect x="0" y="0" width="480" height="40" rx="10" class="agent-band" />
        <text x="240" y="25" class="agent-label">
            Agentic AI reaches across all four
        </text>
        {
            DOMAINS.map((_, i) => (
                <path
                    d={`M ${x(i) + COL_W / 2} 44 L ${x(i) + COL_W / 2} 68`}
                    class="agent-arrow"
                />
            ))
        }

        {
            DOMAINS.map((d, i) => (
                <g>
                    <rect
                        x={x(i)}
                        y={COL_Y}
                        width={COL_W}
                        height={COL_H}
                        rx="10"
                        class="col"
                    />
                    <text x={x(i) + COL_W / 2} y={COL_Y + 28} class="col-label">
                        {d.label}
                    </text>

                    {/* its own engine, its own shape */}
                    {d.shape === "square" && (
                        <rect
                            x={x(i) + COL_W / 2 - 17}
                            y={COL_Y + 46}
                            width="34"
                            height="34"
                            rx="9"
                            fill={d.hue}
                        />
                    )}
                    {d.shape === "circle" && (
                        <circle
                            cx={x(i) + COL_W / 2}
                            cy={COL_Y + 63}
                            r="18"
                            fill={d.hue}
                        />
                    )}
                    {d.shape === "diamond" && (
                        <rect
                            x={x(i) + COL_W / 2 - 15}
                            y={COL_Y + 48}
                            width="30"
                            height="30"
                            rx="6"
                            fill={d.hue}
                            transform={`rotate(45 ${x(i) + COL_W / 2} ${COL_Y + 63})`}
                        />
                    )}
                    {d.shape === "pill" && (
                        <rect
                            x={x(i) + COL_W / 2 - 22}
                            y={COL_Y + 52}
                            width="44"
                            height="22"
                            rx="11"
                            fill={d.hue}
                        />
                    )}

                    {/* its own audit trail */}
                    {[0, 1, 2].map((n) => (
                        <rect
                            x={x(i) + 20}
                            y={COL_Y + 100 + n * 14}
                            width={[65, 50, 58][n]}
                            height="6"
                            rx="3"
                            class="trail"
                        />
                    ))}
                </g>
            ))
        }

        {/* the handoff between two domains, severed: a connector that leaves
            each tool and never reaches the next one. Deliberately neutral —
            the cost is the boundary, not the tools on either side of it. */}
        {
            [0, 1, 2].map((i) => {
                const cx = x(i) + COL_W + GAP / 2
                const cy = COL_Y + 63
                return (
                    <g class="cut">
                        <path d={`M ${cx - 24} ${cy} L ${cx - 6} ${cy}`} />
                        <path d={`M ${cx + 6} ${cy} L ${cx + 24} ${cy}`} />
                    </g>
                )
            })
        }

        <rect x="0" y="234" width="480" height="28" rx="8" class="caption-bar" />
        <text x="240" y="253" class="caption-label">
            The work breaks at the boundaries
        </text>
    </svg>
</figure>

<style lang="scss">
    @use "/src/assets/styles/color-palette" as *;

    // Colours come from the Kestra palette (src/assets/styles/_color-palette.scss,
    // generated from Figma). The four domains use the primary ramp so they read
    // as four distinct engines while staying inside the brand; the agent band
    // uses the orange family, which is what the design system already uses for
    // "unattended / needs attention".
    .diagram {
        --d-surface: var(--ks-background-secondary);
        --d-border: var(--ks-border-secondary);
        --d-text: var(--ks-content-primary);
        --d-trail: var(--ks-border-secondary);
        --d-agent: var(--ks-background-orange-light);
        --d-agent-line: var(--orange-300);
        --d-agent-text: var(--orange-500);
        --d-cut: var(--ks-content-tertiary);
        // The conclusion bar is Kestra primary; the four domains sit on
        // either side of it in the same ramp, so no domain collides with it.
        --d-caption: #{$base-primary-base};
        --d-caption-text: #{$base-grey-white};
        --d-apps: #{$base-primary-200};
        --d-data: #{$base-primary-300};
        --d-infra: #{$base-primary-400};
        --d-business: #{$base-primary-600};

        margin: 0;
        width: 100%;

        svg {
            display: block;
            width: 100%;
            height: auto;
            overflow: visible;
            font-family: $font-family-sans-serif;
        }
    }

    :global(html.dark) .diagram {
        --d-agent: #{rgba(#dd5f00, 0.18)}; // orange/400 at low opacity
        --d-agent-line: var(--orange-300);
        --d-agent-text: var(--orange-200);
        // On a near-black surface the ramp has to shift up a step, otherwise
        // the darkest domains disappear into the column behind them.
        --d-apps: #{$base-primary-100};
        --d-data: #{$base-primary-200};
        --d-infra: #{$base-primary-300};
        --d-business: #{$base-primary-400};
    }

    .agent-band {
        fill: var(--d-agent);
    }

    .agent-label {
        fill: var(--d-agent-text);
        font-size: 14px;
        font-weight: 700;
        text-anchor: middle;
    }

    .agent-arrow {
        stroke: var(--d-agent-line);
        stroke-width: 2.5;
        stroke-dasharray: 5 4;
        stroke-linecap: round;
    }

    .col {
        fill: var(--d-surface);
        stroke: var(--d-border);
        stroke-width: 1;
    }

    .col-label {
        fill: var(--d-text);
        font-size: 15px;
        font-weight: 700;
        text-anchor: middle;
    }

    .trail {
        fill: var(--d-trail);
    }

    .cut path {
        stroke: var(--d-cut);
        stroke-width: 2.5;
        stroke-linecap: round;
    }

    .caption-bar {
        fill: var(--d-caption);
    }

    .caption-label {
        fill: var(--d-caption-text);
        font-size: 13px;
        font-weight: 700;
        text-anchor: middle;
    }
</style>
