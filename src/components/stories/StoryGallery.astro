---
import FeaturedCarousel from "~/components/stories/FeaturedCarousel.vue"

interface Props {
    featuredStories: Story[]
}

const { featuredStories } = Astro.props
---

<section class="stories-hero">
    <div class="container">
        <div class="hero-intro">
            <h1>Thousands of teams.<br />Millions of flows. Zero drama.</h1>
            <p class="hero-sub">
                See how engineering teams use Kestra to orchestrate everything —
                from real-time AI pipelines to enterprise-scale ERP
                integrations.
            </p>
        </div>

        <FeaturedCarousel stories={featuredStories} client:idle />
    </div>
</section>

<section class="stories-list-section">
    <slot name="stories" />
</section>

<style lang="scss">
    .stories-hero {
        --hero-grid-size: 68px;
        --header-h: calc(
            var(--top-bar-height, 67px) + var(--announce-height, 0px)
        );
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background: #0a0b0d;
        color: #fff;
        margin-top: calc(-1 * var(--header-h));
        padding: calc(var(--header-h) + 3.75rem) 0 3.5rem;

        @include media-breakpoint-down(lg) {
            padding: calc(var(--header-h) + 3rem) 0 2.5rem;
        }

        &::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background-image:
                linear-gradient(
                    to right,
                    rgba(185, 135, 255, 0.12) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    to bottom,
                    rgba(185, 135, 255, 0.12) 1px,
                    transparent 1px
                );
            background-size: var(--hero-grid-size) var(--hero-grid-size);
            -webkit-mask: radial-gradient(
                ellipse 85% 70% at 60% 0%,
                #000 15%,
                transparent 100%
            );
            mask: radial-gradient(
                ellipse 85% 70% at 60% 0%,
                #000 15%,
                transparent 100%
            );
            pointer-events: none;
        }

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                radial-gradient(
                    ellipse 45% 60% at 0% 100%,
                    rgba(108, 44, 255, 0.5) 0%,
                    transparent 70%
                ),
                radial-gradient(
                    ellipse 40% 50% at 100% 100%,
                    rgba(31, 155, 243, 0.35) 0%,
                    transparent 70%
                );
            pointer-events: none;
        }

        .container {
            position: relative;
            max-width: 1180px;
        }
    }

    .hero-intro {
        margin-bottom: 4rem;
        max-width: 860px;

        @include media-breakpoint-down(lg) {
            margin-bottom: 2rem;
        }

        h1 {
            font-size: clamp(2.25rem, 4.2vw, 3.5rem);
            font-weight: 600;
            line-height: 1.05;
            color: #fff;
            letter-spacing: -0.025em;
            margin: 0 0 1.25rem;
        }

        .hero-sub {
            font-size: 1.125rem;
            color: rgba(255, 255, 255, 0.65);
            line-height: 1.75rem;
            margin: 0;
            max-width: 640px;

            @include media-breakpoint-down(md) {
                font-size: 1rem;
            }
        }
    }

    .stories-list-section {
        background: var(--ks-background-body);
    }
</style>
