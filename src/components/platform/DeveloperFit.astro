---
import Rails from "./Rails.astro"
import { Icon } from "astro-icon/components"
import SectionHead from "~/components/home/SectionHead.astro"

const CARDS = [
    {
        icon: "mdi:source-pull",
        title: "Git and CI/CD",
        text: "Review flows in pull requests and deploy them from the pipeline you already run.",
    },
    {
        icon: "mdi:console",
        title: "API and CLI",
        text: "A full REST API, a CLI for deployments and namespaces, and webhooks in and out.",
    },
    {
        icon: "mdi:terraform",
        title: "Terraform",
        text: "Manage flows, namespaces, and secrets as Terraform resources, next to the rest of your infrastructure.",
    },
    {
        icon: "mdi:code-braces",
        title: "Any language",
        text: "Run Python, Node, Go, Shell, or any container as a task. Your scripts stay as they are.",
    },
]
---

<section class="fit" id="fit" aria-labelledby="fit-h">
    <Rails>
        <SectionHead id="fit-h" align="start">
            A platform that fits <span>your existing workflows.</span>
            <Fragment slot="lead">
                Everything you can do in the UI, you can do from code. Flows are
                YAML, so they live in Git, ship through CI/CD, and get reviewed
                like any other change.
            </Fragment>
        </SectionHead>

        <ul class="cards">
            {CARDS.map((card) => (
                <li>
                    <Icon name={card.icon} class="icon" />
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                </li>
            ))}
        </ul>
    </Rails>
</section>

<style lang="scss">
    .fit {
        border-top: 1px solid var(--ks-border-primary);

        :global(.section-head h2 span) {
            display: block;
            color: var(--ks-content-tertiary);
        }
    }

    .cards {
        --rule: 1px solid var(--ks-border-primary);

        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 0 calc(-1 * var(--inset));
        padding: 0;
        border-block: var(--rule);
        list-style: none;

        @include media-breakpoint-down(xl) {
            margin: 0;
            border: var(--rule);
            border-radius: 0.75rem;
            overflow: hidden;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: minmax(0, 1fr);
        }

        li {
            position: relative;
            padding: 2.25rem 2rem 2.5rem;
            transition: background-color 0.3s ease;

            &::before {
                content: "";
                position: absolute;
                top: -1px;
                left: 0;
                right: 0;
                height: 2px;
                background: var(--ks-content-primary);
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
            }

            &:hover {
                background: var(--ks-background-secondary);

                :global(.icon) {
                    color: var(--ks-content-link);
                }

                &::before {
                    transform: none;
                }
            }

            & + li {
                border-left: var(--rule);
            }

            @include media-breakpoint-down(lg) {
                &:nth-child(3) {
                    border-left: 0;
                }

                &:nth-child(n + 3) {
                    border-top: var(--rule);
                }
            }

            @include media-breakpoint-down(sm) {
                & + li {
                    border-left: 0;
                    border-top: var(--rule);
                }
            }
        }

        h3 {
            margin: 0 0 0.5rem;
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--ks-content-primary);
        }

        p {
            margin: 0;
            font-size: $font-size-sm;
            line-height: 1.6;
            color: var(--ks-content-secondary);
        }

        :global(.icon) {
            width: 1.75rem;
            height: 1.75rem;
            margin-bottom: 1.25rem;
            color: var(--ks-content-tertiary);
            transition: color 0.3s ease;
        }
    }
</style>
