---
import Rails from "./Rails.astro"
import { Icon } from "astro-icon/components"
import SectionHead from "~/components/home/SectionHead.astro"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"

const totalPlugins = await fetchTotalPluginsCount()

const CARDS = [
    {
        icon: "mdi:scale-balance",
        title: "Apache 2.0",
        text: "A permissive license for the engine. Use it, extend it, and run it in production without a license key.",
    },
    {
        icon: "mdi:github",
        title: "Developed in public",
        text: "Source, issues, and pull requests live on GitHub.",
        href: "https://github.com/kestra-io/kestra",
    },
    {
        icon: "mdi:calendar-check-outline",
        title: "Predictable releases",
        text: "Release notes for every version on a published cadence, so you can plan upgrades like any other platform.",
        href: "/docs/releases",
    },
]

const STATS = [
    { value: "30,000", label: "GitHub stars", live: "github-stars" },
    { value: totalPlugins, label: "Plugins" },
]
---

<section class="open-source" id="open" aria-labelledby="open-h">
    <Rails>
        <SectionHead id="open-h" align="start">
            Built in the open.
            <Fragment slot="lead">
                The engine is licensed under Apache 2.0 and developed in public
                on GitHub.
            </Fragment>
        </SectionHead>

        <div class="open-grid">
            <dl class="stats">
                {STATS.map((stat) => (
                    <div>
                        <dt>{stat.label}</dt>
                        <dd>
                            <span class="arrow" aria-hidden="true">
                                ↑
                            </span>
                            <span
                                class="value"
                                data-count={stat.value}
                                data-live={stat.live}
                            >
                                {stat.value}
                            </span>
                            <span class="suffix">+</span>
                        </dd>
                    </div>
                ))}
            </dl>
            <ul class="cards">
                {CARDS.map((card) => (
                    <li>
                        <Icon name={card.icon} class="icon" />
                        <div>
                            <h3>
                                {card.href ? (
                                    <a href={card.href}>{card.title}</a>
                                ) : (
                                    card.title
                                )}
                            </h3>
                            <p>{card.text}</p>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </Rails>
</section>

<script>
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
    const format = new Intl.NumberFormat("en-US")
    const io = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return
                io.unobserve(entry.target)
                const el = entry.target as HTMLElement
                const start = performance.now()
                const step = (now: number) => {
                    const final = el.dataset.count!
                    const end = Number(final.replace(/\D/g, ""))
                    const t = Math.min(1, Math.max(0, (now - start) / 1400))
                    const eased = 1 - Math.pow(1 - t, 3)
                    el.textContent = format.format(Math.round(end * eased))
                    if (t < 1) requestAnimationFrame(step)
                    else {
                        el.textContent = final
                        el.dataset.counted = "true"
                    }
                }
                requestAnimationFrame(step)
            })
        },
        { threshold: 0.6 },
    )

    async function loadGithubStars() {
        const stars = document.querySelectorAll<HTMLElement>(
            '.open-source [data-live="github-stars"]',
        )
        if (!stars.length) return
        try {
            const response = await fetch("/api/github")
            if (!response.ok) return
            const { stargazers } = (await response.json()) as {
                stargazers?: number
            }
            if (!stargazers) return
            const value = format.format(Math.floor(stargazers / 100) * 100)
            stars.forEach((el) => {
                el.dataset.count = value
                if (reduced || el.dataset.counted) el.textContent = value
            })
        } catch {}
    }

    function init() {
        document
            .querySelectorAll<HTMLElement>(
                ".open-source [data-count]:not([data-ready])",
            )
            .forEach((el) => {
                el.dataset.ready = "true"
                if (!reduced) io.observe(el)
            })
        loadGithubStars()
    }

    document.addEventListener("astro:page-load", init)
    init()
</script>

<style lang="scss">
    .open-source {
        border-bottom: 1px solid var(--ks-border-primary);
    }

    .open-grid {
        --rule: 1px solid var(--ks-border-primary);

        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
        margin: 0 calc(-1 * var(--inset));
        border-block: var(--rule);

        @include media-breakpoint-down(xl) {
            margin: 0;
            border: var(--rule);
            border-radius: 0.75rem;
            overflow: hidden;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .stats {
        display: grid;
        grid-template-rows: 1fr 1fr;
        margin: 0;
        border-right: var(--rule);

        @include media-breakpoint-down(lg) {
            grid-template-rows: none;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            border-right: 0;
            border-bottom: var(--rule);
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: minmax(0, 1fr);
        }

        div {
            display: flex;
            flex-direction: column-reverse;
            justify-content: center;
            gap: 1rem;
            padding: 2.5rem var(--inset);

            & + div {
                border-top: var(--rule);

                @include media-breakpoint-down(lg) {
                    border-top: 0;
                    border-left: var(--rule);
                }

                @include media-breakpoint-down(sm) {
                    border-left: 0;
                    border-top: var(--rule);
                }
            }
        }

        dd {
            display: flex;
            align-items: flex-start;
            margin: 0;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
            color: var(--ks-content-primary);
        }

        .arrow {
            margin: 0.35em 0.15em 0 0;
            font-size: clamp(1.25rem, 2.2vw, 2rem);
            line-height: 1;
            color: var(--ks-content-color-highlight);
        }

        .value {
            font-size: clamp(3.25rem, 6.5vw, 6rem);
            font-weight: 500;
            letter-spacing: -0.05em;
            line-height: 0.9;
        }

        .suffix {
            align-self: flex-end;
            margin-left: 0.15em;
            font-size: clamp(1.75rem, 2.8vw, 2.5rem);
            font-weight: 500;
            line-height: 1;
            color: var(--ks-content-secondary);
        }

        dt {
            font-family: $font-family-monospace;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ks-content-tertiary);
        }
    }

    .cards {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;

        li {
            position: relative;
            display: grid;
            grid-template-columns: 1.75rem minmax(0, 1fr);
            gap: 1.25rem;
            padding: 2rem var(--inset);
            transition: background-color 0.3s ease;

            & + li {
                border-top: var(--rule);
            }

            &::before {
                content: "";
                position: absolute;
                top: -1px;
                left: 0;
                right: 0;
                height: 2px;
                background: var(--ks-content-primary);
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
            }

            &:hover {
                background: var(--ks-background-secondary);

                &::before {
                    transform: none;
                }

                :global(.icon) {
                    color: var(--ks-content-link);
                }
            }
        }

        h3 {
            margin: 0 0 0.375rem;
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--ks-content-primary);
        }

        p {
            margin: 0;
            font-size: $font-size-md;
            line-height: 1.55;
            color: var(--ks-content-secondary);
        }

        a {
            color: inherit;
            text-decoration: none;

            &::after {
                content: "";
                position: absolute;
                inset: 0;
            }
        }

        :global(.icon) {
            width: 1.75rem;
            height: 1.75rem;
            color: var(--ks-content-tertiary);
            transition: color 0.3s ease;
        }
    }
</style>
