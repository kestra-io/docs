---
import { Icon } from "astro-icon/components"
---

<div class="status" data-run-status aria-hidden="true">
    <span class="ring"></span>
    <span class="ring outer"></span>
    <span class="disc">
        <Icon name="mdi:close" class="glyph failed" />
        <Icon name="mdi:refresh" class="glyph retry" />
        <Icon name="mdi:check" class="glyph success" />
    </span>
</div>

<script>
    const STATES: [string, number][] = [
        ["failed", 1800],
        ["retry", 1800],
        ["success", 2600],
    ]

    function wireRunStatus() {
        const root = document.querySelector<HTMLElement>(
            "[data-run-status]:not([data-wired])",
        )
        if (!root) return
        root.dataset.wired = "true"
        root.dataset.state = "failed"
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.classList.add("in")
            return
        }

        let step = 0
        let timer = 0
        const next = () => {
            const [state, ms] = STATES[step]
            root.dataset.state = state
            step = (step + 1) % STATES.length
            timer = window.setTimeout(next, ms)
        }

        new IntersectionObserver(
            ([entry]) => {
                window.clearTimeout(timer)
                if (!entry.isIntersecting) return
                root.classList.add("in")
                timer = window.setTimeout(next, 500)
            },
            { threshold: 0.6 },
        ).observe(root)
    }

    document.addEventListener("astro:page-load", wireRunStatus)
    wireRunStatus()
</script>

<style lang="scss">
    .status {
        --tone: #e5484d;
        --ring: rgba(169, 80, 255, 0.4);
        --ring-outer: rgba(169, 80, 255, 0.2);

        display: grid;
        place-items: center;
        position: relative;
        width: 8rem;
        height: 8rem;
        margin: 0 auto 1rem;

        :global(html.dark) & {
            --ring: rgba(255, 255, 255, 0.24);
            --ring-outer: rgba(255, 255, 255, 0.12);
        }

        &[data-state="retry"] {
            --tone: #8405ff;

            :global(html.dark) & {
                --tone: #9869f7;
            }
        }

        &[data-state="success"] {
            --tone: #1c7e57;

            :global(html.dark) & {
                --tone: #06f0b1;
            }
        }

        .ring {
            position: absolute;
            inset: 1.125rem;
            border: 1px dashed color-mix(in srgb, var(--tone) 55%, var(--ring));
            border-radius: 50%;
            opacity: 0;
            transform: scale(0.6);
            transition:
                border-color 0.4s ease,
                opacity 0.6s ease 0.25s,
                transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.25s;

            &.outer {
                inset: 0;
                border-color: var(--ring-outer);
                transition-delay: 0s, 0.4s, 0.4s;
            }
        }

        .disc {
            display: grid;
            place-items: center;
            position: relative;
            width: 4.25rem;
            height: 4.25rem;
            border-radius: 50%;
            background: linear-gradient(180deg, #a982ff 0%, #7448e8 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.35),
                0 0 0 3px color-mix(in srgb, var(--tone) 35%, transparent),
                0 8px 22px -10px rgba(91, 40, 210, 0.5);
            opacity: 0;
            transform: scale(0.3);
            transition:
                box-shadow 0.4s ease,
                opacity 0.3s ease,
                transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);

            :global(html.dark) & {
                background: linear-gradient(180deg, #2c2c33 0%, #141418 100%);
                box-shadow:
                    0 0 0 1px rgba(255, 255, 255, 0.16),
                    0 0 0 4px color-mix(in srgb, var(--tone) 35%, transparent);
            }
        }

        :global(.glyph) {
            grid-area: 1 / 1;
            width: 2.25rem;
            height: 2.25rem;
            color: #ffffff;
            opacity: 0;
            transform: scale(0.5);
            transition:
                opacity 0.25s ease,
                transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        &:global(.in) {
            .ring,
            .disc {
                opacity: 1;
                transform: none;
            }
        }

        &[data-state="failed"] {
            :global(.failed) {
                opacity: 1;
                transform: none;
            }

            &:global(.in) .disc {
                animation: shake 0.5s ease;
            }
        }

        &[data-state="retry"] {
            :global(.retry) {
                opacity: 1;
                transform: none;
                animation: spin 1.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
            }

            .ring:not(.outer) {
                animation: spin 1.8s linear;
            }
        }

        &[data-state="success"] {
            :global(.success) {
                opacity: 1;
                transform: none;
            }

            .disc {
                animation: hop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            }
        }
    }

    @keyframes shake {
        20%,
        60% {
            transform: translateX(-5px) rotate(-4deg);
        }

        40%,
        80% {
            transform: translateX(5px) rotate(4deg);
        }
    }

    @keyframes spin {
        to {
            transform: rotate(1turn);
        }
    }

    @keyframes hop {
        40% {
            transform: translateY(-8px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .status .ring,
        .status .disc {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>
