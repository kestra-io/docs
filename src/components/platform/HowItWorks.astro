---
import { Icon } from "astro-icon/components"
import { fetchPluginIcon } from "~/utils/pluginIcon"
import CodeCard from "./CodeCard.astro"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"

const STEPS = [
    {
        tab: "Flows",
        title: "Flows define your work",
        text: "A YAML file with an id, a namespace, and tasks. Reviewed and versioned like code.",
        link: {
            href: "/docs/workflow-components/flow",
            label: "Learn more about flows",
        },
    },
    {
        tab: "Plugins",
        title: "Plugins connect your systems",
        text: "Native connectivity to thousands of services like Terraform, Postgres, ServiceNow, and others.",
        link: {
            href: "/docs/workflow-components/plugins",
            label: "Learn more about plugins",
        },
    },
    {
        tab: "Triggers",
        title: "Triggers start flows",
        text: "Start a flow on a schedule, a webhook, another flow’s result, or a poll.",
        link: {
            href: "/docs/workflow-components/triggers",
            label: "Learn more about triggers",
        },
    },
    {
        tab: "No-code",
        title: "Write flows with no code",
        text: "Don’t like to code? Author flows in the no-code editor. Edits are interchangeable with YAML, so both views stay in sync.",
    },
    {
        tab: "Observability",
        title: "Execution with insight",
        text: "Each execution retains its logs, outputs, and timing, so “what happened?” always has an answer. Metrics and alerts feed the tools you already monitor.",
        link: {
            href: "/docs/administrator-guide/monitoring",
            label: "Learn more about monitoring",
        },
    },
]

const FLOW = `id: etl_orders
namespace: company.team
tasks:
  - id: extract
    type: io.kestra.plugin.core.http.Download
    uri: https://api.example.com/orders.csv
  - id: transform
    type: io.kestra.plugin.scripts.python.Script
    script: clean_orders("{{ outputs.extract.uri }}")
  - id: load
    type: io.kestra.plugin.jdbc.postgresql.Query`

const NO_CODE = `triggers:
  - id: daily
    type: io.kestra.plugin.core.trigger.Schedule
    cron: "0 9 * * *"
tasks:
  - id: hello
    type: io.kestra.plugin.core.log.Log
    message: Hello from Kestra`

const PLUGINS = [
    { name: "Terraform", group: "io.kestra.plugin.terraform", accent: true },
    { name: "Ansible", group: "io.kestra.plugin.ansible" },
    { name: "Kubernetes", group: "io.kestra.plugin.kubernetes" },
    {
        name: "PostgreSQL",
        group: "io.kestra.plugin.jdbc.postgresql",
        accent: true,
    },
    { name: "Snowflake", group: "io.kestra.plugin.jdbc.snowflake" },
    { name: "dbt", group: "io.kestra.plugin.dbt" },
    { name: "ServiceNow", group: "io.kestra.plugin.servicenow", accent: true },
    { name: "Jira", group: "io.kestra.plugin.jira" },
    { name: "Kafka", group: "io.kestra.plugin.kafka" },
    { name: "AWS", group: "io.kestra.plugin.aws" },
    { name: "Azure", group: "io.kestra.plugin.azure" },
    { name: "Google Cloud", group: "io.kestra.plugin.gcp" },
    { name: "Python", group: "io.kestra.plugin.scripts.python" },
    { name: "Docker", group: "io.kestra.plugin.docker" },
    { name: "Slack", group: "io.kestra.plugin.notifications.slack" },
    { name: "OpenAI", group: "io.kestra.plugin.openai" },
]

const icons = await Promise.all(
    PLUGINS.map((plugin) => fetchPluginIcon(plugin.group).catch(() => null)),
)

const TRIGGERS = [
    {
        icon: "mdi:clock-outline",
        name: "Schedule",
        text: "Cron-like timing, with backfills for missed intervals.",
    },
    {
        icon: "mdi:webhook",
        name: "Webhook",
        text: "An HTTP call starts a run.",
    },
    {
        icon: "mdi:source-branch",
        name: "Flow",
        text: "Run when another flow finishes or fails.",
    },
    {
        icon: "mdi:refresh",
        name: "Polling",
        text: "Check a file, queue, or table at intervals.",
    },
]

const SIGNALS = [
    { name: "Execution logs" },
    { name: "Timeline and topology" },
    { name: "Metrics and traces" },
    { name: "Alerts" },
    { name: "Audit logs", enterprise: true },
    { name: "Log export", enterprise: true },
]

const GANTT = [
    { task: "extract", start: 0, width: 28, time: "2.1s" },
    { task: "transform", start: 28, width: 52, time: "6.4s" },
    { task: "load #1", start: 80, width: 12, time: "fail", status: "bad" },
    { task: "load #2", start: 84, width: 14, time: "retry", status: "run" },
]
---

<section class="how" id="how" aria-labelledby="how-h" data-platform-how>
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="how-h">How it works</h2>
            </header>

            <div class="tabs" role="tablist" aria-label="How it works">
                {STEPS.map((step, idx) => (
                    <button
                        type="button"
                        role="tab"
                        class:list={["tab", { active: idx === 0 }]}
                        id={`how-tab-${idx}`}
                        aria-selected={idx === 0 ? "true" : "false"}
                        aria-controls="how-panel"
                        tabindex={idx === 0 ? 0 : -1}
                    >
                        <span class="swatch" aria-hidden="true" />
                        {step.tab}
                    </button>
                ))}
            </div>

            <div
                class="body"
                id="how-panel"
                role="tabpanel"
                aria-labelledby="how-tab-0"
                data-at="0"
                style={`--pixels: url("${pixelCluster}")`}
            >
                <span class="pixels" aria-hidden="true" />
                <div class="copies">
                    {STEPS.map((step, idx) => (
                        <div class="copy" data-copy={idx}>
                            <h3>{step.title}</h3>
                            <p>{step.text}</p>
                            {step.link && (
                                <a
                                    href={step.link.href}
                                    class="btn-ghost compact"
                                >
                                    {step.link.label}
                                </a>
                            )}
                        </div>
                    ))}
                </div>

                <div class="views">
                    <div class="view" data-view="0">
                        <CodeCard
                            file="company.team / etl_orders.yml"
                            code={FLOW}
                        />
                    </div>

                    <div class="view" data-view="1">
                        <ul class="chips">
                            {PLUGINS.map((plugin, idx) => (
                                <li
                                    class:list={{ accent: plugin.accent }}
                                    style={`--k: ${idx}`}
                                >
                                    {icons[idx] && (
                                        <span
                                            class="logo"
                                            set:html={icons[idx]}
                                        />
                                    )}
                                    {plugin.name}
                                </li>
                            ))}
                            <li
                                class="more-chip"
                                style={`--k: ${PLUGINS.length}`}
                            >
                                + 2,400 more
                            </li>
                        </ul>
                    </div>

                    <div class="view" data-view="2">
                        <ul class="triggers">
                            {TRIGGERS.map((trigger, idx) => (
                                <li style={`--k: ${idx}`}>
                                    <Icon name={trigger.icon} />
                                    <b>{trigger.name}</b>
                                    <span>{trigger.text}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="view nocode" data-view="3">
                        <div class="nodes">
                            <p class="pane-label">No-code</p>
                            <div class="node">
                                <Icon name="mdi:clock-outline" />
                                <div>
                                    <b>Trigger · Schedule</b>
                                    <span>every day at 09:00</span>
                                </div>
                            </div>
                            <span class="down" aria-hidden="true">
                                ↓
                            </span>
                            <div class="node">
                                <Icon name="mdi:play" />
                                <div>
                                    <b>Task · Log</b>
                                    <span>message: Hello from Kestra</span>
                                </div>
                            </div>
                        </div>
                        <span class="sync" aria-hidden="true">
                            <Icon name="mdi:swap-horizontal" />
                        </span>
                        <CodeCard file="YAML" code={NO_CODE} />
                    </div>

                    <div class="view" data-view="4">
                        <div class="exec-card">
                            <p class="exec">
                                EXECUTION 4f2a… · etl_orders ·{" "}
                                <span class="bad">FAILED</span> → restarted
                            </p>
                            <ul class="gantt">
                                {GANTT.map((row, idx) => (
                                    <li style={`--k: ${idx}`}>
                                        <span>{row.task}</span>
                                        <span class="track">
                                            <em
                                                class={row.status}
                                                style={`left: ${row.start}%; width: ${row.width}%`}
                                            />
                                        </span>
                                        <span>{row.time}</span>
                                    </li>
                                ))}
                            </ul>
                            <ul class="chips signals">
                                {SIGNALS.map((signal) => (
                                    <li>
                                        {signal.name}
                                        {signal.enterprise && (
                                            <span class="tag">ENT</span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const STEP_MS = 7000

    function wirePlatformHow() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-platform-how]:not([data-wired])",
        )) {
            root.dataset.wired = "true"
            const tabs = [...root.querySelectorAll<HTMLElement>(".tab")]
            const body = root.querySelector<HTMLElement>(".body")!
            const still = matchMedia("(prefers-reduced-motion: reduce)").matches
            let auto = !still
            let inView = false
            let started = false
            let waiting: number | null = null
            let timer: number | null = null

            const stop = () => {
                if (timer !== null) clearTimeout(timer)
                timer = null
            }
            document.addEventListener("astro:before-swap", stop, {
                once: true,
            })

            const open = (idx: number) => {
                stop()
                tabs.forEach((tab, i) => {
                    tab.classList.toggle("active", i === idx)
                    tab.classList.toggle("timed", auto && i === idx)
                    tab.style.setProperty("--dur", `${STEP_MS}ms`)
                    tab.setAttribute("aria-selected", String(i === idx))
                    tab.tabIndex = i === idx ? 0 : -1
                })
                body.dataset.at = String(idx)
                body.setAttribute("aria-labelledby", tabs[idx].id)
                body.classList.remove("enter")
                void body.offsetWidth
                body.classList.add("enter")
                if (auto)
                    timer = window.setTimeout(() => {
                        const next = (idx + 1) % tabs.length
                        if (inView) open(next)
                        else waiting = next
                    }, STEP_MS)
            }

            tabs.forEach((tab, idx) => {
                tab.addEventListener("click", () => {
                    auto = false
                    open(idx)
                })
                tab.addEventListener("keydown", (e) => {
                    const n = tabs.length
                    const moves: Record<string, number> = {
                        ArrowRight: (idx + 1) % n,
                        ArrowLeft: (idx - 1 + n) % n,
                        Home: 0,
                        End: n - 1,
                    }
                    const next = moves[e.key]
                    if (next === undefined) return
                    e.preventDefault()
                    auto = false
                    tabs[next].focus()
                    open(next)
                })
            })

            new IntersectionObserver(
                ([entry]) => {
                    inView = entry.isIntersecting
                    if (!inView) return
                    if (!started) {
                        started = true
                        open(0)
                    } else if (waiting !== null) {
                        const next = waiting
                        waiting = null
                        open(next)
                    }
                },
                { threshold: 0.35 },
            ).observe(body)
        }
    }

    document.addEventListener("astro:page-load", wirePlatformHow)
    wirePlatformHow()
</script>

<style lang="scss">
    @use "/src/components/enterprise/mocks/tokens" as *;

    .grid {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);
        --tint: #8405ff;

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);

        @include media-breakpoint-down(xl) {
            border-inline: 0;
        }

        :global(html.dark) & {
            --tint: #9869f7;
        }

        > .tabs,
        > .body {
            position: relative;
            border-top: var(--rule);

            &::before {
                content: "";
                position: absolute;
                top: -1px;
                left: -100vw;
                right: -100vw;
                height: 1px;
                background: var(--ks-border-primary);
                pointer-events: none;
            }
        }

        > .body {
            border-bottom: var(--rule);

            &::after {
                content: "";
                position: absolute;
                bottom: -1px;
                left: -100vw;
                right: -100vw;
                height: 1px;
                background: var(--ks-border-primary);
                pointer-events: none;
            }
        }
    }

    .head {
        padding: 7.5rem var(--inset) 4rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--ks-content-primary);
        }
    }

    .tabs {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        border-bottom: var(--rule);

        @include media-breakpoint-down(lg) {
            display: flex;
            overflow-x: auto;
            scrollbar-width: none;
        }
    }

    .tab {
        position: relative;
        display: flex;
        flex: none;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        padding: 1.375rem 1rem;
        border: 0;
        background: var(--ks-background-body);
        font-size: 1.0625rem;
        font-weight: 500;
        white-space: nowrap;
        color: var(--ks-content-primary);
        cursor: pointer;
        transition: background-color 0.3s ease;

        & + & {
            border-left: var(--rule);
        }

        @include media-breakpoint-down(lg) {
            padding-inline: 1.25rem;
        }

        &:hover {
            background: color-mix(
                in srgb,
                var(--tint) 4%,
                var(--ks-background-body)
            );
        }

        &:focus-visible {
            outline: 2px solid var(--ks-border-active);
            outline-offset: -2px;
        }

        &.active {
            cursor: default;
        }

        &::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 2px;
            background: var(--tint);
            opacity: 0;
            transform-origin: left;
            transition: opacity 0.2s ease;
        }

        &.active::after {
            opacity: 1;
        }

        &.timed::after {
            animation: tab-time var(--dur) linear forwards;
        }
    }

    .swatch {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 2px;
        background: var(--ks-content-tertiary);
        opacity: 0.5;
        transition:
            background-color 0.3s ease,
            opacity 0.3s ease;

        .active > & {
            background: var(--tint);
            opacity: 1;
        }
    }

    @keyframes tab-time {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }

    .body {
        @include tokens;

        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
        align-items: center;
        gap: 3rem;
        min-height: max(28rem, min(32rem, calc(100vh - 14rem)));
        padding: var(--inset);
        overflow: hidden;
        background: var(--ks-background-body);

        @include media-breakpoint-down(xl) {
            grid-template-columns: minmax(0, 1fr);
            align-content: start;
            gap: 2rem;
        }

        @include media-breakpoint-down(lg) {
            min-height: 0;
            padding: 2rem 1.25rem 3rem;
        }
    }

    .pixels {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        width: 96px;
        aspect-ratio: 194 / 168;
        background: var(--tint);
        mask: var(--pixels) no-repeat center / contain;
        opacity: 0.3;
        pointer-events: none;

        @include media-breakpoint-down(lg) {
            width: 64px;
        }
    }

    .copies,
    .views {
        position: relative;
        display: grid;
    }

    .views {
        place-items: center;
    }

    .copy {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        visibility: hidden;
        opacity: 0;
        transform: translateY(0.75rem);
        transition:
            opacity 0.4s ease,
            transform 0.4s ease,
            visibility 0s linear 0.4s;

        @include media-breakpoint-down(lg) {
            display: none;
        }

        h3 {
            margin: 0 0 1rem;
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            line-height: 1.2;
            color: var(--ks-content-primary);
        }

        p {
            margin: 0;
            font-size: 1.0625rem;
            line-height: 1.65;
            color: var(--ks-content-secondary);
        }

        a {
            margin-top: 1.75rem;
        }
    }

    .view {
        grid-area: 1 / 1;
        width: min(100%, 40rem);
        visibility: hidden;
        opacity: 0;
        transform: translateY(0.75rem);
        transition:
            opacity 0.4s ease,
            transform 0.4s ease,
            visibility 0s linear 0.4s;

        &.nocode {
            width: min(100%, 52rem);
        }
    }

    @for $i from 0 through 4 {
        .body[data-at="#{$i}"] .view[data-view="#{$i}"] {
            visibility: visible;
            opacity: 1;
            transform: none;
            transition:
                opacity 0.4s ease 0.1s,
                transform 0.4s ease 0.1s,
                visibility 0s;
        }

        .body[data-at="#{$i}"] .copy[data-copy="#{$i}"] {
            display: flex;
            visibility: visible;
            opacity: 1;
            transform: none;
            transition:
                opacity 0.4s ease,
                transform 0.4s ease,
                visibility 0s;
        }
    }

    .body.enter :global(.line) {
        animation: line-in 0.35s ease both;
    }

    @for $n from 1 through 12 {
        .body.enter :global(.line:nth-child(#{$n})) {
            animation-delay: #{0.1 + $n * 0.04}s;
        }
    }

    .body.enter [style*="--k"] {
        animation: pop-in 0.4s ease both;
        animation-delay: calc(0.15s + var(--k) * 0.05s);
    }

    @keyframes line-in {
        from {
            opacity: 0;
            transform: translateX(-0.5rem);
        }
    }

    @keyframes pop-in {
        from {
            opacity: 0;
            transform: translateY(0.5rem) scale(0.96);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .body.enter :global(.line),
        .body.enter [style*="--k"] {
            animation: none;
        }
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.625rem;

        li {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.875rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--panel);
            box-shadow: var(--shadow);
            font-size: $font-size-sm;
            font-weight: 600;
            color: var(--soft);

            &.accent {
                border-color: var(--ring);
                color: var(--text);
            }
        }

        .more-chip {
            border-style: dashed;
            box-shadow: none;
            color: var(--run);
        }
    }

    .logo {
        display: inline-flex;
        width: 1.25rem;
        height: 1.25rem;

        :global(svg) {
            width: 100%;
            height: 100%;
        }
    }

    .triggers {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;

        @include media-breakpoint-down(sm) {
            grid-template-columns: 1fr;
        }

        li {
            display: flex;
            flex-direction: column;
            gap: 0.375rem;
            padding: 1.25rem;
            border: 1px solid var(--line);
            border-radius: 0.875rem;
            background: var(--panel);
            box-shadow: var(--shadow);

            > svg {
                width: 1.5rem;
                height: 1.5rem;
                margin-bottom: 0.25rem;
                color: var(--run);
            }
        }

        b {
            font-family: $font-family-monospace;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text);
        }

        span {
            font-size: $font-size-sm;
            color: var(--soft);
        }
    }

    .nocode {
        display: grid;
        grid-template-columns: minmax(0, 0.75fr) auto minmax(0, 1.5fr);
        gap: 1rem;
        align-items: center;

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .nodes {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .pane-label {
        margin: 0 0 0.5rem;
        font-family: $font-family-monospace;
        font-size: 0.75rem;
        color: var(--muted);
    }

    .node {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        padding: 0.875rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.625rem;
        background: var(--panel);
        box-shadow: var(--shadow);

        > svg {
            flex: none;
            width: 2rem;
            height: 2rem;
            padding: 0.375rem;
            border-radius: 0.5rem;
            background: var(--tile);
            color: var(--tile-ink);
        }

        div {
            display: flex;
            flex-direction: column;
        }

        b {
            font-size: $font-size-sm;
            color: var(--text);
        }

        span {
            font-family: $font-family-monospace;
            font-size: 0.75rem;
            color: var(--muted);
        }
    }

    .down {
        color: var(--muted);
    }

    .sync {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background: var(--tile);
        color: var(--tile-ink);
        font-size: 1.25rem;

        @include media-breakpoint-down(md) {
            margin-inline: auto;
            transform: rotate(90deg);
        }
    }

    .exec-card {
        padding: 1.5rem;
        border: 1px solid var(--line);
        border-radius: 0.875rem;
        background: var(--panel);
        box-shadow: var(--shadow);
    }

    .exec {
        margin: 0 0 1.25rem;
        font-family: $font-family-monospace;
        font-size: 0.75rem;
        color: var(--muted);

        .bad {
            color: #e5484d;
        }
    }

    .gantt {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;

        li {
