---
import { Icon } from "astro-icon/components"
import { fetchPluginIcon } from "~/utils/pluginIcon"
import CodeCard from "./CodeCard.astro"
import TopologyNode from "~/components/home/TopologyNode.astro"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"

const STEPS = [
    {
        tab: "Flows",
        title: "Flows define your work",
        dur: 13000,
        text: "A YAML file with an id, a namespace, and tasks. Reviewed and versioned like code.",
        link: {
            href: "/docs/workflow-components/flow",
            label: "Learn more about flows",
        },
    },
    {
        tab: "Plugins",
        title: "Plugins connect your systems",
        text: "Native connectivity to thousands of services like Terraform, Postgres, ServiceNow, and others.",
        link: {
            href: "/docs/workflow-components/plugins",
            label: "Learn more about plugins",
        },
    },
    {
        tab: "Triggers",
        title: "Triggers start flows",
        dur: 12000,
        text: "Start a flow on a schedule, a webhook, another flow’s result, or a poll.",
        link: {
            href: "/docs/workflow-components/triggers",
            label: "Learn more about triggers",
        },
    },
    {
        tab: "No-code",
        title: "Write flows with no code",
        text: "Don’t like to code? Author flows in the no-code editor. Edits are interchangeable with YAML, so both views stay in sync.",
    },
    {
        tab: "Observability",
        title: "Execution with insight",
        text: "Each execution retains its logs, outputs, and timing, so “what happened?” always has an answer. Metrics and alerts feed the tools you already monitor.",
        link: {
            href: "/docs/administrator-guide/monitoring",
            label: "Learn more about monitoring",
        },
    },
]

const FLOW = `id: etl_orders
namespace: company.team
tasks:
  - id: extract
    type: io.kestra.plugin.core.http.Download
    uri: https://api.example.com/orders.csv
  - id: transform
    type: io.kestra.plugin.scripts.python.Script
    script: clean_orders("{{ outputs.extract.uri }}")
  - id: load
    type: io.kestra.plugin.jdbc.postgresql.Query`

const SUGGEST = [
    {
        line: 5,
        after: "core.http.",
        pick: 0,
        options: [
            { label: "Download", kind: "Task" },
            { label: "Request", kind: "Task" },
            { label: "Trigger", kind: "Trigger" },
        ],
    },
    {
        line: 8,
        after: "plugin.scripts.",
        pick: 2,
        options: [
            { label: "node.Script", kind: "Task" },
            { label: "python.Commands", kind: "Task" },
            { label: "python.Script", kind: "Task" },
            { label: "shell.Commands", kind: "Task" },
        ],
    },
    {
        line: 11,
        after: "plugin.jdbc.",
        pick: 2,
        options: [
            { label: "mysql.Query", kind: "Task" },
            { label: "postgresql.Queries", kind: "Task" },
            { label: "postgresql.Query", kind: "Task" },
            { label: "snowflake.Query", kind: "Task" },
        ],
    },
]

const NO_CODE = `triggers:
  - id: daily
    type: io.kestra.plugin.core.trigger.Schedule
    cron: "0 9 * * *"
tasks:
  - id: hello
    type: io.kestra.plugin.core.log.Log
    message: Hello from Kestra`

const PLUGIN_ROWS = [
    [
        ["Terraform", "terraform"],
        ["Ansible", "ansible"],
        ["Kubernetes", "kubernetes"],
        ["Docker", "docker"],
        ["AWS", "aws"],
        ["Azure", "azure"],
        ["Google Cloud", "gcp"],
        ["GitHub", "github"],
        ["GitLab", "gitlab"],
        ["Argo CD", "argocd"],
        ["Databricks", "databricks"],
        ["Spark", "spark"],
    ],
    [
        ["PostgreSQL", "jdbc.postgresql"],
        ["Snowflake", "jdbc.snowflake"],
        ["MySQL", "jdbc.mysql"],
        ["MongoDB", "mongodb"],
        ["Elasticsearch", "elasticsearch"],
        ["Redis", "redis"],
        ["ClickHouse", "jdbc.clickhouse"],
        ["DuckDB", "jdbc.duckdb"],
        ["dbt", "dbt"],
        ["Airbyte", "airbyte"],
        ["Fivetran", "fivetran"],
        ["Kafka", "kafka"],
    ],
    [
        ["Slack", "notifications.slack"],
        ["Microsoft Teams", "notifications.teams"],
        ["PagerDuty", "notifications.pagerduty"],
        ["Jira", "jira"],
        ["ServiceNow", "servicenow"],
        ["HubSpot", "hubspot"],
        ["Zendesk", "zendesk"],
        ["Notion", "notion"],
        ["OpenAI", "openai"],
        ["Hugging Face", "huggingface"],
        ["Python", "scripts.python"],
        ["Node.js", "scripts.node"],
    ],
]

const ROWS = await Promise.all(
    PLUGIN_ROWS.map(async (row) =>
        (
            await Promise.all(
                row.map(async ([name, group]) => ({
                    name,
                    icon: await fetchPluginIcon(
                        `io.kestra.plugin.${group}`,
                    ).catch(() => null),
                })),
            )
        ).filter((plugin) => plugin.icon),
    ),
)

const totalPlugins = await fetchTotalPluginsCount()

const TRIGGERS = [
    {
        id: "daily",
        plugin: "core.trigger.Schedule",
        text: "Cron-like timing, with backfills for missed intervals.",
        fallback: "mdi:clock-outline",
    },
    {
        id: "on_order",
        plugin: "core.trigger.Webhook",
        text: "An HTTP call starts a run.",
        fallback: "mdi:webhook",
    },
    {
        id: "after_extract",
        plugin: "core.trigger.Flow",
        text: "Run when another flow finishes or fails.",
        fallback: "mdi:source-branch",
    },
    {
        id: "new_files",
        plugin: "aws.s3.Trigger",
        text: "Check a file, queue, or table at intervals.",
        fallback: "mdi:refresh",
    },
]

const iconSrc = (plugin: string) =>
    fetchPluginIcon(`io.kestra.plugin.${plugin}`)
        .then(
            (svg) =>
                `data:image/svg+xml;base64,${Buffer.from(svg).toString("base64")}`,
        )
        .catch(() => null)

const triggerIcons = await Promise.all(
    TRIGGERS.map((trigger) => iconSrc(trigger.plugin)),
)
const flowIcon = await iconSrc("core.flow.Subflow")

const NODE_W = 260
const NODE_H = 76
const TRIGGER_H = 60
const PAD = 14
const STEP_Y = TRIGGER_H + PAD
const TOP = 36
const FLOW_X = 380
const GROUP_H = TOP + TRIGGERS.length * STEP_Y
const FLOW_Y = TOP + (TRIGGER_H - NODE_H) / 2
const RUNS_Y = FLOW_Y + NODE_H + 40
const CANVAS_W = FLOW_X + NODE_W
const CANVAS_H = Math.max(GROUP_H, RUNS_Y + 195)

const EDGE_X = PAD + NODE_W + 3
const BUS_X = (EDGE_X + FLOW_X) / 2
const FLOW_MID = FLOW_Y + NODE_H / 2
const triggerMid = (idx: number) => TOP + idx * STEP_Y + TRIGGER_H / 2

const GROUP_R = NODE_W + 2 * PAD

const elbow = (y1: number, x0 = EDGE_X) => {
    const dy = Math.sign(FLOW_MID - y1)
    const r = Math.min(8, Math.abs(FLOW_MID - y1) / 2)
    if (!dy) return `M${x0} ${y1} H${FLOW_X - 2}`
    return `M${x0} ${y1} H${BUS_X - r} Q${BUS_X} ${y1} ${BUS_X} ${y1 + dy * r} V${FLOW_MID - dy * r} Q${BUS_X} ${FLOW_MID} ${BUS_X + r} ${FLOW_MID} H${FLOW_X - 2}`
}

const STUBS = TRIGGERS.map(
    (_, idx) => `M${EDGE_X} ${triggerMid(idx)} H${BUS_X}`,
)
const BUS = `M${BUS_X} ${Math.min(triggerMid(0), FLOW_MID)} V${Math.max(triggerMid(TRIGGERS.length - 1), FLOW_MID)}`
const TRUNK = `M${BUS_X} ${FLOW_MID} H${FLOW_X - 2}`
const TRACES = TRIGGERS.map((_, idx) => ({
    line: elbow(triggerMid(idx)),
    inside: `M${EDGE_X} ${triggerMid(idx)} H${GROUP_R}`,
    outside: elbow(triggerMid(idx), GROUP_R),
}))

const RUNS = [
    { trigger: 0, time: "09:00:00.214" },
    { trigger: 3, time: "08:55:00.087" },
    { trigger: 2, time: "08:41:12.540" },
    { trigger: 1, time: "08:37:05.931" },
]

const SIGNALS = [
    { name: "Execution logs" },
    { name: "Timeline and topology" },
    { name: "Metrics and traces" },
    { name: "Alerts" },
    { name: "Audit logs", enterprise: true },
    { name: "Log export", enterprise: true },
]

const GANTT = [
    { task: "extract", start: 0, width: 28, time: "2.1s" },
    { task: "transform", start: 28, width: 52, time: "6.4s" },
    { task: "load #1", start: 80, width: 12, time: "fail", status: "bad" },
    { task: "load #2", start: 84, width: 14, time: "retry", status: "run" },
]
---

<section class="how" id="how" aria-labelledby="how-h" data-platform-how>
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="how-h">How it works</h2>
            </header>

            <div class="tabs" role="tablist" aria-label="How it works">
                {STEPS.map((step, idx) => (
                    <button
                        type="button"
                        role="tab"
                        class:list={["tab", { active: idx === 0 }]}
                        id={`how-tab-${idx}`}
                        aria-selected={idx === 0 ? "true" : "false"}
                        aria-controls="how-panel"
                        tabindex={idx === 0 ? 0 : -1}
                        data-dur={step.dur}
                    >
                        <span class="swatch" aria-hidden="true" />
                        {step.tab}
                    </button>
                ))}
            </div>

            <div
                class="body"
                id="how-panel"
                role="tabpanel"
                aria-labelledby="how-tab-0"
                data-at="0"
                style={`--pixels: url("${pixelCluster}")`}
            >
                <span class="pixels" aria-hidden="true" />
                <div class="copies">
                    {STEPS.map((step, idx) => (
                        <div class="copy" data-copy={idx}>
                            <h3>{step.title}</h3>
                            <p>{step.text}</p>
                            {step.link && (
                                <a
                                    href={step.link.href}
                                    class="btn-ghost compact"
                                >
                                    {step.link.label}
                                </a>
                            )}
                        </div>
                    ))}
                </div>

                <div class="views">
                    <div class="view typed" data-view="0">
                        <div
                            class="typer"
                            data-typer
                            data-suggest={JSON.stringify(SUGGEST)}
                        >
                            <CodeCard
                                file="company.team / etl_orders.yml"
                                code={FLOW}
                            />
                            <div class="suggest" aria-hidden="true">
                                <ul></ul>
                            </div>
                        </div>
                    </div>

                    <div class="view wide" data-view="1">
                        <div class="plugins">
                            <div class="marquee">
                                {ROWS.map((row) => (
                                    <div class="row">
                                        <ul class="track">
                                            {[...row, ...row].map(
                                                (plugin, idx) => (
                                                    <li
                                                        aria-hidden={
                                                            idx >= row.length
                                                                ? "true"
                                                                : undefined
                                                        }
                                                    >
                                                        <span
                                                            class="tile"
                                                            title={plugin.name}
                                                            set:html={
                                                                plugin.icon
                                                            }
                                                        />
                                                    </li>
                                                ),
                                            )}
                                        </ul>
                                    </div>
                                ))}
                            </div>
                            <a class="count" href="/plugins">
                                {totalPlugins}+ plugins
                            </a>
                        </div>
                    </div>

                    <div class="view wide" data-view="2">
                        <div class="fire" data-fire>
                            <div
                                class="canvas"
                                style={`width: ${CANVAS_W}px; height: ${CANVAS_H}px`}
                            >
                                <div
                                    class="group"
                                    style={`height: ${GROUP_H}px`}
                                    aria-hidden="true"
                                >
                                    <span class="group-label">trigger</span>
                                </div>
                                <svg
                                    class="edges"
                                    viewBox={`0 0 ${CANVAS_W} ${CANVAS_H}`}
                                    aria-hidden="true"
                                >
                                    <defs>
                                        <marker
                                            id="how-arrow"
                                            viewBox="0 0 10 10"
                                            refX="9"
                                            refY="5"
                                            markerWidth="6"
                                            markerHeight="6"
                                            markerUnits="userSpaceOnUse"
                                            orient="auto"
                                        >
                                            <path
                                                d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z"
                                                class="arrow"
                                            />
                                        </marker>
                                        <marker
                                            id="how-arrow-run"
                                            viewBox="0 0 10 10"
                                            refX="9"
                                            refY="5"
                                            markerWidth="6"
                                            markerHeight="6"
                                            markerUnits="userSpaceOnUse"
                                            orient="auto"
                                        >
                                            <path
                                                d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z"
                                                class="arrow run"
                                            />
                                        </marker>
                                        <marker
                                            id="how-arrow-done"
                                            viewBox="0 0 10 10"
                                            refX="9"
                                            refY="5"
                                            markerWidth="6"
                                            markerHeight="6"
                                            markerUnits="userSpaceOnUse"
                                            orient="auto"
                                        >
                                            <path
                                                d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z"
                                                class="arrow done"
                                            />
                                        </marker>
                                        <marker
                                            id="how-dot"
                                            viewBox="0 0 6 6"
                                            refX="3"
                                            refY="3"
                                            markerWidth="5"
                                            markerHeight="5"
                                            markerUnits="userSpaceOnUse"
                                        >
                                            <circle
                                                cx="3"
                                                cy="3"
                                                r="3"
                                                class="arrow"
                                            />
                                        </marker>
                                    </defs>
                                    {STUBS.map((d) => (
                                        <path class="edge stub" d={d} />
                                    ))}
                                    <path class="edge" d={BUS} />
                                    <path class="edge trunk" d={TRUNK} />
                                    {TRACES.map((trace) => (
                                        <g class="trace">
                                            <path
                                                class="mask inside"
                                                d={trace.inside}
                                            />
                                            <path
                                                class="mask"
                                                d={trace.outside}
                                            />
                                            <path class="line" d={trace.line} />
                                        </g>
                                    ))}
                                </svg>
                                {TRIGGERS.map((trigger, idx) => (
                                    <TopologyNode
                                        id={trigger.id}
                                        type={trigger.plugin}
                                        icon={triggerIcons[idx]}
                                        fallback={trigger.fallback}
                                        status="created"
                                        duration="0.2s"
                                        style={`position: absolute; left: ${PAD}px; top: ${TOP + idx * STEP_Y}px; height: ${TRIGGER_H}px`}
                                        data-trigger={idx}
                                    >
                                        <button
                                            slot="action"
                                            type="button"
                                            class="hint"
                                            aria-label={trigger.text}
                                        >
                                            <Icon name="mdi:information-outline" />
                                            <span
                                                class="tip"
                                                aria-hidden="true"
                                            >
                                                {trigger.text}
                                            </span>
                                        </button>
                                    </TopologyNode>
                                ))}
                                <TopologyNode
                                    id="etl_orders"
                                    type="company.team"
                                    icon={flowIcon}
                                    fallback="mdi:sitemap-outline"
                                    status="success"
                                    duration="4.1s"
                                    style={`position: absolute; left: ${FLOW_X}px; top: ${FLOW_Y}px`}
                                    data-flow
                                />
                                <div
                                    class="runs"
                                    style={`left: ${FLOW_X}px; top: ${RUNS_Y}px; width: ${NODE_W}px`}
                                >
                                    <p class="runs-head">
                                        <Icon name="mdi:play-outline" />
                                        Executions
                                    </p>
                                    <ul>
                                        {RUNS.map((run) => (
                                            <li>
                                                <span class="runs-icon">
                                                    {triggerIcons[
                                                        run.trigger
                                                    ] ? (
                                                        <img
                                                            src={
                                                                triggerIcons[
                                                                    run.trigger
                                                                ]
                                                            }
                                                            alt=""
                                                        />
                                                    ) : (
                                                        <Icon
                                                            name={
                                                                TRIGGERS[
                                                                    run.trigger
                                                                ].fallback
                                                            }
                                                        />
                                                    )}
                                                </span>
                                                <code>{run.time}</code>
                                                <span class="runs-state">
                                                    <Icon
                                                        name="mdi:check-circle-outline"
                                                        class="done"
                                                    />
                                                    <Icon
                                                        name="mdi:loading"
                                                        class="spin"
                                                    />
                                                </span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="view nocode" data-view="3">
                        <div class="nodes">
                            <p class="pane-label">No-code</p>
                            <div class="node">
                                <Icon name="mdi:clock-outline" />
                                <div>
                                    <b>Trigger · Schedule</b>
                                    <span>every day at 09:00</span>
                                </div>
                            </div>
                            <span class="down" aria-hidden="true">
                                ↓
                            </span>
                            <div class="node">
                                <Icon name="mdi:play" />
                                <div>
                                    <b>Task · Log</b>
                                    <span>message: Hello from Kestra</span>
                                </div>
                            </div>
                        </div>
                        <span class="sync" aria-hidden="true">
                            <Icon name="mdi:swap-horizontal" />
                        </span>
                        <CodeCard file="YAML" code={NO_CODE} />
                    </div>

                    <div class="view" data-view="4">
                        <div class="exec-card">
                            <p class="exec">
                                EXECUTION 4f2a… · etl_orders ·{" "}
                                <span class="bad">FAILED</span> → restarted
                            </p>
                            <ul class="gantt">
                                {GANTT.map((row, idx) => (
                                    <li style={`--k: ${idx}`}>
                                        <span>{row.task}</span>
                                        <span class="track">
                                            <em
                                                class={row.status}
                                                style={`left: ${row.start}%; width: ${row.width}%`}
                                            />
                                        </span>
                                        <span>{row.time}</span>
                                    </li>
                                ))}
                            </ul>
                            <ul class="chips signals">
                                {SIGNALS.map((signal) => (
                                    <li>
                                        {signal.name}
                                        {signal.enterprise && (
                                            <span class="tag">ENT</span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const STEP_MS = 7000
    const TYPE_MS = 22
    const LINE_MS = 90

    interface Hint {
        line: number
        after: string
        pick: number
        options: { label: string; kind: string }[]
    }

    const wait = (ms: number) =>
        new Promise((resolve) => setTimeout(resolve, ms))

    function makeTyper(box: HTMLElement) {
        const pop = box.querySelector<HTMLElement>(".suggest")!
        const list = pop.querySelector("ul")!
        const hints = JSON.parse(box.dataset.suggest!) as Hint[]
        const rows = [...box.querySelectorAll<HTMLElement>(".line")].map(
            (line) => {
                const txt = document.createElement("span")
                txt.className = "txt"
                const nodes = [...line.childNodes].slice(1)
                if (nodes.at(-1)?.textContent === "\n") nodes.pop()!.remove()
                for (const node of nodes) txt.appendChild(node)
                line.appendChild(txt)
                return { line, txt, text: txt.textContent ?? "" }
            },
        )
        let token = 0

        const fill = (hint: Hint, active: number) => {
            list.replaceChildren()
            hint.options.forEach((option, i) => {
                const item = document.createElement("li")
                item.classList.toggle("on", i === active)
                const label = document.createElement("b")
                label.textContent = option.label
                const kind = document.createElement("span")
                kind.textContent = option.kind
                item.appendChild(label)
                item.appendChild(kind)
                list.appendChild(item)
            })
        }

        const place = (txt: HTMLElement) => {
            const base = box.getBoundingClientRect()
            const caret = txt.getBoundingClientRect()
            const left = Math.min(
                caret.right - base.left,
                base.width - pop.offsetWidth - 8,
            )
            const below = caret.bottom - base.top + 4
            const top =
                below + pop.offsetHeight > base.height
                    ? caret.top - base.top - pop.offsetHeight - 4
                    : below
            pop.style.transform = `translate(${Math.max(8, left)}px, ${top}px)`
        }

        const suggest = async (hint: Hint, txt: HTMLElement, id: number) => {
            fill(hint, 0)
            place(txt)
            pop.classList.add("open")
            await wait(550)
            for (let i = 1; i <= hint.pick && id === token; i++) {
                fill(hint, i)
                await wait(260)
            }
            await wait(450)
            pop.classList.remove("open")
        }

        const reset = () => {
            pop.classList.remove("open")
            for (const row of rows) {
                row.txt.style.width = ""
                row.line.classList.remove("seen", "typing")
            }
        }

        const run = async () => {
            const id = ++token
            reset()
            for (const row of rows) row.txt.style.width = "0ch"
            box.classList.add("running")
            for (const [i, row] of rows.entries()) {
                row.line.classList.add("seen", "typing")
                row.txt.style.width = "0ch"
                const hint = hints.find((h) => h.line === i + 1)
                const stop = hint
                    ? row.text.indexOf(hint.after) + hint.after.length
                    : -1
                for (let c = 1; c <= row.text.length; c++) {
                    row.txt.style.width = `${c}ch`
                    if (hint && c === stop) {
                        await suggest(hint, row.txt, id)
                        if (id !== token) return
                        row.txt.style.width = `${row.text.length}ch`
                        break
                    }
                    await wait(TYPE_MS)
                    if (id !== token) return
                }
                await wait(LINE_MS)
                if (id !== token) return
                if (i < rows.length - 1) row.line.classList.remove("typing")
            }
        }

        const stop = () => {
            token++
            reset()
            box.classList.remove("running")
        }

        const view = Number(
            box.closest<HTMLElement>("[data-view]")!.dataset.view,
        )
        return { run, stop, view }
    }

    const FIRES = [1, 0, 3, 1, 2, 3, 1, 0]
    const GAPS = [
        74.318, 31.062, 112.745, 9.481, 46.207, 63.926, 18.153, 95.604,
    ]
    const TOOK = ["4.1s", "3.8s", "5.2s", "2.9s"]
    const FIRE_MS = 2600
    const ROW_H = 40

    const setStatus = (node: Element, status: string) => {
        node.classList.remove("is-created", "is-running", "is-success")
        node.classList.add(`is-${status}`)
    }

    function makeFirer(box: HTMLElement) {
        const triggers = [
            ...box.querySelectorAll<HTMLElement>("[data-trigger]"),
        ]
        const edges = [...box.querySelectorAll<SVGGElement>(".trace")]
        const flow = box.querySelector<HTMLElement>("[data-flow]")!
        const took = [
            ...flow.querySelector(".pill.state")!.childNodes,
        ].findLast(
            (node) =>
                node.nodeType === Node.TEXT_NODE && node.textContent?.trim(),
        )!
        const initial = took.textContent
        const list = box.querySelector<HTMLElement>(".runs ul")!
        const template = list.firstElementChild!.cloneNode(true) as HTMLElement
        const seed = [...list.children].map((row) => row.cloneNode(true))
        const view = Number(
            box.closest<HTMLElement>("[data-view]")!.dataset.view,
        )
        let token = 0

        const clock = (seconds: number) => {
            const ms = Math.round(seconds * 1000)
            const pad = (value: number, size = 2) =>
                String(value).padStart(size, "0")
            return `${pad(Math.floor(ms / 3600000))}:${pad(Math.floor(ms / 60000) % 60)}:${pad(Math.floor(ms / 1000) % 60)}.${pad(ms % 1000, 3)}`
        }

        const fire = async (src: number, n: number, at: number, id: number) => {
            setStatus(triggers[src], "running")
            edges[src].classList.add("active")
            await wait(600)
            if (id !== token) return
            setStatus(triggers[src], "created")
            edges[src].classList.replace("active", "done")
            setStatus(flow, "running")
            const row = template.cloneNode(true) as HTMLElement
            row.classList.add("running")
            const icon =
                triggers[src].querySelector(".icon")!.firstElementChild!
            row.querySelector(".runs-icon")!.replaceChildren(
                icon.cloneNode(true),
            )
            row.querySelector("code")!.textContent = clock(at)
            list.style.transition = "none"
            list.style.transform = `translateY(${-ROW_H}px)`
            list.insertBefore(row, list.firstChild)
            void list.offsetHeight
            list.style.transition = ""
            list.style.transform = ""
            await wait(1100)
            if (id !== token) return
            took.textContent = TOOK[n % TOOK.length]
            setStatus(flow, "success")
            edges[src].classList.remove("done")
            row.classList.remove("running")
            while (list.children.length > 4) list.lastElementChild!.remove()
        }

        const reset = () => {
            list.style.transform = ""
            list.replaceChildren()
            for (const row of seed) list.appendChild(row.cloneNode(true))
            for (const trigger of triggers) setStatus(trigger, "created")
            for (const edge of edges) edge.classList.remove("active", "done")
            setStatus(flow, "success")
            took.textContent = initial
        }

        const run = async () => {
            const id = ++token
            reset()
            let at = 9 * 3600 + 2 * 60 + 14.104
            for (let n = 0; id === token; n++) {
                const i = n % FIRES.length
                void fire(FIRES[i], n, at, id)
                at += GAPS[i]
                await wait(FIRE_MS)
            }
        }

        const stop = () => {
            token++
            reset()
        }

        return { run, stop, view }
    }

    function wirePlatformHow() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-platform-how]:not([data-wired])",
        )) {
            root.dataset.wired = "true"
            const tabs = [
                ...root.querySelectorAll<HTMLElement>(".tabs > [role=tab]"),
            ]
            const body = root.querySelector<HTMLElement>(".body")!
            const still = matchMedia("(prefers-reduced-motion: reduce)").matches
            const typerBox = root.querySelector<HTMLElement>("[data-typer]")
            const firerBox = root.querySelector<HTMLElement>("[data-fire]")
            if (firerBox) {
                const canvas = firerBox.querySelector<HTMLElement>(".canvas")!
                const width = canvas.offsetWidth
                new ResizeObserver(([entry]) => {
                    const scale = Math.min(1, entry.contentRect.width / width)
                    canvas.style.zoom = String(scale)
                }).observe(firerBox)
            }
            const players = still
                ? []
                : [
                      typerBox && makeTyper(typerBox),
                      firerBox && makeFirer(firerBox),
                  ].filter((player) => player !== null)
            let auto = !still
            let inView = false
            let started = false
            let waiting: number | null = null
            let timer: number | null = null

            const stop = () => {
                if (timer !== null) clearTimeout(timer)
                timer = null
            }
            document.addEventListener("astro:before-swap", stop, {
                once: true,
            })

            const open = (idx: number) => {
                stop()
                tabs.forEach((tab, i) => {
                    tab.classList.toggle("active", i === idx)
                    tab.classList.toggle("timed", auto && i === idx)
                    tab.style.setProperty(
                        "--dur",
                        `${Number(tab.dataset.dur) || STEP_MS}ms`,
                    )
                    tab.setAttribute("aria-selected", String(i === idx))
                    tab.tabIndex = i === idx ? 0 : -1
                })
                body.dataset.at = String(idx)
                body.setAttribute("aria-labelledby", tabs[idx].id)
                body.classList.remove("enter")
                void body.offsetWidth
                body.classList.add("enter")
                for (const player of players) {
                    if (idx === player.view) player.run()
                    else player.stop()
                }
                if (auto)
                    timer = window.setTimeout(
                        () => {
                            const next = (idx + 1) % tabs.length
                            if (inView) open(next)
                            else waiting = next
                        },
                        Number(tabs[idx].dataset.dur) || STEP_MS,
                    )
            }

            const takeOver = () => {
                auto = false
                stop()
                tabs.forEach((tab) => tab.classList.remove("timed"))
            }
            root.addEventListener("pointerdown", takeOver)
            root.addEventListener("focusin", takeOver)

            tabs.forEach((tab, idx) => {
                tab.addEventListener("click", () => open(idx))
                tab.addEventListener("keydown", (e) => {
                    const n = tabs.length
                    const moves: Record<string, number> = {
                        ArrowRight: (idx + 1) % n,
                        ArrowLeft: (idx - 1 + n) % n,
                        Home: 0,
                        End: n - 1,
                    }
                    const next = moves[e.key]
                    if (next === undefined) return
                    e.preventDefault()
                    tabs[next].focus()
                    open(next)
                })
            })

            new IntersectionObserver(
                ([entry]) => {
                    inView = entry.isIntersecting
                    if (!inView) return
                    if (!started) {
                        started = true
                        open(0)
                    } else if (waiting !== null) {
                        const next = waiting
                        waiting = null
                        open(next)
                    }
                },
                { threshold: 0.35 },
            ).observe(body)
        }
    }

    document.addEventListener("astro:page-load", wirePlatformHow)
    wirePlatformHow()
</script>

