---
interface Props {
    file: string
    code: string
    marks?: Record<string, [number, number]>
    dots?: boolean
    dark?: boolean
    class?: string
}

const { file, code, marks = {}, dots = false, dark = false } = Astro.props

const escape = (text: string) =>
    text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")

const markAt = (row: number) =>
    Object.entries(marks).find(
        ([, [from, to]]) => row + 1 >= from && row + 1 <= to,
    )?.[0]

let block = -1
const HTML = code
    .split("\n")
    .map((text, row) => {
        const indent = text.match(/^\s*/)?.[0].length ?? 0
        if (block >= 0 && text.trim() !== "" && indent <= block) block = -1
        const inBlock = block >= 0
        const match = inBlock ? null : text.match(/^(\s*)(- )?([\w.]+)(:)(.*)$/)
        let value = match ? match[5] : text.slice(indent)
        let comment = ""
        const hash = value.indexOf(" #")
        if (!inBlock && hash >= 0) {
            comment = value.slice(hash + 1)
            value = value.slice(0, hash)
        }
        if (match && value.trim() === "|") block = indent
        const string = inBlock || /^\s*["']/.test(value) ? " string" : ""
        const mark = markAt(row)
        return [
            `<span class="line"${mark ? ` data-k="${mark}"` : ""}>`,
            match ? match[1] : " ".repeat(indent),
            match?.[2] ? `<span class="dash">- </span>` : "",
            match ? `<span class="key">${match[3]}:</span>` : "",
            `<span class="value${string}">${escape(value)}</span>`,
            comment ? `<span class="comment">${escape(comment)}</span>` : "",
            "\n</span>",
        ].join("")
    })
    .join("")
---

<figure
    class:list={["code-card", Astro.props.class, { dark }]}
    aria-label={file}
>
    <figcaption>
        {dots && (
            <span class="dots" aria-hidden="true">
                <i />
                <i />
                <i />
            </span>
        )}
        <span class="file">{file}</span>
    </figcaption>
    <pre><code set:html={HTML} /></pre>
</figure>

<style lang="scss">
    @use "/src/components/enterprise/mocks/tokens" as *;

    .code-card {
        @include tokens;

        --code-key: #6d52f5;
        --code-string: #1c7e57;
        --code-comment: #6d6d86;
        --hl: rgba(132, 5, 255, 0.08);

        margin: 0;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        background: var(--panel);
        box-shadow: var(--shadow);
        text-align: left;

        :global(html.dark) & {
            --code-key: #b9a6ff;
            --code-string: #7fd8b0;
            --code-comment: #9696a5;
            --hl: rgba(152, 105, 247, 0.16);
        }

        &.dark {
            --chrome: #1e1e26;
            --panel: #18181e;
            --line: #2e2e3c;
            --text: #ffffff;
            --soft: #d6d6e0;
            --muted: #adadbf;
            --code-key: #b9a6ff;
            --code-string: #7fd8b0;
            --code-comment: #9696a5;
            --hl: rgba(152, 105, 247, 0.16);
            --shadow: 0 30px 80px -24px rgba(0, 0, 0, 0.6);
        }
    }

    figcaption {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--line);
        background: var(--chrome);
        font-family: $font-family-monospace;
        font-size: 0.8125rem;
        color: var(--muted);
    }

    .dots {
        display: inline-flex;
        gap: 0.375rem;

        i {
            width: 0.625rem;
            height: 0.625rem;
            border-radius: 50%;
            background: var(--line);
        }
    }

    pre {
        margin: 0;
        padding: 1rem 0;
        overflow-x: auto;
        font-family: $font-family-monospace;
        font-size: 0.8125rem;
        line-height: 1.7;
        color: var(--soft);
        background: transparent;
    }

    code {
        display: block;
        min-width: max-content;
        font: inherit;
        color: inherit;
        background: none;
        padding: 0;
    }

    pre :global(.line) {
        display: block;
        padding: 0 1.25rem;
        transition: background-color 0.2s ease;
    }

    pre :global(.line.on) {
        background: var(--hl);
    }

    pre :global(.key) {
        color: var(--code-key);
    }

    pre :global(.dash) {
        color: var(--muted);
    }

    pre :global(.string) {
        color: var(--code-string);
    }

    pre :global(.comment) {
        color: var(--code-comment);
        font-style: italic;
    }
</style>
