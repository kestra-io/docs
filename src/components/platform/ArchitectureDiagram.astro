---
import { Icon } from "astro-icon/components"

const ENTRIES = [
    { icon: "mdi:account-outline", who: "Humans", via: "UI" },
    { icon: "mdi:api", who: "Systems", via: "API" },
    { icon: "mdi:robot-outline", who: "Agents", via: "MCP" },
]

const SERVICES = [
    { icon: "mdi:web", name: "Web server" },
    { icon: "mdi:tune-variant", name: "Controller" },
    { icon: "mdi:play-circle-outline", name: "Executor" },
    { icon: "mdi:database-search-outline", name: "Indexer" },
    { icon: "mdi:clock-outline", name: "Scheduler" },
]

const BACKENDS = {
    oss: ["PostgreSQL", "MySQL", "JDBC"],
    ent: ["Redis", "AMQP", "Kafka", "Elasticsearch", "JDBC"],
}

const SITES = [
    { icon: "mdi:cloud-outline", name: "Cloud" },
    { icon: "mdi:server-outline", name: "On-prem" },
    { icon: "mdi:cloud-sync-outline", name: "Hybrid" },
]

const TARGETS = [
    { icon: "mdi:database-outline", name: "Database" },
    { icon: "mdi:api", name: "API" },
    { icon: "mdi:dots-horizontal", name: "Other" },
]
---

<div class="arch-diagram" role="img" aria-label="Kestra architecture">
    <ul class="entries">
        {ENTRIES.map((entry) => (
            <li>
                <span class="ico">
                    <Icon name={entry.icon} />
                </span>
                <span class="lbl">
                    {entry.who} → <b>{entry.via}</b>
                </span>
            </li>
        ))}
    </ul>

    <div class="zone" data-zone="control">
        <p class="title">Control plane</p>
        <ul class="services">
            {SERVICES.map((service) => (
                <li>
                    <Icon name={service.icon} />
                    {service.name}
                </li>
            ))}
        </ul>
        <p class="plugins">Plugins</p>
    </div>

    <div class="middle">
        <div class="wire">
            <span class="pulse" aria-hidden="true"></span>
            <p>
                <b>Worker communication</b>
                gRPC, mTLS configurable
            </p>
        </div>
        <div class="zone" data-zone="queue">
            <p class="title">Queue / database</p>
            <p class="sub">Backends</p>
            <ul class="chips" data-edition="oss">
                {BACKENDS.oss.map((name) => (
                    <li>{name}</li>
                ))}
            </ul>
            <ul class="chips" data-edition="ent">
                {BACKENDS.ent.map((name) => (
                    <li>{name}</li>
                ))}
            </ul>
        </div>
    </div>

    <div class="zone" data-zone="data">
        <p class="title">Data plane</p>
        <p class="sub">Run workers wherever your data lives</p>
        <ul class="sites">
            {SITES.map((site) => (
                <li>
                    <Icon name={site.icon} />
                    {site.name}
                </li>
            ))}
        </ul>
        <div class="workers" data-edition="oss">
            <span class="worker">
                <Icon name="mdi:cog-outline" /> Worker
            </span>
        </div>
        <div class="workers group" data-edition="ent">
            <p class="group-name">Worker group</p>
            <p class="sub">Subscribes to queues · reserves capacity</p>
            <div class="row">
                <span class="worker">
                    <Icon name="mdi:cog-outline" /> Worker
                </span>
                <span class="worker">
                    <Icon name="mdi:cog-outline" /> Worker
                </span>
                <span class="worker">
                    <Icon name="mdi:cog-outline" /> Worker
                </span>
            </div>
        </div>
        <p class="sub calls">Flow tasks call out</p>
        <ul class="sites targets">
            {TARGETS.map((target) => (
                <li>
                    <Icon name={target.icon} />
                    {target.name}
                </li>
            ))}
        </ul>
    </div>
</div>

<style lang="scss">
    @use "/src/components/enterprise/mocks/tokens" as *;

    .arch-diagram {
        @include tokens;

        display: grid;
        grid-template-columns: 9rem 1.1fr 1fr 1.3fr;
        gap: 1.5rem;
        align-items: stretch;
        padding: 2rem;
        border: 1px solid var(--line);
        border-radius: 1rem;
        background: var(--deep);

        @include media-breakpoint-down(lg) {
            grid-template-columns: 1fr;
            padding: 1.25rem;
        }
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .entries {
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        gap: 1rem;

        @include media-breakpoint-down(lg) {
            flex-direction: row;
            justify-content: space-between;
        }

        li {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }
    }

    .ico {
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border: 1px solid var(--line);
        border-radius: 0.625rem;
        background: var(--panel);
        color: var(--run);
        font-size: 1.375rem;
    }

    .lbl,
    .sub,
    .title,
    .group-name,
    .plugins,
    .wire p {
        font-family: $font-family-monospace;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .lbl b {
        color: var(--text);
    }

    .zone {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.25rem;
        border: 1px solid var(--line);
        border-radius: 0.875rem;
        background: var(--panel);
        transition:
            opacity 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease,
            border-color 0.25s ease;

        :global([data-focus]) & {
            opacity: 0.45;
        }

        :global([data-focus="control"]) &[data-zone="control"],
        :global([data-focus="data"]) &[data-zone="data"],
        :global([data-focus="queue"]) &[data-zone="queue"] {
            opacity: 1;
            transform: translateY(-3px);
            border-color: var(--ring);
            box-shadow: var(--shadow);
        }

        &[data-zone="control"] {
            border-color: color-mix(in srgb, var(--ring) 45%, var(--line));
        }
    }

    .title {
        margin: 0;
        font-weight: 700;
        text-align: center;
        color: var(--text);
    }

    .sub {
        margin: 0;
        text-align: center;
        text-transform: none;
        letter-spacing: 0;
    }

    .services {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        li {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            padding: 0.5rem 0.75rem;
            border-radius: 0.5rem;
            background: var(--field);
            font-family: $font-family-monospace;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--soft);

            svg {
                font-size: 1.125rem;
                color: var(--run);
            }
        }
    }

    .plugins {
        margin: 0;
        padding: 0.5rem;
        border: 1px dashed var(--line);
        border-radius: 0.5rem;
        text-align: center;
        text-transform: none;
        letter-spacing: 0;
    }

    .middle {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
    }

    .wire {
        position: relative;
        padding-top: 1rem;
        text-align: center;

        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: repeating-linear-gradient(
                90deg,
                var(--ring) 0 6px,
                transparent 6px 12px
            );
            opacity: 0.6;
        }

        p {
            margin: 0;
        }

        b {
            display: block;
            color: var(--text);
        }

        @include media-breakpoint-down(lg) {
            display: none;
        }
    }

    .pulse {
        position: absolute;
        top: -3px;
        left: 0;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--ring);
        animation: travel 2.4s linear infinite;

        @media (prefers-reduced-motion: reduce) {
            display: none;
        }
    }

    @keyframes travel {
        from {
            left: 0;
        }

        to {
            left: calc(100% - 8px);
        }
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.375rem;

        li {
            padding: 0.25rem 0.625rem;
            border-radius: 999px;
            background: var(--chip);
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--soft);
        }
    }

    .sites {
        display: flex;
        justify-content: space-around;

        li {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.25rem;
            font-family: $font-family-monospace;
            font-size: 0.6875rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);

            svg {
                font-size: 1.5rem;
                color: var(--soft);
            }
        }
    }

    .workers {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;

        &.group {
            padding: 0.75rem;
            border: 1px dashed var(--ring);
            border-radius: 0.625rem;
        }

        .row {
            display: flex;
            gap: 0.5rem;
        }
    }

    .group-name {
        margin: 0;
        font-weight: 700;
        color: var(--run);
    }

    .worker {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.625rem;
        border-radius: 0.5rem;
        background: var(--tile);
        font-family: $font-family-monospace;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--tile-ink);
    }

    .calls {
        margin-top: auto;
    }

    [data-edition="ent"] {
        display: none;
    }
</style>
