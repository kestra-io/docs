---
import { Icon } from "astro-icon/components"
import Rails from "./Rails.astro"
import SectionHead from "~/components/home/SectionHead.astro"
import CodeCard from "./CodeCard.astro"
import RunStatus from "./RunStatus.astro"

const FEATURES = [
    {
        mark: "conc",
        side: "left",
        key: "concurrency",
        title: "Concurrency limits",
        text: "Cap concurrent executions per flow, and choose whether extra runs queue, cancel, or fail.",
    },
    {
        mark: "sla",
        side: "right",
        key: "sla",
        title: "SLAs",
        text: "Declare a maximum duration or an assertion on each execution. A breach fails the run, cancels it, or adds a label your alerts can act on.",
    },
    {
        mark: "trigger",
        side: "left",
        key: "triggers",
        title: "Backfills",
        text: "Rerun a schedule over a past date range.",
    },
    {
        mark: "timeout",
        side: "left",
        key: "timeout",
        title: "Timeouts",
        text: "Set a maximum duration on any task.",
    },
    {
        mark: "retry",
        side: "right",
        key: "retry",
        title: "Retries",
        text: "Backoff per task, capped by attempts or time.",
    },
    {
        mark: "err",
        side: "right",
        key: "errors",
        title: "Error handlers",
        text: "Run alerting, cleanup, or compensation tasks when a flow fails.",
    },
]

const RUNTIME = [
    {
        icon: "mdi:restart",
        title: "Restart and replay",
        text: "Restart a failed execution from the task that failed, not from the beginning.",
    },
    {
        icon: "mdi:history",
        title: "Every attempt recorded",
        text: "Each attempt keeps its own logs, outputs, and duration, so the post-incident question “what happened?” has an answer.",
    },
]

const FLOW = `id: nightly_ledger
namespace: finance
concurrency:
  limit: 1
  behavior: QUEUE
sla:
  - id: max_runtime
    type: MAX_DURATION
    duration: PT2H
    behavior: FAIL
triggers:
  - id: nightly          # backfill from the UI or API
    type: io.kestra.plugin.core.trigger.Schedule
    cron: "0 2 * * *"
tasks:
  - id: extract
    type: io.kestra.plugin.jdbc.postgresql.Query
    timeout: PT30M
    retry:
      type: exponential
      interval: PT30S
      maxAttempts: 5
errors:
  - id: page_oncall
    type: io.kestra.plugin.notifications.slack.SlackIncomingWebhook`

const SIDES = ["left", "right"].map((side) =>
    FEATURES.filter((feature) => feature.side === side),
)

const MARKS: Record<string, [number, number]> = {
    conc: [3, 5],
    sla: [6, 10],
    trigger: [11, 14],
    timeout: [18, 18],
    retry: [19, 22],
    err: [23, 25],
}
---

<section class="production" id="production" aria-labelledby="prod-h">
    <Rails>
        <RunStatus />
        <SectionHead id="prod-h" align="center">
            Failure handling, <span>declared in the flow.</span>
            <Fragment slot="lead">
                Every workflow fails eventually. In Kestra, what happens next is
                written in the same YAML as the work itself, so it’s reviewed in
                Git, versioned with the flow, and behaves the same on every run.
            </Fragment>
        </SectionHead>

        <div class="annotated" data-prod>
            <CodeCard
                class="code"
                file="finance / nightly_ledger.yml"
                code={FLOW}
                marks={MARKS}
                editor
            />
            {SIDES.map((notes, idx) => (
                <ol class:list={["notes", idx ? "right" : "left"]}>
                    {notes.map((feature) => (
                        <li class="note" tabindex="0" data-k={feature.mark}>
                            <b>
                                {feature.title}
                                <code class="key">{feature.key}</code>
                            </b>
                            <span>{feature.text}</span>
                        </li>
                    ))}
                </ol>
            ))}
            <svg class="links" aria-hidden="true"></svg>
        </div>

        <ul class="runtime">
            {RUNTIME.map((item) => (
                <li>
                    <Icon name={item.icon} />
                    <b>{item.title}</b>
                    <span>{item.text}</span>
                </li>
            ))}
        </ul>
    </Rails>
</section>

<script>
    const SVG = "http://www.w3.org/2000/svg"
    const GAP = 14

    function wireProduction() {
        const box = document.querySelector<HTMLElement>(
            "[data-prod]:not([data-wired])",
        )
        if (!box) return
        box.dataset.wired = "true"
        const card = box.querySelector<HTMLElement>(".code")!
        const lines = [...card.querySelectorAll<HTMLElement>(".line[data-k]")]
        const notes = [...box.querySelectorAll<HTMLElement>(".note")]
        const svg = box.querySelector<SVGSVGElement>(".links")!
        const wide = matchMedia("(min-width: 1200px)")

        const linesOf = (mark: string) =>
            lines.filter((line) => line.dataset.k === mark)

        const light = (mark?: string) => {
            for (const line of lines)
                line.classList.toggle("on", !!mark && line.dataset.k === mark)
            for (const note of notes)
                note.classList.toggle("on", note.dataset.k === mark)
            for (const path of svg.querySelectorAll("[data-k]"))
                path.classList.toggle(
                    "on",
                    (path as SVGElement).dataset.k === mark,
                )
        }

        const layout = () => {
            svg.replaceChildren()
            for (const note of notes) note.style.top = ""
            for (const side of box.querySelectorAll<HTMLElement>(".notes"))
                side.style.minHeight = ""
            if (!wide.matches) return
            const base = box.getBoundingClientRect()
            const code = card.getBoundingClientRect()
            svg.setAttribute("viewBox", `0 0 ${base.width} ${base.height}`)
            for (const side of box.querySelectorAll<HTMLElement>(".notes")) {
                const left = side.classList.contains("left")
                let floor = 0
                for (const note of side.querySelectorAll<HTMLElement>(
                    ".note",
                )) {
                    const range = linesOf(note.dataset.k!)
                    const first = range[0].getBoundingClientRect()
                    const last = range.at(-1)!.getBoundingClientRect()
                    const lineY = (first.top + last.bottom) / 2 - base.top
                    const title = note.querySelector("b")!
                    const half = title.offsetHeight / 2
                    const top = Math.max(lineY - half, floor)
                    note.style.top = `${top}px`
                    floor = top + note.offsetHeight + GAP
                    const rect = note.getBoundingClientRect()
                    const y = top + half
                    const from = left
                        ? rect.right - base.left + 10
                        : rect.left - base.left - 10
                    const to = left
                        ? code.left - base.left
                        : code.right - base.left
                    const mid = (from + to) / 2
                    const path = document.createElementNS(SVG, "path")
                    path.setAttribute(
                        "d",
                        `M${from} ${y} H${mid} V${lineY} H${to}`,
                    )
                    path.dataset.k = note.dataset.k
                    const dot = document.createElementNS(SVG, "circle")
                    dot.setAttribute("cx", String(to))
                    dot.setAttribute("cy", String(lineY))
                    dot.setAttribute("r", "3")
                    dot.dataset.k = note.dataset.k
                    svg.appendChild(path)
                    svg.appendChild(dot)
                }
                side.style.minHeight = `${floor}px`
            }
        }

        for (const note of notes) {
            const on = () => light(note.dataset.k)
            note.addEventListener("mouseenter", on)
            note.addEventListener("focus", on)
            note.addEventListener("mouseleave", () => light())
            note.addEventListener("blur", () => light())
        }

        const pre = card.querySelector<HTMLElement>("pre")!
        for (const line of pre.querySelectorAll<HTMLElement>(".line"))
            line.addEventListener("mouseenter", () => light(line.dataset.k))
        pre.addEventListener("mouseleave", () => light())

        new ResizeObserver(layout).observe(box)
        wide.addEventListener("change", layout)
        void document.fonts.ready.then(layout)

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
        const order = [...new Set(lines.map((line) => line.dataset.k!))]
        let step = 0
        let timer = 0
        let visible = false
        let held = false
        const stop = () => window.clearInterval(timer)
        const play = () => {
            stop()
            if (!visible || held) return
            light(order[step])
            timer = window.setInterval(() => {
                step = (step + 1) % order.length
                light(order[step])
            }, 2200)
        }
        const hold = () => {
            held = true
            stop()
        }
        const release = () => {
            held = false
            light()
            play()
        }
        box.addEventListener("pointerenter", hold)
        box.addEventListener("pointerleave", release)
        box.addEventListener("focusin", hold)
        box.addEventListener("focusout", release)
        new IntersectionObserver(
            ([entry]) => {
                visible = entry.isIntersecting
                if (visible) play()
                else stop()
            },
            { threshold: 0.4 },
        ).observe(box)
    }

    document.addEventListener("astro:page-load", wireProduction)
    wireProduction()
</script>

<style lang="scss">
    @use "./style/platform" as *;

    .production {
        @include tinted;

        :global(.section-head h2 span) {
            display: block;
            color: var(--ks-content-tertiary);
        }

        :global(.section-head) {
            max-width: 56rem;
            margin-bottom: 2.5rem;
        }
    }

    .annotated {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 40rem) minmax(0, 1fr);
        gap: 3.5rem;
        align-items: start;

        @include media-breakpoint-down(xl) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.5rem 2rem;
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
        }

        :global(.code) {
            grid-column: 2;
            grid-row: 1;

            @include media-breakpoint-down(xl) {
                grid-column: 1 / -1;
            }
        }
    }

    .notes {
        position: relative;
        grid-row: 1;
        align-self: stretch;
        margin: 0;
        padding: 0;
        list-style: none;

        &.left {
            grid-column: 1;
            text-align: right;
        }

        &.right {
            grid-column: 3;
        }

        @include media-breakpoint-down(xl) {
            display: grid;
            gap: 1.25rem;
            grid-row: 2;

            &.left {
                grid-column: 1;
                text-align: left;
            }

            &.right {
                grid-column: 2;
            }
        }

        @include media-breakpoint-down(md) {
            &.right {
                grid-column: 1;
                grid-row: 3;
            }
        }
    }

    .note {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        outline: none;
        cursor: default;

        @include media-breakpoint-up(xl) {
            position: absolute;
            left: 0;
            right: 0;
        }

        b {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1rem;
            font-weight: 600;
            color: var(--ks-content-primary);

            .left & {
                justify-content: flex-end;
            }

            @include media-breakpoint-down(xl) {
                .left & {
                    justify-content: flex-start;
                }
            }
        }

        span {
            font-size: $font-size-sm;
            line-height: 1.5;
            color: var(--ks-content-secondary);
        }

        &:global(.on) .key,
        &:focus-visible .key {
            background: var(--ks-content-primary);
            color: var(--ks-background-body);
        }
    }

    .key {
        padding: 0 0.25rem;
        border-radius: var(--ks-border-radius);
        background-color: var(--ks-background-function);
        font-family: $font-family-monospace;
        font-size: 0.8125rem;
        font-weight: 400;
        color: var(--ks-content-secondary);
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }

    .links {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;

        @include media-breakpoint-down(xl) {
            display: none;
        }

        :global(path) {
            fill: none;
            stroke: var(--ks-border-secondary);
            stroke-width: 1;
            stroke-dasharray: 3 3;
            transition: stroke 0.2s ease;
        }

        :global(circle) {
            fill: var(--ks-border-secondary);
            transition: fill 0.2s ease;
        }

        :global(path.on) {
            stroke: var(--ks-content-link);
        }

        :global(circle.on) {
            fill: var(--ks-content-link);
        }
    }

    .runtime {
        @include ruled-grid(2);

        margin-top: 4rem;

        li {
            display: flex;
            flex-direction: column;
            gap: 0.375rem;
            padding: 2rem var(--inset) 2.25rem;

            > :global(svg) {
                width: 1.5rem;
                height: 1.5rem;
                margin-bottom: 0.75rem;
                color: var(--ks-content-tertiary);
                transition: color 0.3s ease;
            }

            &:hover > :global(svg) {
                color: var(--ks-content-link);
            }
        }

        b {
            font-size: 1.0625rem;
            font-weight: 600;
            color: var(--ks-content-primary);
        }

        span {
            font-size: $font-size-sm;
            line-height: 1.55;
            color: var(--ks-content-secondary);
        }
    }
</style>
