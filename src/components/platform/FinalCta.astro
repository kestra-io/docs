---
import Rails from "./Rails.astro"
import Copy from "~/components/common/Copy.vue"
import RocketSky from "~/components/home/RocketSky.astro"

const COMMAND = `docker run --pull=always --rm -it -p 8080:8080 --user=root \\
  -v /var/run/docker.sock:/var/run/docker.sock -v /tmp:/tmp \\
  kestra/kestra:latest server local`
---

<section
    class="final-cta surface-dark"
    id="start"
    aria-labelledby="start-h"
    data-header-dark
>
    <RocketSky />
    <Rails dark>
        <div class="stage">
            <h2 id="start-h">Run your first flow in minutes.</h2>
            <p>
                One command starts the full open-source edition on your machine.
            </p>
            <div class="cmd">
                <pre><code>{COMMAND}</code></pre>
                <Copy code={COMMAND} client:visible />
            </div>
            <div class="buttons">
                <a href="/docs/quickstart" class="btn-solid">
                    Get started
                </a>
                <a href="/demo" class="btn-ghost">
                    Book a demo
                </a>
            </div>
        </div>
    </Rails>
</section>

<style lang="scss">
    @use "/src/components/about/style/section" as *;

    .final-cta {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                50% 60% at 78% 30%,
                rgba(120, 70, 255, 0.14),
                transparent 70%
            ),
            #08070d;
        color: #ffffff;
    }

    .stage {
        position: relative;
        z-index: 1;
        max-width: 40rem;
        min-width: 0;

        @include media-breakpoint-down(lg) {
            padding-top: 10rem;
        }
    }

    h2 {
        @include title;

        font-size: clamp(2rem, 3.6vw, 3rem);
        color: #ffffff;
        text-shadow: 0 0 1.5rem rgba(8, 7, 13, 0.8);
    }

    p {
        margin: 0.75rem 0 1.25rem;
        font-size: $font-size-lg;
        color: rgba(255, 255, 255, 0.78);
    }

    .cmd {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border: 1px solid #2e2e3c;
        border-radius: 0.75rem;
        background: rgba(17, 15, 26, 0.82);

        pre {
            flex: 1;
            margin: 0;
            overflow-x: auto;
            background: none;
            font-family: $font-family-monospace;
            font-size: 0.8125rem;
            line-height: 1.7;
            color: #d6d6e0;
        }

        code {
            padding: 0;
            background: none;
            color: inherit;
            font: inherit;
        }

        :global(.copy .btn) {
            color: #adadbf;
            border-color: #2e2e3c;
        }
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }
</style>
