---
import { Icon } from "astro-icon/components"
import Rails from "./Rails.astro"
import PixelEdges from "~/components/about/PixelEdges.astro"
import HeroLive from "./HeroLive.astro"

const TITLE =
    'The orchestration platform teams run in production<span class="brand-dot" aria-hidden="true"></span><span class="visually-hidden">.</span>'
---

<section
    class="platform-hero surface-dark"
    aria-labelledby="platform-hero"
    data-header-dark
>
    <div class="mesh" aria-hidden="true">
        <span class="light violet"></span>
        <span class="light lavender"></span>
        <span class="light graphite"></span>
    </div>
    <PixelEdges left="tall" right="wide" />
    <Rails dark top="none" bottom="none" lines={false}>
        <div class="grid">
            <div class="copy">
                <h1 id="platform-hero">
                    <span class="product">
                        Platform Overview
                        <span class="visually-hidden">:</span>
                    </span>
                    <span class="claim" set:html={TITLE} />
                </h1>
                <p class="lead">
                    Schedule, trigger, observe, and govern every workflow. Use
                    any language, orchestrate any system, deploy anywhere.
                </p>
                <div class="buttons">
                    <a href="/get-started" class="btn-solid">
                        Get started <Icon name="mdi:chevron-right" />
                    </a>
                    <a href="/demo" class="btn-ghost">
                        Book a demo
                    </a>
                </div>
            </div>
            <div class="stage">
                <HeroLive />
            </div>
        </div>
    </Rails>
</section>

<style lang="scss">
    .platform-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background: #09090b;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: calc(min(80vh, 800px) + 67px);
        margin-top: -67px;
        padding: calc(67px + 4rem) 0 4rem;
        color: #ffffff;

        @include media-breakpoint-down(md) {
            min-height: 0;
            padding: calc(67px + 3rem) 0 4rem;
        }
    }

    .grid {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: 4rem;
        align-items: center;

        @include media-breakpoint-down(lg) {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
    }

    .platform-hero :global(.pixel-edges .edge) {
        background: rgba(190, 176, 255, 0.16);
    }

    .mesh {
        position: absolute;
        z-index: -1;
        inset: 0;
        pointer-events: none;

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.55'/></svg>");
            opacity: 0.22;
            mix-blend-mode: overlay;
        }

        &::before {
            content: "";
            position: absolute;
            z-index: 1;
            inset: 0;
            background: radial-gradient(
                    circle,
                    rgba(255, 255, 255, 0.5) 0.6px,
                    transparent 1px
                )
                0 0 / 4px 4px;
            opacity: 0.12;
            mask: radial-gradient(
                ellipse 70% 80% at 50% 50%,
                rgba(0, 0, 0, 0.25),
                #000
            );
            mix-blend-mode: overlay;
        }
    }

    .light {
        position: absolute;
        border-radius: 50%;
        filter: blur(40px);
        animation: glow-drift 28s ease-in-out infinite alternate;

        &.violet {
            top: -35%;
            left: -20%;
            width: 80%;
            height: 120%;
            background: radial-gradient(
                closest-side,
                rgba(98, 48, 255, 0.52),
                rgba(88, 58, 255, 0.16) 55%,
                transparent
            );
        }

        &.lavender {
            top: -25%;
            right: 5%;
            width: 55%;
            height: 80%;
            background: radial-gradient(
                closest-side,
                rgba(205, 182, 251, 0.18),
                rgba(205, 182, 251, 0.05) 55%,
                transparent
            );
            animation-duration: 34s;
            animation-delay: -12s;
        }

        &.graphite {
            right: -20%;
            bottom: -45%;
            width: 75%;
            height: 115%;
            background: radial-gradient(
                closest-side,
                rgba(120, 118, 135, 0.35),
                rgba(120, 118, 135, 0.1) 55%,
                transparent
            );
            animation-duration: 40s;
            animation-delay: -20s;
        }

        @media (prefers-reduced-motion: reduce) {
            animation: none;
        }
    }

    @keyframes glow-drift {
        0% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(5%, 4%) scale(1.06);
        }

        100% {
            transform: translate(-3%, 6%) scale(0.96);
        }
    }

    .stage {
        position: relative;
        isolation: isolate;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.05;
        text-wrap: balance;
        color: #ffffff;
    }

    .product {
        display: block;
        width: fit-content;
        background: linear-gradient(
                90deg,
                #ffffff 0%,
                #e4dcff 25%,
                #a996ff 50%,
                #e4dcff 75%,
                #ffffff 100%
            )
            0 0 / 200% 100% repeat-x;
        background-clip: text;
        text-transform: uppercase;
        color: transparent;
    }

    .claim {
        display: block;
        margin-top: 0.4em;
        font-size: 0.5em;
        font-weight: 500;
        letter-spacing: -0.01em;

        @include media-breakpoint-down(md) {
            font-size: 0.62em;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .product {
            animation: hero-sheen 8s linear infinite;
        }
    }

    @keyframes hero-sheen {
        to {
            background-position-x: 200%;
        }
    }

    h1 :global(.brand-dot) {
        display: inline-block;
        width: 0.15em;
        height: 0.15em;
        margin-left: 0.05em;
        background: #fe0071;
    }

    .lead {
        margin: 1.5rem 0 0;
        max-width: 34rem;
        font-size: $font-size-lg;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.78);
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }
</style>
