---
import { Image } from "astro:assets"
import soc2Img from "./assets/soc2.png"
import gdprImg from "./assets/gdpr.svg"
---

<div class="certifications">
    <a href="/security" title="SOC 2">
        <Image src={soc2Img} alt="SOC 2" height="46" />
    </a>
    <a href="/security" title="GDPR">
        <Image src={gdprImg} alt="GDPR" height="46" />
    </a>
</div>

<style lang="scss" scoped>
    .certifications {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>
