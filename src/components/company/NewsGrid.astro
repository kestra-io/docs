---
import { Image } from "astro:assets"
import TeamsImages from "~/utils/teamsImages"

const newsItems = [
    {
        id: 1,
        title: "Kestra 2.0 Gives Enterprises One Governed Orchestration Layer Across Every Environment",
        source: "Business Wire",
        url: "https://www.businesswire.com/news/home/20260922260162/en/Kestra-2.0-Gives-Enterprises-One-Governed-Orchestration-Layer-Across-Every-Environment",
        external: true,
        logo: TeamsImages["businesswire.svg"],
        width: 119,
        height: 22,
        invertOnDark: true,
    },
    {
        id: 2,
        title: "Kestra 2.0: Unified orchestration. Now, everywhere.",
        source: "Medium",
        url: "https://medium.com/@edarras/kestra-2-0-unified-orchestration-now-everywhere-b73212312596",
        external: true,
        logo: TeamsImages["medium.svg"],
        width: 52,
        height: 52,
    },
    {
        id: 3,
        title: "Kestra: Ops automation beyond CI/CD",
        source: "heise",
        url: "https://www.heise.de/en/background/Kestra-Ops-automation-beyond-CI-CD-11338819.html",
        external: true,
        logo: TeamsImages["heise.svg"],
        width: 120,
        height: 17,
        invertOnDark: true,
    },
    {
        id: 4,
        title: "How Kestra Raised $25M: Our Series A Deck, Now Public",
        source: "Medium",
        url: "https://medium.com/@edarras/how-kestra-raised-25m-our-series-a-deck-now-public-8a5b2d625434",
        external: true,
        logo: TeamsImages["medium.svg"],
        width: 52,
        height: 52,
    },
    {
        id: 5,
        title: "French open-source orchestration platform Kestra raises $25M",
        source: "The Next Web",
        url: "https://thenextweb.com/news/orchestration-platform-kestra-raises-25m",
        external: true,
        logo: TeamsImages["thenextweb.svg"],
        width: 82,
        height: 21,
    },
    {
        id: 6,
        title: "Kestra raises $25M Series A to build the enterprise orchestration standard",
        source: "Tech.eu",
        url: "https://tech.eu/2026/03/31/kestra-raises-25m-series-a-to-build-the-enterprise-orchestration-standard/",
        external: true,
        logo: TeamsImages["techeu.svg"],
        width: 53,
        height: 40,
        invertOnDark: true,
    },
    {
        id: 7,
        title: "Taking a declarative approach to data orchestration with this open source platform can improve reliability up to 97%",
        source: "VentureBeat",
        url: "https://venturebeat.com/data/taking-a-declarative-approach-to-data-orchestration-with-this-open-source",
        external: true,
        logo: TeamsImages["venturebeat.svg"],
        width: 125,
        height: 16,
        invertOnDark: true,
    },
    {
        id: 8,
        title: "Kestra raises another $8M for its open source orchestration platform",
        source: "TechCrunch",
        url: "https://techcrunch.com/2024/09/23/kestra-raises-another-8-million-for-its-open-source-orchestration-platform/",
        external: true,
        logo: TeamsImages["techcrunch.svg"],
        width: 56,
        height: 51,
    },
    {
        id: 9,
        title: "How Kestra Raised $8M: Our Seed Deck, Now Public",
        source: "Medium",
        url: "https://medium.com/@edarras/how-kestra-raised-8m-our-seed-deck-now-public-b3493f5a9fbb",
        external: true,
        logo: TeamsImages["medium.svg"],
        width: 52,
        height: 52,
    },
    {
        id: 10,
        title: "Kestra is an open source data orchestration platform for complex workflows",
        source: "TechCrunch",
        url: "https://techcrunch.com/2023/10/04/kestra-is-an-open-source-data-orchestration-platform-for-complex-workflows/",
        external: true,
        logo: TeamsImages["techcrunch.svg"],
        width: 56,
        height: 51,
    },
    {
        id: 11,
        title: "Kestra: a Scalable Open-Source Orchestration and Scheduling Platform",
        source: "InfoQ",
        url: "https://www.infoq.com/news/2022/03/kestra-orchestration-platform/",
        external: true,
        logo: TeamsImages["infoq.svg"],
        width: 65,
        height: 19,
    },
]
---

<div class="container">
    <div class="news-grid">
        <div class="news-card title-card" data-usal="fade-u">
            <div class="title-content">
                <h2 class="title">News</h2>
                <p class="subtitle">Recent mentions in media.</p>
            </div>
        </div>
        {
            newsItems.map((news, index) => (
                <div
                    class="news-card"
                    data-usal={`fade-u delay-${200 + (index % 3) * 100}`}
                >
                    <a
                        href={news.url}
                        target={news.external ? "_blank" : "_self"}
                    >
                        <div class="card-content">
                            <span class="card-category">{news.source}</span>
                            <h3 class="card-title">{news.title}</h3>
                            <Image
                                src={news.logo}
                                alt={news.source}
                                width={news.width}
                                height={news.height}
                                class:list={[{ "invert-on-dark": news.invertOnDark }]}
                            />
                        </div>
                    </a>
                </div>
            ))
        }
    </div>
</div>

<style lang="scss">
    .container {
        max-width: 100%;
        background-color: var(--ks-background-body);
        padding: 5rem 1rem;

        @include media-breakpoint-up(sm) {
            padding: 4rem 1rem;
        }
        @include media-breakpoint-up(md) {
            padding: 4.5rem 4rem;
        }
        @include media-breakpoint-up(lg) {
            padding: 4.5rem;
        }
        @include media-breakpoint-up(xxl) {
            padding: 4.5rem 150px;
        }
    }

    .news-layout {
        max-width: 1140px;
        margin: 0 auto;
    }

    .news-grid {
        width: 1140px;
        max-width: 100%;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(2, 1fr);
        }
        @include media-breakpoint-up(xl) {
            grid-template-columns: repeat(3, minmax(380px, 1fr));
        }
    }

    .news-card {
        padding: 32px;
        height: 277px;

        @media (max-width: 767px) {
            &:not(:first-child) {
                border-top: 1px solid var(--ks-border-primary);
            }
        }

        @media (min-width: 768px) and (max-width: 1199px) {
            &:nth-child(odd) {
                border-right: 1px solid var(--ks-border-primary);
            }

            &:not(:first-child):not(:nth-child(2)) {
                border-top: 1px solid var(--ks-border-primary);
            }
        }

        @media (min-width: 1200px) {
            &:not(:nth-last-child(-n + 3)) {
                border-bottom: 1px solid var(--ks-border-primary);
            }

            &:nth-child(3n + 2) {
                border-left: 1px solid var(--ks-border-primary);
                border-right: 1px solid var(--ks-border-primary);
            }
        }

        @include media-breakpoint-down(md) {
            height: auto;
            max-height: 277px;
        }
    }

    .title-card {
        display: flex;
        align-items: center;
        justify-content: center;

        @include media-breakpoint-up(md) {
            align-items: start;
            justify-content: start;
        }

        .title {
            font-size: 2rem !important;
            line-height: 1.2;
            font-weight: 600;
            margin-bottom: 0.5rem;
            text-align: center;

            @include media-breakpoint-up(md) {
                text-align: left;
            }
        }

        .subtitle {
            font-size: $font-size-md;
            line-height: 1.4;
            margin: 0;
            color: var(--ks-content-tertiary);
        }
    }

    .card-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
        gap: 1rem;
        justify-content: space-between;

        img {
            margin-top: auto;
            align-self: flex-start;
        }

        :global(html.dark) & img.invert-on-dark {
            filter: brightness(0) invert(1);
        }
    }

    .card-details {
        margin-bottom: 1rem;
    }

    .card-category {
        color: var(--ks-content-primary);
        font-size: $font-size-sm;

        line-height: 1.4;
    }

    .card-title {
        font-size: $font-size-lg;
        font-weight: 600;
        color: var(--ks-content-primary);
        line-height: 1.4;
    }
</style>
