---
import { Icon } from "astro-icon/components"
import PixelEdges from "~/components/about/PixelEdges.astro"

type Action = { label: string; href: string; solid?: boolean }

const PLANS: {
    name: string
    tag?: string
    price: string
    text: string
    features: string[]
    ideal: string
    actions: Action[]
    tone: "neutral" | "blue" | "premium"
    featured?: boolean
}[] = [
    {
        name: "Kestra Core",
        tone: "neutral",
        tag: "Open Source",
        price: "Free",
        text: "For individuals and single teams who want to run Kestra themselves. No limits on flows or executions.",
        features: [
            "Declarative workflows, 2,300+ plugins",
            "Scheduling and events",
            "Code and no-code editors",
            "AI agents and MCP server",
            "Queue on PostgreSQL or MySQL",
            "Community Slack, docs and blueprints",
        ],
        ideal: "Ideal for a first team and a first production.",
        actions: [
            { label: "Get started", href: "/get-started" },
            {
                label: "Star on GitHub",
                href: "https://github.com/kestra-io/kestra",
            },
        ],
    },
    {
        name: "Kestra Cloud",
        tone: "blue",
        tag: "Early Access",
        price: "Usage-based",
        text: "Managed by the people who build Kestra. Start in minutes, scale when you need to.",
        features: [
            "Everything in Open Source",
            "Fully managed: hosting, upgrades, monitoring",
            "Automatic scaling",
            "Built-in security and governance",
            "Enterprise plugins included",
            "SOC2",
        ],
        ideal: "Get most Enterprise capabilities without managing the infrastructure yourself.",
        actions: [{ label: "Try Kestra Cloud", href: "/cloud" }],
    },
    {
        name: "Kestra Enterprise",
        tone: "premium",
        price: "Annual",
        text: "For organizations running Kestra as shared infrastructure, on their own terms.",
        features: [
            "Unlimited executions, flows, tasks, apps and assets",
            "Sized to the project: instances, environments, worker groups",
            "SSO, RBAC, audit logs, secrets, policies, approvals",
            "Customer Success program, support with SLA",
            "Self-hosted, hybrid or air-gapped",
        ],
        ideal: "Ideal when a second team joins, when auditors ask, when agents act.",
        actions: [
            { label: "Book a demo", href: "/demo", solid: true },
            { label: "About Enterprise", href: "/enterprise" },
        ],
        featured: true,
    },
]
---

<section class="pricing-plans" aria-labelledby="pricing-title">
    <PixelEdges left="tall" right="wide" />
    <div class="container-xl">
        <div class="rails">
            <header>
                <h1 id="pricing-title">Three ways to run Kestra</h1>
                <p class="lead">
                    Self-host the open-source version for free. Choose Cloud for
                    a managed service. Get Enterprise for advanced governance,
                    air-gapped-ready deployment, and SLA backed support.
                </p>
            </header>
            <ul class="plans">
                {PLANS.map((plan) => {
                    const [primary, secondary] = plan.actions
                    const external = (href: string) =>
                        href.startsWith("http")
                            ? { target: "_blank", rel: "noopener" }
                            : {}
                    return (
                        <li
                            class:list={[
                                plan.tone,
                                { featured: plan.featured },
                            ]}
                        >
                            <div class="panel">
                                <div class="name">
                                    <h2 class={plan.tone}>{plan.name}</h2>
                                </div>
                                <p class="stage">
                                    {plan.tag && (
                                        <span class="tag">{plan.tag}</span>
                                    )}
                                </p>
                                <p class="price">{plan.price}</p>
                                <p class="text">{plan.text}</p>
                                <a
                                    href={primary.href}
                                    class={
                                        primary.solid
                                            ? "btn-solid"
                                            : "btn-ghost"
                                    }
                                    {...external(primary.href)}
                                >
                                    {primary.label}
                                </a>
                                <p class="more">
                                    {secondary && (
                                        <a
                                            href={secondary.href}
                                            {...external(secondary.href)}
                                        >
                                            {secondary.label}
                                            <span
                                                class="arrow"
                                                aria-hidden="true"
                                            >
                                                →
                                            </span>
                                        </a>
                                    )}
                                </p>
                            </div>
                            <ul class="features">
                                {plan.features.map((feature) => (
                                    <li>
                                        <Icon name="mdi:check" />
                                        {feature}
                                    </li>
                                ))}
                            </ul>
                            <p class="ideal">{plan.ideal}</p>
                        </li>
                    )
                })}
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    @use "../about/style/section" as *;

    .pricing-plans {
        --rule: 1px solid var(--ks-border-primary);

        position: relative;
        border-bottom: var(--rule);
        background: var(--ks-background-body);
    }

    // The site header draws its hairline only once scrolled. This page opens
    // on a white hero, so the header carries it from the top.
    :global(body:has(.pricing-plans) #top-bar:not(.open)) {
        box-shadow: 0 1px 0 var(--ks-border-primary);
    }

    .rails {
        position: relative;
        padding: 0 clamp(1.5rem, 4vw, 3.5rem) 4.5rem;
        border-inline: var(--rule);

        @include media-breakpoint-down(md) {
            padding-bottom: 3.5rem;
        }
    }

    header {
        padding: calc(3.5rem + 61px) 0 3.5rem;
        text-align: center;

        @include media-breakpoint-down(md) {
            padding-block: calc(2.5rem + 57px) 2.5rem;
        }
    }

    h1 {
        @include title;
        color: var(--ks-content-primary);
    }

    .lead {
        @include lead;
        max-width: 44rem;
        margin-inline: auto;
    }

    .plans {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
        max-width: 72rem;
        margin: 0 auto;
        padding: 0;
        list-style: none;

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
            max-width: 32rem;
        }

        // A card: a tinted panel that holds the offer, then what it includes.
        > li {
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 0.75rem 0.75rem 1.75rem;
            border: var(--rule);
            border-radius: 12px;
            background: var(--ks-background-body);

            &.neutral {
                --tint: #ececf1;
            }

            &.blue {
                --tint: #dde7ff;
            }

            &.premium {
                --tint: #e3dbff;
            }

            :global(html.dark) & {
                &.neutral {
                    --tint: rgba(255, 255, 255, 0.07);
                }

                &.blue {
                    --tint: rgba(70, 110, 255, 0.2);
                }

                &.premium {
                    --tint: rgba(143, 123, 255, 0.24);
                }
            }

            // The featured card's ring carries a light that travels around it.
            &.featured {
                border-color: transparent;

                &::before {
                    content: "";
                    position: absolute;
                    inset: -1px;
                    padding: 1px;
                    border-radius: inherit;
                    background:
                        conic-gradient(
                            from var(--plans-turn),
                            transparent 0 60%,
                            #b4b8c8 78%,
                            #8f9fe6 94%,
                            transparent 100%
                        ),
                        var(--ks-border-primary);
                    mask:
                        linear-gradient(#000 0 0) content-box exclude,
                        linear-gradient(#000 0 0);
                    pointer-events: none;
                    animation: plans-turn 7s linear infinite;

                    @media (prefers-reduced-motion: reduce) {
                        background: var(--ks-border-primary);
                        animation: none;
                    }
                }
            }
        }
    }

    @property --plans-turn {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
    }

    @keyframes plans-turn {
        to {
            --plans-turn: 360deg;
        }
    }

    .panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1.5rem 1.5rem;
        border-radius: 6px;
        background: linear-gradient(180deg, var(--tint), transparent 92%);
        text-align: center;
    }

    .name {
        display: flex;
        justify-content: center;

        // The edition tag of the Enterprise page's hero, one tone per edition:
        // neutral for Open Source, blue for Cloud, ink and violet for
        // Enterprise. Each tone sets the fill, the ring and the ink.
        h2 {
            position: relative;
            display: inline-flex;
            align-items: center;
            margin: 0;
            padding: 0.3125rem 0.75rem;
            border-radius: 999px;
            background: var(--tag-fill);
            box-shadow: var(--tag-shadow, none);
            font-size: 0.8125rem;
            font-weight: 600;
            letter-spacing: 0.01em;
            color: var(--tag-ink);

            &::before {
                content: "";
                position: absolute;
                inset: 0;
                padding: 1px;
                border-radius: inherit;
                background: var(--tag-ring);
                mask:
                    linear-gradient(#000 0 0) content-box exclude,
                    linear-gradient(#000 0 0);
                pointer-events: none;
            }

            &.neutral {
                --tag-fill: linear-gradient(160deg, #f4f4f6, #ffffff 70%);
                --tag-ring: linear-gradient(
                    150deg,
                    rgba(19, 19, 22, 0.26),
                    rgba(19, 19, 22, 0.12)
                );
                --tag-ink: #131316;
            }

            &.blue {
                --tag-fill: linear-gradient(160deg, #e2ebff, #ffffff 85%);
                --tag-ring: linear-gradient(
                    150deg,
                    rgba(46, 98, 255, 0.6),
                    rgba(46, 98, 255, 0.18) 45%,
                    rgba(46, 98, 255, 0.4)
                );
                --tag-ink: #1f43b8;
            }

            &.premium {
                --tag-fill: linear-gradient(150deg, #2c2547, #131316 65%);
                --tag-ring: linear-gradient(
                    150deg,
                    #d9ceff,
                    rgba(143, 123, 255, 0.45) 40%,
                    rgba(255, 255, 255, 0.12) 60%,
                    rgba(180, 150, 255, 0.7)
                );
                --tag-ink: #ffffff;
                --tag-shadow: 0 8px 18px -10px rgba(44, 37, 71, 0.8);
            }

            :global(html.dark) & {
                &.neutral {
                    --tag-fill: rgba(255, 255, 255, 0.06);
                    --tag-ring: linear-gradient(
                        150deg,
                        rgba(255, 255, 255, 0.34),
                        rgba(255, 255, 255, 0.1)
                    );
                    --tag-ink: #ffffff;
                }

                &.blue {
                    --tag-fill: linear-gradient(
                        160deg,
                        rgba(70, 110, 255, 0.24),
                        rgba(22, 21, 30, 0.5)
                    );
                    --tag-ring: linear-gradient(
                        150deg,
                        rgba(140, 170, 255, 0.75),
                        rgba(140, 170, 255, 0.2) 45%,
                        rgba(140, 170, 255, 0.5)
                    );
                    --tag-ink: #d3deff;
                }

                &.premium {
                    --tag-fill: linear-gradient(150deg, #ffffff, #d9ceff);
                    --tag-ring: linear-gradient(
                        150deg,
                        #ffffff,
                        rgba(143, 123, 255, 0.6)
                    );
                    --tag-ink: #131316;
                    --tag-shadow: 0 0 18px -6px rgba(180, 150, 255, 0.6);
                }
            }
        }
    }

    .stage {
        display: flex;
        align-items: center;
        min-height: 1.5rem;
        margin: 0.75rem 0 0;
    }

    .tag {
        padding: 0.125rem 0.625rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--ks-content-link) 12%, transparent);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--ks-content-link);
    }

    .price {
        margin: 0.75rem 0 0;
        font-size: clamp(2.25rem, 3.4vw, 3rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--ks-content-primary);
    }

    .text {
        max-width: 19rem;
        margin: 1.25rem 0 0;
        font-size: $font-size-md;
        line-height: 1.55;
        color: var(--ks-content-secondary);

        @include media-breakpoint-up(lg) {
            min-height: 4.65em;
        }
    }

    .panel > a {
        width: min(100%, 19rem);
        margin-top: 1.5rem;
    }

    .more {
        min-height: 1.5rem;
        margin: 0.875rem 0 0;
        font-size: 0.9375rem;

        a {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            font-weight: 600;
            color: var(--ks-content-primary);
            text-decoration: none;

            @include arrow-nudge;

            &:hover {
                color: var(--ks-content-link);
            }
        }
    }

    .features {
        display: grid;
        gap: 0.75rem;
        margin: 1.75rem 0 0;
        padding: 0 1.5rem;
        list-style: none;

        li {
            display: grid;
            grid-template-columns: 1.125rem minmax(0, 1fr);
            gap: 0.625rem;
            font-size: 0.9375rem;
            line-height: 1.5;
            color: var(--ks-content-primary);
        }

        :global(svg) {
            width: 1.125rem;
            height: 1.125rem;
            margin-top: 0.15em;
            color: var(--ks-content-link);
        }
    }

    .ideal {
        margin: auto 0 0;
        padding: 1.75rem 1.5rem 0;
        font-size: $font-size-sm;
        line-height: 1.55;
        color: var(--ks-content-tertiary);
    }
</style>
