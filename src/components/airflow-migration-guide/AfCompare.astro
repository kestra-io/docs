---
import { Icon } from "astro-icon/components"
import airflowMark from "~/components/versus/assets/airflow-monograme.svg"
import kestraMark from "~/components/home/assets/ai/kestra-logo-mark-on-dark.svg"
import ControlPlaneTopology from "~/components/home/ControlPlaneTopology.astro"
import { AF_DAG_FILE, EX4_KESTRA } from "./code"

const escape = (text: string) =>
    text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")

const python = (line: string) =>
    escape(line).replace(
        /("[^"]*")|(@\w+(?:\(\))?)|\b(def|return|import|from|None|with)\b|\b(requests|get|print|raise_for_status|json|xcom_push|partial|expand|datetime)\b/g,
        (match, str, deco, kw, fn) =>
            str
                ? `<span class="s">${match}</span>`
                : deco
                  ? `<span class="d">${match}</span>`
                  : kw
                    ? `<span class="k">${match}</span>`
                    : fn
                      ? `<span class="f">${match}</span>`
                      : match,
    )

const pebble = (value: string) =>
    escape(value).replace(
        /(\{\{)(.*?)(\}\})/g,
        '<span class="pbd">$1</span><span class="pbv">$2</span><span class="pbd">$3</span>',
    )

const KESTRA_LINES = EX4_KESTRA.split("\n")
const startOf = (needle: string) =>
    KESTRA_LINES.findIndex((line) => line.includes(needle)) + 1
const MARKS: Record<string, [number, number]> = {
    get_astronauts: [
        startOf("- id: get_astronauts"),
        startOf("- id: print_astronaut_craft") - 2,
    ],
    print_astronaut_craft: [
        startOf("- id: print_astronaut_craft"),
        startOf("triggers:") - 2,
    ],
    daily: [startOf("triggers:"), KESTRA_LINES.length],
}
const markAt = (row: number) =>
    Object.entries(MARKS).find(([, [a, b]]) => row >= a && row <= b)?.[0]

let block = -1
const FLOW_LINES = KESTRA_LINES.map((text, i) => {
    const indent = text.match(/^\s*/)?.[0].length ?? 0
    if (block >= 0 && text.trim() !== "" && indent <= block) block = -1
    let html: string
    if (block >= 0) html = python(text)
    else {
        const m = text.match(/^(\s*)(- )?([\w.]+)(:)(\s*)(.*)$/)
        if (!m) html = escape(text)
        else {
            const [, ind, dash = "", key, colon, space, value] = m
            if (value.trim() === "|") block = indent
            const cls = /^["']/.test(value) ? "s" : "v"
            html = `${ind}<span class="p">${dash}</span><span class="y">${key}${colon}</span>${space}<span class="${cls}">${pebble(value)}</span>`
        }
    }
    return { html, mark: markAt(i + 1) }
})

const AF_CODE = AF_DAG_FILE.split("\n").map(python)

const TOPOLOGY = [
    {
        id: "daily",
        type: "core.trigger.Schedule",
        plugin: "core.trigger.Schedule",
        fallback: "mdi:calendar-clock",
        x: 0,
        y: 70,
        status: "success" as const,
        duration: "0s",
        seconds: 0.01,
    },
    {
        id: "get_astronauts",
        type: "scripts.python.Script",
        plugin: "scripts.python.Script",
        fallback: "mdi:language-python",
        x: 310,
        y: 70,
        status: "success" as const,
        duration: "3.1s",
        seconds: 3.1,
    },
    {
        id: "print_astronaut_craft",
        type: "core.flow.Loop",
        plugin: "core.flow.Loop",
        fallback: "mdi:repeat",
        x: 620,
        y: 70,
        status: "success" as const,
        duration: "1.8s",
        seconds: 1.8,
    },
]

const FEED = [
    {
        node: 1,
        at: "start",
        time: "11:05:13",
        who: "get_astronauts",
        what: "Installing packages with uv",
    },
    {
        node: 1,
        at: "done",
        time: "11:05:15",
        who: "get_astronauts",
        what: "Exit code 0 · number_of_people_in_space 12",
        tone: "ok",
    },
    {
        node: 2,
        at: "done",
        time: "11:05:17",
        who: "greet",
        what: "Oleg Kononenko is currently in space flying on the ISS! Hello! :)",
        tone: "ok",
    },
]

const K_TABS = [
    { icon: "mdi:code-tags", label: "Flow Code", on: true },
    { icon: "mdi:gesture-tap", label: "No-code" },
    { icon: "mdi:sitemap-outline", label: "Topology", on: true },
    { icon: "mdi:file-document-outline", label: "Docs" },
    { icon: "mdi:folder-outline", label: "Files" },
    { icon: "mdi:view-grid-plus-outline", label: "Blueprints" },
]

const AF_NAV = [
    { icon: "mdi:home-outline", label: "Home" },
    { icon: "mdi:source-branch", label: "Dags", on: true },
    { icon: "mdi:database-outline", label: "Assets" },
    { icon: "mdi:web", label: "Browse" },
    { icon: "mdi:cog-outline", label: "Admin" },
]
const AF_TABS = [
    "mdi:chart-bar",
    "mdi:chart-timeline-variant",
    "mdi:source-commit",
    "mdi:calendar-blank-outline",
    "mdi:undo-variant",
    "mdi:file-document-outline",
    "mdi:code-tags",
    "mdi:alert-outline",
]
interface Props {
    bare?: boolean
}

const { bare = false } = Astro.props
const Wrapper = bare ? "div" : "section"
---

<Wrapper
    class:list={["af-compare", { bare }]}
    aria-labelledby={bare ? undefined : "af-compare-title"}
>
    <div class="container-xl">
        <div class="rails">
            {!bare && (
                <header class="head">
                    <h2 id="af-compare-title">The Airflow UI next to Kestra</h2>
                    <p>
                        An Airflow DAG that fetches who is in space and runs one task
                        per astronaut, and the same pipeline in Kestra. The fetch
                        code is unchanged. The XCom push becomes Kestra.outputs()
                        and .expand() becomes a Loop.
                    </p>
                </header>
            )}
            <div class="stage">
                <div class="compare" data-compare>
                    <div
                        class="layer af"
                        role="img"
                        aria-label="The example_astronauts DAG in the Airflow UI after a successful run: the Code tab next to the Graph view with get_astronauts and 12 mapped print_astronaut_craft tasks."
                    >
                        <aside class="af-rail">
                            <img src={airflowMark.src} alt="" />
                            {AF_NAV.map((item) => (
                                <span
                                    class:list={["rail-item", { on: item.on }]}
                                >
                                    <Icon name={item.icon} />
                                    {item.label}
                                </span>
                            ))}
                            <span class="rail-item docs">
                                <Icon name="mdi:book-open-outline" />
                                Docs
                            </span>
                        </aside>
                        <div class="af-main">
                            <div class="af-top">
                                <span class="crumb">
                                    <small>Dag</small>
                                    example_astronauts
                                </span>
                                <span class="search">
                                    <Icon name="mdi:magnify" /> Search Dags
                                </span>
                                <span class="trigger">
                                    <Icon name="mdi:play-outline" /> Trigger
                                </span>
                            </div>
                            <div class="cols">
                                <div class="af-graph">
                                    <div class="af-tools">
                                        <span>
                                            <Icon name="mdi:view-grid-outline" />
                                        </span>
                                        <span class="on">
                                            <Icon name="mdi:sitemap-outline" />
                                        </span>
                                    </div>
                                    <div class="af-nodes">
                                        <div class="af-node">
                                            <strong>
                                                <Icon name="mdi:source-commit" />{" "}
                                                get_astronauts
                                            </strong>
                                            <small>@task</small>
                                            <em>
                                                <Icon name="mdi:check" />{" "}
                                                success
                                            </em>
                                        </div>
                                        <span class="af-edge"></span>
                                        <div class="af-node mapped">
                                            <strong>
                                                <Icon name="mdi:source-commit" />{" "}
                                                print_astronaut_craft [12]
                                            </strong>
                                            <small>@task</small>
                                            <em>
                                                <Icon name="mdi:check" />{" "}
                                                success
                                            </em>
                                            <b></b>
                                        </div>
                                    </div>
                                </div>
                                <div class="af-panel">
                                    <div class="af-head">
                                        <span class="name">
                                            <Icon name="mdi:source-branch" />
                                            example_astronauts
                                            <span class="switch">
                                                <i></i>
                                            </span>
                                        </span>
                                        <dl>
                                            <div>
                                                <dt>Schedule</dt>
                                                <dd>0 0 * * *</dd>
                                            </div>
                                            <div>
                                                <dt>Latest Run</dt>
                                                <dd class="link">
                                                    2026-11-24 12:18:17{" "}
                                                    <Icon
                                                        name="mdi:check-circle"
                                                        class="ok"
                                                    />
                                                </dd>
                                            </div>
                                            <div>
                                                <dt>Next Run</dt>
                                                <dd>2026-11-25 01:00:00</dd>
                                            </div>
                                            <div>
                                                <dt>Max Active Runs</dt>
                                                <dd>0 of 16</dd>
                                            </div>
                                            <div>
                                                <dt>Owner</dt>
                                                <dd class="link">airflow</dd>
                                            </div>
                                            <div>
                                                <dt>Latest Dag Version</dt>
                                                <dd>v1</dd>
                                            </div>
                                        </dl>
                                    </div>
                                    <div class="af-tabs">
                                        {AF_TABS.map((icon) => (
                                            <span
                                                class:list={{
                                                    on:
                                                        icon ===
                                                        "mdi:code-tags",
                                                }}
                                            >
                                                <Icon name={icon} />
                                            </span>
                                        ))}
                                    </div>
                                    <div class="af-file">
                                        example_astronauts.py
                                    </div>
                                    <pre class="af-code">{AF_CODE.map((line, i) => (
                                        <span class="ln"><i>{i + 1}</i><Fragment set:html={line} /></span>
                                    ))}</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div
                        class="layer ks"
                        role="img"
                        aria-label="The same pipeline in the Kestra flow editor, with Flow Code and Topology open side by side while an execution runs get_astronauts and the print_astronaut_craft loop."
                        data-ks
                    >
