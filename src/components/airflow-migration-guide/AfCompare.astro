                                    <Icon name="mdi:download" /> Export flow
                                </span>
                                <span class="ks-btn">Save</span>
                            </span>
                        </div>
                        <div class="ks-tabs">
                            {K_TABS.map((tab) => (
                                <span class:list={{ on: tab.on }}>
                                    <Icon name={tab.icon} />
                                    {tab.label}
                                </span>
                            ))}
                        </div>
                        <div class="cols">
                            <div class="ks-panel">
                                <div class="ks-ptab">
                                    <Icon name="mdi:code-tags" /> Flow Code{" "}
                                    <Icon name="mdi:close" class="x" />
                                </div>
                                <pre class="ks-code">{FLOW_LINES.map((line, i) => (
                                    <span class="line" data-k={line.mark}><i class="no">{i + 1}</i><Fragment set:html={line.html} /></span>
                                ))}</pre>
                            </div>
                            <div class="ks-panel">
                                <div class="ks-ptab">
                                    <Icon name="mdi:sitemap-outline" /> Topology{" "}
                                    <Icon name="mdi:close" class="x" />
                                </div>
                                <div class="ks-topology surface-dark">
                                    <ControlPlaneTopology
                                        nodes={TOPOLOGY}
                                        label="Kestra topology of the example_astronauts flow: a daily schedule, the get_astronauts script, then a loop over each astronaut"
                                    />
                                </div>
                                <ol
                                    class="feed"
                                    aria-hidden="true"
                                    data-feed
                                ></ol>
                                <script
                                    type="application/json"
                                    data-feed-rows
                                    set:html={JSON.stringify(FEED)}
                                />
                            </div>
                        </div>
                    </div>
                    <input
                        type="range"
                        min="0"
                        max="100"
                        step="0.1"
                        value="50"
                        aria-label="Compare the Airflow DAG with the Kestra flow"
                    />
                    <div class="handle" aria-hidden="true">
                        <span class="knob">
                            <Icon name="mdi:chevron-left" />
                            <Icon name="mdi:chevron-right" />
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Wrapper>

<script>
    const ORDER = ["daily", "get_astronauts", "print_astronaut_craft"]

    function wire() {
        document
            .querySelectorAll<HTMLElement>("[data-compare]:not([data-wired])")
            .forEach((root) => {
                root.dataset.wired = ""
                const input = root.querySelector<HTMLInputElement>("input")!
                const ks = root.querySelector<HTMLElement>("[data-ks]")!
                input.addEventListener("input", () =>
                    root.style.setProperty("--pos", `${input.value}%`),
                )

                const lines = [...ks.querySelectorAll<HTMLElement>(".line")]
                const nodes = [
                    ...ks.querySelectorAll<HTMLElement>("[data-node]"),
                ]
                const feed = ks.querySelector<HTMLOListElement>("[data-feed]")!
                const rows: {
                    node: number
                    at: string
                    time: string
                    who: string
                    what: string
                    tone?: string
                }[] = JSON.parse(
                    ks.querySelector("[data-feed-rows]")!.textContent ?? "[]",
                )
                let shown = 0
                const sync = () => {
                    const state = nodes.map((node) =>
                        node.classList.contains("is-success")
                            ? 2
                            : node.classList.contains("is-running")
                              ? 1
                              : 0,
                    )
                    const due = rows.filter(
                        (row) => state[row.node] >= (row.at === "done" ? 2 : 1),
                    )
                    if (due.length < shown) {
                        feed.replaceChildren()
                        shown = 0
                    }
                    for (const row of due.slice(shown)) {
                        const li = document.createElement("li")
                        if (row.tone) li.dataset.tone = row.tone
                        for (const [cls, text] of [
                            ["time", row.time],
                            ["who", row.who],
                            ["what", row.what],
                        ]) {
                            const cell = document.createElement("span")
                            cell.className = cls
                            cell.textContent = text
                            li.appendChild(cell)
                        }
                        feed.insertBefore(li, feed.firstChild)
                        while (feed.children.length > 3)
                            feed.lastElementChild!.remove()
                    }
                    shown = due.length
                    const running = nodes.findIndex((node) =>
                        node.classList.contains("is-running"),
                    )
                    const focus = running >= 0 ? ORDER[running] : ""
                    lines.forEach((line) =>
                        line.classList.toggle(
                            "on",
                            !!focus && line.dataset.k === focus,
                        ),
                    )
                    const first = lines.find((line) =>
                        line.classList.contains("on"),
                    )
                    const pre = first?.closest<HTMLElement>("pre")
                    if (first && pre)
                        pre.scrollTo({
                            top: Math.max(0, first.offsetTop - 24),
                            behavior: "smooth",
                        })
                }
                const observer = new MutationObserver(sync)
                nodes.forEach((node) =>
                    observer.observe(node, {
                        attributes: true,
                        attributeFilter: ["class"],
                    }),
                )
            })
    }

    wire()
    document.addEventListener("astro:page-load", wire)
</script>

<style lang="scss">
    @use "/src/components/migration/migration" as *;

    .af-compare:not(.bare) {
        @include band;
    }

    .bare {
        .container-xl {
            max-width: none;
            padding: 0;
        }

        .rails {
            border: 0;
        }

        .stage {
            padding: 0;
        }

        .compare {
            border-color: #2e2e3c;
            box-shadow: 0 30px 80px -24px rgba(0, 0, 0, 0.6);
        }
    }

