---
import { Icon } from "astro-icon/components"
import Link from "~/components/common/Link.astro"
import SectionTitle from "./SectionTitle.astro"
import Pill from "./Pill.astro"
import PointScan from "./assets/point-scan.svg"

interface Props {
    contributingUrl: string
    codeOfConductUrl: string
}

const { contributingUrl, codeOfConductUrl } = Astro.props

const securityAdvisoryUrl =
    "https://github.com/kestra-io/kestra/security/advisories/new"

interface Rule {
    badge: string
    title: string
    text?: string
    items?: string[]
}

const RULES: Rule[] = [
    {
        badge: "Before you write code",
        title: "Follow the rules to ensure your submission qualifies",
        items: [
            "Only 2 PRs per participant can be open at any given time",
            "The same issue can have PRs submitted by multiple participants. The PRs will be merged on a first-come, first-served basis and based on quality of PR",
            "PRs for good-first-issues must include a before and after screenshot where the change is visible",
            "Must publish a minimum of one social media post that mentions your participation in Kestra's Hacktober and what you have worked on",
            "Typo-only, whitespace and auto-generated changes are closed as invalid PRs",
        ],
    },
    {
        badge: "Legal notice",
        title: "The work has to be yours",
        text: "By contributing you confirm you authored 100% of the content, that you hold the rights to it, and that it can be provided under the project licence. This is also why generated boilerplate you haven't reviewed and can't explain will not be merged.",
    },
]

const NEEDS = [
    "Java 25+",
    "Node 24+ · npm 11+",
    "Python 3 · pip · venv",
    "Docker + Compose",
]
---

<section class="hf-guidelines" aria-labelledby="hf-guidelines-title">
    <div class="container">
        <SectionTitle
            id="hf-guidelines-title"
            align="center"
            title="Contribution Rules"
        />

        <div class="body">
            <div class="rules">
                {
                    RULES.map((rule, index) => (
                        <article
                            class="rule"
                            data-usal={`fade-u duration-400 delay-${100 + index * 50} ease-out`}
                        >
                            <Pill tone="info">{rule.badge}</Pill>
                            <h3>{rule.title}</h3>
                            {rule.text && <p>{rule.text}</p>}
                            {rule.items && (
                                <ul class="rule-items">
                                    {rule.items.map((item) => (
                                        <li>
                                            <PointScan />
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </article>
                    ))
                }
            </div>

            <div
                class="build"
                data-usal="fade-u duration-400 delay-200 ease-out"
            >
                <div class="build-main">
                    <div class="how">
                        <div class="how-copy">
                            <h3>
                                <Icon name="mdi:hammer-wrench" />
                                Building Kestra locally
                            </h3>
                            <p>
                                Fork the repository, then clone your fork. The
                                backend is <strong>Micronaut</strong> and runs on
                                port <strong>8080</strong>; the frontend is <strong
                                    >Vue.js</strong
                                > under <code>/ui</code> and runs on port <strong
                                    >5173</strong
                                > with <code>npm run dev</code>.
                            </p>
                        </div>
                        <div class="how-links">
                            <Link
                                href={contributingUrl}
                                text="Read the full contributing guide"
                            />
                            <p class="also">
                                Also see the <a
                                    href="/docs/plugin-developer-guide"
                                    >plugin developer guide</a
                                >
                            </p>
                        </div>
                    </div>

                    <div class="needs">
                        <h4>You'll need</h4>
                        <ul>
                            {
                                NEEDS.map((need) => (
                                    <li>
                                        <Icon name="mdi:check" />
                                        <code>{need}</code>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>

                <p class="conduct">
                    <Icon name="mdi:shield-outline" />
                    <span>
                        Covered by the Kestra <a href={codeOfConductUrl}
                            >code of conduct</a
                        > · security issues go through a <a
                            class="report"
                            href={securityAdvisoryUrl}
                            target="_blank"
                            rel="noopener">private security advisory</a
                        >, not public posts
                    </span>
                </p>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .hf-guidelines {
        padding: 5.625rem 1rem;
        border-bottom: 1px solid var(--ks-border-primary);
        background: var(--ks-background-primary);

        @include media-breakpoint-down(md) {
            padding-block: 3.5rem;
        }
    }

    .container {
        display: flex;
        flex-direction: column;
        gap: 4rem;

        @include media-breakpoint-down(md) {
            gap: 2.5rem;
        }
    }

    .body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .rules {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;

        @include media-breakpoint-down(md) {
            grid-template-columns: 1fr;
        }
    }

    .rule {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 2rem;
        border: 1px solid var(--hf-card-border, var(--ks-border-primary));
        border-radius: 8px;
        background: var(--hf-card-background, var(--ks-background-primary));
        box-shadow: 0 2px 4px var(--ks-shadows-light);
        color: var(--ks-content-primary);

        h3 {
            margin: 0;
            font-size: $font-size-2xl;
            font-weight: 600;
            line-height: 38px;

            @include media-breakpoint-down(md) {
                font-size: $font-size-xl;
                line-height: 1.3;
            }
        }

        p {
            margin: 0;
            font-size: $font-size-md;
            line-height: 24px;
        }

        .rule-items {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin: 0;
            padding: 0;
            list-style: none;

            li {
                display: flex;
                align-items: flex-start;
                gap: 0.5rem;
                color: var(--ks-content-secondary);
                font-size: $font-size-md;
                line-height: 24px;

                svg {
                    flex: none;
                    width: 20px;
                    height: 20px;
                    margin-top: 2px;
                    color: var(--ks-content-color-highlight);
                }
            }
        }
    }

    .build {
        border-radius: 8px;
        background: var(--ks-background-blue-light);
        overflow: hidden;
    }

    .build-main {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 4rem 2rem;

        @include media-breakpoint-down(lg) {
            flex-direction: column;
            align-items: stretch;
            padding: 2rem 1.5rem;
        }
    }

    .how {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding-left: 4rem;
        color: var(--ks-content-primary);

        @include media-breakpoint-down(lg) {
            padding-left: 0;
        }

        .how-copy {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        h3 {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            font-size: $font-size-2xl;
            font-weight: 600;
            line-height: 38px;

            svg {
                flex: none;
                width: 48px;
                height: 48px;
                color: var(--ks-border-alert-info);
            }

            @include media-breakpoint-down(md) {
                font-size: $font-size-xl;
                line-height: 1.3;

                svg {
                    width: 32px;
                    height: 32px;
                }
            }
        }

        p {
            margin: 0;
            font-size: $font-size-md;
            line-height: 24px;

            code {
                color: var(--ks-content-color-highlight);
                font-family: $font-family-monospace;
                font-size: $font-size-md;
            }
        }

        .how-links {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .also {
            color: var(--ks-content-tertiary);
            font-size: $font-size-sm;
            line-height: 20px;

            a {
                color: inherit;
                text-decoration: underline;

                &:hover {
                    color: var(--ks-content-link);
                }
            }
        }
    }

    .needs {
        flex: 0 0 415px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-inline: 2rem;
        border-left: 1px solid var(--ks-border-secondary);

        @include media-breakpoint-down(lg) {
            flex: none;
            padding: 1.5rem 0 0;
            border-left: 0;
            border-top: 1px solid var(--ks-border-secondary);
        }

        h4 {
            margin: 0;
            color: var(--ks-content-tertiary);
            font-size: $font-size-md;
            font-weight: 600;
            line-height: 24px;
            text-transform: uppercase;
        }

        ul {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            display: flex;
            align-items: center;
            gap: 0.5rem;

            svg {
                flex: none;
                width: 20px;
                height: 20px;
                color: var(--ks-content-color-highlight);
            }

            code {
                color: var(--ks-content-primary);
                font-family: $font-family-monospace;
                font-size: $font-size-sm;
                line-height: 24px;
            }
        }
    }

    .conduct {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        margin: 0;
        padding: 1rem 2rem;
        border-top: 1px solid var(--ks-border-secondary);
        color: var(--ks-content-secondary);
        font-size: $font-size-sm;
        line-height: 20px;
        text-align: center;

        svg {
            flex: none;
            width: 20px;
            height: 20px;
            color: var(--ks-content-color-highlight);
        }

        a {
            color: inherit;
            text-decoration: underline;

            &:hover {
                color: var(--ks-content-link);
            }
        }

        a.report {
            color: var(--ks-content-link);
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }
    }
</style>
