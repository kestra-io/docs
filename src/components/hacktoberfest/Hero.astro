---

<section class="hf-hero" aria-labelledby="hf-hero-title">
    <PixelSquares squares={SQUARES} mobile={MOBILE_SQUARES} />
    <div class="content">
        <p class="lockup" data-usal="fade-u delay-0 duration-500 ease-out">
            <span class="visually-hidden">Kestra × Hacktoberfest 26</span>
            <svg class="pixel-mark" viewBox="0 0 5 5" aria-hidden="true">
                {
                    MARK_CELLS.map(([x, y, fill]) => (
                        <rect {x} {y} width="1" height="1" {fill} />
                    ))
                }
            </svg>
            <span class="times" aria-hidden="true">x</span>
            <Wordmark class="wordmark" aria-hidden="true" />
        </p>

        <h1
            id="hf-hero-title"
            data-usal="fade-u delay-50 duration-500 ease-out"
        >
            Put your October pull requests into Kestra<span class="dot">.</span>
        </h1>

        <p
            class="standfirst"
            data-usal="fade-u delay-100 duration-500 ease-out"
        >
            Two tracks, two podiums, and Kestra merch and goodies for everyone
            who lands a merge. Registration is open, submissions run{" "}
            <strong>October 1 to 31.</strong>
        </p>

        <dl
            class="facts"
            aria-label="The hackathon at a glance"
            data-usal="fade-u delay-150 duration-500 ease-out"
        >
            {
                KEY_FACTS.map((fact) => (
                    <div>
                        <dt>{fact.value}</dt>
                        <dd>{fact.label}</dd>
                    </div>
                ))
            }
        </dl>

        <div class="buttons" data-usal="fade-u delay-200 duration-500 ease-out">
            <a
                href={registerUrl}
                class="btn btn-lg btn-primary"
                target="_blank"
                rel="noopener">Register now</a
            >
            <a href={rulesHref} class="btn btn-lg btn-secondary">How to enter</a
            >
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/assets/styles/buttons" as *;

    .hf-hero {
        --header-h: var(--top-bar-height, 67px);

        position: relative;
        isolation: isolate;
        margin-top: calc(-1 * var(--header-h));
        padding: calc(var(--header-h) + 4rem) 1rem 3.125rem;
        overflow: clip;
        background: var(--hf-background-dark);
        color: var(--hf-content-dark);
        text-align: center;

        @include media-breakpoint-down(md) {
            padding: calc(var(--header-h) + 2.1875rem) 2rem 7.75rem;
            text-align: left;
        }

        :global(.pixel-squares) {
            clip-path: inset(var(--header-h) 0 0 0);
        }
    }

    .content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2.125rem;
        max-width: 1200px;
        margin-inline: auto;

        @include media-breakpoint-down(md) {
            align-items: flex-start;
            gap: 0.5rem;
        }
    }

    .lockup {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        margin: 0 0 4px;

        .pixel-mark {
            width: 23px;
            height: 23px;
        }

        .times {
            color: var(--hf-content-dark-tertiary);
            font-size: $font-size-sm;
            line-height: 20px;
        }

        .wordmark {
            width: 191px;
            height: 19px;
            color: var(--hf-content-dark);
        }
    }

    h1 {
        max-width: 1100px; 
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 600;
        font-feature-settings: "ss01", "ss06", "ss07";
        letter-spacing: -0.02em;
        line-height: 0.94;
        color: var(--hf-content-dark);
        text-wrap: balance;

        .dot {
            color: var(--hf-pixel-magenta);
        }

        @include media-breakpoint-down(md) {
            margin-top: 0.5rem;
            font-size: 2.125rem;
            line-height: 39px;
            text-wrap: wrap;
        }
    }

    .standfirst {
        max-width: 780px;
        margin: 0;
        color: var(--hf-content-dark-secondary);
        font-size: 1.25rem;
        line-height: 1.2;

        strong {
            font-weight: 700;
        }

        @include media-breakpoint-down(md) {
            margin-top: 1.5rem;
            font-size: $font-size-sm;
            line-height: 24px;
        }
    }

    .facts {
        display: flex;
        width: 100%;
        max-width: 672px;
        margin: 0;
        padding: 10px 30px;
        border: 1px solid var(--hf-border-dark);
        border-radius: 4px;
        background: linear-gradient(
            180deg,
            rgba($white, 0.04),
            rgba($white, 0)
        );

        > div {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;

            + div {
                border-left: 1px solid var(--hf-border-dark);
            }
        }

        dt {
            font-size: 1.75rem;
            font-weight: 600;
            line-height: 2rem;
            color: var(--hf-content-dark);
        }

        dd {
            margin: 0;
            color: var(--hf-content-dark-muted);
            font-size: $font-size-xs;
            line-height: 18px;
        }

        @include media-breakpoint-down(md) {
            gap: 0.5rem;
            padding-inline: 0.5rem;
            text-align: center;
        }
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.125rem;
        width: 100%;
        margin-top: 1.875rem;

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 180px;
            min-height: 56px;
            border-radius: 8px;
            font-size: $font-size-lg;
        }

        .btn-secondary {
            @include btn-secondary-light-surface;
            --ks-border-button-secondary: var(--hf-content-dark-tertiary);
        }

        @include media-breakpoint-down(md) {
            flex-direction: column;
            gap: 0.5rem;
            margin-top: 1.5rem;

            .btn {
                width: 100%;
                min-height: 50px;
                font-size: $font-size-md;
            }
        }
    }
</style>
