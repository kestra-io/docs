---
import RocketSky from "./RocketSky.astro"
---

<section class="run-kestra" aria-labelledby="run-kestra">
    <RocketSky />
    <div class="container-xl">
        <div class="stage">
            <header class="head">
                <h2 id="run-kestra">Three ways to run Kestra</h2>
                <p>
                    Try it alone, try it managed, or talk to an expert who has
                    done the migration before.
                </p>
            </header>

            <div class="side">
                <div class="editions surface-dark" data-rocket-steer>
                    <article class="edition" data-edition="core">
                        <h3>Kestra Core</h3>
                        <p class="badge">Open Source</p>
                        <p>
                            Where most teams start, and where many experiment
                            with a first production. Self-hosted and free, with
                            no limits on flows or executions.
                        </p>
                        <a href="/get-started" class="btn-ghost compact">
                            Get started
                        </a>
                    </article>

                    <article class="edition" data-edition="cloud">
                        <h3>Kestra Cloud</h3>
                        <p class="badge">Early Access</p>
                        <p>
                            Managed by the people who build Kestra. No platform
                            to run, pay for what you use.
                        </p>
                        <a href="/cloud" class="btn-ghost compact">
                            Try Kestra Cloud
                        </a>
                    </article>

                    <article class="edition featured" data-edition="enterprise">
                        <h3>Kestra Enterprise</h3>
                        <p>
                            The Kestra experience scaled for the enterprise:
                            multi-team organization, security and governance,
                            support with SLAs. Self-hosted, cloud or air-gapped.
                        </p>
                        <a href="/demo" class="btn-solid compact">
                            Book a demo
                        </a>
                    </article>
                </div>
                <a href="/pricing" class="compare">
                    Find the edition that fits your team{" "}
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .run-kestra {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                50% 60% at 78% 30%,
                rgba(120, 70, 255, 0.14),
                transparent 70%
            ),
            #08070d;
        color: #ffffff;
        --rule-color: rgba(255, 255, 255, 0.13);
        --rule: 1px solid var(--rule-color);
        --inset: clamp(1.5rem, 3vw, 2.75rem);
    }

    .stage {
        position: relative;
        z-index: 1;
        display: grid;
        justify-items: start;
        gap: clamp(2.5rem, 4vw, 3.5rem);
        max-width: 76rem;
        margin-inline: auto;
        padding: clamp(5rem, 9vw, 8rem) clamp(1rem, 5vw, 4rem);

        @include media-breakpoint-down(lg) {
            padding-top: 15rem;
        }
    }

    .head {
        max-width: 40rem;

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: #ffffff;
            text-shadow: 0 0 1.5rem rgba(8, 7, 13, 0.8);
        }

        p {
            max-width: 34rem;
            margin: 1.25rem 0 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.72);
            text-shadow: 0 0 1rem rgba(8, 7, 13, 0.8);
        }
    }

    .side {
        width: min(61rem, 100%);
    }

    .editions {
        border: var(--rule);
        border-radius: 10px;
        background: rgba(14, 12, 22, 0.55);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .editions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        width: 100%;
        overflow: hidden;

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .edition {
        position: relative;
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
        padding: 2rem var(--inset) 2.25rem;
        transition: background-color 0.3s ease;

        @media (hover: hover) {
            &:hover {
                background: rgba(255, 255, 255, 0.05);
            }
        }

        &:focus-within {
            background: rgba(255, 255, 255, 0.05);
        }

        & + & {
            border-left: var(--rule);

            @include media-breakpoint-down(lg) {
                border-left: 0;
                border-top: var(--rule);
            }
        }

        > a {
            display: flex;
            justify-content: center;
            width: 100%;
            margin-top: auto;
        }
    }

    .compare {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.375rem;
        justify-content: flex-start;
        padding: 1.5rem 0 0;
        font-size: 0.9375rem;
        font-weight: 600;
        color: #ffffff;
        text-shadow: 0 0 0.75rem rgba(8, 6, 18, 0.9);
        text-decoration: none;
        transition: color 0.2s ease;

        span {
            transition: translate 0.2s ease;
        }

        &:hover {
            color: #c4b8ff;

            span {
                translate: 0.25em 0;
            }
        }
    }

    .badge {
        margin: 0 0 0.75rem;
        align-self: flex-start;
        padding: 0.125rem 0.625rem;
        background: rgba(167, 150, 255, 0.16);
        font-size: 0.75rem;
        font-weight: 600;
        color: #c4b8ff;
    }

    h3 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        font-weight: 600;
        color: #ffffff;
    }

    .edition p:not(.badge) {
        max-width: 30rem;
        margin: 0 0 0.75rem;
        font-size: 0.9375rem;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.7);

        &:last-of-type {
            margin-bottom: 1.25rem;
        }
    }
</style>
