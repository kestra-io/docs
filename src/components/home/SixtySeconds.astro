---
interface Props {
    /** YouTube video id, e.g. "1DMXb98nTik". */
    videoId?: string
    /** Accessible name for the dialog and the iframe. */
    title?: string
    /** Unique dialog id; needed when several dialogs share a page. */
    id?: string
    /** Classes for the trigger button. Defaults to the site's primary button. */
    class?: string
    [x: string]: any
}

const {
    videoId = "1DMXb98nTik",
    title = "Kestra in 60 seconds",
    id = "sixty-seconds-modal",
    class: className = "btn btn-lg btn-primary",
    ...rest
} = Astro.props
---

<button class={className} command="show-modal" commandfor={id} {...rest}>
    <slot>See Kestra in 60 seconds</slot>
</button>
<dialog
    {id}
    closedby="any"
    aria-label={title}
    data-video-id={videoId}
    data-video-title={title}
>
    <div class="modal-header">
        <button
            type="button"
            class="btn-close"
            commandfor={id}
            command="close"
            aria-label="Close">X</button
        >
    </div>
    <div class="modal-body">
        <div class="video-container"></div>
    </div>
</dialog>

<script>
    function initVideoDialogs() {
        const dialogs = document.querySelectorAll<HTMLDialogElement>(
            "dialog[data-video-id]",
        )

        for (const dialog of dialogs) {
            if (dialog.dataset.armed === "true") continue
            dialog.dataset.armed = "true"

            const container =
                dialog.querySelector<HTMLElement>(".video-container")
            const trigger = document.querySelector<HTMLElement>(
                `[command="show-modal"][commandfor="${dialog.id}"]`,
            )
            const closer =
                dialog.querySelector<HTMLElement>('[command="close"]')
            if (!container || !trigger) continue

            trigger.addEventListener("click", () => {
                if (!dialog.open) dialog.showModal()

                const existing = container.querySelector("iframe")
                if (existing) {
                    controlVideo("playVideo", existing)
                    return
                }

                const iframe = document.createElement("iframe")
                iframe.width = "100%"
                iframe.height = "100%"
                iframe.src = `https://www.youtube.com/embed/${dialog.dataset.videoId}?autoplay=1&enablejsapi=1`
                iframe.title = dialog.dataset.videoTitle ?? ""
                iframe.allow =
                    "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                iframe.allowFullscreen = true
                container.appendChild(iframe)
            })

            closer?.addEventListener("click", () => dialog.close())

            dialog.addEventListener("close", () => {
                const iframe = container.querySelector("iframe")
                if (iframe) controlVideo("stopVideo", iframe)
            })
        }
    }

    function controlVideo(func: string, iframe: HTMLIFrameElement) {
        iframe.contentWindow?.postMessage(
            JSON.stringify({ event: "command", func, args: "" }),
            "*",
        )
    }

    initVideoDialogs()
    document.addEventListener("astro:page-load", initVideoDialogs)
</script>

<style lang="scss">
    dialog {
        width: 95vw;
        aspect-ratio: 16 / 11;
        background: transparent;
        border: none;

        .btn-close {
            border: none;
            background: transparent;
            padding: 0.5rem;
            /* The backdrop is always dark, so this cannot follow the theme
               tokens: --ks-content-primary is dark in light mode and
               --ks-content-primary-inverse is dark in dark mode. */
            color: #fff;
            opacity: 0.75;
            transition: opacity 0.2s ease;

            &:hover,
            &:focus-visible {
                opacity: 1;
            }
        }
        .video-container {
            iframe {
                margin-inline: auto;
                display: none;
            }
        }
    }

    /* Open state of the dialog  */
    dialog:open {
        opacity: 1;
        transform: scale(1) translateY(0);
        font-size: 1.2rem;
        padding: 0.3rem;

        iframe {
            display: block;
        }
    }

    /* Closed state of the dialog   */
    dialog {
        opacity: 0;
        transform: scale(0.5) translateY(-15%);
        transition:
            opacity 0.4s ease-out,
            transform 0.4s ease-out,
            overlay 0.4s ease-out allow-discrete,
            display 0.4s ease-out allow-discrete;
    }

    /* Before open state  */
    /* Needs to be after the previous dialog:open rule to take effect,
        as the specificity is the same */
    @starting-style {
        dialog:open {
            opacity: 0;
            transform: scale(0.5) translateY(-15%);
        }
    }

    /* Transition the :backdrop when the dialog modal is promoted to the top layer */
    dialog::backdrop {
        background-color: transparent;
        transition:
            display 0.4s allow-discrete,
            overlay 0.4s allow-discrete,
            background-color 0.4s;
    }

    dialog:open::backdrop {
        background-color: rgb(0 0 0 / 80%);
    }

    /* This starting-style rule cannot be nested inside the above selector
    because the nesting selector cannot represent pseudo-elements. */
    @starting-style {
        dialog:open::backdrop {
            background-color: transparent;
        }
    }
</style>
