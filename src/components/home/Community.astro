---
import { Icon } from "astro-icon/components"
import SectionHead from "./SectionHead.astro"
import type { GitHubMetrics } from "~/components/community/types"
import { $fetchApiCachedOptional } from "~/utils/fetch"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"
import { fetchTotalBlueprintsCount } from "~/utils/blueprints/blueprintCount"

const [metrics, totalPlugins, totalBlueprints] = await Promise.all([
    $fetchApiCachedOptional<GitHubMetrics>("/communities/github/metrics", {
        signal: AbortSignal.timeout(3000),
    }),
    fetchTotalPluginsCount(),
    fetchTotalBlueprintsCount(),
])

const stars = metrics?.stars ? `${Math.floor(metrics.stars / 1000)}k+` : "28k+"

const STATS = [
    { icon: "mdi:star-outline", value: stars, label: "GitHub stars" },
    { icon: "mdi:puzzle-outline", value: `${totalPlugins}+`, label: "plugins" },
    {
        icon: "mdi:file-document-multiple-outline",
        value: `${totalBlueprints}+`,
        label: "blueprints, ready-to-use examples",
    },
]
---

<section class="community" aria-labelledby="community">
    <div class="container">
        <SectionHead id="community">
            Open by design, and powered by the community
            <Fragment slot="lead">
                Great software grows when users make it their own. Kestra’s
                engine is licensed under Apache 2.0 with a community that builds
                plugins, shares blueprints, and helps shape what comes next.
            </Fragment>
        </SectionHead>

        <ul>
            {
                STATS.map((stat) => (
                    <li>
                        <Icon name={stat.icon} />
                        <strong>{stat.value}</strong>
                        <span>{stat.label}</span>
                    </li>
                ))
            }
        </ul>

        <div class="buttons">
            <a
                href="https://github.com/kestra-io/kestra"
                class="btn btn-primary"
                target="_blank"
                rel="noopener"
            >
                <Icon name="mdi:github" /> Star on GitHub
            </a>
            <a href="/blueprints" class="btn btn-secondary">Browse blueprints</a
            >
        </div>
    </div>
</section>

<style lang="scss">
    .community {
        padding: 7rem 0;
        background: var(--ks-background-secondary);

        @include media-breakpoint-down(md) {
            padding: 4.5rem 0;
        }
    }

    ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
        max-width: 960px;
        margin: 0 auto;
        padding: 0;
        list-style: none;

        @include media-breakpoint-down(md) {
            grid-template-columns: 1fr;
        }
    }

    li {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1.5rem;
        border: 1px solid var(--ks-border-primary);
        border-radius: 1rem;
        background: var(--ks-background-primary);
        text-align: center;

        :global(svg) {
            width: 1.75rem;
            height: 1.75rem;
            margin-bottom: 1rem;
            color: var(--ks-content-link);
        }
    }

    strong {
        font-size: 2.5rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.05;
        color: var(--ks-content-primary);
    }

    span {
        margin-top: 0.375rem;
        color: var(--ks-content-secondary);
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2.5rem;

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;

            :global(svg) {
                width: 1.125rem;
                height: 1.125rem;
            }
        }
    }
</style>
