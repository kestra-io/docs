---
import { Icon } from "astro-icon/components"
import { API_URL } from "astro:env/client"
import kestraMark from "./assets/ai/kestra-logo-mark-on-dark.svg"
import PixelEdges from "~/components/about/PixelEdges.astro"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"

const totalPlugins = await fetchTotalPluginsCount()

const STEPS = [
    {
        title: "Declare",
        text: "Write the workflow in YAML with your favorite editor or coding agent, or build it in the visual editor. Every change is versioned, reviewable, and deployable via your CI/CD pipeline.",
    },
    {
        title: "Connect",
        text: `${totalPlugins}+ plugins, scripts in any language, containers. Kestra adapts to the tools and languages you already use.`,
    },
    {
        title: "Run and govern",
        text: "Apply permissions, capture audit trails, and monitor every execution, whether self-hosted, in the cloud, or air-gapped.",
    },
]

const FLOW = `id: nightly_close
namespace: finance

triggers:
  - id: schedule
    type: io.kestra.plugin.core.trigger.Schedule
    cron: "0 2 * * *"

tasks:
  - id: extract
    type: io.kestra.plugin.jdbc.postgresql.Query
    sql: SELECT * FROM ledger WHERE day = '{{ trigger.date }}'

  - id: approve # a human decides before anything moves
    type: io.kestra.plugin.core.flow.Pause

  - id: post_to_erp
    type: io.kestra.plugin.scripts.python.Script
    script: |
      post_journal(read_csv('{{ outputs.extract.uri }}'))`

// The flow's own plugins first, then a crowd of others around the editor.
const USED = [
    "core.trigger.Schedule",
    "jdbc.postgresql.Query",
    "core.flow.Pause",
    "scripts.python.Script",
]
// The carousel's plugins, the names people look for first.
const CROWD = [
    "aws.s3.Upload",
    "azure.storage.blob.Upload",
    "gcp.bigquery.Query",
    "servicenow.Post",
    "notifications.slack.SlackIncomingWebhook",
    "ansible.cli.AnsibleCLI",
    "openai.ChatCompletion",
    "huggingface.Inference",
    "anthropic.ChatCompletion",
    "ai.agent.AIAgent",
    "docker.Run",
    "dbt.cli.DbtCLI",
    "jdbc.mysql.Query",
    "kafka.Produce",
    "elasticsearch.Search",
    "jdbc.snowflake.Query",
    "databricks.job.CreateJob",
    "kubernetes.core.PodCreate",
    "terraform.cli.TerraformCLI",
    "mongodb.Find",
    "github.issues.Create",
    "airbyte.connections.Sync",
    "fivetran.connectors.Sync",
    "spark.SparkCLI",
    "gcp.vertexai.ChatCompletion",
    "redis.list.ListPush",
]

const fetchIcon = async (type: string) => {
    try {
        const response = await fetch(
            `${API_URL}/plugins/icons/io.kestra.plugin.${type}`,
        )
        if (!response.ok) return null
        return Buffer.from(await response.arrayBuffer()).toString("base64")
    } catch {
        return null
    }
}
// The API answers an unknown plugin with a generic icon: those are left
// out of the crowd.
const [generic, ...fetched] = await Promise.all(
    ["unknown.Plugin", ...USED, ...CROWD].map(fetchIcon),
)
const dataUri = (svg: string | null) =>
    svg && svg !== generic ? `data:image/svg+xml;base64,${svg}` : null
const icons = fetched.slice(0, USED.length).map(dataUri)

// The carousel behind the editor: each plugin once, as a CSS variable on
// the carousel so its icon is written out a single time.
const crowd = [
    ...new Set(
        fetched
            .slice(USED.length)
            .map(dataUri)
            .filter((icon): icon is string => icon !== null),
    ),
]
const CAROUSEL_ICONS = crowd
    .map((icon, idx) => `--p${idx}: url("${icon}")`)
    .join("; ")

// The flow's own plugins, near the editor, over the carousel.
const TILES = [
    { icon: icons[0], used: 0, x: 19, y: 24 },
    { icon: icons[1], used: 1, x: 81, y: 28 },
    { icon: icons[2], used: 2, x: 19, y: 76 },
    { icon: icons[3], used: 3, x: 81, y: 74 },
].filter((tile) => tile.icon)

// The flow's lines, split into tokens for the editor's colors. Type lines
// carry their plugin, and each task's lines its index, for the run.
let plugin = 0
let task = -1
const LINES = FLOW.split("\n").map((text, row) => {
    const match = text.match(/^(\s*)(- )?([\w]+)(:)(.*)$/)
    if (/^tasks:/.test(text)) task = -1
    if (/^ {2}- id:/.test(text) && task > -2) task++
    if (/^triggers:/.test(text)) task = -2
    const line = {
        row,
        indent: text.match(/^\s*/)?.[0] ?? "",
        dash: match?.[2] ?? "",
        key: match?.[3] ?? "",
        value: match ? match[5] : text.trim(),
        comment: "",
        plugin: match?.[3] === "type" ? plugin++ : -1,
        task: task >= 0 && text.trim() !== "" ? task : -1,
    }
    const hash = line.value.indexOf(" #")
    if (hash >= 0) {
        line.comment = line.value.slice(hash + 1)
        line.value = line.value.slice(0, hash)
    }
    return line
})

// Written out as one string: in a pre, the template's own line breaks and
// indents would show. A type's class name is wrapped, to light up as in
// the product's editor.
const escape = (text: string) =>
    text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
const CODE = LINES.map((line) => {
    const string = /^\s*["']/.test(line.value) ? " string" : ""
    let value = escape(line.value)
    if (line.plugin >= 0)
        value = value.replace(/\.(\w+)$/, '.<span class="cls">$1</span>')
    return [
        `<span class="line" style="--n: ${line.row}"`,
        line.task >= 0 ? ` data-task-line="${line.task}"` : "",
        line.plugin >= 0 ? ` data-plugin="${line.plugin}">` : ">",
        `<span class="no">${line.row + 1}</span>${line.indent}`,
        line.dash && `<span class="dash">- </span>`,
        line.key && `<span class="key">${line.key}:</span>`,
        `<span class="value${string}">${value}</span>`,
        line.comment && `<span class="comment"> ${escape(line.comment)}</span>`,
        "\n</span>",
    ].join("")
}).join("")

// The run, as the Gantt shows it: each task's slot along the run.
const RUN = [
    { id: "extract", duration: "2.1s", start: 0, length: 0.14 },
    { id: "approve", duration: "3m 40s", start: 0.14, length: 0.6 },
    { id: "post_to_erp", duration: "4.6s", start: 0.74, length: 0.26 },
]

// The run's logs, as the product's Logs tab shows them, each in when
// its task gets there (ms from the step's start).
const LOGS = [
    {
        at: 1500,
        level: "INFO",
        time: "02:00:02.104",
        task: "extract",
        message: "Query returned 1,204 rows",
    },
    {
        at: 1650,
        level: "WARN",
        time: "02:00:02.311",
        task: "approve",
        message: "Execution paused, waiting for m.lee",
    },
    {
        at: 3300,
        level: "INFO",
        time: "02:03:42.518",
        task: "approve",
        message: "Execution resumed by m.lee",
    },
    {
        at: 3450,
        level: "INFO",
        time: "02:03:42.640",
        task: "post_to_erp",
        message: "Python 3.12 container started",
    },
    {
        at: 4400,
        level: "INFO",
        time: "02:03:47.330",
        task: "post_to_erp",
        message: "Journal posted to the ERP",
    },
]

// The dashboard's executions over the last 24 hours, one bar an hour.
const HOURS = [5, 7, 4, 9, 6, 8, 11, 7, 10, 6, 9, 12]
---

{
    /* On the control plane block's hairline grid: the same two-column head,
    then the three steps as a strip of cells taking turns, over a panel of
    product screens in the 2.0 style: the flow in a white editor, with what
    each step does around it. */
}
<section class="how-it-works" aria-labelledby="how-it-works" data-how>
    {/* A few About us pixels at the edges, as on the blocks above. */}
    <PixelEdges left="wide" right="cluster" />
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="how-it-works">How it works</h2>
                <div>
                    <p>
                        Define workflows in YAML files that teams can review,
                        version in Git, and deploy through CI/CD.
                    </p>
                </div>
            </header>

            <ol class="steps">
                {
                    STEPS.map((step, idx) => (
                        <li
                            class:list={["step", { active: idx === 0 }]}
                            data-step={idx}
                        >
                            <button type="button" aria-pressed={idx === 0}>
                                <span class="bar" aria-hidden="true" />
                                <span class="number">0{idx + 1}</span>
                                <h3>{step.title}</h3>
                                <p>{step.text}</p>
                            </button>
                        </li>
                    ))
                }
            </ol>

            <div class="body" data-at="0">
                {/* Plugins all around: faint, until Connect brings them in. */}
                {
                    /* A small About us pixel cluster in the corner, as in the control plane's panel. */
                }
                <span
                    class="pixels"
                    aria-hidden="true"
                    style={`--pixels: url("${pixelCluster}")`}></span>

                {
                    /* Connect: the plugins roll by behind the editor, the
                    list twice over so it loops. */
                }
                <div class="carousel" aria-hidden="true" style={CAROUSEL_ICONS}>
                    <div class="lane">
                        {
                            [...crowd, ...crowd].map((_, idx) => (
                                <span
                                    class="chip"
                                    style={`--src: var(--p${idx % crowd.length})`}
                                />
                            ))
                        }
                    </div>
                </div>

                <div class="crowd" aria-hidden="true">
                    {
                        TILES.map((tile, idx) => (
                            <span
                                class:list={["tile", { used: tile.used >= 0 }]}
                                style={`left: ${tile.x}%; top: ${tile.y}%; --k: ${idx}; --dy: ${((50 - tile.y) * 36) / 100}rem`}
                                data-used={
                                    tile.used >= 0 ? tile.used : undefined
                                }
                            >
                                <img src={tile.icon} alt="" />
                            </span>
                        ))
                    }
                    <a href="/plugins" class="count" tabindex="-1">
                        <strong>{totalPlugins}+</strong> plugins
                    </a>
                </div>

                {
                    /* Connect: a dashed lead from each of the flow's plugins to its line. */
                }
                <svg class="links" aria-hidden="true">
                    {
                        USED.map(() => (
                            <g>
                                <path />
                                <circle r="3" />
                            </g>
                        ))
                    }
                </svg>

                {/* The flow, in the product's editor. */}
                <div class="card editor" aria-label="The nightly_close flow">
                    <div class="tabs">
                        <span class="tab active yaml-tab">
                            <span class="logo"
                                ><img src={kestraMark.src} alt="" /></span
                            >
                            YAML
                        </span>
                        {
                            /* Run and govern: the run's own tab, once executed. */
                        }
                        <span class="tab exec-tab">
                            <Icon name="mdi:play-outline" /> Execution
                        </span>
                        <span class="execute" aria-hidden="true">
                            <Icon name="mdi:play" /> Execute
                        </span>
                        {
                            /* Once pressed, Execute gives way to the run's state. */
                        }
                        <span class="pill status">
                            <Icon name="mdi:loading" class="spin" />
                            <Icon name="mdi:pause" class="wait" />
                            <Icon
                                name="mdi:check-circle-outline"
                                class="done"
                            />
                            <span class="running">Running</span>
                            <span class="paused">Paused</span>
                            <span class="success">Success</span>
                        </span>
                    </div>
                    <div class="sheet">
                        <pre><code set:html={CODE} /></pre>

                        {/* The run, as the product's Gantt view. */}
                        <div class="gantt" aria-hidden="true">
                            <div class="gantt-head">
                                <span>
                                    Execution <code>4dTq2x</code>
                                </span>
                            </div>
                            <ul>
                                {
                                    RUN.map((row, idx) => (
                                        <li
                                            class="task is-created"
                                            data-task={idx}
                                            style={`--start: ${row.start}; --length: ${row.length}`}
                                        >
                                            <code class="name">{row.id}</code>
                                            <span class="track">
                                                <span class="fill" />
                                            </span>
                                            <span class="end">
                                                <Icon
                                                    name="mdi:loading"
                                                    class="spin"
                                                />
                                                <Icon
                                                    name="mdi:pause"
                                                    class="wait"
                                                />
                                                <Icon
                                                    name="mdi:check-circle-outline"
                                                    class="done"
                                                />
                                                <span class="time">
                                                    {row.duration}
                                                </span>
                                            </span>
                                        </li>
                                    ))
                                }
                            </ul>
                            <ol class="logs">
                                {
                                    LOGS.map((log) => (
                                        <li
                                            class={log.level.toLowerCase()}
                                            data-on={log.at}
                                        >
                                            <span class="level">
                                                {log.level}
                                            </span>
                                            <span class="meta">
                                                <time>{log.time}</time>
                                                <span class="kv">
                                                    taskId:{" "}
                                                    <span>{log.task}</span>
                                                </span>
                                            </span>
                                            <span class="message">
                                                {log.message}
                                            </span>
                                        </li>
                                    ))
                                }
                            </ol>
                        </div>
                    </div>
                </div>

                {
                    /* Declare: on the left, the change lands in Git and is
                    reviewed; on the right, CI/CD checks and deploys it. */
                }
                <div class="card side git" data-scene="0">
                    <div class="card-head">
                        <Icon name="mdi:source-branch" />
                        <span>Versioned in Git</span>
                        <code class="branch">main</code>
                    </div>
                    <ul>
                        <li class="fresh" data-on="1400">
                            <span class="avatar">ML</span>
                            <span class="what">
                                Add the nightly close
                                <code>a3f9c2</code>
                            </span>
                        </li>
                        <li data-on="2000">
                            <span class="avatar reviewer">AR</span>
                            <span class="what">Review approved</span>
                            <span class="state"
                                ><Icon name="mdi:check-circle-outline" /></span
                            >
                        </li>
                        <li class="past">
                            <span class="avatar">ML</span>
                            <span class="what">
                                Move cron to 02:00
                                <code>7be1d0</code>
                            </span>
                        </li>
                        <li class="past">
                            <span class="avatar reviewer">AR</span>
                            <span class="what">
                                Initial flow
                                <code>c41e88</code>
                            </span>
                        </li>
                    </ul>
                </div>
                <div class="card side ci" data-scene="0">
                    <div class="card-head">
                        <Icon name="mdi:rocket-launch-outline" />
                        <span>CI/CD</span>
                        <span class="pill merged" data-on="3800">Deployed</span>
                        <span class="pill open">Running</span>
                    </div>
                    <ul>
                        <li data-on="2600">
                            <span class="what">Validate flow</span>
                            <span class="state"
                                ><Icon name="mdi:check-circle-outline" /></span
                            >
                        </li>
                        <li data-on="3000">
                            <span class="what">Run tests</span>
                            <span class="state"
                                ><Icon name="mdi:check-circle-outline" /></span
                            >
                        </li>
                        <li data-on="3500">
                            <span class="what">Deploy to finance</span>
                            <span class="state"
                                ><Icon name="mdi:check-circle-outline" /></span
                            >
                        </li>
                    </ul>
                </div>

                {
                    /* Run and govern: on the left, what governs the run; on
                    the right, the dashboard that watches every execution. */
                }
                <div class="card side gov" data-scene="2">
                    <div class="card-head">
                        <Icon name="mdi:shield-check-outline" />
                        <span>Governance</span>
                    </div>
                    <ul>
                        <li data-on="1000">
                            <Icon name="mdi:key-outline" class="glyph" />
                            <span class="what">
                                Permissions
                                <small>etl-bot can run finance flows</small>
                            </span>
                            <span class="state"
                                ><Icon name="mdi:check-circle-outline" /></span
                            >
                        </li>
                        <li class="approval" data-on="1650">
                            <Icon
                                name="mdi:account-check-outline"
                                class="glyph"
                            />
                            <span class="what">
                                Approval
                                <small class="waiting">Waiting for m.lee</small>
                                <small class="approved">Approved by m.lee</small
                                >
                            </span>
                            <span class="state"
                                ><Icon name="mdi:check-circle-outline" /></span
                            >
                        </li>
                        <li data-on="4600">
                            <Icon
                                name="mdi:text-box-search-outline"
                                class="glyph"
                            />
                            <span class="what">
                                Audit trail
                                <small>Every step logged</small>
                            </span>
                            <span class="state"
                                ><Icon name="mdi:check-circle-outline" /></span
                            >
                        </li>
                    </ul>
                </div>
                <div class="card side dash" data-scene="2">
                    <div class="card-head">
                        <Icon name="mdi:chart-line" />
                        <span>Dashboard</span>
                        <span class="period">Last 24 hours</span>
                    </div>
                    <div class="tiles">
                        <div class="tile-kpi">
                            <small>Success ratio</small>
                            <strong>98.2<span class="unit">%</span></strong>
                            <span class="ratio"><span></span></span>
                        </div>
                        <div class="tile-kpi">
                            <small>Executions</small>
                            <strong class="total">
                                <span class="before">1,204</span>
                                <span class="after">1,205</span>
                            </strong>
                            <svg viewBox="0 0 120 28" class="bars">
                                {
                                    HOURS.map((h, idx) => (
                                        <rect
                                            x={idx * 10 + 1}
                                            y={28 - h * 2}
                                            width="7"
                                            height={h * 2}
                                            rx="1.5"
                                            class:list={{
                                                last: idx === HOURS.length - 1,
                                            }}
                                        />
                                    ))
                                }
                            </svg>
                        </div>
                        <div class="tile-kpi inline">
                            <small>In progress</small>
                            <strong class="live">
                                <span class="idle">0</span>
                                <span class="busy">1</span>
                            </strong>
                        </div>
                    </div>
                </div>
            </div>

            {/* The closing row, with the way into the platform. */}
            <div class="foot">
                <a href="/features" class="btn btn-secondary"
                    >See the platform</a
                >
            </div>
        </div>
    </div>
</section>

<script>
    // The steps take turns while the block is in view: the open step's top
    // edge fills as its time goes, then the next one opens. A click picks a
    // step and stops the turns.
    const STEP_MS = [7000, 7000, 7000]
    // The run's states over time, in ms from the step's start.
    // Execute is pressed at 400ms, the Gantt replaces the code at 600ms.
    const RUN: [number, number, string][] = [
        [900, 0, "running"],
        [1500, 0, "success"],
        [1650, 1, "paused"],
        [3300, 1, "success"],
        [3450, 2, "running"],
        [4400, 2, "success"],
    ]

    function wireHow() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-how]:not([data-wired])",
        )) {
            root.dataset.wired = "true"
            const steps = [...root.querySelectorAll<HTMLElement>(".step")]
            const body = root.querySelector<HTMLElement>(".body")!
            const tasks = [...root.querySelectorAll<HTMLElement>("[data-task]")]
            const timed = [...root.querySelectorAll<HTMLElement>("[data-on]")]
            const still = matchMedia("(prefers-reduced-motion: reduce)").matches
            let auto = !still
            let inView = false
            let started = false
            let waiting: number | null = null
            let timers: number[] = []
            const later = (ms: number, fn: () => void) =>
                timers.push(window.setTimeout(fn, still ? 0 : ms))

            const setTask = (idx: number, status: string) => {
                tasks[idx].classList.remove(
                    "is-created",
                    "is-running",
                    "is-paused",
                    "is-success",
                )
                tasks[idx].classList.add(`is-${status}`)
                // The editor lights the task that runs, and the card's head
                // shows the execution's state.
                const last = idx === tasks.length - 1
                if (status !== "success") body.dataset.run = String(idx)
                else if (last) delete body.dataset.run
                body.dataset.exec =
                    status === "success" && last
                        ? "success"
                        : status === "paused"
                          ? "paused"
                          : "running"
            }

            // The leads run from each used plugin's tile to the editor's
            // edge, level with its type line, in a soft S.
            const editor = root.querySelector<HTMLElement>(".editor")!
            const links = [...root.querySelectorAll<SVGGElement>(".links g")]
            const drawLinks = () => {
                const box = body.getBoundingClientRect()
                const frame = editor.getBoundingClientRect()
                links.forEach((link, i) => {
                    const tile = root.querySelector<HTMLElement>(
                        `[data-used="${i}"]`,
                    )
                    if (!tile) return
                    // The tile's resting centre, from the layout, so the
                    // lead is right even while the tile is still on its way
                    // out of the carousel. It starts there, behind the tile.
                    const x1 = tile.offsetLeft + tile.offsetWidth / 2
                    const y1 = tile.offsetTop + tile.offsetHeight / 2
                    const left = x1 + box.left < frame.left + frame.width / 2
                    const x2 = (left ? frame.left : frame.right) - box.left
                    // A straight horizontal lead, from behind the tile to
                    // the editor's edge, level with the tile.
                    link.querySelector("path")!.setAttribute(
                        "d",
                        `M${x1},${y1} H${x2}`,
                    )
                    const dot = link.querySelector("circle")!
                    dot.setAttribute("cx", String(x2))
                    dot.setAttribute("cy", String(y1))
                })
            }
            window.addEventListener("resize", drawLinks)

            const open = (idx: number) => {
                timers.forEach(clearTimeout)
                timers = []
                steps.forEach((step, i) => {
                    step.classList.toggle("active", i === idx)
                    step.classList.toggle("timed", auto && i === idx)
                    step.style.setProperty("--dur", `${STEP_MS[i]}ms`)
                    step.querySelector("button")!.ariaPressed = String(
                        i === idx,
                    )
                })
                // Restart the step's entrance.
                body.dataset.at = String(idx)
                if (idx === 1) drawLinks()
                body.classList.remove("enter")
                void body.offsetWidth
                body.classList.add("enter")

                // Timed details come on one after the other.
                timed.forEach((el) => el.classList.remove("on"))
                for (const el of timed)
                    later(Number(el.dataset.on), () => el.classList.add("on"))

                tasks.forEach((_, i) => setTask(i, "created"))
                delete body.dataset.run
                body.dataset.exec = "idle"
                body.classList.remove("pressing", "executing")
                if (idx === 2) {
                    later(400, () => body.classList.add("pressing"))
                    later(600, () => {
                        body.classList.remove("pressing")
                        body.classList.add("executing")
                        body.dataset.exec = "running"
                    })
                    for (const [at, task, status] of RUN)
                        later(at, () => setTask(task, status))
                }
                // The next step opens only while the block is in view;
                // out of view, it waits for the block to come back.
                if (auto)
                    later(STEP_MS[idx], () => {
                        const next = (idx + 1) % steps.length
