---
import { Icon } from "astro-icon/components"
import { API_URL } from "astro:env/client"

type Status = "success" | "running" | "created"

export interface TopologyNode {
    id: string
    type: string
    plugin: string
    fallback: string
    x: number
    y: number
    status: Status
    duration: string
    seconds: number
    artifacts?: number
    runner?: string
}

export interface Props {
    nodes: TopologyNode[]
    label: string
    gantt?: boolean
}

const { nodes, label, gantt = false } = Astro.props

const NODE_W = 260
const NODE_H = 76

const icons = await Promise.all(
    nodes.map(async (node) => {
        try {
            const response = await fetch(
                `${API_URL}/plugins/icons/io.kestra.plugin.${node.plugin}`,
            )
            if (!response.ok) return null
            const svg = Buffer.from(await response.arrayBuffer())
            return `data:image/svg+xml;base64,${svg.toString("base64")}`
        } catch {
            return null
        }
    }),
)

const edges = nodes.slice(0, -1).map((a, idx) => {
    const b = nodes[idx + 1]
    if (a.x === b.x) {
        const x = a.x + 40
        return `M${x} ${a.y + NODE_H} V${b.y - 2}`
    }
    const x1 = a.x + NODE_W
    const y1 = a.y + NODE_H / 2
    const y2 = b.y + NODE_H / 2
    const mid = (x1 + b.x) / 2
    const r = Math.min(8, Math.abs(y2 - y1) / 2)
    const dy = Math.sign(y2 - y1)
    if (!dy) return `M${x1} ${y1} H${b.x - 2}`
    return [
        `M${x1} ${y1}`,
        `H${mid - r}`,
        `Q${mid} ${y1} ${mid} ${y1 + dy * r}`,
        `V${y2 - dy * r}`,
        `Q${mid} ${y2} ${mid + r} ${y2}`,
        `H${b.x - 2}`,
    ].join(" ")
})

const total = nodes.reduce((sum, node) => sum + node.seconds, 0)
const starts = nodes.map((_, idx) =>
    nodes.slice(0, idx).reduce((sum, node) => sum + node.seconds, 0),
)
const MIN_LENGTH = 0.015
const shown = nodes.map((node) => Math.max(node.seconds / total, MIN_LENGTH))
const span = shown.reduce((sum, length) => sum + length, 0)
const slot = (idx: number) => {
    const start = shown.slice(0, idx).reduce((sum, length) => sum + length, 0)
    return `--start: ${start / span}; --length: ${shown[idx] / span}`
}

const clock = (seconds: number) => {
    if (seconds < 60) return `${Math.round(seconds * 10) / 10}s`
    const m = Math.floor(seconds / 60)
    const s = Math.round(seconds % 60)
    return `${m}m ${String(s).padStart(2, "0")}s`
}
---

<div
    class:list={["topology", { "no-gantt": !gantt }]}
    role="img"
    aria-label={label}
    data-topology
>
    <div class="graph">
        <div class="canvas">
            {
                nodes.map(
                    (node, idx) =>
                        node.plugin.startsWith("core.trigger.") && (
                            <div
                                class="trigger"
                                style={`left: ${node.x}px; top: ${node.y}px; --i: ${idx}`}
                                aria-hidden="true"
                            >
                                <span class="trigger-label">trigger</span>
                                <span class="trigger-collapse">
                                    <Icon name="mdi:arrow-collapse" />
                                </span>
                            </div>
                        ),
                )
            }

            <svg class="edges" viewBox="0 0 880 250" aria-hidden="true">
                <defs>
                    <marker
                        id="topology-arrow"
                        viewBox="0 0 10 10"
                        refX="9"
                        refY="5"
                        markerWidth="6"
                        markerHeight="6"
                        markerUnits="userSpaceOnUse"
                        orient="auto"
                    >
                        <path
                            d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z"
                            class="arrow"></path>
                    </marker>
                    <marker
                        id="topology-arrow-running"
                        viewBox="0 0 10 10"
                        refX="9"
                        refY="5"
                        markerWidth="6"
                        markerHeight="6"
                        markerUnits="userSpaceOnUse"
                        orient="auto"
                    >
                        <path
                            d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z"
                            class="arrow running"></path>
                    </marker>
                    <marker
                        id="topology-arrow-done"
                        viewBox="0 0 10 10"
                        refX="9"
                        refY="5"
                        markerWidth="6"
                        markerHeight="6"
                        markerUnits="userSpaceOnUse"
                        orient="auto"
                    >
                        <path
                            d="M1 1.5 L9 5 L1 8.5 Q2.5 5 1 1.5 z"
                            class="arrow done"></path>
                    </marker>
                    <marker
                        id="topology-dot"
                        viewBox="0 0 6 6"
                        refX="3"
                        refY="3"
                        markerWidth="5"
                        markerHeight="5"
                        markerUnits="userSpaceOnUse"
                    >
                        <circle cx="3" cy="3" r="3" class="arrow"></circle>
                    </marker>
                </defs>
                {
                    edges.map((d, idx) => (
                        <path
                            d={d}
                            class:list={[
                                "edge",
                                { done: nodes[idx + 1].status !== "created" },
                            ]}
                            data-edge={idx}
                            style={`--i: ${idx + 1}`}
                        />
                    ))
                }
            </svg>

            {
                nodes.map((node, idx) => (
                    <div
                        class:list={["node", `is-${node.status}`]}
                        style={`left: ${node.x}px; top: ${node.y}px; ${slot(idx)}; --i: ${idx}`}
                        data-node={idx}
                    >
                        <span class="icon">
                            {icons[idx] ? (
                                <img class="plugin" src={icons[idx]} alt="" />
                            ) : (
                                <Icon name={node.fallback} />
                            )}
                        </span>
                        <span class="text">
                            {node.runner && (
                                <span class="runner">{node.runner}</span>
                            )}
                            <strong>{node.id}</strong>
                            <span class="type">{node.type}</span>
                        </span>
                        <Icon name="mdi:information-outline" class="info" />
                        <span class="progress" />

                        <span class="pills">
                            {node.artifacts && (
                                <span class="pill artifact">
                                    <Icon name="mdi:diamond-outline" />
                                    {node.artifacts} artifact
                                    {node.artifacts > 1 && "s"}
                                </span>
                            )}
                            <span class="pill state">
                                <Icon
                                    name="mdi:check-circle-outline"
                                    class="done"
                                />
                                <Icon name="mdi:loading" class="spin" />
                                {node.duration}
                            </span>
                        </span>
                    </div>
                ))
            }
        </div>
    </div>

    <div class="gantt" hidden={!gantt}>
        <div class="gantt-head">
            <span>0s</span>
            <span data-elapsed>{clock(total)}</span>
        </div>
        <ul>
            {
                nodes.map((node, idx) => (
                    <li
                        class:list={[`is-${node.status}`]}
                        style={slot(idx)}
                        data-bar={idx}
                        data-start={starts[idx]}
                        data-seconds={node.seconds}
                    >
                        <span class="icon small">
                            {icons[idx] ? (
                                <img class="plugin" src={icons[idx]} alt="" />
                            ) : (
                                <Icon name={node.fallback} />
                            )}
                        </span>
                        <span class="gantt-task">{node.id}</span>
                        <span class="offset">+{clock(starts[idx])}</span>
                        <span class="track">
                            <span class="bar" />
                        </span>
                        <span class="took">{node.duration}</span>
                        <span class="gantt-state">
                            <span class="state-running">
                                <Icon name="mdi:loading" class="spin" />
                                Running
                            </span>
                            <span class="state-success">
                                <Icon name="mdi:check-circle-outline" />
                                Success
                            </span>
                        </span>
                    </li>
                ))
            }
        </ul>
    </div>
</div>

<script>
    const RUN_MS = 1100
    const HANDOVER_MS = 450
    const HOLD_MS = 2200

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))

    function play(root: HTMLElement) {
        const nodes = [...root.querySelectorAll<HTMLElement>("[data-node]")]
        const bars = [...root.querySelectorAll<HTMLElement>("[data-bar]")]
        const edges = [...root.querySelectorAll<SVGElement>("[data-edge]")]

        let visible = false
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting && root.offsetParent !== null
        }).observe(root)

        const set = (idx: number, status: string) => {
            for (const el of [nodes[idx], bars[idx]]) {
                el.classList.remove("is-created", "is-running", "is-success")
                el.classList.add(`is-${status}`)
            }
        }

        const elapsed = root.querySelector<HTMLElement>("[data-elapsed]")!
        const starts = bars.map((bar) => Number(bar.dataset.start))
        const seconds = bars.map((bar) => Number(bar.dataset.seconds))
        const MIN_LENGTH = 0.015
        const clock = (value: number) => {
            if (value < 60) return `${Math.round(value * 10) / 10}s`
            const m = Math.floor(value / 60)
            const sec = Math.round(value % 60)
            return `${m}m ${String(sec).padStart(2, "0")}s`
        }
        const layout = (time: number) => {
            const now = Math.max(time, 0.001)
            elapsed.textContent = clock(time)
            const shown = starts.map((start, idx) =>
                start <= now
                    ? Math.max(
                          Math.min(now - start, seconds[idx]) / now,
                          MIN_LENGTH,
                      )
                    : 0,
            )
            const span = Math.max(
                1,
                shown.reduce((sum, l) => sum + l, 0),
            )
            let offset = 0
            shown.forEach((length, idx) => {
                for (const el of [nodes[idx], bars[idx]]) {
                    el.style.setProperty("--start", String(offset / span))
                    el.style.setProperty("--length", String(length / span))
                }
                offset += length
            })
        }
        const tick = (idx: number) => {
            const began = performance.now()
            const step = (now: number) => {
                const t = Math.min(1, (now - began) / RUN_MS)
                layout(starts[idx] + t * seconds[idx])
                if (t < 1) requestAnimationFrame(step)
            }
            requestAnimationFrame(step)
        }

        const reset = () => {
            layout(0)
            root.classList.add("resetting")
            nodes.forEach((_, idx) => set(idx, "created"))
            edges.forEach((edge) => edge.classList.remove("active", "done"))
            void root.offsetWidth
            root.classList.remove("resetting")
        }

        const host = root.closest<HTMLElement>("[data-domain-visual]")
        const shown = () =>
            visible &&
            root.offsetParent !== null &&
            (!host || host.classList.contains("active"))

        let built = false
        const waitVisible = async () => {
            if (shown()) return
            built = false
            root.classList.add("building")
            while (!shown()) await sleep(200)
        }
        const build = async () => {
            reset()
            root.classList.add("building")
            void root.offsetWidth
            root.classList.remove("building")
            built = true
            await sleep(900)
        }

        const report = (type: string, detail?: number) =>
            root.dispatchEvent(new CustomEvent(type, { bubbles: true, detail }))

        const loop = async () => {
            run: for (;;) {
                await waitVisible()
                if (!built) await build()
                else {
                    reset()
                    await sleep(500)
                }
                for (let idx = 0; idx < nodes.length; idx++) {
                    await waitVisible()
                    if (!built) continue run
                    set(idx, "running")
                    tick(idx)
                    await sleep(RUN_MS)
                    set(idx, "success")
                    report("topology:progress", (idx + 1) / nodes.length)
                    const edge = edges[idx]
                    if (edge) {
                        edge.classList.add("active")
                        await sleep(HANDOVER_MS)
                        edge.classList.remove("active")
                        edge.classList.add("done")
                    }
                }
                report("topology:done")
                await sleep(HOLD_MS)
            }
        }
        loop()
    }

    function init() {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-topology]:not([data-playing])",
        )) {
            root.dataset.playing = "true"
            play(root)
        }
    }

    document.addEventListener("astro:page-load", init)
    init()
</script>

<style lang="scss">
    .topology {
        --node-bg: #ffffff;
        --node-border: #ebebf0;
        --node-text: #2b2b33;
        --node-muted: #8a8a97;
        --edge: #d0d0da;
        --track: #f0f0f4;
        --success: #1e875e;
        --success-border: #9fdcc0;
        --success-line: #1e875e;
        --success-bg: #e7f6ef;
        --running: #8405ff;
        --running-bg: #f1e9ff;
        --runner: #3b5bdb;
        --runner-bg: #e8edff;
        --trigger: #4fb383;
        --trigger-button: #5fd6b4;
        --trigger-border: #7fdcc0;
        --trigger-bg: rgba(95, 214, 180, 0.12);

        position: relative;
        --z: 0.85;
        --gantt-h: 156px;

        width: calc(100% / var(--z));
        align-self: stretch;
        font-family: var(--font-family-mona-sans), system-ui, sans-serif;

        :global(html.dark) & {
            --node-bg: #1a1c22;
            --node-border: #2e2e3c;
            --node-text: #ffffff;
            --node-muted: #adadbf;
            --edge: #4a4a5a;
            --track: #2a2a36;
            --success-line: #06f0b1;
            --success-border: #1e875e;
            --success-bg: rgba(30, 135, 94, 0.14);
            --running: #9869f7;
            --running-bg: rgba(152, 105, 247, 0.14);
            --runner: #718bfe;
            --runner-bg: rgba(152, 105, 247, 0.12);
            --trigger: #1e875e;
            --trigger-button: #1e875e;
            --trigger-border: rgba(6, 240, 177, 0.35);
            --trigger-bg: rgba(6, 240, 177, 0.06);
        }

        zoom: var(--z);

        @include media-breakpoint-down(xxl) {
            --z: 0.78;
        }

        @include media-breakpoint-down(xl) {
            --z: 0.65;
        }

        @include media-breakpoint-down(md) {
            --z: 0.42;
        }

        &.no-gantt {
            --gantt-h: 0px;
        }

        &.resetting * {
            transition: none !important;
        }
    }

    .graph {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: var(--gantt-h);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .canvas {
        position: relative;
        width: 880px;
        height: 250px;
        zoom: 1.18;
    }

    .edges {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        will-change: transform;
    }

    .edge {
        fill: none;
        stroke: var(--edge);
        stroke-width: 1.5;
        stroke-dasharray: 4 4;
        transition:
            stroke 0.5s ease,
            opacity 0.3s ease calc(150ms + var(--i) * 70ms);

        .building & {
            opacity: 0;
            transition: none;
        }

        &.active {
            stroke: var(--running);
            animation: flow 0.5s linear infinite;
        }

        &.done {
            stroke: var(--success-line);
        }
    }

    .arrow {
        fill: var(--edge);

        &.running {
            fill: var(--running);
        }

        &.done {
            fill: var(--success-line);
        }
    }

    .edge {
        marker-start: url(#topology-dot);
        marker-end: url(#topology-arrow);

        &.active {
            marker-end: url(#topology-arrow-running);
        }

        &.done {
            marker-end: url(#topology-arrow-done);
        }
    }

    @keyframes flow {
        to {
            stroke-dashoffset: -16;
        }
    }

    .trigger {
        position: absolute;
        width: calc(260px + 2 * 14px);
        height: calc(76px + 36px + 38px);
        margin: -36px 0 0 -14px;
        border: 1px solid var(--trigger-border);
        border-radius: 10px;
        background: var(--trigger-bg);
        transition:
            opacity 0.35s ease calc(var(--i) * 70ms),
            transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 70ms);

        .building & {
            opacity: 0;
            transform: translateY(6px) scale(0.98);
            transition: none;
        }
    }

    .trigger-label {
        position: absolute;
        top: 9px;
        left: 10px;
        padding: 1px 9px 2px;
        border-radius: 9px;
        background: var(--trigger);
        font-size: 12px;
        font-weight: 600;
        color: #ffffff;
    }

    .trigger-collapse {
        position: absolute;
        top: -12px;
        right: -12px;
        display: grid;
        place-items: center;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--trigger-button);
        color: #ffffff;

        :global(svg) {
            width: 13px;
            height: 13px;
        }
    }

    .node {
        position: absolute;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.875rem;
        width: 260px;
        height: 76px;
        padding: 0 0.875rem 10px;
        border: 1px solid var(--node-border);
        border-radius: 8px;
        background: var(--node-bg);
        box-shadow: 0 1px 4px 0 var(--ks-shadows-light);
        transition:
            border-color 0.6s ease,
            box-shadow 0.6s ease,
            opacity 0.35s ease calc(var(--i) * 70ms),
            transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 70ms);

        .building & {
            opacity: 0;
            transform: translateY(6px) scale(0.98);
            transition: none;
        }

        &.is-success {
            border-color: var(--success-border);
        }

        &.is-running {
            border-color: var(--running);
            box-shadow:
                0 0 0 3px var(--running-bg),
                0 2px 6px 0 var(--ks-shadows-light);
        }
    }

    .icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: #ffffff;

        :global(svg) {
            width: 32px;
            height: 32px;
        }
    }

    .plugin {
        width: 32px;
        height: 32px;

        .small & {
            width: 15px;
            height: 15px;
        }
    }

    .text {
        display: flex;
        flex-direction: column;
        min-width: 0;
        line-height: 1.2;

        strong {
            overflow: hidden;
            font-size: 14px;
            font-weight: 500;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--node-text);
        }
    }

    .type {
        overflow: hidden;
        font-size: 13px;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--node-muted);
    }

    .runner {
        align-self: flex-start;
        margin-bottom: 2px;
        padding: 0 5px;
        border-radius: 4px;
        background: var(--runner-bg);
        font-size: 11px;
        font-weight: 500;
        color: var(--runner);
    }

    .info {
        width: 18px;
        height: 18px;
        color: var(--node-muted);
    }

    .progress,
    .bar {
        position: absolute;
        left: 0;
        width: 100%;
        transform: translateX(calc(var(--start) * 100%)) scaleX(var(--length));
        transform-origin: left;
        opacity: 0;
        transition:
            background-color 0.4s ease,
            opacity 0.3s ease;

        .is-running > &,
        .is-running .track > & {
            opacity: 1;
            background: var(--running);
        }

        .is-success > &,
        .is-success .track > & {
            opacity: 1;
            background: var(--success-line);
        }
    }

    .node::after {
        content: "";
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 8px;
        height: 2px;
        border-radius: 1px;
        background: var(--track);
    }

    .progress {
        z-index: 1;
        bottom: 8px;
        left: 12px;
        width: calc(100% - 24px);
        height: 2px;
        border-radius: 1px;
    }

    .pills {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        display: flex;
        gap: 6px;
        opacity: 0;
        transition: opacity 0.5s ease;

        .is-running > &,
        .is-success > & {
            opacity: 1;
        }
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;

        :global(svg) {
            width: 14px;
            height: 14px;
        }

        &.artifact {
            display: none;
            background: var(--running-bg);
            color: var(--running);

            .is-success & {
                display: inline-flex;
            }
        }

        .is-success &.state {
            background: var(--success-bg);
            color: var(--success);
        }

        .is-running &.state {
            background: var(--running-bg);
            color: var(--running);
        }

        :global(.spin) {
            display: none;
            animation: spin 1s linear infinite;
        }

        .is-running & :global(.spin) {
            display: block;
        }

        .is-running & :global(.done) {
            display: none;
        }
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .gantt {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        min-height: var(--gantt-h);
        border-top: 1px solid var(--node-border);
        background: color-mix(in srgb, var(--node-bg) 72%, transparent);
        backdrop-filter: blur(6px);
        overflow: hidden;
        transition:
            opacity 0.4s ease 0.45s,
            transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.45s;

        .building & {
            opacity: 0;
            transform: translateY(10px);
            transition: none;
        }

        ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        li {
            display: grid;
            grid-template-columns: 22px 150px 56px minmax(0, 1fr) 52px 76px;
            align-items: center;
            gap: 10px;
            height: 26px;
            padding: 0 24px;

            & + li {
                border-top: 1px solid var(--node-border);
            }

            &.is-created {
                .icon,
                .gantt-task {
                    opacity: 0;
                }

                .track {
                    opacity: 0.5;
                }
            }

            .track {
                transition: opacity 0.4s ease;
            }

            .icon,
            .gantt-task {
                transition: opacity 0.4s ease;
            }
        }
    }

    .gantt-head {
        display: flex;
        justify-content: space-between;
        margin-left: calc(24px + 22px + 150px + 56px + 30px);
