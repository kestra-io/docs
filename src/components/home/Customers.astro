---
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import applePhoto from "./assets/customers/apple.jpg"
import filaPhoto from "./assets/customers/fila.jpg"
import jpmorganPhoto from "./assets/customers/jpmorgan.jpg"
import PixelEdges from "~/components/about/PixelEdges.astro"
import { flat } from "./flatLogo"
import { getCollection } from "astro:content"
import { toSlug } from "~/utils/stories"
import jpmorgan from "~/assets/teams/jpmorgan.svg?raw"
import fila from "~/assets/companies/fila.svg?raw"
import amdocs from "./assets/companies/amdocs.svg?raw"
import amdocsPhoto from "~/contents/customer-stories/amdocs-delivers-integration-environments-as-a-service-with-kestra/hero.jpeg"
import apple from "~/contents/customer-stories/apple-ml-team-orchestrates-large-scale-data-pipelines-with-kestra/logo.svg?raw"

// Each story links to its customer story page, found by company name.
const stories = await getCollection("customerStories")
const storyHref = (company?: string) => {
    if (!company) return undefined
    const entry = stories.find((e) => e.data.companyName === company)
    return entry ? `/stories/${toSlug(entry)}` : undefined
}

export interface Story {
    company: string
    story?: string
    photo?: ImageMetadata
    logo?: string
    height?: number
    industry?: string
    stat: string
    label: string
    quote?: string
    author?: string
    detail?: string
}

interface Props {
    stories?: Story[]
    foot?: boolean
    placeholder?: boolean
}

// Melissa's stories, each with its logo for the tab, its industry and,
// when there is one yet, its photo.
const DEFAULT_STORIES: Story[] = [
    {
        company: "Apple",
        photo: applePhoto,
        story: "Apple",
        logo: flat(
            apple.replace("<svg ", '<svg viewBox="0 0 842.32007 1000.0001" '),
        ),
        height: 30,
        industry: "AI / ML",
        stat: "200",
        label: "ML engineers on Kestra",
        quote: "I want to highlight their robustness, which is crucial at our scale.",
    },
    {
        company: "JPMorgan Chase",
        photo: jpmorganPhoto,
        story: "JPMorgan Chase",
        logo: flat(jpmorgan),
        height: 20,
        industry: "Cybersecurity",
        stat: "Billions",
        label: "of cybersecurity records processed",
        detail: "100+ analysts define their own secure workflows.",
    },
    // From the Amdocs customer story: its KPI and its quote.
    {
        company: "Amdocs",
        photo: amdocsPhoto,
        story: "Amdocs",
        logo: flat(amdocs),
        height: 22,
        industry: "Telecom",
        stat: "Days → hours",
        label: "to deliver a validated integration environment",
        quote: "From a technical point of view, Kestra sits at the first place.",
    },
    {
        company: "FILA",
        photo: filaPhoto,
        story: "Fila",
        logo: flat(fila),
        height: 21,
        industry: "Manufacturing",
        stat: "2.5M",
        label: "executions a month across 2,000+ workflows",
        detail: "ERP, PLM and supply chain in 70+ countries.",
    },
]

const {
    stories: STORIES = DEFAULT_STORIES,
    foot = true,
    placeholder = true,
} = Astro.props
---

{
    /* On the hairline grid of the blocks above: the head, then the customers
    as a row of logo tabs over one story at a time: its words and figure on
    the quotes' lavender, the open tab in the same lavender, and the photo
    of its customer story beside them. */
}
<section class="customers" aria-labelledby="customers" data-stories>
    <PixelEdges left="cluster" right="tall" />
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="customers">
                    <slot name="title">
                        In production, at scale
                        <span
                            >Teams across banking, manufacturing, technology and
                            the public sector run Kestra in production.</span
                        >
                    </slot>
                </h2>
            </header>

            <div class="tabs" role="tablist" aria-label="Customer stories">
                {
                    STORIES.map((story, idx) => (
                        <button
                            type="button"
                            role="tab"
                            class:list={["tab", { active: idx === 0 }]}
                            aria-selected={idx === 0 ? "true" : "false"}
                            aria-controls={`story-${idx}`}
                            style={`--logo-height: ${story.height}px`}
                        >
                            <span class="bar" aria-hidden="true" />
                            {story.logo ? (
                                <span class="logo" set:html={story.logo} />
                            ) : (
                                <span class="name" aria-hidden="true">
                                    {story.company}
                                </span>
                            )}
                            <span class="visually-hidden">{story.company}</span>
                        </button>
                    ))
                }
            </div>

            <div class="panels">
                {
                    STORIES.map((story, idx) => (
                        <div
                            id={`story-${idx}`}
                            role="tabpanel"
                            class:list={[
                                "panel",
                                {
                                    active: idx === 0,
                                    bare: !story.photo && !placeholder,
                                },
                            ]}
                        >
                            <figure class="story">
                                <div class="figure">
                                    {story.industry && (
                                        <p class="industry">{story.industry}</p>
                                    )}
                                    <p class="stat">
                                        {story.stat}{" "}
                                        <span set:html={story.label} />
                                    </p>
                                </div>
                                <figcaption class="words">
                                    {(story.quote || story.detail) && (
                                        <svg
                                            viewBox="0 0 46 40"
                                            class="glyph"
                                            aria-hidden="true"
                                        >
                                            <path d="M0 0v20.742h11.843c-.161 2.37-.822 6.365-3.33 9.113C6.543 32.01 3.757 33.06 0 33.06V40c5.683 0 10.228-1.823 13.513-5.417 4.062-4.446 5.244-10.484 5.422-13.835V0H0Z" />
                                            <path d="M27.06 0v20.742h11.842c-.161 2.37-.821 6.365-3.33 9.113-1.97 2.155-4.756 3.205-8.512 3.205V40c5.682 0 10.227-1.823 13.512-5.417 4.063-4.446 5.245-10.484 5.422-13.835V0H27.06Z" />
                                        </svg>
                                    )}
                                    {story.quote ? (
                                        <blockquote>{story.quote}</blockquote>
                                    ) : (
                                        story.detail && (
                                            <p class="detail">{story.detail}</p>
                                        )
                                    )}
                                    {story.author && (
                                        <p class="author">{story.author}</p>
                                    )}
                                    {storyHref(story.story) && (
                                        <a
                                            href={storyHref(story.story)}
                                            class="read"
                                        >
                                            <span>Read the story</span>
                                            <Icon name="mdi:arrow-right" />
                                        </a>
                                    )}
                                </figcaption>
                            </figure>
                            {/* The story's photo; black while it has none yet. */}
                            {(story.photo || placeholder) && (
                                <div class="photo" aria-hidden="true">
                                    {story.photo && (
                                        <Image
                                            src={story.photo}
                                            alt=""
                                            widths={[480, 720, 960]}
                                            sizes="(max-width: 992px) 100vw, 40vw"
                                            loading="lazy"
                                        />
                                    )}
                                </div>
                            )}
                        </div>
                    ))
                }
            </div>

            {/* The closing row, as See the platform and the whitepaper. */}
            {/* The reach in one line, with the way to every story. */}
            {
                foot && (
                    <div class="foot">
                        <p>
                            More than <strong>40,000</strong> organizations run
                            Kestra, including nearly 800 companies with over
                            1,000 employees.
                        </p>
                        <a href="/stories" class="all">
                            See all stories <span aria-hidden="true">→</span>
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</section>

<script>
    // One story at a time: the tabs take turns while the block is in view,
    // the open tab's top edge filling as its time goes; a click picks one
    // and stops the turns.
    const TURN_MS = 6000

    function wireStories() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-stories]:not([data-wired])",
        )) {
            root.dataset.wired = "true"
            const tabs = [...root.querySelectorAll<HTMLElement>(".tab")]
            const panels = [...root.querySelectorAll<HTMLElement>(".panel")]
            let auto = !matchMedia("(prefers-reduced-motion: reduce)").matches
            let current = 0
            let inView = false
            let timer = 0

            const open = (idx: number) => {
                current = idx
                tabs.forEach((tab, i) => {
                    tab.classList.toggle("active", i === idx)
                    tab.classList.remove("timed")
                    tab.setAttribute("aria-selected", String(i === idx))
                })
                panels.forEach((panel, i) =>
                    panel.classList.toggle("active", i === idx),
                )
                schedule()
            }

            const schedule = () => {
                clearTimeout(timer)
                if (!auto || !inView) return
                const tab = tabs[current]
                void tab.offsetWidth
                tab.classList.add("timed")
                timer = window.setTimeout(
                    () => open((current + 1) % tabs.length),
                    TURN_MS,
                )
            }

            tabs.forEach((tab, idx) =>
                tab.addEventListener("click", () => {
                    auto = false
                    clearTimeout(timer)
                    tabs.forEach((t) => t.classList.remove("timed"))
                    open(idx)
                }),
            )

            // The turns run only while the block is in view.
            new IntersectionObserver(
                ([entry]) => {
                    inView = entry.isIntersecting
                    if (inView) schedule()
                    else {
                        clearTimeout(timer)
                        tabs.forEach((t) => t.classList.remove("timed"))
                    }
                },
                { threshold: 0.35 },
            ).observe(root)
        }
    }

    document.addEventListener("astro:page-load", wireStories)
    wireStories()
</script>

<style lang="scss">
    .customers {
        position: relative;
        background: var(--ks-background-body);
    }

    // No hairline grid on the background here, to break the page's rhythm:
    // the tabs and the story sit as one lavender piece, split by the grid's
    // grey rules, on the same insets as the other blocks.
    .grid {
        --gap: 1px;
        --inset: clamp(1.5rem, 4vw, 3.5rem);
        // The lavender of our quotes.
        --surface: #f0f0fd;
        --glyph: #4f6df7;

        :global(html.dark) & {
            --surface: #1c1b2e;
            --glyph: #a796ff;
        }

        position: relative;
        background: var(--ks-background-body);
        // Rails on both sides, on the other blocks' lines, so they run on
        // unbroken from Replace down to Three ways.
        border-left: var(--gap) solid var(--ks-border-primary);
        border-right: var(--gap) solid var(--ks-border-primary);

        @include media-breakpoint-down(xl) {
            border-inline: 0;
        }

        // The rules show through the gaps; above the tabs and under the
        // story, a rule across the page, as between the other blocks' rows.
        > .tabs {
            position: relative;
            border-block: var(--gap) solid var(--ks-border-primary);
            background: var(--ks-border-primary);
        }

        > .panels {
            position: relative;
            border-bottom: var(--gap) solid var(--ks-border-primary);
        }

        > .tabs::before,
        > .panels::after {
            content: "";
            position: absolute;
            left: -100vw;
            right: -100vw;
            height: var(--gap);
            background: var(--ks-border-primary);
            pointer-events: none;
        }

        > .tabs::before {
            top: calc(-1 * var(--gap));
        }

        > .panels::after {
            bottom: calc(-1 * var(--gap));
        }
    }

    // The title in two tones, the lead as its grey second line.
    .head {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
        // Inside the rails, in line with the story's words.
        padding: 8.5rem var(--inset) 4rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            max-width: 26em;
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--ks-content-primary);
            text-wrap: pretty;

            span {
                display: block;
                color: var(--ks-content-tertiary);
            }
        }
    }

    .foot {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem 2rem;
        // More room under the line, before Three ways.
        padding: clamp(2rem, 3vw, 2.75rem) var(--inset)
            clamp(4.5rem, 8vw, 7rem);
        font-size: 1.0625rem;

        p {
            margin: 0;
            color: var(--ks-content-tertiary);
        }

        strong {
            font-weight: 600;
            color: var(--ks-content-primary);
        }

        .all {
            color: var(--ks-content-secondary);
            text-decoration: none;
            white-space: nowrap;
            transition: color 0.2s ease;

            span {
                display: inline-block;
                margin-left: 0.25rem;
                transition: translate 0.2s ease;
            }

            &:hover {
                color: var(--ks-content-primary);

                span {
                    translate: 0.25em 0;
                }
            }
        }
    }

    // The logo tabs: four cells between the rules; the open one is grey,
    // its top edge filling while the stories take turns.
    .tabs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--gap);

        @include media-breakpoint-down(md) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .tab {
        position: relative;
        display: grid;
        place-items: center;
        height: 6rem;
        border: 0;
        // Every tab in the quotes' lavender, as the story under them.
        background: var(--surface);
        color: var(--ks-content-tertiary);
        cursor: pointer;
        transition:
            background-color 0.25s ease,
            color 0.25s ease;

        &:hover {
            background: color-mix(in srgb, var(--glyph) 4%, var(--surface));
            color: var(--ks-content-primary);
        }

        // The open one: its logo in full, its top edge drawn, on a deeper
        // lavender, so the story being read is plain to see.
        &.active {
            background: color-mix(in srgb, var(--glyph) 8%, var(--surface));
            color: var(--ks-content-primary);
        }

        &:focus-visible {
            outline: 2px solid var(--ks-border-active);
            outline-offset: -2px;
        }

        .bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--ks-content-primary);
            transform: scaleX(0);
            transform-origin: left;
        }

        &.timed .bar {
            animation: turn 6s linear forwards;
        }

        .name {
            font-size: 0.9375rem;
            font-weight: 600;
            text-align: center;
        }

        .logo {
            display: flex;
            height: var(--logo-height);

            :global(svg) {
                width: auto;
                max-width: 9rem;
                height: 100%;
            }
        }
    }

    @keyframes turn {
        to {
            transform: scaleX(1);
        }
    }

    // One story at a time: its figure on the left, its words on the right
    // on the lavender of our quotes.
    .panels {
        display: grid;
    }

    .panel {
        grid-area: 1 / 1;
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
        min-height: 32rem;
        // One lavender card: the story's words and its photo, set in it.
        background: var(--surface);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.4s ease,
            visibility 0s 0.4s;

        &.active {
            opacity: 1;
            visibility: visible;
            transition: opacity 0.4s ease;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }

        // Without its photo on a phone, as tall as its words.
        @include media-breakpoint-down(md) {
            min-height: 0;
        }

        &.bare {
            grid-template-columns: minmax(0, 1fr);
            min-height: 24rem;
        }
    }

    // The story on the quotes' lavender: the industry and the figure at the
    // top, the quote at the foot.
    .story {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2.5rem;
        margin: 0;
        padding: 3rem var(--inset);

        .glyph {
            width: 2.25rem;
            height: 2rem;
            margin-bottom: 1.25rem;
            fill: var(--glyph);
            transform: scaleX(-1);
        }

        blockquote,
        .detail {
            max-width: 28em;
            margin: 0;
            font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
            font-weight: 500;
            line-height: 1.45;
            color: var(--ks-content-primary);
        }

        .author {
            margin: 1rem 0 0;
            font-size: 0.9375rem;
            color: var(--ks-content-tertiary);
        }

        .industry {
            margin: 0 0 0.875rem;
            font-family: $font-family-monospace;
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--ks-content-tertiary);
        }

        .stat {
            max-width: 14em;
            margin: 0;
            font-size: clamp(1.75rem, 2.6vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.15;
            color: var(--ks-content-primary);

            span {
                color: var(--ks-content-tertiary);
            }
        }

        .read {
            margin-top: 1.25rem;
        }
    }

    // The customer story's photo, upright, filling its column to the rules.
    // Black while a story has none yet.
    .photo {
        position: relative;
        min-height: 20rem;
        background: #0d0d10;
        overflow: hidden;

        // On a phone the words carry the story alone.
        @include media-breakpoint-down(md) {
            display: none;
        }

        :global(img) {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    // A quiet link that reads with the quote.
    .read {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ks-content-primary);
        text-decoration: none;

        span {
            background: linear-gradient(currentColor, currentColor) left
                bottom / 100% 1px no-repeat;
        }

        :global(svg) {
            width: 1rem;
            height: 1rem;
            transition: transform 0.2s ease;
        }

        &:hover :global(svg) {
            transform: translateX(3px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .panel {
            transition: none;
        }
    }
</style>
