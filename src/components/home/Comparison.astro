---
import { Image } from "astro:assets"
import SixtySeconds from "./SixtySeconds.astro"
import dataVisual from "./assets/comparison/tab-data.svg"
import infrastructureVisual from "./assets/comparison/tab-infrastructure.svg"
import aiAgentsVisual from "./assets/comparison/tab-ai-agents.svg"
import businessAppVisual from "./assets/comparison/tab-business-app.svg"

const TABS = [
    {
        id: "data",
        label: "Data",
        title: "Cross-Cloud ETL That Starts Itself",
        image: dataVisual,
        alt: "Kestra flow editor showing an Azure Blob to BigQuery flow with its topology",
    },
    {
        id: "infrastructure",
        label: "Infrastructure",
        title: "Every VM Configured, Every Run Traceable",
        image: infrastructureVisual,
        alt: "Kestra execution logs of an Ansible playbook run against a NetBox dynamic inventory",
    },
    {
        id: "ai-agents",
        label: "AI Agents",
        title: "Triage every issue from GitHub with AI, start each day with a plan",
        image: aiAgentsVisual,
        alt: "Kestra execution outputs of an AI daily repo brief, with the expression debugger preview",
    },
    {
        id: "business-app",
        label: "Business Apps",
        title: "Self-service Business automation, fully recorded",
        image: businessAppVisual,
        alt: "Kestra app editor showing a Weekly recap form next to its YAML definition",
    },
]
---

<section class="use-cases" aria-label="Kestra across teams" data-use-case-tabs>
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="tabs" role="tablist" aria-label="Team">
        {
            TABS.map((tab, idx) => (
                <button
                    type="button"
                    id={`use-case-tab-${tab.id}`}
                    class:list={["tab", { active: idx === 0 }]}
                    role="tab"
                    aria-selected={idx === 0}
                    aria-controls={`use-case-panel-${tab.id}`}
                    tabindex={idx === 0 ? 0 : -1}
                    data-tab-target={tab.id}
                >
                    {tab.label}
                </button>
            ))
        }
    </div>

    {
        TABS.map((tab, idx) => (
            <div
                id={`use-case-panel-${tab.id}`}
                class:list={["panel", { active: idx === 0 }]}
                role="tabpanel"
                aria-labelledby={`use-case-tab-${tab.id}`}
                data-tab-content={tab.id}
            >
                <h3>{tab.title}</h3>
                <Image
                    src={tab.image}
                    alt={tab.alt}
                    layout="none"
                    loading={idx === 0 ? "eager" : "lazy"}
                    class="visual"
                />
            </div>
        ))
    }

    <p class="caption">
        Kestra scales because it is designed for cross-team orchestration from
        day one.
    </p>
    <SixtySeconds />
</section>

<script>
    function wireUseCaseTabs() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-use-case-tabs]",
        )) {
            if (root.dataset.wired === "true") continue
            root.dataset.wired = "true"

            const tabs = [...root.querySelectorAll<HTMLElement>(".tab")]

            const activate = (btn: HTMLElement) => {
                const target = btn.dataset.tabTarget
                if (target == null) return
                for (const el of root.querySelectorAll(".tab, .panel")) {
                    el.classList.remove("active")
                    if (el.matches(".tab")) {
                        el.setAttribute("aria-selected", "false")
                        el.setAttribute("tabindex", "-1")
                    }
                }
                btn.classList.add("active")
                btn.setAttribute("aria-selected", "true")
                btn.setAttribute("tabindex", "0")
                root.querySelector(
                    `.panel[data-tab-content="${target}"]`,
                )?.classList.add("active")
            }

            root.addEventListener("click", (e) => {
                const btn = (e.target as Element).closest(
                    ".tab",
                ) as HTMLElement | null
                if (btn) activate(btn)
            })

            root.addEventListener("keydown", (e) => {
                const current = (e.target as Element).closest(
                    ".tab",
                ) as HTMLElement | null
                if (!current) return
                const idx = tabs.indexOf(current)
                let next: number | null = null
                if (e.key === "ArrowRight") next = (idx + 1) % tabs.length
                else if (e.key === "ArrowLeft")
                    next = (idx - 1 + tabs.length) % tabs.length
                else if (e.key === "Home") next = 0
                else if (e.key === "End") next = tabs.length - 1
                if (next == null) return
                e.preventDefault()
                activate(tabs[next])
                tabs[next].focus()
            })
        }
    }

    document.addEventListener("astro:page-load", wireUseCaseTabs)
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", wireUseCaseTabs)
    } else {
        wireUseCaseTabs()
    }
</script>

<style lang="scss">
    .use-cases {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 1rem 5rem;
        background-color: #ffffff;
        color: var(--hp-content-primary);
        text-align: center;
        overflow: clip;
    }

    .grid-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background:
            radial-gradient(
                640px 527px at 108% 24%,
                rgba(185, 135, 255, 0.45),
                transparent 65%
            ),
            linear-gradient(
                to right,
                color-mix(in srgb, var(--hp-border-secondary) 40%, transparent)
                    1px,
                transparent 1px
            ),
            linear-gradient(
                to bottom,
                color-mix(in srgb, var(--hp-border-secondary) 40%, transparent)
                    1px,
                transparent 1px
            );
        background-size:
            100% 100%,
            var(--hp-grid-size) var(--hp-grid-size),
            var(--hp-grid-size) var(--hp-grid-size);
        -webkit-mask: radial-gradient(
            ellipse 75% 90% at 95% 5%,
            #000 25%,
            transparent 100%
        );
        mask: radial-gradient(
            ellipse 75% 90% at 95% 5%,
            #000 25%,
            transparent 100%
        );
        pointer-events: none;

        @include media-breakpoint-down(md) {
            -webkit-mask: radial-gradient(
                ellipse 90% 40% at 100% 0,
                #000 10%,
                transparent 100%
            );
            mask: radial-gradient(
                ellipse 90% 40% at 100% 0,
                #000 10%,
                transparent 100%
            );
        }
    }

    .tabs,
    .panel,
    .caption {
        position: relative;
        z-index: 1;
    }

    .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        width: 100%;
        max-width: 1320px;
        padding: 0.5rem 1rem;
        margin-bottom: 1rem;
    }

    .tab {
        flex: 1 1 calc(50% - 0.625rem);
        padding: 0.5rem 1rem;
        border: 1px solid var(--hp-border-secondary);
        border-radius: 6px;
        background: #ffffff;
        color: var(--hp-content-secondary);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.75rem;
        cursor: pointer;
        transition:
            background-color 0.2s ease-in-out,
            border-color 0.2s ease-in-out,
            box-shadow 0.2s ease-in-out;

        &:hover {
            background: var(--hp-background-secondary);
        }

        &:focus-visible {
            outline: 2px solid var(--hp-content-color-highlight);
            outline-offset: 2px;
        }

        &.active {
            background: var(--hp-background-secondary);
            border-color: var(--hp-content-primary);
            color: var(--hp-content-primary);
            box-shadow: 2px 3px 16px 0 rgba(57, 82, 242, 0.1);
        }

        @include media-breakpoint-up(md) {
            flex: 1 1 0;
            font-size: 1.25rem;
        }
    }

    .panel {
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 1.875rem;
        width: 100%;
        max-width: 1364px;
        padding: 2rem;
        border-radius: 16px;
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0) 18.5%,
            #fdfcfe 36.3%,
            #ebeeef 91.6%
        );

        &.active {
            display: flex;
        }

        h3 {
            margin: 0;
            color: var(--hp-content-primary);
            font-size: 1.5rem;
            font-weight: 600;
            line-height: 1.75rem;
            letter-spacing: -0.12px;
            text-wrap: balance;
        }

        @include media-breakpoint-down(md) {
            gap: 1.25rem;
            padding: 1.25rem 0.75rem;

            h3 {
                font-size: 1.25rem;
            }
        }
    }

    .visual {
        display: block;
        width: 100%;
        height: auto;
        border: 2px solid #bfbfe7;
        border-radius: 16px;
        overflow: clip;

        @include media-breakpoint-down(md) {
            border-radius: 8px;
        }
    }

    /* The dialog button is rendered by VideoDialog, outside this scope, so the
     * gap above it is carried by the caption. */
    .caption {
        font-size: 1rem;
        margin: 3.5rem 0 1.5rem;
    }
</style>
