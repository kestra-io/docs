---
import { Icon } from "astro-icon/components"
import CustomerLogos from "./CustomerLogos.astro"
import PixelEdges from "~/components/about/PixelEdges.astro"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"

const totalPlugins = await fetchTotalPluginsCount()

// Melissa's keyword bar ("Kestra at a glance").
const KEY_FACTS = [
    "Open Source",
    "Declarative",
    "Language-Agnostic",
    `${totalPlugins}+ Plugins`,
    "Cloud",
    "Self-Hosted",
    "API-First",
]
---

{
    /* Deliberately not `.hero`: app.scss owns that class as a site component
    and its `.hero h1, .hero p { max-width }` would clamp the copy here. */
}
<section class="home-hero" aria-labelledby="hero-title">
    <PixelEdges left="tall" right="wide" />
    {
        /* Full width and dark, like the AI block further down; the copy sits
    in container-xl, on the page's text line. The frame stands in for the
    hero visual until it is ready. */
    }
    <div class="frame surface-dark">
        <div class="container-xl">
            <div class="intro">
                <div class="copy">
                    <h1 id="hero-title">
                        Orchestrate everything, everywhere<span
                            class="brand-dot"
                            aria-hidden="true"></span><span
                            class="visually-hidden">.</span
                        >
                    </h1>
                    <p class="lead">
                        Use any language, connect your systems, and run
                        anywhere. Built on open source.
                    </p>
                    <div class="buttons">
                        <a href="/get-started" class="btn-solid">
                            Get started <Icon name="mdi:chevron-right" />
                        </a>
                        <a href="/demo" class="btn-ghost">Book a demo</a>
                    </div>
                </div>
            </div>
        </div>
        {
            /* The key facts, a strip of cells across the frame's foot, full width. */
        }
        <ul class="key" aria-label="Kestra at a glance" data-key-facts>
            {
                KEY_FACTS.map((fact, idx) => (
                    <li style={`--i: ${idx}`}>
                        <span class="bar" aria-hidden="true" />
                        {fact}
                    </li>
                ))
            }
        </ul>
    </div>
    {
        /* The customers under the frame, full width, on the key facts' columns. */
    }
    <div class="customers">
        <CustomerLogos label="Companies running Kestra in production" />
    </div>
</section>

<script>
    // The key facts run on arrival, then again every few seconds while the
    // strip is in view. Without JavaScript they simply show, lit.
    const REPLAY_MS = 9000

    function loopKeyFacts() {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
        for (const strip of document.querySelectorAll<HTMLElement>(
            "[data-key-facts]:not([data-looping])",
        )) {
            strip.dataset.looping = "true"
            const run = () => {
                strip.classList.remove("running")
                void strip.offsetWidth
                strip.classList.add("running")
            }
            let visible = false
            new IntersectionObserver(([entry]) => {
                if (entry.isIntersecting && !visible) run()
                visible = entry.isIntersecting
            }).observe(strip)
            setInterval(() => {
                if (visible && !document.hidden) run()
            }, REPLAY_MS)
        }
    }

    document.addEventListener("astro:page-load", loopKeyFacts)
    loopKeyFacts()
</script>

<style lang="scss">
    // One dark frame across the page under the menu, with the copy at its
    // bottom left over a row of key facts; the customers follow on the
    // page.
    .home-hero {
        position: relative;
        background: var(--ks-background-body);
    }

    .frame {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        display: flex;
        flex-direction: column;
        // Most of the first screen; the copy sits centred in the space
        // above the key facts strip.
        min-height: min(86vh, 860px);
        // Square, edge to edge: a global .frame rule rounds it otherwise.
        border-radius: 0;
        overflow: hidden;
        // Black to grey only, no colour: a faint light from the top right.
        background:
            radial-gradient(
                90% 80% at 85% 10%,
                rgba(255, 255, 255, 0.06),
                transparent 60%
            ),
            #0d0d0f;
        color: #ffffff;

        @include media-breakpoint-down(md) {
            min-height: 560px;
        }

        > .container-xl {
            display: flex;
            flex: 1;
            flex-direction: column;
        }
    }

    .copy {
        max-width: 46rem;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 5.2vw, 4.25rem);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.04;
        color: #ffffff;
        text-wrap: balance;

        .brand-dot {
            display: inline-block;
            width: 0.15em;
            height: 0.15em;
            margin-left: 0.05em;
            background: #fe0071;
        }
    }

    .lead {
        max-width: 36rem;
        margin: 1.25rem 0 2rem;
        font-size: 1.125rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
        text-wrap: balance;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    // Translucent on the dark frame, so it sits back behind Get started.
    .btn-ghost {
        display: inline-flex;
        align-items: center;
        padding: 0.625rem 1.125rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0.5rem;
        background: rgba(255, 255, 255, 0.06);
        font-size: 0.9375rem;
        font-weight: 500;
        color: #ffffff;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;

        &:hover,
        &:focus-visible {
            border-color: rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
        }
    }

    // Flat violet, like Get Started in the menu. On hover it lifts, glows
    // and a sheen sweeps across it.
    .btn-solid {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.625rem 0.75rem 0.625rem 1.125rem;
        border-radius: 0.5rem;
        overflow: hidden;
        background: var(--ks-background-button-primary);
        font-size: 0.9375rem;
        font-weight: 500;
        color: #ffffff;
        text-decoration: none;
        box-shadow:
            0 0 0 0 rgba(132, 5, 255, 0),
            inset 0 1px 0 rgba(255, 255, 255, 0.18);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            filter 0.25s ease;

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                110deg,
                transparent 30%,
                rgba(255, 255, 255, 0.35) 50%,
                transparent 70%
            );
            transform: translateX(-120%);
            pointer-events: none;
        }

        :global(svg) {
            width: 1.125rem;
            height: 1.125rem;
            transition: transform 0.25s ease;
        }

        &:hover,
        &:focus-visible {
            color: #ffffff;
            transform: translateY(-1px);
            filter: brightness(1.08);
            box-shadow:
                0 8px 28px -6px rgba(132, 5, 255, 0.7),
                inset 0 1px 0 rgba(255, 255, 255, 0.25);

            &::after {
                transform: translateX(120%);
                transition: transform 0.7s ease;
            }

            :global(svg) {
                transform: translateX(3px);
            }
        }

        &:active {
            transform: translateY(0);
        }

        @media (prefers-reduced-motion: reduce) {
            &,
            &:hover {
                transform: none;
            }

            &::after {
                display: none;
            }
        }
    }

    // Key facts as the frame's foot: a strip of hairline cells across the
    // container, its top rule running edge to edge. They light up one after
    // the other, like a run: a white bar fills each cell's top edge, then
    // settles into the rule, and the label brightens.
    .key {
        --run: 0.35s;
        --rule: rgba(255, 255, 255, 0.12);

        position: relative;
        display: grid;
        // Seven across, on the same columns as the customer logos below.
        grid-template-columns: repeat(7, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;

        // The top rule, across the whole frame.
        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--rule);
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        li {
            position: relative;
            padding: 1.375rem 1rem;
            font-size: 0.875rem;
            text-align: center;
            font-weight: 500;
            white-space: nowrap;
            color: rgba(255, 255, 255, 0.85);

            border-left: 1px solid var(--rule);

            &:first-child {
                border-left: 0;
            }

            @include media-breakpoint-between(md, lg) {
                &:nth-child(4n + 1) {
                    border-left: 0;
                }

                &:nth-child(n + 5) {
                    border-top: 1px solid var(--rule);
                }
            }

            @include media-breakpoint-down(md) {
                &:nth-child(odd) {
                    border-left: 0;
                }

                &:nth-child(n + 3) {
                    border-top: 1px solid var(--rule);
                }
            }
        }

        // On hover a cell lights its top edge with a soft glow, like the
        // run that lit it.
        li:hover {
            background: rgba(255, 255, 255, 0.03);
            color: #ffffff;

            .bar {
                opacity: 1;
                transform: none;
                box-shadow: 0 0 12px 1px rgba(255, 255, 255, 0.55);
                animation: none;
            }
        }

        li {
            transition:
                background-color 0.25s ease,
                color 0.25s ease;
        }

        .bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: #ffffff;
            transform: scaleX(0);
            transform-origin: left;
        }

        // A run: the script adds this class on arrival, then again every
        // few seconds while the strip is in view.
        &.running {
            li {
                color: rgba(255, 255, 255, 0.4);
                animation: fact-lit 0.4s ease forwards;
                animation-delay: calc(0.6s + (var(--i) + 1) * var(--run));
            }

            .bar {
                animation:
                    fact-run var(--run) linear forwards,
                    fact-done 0.6s ease forwards;
                animation-delay:
                    calc(0.6s + var(--i) * var(--run)),
                    calc(0.6s + (var(--i) + 1) * var(--run));
            }

            li:hover .bar {
                animation: none;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            li,
            .bar {
                animation: none;
            }

            li {
                color: rgba(255, 255, 255, 0.85);
            }

            .bar {
                display: none;
            }
        }
    }

    @keyframes fact-run {
        to {
            transform: scaleX(1);
        }
    }

    @keyframes fact-done {
        to {
            opacity: 0;
        }
    }

    @keyframes fact-lit {
        to {
            color: rgba(255, 255, 255, 0.85);
        }
    }

    // Melissa's label for the logo row.
    .intro {
        display: flex;
        flex: 1;
        align-items: center;
        padding: clamp(3rem, 6vw, 5rem) var(--inset);
    }

    .customers {
        margin-top: 0;
    }
</style>
