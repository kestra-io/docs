---
import { Icon } from "astro-icon/components"
import CustomerLogos from "./CustomerLogos.astro"
import PixelEdges from "~/components/about/PixelEdges.astro"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"

const totalPlugins = await fetchTotalPluginsCount()

// Melissa's keyword bar ("Kestra at a glance").
const KEY_FACTS = [
    "Open Source",
    "Declarative",
    "Language-Agnostic",
    `${totalPlugins}+ Plugins`,
    "Cloud",
    "Self-Hosted",
    "API-First",
]
---

{
    /* Deliberately not `.hero`: app.scss owns that class as a site component
    and its `.hero h1, .hero p { max-width }` would clamp the copy here. */
}
<section class="home-hero" aria-labelledby="hero-title">
    <PixelEdges left="tall" right="wide" />
    {/* container-xl, like the menu, so the frame lines up with its edges. */}
    <div class="container-xl">
        {/* The frame stands in for the hero visual until it is ready. */}
        <div class="frame surface-dark">
            <div class="intro">
                <div class="copy">
                    <h1 id="hero-title">
                        Orchestrate everything, everywhere<span
                            class="brand-dot"
                            aria-hidden="true"></span><span
                            class="visually-hidden">.</span
                        >
                    </h1>
                    <p class="lead">
                        Use any language, connect your systems, and run
                        anywhere. Built on open source.
                    </p>
                    <div class="buttons">
                        <a href="/get-started" class="btn-solid">
                            Get started <Icon name="mdi:chevron-right" />
                        </a>
                        <a href="/demo" class="btn-ghost">Book a demo</a>
                    </div>
                </div>
                <ul class="key" aria-label="Kestra at a glance">
                    {
                        KEY_FACTS.map((fact, idx) => (
                            <li style={`--i: ${idx}`}>
                                <span class="state" aria-hidden="true">
                                    <Icon name="mdi:loading" class="running" />
                                    <Icon
                                        name="mdi:check-circle-outline"
                                        class="success"
                                    />
                                </span>
                                {fact}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
    {/* The customers, on the page under the frame. */}
    <div class="customers container-xl">
        <p class="customers-label">Companies running Kestra in production</p>
        <CustomerLogos />
    </div>
</section>

<style lang="scss">
    // One rounded dark frame as wide as the menu, a little below it, with
    // the copy at its bottom left over a row of key facts; the customers
    // follow on the page.
    .home-hero {
        position: relative;
        padding-top: 0.75rem;
        background: var(--ks-background-body);
    }

    .frame {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        min-height: min(66vh, 640px);
        padding-top: clamp(2.5rem, 6vw, 4.5rem);
        border-radius: 0.875rem;
        overflow: hidden;
        background:
            radial-gradient(
                90% 80% at 85% 10%,
                rgba(132, 5, 255, 0.28),
                transparent 60%
            ),
            radial-gradient(
                60% 60% at 10% 100%,
                rgba(31, 155, 243, 0.12),
                transparent 70%
            ),
            #0b0c10;
        color: #ffffff;

        @include media-breakpoint-down(md) {
            min-height: 520px;
        }
    }

    .copy {
        max-width: 46rem;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 5.2vw, 4.25rem);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.04;
        color: #ffffff;
        text-wrap: balance;

        .brand-dot {
            display: inline-block;
            width: 0.15em;
            height: 0.15em;
            margin-left: 0.05em;
            background: #fe0071;
        }
    }

    .lead {
        max-width: 36rem;
        margin: 1.25rem 0 2rem;
        font-size: 1.125rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
        text-wrap: balance;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    // Translucent on the dark frame, so it sits back behind Get started.
    .btn-ghost {
        display: inline-flex;
        align-items: center;
        padding: 0.625rem 1.125rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0.5rem;
        background: rgba(255, 255, 255, 0.06);
        font-size: 0.9375rem;
        font-weight: 500;
        color: #ffffff;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;

        &:hover,
        &:focus-visible {
            border-color: rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
        }
    }

    // Flat violet, like Get Started in the menu. On hover it lifts, glows
    // and a sheen sweeps across it.
    .btn-solid {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.625rem 0.75rem 0.625rem 1.125rem;
        border-radius: 0.5rem;
        overflow: hidden;
        background: var(--ks-background-button-primary);
        font-size: 0.9375rem;
        font-weight: 500;
        color: #ffffff;
        text-decoration: none;
        box-shadow:
            0 0 0 0 rgba(132, 5, 255, 0),
            inset 0 1px 0 rgba(255, 255, 255, 0.18);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            filter 0.25s ease;

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                110deg,
                transparent 30%,
                rgba(255, 255, 255, 0.35) 50%,
                transparent 70%
            );
            transform: translateX(-120%);
            pointer-events: none;
        }

        :global(svg) {
            width: 1.125rem;
            height: 1.125rem;
            transition: transform 0.25s ease;
        }

        &:hover,
        &:focus-visible {
            color: #ffffff;
            transform: translateY(-1px);
            filter: brightness(1.08);
            box-shadow:
                0 8px 28px -6px rgba(132, 5, 255, 0.7),
                inset 0 1px 0 rgba(255, 255, 255, 0.25);

            &::after {
                transform: translateX(120%);
                transition: transform 0.7s ease;
            }

            :global(svg) {
                transform: translateX(3px);
            }
        }

        &:active {
            transform: translateY(0);
        }

        @media (prefers-reduced-motion: reduce) {
            &,
            &:hover {
                transform: none;
            }

            &::after {
                display: none;
            }
        }
    }

    // Key facts along the bottom of the copy.
    .key {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.75rem;
        margin: 2.5rem 0 0;
        padding: 0;
        list-style: none;

        // Each fact runs like a task: a spinner, then a success check,
        // one after the other.
        li {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            animation: fact-in 0.4s ease both;
            animation-delay: calc(0.5s + var(--i) * 0.22s);
        }

        .state {
            position: relative;
            display: inline-grid;
            width: 14px;
            height: 14px;

            :global(svg) {
                grid-area: 1 / 1;
                width: 14px;
                height: 14px;
            }
        }

        .running {
            color: #9869f7;
            animation:
                spin 0.6s linear infinite,
                fact-out 0.15s ease forwards;
            animation-delay: 0s, calc(0.8s + var(--i) * 0.22s);
        }

        .success {
            color: #06f0b1;
            opacity: 0;
            animation: fact-check 0.25s ease forwards;
            animation-delay: calc(0.8s + var(--i) * 0.22s);
        }

        @media (prefers-reduced-motion: reduce) {
            li,
            .running,
            .success {
                animation: none;
            }

            .running {
                display: none;
            }

            .success {
                opacity: 1;
            }
        }

        @include media-breakpoint-down(md) {
            gap: 0.375rem 1.25rem;
            margin-top: 2rem;
        }
    }

    @keyframes fact-in {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
    }

    @keyframes fact-out {
        to {
            opacity: 0;
        }
    }

    @keyframes fact-check {
        from {
            opacity: 0;
            transform: scale(0.6);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    // Melissa's label for the logo row.
    .intro {
        padding: 0 clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
    }

    .customers {
        margin-top: 2.5rem;
    }

    .customers-label {
        margin: 0 0 1rem;
        text-align: center;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--ks-content-tertiary);
    }
</style>
