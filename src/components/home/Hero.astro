---
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import PixelEdges from "~/components/about/PixelEdges.astro"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"

const totalPlugins = await fetchTotalPluginsCount()

// Melissa's keyword bar ("Kestra at a glance").
const KEY_FACTS = [
    "Open Source",
    "Declarative",
    "Language-Agnostic",
    `${totalPlugins}+ Plugins`,
    "Cloud",
    "Self-Hosted",
    "API-First",
]

// The logo carousel at the frame's foot, from the logo bar of the previous
// hero.
const CAROUSEL = [
    { file: "jpmorgan", name: "JPMorgan Chase" },
    { file: "apple", name: "Apple" },
    { file: "bloomberg", name: "Bloomberg" },
    { file: "amdocs", name: "Amdocs" },
    { file: "t-system", name: "T-Systems" },
    { file: "fila", name: "FILA" },
    { file: "xiaomi", name: "Xiaomi" },
    { file: "toyota", name: "Toyota" },
    { file: "bundesagentur", name: "Bundesagentur für Arbeit" },
]
const companyLogos = import.meta.glob<{ default: ImageMetadata }>(
    "/src/components/home/assets/companies/*.svg",
    { eager: true },
)
---

{
    /* Deliberately not `.hero`: app.scss owns that class as a site component
    and its `.hero h1, .hero p { max-width }` would clamp the copy here. */
}
<section class="home-hero" aria-labelledby="hero-title">
    <PixelEdges left="tall" right="wide" />
    {
        /* Full width and dark, like the AI block further down; the copy sits
    in container-xl, on the page's text line. The frame stands in for the
    hero visual until it is ready. */
    }
    <div class="frame surface-dark">
        <div class="container-xl stage">
            <div class="intro">
                <div class="copy">
                    <h1 id="hero-title">
                        Orchestrate everything, everywhere<span
                            class="brand-dot"
                            aria-hidden="true"></span><span
                            class="visually-hidden">.</span
                        >
                    </h1>
                    <p class="lead">
                        Use any language, connect your systems, and run
                        anywhere. Built on open source.
                    </p>
                    <div class="buttons">
                        <a href="/get-started" class="btn-solid">
                            Get started <Icon name="mdi:chevron-right" />
                        </a>
                        <a href="/demo" class="btn-ghost">Book a demo</a>
                    </div>
                    {/* The key facts, a quiet line under the buttons. */}
                    <ul
                        class="key"
                        aria-label="Kestra at a glance"
                        data-key-facts
                    >
                        {
                            KEY_FACTS.map((fact, idx) => (
                                <li style={`--i: ${idx}`}>{fact}</li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
        {
            /* The customers run along the frame's foot, four rounds so the
            belt outruns wide screens and its half loops without a seam;
            only the first round is read out. */
        }
        <div class="carousel">
            <ul
                class="belt"
                aria-label="Companies running Kestra in production"
            >
                {
                    [...CAROUSEL, ...CAROUSEL, ...CAROUSEL, ...CAROUSEL].map(
                        (company, idx) => {
                            const echo = idx >= CAROUSEL.length
                            return (
                                <li aria-hidden={echo ? "true" : undefined}>
                                    <Image
                                        src={
                                            companyLogos[
                                                `/src/components/home/assets/companies/${company.file}.svg`
                                            ].default
                                        }
                                        alt={echo ? "" : company.name}
                                        class="brand-logo"
                                    />
                                </li>
                            )
                        },
                    )
                }
            </ul>
        </div>
    </div>
</section>

<script>
    // The key facts run on arrival, then again every few seconds while the
    // line is in view. Without JavaScript they simply show, lit.
    const REPLAY_MS = 9000

    function loopKeyFacts() {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
        for (const strip of document.querySelectorAll<HTMLElement>(
            "[data-key-facts]:not([data-looping])",
        )) {
            strip.dataset.looping = "true"
            const run = () => {
                strip.classList.remove("running")
                void strip.offsetWidth
                strip.classList.add("running")
            }
            let visible = false
            new IntersectionObserver(([entry]) => {
                if (entry.isIntersecting && !visible) run()
                visible = entry.isIntersecting
            }).observe(strip)
            setInterval(() => {
                if (visible && !document.hidden) run()
            }, REPLAY_MS)
        }
    }

    document.addEventListener("astro:page-load", loopKeyFacts)
    loopKeyFacts()
</script>

<style lang="scss">
    // One dark frame across the page under the menu, with the copy and its
    // key facts on the left, over the customers' carousel.
    .home-hero {
        position: relative;
        background: var(--ks-background-body);
    }

    .frame {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        display: flex;
        flex-direction: column;
        // Most of the first screen; the copy sits centred in the space
        // above the carousel.
        min-height: min(86vh, 860px);
        // Square, edge to edge: a global .frame rule rounds it otherwise.
        border-radius: 0;
        overflow: hidden;
        // Black to grey only, no colour: a faint light from the top right.
        background:
            radial-gradient(
                90% 80% at 85% 10%,
                rgba(255, 255, 255, 0.06),
                transparent 60%
            ),
            #0d0d0f;
        color: #ffffff;

        @include media-breakpoint-down(md) {
            min-height: 560px;
        }

        // Only the copy grows, so the carousel stays at the frame's foot.
        > .stage {
            display: flex;
            flex: 1;
            flex-direction: column;
        }
    }

    // The title and lead keep their own measure, so the key facts line can
    // run wider than them.
    .copy {
        min-width: 0;
    }

    h1 {
        max-width: 46rem;
        margin: 0;
        font-size: clamp(2.5rem, 5.2vw, 4.25rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.04;
        color: #ffffff;
        text-wrap: balance;

        .brand-dot {
            display: inline-block;
            width: 0.15em;
            height: 0.15em;
            margin-left: 0.05em;
            background: #fe0071;
        }
    }

    .lead {
        max-width: 36rem;
        margin: 1.25rem 0 2rem;
        font-size: 1.125rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
        text-wrap: balance;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    // Key facts as one line of monospace capitals under the buttons, dot
    // between dot. They light up one after the other, like a run.
    .key {
        --run: 0.25s;

        display: flex;
        flex-wrap: wrap;
        // Plain gaps while the line wraps, so no row opens on a dot.
        gap: 0.625rem 1.5rem;
        margin: 2.5rem 0 0;
        padding: 0;
        list-style: none;
        font-family: $font-family-monospace;

        @include media-breakpoint-up(lg) {
            gap: 0;
        }

        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;

        li {
            color: rgba(255, 255, 255, 0.55);
            white-space: nowrap;

            @include media-breakpoint-up(lg) {
                & + li::before {
                    content: "·";
                    margin-inline: 0.875rem;
                    color: rgba(255, 255, 255, 0.3);
                }
            }
        }

        // A run: the script adds this class on arrival, then again every
        // few seconds while the line is in view.
        &.running li {
            animation: fact-lit 1.2s ease;
            animation-delay: calc(0.6s + var(--i) * var(--run));
        }

        @media (prefers-reduced-motion: reduce) {
            &.running li {
                animation: none;
            }
        }
    }

    @keyframes fact-lit {
        20% {
            color: #ffffff;
        }
    }

    .intro {
        display: flex;
        flex: 1;
        align-items: center;
        // On the Kestra logo of the menu.
        padding-block: clamp(3rem, 6vw, 5rem);
    }

    // A belt of white logos sliding left at the frame's foot, from one
    // edge of the screen to the other, fading out at both.
    .carousel {
        overflow: hidden;
        padding-block: clamp(2.5rem, 4vw, 3.5rem);
        mask-image: linear-gradient(
            90deg,
            transparent,
            #000 6%,
            #000 94%,
            transparent
        );
    }

    .belt {
        display: flex;
        align-items: center;
        gap: clamp(3rem, 5vw, 5rem);
        width: max-content;
        margin: 0;
        padding: 0 clamp(3rem, 5vw, 5rem) 0 0;
        list-style: none;
        animation: belt 80s linear infinite;

        > li {
            display: flex;
            flex-shrink: 0;
        }

        @media (prefers-reduced-motion: reduce) {
            animation: none;
        }
    }

    .carousel:hover .belt {
        animation-play-state: paused;
    }

    .brand-logo {
        flex-shrink: 0;
        width: auto;
        height: 1.5rem;
        filter: brightness(0) invert(1);
        opacity: 0.7;
    }

    @keyframes belt {
        to {
            transform: translateX(-50%);
        }
    }
</style>
