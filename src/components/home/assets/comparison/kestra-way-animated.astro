---
const { class: className, ...rest } = Astro.props
---

<style lang="scss">
    .kestra-widget {
        position: relative;
        width: 554px;
        height: 396px;
        background-color: #131316;
        overflow: hidden;
    }
    .kestra-widget svg,
    .kestra-widget canvas {
        position: absolute;
        pointer-events: none;
        aspect-ratio: 554 / 396;
        width: 100%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        @include media-breakpoint-up(md) {
            width: auto;
        }
    }
    .kestra-widget svg {
        z-index: 1;
    }
    .kestra-widget .glow {
        z-index: 2;
    }
    .kestra-widget .ptcl {
        z-index: 3;
    }
</style>

