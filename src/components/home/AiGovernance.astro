---
/**
 * Melissa's AI orchestration block, drawn as Kai's stack resolved: the
 * agents on top, Kestra in the middle as the one layer every action crosses
 * (permissions, approvals, audit trail), and under it the same four domains
 * as the control plane block above. Calls run down as pulses; one is turned
 * back by policy, and every outcome loops back into one audit trail.
 * Without JavaScript, or with reduced motion, the stack stands still.
 */
import { Icon } from "astro-icon/components"
import kestraMark from "./assets/ai/kestra-logo-mark-on-dark.svg"
import PixelEdges from "~/components/about/PixelEdges.astro"

// The drawing's grid, in viewBox units.
const W = 1200
const AGENT_Y = 28
const AGENT_H = 48
const BAND_Y = 216
const BAND_H = 88
const DOMAIN_Y = 404
const DOMAIN_H = 72
const AUDIT_Y = 548
const AUDIT_X = 34

const AGENTS = [
    { id: "support", name: "Support", cx: 300 },
    { id: "ops", name: "Ops", cx: 600 },
    { id: "finance", name: "Finance", cx: 900 },
]

// The control plane block's four domains, in its order.
const DOMAINS = [
    { id: "infra", name: "Infrastructure", cx: 195 },
    { id: "data", name: "Data pipelines", cx: 465 },
    { id: "business", name: "Business processes", cx: 735 },
    { id: "it", name: "IT operations", cx: 1005 },
]
const DOMAIN_W = 210

const CONTROLS = [
    { id: "permissions", name: "Permissions", x: 610 },
    { id: "approvals", name: "Approvals", x: 785 },
    { id: "audit", name: "Audit trail", x: 960 },
]
const CONTROL_W = 160

const agentPath = (cx: number) => `M ${cx} ${AGENT_Y + AGENT_H} V ${BAND_Y}`
const domainPath = (cx: number) => `M ${cx} ${BAND_Y + BAND_H} V ${DOMAIN_Y}`
// From a domain's foot, along the floor and up the left side, back into
// the band: every outcome ends in the one audit trail.
const auditPath = (cx: number) =>
    [
        `M ${cx} ${DOMAIN_Y + DOMAIN_H}`,
        `V ${AUDIT_Y - 20}`,
        `Q ${cx} ${AUDIT_Y} ${cx - 20} ${AUDIT_Y}`,
        `H ${AUDIT_X + 20}`,
        `Q ${AUDIT_X} ${AUDIT_Y} ${AUDIT_X} ${AUDIT_Y - 20}`,
        `V ${BAND_Y + BAND_H / 2 + 20}`,
        `Q ${AUDIT_X} ${BAND_Y + BAND_H / 2} ${AUDIT_X + 20} ${BAND_Y + BAND_H / 2}`,
        `H 60`,
    ].join(" ")
---

<section
    class="ai-governance surface-dark"
    aria-labelledby="ai-governance"
    data-header-dark
>
    {/* The About us pixel art, as in the blocks above. */}
    <PixelEdges left="wide" right="tall" />
    {/* A faint technical grid behind the stack, fading out at the edges. */}
    <span class="texture" aria-hidden="true"></span>
    <div class="container-xl">
        <div class="rails">
            <div class="head">
                <h2 id="ai-governance">
                    AI agents cross systems seamlessly. <span
                        >Enforce governance at every step.</span
                    >
                </h2>
                <p class="lead">
                    Permissions, approvals, and audit trails apply to every
                    action an agent takes.
                </p>
                {/* The hero's primary button. */}
                <a href="/ai-automation" class="btn-solid">
                    How agents fit <Icon name="mdi:chevron-right" />
                </a>
            </div>

            <figure
                class="stack"
                aria-label="AI agents call into Kestra, which checks permissions, holds approvals and keeps the audit trail before any action reaches infrastructure, data pipelines, business processes or IT operations. A drop_table call from the finance agent is blocked by policy."
                data-ai-stack
            >
                <svg
                    viewBox={`0 0 ${W} 580`}
                    role="presentation"
                    aria-hidden="true"
                >
                    {/* The wires, faint; the pulses run on copies of them. */}
                    <g class="wires">
                        {
                            AGENTS.map((agent) => (
                                <path d={agentPath(agent.cx)} />
                            ))
                        }
                        {
                            DOMAINS.map((domain) => (
                                <path d={domainPath(domain.cx)} />
                            ))
                        }
                        {
                            DOMAINS.map((domain) => (
                                <path class="dashed" d={auditPath(domain.cx)} />
                            ))
                        }
                    </g>

                    <g class="pulses">
                        {
                            AGENTS.map((agent) => (
                                <path
                                    d={agentPath(agent.cx)}
                                    data-pulse={`agent-${agent.id}`}
                                />
                            ))
                        }
                        {
                            DOMAINS.map((domain) => (
                                <path
                                    d={domainPath(domain.cx)}
                                    data-pulse={`domain-${domain.id}`}
                                />
                            ))
                        }
                        {
                            DOMAINS.map((domain) => (
                                <path
                                    d={auditPath(domain.cx)}
                                    data-pulse={`audit-${domain.id}`}
                                />
                            ))
                        }
                    </g>

                    {/* The agents, each with the call it is making. */}
                    {
                        AGENTS.map((agent) => (
                            <g class="agent" data-agent={agent.id}>
                                <rect
                                    x={agent.cx - 120}
                                    y={AGENT_Y}
                                    width="240"
                                    height={AGENT_H}
                                    rx="10"
                                />
                                <g
                                    class="glyph"
                                    transform={`translate(${agent.cx - 102} ${AGENT_Y + 15})`}
                                >
                                    <Icon
                                        name="mdi:robot-outline"
                                        width="18"
                                        height="18"
                                    />
                                </g>
                                <text
                                    x={agent.cx - 74}
                                    y={AGENT_Y + AGENT_H / 2 + 4}
                                >
                                    <tspan class="strong">{agent.name}</tspan>{" "}
                                    agent
                                </text>
                                <circle
                                    class="dot"
                                    cx={agent.cx}
                                    cy={AGENT_Y + AGENT_H + 12}
                                    r="2.5"
                                />
                                <text
                                    class="call"
                                    x={agent.cx + 14}
                                    y={AGENT_Y + AGENT_H + 70}
                                    data-call
                                />
                            </g>
                        ))
                    }

                    {/* Kestra: the one layer every action crosses. */}
                    <g class="band" data-band>
                        <rect
                            x="60"
                            y={BAND_Y}
                            width={W - 120}
                            height={BAND_H}
                            rx="14"></rect>
                        <image
                            href={kestraMark.src}
                            x="88"
                            y={BAND_Y + BAND_H / 2 - 16}
                            width="32"
                            height="32"
                        />
                        <text
                            class="band-name"
                            x="136"
                            y={BAND_Y + BAND_H / 2 - 2}
                        >
                            Kestra
                        </text>
                        <text
                            class="band-role"
                            x="136"
                            y={BAND_Y + BAND_H / 2 + 18}
                        >
                            One control plane for every action
                        </text>
                        {
                            CONTROLS.map((control) => (
                                <g class="control" data-control={control.id}>
                                    <rect
                                        x={control.x}
                                        y={BAND_Y + BAND_H / 2 - 18}
                                        width={CONTROL_W}
                                        height="36"
                                        rx="8"
                                    />
                                    <circle
                                        class="state"
                                        cx={control.x + 18}
                                        cy={BAND_Y + BAND_H / 2}
                                        r="3.5"
                                    />
                                    <text
                                        x={control.x + 32}
                                        y={BAND_Y + BAND_H / 2 + 4}
                                        data-label={control.name}
                                    >
                                        {control.name}
                                    </text>
                                </g>
                            ))
                        }
                        <text
                            class="verdict"
                            x={W / 2}
                            y={BAND_Y + BAND_H + 34}
                            data-verdict></text>
                    </g>

                    {/* The control plane block's four domains. */}
                    {
                        DOMAINS.map((domain) => (
                            <g class="domain" data-domain={domain.id}>
                                <rect
                                    class="outline"
                                    x={domain.cx - DOMAIN_W / 2}
                                    y={DOMAIN_Y}
                                    width={DOMAIN_W}
                                    height={DOMAIN_H}
                                    rx="12"
                                />
                                <rect
                                    class="inner"
                                    x={domain.cx - DOMAIN_W / 2 + 8}
                                    y={DOMAIN_Y + 8}
                                    width={DOMAIN_W - 16}
                                    height={DOMAIN_H - 16}
                                    rx="7"
                                />
                                <text
                                    x={domain.cx}
                                    y={DOMAIN_Y + DOMAIN_H / 2 + 4}
                                >
                                    {domain.name}
                                </text>
                                <text
                                    class="result"
                                    x={domain.cx}
                                    y={DOMAIN_Y + DOMAIN_H + 24}
                                    data-result
                                />
                            </g>
                        ))
                    }
                </svg>
            </figure>
        </div>
    </div>
</section>

<script>
    // While a [data-header-dark] section sits under the fixed menu, the menu
    // turns dark too (Header.vue reads body[data-header-over-dark]).
    function watchDarkSections() {
        const sections =
            document.querySelectorAll<HTMLElement>("[data-header-dark]")
        if (!sections.length || document.body.dataset.darkSectionsWatched)
            return
        document.body.dataset.darkSectionsWatched = "true"
        let frame = 0
        const update = () => {
            frame = 0
            const bar = document.getElementById("top-bar")
            const line = bar ? bar.getBoundingClientRect().bottom - 1 : 0
            const over = [...sections].some((section) => {
                const box = section.getBoundingClientRect()
                return box.top <= line && box.bottom > line
            })
            document.body.toggleAttribute("data-header-over-dark", over)
        }
        const schedule = () => {
            frame ||= requestAnimationFrame(update)
        }
        window.addEventListener("scroll", schedule, { passive: true })
        window.addEventListener("resize", schedule)
        document.addEventListener(
            "astro:before-swap",
            () => {
                window.removeEventListener("scroll", schedule)
                window.removeEventListener("resize", schedule)
                document.body.removeAttribute("data-header-over-dark")
                delete document.body.dataset.darkSectionsWatched
            },
            { once: true },
        )
        update()
    }

    document.addEventListener("astro:page-load", watchDarkSections)
    watchDarkSections()

    // The calls, one after the other, then the loop starts over:
    //   support → refund_order: permitted, held for j.kim's approval, run in
    //             business processes, then audited;
    //   ops     → restart_service: permitted, run in IT operations, audited;
    //   finance → drop_table on data pipelines: turned back by policy, and
    //             the refusal is audited too.
    type Call = {
        agent: string
        call: string
        domain: string
        approval?: string
        denied?: boolean
    }
    const CALLS: Call[] = [
        {
            agent: "support",
            call: "refund_order",
            domain: "business",
            approval: "j.kim",
        },
        { agent: "ops", call: "restart_service", domain: "it" },
        { agent: "finance", call: "drop_table", domain: "data", denied: true },
    ]

    function playStack(root: HTMLElement) {
        if (root.dataset.playing) return
        root.dataset.playing = "true"
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return

        const q = <T extends Element>(sel: string) =>
            root.querySelector<T>(sel)!
        const band = q<SVGGElement>("[data-band]")
        const verdict = q<SVGTextElement>("[data-verdict]")
        const control = (id: string) => q<SVGGElement>(`[data-control="${id}"]`)
        const auditLabel = control("audit").querySelector("text")!

        let visible = false
        let waiters: (() => void)[] = []
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting
            if (visible) waiters.splice(0).forEach((go) => go())
        }).observe(root)

        // Waits, and holds while the block is off screen.
        const wait = async (ms: number) => {
            await new Promise((done) => setTimeout(done, ms))
            if (!visible) await new Promise<void>((go) => waiters.push(go))
        }

        // A short streak of light along a wire.
        const pulse = (id: string, ms: number, tone = "") =>
            new Promise<void>((done) => {
                const path = q<SVGPathElement>(`[data-pulse="${id}"]`)
                const length = path.getTotalLength()
                const streak = Math.min(70, length * 0.45)
                path.style.strokeDasharray = `${streak} ${length + streak}`
                path.dataset.tone = tone
                path.classList.add("lit")
                const run = path.animate(
                    [
                        { strokeDashoffset: streak },
                        { strokeDashoffset: -length },
                    ],
                    { duration: ms, easing: "cubic-bezier(0.45, 0, 0.2, 1)" },
                )
                run.onfinish = () => {
                    path.classList.remove("lit")
                    done()
                }
            })

        const set = (el: Element, state: string) =>
            el.setAttribute("data-state", state)
        const clear = (el: Element) => el.removeAttribute("data-state")
        let audited = 0

        const reset = () => {
            root.querySelectorAll("[data-state]").forEach(clear)
            root.querySelectorAll("[data-call], [data-result]").forEach(
                (el) => (el.textContent = ""),
            )
            verdict.textContent = ""
            control("approvals").querySelector("text")!.textContent =
                "Approvals"
        }

        const play = async (call: Call) => {
            // Each call starts with fresh checks; the audit trail keeps
            // counting.
            clear(control("permissions"))
            clear(control("approvals"))
            control("approvals").querySelector("text")!.textContent =
                "Approvals"
            const agent = q<SVGGElement>(`[data-agent="${call.agent}"]`)
            const domain = q<SVGGElement>(`[data-domain="${call.domain}"]`)
            set(agent, "active")
            agent.querySelector("[data-call]")!.textContent = call.call
            await wait(500)
            await pulse(`agent-${call.agent}`, 900)

            set(band, "busy")
            set(control("permissions"), call.denied ? "denied" : "ok")
            await wait(500)

            if (call.denied) {
                set(band, "denied")
                verdict.textContent = `${call.call} · blocked by Kestra policy`
                set(verdict, "denied")
                audited += 1
                set(control("audit"), "ok")
                auditLabel.textContent = `Audit trail · ${audited}`
                await wait(2600)
                clear(band)
                clear(agent)
                return
            }

            if (call.approval) {
                const approvals = control("approvals")
                set(approvals, "waiting")
                approvals.querySelector("text")!.textContent =
                    `Awaiting ${call.approval}`
                await wait(1300)
                set(approvals, "ok")
                approvals.querySelector("text")!.textContent =
                    `Approved by ${call.approval}`
                await wait(500)
            }

            await pulse(`domain-${call.domain}`, 700)
            set(domain, "ok")
            domain.querySelector("[data-result]")!.textContent =
                `${call.call} ✓`
            await wait(400)
            await pulse(`audit-${call.domain}`, 1300, "audit")
            audited += 1
            set(control("audit"), "ok")
            auditLabel.textContent = `Audit trail · ${audited}`
            await wait(900)
            clear(band)
            clear(agent)
        }

        const loop = async () => {
            if (!visible) await new Promise<void>((go) => waiters.push(go))
            for (;;) {
                reset()
                audited = 0
                auditLabel.textContent = "Audit trail"
                await wait(600)
                for (const call of CALLS) await play(call)
                await wait(1800)
            }
        }
        loop()
    }

    function startStacks() {
        document
            .querySelectorAll<HTMLElement>("[data-ai-stack]")
            .forEach(playStack)
    }

    document.addEventListener("astro:page-load", startStacks)
    startStacks()
</script>

<style lang="scss">
    @use "/src/assets/styles/color-palette" as *;

    // Dark in both themes.
    .ai-governance {
        --bg: #0b0b0e;
        --line: rgba(255, 255, 255, 0.08);
        --wire: rgba(255, 255, 255, 0.14);
        --text: #ffffff;
        --muted: #a3a3b1;
        --faint: #5c5c68;
        // Grey and white throughout; red only in a refused check's tag.
        --danger: #ff5c7a;

        // The menu reads these while it sits over the section.
        --ks-content-primary: #{$base-grey-white};
        --ks-content-secondary: #{$base-grey-200};
        --ks-content-tertiary: #{$base-grey-300};
        --ks-content-link: #{$base-primary-200};

        position: relative;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);
    }

    // The section is dark in both themes: the pixels take their dark-theme
    // tint.
    .ai-governance :global(.pixel-edges) {
        --pixel: rgba(167, 150, 255, 0.07);
    }

    // Hairline rails down the sides, on the other blocks' lines.
    .rails {
        position: relative;
        // More black above the title, straight after the last domain row.
        padding: clamp(6rem, 9vw, 8.5rem) 0 clamp(4rem, 6vw, 5.5rem);

        &::before,
        &::after {
            content: "";
            position: absolute;
            z-index: 3;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--line);
            pointer-events: none;
        }

        &::before {
            left: 0;
        }

        &::after {
            right: 0;
        }
    }

    .head {
        position: relative;
        max-width: 50rem;
        margin: 0 auto 4.5rem;
        padding-inline: 1.5rem;
        text-align: center;

        @include media-breakpoint-down(md) {
            margin-bottom: 3rem;
        }
    }

    h2 {
        margin: 0;
        font-size: clamp(2rem, 3.6vw, 3rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--text);
        text-wrap: balance;

        // The second sentence in grey, the promise after the fact.
        span {
            color: #a9a9b8;
        }
    }

    .lead {
        margin: 1.25rem auto 0;
        max-width: 36rem;
        font-size: 1.25rem;
        line-height: 1.55;
        color: #cfcfda;
    }

    .btn-solid {
        margin-top: 2rem;
    }

    // The dots of the product's topology canvas, faded to nothing away
    // from the stack.
    .texture {
        position: absolute;
        inset: 0;
        background: radial-gradient(
                circle,
                rgba(255, 255, 255, 0.07) 1px,
                transparent 1.5px
            )
            0 0 / 20px 20px;
        mask: radial-gradient(
            ellipse 60% 50% at 50% 65%,
            #000 20%,
            transparent 75%
        );
        pointer-events: none;
    }

    // The stack: one drawing, scaled to the stage. On a phone it keeps a
    // readable size and scrolls sideways.
    .stack {
        position: relative;
        max-width: 72rem;
        margin: 0 auto;
        padding-inline: clamp(1rem, 3vw, 2.5rem);

        @include media-breakpoint-down(md) {
            overflow-x: auto;
        }

        svg {
            display: block;
            width: 100%;
            min-width: 46rem;
            height: auto;
            overflow: visible;
            // The site's typeface, not the code one.
            font-family: $font-family-sans-serif;
        }
    }

    // The wires: fine grey lines, rounded at the turns; the audit loop
    // dashed, as in the product's canvas.
    .wires path {
        fill: none;
        stroke: var(--wire);
        stroke-width: 1;

        &.dashed {
            stroke: rgba(255, 255, 255, 0.1);
            stroke-dasharray: 4 5;
        }
    }

    // The pulses ride on copies of the wires, invisible until lit.
    .pulses path {
        fill: none;
        stroke: #ffffff;
        stroke-width: 1.5;
        stroke-linecap: round;
        opacity: 0;
        filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.8));

        &:global(.lit) {
            opacity: 1;
        }

        // The audit pulse, a touch softer.
        &[data-tone="audit"] {
            stroke: rgba(255, 255, 255, 0.7);
        }
    }

    text {
        font-size: 14.5px;
        fill: var(--muted);
    }

    // An agent: a dark chip with its icon, its name lit while it calls.
    .agent {
        rect:first-child {
            fill: #141418;
            stroke: rgba(255, 255, 255, 0.1);
            transition: stroke 0.3s ease;
        }

        // The agent's icon, lit while it calls.
        .glyph {
            color: var(--faint);
            transition: color 0.3s ease;
        }

        .strong {
            fill: #d6d6de;
        }

        .dot {
            fill: var(--faint);
        }

        .call {
            font-size: 13.5px;
            fill: var(--text);
        }

        &[data-state="active"] {
            rect:first-child {
                stroke: rgba(255, 255, 255, 0.35);
            }

            .glyph {
                color: #ffffff;
            }

            .dot {
                fill: #ffffff;
            }
        }
    }

    // Kestra: the band every call crosses. Colour stays in the controls'
    // tags only.
    .band {
        > rect {
            fill: #121216;
            stroke: rgba(255, 255, 255, 0.16);
            transition:
                stroke 0.3s ease,
                fill 0.3s ease;
        }

        .band-name {
            font-size: 17px;
            font-weight: 600;
            fill: #ffffff;
        }

        .band-role {
            font-size: 13.5px;
            fill: var(--muted);
        }

        &[data-state="busy"] > rect,
        &[data-state="denied"] > rect {
            stroke: rgba(255, 255, 255, 0.4);
        }

        // Edged in the background colour, so the wires it crosses break
        // around it.
        .verdict {
            text-anchor: middle;
            font-size: 14px;
            paint-order: stroke;
            stroke: var(--bg);
            stroke-width: 8px;

            &[data-state="denied"] {
                fill: #d6d6de;
            }
        }
    }

    // A control in the band: its dot and label light with its verdict.
    .control {
        rect {
            fill: rgba(255, 255, 255, 0.03);
            stroke: rgba(255, 255, 255, 0.08);
            transition: stroke 0.3s ease;
        }

        .state {
            fill: var(--faint);
            transition: fill 0.3s ease;
        }

        text {
            font-size: 13.5px;
            fill: var(--muted);
            transition: fill 0.3s ease;
        }

        &[data-state="ok"] {
            rect {
                stroke: rgba(255, 255, 255, 0.22);
            }

            .state {
                fill: #ffffff;
            }

            text {
                fill: #ffffff;
            }
        }

        // Held for a person: the dot breathes until the approval comes.
        &[data-state="waiting"] {
            .state {
                fill: #d6d6de;
                animation: breathe 1s ease-in-out infinite alternate;
            }

            text {
                fill: #d6d6de;
            }
        }

        &[data-state="denied"] {
            rect {
                stroke: rgba(255, 92, 122, 0.5);
            }

            .state {
                fill: var(--danger);
            }

            text {
                fill: var(--danger);
            }
        }
    }

    // A domain: a dashed outline around a dark tile, as in the reference;
    // it lights once an action lands.
    .domain {
        // Filled with the background, so the wires stop at its edge.
        .outline {
            fill: var(--bg);
            stroke: rgba(255, 255, 255, 0.14);
            stroke-dasharray: 4 4;
        }

        .inner {
            fill: #121216;
            stroke: rgba(255, 255, 255, 0.08);
            transition: stroke 0.3s ease;
        }

        text {
            text-anchor: middle;
            font-size: 13.5px;
        }

        .result {
            fill: #d6d6de;
        }

        &[data-state="ok"] {
            .inner {
                stroke: rgba(255, 255, 255, 0.4);
            }

            text:not(.result) {
                fill: #ffffff;
            }
        }
    }

    @keyframes breathe {
        to {
            opacity: 0.25;
        }
    }
</style>
