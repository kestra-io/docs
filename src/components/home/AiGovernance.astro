---
/**
 * Melissa's AI orchestration block. The agent is not a gateway in front of
 * the systems but one step inside a governed flow (see AiFlow): trigger,
 * task, agent, approval, task, with RBAC, approvals and audit logs around
 * the whole run, and the control plane's four domains in context.
 */
import AiFlow from "./AiFlow.astro"
import PixelEdges from "~/components/about/PixelEdges.astro"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"

interface Props {
    eyebrow?: string
    bridge?: boolean
    foot?: boolean
}

const { eyebrow, bridge = true, foot = true } = Astro.props
---

<section
    class="ai-governance is-aurora surface-dark"
    aria-labelledby="ai-governance"
    data-header-dark
>
    {/* The About us pixel art, as in the blocks above. */}
    <PixelEdges left="wide" right="tall" />
    {/* A faint technical grid behind the stack, fading out at the edges. */}
    <span class="texture" aria-hidden="true"></span>
    {
        /* Two small pixel clusters in Kestra's violet, as on the control plane's panels. */
    }
    <span
        class="cluster top"
        aria-hidden="true"
        style={`--pixels: url("${pixelCluster}")`}></span>
    <span
        class="cluster bottom"
        aria-hidden="true"
        style={`--pixels: url("${pixelCluster}")`}></span>
    {/* A soft light that follows the pointer across the block. */}
    <span class="glow" aria-hidden="true" data-glow></span>
    {
        /* A planet rising from the foot of the section, cut by its edge, in
        the 2.0 page's colours: its lit limb arcs behind the flow. */
    }
    <div class="planet" aria-hidden="true">
        <span class="haze"></span>
        <span class="atmosphere"></span>
        <span class="rim"></span>
        <span class="limb"></span>
    </div>
    {
        /* The block's end: a horizon of light where the planet is cut, the
        Enterprise block's black beyond it. */
    }
    <span class="horizon" aria-hidden="true"></span>
    <div class="container-xl">
        <div class="rails">
            {
                /* The link to the control plane above: its dashed line,
                from a node on its panel's foot, carries on down to the
                agent, with a run travelling along it. */
            }
            {bridge && <span class="bridge" aria-hidden="true" />}
            <div class="head">
                <div>
                    {
                        /* The agent from the launch video: the bridge from the
                        control plane lands on it, and it greets the block. */
                    }
                    <div class="mascot" data-mascot aria-hidden="true">
                        <span class="ring"></span>
                        <span class="ring outer"></span>
                        <span class="disc">
                            <svg viewBox="0 0 48 48">
                                <rect
                                    class="antenna"
                                    x="20"
                                    y="6"
                                    width="8"
                                    height="7"
                                    rx="3.5"></rect>
                                <rect
                                    x="5"
                                    y="19"
                                    width="5"
                                    height="12"
                                    rx="2.5"></rect>
                                <rect
                                    x="38"
                                    y="19"
                                    width="5"
                                    height="12"
                                    rx="2.5"></rect>
                                <rect
                                    class="face"
                                    x="11.5"
                                    y="12.5"
                                    width="25"
                                    height="24"
                                    rx="3.5"></rect>
                                <g class="eyes" data-eyes>
                                    <circle
                                        class="eye"
                                        cx="19.5"
                                        cy="22"
                                        r="2.4"></circle>
                                    <circle
                                        class="eye wink"
                                        cx="28.5"
                                        cy="22"
                                        r="2.4"></circle>
                                </g>
                                <rect
                                    class="mouth"
                                    x="18"
                                    y="29"
                                    width="12"
                                    height="2.75"
                                    rx="1"></rect>
                            </svg>
                        </span>
                    </div>
                    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
                    <h2 id="ai-governance">
                        <slot name="title">
                            AI agents cross systems seamlessly. <span
                                >Enforce governance at every step.</span
                            >
                        </slot>
                    </h2>
                    <p class="lead">
                        <slot name="lead">
                            Permissions, approvals, and audit trails apply to
                            every action an agent takes.
                        </slot>
                    </p>
                </div>
            </div>

            <slot name="cards" />

            <figure class="stack">
                <AiFlow />
            </figure>

            {/* A secondary button, under the schema. */}
            {
                foot && (
                    <div class="foot">
                        <a href="/ai-automation" class="btn-ghost">
                            How agents fit
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</section>

<script>
    // While a [data-header-dark] section sits under the fixed menu, the menu
    // turns dark too (Header.vue reads body[data-header-over-dark]).
    function watchDarkSections() {
        const sections =
            document.querySelectorAll<HTMLElement>("[data-header-dark]")
        if (!sections.length || document.body.dataset.darkSectionsWatched)
            return
        document.body.dataset.darkSectionsWatched = "true"
        let frame = 0
        const update = () => {
            frame = 0
            const bar = document.getElementById("top-bar")
            // The menu mounts after this script: wait for it.
            if (!bar) return setTimeout(schedule, 100)
            const line = bar.getBoundingClientRect().bottom - 1
            const over = [...sections].some((section) => {
                const box = section.getBoundingClientRect()
                // A few pixels' grace: the hero starts just under the menu.
                return box.top <= line + 4 && box.bottom > line
            })
            document.body.toggleAttribute("data-header-over-dark", over)
        }
        const schedule = () => {
            frame ||= requestAnimationFrame(update)
        }
        window.addEventListener("scroll", schedule, { passive: true })
        window.addEventListener("resize", schedule)
        document.addEventListener(
            "astro:before-swap",
            () => {
                window.removeEventListener("scroll", schedule)
                window.removeEventListener("resize", schedule)
                document.body.removeAttribute("data-header-over-dark")
                delete document.body.dataset.darkSectionsWatched
            },
            { once: true },
        )
        update()
    }

    document.addEventListener("astro:page-load", watchDarkSections)
    watchDarkSections()

    // The agent pops in once in view and winks, then blinks now and then;
    // its eyes follow the pointer, a couple of units at most.
    function wakeMascot(root: HTMLElement) {
        if (root.dataset.awake) return
        root.dataset.awake = "true"
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.classList.add("in")
            return
        }
        const eyes = root.querySelector<SVGGElement>("[data-eyes]")!
        const flash = (name: string, ms: number) => {
            root.classList.add(name)
            setTimeout(() => root.classList.remove(name), ms)
        }

        let timer = 0
        const blinkLater = () => {
            timer = window.setTimeout(
                () => {
                    flash("blinking", 250)
                    blinkLater()
                },
                3500 + Math.random() * 3000,
            )
        }
        // It comes in when the bridge from the control plane lands on it
        // (see arriveAi).
        root.addEventListener(
            "mascot:arrive",
            () => {
                root.classList.add("in")
                setTimeout(() => flash("winking", 500), 700)
                setTimeout(blinkLater, 1400)
            },
            { once: true },
        )

        let frame = 0
        let pointer = { x: 0, y: 0 }
        // While the stack points it at a step, it looks there instead.
        let target: Element | null = null
        const look = () => {
            frame = 0
            const box = root.getBoundingClientRect()
            const at = target?.getBoundingClientRect()
            const x0 = at ? at.left + at.width / 2 : pointer.x
            const y0 = at ? at.top + at.height / 2 : pointer.y
            const dx = x0 - (box.left + box.width / 2)
            const dy = y0 - (box.top + box.height / 2)
            const distance = Math.hypot(dx, dy) || 1
            const reach = at ? 1 : Math.min(1, distance / 320)
            const x = (dx / distance) * 3.2 * reach
            const y = (dy / distance) * 2.6 * reach
            eyes.style.transform = `translate(${x}px, ${y}px)`
        }
        const follow = (event: PointerEvent) => {
            pointer = { x: event.clientX, y: event.clientY }
            if (!target) frame ||= requestAnimationFrame(look)
        }
        window.addEventListener("pointermove", follow, { passive: true })
        root.addEventListener("mascot:look", (event) => {
            target = (event as CustomEvent<Element | null>).detail
            frame ||= requestAnimationFrame(look)
        })
        document.addEventListener(
            "astro:before-swap",
            () => {
                window.removeEventListener("pointermove", follow)
                clearTimeout(timer)
            },
            { once: true },
        )
    }

    function wakeMascots() {
        document
            .querySelectorAll<HTMLElement>("[data-mascot]")
            .forEach(wakeMascot)
    }

    document.addEventListener("astro:page-load", wakeMascots)
    wakeMascots()

    // The light follows the pointer while it is over the block.
    function trackGlow(glow: HTMLElement) {
        if (glow.dataset.tracking) return
        glow.dataset.tracking = "true"
        if (!matchMedia("(pointer: fine)").matches) return
        const section = glow.parentElement!
        let frame = 0
        let point = { x: 0, y: 0 }
        const move = () => {
            frame = 0
            glow.style.setProperty("--x", `${point.x}px`)
            glow.style.setProperty("--y", `${point.y}px`)
        }
        section.addEventListener("pointermove", (event) => {
            const box = section.getBoundingClientRect()
            point = { x: event.clientX - box.left, y: event.clientY - box.top }
            // Coming in, it lights where the pointer is, without sliding
            // over from where it last was.
            if (!glow.classList.contains("on")) {
                glow.style.transition = "opacity 0.6s ease"
                move()
                requestAnimationFrame(() => (glow.style.transition = ""))
                glow.classList.add("on")
                return
            }
            frame ||= requestAnimationFrame(move)
        })
        section.addEventListener("pointerleave", () =>
            glow.classList.remove("on"),
        )
    }

    function trackGlows() {
        document.querySelectorAll<HTMLElement>("[data-glow]").forEach(trackGlow)
    }

    document.addEventListener("astro:page-load", trackGlows)
    trackGlows()

    // The arrival on the block, as the agent comes into view: the
    // control plane's open panel lights up, the bridge's node pops in at
    // its foot, then travels down, drawing the dashed line, and lands on
    // the agent, which greets the block with a wink. Then the title, the
    // copy, the schema and the button rise in turn. Hidden only once
    // armed, so all of it shows without JavaScript.
    function arriveAi() {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
        document
            .querySelectorAll<HTMLElement>(".ai-governance:not(.armed)")
            .forEach((section) => {
                const mascot =
                    section.querySelector<HTMLElement>("[data-mascot]")
                const lower = section.querySelector<HTMLElement>(".bridge")
                const upper = document.querySelector<HTMLElement>(
                    ".control-plane .grid > .bridge",
                )
                const panel = document.querySelector<HTMLElement>(
                    ".control-plane .visuals",
                )
                const node = upper?.querySelector<HTMLElement>(".node")
                if (!mascot) return
                section.classList.add("armed")
                upper?.classList.add("armed")

                const later = (ms: number, step: () => void) =>
                    window.setTimeout(step, ms)

                const play = () => {
                    panel?.classList.add("lit")
                    // The panel lights up first, on its own, then sends the
                    // node out.
                    later(600, () => upper?.classList.add("on"))
                    later(1000, () => {
                        upper?.classList.add("drawn")
                        if (!node || !lower) return
                        // To the foot of the lower dashed line, the top of
                        // the agent's rings; read from the layout, which the
                        // animations do not move.
                        const from = node.getBoundingClientRect()
                        const target =
                            section.getBoundingClientRect().top +
                            lower.offsetTop +
                            lower.offsetHeight
                        node.animate(
                            [
                                { transform: "translateY(0)" },
                                {
                                    transform: `translateY(${target - (from.top + from.height / 2)}px)`,
                                },
                            ],
                            {
                                duration: 900,
                                easing: "cubic-bezier(0.65, 0, 0.35, 1)",
                                fill: "forwards",
                            },
                        )
                    })
                    later(1450, () => lower?.classList.add("drawn"))
                    // The node lands: the agent pops in and winks, and the
                    // rest of the block follows.
                    later(1900, () => {
                        mascot.dispatchEvent(new Event("mascot:arrive"))
                        upper?.classList.add("done")
                    })
                    later(2300, () => section.classList.add("in"))
                    // The panel stays lit until the agent has greeted.
                    later(3000, () => panel?.classList.remove("lit"))
                }

                const seen = new IntersectionObserver(
                    ([entry]) => {
                        if (!entry.isIntersecting) return
                        seen.disconnect()
                        play()
                    },
                    { rootMargin: "0px 0px -15% 0px" },
                )
                seen.observe(mascot)
            })
    }

    document.addEventListener("astro:page-load", arriveAi)
    arriveAi()

    // Once the agent has arrived, and while the control plane is still in
    // sight above it, each task that succeeds there sends a packet, in the
    // open use case's tint, down to the agent: out of the node, down to the
    // panel's foot, along it to the bridge, then down the bridge, where the
    // agent's rings take it in.
    function feedAgent() {
        if (document.documentElement.dataset.feedingAgent) return
        document.documentElement.dataset.feedingAgent = "true"
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return

        const inView = (box: DOMRect) =>
            box.bottom > 0 && box.top < window.innerHeight

        document.addEventListener("topology:progress", (event) => {
            const section =
                document.querySelector<HTMLElement>(".ai-governance.in")
            const mascot = section?.querySelector<HTMLElement>("[data-mascot]")
            const topology = event.target as HTMLElement
            const visual = topology.closest<HTMLElement>(
                "[data-domain-visual].active",
            )
            const bridge = document.querySelector<HTMLElement>(
                ".control-plane .grid > .bridge",
            )
            if (!mascot || !visual || !bridge) return

            const nodes = topology.querySelectorAll<HTMLElement>("[data-node]")
            const detail = (event as CustomEvent<number>).detail
            const node = nodes[Math.round(detail * nodes.length) - 1]
            if (!node) return
            const from = node.getBoundingClientRect()
            const to = mascot.getBoundingClientRect()
            if (!inView(from) || !inView(to)) return

            // The route, in page coordinates, read from the layout.
            const foot = visual.getBoundingClientRect().bottom - 14
            const x = bridge.getBoundingClientRect().left
            const points = [
                [from.left + from.width / 2, from.bottom],
                [from.left + from.width / 2, foot],
                [x, foot],
                [x, to.top],
            ].map(([px, py]) => [px + window.scrollX, py + window.scrollY])
            const legs = points
                .slice(1)
                .map((p, i) =>
                    Math.hypot(p[0] - points[i][0], p[1] - points[i][1]),
                )
            const length = legs.reduce((sum, leg) => sum + leg, 0)
            let run = 0
            const offsets = [0, ...legs.map((leg) => (run += leg) / length)]

            const tint = getComputedStyle(visual).getPropertyValue("--tint")
            const packet = document.createElement("span")
            packet.className = "agent-packet"
            packet.style.setProperty("--tint", tint)
            document.body.appendChild(packet)
            const flight = packet.animate(
                points.map(([px, py], i) => ({
                    offset: offsets[i],
                    transform: `translate(${px}px, ${py}px)`,
                    opacity: i === 0 ? 0 : 1,
                })),
                {
                    duration: Math.min(2200, Math.max(1100, length * 1.6)),
                    easing: "cubic-bezier(0.45, 0, 0.25, 1)",
                },
            )
            flight.onfinish = () => {
                packet.remove()
                // The rings take it in.
                mascot
                    .querySelector(".ring.outer")
                    ?.animate(
                        [
                            { transform: "scale(1)", borderColor: tint },
                            { transform: "scale(1.12)", offset: 0.4 },
                            { transform: "scale(1)" },
                        ],
                        { duration: 600, easing: "ease-out" },
                    )
            }
        })
    }

    document.addEventListener("astro:page-load", feedAgent)
    feedAgent()
</script>

<style lang="scss">
    @use "/src/assets/styles/color-palette" as *;

    // Dark in both themes.
    .ai-governance {
        // The page's dark grey, as the control plane above.
        --bg: #1c1c20;
        --ink: #ffffff;
        --ink-2: #d6d6de;
        --node: #141418;
        --node-hi: #2c2c33;
        --glow: 255, 255, 255;
        --glow-a: 1;
        --pulse: #ffffff;
        --pulse-kestra: #b48cff;
        // The rails, in the control plane's rule colour above.
        --line: var(--ks-border-primary);
        --wire: rgba(255, 255, 255, 0.14);
        --text: #ffffff;
        --muted: #a3a3b1;
        --faint: #5c5c68;
        // Grey and white throughout; red only in a refused check's tag.
        --danger: #ff5c7a;

        // The menu reads these while it sits over the section.
        --ks-content-primary: #{$base-grey-white};
        --ks-content-secondary: #{$base-grey-200};
        --ks-content-tertiary: #{$base-grey-300};
        --ks-content-link: #{$base-primary-200};

        // The planet's night side, which the foot of the block fades into.
        --night: #060609;

        position: relative;
        overflow: hidden;
        // The control plane's grey at the top, down to the planet's night
        // at the foot, so its dark side melts into the block, and the black
        // Enterprise block follows on. The planet's indigo rises from the
        // foot into it, wide and faint, on both sides of its arc.
        background:
            radial-gradient(
                ellipse 75% 55% at 50% 100%,
                rgba(70, 44, 255, 0.16),
                rgba(60, 30, 240, 0.06) 55%,
                transparent 80%
            ),
            linear-gradient(
                180deg,
                var(--bg) 0%,
                var(--bg) 30%,
                #100e1c 70%,
                var(--night) 100%
            );
        color: var(--text);
    }

    // The section is dark in both themes: the pixels take their dark-theme
    // tint.
    .ai-governance :global(.pixel-edges) {
        --pixel: rgba(167, 150, 255, 0.07);
    }

    // The pixel clusters: one in the top right, by the button, one low on
    // the left, under the mascot.
    .cluster {
        position: absolute;
        width: 96px;
        aspect-ratio: 194 / 168;
        background: #8405ff;
        mask: var(--pixels) no-repeat center / contain;
        opacity: 0.22;
        pointer-events: none;

        &.top {
            top: 2.5rem;
            right: clamp(1.5rem, 6vw, 6rem);
        }

        &.bottom {
            bottom: 2.5rem;
            left: clamp(1.5rem, 6vw, 6rem);
            transform: scaleX(-1);
            opacity: 0.14;
        }

        .ai-governance:not(.is-light) & {
            display: none;
        }
    }

    // Hairline rails down the sides, on the other blocks' lines.
    .rails {
        position: relative;
        // Close under the control plane, the bridge between the two.
        padding: clamp(2.5rem, 4vw, 3.5rem) 0 clamp(4rem, 6vw, 5.5rem);

        &::before,
        &::after {
            content: "";
            position: absolute;
            z-index: 3;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--line);
            pointer-events: none;
        }

        &::before {
            left: 0;
        }

        // Below a wide screen they would sit a few pixels in from the
        // screen's edge: none there.
        @include media-breakpoint-down(xl) {
            &::before,
            &::after {
                display: none;
            }
        }

        &::after {
            right: 0;
        }
    }

    // Centred: the agent, then the title and the copy under it.
    .head {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2.5rem;
        padding-inline: clamp(1.5rem, 4vw, 3.5rem);
        text-align: center;

        @include media-breakpoint-down(md) {
            margin-bottom: 1.5rem;
        }

        > div {
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 56rem;
        }
    }

    // The agent from the launch video: a robot in a dark disc, ringed
    // with dashes. It pops in, winks, and its eyes follow the pointer.
    .mascot {
        display: grid;
        place-items: center;
        z-index: 1;
        position: relative;
        width: 9rem;
        height: 9rem;
        // Atop the head, where the bridge from the control plane lands.
        margin: 0 auto 1.25rem;

        .ring {
            position: absolute;
            inset: 1.25rem;
            border: 1px dashed color-mix(in srgb, var(--ink) 24%, transparent);
            border-radius: 50%;
            opacity: 0;
            transform: scale(0.6);
            transition:
                opacity 0.6s ease 0.25s,
                transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.25s;

            &.outer {
                inset: 0;
                border-color: color-mix(in srgb, var(--ink) 12%, transparent);
                transition-delay: 0.4s;
            }
        }

        .disc {
            display: grid;
            place-items: center;
            width: 4.75rem;
            height: 4.75rem;
            border-radius: 50%;
            background: linear-gradient(
                180deg,
                var(--node-hi) 0%,
                var(--node) 100%
            );
            box-shadow: 0 0 0 1px
                color-mix(in srgb, var(--ink) 16%, transparent);
            opacity: 0;
            transform: scale(0.3);
            transition:
                opacity 0.3s ease,
                transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        svg {
            width: 3rem;
            height: 3rem;
            fill: var(--ink);
        }

        .face {
            fill: none;
            stroke: var(--ink);
            stroke-width: 3.25;
        }

        .eyes {
            transition: transform 0.25s ease-out;
        }

        .eye,
        .mouth {
            transform-box: fill-box;
            transform-origin: center;
            transition: transform 0.25s ease;
        }

        &:global(.in) {
            .ring,
            .disc {
                opacity: 1;
                transform: none;
            }
        }

        // On the light block, in the logo's hue: a violet disc with a
        // white robot, and violet rings.
        .is-light & {
            .ring {
                border-color: rgba(169, 80, 255, 0.4);

                &.outer {
                    border-color: rgba(169, 80, 255, 0.2);
                }
            }

            .disc {
                // The logo's violet, a step quieter than the brand's.
                background: linear-gradient(180deg, #a982ff 0%, #7448e8 100%);
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.35),
                    0 8px 22px -10px rgba(91, 40, 210, 0.5);
            }

            svg {
                fill: #ffffff;
            }

            .face {
                stroke: #ffffff;
            }

            .antenna {
                fill: #ffffff;
            }
        }

        &:global(.winking) .wink {
            animation: shut 0.45s ease-in-out;
        }

        &:global(.blinking) .eye {
            animation: shut 0.22s ease-in-out;
        }

        // Its moods, as the calls go through the stack.
        // Sending a task: a nod towards the agent.
        &[data-mood="send"] .disc {
            animation: nod 0.5s ease;
        }

        // A check passes: eyes narrowed, content.
        &[data-mood="ok"] .eye {
            transform: scaleY(0.55);
        }

        // Held for a person: the dashed ring turns while it waits.
        &[data-mood="wait"] .ring:not(.outer) {
            animation: turn 6s linear infinite;
        }

        // Done: a hop, a grin.
        &[data-mood="happy"] {
            .disc {
                animation: hop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            }

            .eye {
                transform: scaleY(0.45);
            }

            .mouth {
                transform: scaleX(1.3);
            }
        }

