                stroke: #cd88ff;
                filter: drop-shadow(0 0 14px rgba(169, 80, 255, 0.3));
            }
        }

        .control {
            rect {
                fill: rgba(255, 255, 255, 0.06);
                stroke: rgba(255, 255, 255, 0.12);
            }

            text {
                fill: #a3a0c4;
            }

            // The dots in colour: a dim green while the control stands
