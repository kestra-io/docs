            .state {
                fill: rgba(122, 240, 194, 0.35);
            }

            &[data-state="ok"],
            &[data-state="waiting"],
            &[data-state="denied"] {
                rect {
                    fill: rgba(255, 255, 255, 0.1);
                    stroke: rgba(255, 255, 255, 0.2);
