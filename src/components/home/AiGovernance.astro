---
/**
 * Melissa's AI orchestration block, drawn as Kai's stack resolved: the
 * agents on top, Kestra in the middle as the one layer every action crosses
 * (permissions, approvals, audit trail), and under it the same four domains
 * as the control plane block above. Calls run down as pulses; one is turned
 * back by policy, and every outcome loops back into one audit trail.
 * Without JavaScript, or with reduced motion, the stack stands still.
 */
import { Icon } from "astro-icon/components"
import kestraLogo from "./assets/ai/kestra-logo-full-on-dark.svg"
import PixelEdges from "~/components/about/PixelEdges.astro"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"

// The drawing's grid, in viewBox units, read left to right: the mascot,
// the agents, Kestra, then the domains, with the audit trail looping back
// along the floor.
interface Props {
    eyebrow?: string
    bridge?: boolean
    foot?: boolean
}

const { eyebrow, bridge = true, foot = true } = Astro.props

const W = 1200
const H = 420
// The drawing starts a little left of the agents.
const VIEW_X = 150
const AGENT_X = 190
const AGENT_W = 180
const AGENT_H = 58
const BAND_X = 470
const BAND_W = 300
const BAND_Y = 74
const BAND_H = 252
const DOMAIN_X = 830
const DOMAIN_W = 200
const DOMAIN_H = 56
const AUDIT_X = 1190
const AUDIT_Y = 398

const AGENTS = [
    { id: "support", name: "Support", cy: 110 },
    { id: "ops", name: "Ops", cy: 200 },
    { id: "finance", name: "Finance", cy: 290 },
]

// The control plane block's four domains, in its order.
const DOMAINS = [
    { id: "infra", name: "Infrastructure", cy: 80 },
    { id: "data", name: "Data pipelines", cy: 160 },
    { id: "business", name: "Business processes", cy: 240 },
    { id: "it", name: "IT operations", cy: 320 },
]

const CONTROLS = [
    { id: "permissions", name: "Permissions", y: BAND_Y + 92 },
    { id: "approvals", name: "Approvals", y: BAND_Y + 140 },
    { id: "audit", name: "Audit trail", y: BAND_Y + 188 },
]
const CONTROL_W = 240

const agentPath = (cy: number) => `M ${AGENT_X + AGENT_W} ${cy} H ${BAND_X}`
const domainPath = (cy: number) => `M ${BAND_X + BAND_W} ${cy} H ${DOMAIN_X}`
// From a domain's right edge, down the right side and back along the
// floor into the band's foot: every outcome ends in the one audit trail.
// Each domain joins one shared line on the right; only the top one turns
// into it, the others meet it square, so the turns do not pile up.
const FIRST_CY = 80
const auditBranch = (cy: number) =>
    cy === FIRST_CY
        ? `M ${DOMAIN_X + DOMAIN_W} ${cy} H ${AUDIT_X - 20} Q ${AUDIT_X} ${cy} ${AUDIT_X} ${cy + 20}`
        : `M ${DOMAIN_X + DOMAIN_W} ${cy} H ${AUDIT_X}`
// The shared line, down and back along the floor into the band's foot.
const auditTrunk = [
    `M ${AUDIT_X} ${FIRST_CY + 20}`,
    `V ${AUDIT_Y - 20}`,
    `Q ${AUDIT_X} ${AUDIT_Y} ${AUDIT_X - 20} ${AUDIT_Y}`,
    `H ${BAND_X + BAND_W / 2 + 20}`,
    `Q ${BAND_X + BAND_W / 2} ${AUDIT_Y} ${BAND_X + BAND_W / 2} ${AUDIT_Y - 20}`,
    `V ${BAND_Y + BAND_H}`,
].join(" ")
// A pulse's whole way: its branch, then down the shared line.
const auditPath = (cy: number) =>
    [
        `M ${DOMAIN_X + DOMAIN_W} ${cy}`,
        `H ${AUDIT_X}`,
        `V ${AUDIT_Y - 20}`,
        `Q ${AUDIT_X} ${AUDIT_Y} ${AUDIT_X - 20} ${AUDIT_Y}`,
        `H ${BAND_X + BAND_W / 2 + 20}`,
        `Q ${BAND_X + BAND_W / 2} ${AUDIT_Y} ${BAND_X + BAND_W / 2} ${AUDIT_Y - 20}`,
        `V ${BAND_Y + BAND_H}`,
    ].join(" ")
---

<section
    class="ai-governance is-light is-aurora"
    aria-labelledby="ai-governance"
>
    {/* The About us pixel art, as in the blocks above. */}
    <PixelEdges left="wide" right="tall" />
    {/* A faint technical grid behind the stack, fading out at the edges. */}
    <span class="texture" aria-hidden="true"></span>
    {
        /* Two small pixel clusters in Kestra's violet, as on the control plane's panels. */
    }
    <span
        class="cluster top"
        aria-hidden="true"
        style={`--pixels: url("${pixelCluster}")`}></span>
    <span
        class="cluster bottom"
        aria-hidden="true"
        style={`--pixels: url("${pixelCluster}")`}></span>
    {/* A soft light that follows the pointer across the block. */}
    <span class="glow" aria-hidden="true" data-glow></span>
    <div class="container-xl">
        <div class="rails">
            {
                /* The link to the control plane above: its dashed line,
                from a node on its panel's foot, carries on down to the
                agent, with a run travelling along it. */
            }
            {bridge && <span class="bridge" aria-hidden="true" />}
            <div class="head">
                <div>
                    {
                        /* The agent from the launch video: the bridge from the
                        control plane lands on it, and it greets the block. */
                    }
                    <div class="mascot" data-mascot aria-hidden="true">
                        <span class="ring"></span>
                        <span class="ring outer"></span>
                        <span class="disc">
                            <svg viewBox="0 0 48 48">
                                <rect
                                    class="antenna"
                                    x="20"
                                    y="6"
                                    width="8"
                                    height="7"
                                    rx="3.5"></rect>
                                <rect
                                    x="5"
                                    y="19"
                                    width="5"
                                    height="12"
                                    rx="2.5"></rect>
                                <rect
                                    x="38"
                                    y="19"
                                    width="5"
                                    height="12"
                                    rx="2.5"></rect>
                                <rect
                                    class="face"
                                    x="11.5"
                                    y="12.5"
                                    width="25"
                                    height="24"
                                    rx="3.5"></rect>
                                <g class="eyes" data-eyes>
                                    <circle
                                        class="eye"
                                        cx="19.5"
                                        cy="22"
                                        r="2.4"></circle>
                                    <circle
                                        class="eye wink"
                                        cx="28.5"
                                        cy="22"
                                        r="2.4"></circle>
                                </g>
                                <rect
                                    class="mouth"
                                    x="18"
                                    y="29"
                                    width="12"
                                    height="2.75"
                                    rx="1"></rect>
                            </svg>
                        </span>
                    </div>
                    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
                    <h2 id="ai-governance">
                        <slot name="title">
                            AI agents cross systems seamlessly. <span
                                >Enforce governance at every step.</span
                            >
                        </slot>
                    </h2>
                    <p class="lead">
                        <slot name="lead">
                            Permissions, approvals, and audit trails apply to
                            every action an agent takes.
                        </slot>
                    </p>
                </div>
            </div>

            <slot name="cards" />

            <figure
                class="stack"
                aria-label="AI agents call into Kestra, which checks permissions, holds approvals and keeps the audit trail before any action reaches infrastructure, data pipelines, business processes or IT operations. A drop_table call from the finance agent is blocked by policy."
                data-ai-stack
            >
                {
                    /* A wink to the launch video's agent: it pops in, winks,
                    then follows the pointer with its eyes. It briefs the three agents
                    below, one wire each. */
                }
                <div class="canvas">
                    <svg
                        viewBox={`${VIEW_X} 0 ${W - VIEW_X} ${H}`}
                        role="presentation"
                        aria-hidden="true"
                    >
                        {
                            /* The wires, faint; the pulses run on copies of them. */
                        }
                        <g class="wires">
                            {
                                AGENTS.map((agent) => (
                                    <path d={agentPath(agent.cy)} />
                                ))
                            }
                            {
                                DOMAINS.map((domain) => (
                                    <path d={domainPath(domain.cy)} />
                                ))
                            }
                            {
                                DOMAINS.map((domain) => (
                                    <path
                                        class="dashed"
                                        d={auditBranch(domain.cy)}
                                    />
                                ))
                            }
                            <path class="dashed" d={auditTrunk}></path>
                        </g>

                        <g class="pulses">
                            {
                                AGENTS.map((agent) => (
                                    <path
                                        d={agentPath(agent.cy)}
                                        data-pulse={`agent-${agent.id}`}
                                    />
                                ))
                            }
                            {
                                DOMAINS.map((domain) => (
                                    <path
                                        d={domainPath(domain.cy)}
                                        data-pulse={`domain-${domain.id}`}
                                    />
                                ))
                            }
                            {
                                DOMAINS.map((domain) => (
                                    <path
                                        d={auditPath(domain.cy)}
                                        data-pulse={`audit-${domain.id}`}
                                    />
                                ))
                            }
                        </g>

                        {
                            /* The agents, each with the call it is making under it. */
                        }
                        {
                            AGENTS.map((agent) => (
                                <g class="agent" data-agent={agent.id}>
                                    <rect
                                        class="halo"
                                        x={AGENT_X - 6}
                                        y={agent.cy - AGENT_H / 2 - 6}
                                        width={AGENT_W + 12}
                                        height={AGENT_H + 12}
                                        rx="13"
                                    />
                                    <rect
                                        class="tile"
                                        x={AGENT_X}
                                        y={agent.cy - AGENT_H / 2}
                                        width={AGENT_W}
                                        height={AGENT_H}
                                        rx="8"
                                    />
                                    <g
                                        class="glyph"
                                        transform={`translate(${AGENT_X + 16} ${agent.cy - 9})`}
                                    >
                                        <Icon
                                            name="mdi:robot-outline"
                                            width="18"
                                            height="18"
                                        />
                                    </g>
                                    <text x={AGENT_X + 44} y={agent.cy - 3}>
                                        <tspan class="strong">
                                            {agent.name}
                                        </tspan>{" "}
                                        agent
                                    </text>
                                    <circle
                                        class="dot"
                                        cx={AGENT_X + AGENT_W + 12}
                                        cy={agent.cy}
                                        r="2.5"
                                    />
                                    {/* The call it makes, under its name, inside
                                    the tile: as a task's type in a topology. */}
                                    <text
                                        class="call"
                                        x={AGENT_X + 44}
                                        y={agent.cy + 15}
                                        data-call
                                    />
                                </g>
                            ))
                        }

                        {/* Kestra: the one layer every action crosses. */}
                        <g class="band" data-band>
                            <rect
                                class="halo"
                                x={BAND_X - 8}
                                y={BAND_Y - 8}
                                width={BAND_W + 16}
                                height={BAND_H + 16}
                                rx="18"></rect>
                            <rect
                                class="tile"
                                x={BAND_X}
                                y={BAND_Y}
                                width={BAND_W}
                                height={BAND_H}
                                rx="12"></rect>
                            {/* The full logo, wordmark and red dot. */}
                            <image
                                href={kestraLogo.src}
                                x={BAND_X + BAND_W / 2 - 60}
                                y={BAND_Y + 24}
                                width="120"
                                height={(120 * 203) / 889}
                            />
                            {
                                /* A hairline between the name and its controls. */
                            }
                            <path
                                class="band-rule"
                                d={`M ${BAND_X + 30} ${BAND_Y + 74} H ${BAND_X + BAND_W - 30}`}
                            ></path>
                            {
                                CONTROLS.map((control) => (
                                    <g
                                        class="control"
                                        data-control={control.id}
                                    >
                                        <rect
                                            x={BAND_X + 30}
                                            y={control.y}
                                            width={CONTROL_W}
                                            height="36"
                                            rx="7"
                                        />
                                        <circle
                                            class="state"
                                            cx={BAND_X + 48}
                                            cy={control.y + 18}
                                            r="3.5"
                                        />
                                        <text
                                            x={BAND_X + 62}
                                            y={control.y + 22}
                                            data-label={control.name}
                                        >
                                            {control.name}
                                        </text>
                                    </g>
                                ))
                            }
                            <text
                                class="verdict"
                                x={BAND_X + BAND_W / 2}
                                y={BAND_Y + BAND_H + 30}
                                data-verdict></text>
                        </g>

                        {/* The control plane block's four domains. */}
                        {
                            DOMAINS.map((domain) => (
                                <g class="domain" data-domain={domain.id}>
                                    <rect
                                        class="outline"
                                        x={DOMAIN_X}
                                        y={domain.cy - DOMAIN_H / 2}
                                        width={DOMAIN_W}
                                        height={DOMAIN_H}
                                        rx="10"
                                    />
                                    <rect
                                        class="inner"
                                        x={DOMAIN_X + 6}
                                        y={domain.cy - DOMAIN_H / 2 + 6}
                                        width={DOMAIN_W - 12}
                                        height={DOMAIN_H - 12}
                                        rx="6"
                                    />
                                    <text
                                        x={DOMAIN_X + DOMAIN_W / 2}
                                        y={domain.cy + 5}
                                    >
                                        {domain.name}
                                    </text>
                                </g>
                            ))
                        }
                    </svg>
                    {
                        /* The outcomes, as glass pills over their wires: HTML, so
                    they can blur what runs behind them. */
                    }
                    {
                        DOMAINS.map((domain) => (
                            <span
                                class="result"
                                style={`left: ${((DOMAIN_X + DOMAIN_W + 18 - VIEW_X) / (W - VIEW_X)) * 100}%; top: ${(domain.cy / H) * 100}%`}
                                data-result={domain.id}
                            />
                        ))
                    }
                </div>
            </figure>

            {/* A secondary button, under the schema. */}
            {
                foot && (
                    <div class="foot">
                        <a href="/ai-automation" class="btn-ghost">
                            How agents fit <Icon name="mdi:chevron-right" />
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</section>

<script>
    // While a [data-header-dark] section sits under the fixed menu, the menu
    // turns dark too (Header.vue reads body[data-header-over-dark]).
    function watchDarkSections() {
        const sections =
            document.querySelectorAll<HTMLElement>("[data-header-dark]")
        if (!sections.length || document.body.dataset.darkSectionsWatched)
            return
        document.body.dataset.darkSectionsWatched = "true"
        let frame = 0
        const update = () => {
            frame = 0
            const bar = document.getElementById("top-bar")
            // The menu mounts after this script: wait for it.
            if (!bar) return setTimeout(schedule, 100)
            const line = bar.getBoundingClientRect().bottom - 1
            const over = [...sections].some((section) => {
                const box = section.getBoundingClientRect()
                // A few pixels' grace: the hero starts just under the menu.
                return box.top <= line + 4 && box.bottom > line
            })
            document.body.toggleAttribute("data-header-over-dark", over)
        }
        const schedule = () => {
            frame ||= requestAnimationFrame(update)
        }
        window.addEventListener("scroll", schedule, { passive: true })
        window.addEventListener("resize", schedule)
        document.addEventListener(
            "astro:before-swap",
            () => {
                window.removeEventListener("scroll", schedule)
                window.removeEventListener("resize", schedule)
                document.body.removeAttribute("data-header-over-dark")
                delete document.body.dataset.darkSectionsWatched
            },
            { once: true },
        )
        update()
    }

    document.addEventListener("astro:page-load", watchDarkSections)
    watchDarkSections()

    // The calls, one after the other, then the loop starts over:
    //   support → refund_order: permitted, held for j.kim's approval, run in
    //             business processes, then audited;
    //   ops     → restart_service: permitted, run in IT operations, audited;
    //   finance → drop_table on data pipelines: turned back by policy, and
    //             the refusal is audited too.
    type Call = {
        agent: string
        call: string
        domain: string
        approval?: string
        denied?: boolean
    }
    const CALLS: Call[] = [
        {
            agent: "support",
            call: "refund_order",
            domain: "business",
            approval: "j.kim",
        },
        { agent: "ops", call: "restart_service", domain: "it" },
        { agent: "finance", call: "drop_table", domain: "data", denied: true },
    ]

    function playStack(root: HTMLElement) {
        if (root.dataset.playing) return
        root.dataset.playing = "true"
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return

        const q = <T extends Element>(sel: string) =>
            root.querySelector<T>(sel)!
        const band = q<SVGGElement>("[data-band]")
        const verdict = q<SVGTextElement>("[data-verdict]")
        const control = (id: string) => q<SVGGElement>(`[data-control="${id}"]`)
        const auditLabel = control("audit").querySelector("text")!

        let visible = false
        let waiters: (() => void)[] = []
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting
            if (visible) waiters.splice(0).forEach((go) => go())
        }).observe(root)

        // Waits, and holds while the block is off screen.
        const wait = async (ms: number) => {
            await new Promise((done) => setTimeout(done, ms))
            if (!visible) await new Promise<void>((go) => waiters.push(go))
        }

        // A short streak of light along a wire.
        const pulse = (id: string, ms: number, tone = "") =>
            new Promise<void>((done) => {
                const path = q<SVGPathElement>(`[data-pulse="${id}"]`)
                const length = path.getTotalLength()
                const streak = Math.min(70, length * 0.45)
                path.style.strokeDasharray = `${streak} ${length + streak}`
                path.dataset.tone = tone
                path.classList.add("lit")
                const run = path.animate(
                    [
                        { strokeDashoffset: streak },
                        { strokeDashoffset: -length },
                    ],
                    { duration: ms, easing: "cubic-bezier(0.45, 0, 0.2, 1)" },
                )
                run.onfinish = () => {
                    path.classList.remove("lit")
                    done()
                }
            })

        // The mascot reacts to each step, and looks where it happens.
        const mascot = root
            .closest("section")
            ?.querySelector<HTMLElement>("[data-mascot]")
        const mood = (name: string, target: Element | null = null) => {
            if (!mascot) return
            if (name) mascot.dataset.mood = name
            else delete mascot.dataset.mood
            mascot.dispatchEvent(
                new CustomEvent("mascot:look", { detail: target }),
            )
        }

        const set = (el: Element, state: string) =>
            el.setAttribute("data-state", state)
        const clear = (el: Element) => el.removeAttribute("data-state")
        let audited = 0

        const reset = () => {
            root.querySelectorAll("[data-state]").forEach(clear)
            root.querySelectorAll("[data-call], [data-result]").forEach(
                (el) => (el.textContent = ""),
            )
            verdict.textContent = ""
            control("approvals").querySelector("text")!.textContent =
                "Approvals"
        }

        const play = async (call: Call) => {
            // Each call starts with fresh checks; the audit trail keeps
            // counting.
            clear(control("permissions"))
            clear(control("approvals"))
            control("approvals").querySelector("text")!.textContent =
                "Approvals"
            const agent = q<SVGGElement>(`[data-agent="${call.agent}"]`)
            const domain = q<SVGGElement>(`[data-domain="${call.domain}"]`)
            // The mascot hands the agent its task.
            mood("send", agent)
            await wait(600)
            set(agent, "active")
            agent.querySelector("[data-call]")!.textContent = call.call
            await wait(500)
            await pulse(`agent-${call.agent}`, 900)

            set(band, "busy")
            set(control("permissions"), call.denied ? "denied" : "ok")
            mood(call.denied ? "denied" : "ok", control("permissions"))
            await wait(500)

            if (call.denied) {
                set(band, "denied")
                verdict.textContent = `${call.call} · blocked by Kestra policy`
                set(verdict, "denied")
                audited += 1
                set(control("audit"), "ok")
                auditLabel.textContent = `Audit trail · ${audited}`
                await wait(2600)
                mood("")
                clear(band)
                clear(agent)
                return
            }

            if (call.approval) {
                const approvals = control("approvals")
                set(approvals, "waiting")
                mood("wait", approvals)
                approvals.querySelector("text")!.textContent =
                    `Awaiting ${call.approval}`
                await wait(1300)
                set(approvals, "ok")
                mood("ok", approvals)
                approvals.querySelector("text")!.textContent =
                    `Approved by ${call.approval}`
                await wait(500)
            }

            await pulse(`domain-${call.domain}`, 700)
            set(domain, "ok")
            mood("happy", domain)
            q(`[data-result="${call.domain}"]`).textContent = `✓ ${call.call}`
            await wait(400)
            await pulse(`audit-${call.domain}`, 1300, "audit")
            audited += 1
            set(control("audit"), "ok")
            auditLabel.textContent = `Audit trail · ${audited}`
            await wait(900)
            mood("")
            clear(band)
            clear(agent)
        }

        const loop = async () => {
            if (!visible) await new Promise<void>((go) => waiters.push(go))
            for (;;) {
                reset()
                audited = 0
                auditLabel.textContent = "Audit trail"
                await wait(600)
                for (const call of CALLS) await play(call)
                await wait(1800)
            }
        }
        loop()
    }

    function startStacks() {
        document
            .querySelectorAll<HTMLElement>("[data-ai-stack]")
            .forEach(playStack)
    }

    document.addEventListener("astro:page-load", startStacks)
    startStacks()

    // The agent pops in once in view and winks, then blinks now and then;
    // its eyes follow the pointer, a couple of units at most.
    function wakeMascot(root: HTMLElement) {
        if (root.dataset.awake) return
        root.dataset.awake = "true"
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.classList.add("in")
            return
        }
        const eyes = root.querySelector<SVGGElement>("[data-eyes]")!
        const flash = (name: string, ms: number) => {
            root.classList.add(name)
            setTimeout(() => root.classList.remove(name), ms)
        }

        let timer = 0
        const blinkLater = () => {
            timer = window.setTimeout(
                () => {
                    flash("blinking", 250)
                    blinkLater()
                },
                3500 + Math.random() * 3000,
            )
        }
        // It comes in when the bridge from the control plane lands on it
        // (see arriveAi).
        root.addEventListener(
            "mascot:arrive",
            () => {
                root.classList.add("in")
                setTimeout(() => flash("winking", 500), 700)
                setTimeout(blinkLater, 1400)
            },
            { once: true },
        )

        let frame = 0
        let pointer = { x: 0, y: 0 }
        // While the stack points it at a step, it looks there instead.
        let target: Element | null = null
        const look = () => {
            frame = 0
            const box = root.getBoundingClientRect()
            const at = target?.getBoundingClientRect()
            const x0 = at ? at.left + at.width / 2 : pointer.x
            const y0 = at ? at.top + at.height / 2 : pointer.y
            const dx = x0 - (box.left + box.width / 2)
            const dy = y0 - (box.top + box.height / 2)
            const distance = Math.hypot(dx, dy) || 1
            const reach = at ? 1 : Math.min(1, distance / 320)
            const x = (dx / distance) * 3.2 * reach
            const y = (dy / distance) * 2.6 * reach
            eyes.style.transform = `translate(${x}px, ${y}px)`
        }
        const follow = (event: PointerEvent) => {
            pointer = { x: event.clientX, y: event.clientY }
            if (!target) frame ||= requestAnimationFrame(look)
        }
        window.addEventListener("pointermove", follow, { passive: true })
        root.addEventListener("mascot:look", (event) => {
            target = (event as CustomEvent<Element | null>).detail
            frame ||= requestAnimationFrame(look)
        })
        document.addEventListener(
            "astro:before-swap",
            () => {
                window.removeEventListener("pointermove", follow)
                clearTimeout(timer)
            },
            { once: true },
        )
    }

    function wakeMascots() {
        document
            .querySelectorAll<HTMLElement>("[data-mascot]")
            .forEach(wakeMascot)
    }

    document.addEventListener("astro:page-load", wakeMascots)
    wakeMascots()

    // The light follows the pointer while it is over the block.
    function trackGlow(glow: HTMLElement) {
        if (glow.dataset.tracking) return
        glow.dataset.tracking = "true"
        if (!matchMedia("(pointer: fine)").matches) return
        const section = glow.parentElement!
        let frame = 0
        let point = { x: 0, y: 0 }
        const move = () => {
            frame = 0
            glow.style.setProperty("--x", `${point.x}px`)
            glow.style.setProperty("--y", `${point.y}px`)
        }
        section.addEventListener("pointermove", (event) => {
            const box = section.getBoundingClientRect()
            point = { x: event.clientX - box.left, y: event.clientY - box.top }
            // Coming in, it lights where the pointer is, without sliding
            // over from where it last was.
            if (!glow.classList.contains("on")) {
                glow.style.transition = "opacity 0.6s ease"
                move()
                requestAnimationFrame(() => (glow.style.transition = ""))
                glow.classList.add("on")
                return
            }
            frame ||= requestAnimationFrame(move)
        })
        section.addEventListener("pointerleave", () =>
            glow.classList.remove("on"),
        )
    }

    function trackGlows() {
        document.querySelectorAll<HTMLElement>("[data-glow]").forEach(trackGlow)
    }

    document.addEventListener("astro:page-load", trackGlows)
    trackGlows()

    // The arrival on the block, as the agent comes into view: the
    // control plane's open panel lights up, the bridge's node pops in at
    // its foot, then travels down, drawing the dashed line, and lands on
    // the agent, which greets the block with a wink. Then the title, the
    // copy, the schema and the button rise in turn. Hidden only once
    // armed, so all of it shows without JavaScript.
    function arriveAi() {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
        document
            .querySelectorAll<HTMLElement>(".ai-governance:not(.armed)")
            .forEach((section) => {
                const mascot =
                    section.querySelector<HTMLElement>("[data-mascot]")
                const lower = section.querySelector<HTMLElement>(".bridge")
                const upper = document.querySelector<HTMLElement>(
                    ".control-plane .grid > .bridge",
                )
                const panel = document.querySelector<HTMLElement>(
                    ".control-plane .visuals",
                )
                const node = upper?.querySelector<HTMLElement>(".node")
                if (!mascot) return
                section.classList.add("armed")
                upper?.classList.add("armed")

                const later = (ms: number, step: () => void) =>
                    window.setTimeout(step, ms)

                const play = () => {
                    panel?.classList.add("lit")
                    // The panel lights up first, on its own, then sends the
                    // node out.
                    later(600, () => upper?.classList.add("on"))
                    later(1000, () => {
                        upper?.classList.add("drawn")
                        if (!node || !lower) return
                        // To the foot of the lower dashed line, the top of
                        // the agent's rings; read from the layout, which the
                        // animations do not move.
                        const from = node.getBoundingClientRect()
                        const target =
                            section.getBoundingClientRect().top +
                            lower.offsetTop +
                            lower.offsetHeight
                        node.animate(
                            [
                                { transform: "translateY(0)" },
                                {
                                    transform: `translateY(${target - (from.top + from.height / 2)}px)`,
                                },
                            ],
                            {
                                duration: 900,
                                easing: "cubic-bezier(0.65, 0, 0.35, 1)",
                                fill: "forwards",
                            },
                        )
                    })
                    later(1450, () => lower?.classList.add("drawn"))
                    // The node lands: the agent pops in and winks, and the
                    // rest of the block follows.
                    later(1900, () => {
                        mascot.dispatchEvent(new Event("mascot:arrive"))
                        upper?.classList.add("done")
                    })
                    later(2300, () => section.classList.add("in"))
                    // The panel stays lit until the agent has greeted.
                    later(3000, () => panel?.classList.remove("lit"))
                }

                const seen = new IntersectionObserver(
                    ([entry]) => {
                        if (!entry.isIntersecting) return
                        seen.disconnect()
                        play()
                    },
                    { rootMargin: "0px 0px -15% 0px" },
                )
                seen.observe(mascot)
            })
    }

    document.addEventListener("astro:page-load", arriveAi)
    arriveAi()

    // Once the agent has arrived, and while the control plane is still in
    // sight above it, each task that succeeds there sends a packet, in the
    // open use case's tint, down to the agent: out of the node, down to the
    // panel's foot, along it to the bridge, then down the bridge, where the
    // agent's rings take it in.
    function feedAgent() {
        if (document.documentElement.dataset.feedingAgent) return
        document.documentElement.dataset.feedingAgent = "true"
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return

        const inView = (box: DOMRect) =>
            box.bottom > 0 && box.top < window.innerHeight

        document.addEventListener("topology:progress", (event) => {
            const section =
                document.querySelector<HTMLElement>(".ai-governance.in")
            const mascot = section?.querySelector<HTMLElement>("[data-mascot]")
            const topology = event.target as HTMLElement
            const visual = topology.closest<HTMLElement>(
                "[data-domain-visual].active",
            )
            const bridge = document.querySelector<HTMLElement>(
                ".control-plane .grid > .bridge",
            )
            if (!mascot || !visual || !bridge) return

            const nodes = topology.querySelectorAll<HTMLElement>("[data-node]")
            const detail = (event as CustomEvent<number>).detail
            const node = nodes[Math.round(detail * nodes.length) - 1]
            if (!node) return
            const from = node.getBoundingClientRect()
            const to = mascot.getBoundingClientRect()
            if (!inView(from) || !inView(to)) return

            // The route, in page coordinates, read from the layout.
            const foot = visual.getBoundingClientRect().bottom - 14
            const x = bridge.getBoundingClientRect().left
            const points = [
                [from.left + from.width / 2, from.bottom],
                [from.left + from.width / 2, foot],
                [x, foot],
                [x, to.top],
            ].map(([px, py]) => [px + window.scrollX, py + window.scrollY])
            const legs = points
                .slice(1)
                .map((p, i) =>
                    Math.hypot(p[0] - points[i][0], p[1] - points[i][1]),
                )
            const length = legs.reduce((sum, leg) => sum + leg, 0)
            let run = 0
            const offsets = [0, ...legs.map((leg) => (run += leg) / length)]

            const tint = getComputedStyle(visual).getPropertyValue("--tint")
            const packet = document.createElement("span")
            packet.className = "agent-packet"
            packet.style.setProperty("--tint", tint)
            document.body.appendChild(packet)
            const flight = packet.animate(
                points.map(([px, py], i) => ({
                    offset: offsets[i],
                    transform: `translate(${px}px, ${py}px)`,
                    opacity: i === 0 ? 0 : 1,
                })),
                {
                    duration: Math.min(2200, Math.max(1100, length * 1.6)),
                    easing: "cubic-bezier(0.45, 0, 0.25, 1)",
                },
            )
            flight.onfinish = () => {
                packet.remove()
                // The rings take it in.
                mascot
                    .querySelector(".ring.outer")
                    ?.animate(
                        [
                            { transform: "scale(1)", borderColor: tint },
                            { transform: "scale(1.12)", offset: 0.4 },
                            { transform: "scale(1)" },
                        ],
                        { duration: 600, easing: "ease-out" },
                    )
            }
        })
    }

    document.addEventListener("astro:page-load", feedAgent)
    feedAgent()
</script>

