---

{
    /* On the page's hairline grid: the head, then one row per domain, its
    copy on the left and its live topology on the right. */
}
<section class="control-plane" aria-labelledby="control-plane">
    {/* A few About us pixels at the edges. */}
    <PixelEdges left="cluster" right="wide" />
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="control-plane">One control plane for every workflow</h2>
                <p>
                    Give teams shared visibility and consistent governance
                    across workflows.
                </p>
            </header>

            <ul class="rows">
                {
                    DOMAINS.map((domain) => (
                        <li class="domain-row" style={`--tint: ${domain.tint}`}>
                            <div class="copy">
                                <h3>{domain.title}</h3>
                                <p>{domain.description}</p>
                                {/* The vertical's solution page, or its
                                blueprints when it has none yet. */}
                                <a
                                    href={domain.solutionHref ?? "/blueprints"}
                                    class="btn-ghost compact"
                                >
                                    {domain.solutionHref
                                        ? "Explore the solution"
                                        : "Browse blueprints"}
                                </a>
                            </div>

                            <div
                                class:list={[
                                    "lane",
                                    {
                                        "has-trigger":
                                            domain.topology.nodes.some((node) =>
                                                node.plugin.startsWith(
                                                    "core.trigger.",
                                                ),
                                            ),
                                    },
                                ]}
                                style={`--pixels: url("${pixelCluster}")`}
                            >
                                {/* A small About us pixel cluster, in the vertical's colour. */}
                                <span class="pixels" aria-hidden="true" />
                                <TopologyMock {...domain.topology} />
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    .control-plane {
        position: relative;
        background: var(--ks-background-body);
    }

    // The page's hairline grid: rails on both sides, and full-width rules
    // between the rows.
    .grid {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);
    }

    // The title on one line, the copy under it.
    .head {
        display: grid;
        row-gap: 1.25rem;
        padding: 8.5rem var(--inset) 4rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--ks-content-primary);
            text-wrap: balance;
        }

        p {
            max-width: calc(26rem + 2 * var(--inset));
            margin: 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: var(--ks-content-tertiary);
            text-wrap: pretty;
        }
    }

    // One row per domain, between full-width rules.
    .rows {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    // Not .row: Bootstrap gives that class negative gutters.
    .domain-row {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 32rem) minmax(0, 1fr);
        border-top: var(--rule);

        &::before {
            content: "";
            position: absolute;
            top: -1px;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--ks-border-primary);
            pointer-events: none;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    // The domain's copy and its way on.
    .copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        // Room around the copy, so each row breathes.
        justify-content: center;
        padding: clamp(3rem, 5vw, 4.5rem) var(--inset);
        border-right: var(--rule);

        @include media-breakpoint-down(lg) {
            border-right: 0;
            border-bottom: var(--rule);
        }

        h3 {
            margin: 0 0 1rem;
            font-size: clamp(1.5rem, 2.2vw, 1.875rem);
            letter-spacing: -0.01em;
            line-height: 1.2;
            font-weight: 600;
            color: var(--ks-content-primary);
        }

        p {
            margin: 0 0 1.75rem;
            font-size: 1rem;
            line-height: 1.6;
            color: var(--ks-content-secondary);
        }

        .btn-ghost {
            margin-top: 0.25rem;
        }
    }

    // The domain's live topology, on a soft glow of its colour, with one
    // small pixel cluster in the top corner, as before.
    .lane {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        // Tall rows, so each use case has room around its topology.
        min-height: 30rem;
        padding: 3.5rem 0;
        overflow: hidden;
        background:
            radial-gradient(
                80% 90% at 100% 0%,
                color-mix(in srgb, var(--tint) 18%, transparent),
                transparent 70%
            ),
            color-mix(in srgb, var(--tint) 3%, var(--ks-background-body));

        :global(html.dark) & {
            background:
                radial-gradient(
                    80% 90% at 100% 0%,
                    color-mix(in srgb, var(--tint) 12%, transparent),
                    transparent 70%
                ),
                color-mix(in srgb, var(--tint) 3%, var(--ks-background-body));
        }

        // A trigger's capsule rises above the first node: half of that
        // moves the topology down, so what shows sits centred in the lane.
        &.has-trigger :global(.canvas) {
            translate: 0 20px;
        }

        .pixels {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            width: 80px;
            aspect-ratio: 194 / 168;
            background: var(--tint);
            mask: var(--pixels) no-repeat center / contain;
            opacity: 0.3;
            pointer-events: none;
        }
    }
</style>
