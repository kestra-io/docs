---

{
    /* On the hairline grid of the About us Backers block, lined up with the
    hero frame: a compact two-column head, then the domains on the left (the
    open one shows its copy) and its product screen on the right. */
}
<section class="control-plane" aria-labelledby="control-plane" data-domains>
    {/* A few About us pixels at the edges, where the hero hands over. */}
    <PixelEdges left="cluster" right="wide" />
    {/* container-xl, like the hero frame, so the rails sit on its edges. */}
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="control-plane">One control plane for every workflow</h2>
                <p>
                    Give teams shared visibility and consistent governance
                    across workflows.
                </p>
            </header>
            <div class="body">
                <ul class="domains">
                    {
                        DOMAINS.map((domain, idx) => (
                            <li
                                class:list={["domain", { active: idx === 0 }]}
                                data-domain={domain.id}
                                style={`--tint: ${domain.tint}`}
                            >
                                <button
                                    type="button"
                                    class="domain-toggle"
                                    aria-expanded={idx === 0 ? "true" : "false"}
                                    aria-controls={`domain-copy-${domain.id}`}
                                >
                                    {/* The short label while closed, the full title once
                                    open, so the two never stack. */}
                                    <span class="label">{domain.label}</span>
                                    <span class="title">{domain.title}</span>
                                </button>
                                <div
                                    id={`domain-copy-${domain.id}`}
                                    class="domain-copy"
                                >
                                    <div class="domain-copy-inner">
                                        <p>{domain.description}</p>
                                        {domain.solutionHref && (
                                            <a
                                                href={domain.solutionHref}
                                                class="solution"
                                            >
                                                <span>
                                                    Explore the solution
                                                </span>
                                                <Icon name="mdi:arrow-right" />
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </li>
                        ))
                    }
                </ul>

                <div class="visuals">
                    {
                        DOMAINS.map((domain, idx) => (
                            <div
                                class:list={["visual", { active: idx === 0 }]}
                                data-domain-visual={domain.id}
                                style={`--tint: ${domain.tint}; --pixels: url("${pixelCluster}")`}
                            >
                                {/* A small About us pixel cluster, in the vertical's color. */}
                                <span class="pixels" aria-hidden="true" />
                                <TopologyMock {...domain.topology} />
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // One domain open at a time, on click: its copy expands on the left and
    // its screen fades in on the right.
    function wireDomains() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-domains]",
        )) {
            if (root.dataset.wired === "true") continue
            root.dataset.wired = "true"

            const items = [...root.querySelectorAll<HTMLElement>(".domain")]
            const toggles = items.map((item) =>
                item.querySelector<HTMLElement>(".domain-toggle")!,
            )
            const visuals = [
                ...root.querySelectorAll<HTMLElement>("[data-domain-visual]"),
            ]

            const open = (idx: number) => {
                items.forEach((item, i) => {
                    item.classList.toggle("active", i === idx)
                    toggles[i].setAttribute("aria-expanded", String(i === idx))
                })
                visuals.forEach((visual, i) =>
                    visual.classList.toggle("active", i === idx),
                )
            }

            // The list keeps the height of its tallest open domain, so
            // switching never moves the page.
            const list = root.querySelector<HTMLElement>(".domains")!
            const settle = () => {
                const current = items.findIndex((item) =>
                    item.classList.contains("active"),
                )
                root.classList.add("measuring")
                list.style.minHeight = ""
                let tallest = 0
                items.forEach((_, idx) => {
                    open(idx)
                    tallest = Math.max(
                        tallest,
                        Math.ceil(list.getBoundingClientRect().height),
                    )
                })
                open(current)
                list.style.minHeight = `${tallest}px`
                root.classList.remove("measuring")
            }
            settle()
            window.addEventListener("resize", settle)
            document.fonts?.ready.then(settle)

            // Until the visitor picks a domain, the domains take turns: the
            // open one's marker fills as its run goes, and once the run is
            // done the next domain opens.
            let auto = !matchMedia("(prefers-reduced-motion: reduce)").matches
            if (auto) items[0].style.setProperty("--progress", "0")
            const shownIndex = (event: Event) =>
                visuals.findIndex(
                    (visual) =>
                        visual.contains(event.target as Node) &&
                        visual.classList.contains("active"),
                )
            root.addEventListener("topology:progress", (event) => {
                const idx = shownIndex(event)
                if (!auto || idx < 0) return
                items[idx].style.setProperty(
                    "--progress",
                    String((event as CustomEvent<number>).detail),
                )
            })
            root.addEventListener("topology:done", (event) => {
                const idx = shownIndex(event)
                if (!auto || idx < 0) return
                setTimeout(() => {
                    if (!auto || !visuals[idx].classList.contains("active"))
                        return
                    items[idx].style.removeProperty("--progress")
                    const next = (idx + 1) % items.length
                    items[next].style.setProperty("--progress", "0")
                    open(next)
                }, 1200)
            })
            const takeOver = () => {
                auto = false
                items.forEach((item) => item.style.removeProperty("--progress"))
            }

            toggles.forEach((toggle, idx) => {
                toggle.addEventListener("click", () => {
                    takeOver()
                    open(idx)
                })
                toggle.addEventListener("keydown", (e) => {
                    const step =
                        e.key === "ArrowDown" ? 1 : e.key === "ArrowUp" ? -1 : 0
                    if (!step) return
                    e.preventDefault()
                    takeOver()
                    const next = (idx + step + toggles.length) % toggles.length
                    toggles[next].focus()
                    open(next)
                })
            })
        }
    }

    document.addEventListener("astro:page-load", wireDomains)
    wireDomains()
</script>

<style lang="scss">
    .control-plane {
        position: relative;
        // Switching domains must not make the browser re-anchor the scroll.
        overflow-anchor: none;
        background: var(--ks-background-body);
        border-top: 1px solid var(--ks-border-primary);
        border-bottom: 1px solid var(--ks-border-primary);
    }

    // Hairline grid: rails on both sides of the content, and full-width rules
    // between rows, like the About us Backers block. The rails sit on the
    // hero frame's edges and the inset matches its padding, so the copy lines
    // up with the hero's.
    .grid {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);

        // An empty closing row between the rails, so the panel does not run
        // straight into the dark section below.
        padding-bottom: clamp(4rem, 7vw, 6.5rem);

        > .body {
            position: relative;
            border-block: var(--rule);

            &::before,
            &::after {
                content: "";
                position: absolute;
                left: -100vw;
                right: -100vw;
                height: 1px;
                background: var(--ks-border-primary);
                pointer-events: none;
            }

            &::before {
                top: -1px;
            }

            &::after {
                bottom: -1px;
            }
        }
    }

    // Compact head: the title on the left, Melissa's line on the right.
    .head {
        display: grid;
        // Same columns as the body below: the title over the domains, the
        // copy lined up with the panel's content.
        grid-template-columns: minmax(0, 29rem) minmax(0, 1fr);
        row-gap: 1.25rem;
        align-items: end;
        padding: 6rem 0 4rem;

        > * {
            padding-inline: var(--inset);
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--ks-content-primary);
            text-wrap: balance;

            // Two lines, free to run past its column into the gutter
            // before the copy.
            @include media-breakpoint-up(lg) {
                width: max-content;
                max-width: 10em;
                padding-right: 0;
            }
        }

        p {
            max-width: calc(26rem + 2 * var(--inset));
            margin: 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: var(--ks-content-tertiary);
            text-wrap: pretty;
        }
    }

    .body {
        background: var(--ks-background-body);
        display: grid;
        grid-template-columns: minmax(0, 29rem) minmax(0, 1fr);

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    // Domains on the left; the open one shows its copy, marked on the rail.
    .domains {
        margin: 0;
        padding: 3.5rem 0;
        list-style: none;
        border-right: var(--rule);

        @include media-breakpoint-down(lg) {
            border-right: 0;
            border-bottom: var(--rule);
        }
    }

    .domain {
        position: relative;
        padding: 0 var(--inset);

        &::before {
            content: "";
            position: absolute;
            top: 0.5rem;
            bottom: 0.5rem;
            left: -1px;
            width: 2px;
            background: var(--tint);
            opacity: 0;
            // Fills with the run while the domains take turns.
            transform: scaleY(var(--progress, 1));
            transform-origin: top;
            transition:
                opacity 0.2s ease,
                transform 0.4s ease;
        }

        &.active::before {
            opacity: 1;
        }

        & + & {
            margin-top: 0.75rem;
        }
    }

    .domain-toggle {
        display: block;
        width: 100%;
        padding: 0.625rem 0;
        border: 0;
        background: none;
        font-size: 1.125rem;
        font-weight: 500;
        text-align: left;
        color: var(--ks-content-tertiary);
        cursor: pointer;
        transition: color 0.2s ease;

        &:hover {
            color: var(--ks-content-secondary);
        }

        &:focus-visible {
            outline: 2px solid var(--ks-border-active);
            outline-offset: 2px;
            border-radius: 4px;
        }

        .active & {
            font-weight: 600;
            color: var(--ks-content-primary);
            cursor: default;
        }

        .title {
            display: none;
        }

        .active & {
            .label {
                display: none;
            }

            .title {
                display: inline;
            }
        }
    }

    // The open domain's copy slides open under its name.
    .measuring .domain-copy,
    .measuring .domain-copy-inner {
        transition: none !important;
    }

    .domain-copy {
        display: grid;
        grid-template-rows: 0fr;
        overflow: hidden;
        transition: grid-template-rows 0.3s ease;

        .domain-copy-inner {
            min-height: 0;
            padding-bottom: 1.5rem;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .active & {
            grid-template-rows: 1fr;

            .domain-copy-inner {
                opacity: 1;
                transition-delay: 0.1s;
            }
        }

        p {
            margin: 0;
            max-width: 23rem;
            font-size: 1rem;
            line-height: 1.7;
            color: var(--ks-content-secondary);
        }
    }

    // A quiet link that reads with the copy, underlined in the vertical's
    // color, rather than a button competing with the visual.
    .solution {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ks-content-primary);
        text-decoration: none;

        span {
            background: linear-gradient(var(--tint), var(--tint)) left bottom /
                100% 2px no-repeat;
            transition: background-size 0.25s ease;
        }

        :global(svg) {
            width: 1rem;
            height: 1rem;
            transition: transform 0.2s ease;
        }

        &:hover,
        &:focus-visible {
            color: var(--ks-content-primary);

            span {
                background-size: 100% 4px;
            }

            :global(svg) {
                transform: translateX(3px);
            }
        }
    }

    // The product screen fills the right column, in a grey panel, cropped at
    // its bottom right.
    .visuals {
        position: relative;
        // Stretches with the domain column, so the panel always reaches the
        // rule below.
        min-height: max(26rem, min(34rem, calc(100vh - 10rem)));
        background: var(--ks-background-body);
        overflow: hidden;
    }

    // Screens are stacked and cross-fade. Each sits on a soft glow of its
    // vertical's color, with one small pixel cluster in the top corner.
    .visual {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        // The topology runs edge to edge, centered in the panel's height.
        padding: var(--inset) 0;
        background:
            radial-gradient(
                80% 90% at 100% 0%,
                color-mix(in srgb, var(--tint) 20%, transparent),
                transparent 70%
            ),
            color-mix(in srgb, var(--tint) 3%, var(--ks-background-body));
        opacity: 0;
        transition: opacity 0.5s ease;
        pointer-events: none;

        > * {
            transform: translateY(16px);
            transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        }

        &.active {
            opacity: 1;
            pointer-events: auto;

            > * {
                transform: none;
            }
        }

        :global(html.dark) & {
            background:
                radial-gradient(
                    80% 90% at 100% 0%,
                    color-mix(in srgb, var(--tint) 12%, transparent),
                    transparent 70%
                ),
                color-mix(in srgb, var(--tint) 3%, var(--ks-background-body));
        }

        .pixels {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            width: 96px;
            aspect-ratio: 194 / 168;
            background: var(--tint);
            mask: var(--pixels) no-repeat center / contain;
            opacity: 0.3;
            pointer-events: none;
        }
    }
</style>
