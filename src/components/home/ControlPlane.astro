---

{
    /* On the hairline grid of the About us Backers block, lined up with the
    hero frame: a centred head, then the four use cases as tabs above one
    tinted panel, where the open one's copy sits beside its product screen. */
}
<section class="control-plane" aria-labelledby="control-plane" data-domains>
    {/* A few About us pixels at the edges, where the hero hands over. */}
    <PixelEdges left="cluster" right="wide" />
    {/* container-xl, like the hero frame, so the rails sit on its edges. */}
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <h2 id="control-plane">One control plane for every workflow</h2>
                <p>
                    Give teams shared visibility and consistent governance
                    across workflows.
                </p>
            </header>
            <div class="body">
                <div class="tabs" role="tablist" aria-label="Use cases">
                    {
                        DOMAINS.map((domain, idx) => (
                            <button
                                type="button"
                                role="tab"
                                id={`domain-tab-${domain.id}`}
                                class:list={["tab", { active: idx === 0 }]}
                                aria-selected={idx === 0 ? "true" : "false"}
                                aria-controls={`domain-panel-${domain.id}`}
                                tabindex={idx === 0 ? 0 : -1}
                                style={`--tint: ${domain.tint}`}
                            >
                                <span class="swatch" aria-hidden="true" />
                                {domain.label}
                            </button>
                        ))
                    }
                </div>

                <div class="visuals">
                    {
                        DOMAINS.map((domain, idx) => (
                            <div
                                id={`domain-panel-${domain.id}`}
                                role="tabpanel"
                                aria-labelledby={`domain-tab-${domain.id}`}
                                class:list={["visual", { active: idx === 0 }]}
                                data-domain-visual={domain.id}
                                style={`--tint: ${domain.tint}; --pixels: url("${pixelCluster}")`}
                            >
                                {/* A small About us pixel cluster, in the vertical's color. */}
                                <span class="pixels" aria-hidden="true" />
                                <div class="panel-copy">
                                    <h3>{domain.title}</h3>
                                    <p>{domain.description}</p>
                                    {/* The vertical's solution page, or its
                                    blueprints when it has none yet. */}
                                    <a
                                        href={
                                            domain.solutionHref ?? "/blueprints"
                                        }
                                        class="btn-ghost compact solution"
                                    >
                                        {domain.solutionHref
                                            ? "Explore the solution"
                                            : "Browse blueprints"}
                                    </a>
                                </div>
                                <div class="panel-topology">
                                    <ControlPlaneTopology
                                        {...domain.topology}
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            {
                /* The start of the bridge to the AI block below: a node on the
            panel's foot, and a dashed line down to the seam. */
            }
            <span class="bridge" aria-hidden="true">
                <span class="node"></span>
                <span class="run"></span>
            </span>
        </div>
    </div>
</section>

<script>
    // One use case open at a time: its tab lights up and its panel, copy
    // and screen together, fades in.
    function wireDomains() {
        for (const root of document.querySelectorAll<HTMLElement>(
            "[data-domains]",
        )) {
            if (root.dataset.wired === "true") continue
            root.dataset.wired = "true"

            const tabs = [...root.querySelectorAll<HTMLElement>(".tab")]
            const visuals = [
                ...root.querySelectorAll<HTMLElement>("[data-domain-visual]"),
            ]

            const open = (idx: number) => {
                tabs.forEach((tab, i) => {
                    tab.classList.toggle("active", i === idx)
                    tab.setAttribute("aria-selected", String(i === idx))
                    tab.tabIndex = i === idx ? 0 : -1
                })
                visuals.forEach((visual, i) =>
                    visual.classList.toggle("active", i === idx),
                )
            }

            // Until the visitor picks one, the use cases take turns: the
            // open tab's line fills as its run goes, and once the run is
            // done the next one opens.
            let auto = !matchMedia("(prefers-reduced-motion: reduce)").matches
            if (auto) tabs[0].style.setProperty("--progress", "0")
            const shownIndex = (event: Event) =>
                visuals.findIndex(
                    (visual) =>
                        visual.contains(event.target as Node) &&
                        visual.classList.contains("active"),
                )
            root.addEventListener("topology:progress", (event) => {
                const idx = shownIndex(event)
                if (!auto || idx < 0) return
                tabs[idx].style.setProperty(
                    "--progress",
                    String((event as CustomEvent<number>).detail),
                )
            })
            root.addEventListener("topology:done", (event) => {
                const idx = shownIndex(event)
                if (!auto || idx < 0) return
                setTimeout(() => {
                    if (!auto || !visuals[idx].classList.contains("active"))
                        return
                    tabs[idx].style.removeProperty("--progress")
                    const next = (idx + 1) % tabs.length
                    tabs[next].style.setProperty("--progress", "0")
                    open(next)
                }, 1200)
            })
            const takeOver = () => {
                auto = false
                tabs.forEach((tab) => tab.style.removeProperty("--progress"))
            }

            tabs.forEach((tab, idx) => {
                tab.addEventListener("click", () => {
                    takeOver()
                    open(idx)
                })
                tab.addEventListener("keydown", (e) => {
                    const step =
                        e.key === "ArrowRight"
                            ? 1
                            : e.key === "ArrowLeft"
                              ? -1
                              : 0
                    if (!step) return
                    e.preventDefault()
                    takeOver()
                    const next = (idx + step + tabs.length) % tabs.length
                    tabs[next].focus()
                    open(next)
                })
            })
        }
    }

    document.addEventListener("astro:page-load", wireDomains)
    wireDomains()
</script>

<style lang="scss">
    .control-plane {
        --blue: #3b5bdb;

        position: relative;
        // Above the AI block, so the bridge's run can cross into it.
        z-index: 1;
        // Switching domains must not make the browser re-anchor the scroll.
        overflow-anchor: none;
        // The AI block's blue, so the two read as one: a soft light from
        // the top left, and a stronger one low on the right that carries
        // on into the AI block below. No rule between them.
        background:
            radial-gradient(
                60% 70% at 0% 0%,
                color-mix(in srgb, var(--blue) 8%, transparent),
                transparent 70%
            ),
            radial-gradient(
                70% 80% at 100% 100%,
                color-mix(in srgb, var(--blue) 14%, transparent),
                transparent 70%
            ),
            color-mix(in srgb, var(--blue) 3%, var(--ks-background-body));

        :global(html.dark) & {
            background: var(--ks-background-body);
            border-bottom: 1px solid var(--ks-border-primary);
        }
    }

    // Hairline grid: rails on both sides of the content, and full-width rules
    // between rows, like the About us Backers block. The rails sit on the
    // hero frame's edges and the inset matches its padding, so the copy lines
    // up with the hero's.
    .grid {
        --rule: 1px solid var(--ks-border-primary);
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);

        // Below a wide screen the rails would sit a few pixels in from the
        // screen's edge: the rules alone carry the grid there.
        @include media-breakpoint-down(xl) {
            border-inline: 0;
        }

        // An empty closing row between the rails, so the panel does not run
        // straight into the dark section below.
        padding-bottom: clamp(2.5rem, 4vw, 3.5rem);

        // The bridge's upper half, through that closing row.
        > .bridge {
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 1px;
            height: clamp(2.5rem, 4vw, 3.5rem);
            pointer-events: none;

            // The dashed line, drawn downwards when the AI block plays its
            // arrival (see arriveAi there).
            &::before {
                content: "";
                position: absolute;
                inset: 0;
                background: repeating-linear-gradient(
                    180deg,
                    color-mix(
                            in srgb,
                            var(--ks-content-primary) 28%,
                            transparent
                        )
                        0 4px,
                    transparent 4px 8px
                );
                transform-origin: top;
                transition: transform 0.45s linear;
            }

            .node {
                position: absolute;
                z-index: 2;
                top: -6px;
                left: -6px;
                width: 13px;
                height: 13px;
                border: 1.5px solid #a950ff;
                border-radius: 50%;
                background: var(--ks-background-body);
                box-shadow: 0 0 0 4px rgba(169, 80, 255, 0.12);
                transition:
                    opacity 0.3s ease,
                    transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
            }

            // A run from the node, all the way down to the AI block's
            // statement: across this half and the AI block's.
            .run {
                position: absolute;
                z-index: 1;
                top: 0;
                left: -1px;
                width: 3px;
                height: 14px;
                border-radius: 2px;
                background: #8405ff;
                opacity: 0;
                animation: bridge-run 2.8s ease-in infinite;
            }

            // Until the arrival: no line, no node, no run.
            &:global(.armed) {
                &::before {
                    transform: scaleY(0);
                }

                .node {
                    opacity: 0;
                    transform: scale(0);
                }

                .run {
                    animation: none;
                }
            }

            &:global(.armed.on) .node {
                opacity: 1;
                transform: none;
            }

            &:global(.armed.drawn)::before {
                transform: none;
            }
        }

        > .body {
            position: relative;
            border-block: var(--rule);

            &::before,
            &::after {
                content: "";
                position: absolute;
                left: -100vw;
                right: -100vw;
                height: 1px;
                background: var(--ks-border-primary);
                pointer-events: none;
            }

            &::before {
                top: -1px;
            }

            &::after {
                bottom: -1px;
            }
        }
    }

    // Compact head: the title on the left, Melissa's line on the right.
    .head {
        // The title on one line, the copy under it, both centred.
        display: grid;
        justify-items: center;
        row-gap: 1.25rem;
        padding: 8.5rem 0 4rem;
        text-align: center;

        > * {
            padding-inline: var(--inset);
        }

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        // Large, as the head of the AI block it hands over to.
        h2 {
            margin: 0;
            font-size: clamp(2.5rem, 5.5vw, 4.5rem);
            font-weight: 600;
            letter-spacing: -0.03em;
            line-height: 1.05;
            color: var(--ks-content-primary);
            text-wrap: balance;
            // Two balanced lines.
            max-width: 10.5em;
        }

        p {
            // One line where there is room.
            max-width: calc(40rem + 2 * var(--inset));
            margin: 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: var(--ks-content-tertiary);
            text-wrap: balance;
        }
    }

    // The tabs on the block's blue; the panel brings its own tint.
    .body {
        background: none;
    }

    // The four use cases, side by side between rules, above the panel.
    .tabs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-bottom: var(--rule);

        @include media-breakpoint-down(md) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .tab {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        padding: 1.375rem 1rem;
        border: 0;
        background: none;
        font-size: 1.0625rem;
        font-weight: 500;
        text-align: center;
        // The same text, open or not: only the square and the line under
        // it take the vertical's colour.
        color: var(--ks-content-primary);
        cursor: pointer;
        transition: background-color 0.3s ease;

        & + & {
            border-left: var(--rule);
        }

        @include media-breakpoint-down(md) {
            &:nth-child(3) {
                border-left: 0;
            }

            &:nth-child(n + 3) {
                border-top: var(--rule);
            }
        }

        &:hover {
            background: color-mix(in srgb, var(--tint) 4%, transparent);
        }

        &:focus-visible {
            outline: 2px solid var(--ks-border-active);
            outline-offset: -2px;
        }

        &.active {
            cursor: default;
        }

        // The tab's line, on the rule under it, in the vertical's color;
        // it fills with the run while the use cases take turns.
        &::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 2px;
            background: var(--tint);
            opacity: 0;
            transform: scaleX(var(--progress, 1));
            transform-origin: left;
            transition:
                opacity 0.2s ease,
                transform 0.4s ease;
        }

        &.active::after {
            opacity: 1;
        }
    }

    .swatch {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 2px;
        background: var(--ks-content-tertiary);
        opacity: 0.5;
        transition:
            background-color 0.3s ease,
            opacity 0.3s ease;

        .active & {
            background: var(--tint);
            opacity: 1;
        }
    }

    // The panels are stacked and cross-fade, each tinted in its vertical's
    // color, its copy on the left and its product screen on the right.
    .visuals {
        position: relative;
        display: grid;
        overflow: hidden;
    }

    // The open panel lights up as the bridge to the AI block leaves it.
    .visual {
        :global(.lit) > &.active {
            box-shadow:
                inset 0 0 0 2px #a950ff,
                inset 0 0 60px rgba(169, 80, 255, 0.16);
        }
    }

    .visual {
        position: relative;
        grid-area: 1 / 1;
        display: grid;
        grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
        align-items: center;
        gap: 2rem;
        min-height: max(28rem, min(32rem, calc(100vh - 14rem)));
        // Even margins all round, so the topology sits centred between
        // the copy and the panel's right edge.
        padding: var(--inset);
        // A white panel on the block's blue, as the AI block's nodes: the
        // vertical's colour stays in its tab and its pixels.
        background: var(--ks-background-body);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.5s ease,
            visibility 0s linear 0.5s;

        > .panel-copy,
        > .panel-topology {
            transform: translateY(16px);
            transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        }

        &.active {
            opacity: 1;
            visibility: visible;
            transition:
                opacity 0.5s ease,
                box-shadow 0.5s ease;

            > .panel-copy,
            > .panel-topology {
                transform: none;
            }
        }

        @include media-breakpoint-down(xl) {
            grid-template-columns: minmax(0, 1fr);
            align-content: start;
        }

        .pixels {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            width: 96px;
            aspect-ratio: 194 / 168;
            background: var(--tint);
            mask: var(--pixels) no-repeat center / contain;
