---
---

<canvas class="sky" aria-hidden="true" data-rocket></canvas>

<script>
    import { HEART, HULL, SPRITE, type Rgb } from "./rocket"

    function flyRocket() {
        const canvas =
            document.querySelector<HTMLCanvasElement>("[data-rocket]")
        if (!canvas || canvas.dataset.wired) return
        canvas.dataset.wired = "true"
        const ctx = canvas.getContext("2d")
        if (!ctx) return
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches

        const HEADING = (-29 * Math.PI) / 180
        const FWD = { x: Math.cos(HEADING), y: Math.sin(HEADING) }

        const FLAGSHIP: Record<string, Rgb> = {
            B: [238, 236, 250],
            D: [150, 152, 196],
            L: [92, 84, 255],
            P: [255, 4, 254],
        }
        const STEPS = 3
        const PLUMES = {
            core: [
                [0, "rgba(130, 90, 255, 1)"],
                [0.2, "rgba(92, 70, 255, 1)"],
                [0.55, "rgba(50, 60, 255, 0.75)"],
                [0.85, "rgba(33, 66, 255, 0.3)"],
                [1, "rgba(33, 66, 255, 0)"],
            ],
            cloud: [
                [0, "rgba(96, 170, 255, 1)"],
                [0.2, "rgba(60, 140, 255, 1)"],
                [0.55, "rgba(40, 110, 255, 0.7)"],
                [0.85, "rgba(30, 90, 255, 0.28)"],
                [1, "rgba(30, 90, 255, 0)"],
            ],
            power: [
                [0, "rgba(255, 255, 255, 1)"],
                [0.12, "rgba(214, 206, 255, 1)"],
                [0.4, "rgba(130, 90, 255, 0.95)"],
                [0.75, "rgba(92, 70, 255, 0.5)"],
                [1, "rgba(60, 60, 255, 0)"],
            ],
        } as const
        type Mode = keyof typeof PLUMES
        const CLOUD_SHAPES = [
            ["...XXXX.....", ".XXXXXXXXX..", "XXXXXXXXXXXX", ".XXXXXXXXXX."],
            [
                "....XXX...",
                "..XXXXXXX.",
                "XXXXXXXXXX",
                "XXXXXXXXXX",
                "..XXXXXX..",
            ],
            ["..XXXX..", "XXXXXXXX", ".XXXXXX."],
        ]
        const mix = { cloud: 0, power: 0 }
        const goal = { cloud: 0, power: 0 }
        const blend = (from: number, to: number, k: number) =>
            from + (to - from) * k
        const tint = (from: Rgb, to: Rgb, k: number) =>
            from.map((c, i) => Math.round(blend(c, to[i], k))).join(", ")

        let width = 0
        let height = 0
        let unit = 14
        let at = { x: 0, y: 0 }
        let reach = 600
        let wide = false
        let plumes: Partial<Record<Mode, HTMLCanvasElement>> = {}
        let cells: { u: number; v: number; ink: string }[] = []
        let clock = 0
        let flow = 0
        let dash = 0
        let spin = 0

        const rand = (i: number, k: number) => {
            const h = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453
            return h - Math.floor(h)
        }
        const LINES = Array.from({ length: 16 }, (_, i) => ({
            lane: rand(i, 1) * 2 - 1,
            pace: 0.8 + rand(i, 2) * 0.7,
            length: 0.6 + rand(i, 3) * 0.8,
            offset: rand(i, 4),
            boost: i >= 8,
        }))
        const CLOUDS = Array.from({ length: 9 }, (_, i) => ({
            x: rand(i, 21),
            y: rand(i, 22),
            shape: CLOUD_SHAPES[i % CLOUD_SHAPES.length],
            size: 1.4 + rand(i, 23) * 1.8,
            pace: 0.7 + rand(i, 24) * 0.9,
            alpha: 0.22 + rand(i, 25) * 0.34,
        }))
        const STARS = Array.from({ length: 140 }, (_, i) => {
            const depth = rand(i, 11) < 0.55 ? 0 : rand(i, 12) < 0.7 ? 1 : 2
            const tone = rand(i, 13)
            return {
                x: rand(i, 14),
                y: rand(i, 15),
                depth,
                cross: depth === 2 && rand(i, 16) < 0.35,
                colour:
                    tone < 0.6
                        ? "255, 255, 255"
                        : tone < 0.82
                          ? "196, 184, 255"
                          : tone < 0.93
                            ? "120, 140, 255"
                            : "255, 90, 220",
                pace: 0.6 + rand(i, 17) * 0.8,
                phase: rand(i, 18) * 6.28,
            }
        })
        const SPARKS = [
            { lane: -4.5, pace: 0.6, offset: 0 },
            { lane: 4, pace: 0.5, offset: 0.45 },
        ]

        const layout = () => {
            const box = canvas.getBoundingClientRect()
            const ratio = Math.min(2, window.devicePixelRatio || 1)
            width = box.width
            height = box.height
            canvas.width = Math.round(width * ratio)
            canvas.height = Math.round(height * ratio)
            ctx.setTransform(ratio, 0, 0, ratio, 0, 0)

            wide = width >= 992
            unit = wide
                ? Math.max(10, Math.min(19, width / 100))
                : Math.max(6, width / 60)
            at = wide
                ? { x: width * 0.81, y: Math.max(unit * 13, height * 0.28) }
                : { x: width * 0.55, y: unit * 13 }
            reach = wide ? Math.min(width * 0.45, 820) : width * 0.8

            cells = []
            SPRITE.forEach((line, row) => {
                ;[...line].forEach((key, col) => {
                    if (HULL[key])
                        cells.push({
                            u: col - HEART.x,
                            v: row - HEART.y,
                            ink: key,
                        })
                })
            })

            plumes = {}
        }

        const plumeFor = (mode: Mode) => {
            if (plumes[mode]) return plumes[mode]
            const w = unit * 20
            const pad = unit * 6
            const sheet = document.createElement("canvas")
            sheet.width = Math.round(w + pad * 2)
            sheet.height = Math.round(reach + pad * 2)
            const pctx = sheet.getContext("2d")
            if (!pctx) return
            const W = sheet.width
            const H = sheet.height
            const g = pctx.createLinearGradient(0, pad, 0, pad + reach)
            for (const [stop, colour] of PLUMES[mode])
                g.addColorStop(stop, colour)
            pctx.fillStyle = g
            pctx.fillRect(0, 0, W, H)
            pctx.globalCompositeOperation = "destination-in"
            const sides = pctx.createLinearGradient(0, 0, W, 0)
            sides.addColorStop(0, "rgba(0, 0, 0, 0)")
            sides.addColorStop(0.22, "rgba(0, 0, 0, 0.55)")
            sides.addColorStop(0.5, "rgba(0, 0, 0, 1)")
            sides.addColorStop(0.78, "rgba(0, 0, 0, 0.55)")
            sides.addColorStop(1, "rgba(0, 0, 0, 0)")
            pctx.fillStyle = sides
            pctx.fillRect(0, 0, W, H)
            const head = pctx.createLinearGradient(0, 0, 0, pad + w * 0.6)
            head.addColorStop(0, "rgba(0, 0, 0, 0)")
            head.addColorStop(1, "rgba(0, 0, 0, 1)")
            pctx.fillStyle = head
            pctx.fillRect(0, 0, W, H)
            plumes[mode] = sheet
            return sheet
        }

        const frame = (time: number) => {
            const t = time / 1000
            const dt = Math.min(0.1, Math.max(0, t - clock))
            clock = t
            const ease = still ? 1 : Math.min(1, dt * 5)
            mix.cloud = blend(mix.cloud, goal.cloud, ease)
            mix.power = blend(mix.power, goal.power, ease)
            const { cloud, power } = mix
            flow += dt * unit * 30 * (1 + power * 0.9)
            dash += dt * (1.4 + power * 1.4)
            spin += dt * (1 + power * 0.8)
            ctx.clearRect(0, 0, width, height)

            const halo = cloud * 0.2 + power * 0.24
            if (halo > 0.004) {
                const radius = unit * (34 + power * 10)
                const g = ctx.createRadialGradient(
                    at.x,
                    at.y,
                    0,
                    at.x,
                    at.y,
                    radius,
                )
                const glow = tint([60, 140, 255], [150, 110, 255], power)
                g.addColorStop(0, `rgba(${glow}, ${halo})`)
                g.addColorStop(1, `rgba(${glow}, 0)`)
                ctx.fillStyle = g
                ctx.fillRect(
                    at.x - radius,
                    at.y - radius,
                    radius * 2,
                    radius * 2,
                )
            }

            const dot = Math.max(2, Math.round(unit / STEPS))
            for (const star of STARS) {
                const speed = [5, 14, 34][star.depth] * star.pace
                const x =
                    (((star.x * width - FWD.x * speed * t) % width) + width) %
                    width
                const y =
                    (((star.y * height - FWD.y * speed * t) % height) +
                        height) %
                    height
                const twinkle =
                    0.55 + 0.45 * Math.sin(t * 1.6 * star.pace + star.phase)
                const alpha = [0.22, 0.4, 0.7][star.depth] * twinkle
                const size = [0.5, 0.75, 1][star.depth] * dot
                const sx = Math.round(x)
                const sy = Math.round(y)
                ctx.fillStyle = `rgba(${star.colour}, ${alpha})`
                ctx.fillRect(sx, sy, size, size)
                if (star.cross) {
                    ctx.fillStyle = `rgba(${star.colour}, ${alpha * 0.5})`
                    ctx.fillRect(sx - size, sy, size, size)
                    ctx.fillRect(sx + size, sy, size, size)
                    ctx.fillRect(sx, sy - size, size, size)
                    ctx.fillRect(sx, sy + size, size, size)
                }
            }

            if (cloud > 0.01) {
                for (const puff of CLOUDS) {
                    const cell = dot * puff.size
                    const w = puff.shape[0].length * cell
                    const h = puff.shape.length * cell
                    const speed = 70 * puff.pace
                    const x =
                        ((((puff.x * (width + w) - FWD.x * speed * t) %
                            (width + w)) +
                            (width + w)) %
                            (width + w)) -
                        w
                    const y =
                        ((((puff.y * (height + h) - FWD.y * speed * t) %
                            (height + h)) +
                            (height + h)) %
                            (height + h)) -
                        h
                    puff.shape.forEach((line, row) => {
                        const shade =
                            row === puff.shape.length - 1
                                ? "120, 170, 255"
                                : "196, 222, 255"
                        ctx.fillStyle = `rgba(${shade}, ${puff.alpha * cloud})`
                        ;[...line].forEach((key, col) => {
                            if (key === "X")
                                ctx.fillRect(
                                    Math.round(x + col * cell),
                                    Math.round(y + row * cell),
                                    Math.ceil(cell),
                                    Math.ceil(cell),
                                )
                        })
                    })
                }
            }

            const beat = 0.85 + 0.15 * Math.sin(t * (8 + power * 8))
            const shares: Record<Mode, number> = {
                core: (1 - cloud) * (1 - power),
                cloud,
                power,
            }
            for (const mode of Object.keys(shares) as Mode[]) {
                if (shares[mode] < 0.01) continue
                const sheet = plumeFor(mode)
                if (!sheet) continue
                ctx.save()
                ctx.translate(at.x, at.y)
                ctx.rotate(HEADING + Math.PI / 2)
                ctx.scale(1 + power * 0.4, 1 + power * 0.3)
                ctx.globalAlpha = beat * shares[mode]
                ctx.drawImage(sheet, -sheet.width / 2, -unit * 6)
                ctx.restore()
            }

            ctx.save()
            ctx.translate(at.x, at.y)
            ctx.rotate(HEADING)

            const fine = unit / STEPS
            const dust = tint([255, 235, 250], [200, 230, 255], cloud)
            for (let row = 4; row * fine < reach * 0.8; row += 1) {
                const fade = 1 - (row * fine) / (reach * 0.8)
                const slot = Math.floor((row * fine + flow) / fine)
                for (let lane = -24; lane <= 24; lane += 2) {
                    const spread = Math.exp(-((lane / 14) ** 2))
                    const n = rand(lane + 80, slot - row * 2)
                    if (n > spread * fade * (0.06 + power * 0.1)) continue
                    ctx.fillStyle = `rgba(${dust}, ${0.2 + 0.35 * fade})`
                    ctx.fillRect(
                        -row * fine - unit * 4,
                        lane * fine,
                        fine * 0.7,
                        fine * 0.7,
                    )
                }
            }

            ctx.lineCap = "round"
            for (const line of LINES) {
                const shown = line.boost ? power : 1
                if (shown < 0.01) continue
                const k = (line.offset + dash * line.pace) % 1
                const x = -unit * 5 - k * reach * 0.6
                const y = line.lane * unit * 12
                const length = unit * 4 * line.length * (1 + power * 0.7)
                const fade = Math.sin(k * Math.PI) * shown
                const g = ctx.createLinearGradient(x, y, x - length, y)
                g.addColorStop(0, `rgba(255, 255, 255, ${0.9 * fade})`)
                g.addColorStop(1, "rgba(255, 255, 255, 0)")
                ctx.strokeStyle = g
                ctx.lineWidth = Math.max(1.5, unit * 0.18)
                ctx.beginPath()
                ctx.moveTo(x, y)
                ctx.lineTo(x - length, y)
                ctx.stroke()
            }

            const ember = tint([255, 4, 254], [150, 220, 255], cloud)
            const trail = tint([92, 84, 255], [70, 150, 255], cloud)
            for (const spark of SPARKS) {
                const k = (spark.offset + spin * spark.pace) % 1
                const fade = Math.sin(k * Math.PI)
                for (let i = 0; i < 3; i++) {
                    const x = -unit * 6 - k * reach * 0.35 - i * unit * 2.2
                    const w = unit * (1.6 - i * 0.35)
                    const h = unit * (0.9 - i * 0.12)
                    ctx.fillStyle =
                        i === 0
                            ? `rgba(${ember}, ${fade})`
                            : `rgba(${trail}, ${fade * (1 - i * 0.2)})`
                    ctx.fillRect(x - w, spark.lane * unit - h / 2, w, h)
                }
            }

            if (power > 0.01) {
                for (let ring = 0; ring < 4; ring++) {
                    const pulse = 0.7 + 0.3 * Math.sin(t * 14 + ring * 1.7)
                    const tall = unit * (5.4 - ring * 1.15)
                    ctx.fillStyle = `rgba(226, 220, 255, ${power * (0.6 - ring * 0.14) * pulse})`
                    ctx.fillRect(
                        -unit * (7.5 + ring * 3.1),
                        -tall / 2,
                        fine * 1.3,
                        tall,
                    )
                }
            }

            const shake = still ? 0 : 0.9 + power * 0.9
            ctx.translate(
                (rand(t * 60, 1) - 0.5) * shake * 2,
                (rand(t * 60, 2) - 0.5) * shake * 2,
            )
            ctx.scale(1 + power * 0.16, 1 + power * 0.16)
            const gap = fine > 4 ? 0.6 : 0
            const ink: Record<string, string> = {}
            for (const key of Object.keys(HULL))
                ink[key] = `rgb(${tint(HULL[key], FLAGSHIP[key], power)})`
            for (const cell of cells) {
                ctx.fillStyle = ink[cell.ink]
                ctx.fillRect(
                    cell.u * fine,
                    cell.v * fine,
                    fine - gap,
                    fine - gap,
                )
            }
            ctx.restore()
        }

        const editions = canvas.parentElement?.querySelector<HTMLElement>(
            "[data-rocket-steer]",
        )
        let hovered: string | undefined
        let focused: string | undefined
        const editionOf = (target: EventTarget | null) =>
            (target as Element | null)?.closest<HTMLElement>("[data-edition]")
                ?.dataset.edition
        const aim = () => {
            const edition = wide ? (hovered ?? focused) : undefined
            goal.cloud = edition === "cloud" ? 1 : 0
            goal.power = edition === "enterprise" ? 1 : 0
            if (still) frame(0)
        }

        layout()
        new ResizeObserver(() => {
            layout()
            aim()
        }).observe(canvas)

        if (editions) {
            if (matchMedia("(hover: hover)").matches) {
                editions.addEventListener("pointerover", (event) => {
                    hovered = editionOf(event.target)
                    aim()
                })
                editions.addEventListener("pointerleave", () => {
                    hovered = undefined
                    aim()
                })
            }
            editions.addEventListener("focusin", (event) => {
                focused = editionOf(event.target)
                aim()
            })
            editions.addEventListener("focusout", (event) => {
                if (editions.contains(event.relatedTarget as Node | null))
                    return
                focused = undefined
                aim()
            })
        }
        if (still) {
            frame(0)
            return
        }

        let visible = false
        let raf = 0
        let last = 0
        const tick = (time: number) => {
            raf = 0
            if (!visible) return
            if (time - last > 40) {
                last = time
                frame(time)
            }
            raf = requestAnimationFrame(tick)
        }
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting
            if (visible && !raf) raf = requestAnimationFrame(tick)
        }).observe(canvas)
    }

    document.addEventListener("astro:page-load", flyRocket)
    flyRocket()
</script>

<style lang="scss">
    .sky {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
</style>
