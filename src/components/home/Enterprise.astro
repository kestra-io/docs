---
import { Icon } from "astro-icon/components"

// Four reasons, each over a glimpse of the product that proves it.
const FEATURES = [
    {
        id: "access",
        title: "Give every team secure access.",
        text: "Share one platform with isolated workflows, credentials, and execution environments.",
    },
    {
        id: "reliability",
        title: "Keep critical workflows running reliably.",
        text: "Support business continuity with worker groups, backup and restore, maintenance mode, and SLA-backed support.",
    },
    {
        id: "governance",
        title: "Verifiable governance",
        text: "Keep track of who ran each workflow, with which permissions, and approval chains with SSO, RBAC, audit logs, policies, and approval gates.",
    },
    {
        id: "scale",
        title: "Built for your scale and your network.",
        text: "Pick the backend that fits your load and scale. Make sure that only trusted workers can connect, wherever they run.",
    },
]

const NAMESPACES = ["data.*", "finance.*", "ops.*"]
const AUDIT = [
    { time: "09:14", who: "j.kim", action: "ran", what: "close_books" },
    { time: "09:31", who: "m.chen", action: "approved" },
    { time: "09:32", who: "agent", blocked: true },
]
---

{
    /* Kestra Enterprise, on black after the AI block, on the page's hairline
    grid: the head with its two ways on, then four cells, each a glimpse of
    the product over its promise. */
}
<section
    class="enterprise surface-dark"
    aria-labelledby="enterprise"
    data-header-dark
>
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <div>
                    <h2 id="enterprise">
                        <span>Achieve more with</span> Kestra Enterprise.
                    </h2>
                    <p>
                        Kestra Enterprise gives you the security, governance and
                        SLA-backed support to run orchestration across your
                        whole organization. Run it self-hosted, in your cloud or
                        air-gapped.
                    </p>
                </div>
                <div class="actions">
                    <a href="/enterprise" class="btn-solid">
                        Explore Enterprise
                    </a>
                    <a href="/demo" class="btn-ghost">Book a demo</a>
                </div>
            </header>

            <ul class="features">
                {
                    FEATURES.map((feature) => (
                        <li>
                            <div class="mock" aria-hidden="true">
                                {feature.id === "access" && (
                                    <div class="tree">
                                        <p class="root">
                                            <span class="dot" /> company
                                            <span class="slash">/</span>
                                        </p>
                                        {NAMESPACES.map((namespace) => (
                                            <p class="leaf">
                                                <span class="dot" />
                                                {namespace}
                                                <Icon name="mdi:lock-outline" />
                                            </p>
                                        ))}
                                    </div>
                                )}
                                {feature.id === "reliability" && (
                                    <div class="workers">
                                        <p>
                                            <span class="tag failed">
                                                Failed
                                            </span>
                                            worker-eu-1
                                        </p>
                                        <p>
                                            <span class="tag running">
                                                Running
                                            </span>
                                            worker-eu-2
                                        </p>
                                        <p class="note">P0 response · 1h</p>
                                    </div>
                                )}
                                {feature.id === "governance" && (
                                    <div class="audit">
                                        {AUDIT.map((line) => (
                                            <p>
                                                <span class="time">
                                                    {line.time}
                                                </span>
                                                <strong>{line.who}</strong>
                                                {line.blocked ? (
                                                    <span class="tag failed">
                                                        Blocked
                                                    </span>
                                                ) : (
                                                    <>
                                                        <span class="verb">
                                                            {line.action}
                                                        </span>
                                                        {line.what && (
                                                            <strong>
                                                                {line.what}
                                                            </strong>
                                                        )}
                                                    </>
                                                )}
                                            </p>
                                        ))}
                                    </div>
                                )}
                                {feature.id === "scale" && (
                                    <div class="backend">
                                        <p class="label">Queue backend</p>
                                        <p class="select">
                                            Kafka
                                            <Icon name="mdi:chevron-down" />
                                        </p>
                                        <p class="note">
                                            <span class="dot ok" /> mTLS · 12
                                            workers verified
                                        </p>
                                    </div>
                                )}
                            </div>
                            <h3>{feature.title}</h3>
                            <p class="text">{feature.text}</p>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    // A lifted black, a shade apart from the AI block above, so the two
    // read as one dark run with a step between them. It stays dark in both
    // themes.
    .enterprise {
        --bg: #141418;
        --rule-color: rgba(255, 255, 255, 0.08);
        --rule: 1px solid var(--rule-color);
        --card: #1b1b20;
        --card-border: rgba(255, 255, 255, 0.08);
        --text: #ffffff;
        --muted: #9a9aa8;
        --faint: #5c5c68;

        position: relative;
        background: var(--bg);
        color: var(--text);
        // A rule across the page, between the AI block and this one.
        border-top: var(--rule);
    }

    // The hairline grid, in white on black: rails on both sides, on the AI
    // block's lines, and full-width rules around the four cells.
    .grid {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);
    }

    // The title and copy on the left, the two ways on the right.
    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem 3rem;
        padding: 8.5rem var(--inset) 4rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--text);

            // The lead-in in grey, so Kestra Enterprise stands out, as in
            // the AI block's title.
            span {
                color: #a9a9b8;
            }
        }

        p {
            max-width: 44rem;
            margin: 1.25rem 0 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.6);
            text-wrap: pretty;
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    // Four cells between full-width rules.
    .features {
        position: relative;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
        border-block: var(--rule);

        &::before,
        &::after {
            content: "";
            position: absolute;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--rule-color);
            pointer-events: none;
        }

        &::before {
            top: -1px;
        }

        &::after {
            bottom: -1px;
        }

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
        }

        > li {
            display: flex;
            flex-direction: column;
            // More room under the copy: the cells are the block's foot.
            padding: 2rem clamp(1.25rem, 2vw, 2rem) clamp(5rem, 9vw, 7.5rem);
            transition: background-color 0.3s ease;

            & + li {
                border-left: var(--rule);
            }

            &:hover {
                background: rgba(255, 255, 255, 0.02);
            }

            // On two columns, the third cell starts a row: a rule above
            // the second row, none on its left edge.
            @include media-breakpoint-between(md, lg) {
                &:nth-child(3) {
                    border-left: 0;
                }

                &:nth-child(n + 3) {
                    border-top: var(--rule);
                }
            }

            @include media-breakpoint-down(md) {
                & + li {
                    border-left: 0;
                    border-top: var(--rule);
                }
            }
        }

        h3 {
            margin: 1.75rem 0 0.5rem;
            font-size: 1.25rem;
            font-weight: 600;
            line-height: 1.3;
            color: var(--text);
            text-wrap: balance;
        }

        .text {
            margin: 0;
            font-size: 0.9375rem;
            line-height: 1.6;
            color: var(--muted);
        }
    }

    // A glimpse of the product: a dark card, grey and white, colour only
    // in a state's tag.
    .mock {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 11rem;
        padding: 1.25rem;
        border: 1px solid var(--card-border);
        border-radius: 0.75rem;
        background: var(--card);
        font-size: 0.875rem;
        color: #d6d6de;

        p {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
        }

        :global(svg) {
            width: 0.9375rem;
            height: 0.9375rem;
            color: var(--faint);
        }

        .dot {
            width: 0.4375rem;
            height: 0.4375rem;
            border-radius: 50%;
            background: var(--faint);

            &.ok {
                background: #ffffff;
            }
        }

        .note {
            font-size: 0.8125rem;
            color: var(--muted);
        }
    }

    // The namespaces, each locked to its team.
    .tree {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;

        .root {
            margin-bottom: 0.25rem;
            color: #ffffff;

            .dot {
                background: #ffffff;
            }
        }

        .slash {
            color: var(--faint);
        }

        .leaf {
            justify-content: flex-start;
            margin-left: 0.75rem;
            padding: 0.4375rem 0.625rem;
            border-radius: 0.375rem;
            background: rgba(255, 255, 255, 0.04);

            :global(svg) {
                margin-left: auto;
            }
        }
    }

    // A worker fails, the next one carries on.
    .workers,
    .audit,
    .backend {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
    }

    .tag {
        padding: 0.125rem 0.4375rem;
        border-radius: 0.25rem;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;

        &.failed {
            background: rgba(255, 92, 122, 0.14);
            color: #ff8197;
        }

        &.running {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
        }
    }

    // Who ran what, and the one the policy turned back.
    .audit {
        .time {
            color: var(--faint);
            font-variant-numeric: tabular-nums;
        }

        strong {
            font-weight: 500;
            color: #ffffff;
        }

        .verb {
            color: var(--muted);
        }
    }

    // The queue backend picked in settings.
    .backend {
        gap: 0.625rem;

        .label {
            font-size: 0.8125rem;
            color: var(--muted);
        }

        .select {
            justify-content: space-between;
            padding: 0.5625rem 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 0.375rem;
            font-weight: 500;
            color: #ffffff;
        }
    }
</style>
