---
import { Icon } from "astro-icon/components"
import { API_URL } from "astro:env/client"
import kestraMark from "./assets/ai/kestra-logo-mark-on-dark.svg"

// Four reasons, each under a glimpse of the product that proves it.
const FEATURES = [
    {
        id: "access",
        title: "Give every team secure access.",
        text: "Share one platform with isolated workflows, credentials, and execution environments.",
    },
    {
        id: "reliability",
        title: "Keep critical workflows running reliably.",
        text: "Support business continuity with worker groups, backup and restore, maintenance mode, and SLA-backed support.",
    },
    {
        id: "governance",
        title: "Verifiable governance",
        text: "Keep track of who ran each workflow, with which permissions, and approval chains with SSO, RBAC, audit logs, policies, and approval gates.",
    },
    {
        id: "scale",
        title: "Built for your scale and your network.",
        text: "Pick the backend that fits your load and scale. Make sure that only trusted workers can connect, wherever they run.",
    },
]

// The page each windowed glimpse would sit on in Kestra; the others are
// drawn free, without a window, so the four do not all look alike.
const PAGES: Record<string, string> = {
    reliability: "Worker groups",
}

// The Infrastructure tenant, open on its namespaces and a flow.
const ROOT = "acme"
const NAMESPACES = [
    "acme.cloud",
    "acme.kubernetes",
    "acme.network",
    "acme.monitoring",
]
const FLOW = { parent: "acme.kubernetes", id: "scale_cluster" }
// The namespace the admin removes in the story.
const DELETED = "acme.network"
// Three roles: one edits the flow, one runs it, one deletes a namespace.
const PEOPLE = [
    { id: "launcher", name: "Launcher", icon: "mdi:play-circle-outline" },
    { id: "editor", name: "Editor", icon: "mdi:pencil" },
    { id: "admin", name: "Admin", icon: "mdi:shield-account-outline" },
]

// The queues the worker group serves, with the slots in use.
const QUEUES = [
    { name: "ml-training", mode: "Elastic 25%", used: 8, slots: 10 },
    { name: "Default", mode: "Shared", used: 4, slots: 24 },
]

// The audit log as the product lists it: what changed, how, by whom,
// one detail of it, and when. The first five show; the script streams the
// others in on top, newest first.
const AUDIT = [
    {
        type: "Execution",
        action: "Resumed",
        actor: "m.chen",
        detail: "approval:deploy_prod",
        age: 40,
    },
    {
        type: "Execution",
        action: "Created",
        actor: "s.roy",
        detail: "flowId:deploy_prod",
        age: 260,
    },
    {
        type: "Flow",
        action: "Updated",
        actor: "j.kim",
        detail: "revision:7",
        age: 900,
    },
    {
        type: "Role",
        action: "Created",
        actor: "admin",
        detail: "id:finance_viewer",
        age: 3600,
    },
    {
        type: "User",
        action: "Login",
        actor: "j.kim",
        detail: "resource:USER",
        age: 7400,
    },
    {
        type: "Secret",
        action: "Updated",
        actor: "m.chen",
        detail: "key:DB_PASSWORD",
        age: 0,
    },
    {
        type: "Namespace",
        action: "Updated",
        actor: "admin",
        detail: "id:acme.finance",
        age: 0,
    },
    {
        type: "Flow",
        action: "Created",
        actor: "agent-01",
        detail: "id:sync_crm",
        age: 0,
    },
    {
        type: "Binding",
        action: "Created",
        actor: "admin",
        detail: "role:editor",
        age: 0,
    },
]
const ago = (seconds: number) =>
    seconds < 60
        ? "just now"
        : seconds < 3600
          ? `${Math.round(seconds / 60)} min ago`
          : `${Math.round(seconds / 3600)} hours ago`

// The backends to pick from, each with its plugin's icon, fetched at
// build. JDBC alone is open source; Enterprise adds the rest. The script
// switches between a few setups.
const BACKENDS = {
    repository: [
        { id: "jdbc", name: "JDBC" },
        { id: "elasticsearch", name: "Elasticsearch", plugin: "elasticsearch" },
    ],
    queue: [
        { id: "jdbc", name: "JDBC" },
        { id: "redis", name: "Redis", plugin: "redis" },
        { id: "rabbitmq", name: "RabbitMQ", plugin: "amqp" },
        { id: "kafka", name: "Kafka", plugin: "kafka" },
    ],
}
const SETUPS = [
    ["elasticsearch", "kafka"],
    ["jdbc", "redis"],
    ["elasticsearch", "rabbitmq"],
    ["jdbc", "jdbc"],
]
const icons = Object.fromEntries(
    await Promise.all(
        [...BACKENDS.repository, ...BACKENDS.queue]
            .filter((backend) => backend.plugin)
            .map(async (backend) => {
                try {
                    const response = await fetch(
                        `${API_URL}/plugins/icons/io.kestra.plugin.${backend.plugin}`,
                    )
                    if (!response.ok) return [backend.id, null]
                    const svg = Buffer.from(await response.arrayBuffer())
                    return [
                        backend.id,
                        `data:image/svg+xml;base64,${svg.toString("base64")}`,
                    ]
                } catch {
                    return [backend.id, null]
                }
            }),
    ),
) as Record<string, string | null>

// As on the 2.0 page: workers prove who they are before they join.
const WORKERS = [
    { name: "onprem-01", ok: true },
    { name: "euwest-02", ok: true },
    { name: "unknown", ok: false },
]
---

{
    /* Kestra Enterprise, on black after the AI block, on the page's hairline
    grid: the head with its two ways on, then four cells, each a glimpse of
    the product, drawn in lines and fading out, over its promise. */
}
<section
    class="enterprise surface-dark"
    aria-labelledby="enterprise"
    data-header-dark
>
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <div>
                    <h2 id="enterprise">
                        <span>Achieve more with</span>{" "}
                        <em>Kestra Enterprise.</em>
                    </h2>
                    <p>
                        Kestra Enterprise gives you the security, governance and
                        SLA-backed support to run orchestration across your
                        whole organization. Run it self-hosted, in your cloud or
                        air-gapped.
                    </p>
                </div>
                <div class="actions">
                    <a href="/enterprise" class="btn-solid">
                        Explore Enterprise
                    </a>
                    <a href="/demo" class="btn-ghost">Book a demo</a>
                </div>
            </header>

            <ul class="features">
                {
                    FEATURES.map((feature) => (
                        <li>
                            <div class="stage" aria-hidden="true">
                                <div
                                    class:list={[
                                        "glimpse",
                                        { free: !PAGES[feature.id] },
                                    ]}
                                    data-card={feature.id}
                                >
                                    {PAGES[feature.id] && (
                                        <p class="glimpse-head">
                                            {PAGES[feature.id]}
                                            {feature.id === "access" && (
                                                <span class="pill">
                                                    <span class="dot" />
                                                    Infrastructure
                                                </span>
                                            )}
                                        </p>
                                    )}
                                    {feature.id === "access" && (
                                        <div
                                            class="glimpse-body tenant"
                                            data-tenants
                                        >
                                            <p class="tenant-label">
                                                <Icon name="mdi:server-network" />
                                                Tenant
                                                <span class="pill">
                                                    <span class="dot" />
                                                    Infrastructure
                                                </span>
                                            </p>
                                            <ul class="ns-tree">
                                                <li>
                                                    <span data-row={ROOT}>
                                                        <Icon
                                                            name="mdi:folder-open-outline"
                                                            class="folder"
                                                        />
                                                        {ROOT}
                                                    </span>
                                                    <ul>
                                                        {NAMESPACES.map(
                                                            (namespace) => (
                                                                <li
                                                                    class:list={{
                                                                        doomed:
                                                                            namespace ===
                                                                            DELETED,
                                                                    }}
                                                                >
                                                                    <span
                                                                        data-row={
                                                                            namespace
                                                                        }
                                                                    >
                                                                        <Icon
                                                                            name="mdi:folder-open-outline"
                                                                            class="folder"
                                                                        />
                                                                        {
                                                                            namespace
                                                                        }
                                                                        {namespace ===
                                                                            DELETED && (
                                                                            <span
                                                                                class="row-state"
                                                                                data-row-state
                                                                            >
                                                                                <span class="pill bad deleted">
                                                                                    <Icon name="mdi:delete-outline" />
                                                                                    Deleted
                                                                                </span>
                                                                            </span>
                                                                        )}
                                                                    </span>
                                                                    {namespace ===
                                                                        FLOW.parent && (
                                                                        <ul>
                                                                            <li>
                                                                                <span data-row="flow">
                                                                                    <Icon name="mdi:file-tree-outline" />
                                                                                    {
                                                                                        FLOW.id
                                                                                    }
                                                                                    <span
                                                                                        class="row-state"
                                                                                        data-row-state
                                                                                    >
                                                                                        <span class="pill editing">
                                                                                            <Icon name="mdi:pencil" />
                                                                                            Editing
                                                                                        </span>
                                                                                        <span class="pill run running">
                                                                                            <Icon
                                                                                                name="mdi:loading"
                                                                                                class="spin"
                                                                                            />
                                                                                            Running
                                                                                        </span>
                                                                                        <span class="pill ok success">
                                                                                            <Icon name="mdi:check-circle-outline" />
                                                                                            Success
                                                                                        </span>
                                                                                    </span>
                                                                                </span>
                                                                            </li>
                                                                        </ul>
                                                                    )}
                                                                </li>
                                                            ),
                                                        )}
                                                    </ul>
                                                </li>
                                            </ul>
                                            {PEOPLE.map((person) => (
                                                <span
                                                    class:list={[
                                                        "cursor",
                                                        person.id,
                                                    ]}
                                                    data-person={person.id}
                                                >
                                                    <svg viewBox="0 0 10 10">
                                                        <path d="M0 0 L10 4 L5.5 5.5 L4 10 Z" />
                                                    </svg>
                                                    <span class="who">
                                                        <Icon
                                                            name={person.icon}
                                                        />
                                                        {person.name}
                                                    </span>
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                    {feature.id === "reliability" && (
                                        <div
                                            class="glimpse-body routing"
                                            data-routing
                                        >
                                            <p class="group">
                                                <strong>gpu-a100</strong>
                                                <span class="tag">
                                                    Reserved
                                                </span>
                                                <span class="pill ok">
                                                    <span class="dot" />
                                                    Online
                                                </span>
                                            </p>
                                            <p class="stats">
                                                <span>
                                                    <b>8</b> workers online
                                                </span>
                                                <span>
                                                    <b data-tps>0.8</b> tasks/s
                                                </span>
                                            </p>
                                            {QUEUES.map((queue) => (
                                                <div
                                                    class="queue"
                                                    data-queue
                                                    data-slots={queue.slots}
                                                >
                                                    <p>
                                                        {queue.name}
                                                        <span class="tag">
                                                            {queue.mode}
                                                        </span>
                                                        <span class="ratio">
                                                            <span data-used>
                                                                {queue.used}
                                                            </span>
                                                            {` / ${queue.slots}`}
                                                        </span>
                                                    </p>
                                                    <span
                                                        class="meter"
                                                        style={`--fill: ${queue.used / queue.slots}`}
                                                    />
                                                </div>
                                            ))}
                                            <dl class="facts">
                                                <dt>Backup</dt>
                                                <dd data-backup>
                                                    <Icon
                                                        name="mdi:check-circle-outline"
                                                        class="done"
                                                    />
                                                    <Icon
                                                        name="mdi:loading"
                                                        class="spin"
                                                    />
                                                    <span data-backup-text>
                                                        Last successful 3m ago
                                                    </span>
                                                </dd>
                                                <dt>Maintenance mode</dt>
                                                <dd>
                                                    <span class="switch" />
                                                    Off
                                                </dd>
                                                <dt>SLA target</dt>
                                                <dd>99.99%</dd>
                                            </dl>
                                        </div>
                                    )}
                                    {feature.id === "governance" && (
                                        <div
                                            class="glimpse-body notes"
                                            data-audit
                                        >
                                            <div class="stack" data-stack>
                                                {AUDIT.slice(0, 3).map(
                                                    (line) => (
                                                        <div
                                                            class="note"
                                                            data-age={line.age}
                                                        >
                                                            <p class="note-top">
                                                                <span class="pill">
                                                                    {line.type}
                                                                </span>
                                                                <span
                                                                    class:list={[
                                                                        "state",
                                                                        line.action.toLowerCase(),
                                                                    ]}
                                                                >
                                                                    {
                                                                        line.action
                                                                    }
                                                                </span>
                                                                <span class="date">
                                                                    {ago(
                                                                        line.age,
                                                                    )}
                                                                </span>
                                                            </p>
                                                            <p class="note-main">
                                                                <strong>
                                                                    {line.actor}
                                                                </strong>
                                                                <span class="tag">
                                                                    {
                                                                        line.detail
                                                                    }
                                                                </span>
                                                            </p>
                                                        </div>
                                                    ),
                                                )}
                                            </div>
                                            <template data-pool>
                                                {AUDIT.slice(3).map((line) => (
                                                    <div
                                                        class="note"
                                                        data-age={line.age}
                                                    >
                                                        <p class="note-top">
                                                            <span class="pill">
                                                                {line.type}
                                                            </span>
                                                            <span
                                                                class:list={[
                                                                    "state",
                                                                    line.action.toLowerCase(),
                                                                ]}
                                                            >
                                                                {line.action}
                                                            </span>
                                                            <span class="date">
                                                                {ago(line.age)}
                                                            </span>
                                                        </p>
                                                        <p class="note-main">
                                                            <strong>
                                                                {line.actor}
                                                            </strong>
                                                            <span class="tag">
                                                                {line.detail}
                                                            </span>
                                                        </p>
                                                    </div>
                                                ))}
                                            </template>
                                            <p class="stream">
                                                <span class="live" />
                                                Streaming to Splunk & Syslog
                                                over TLS
                                                <span class="count">
                                                    <span data-exported>
                                                        1,284
                                                    </span>{" "}
                                                    events
                                                </span>
                                            </p>
                                        </div>
                                    )}
                                    {feature.id === "scale" && (
                                        <div
                                            class="glimpse-body schema-body"
                                            data-backends
                                            data-setups={JSON.stringify(SETUPS)}
                                        >
                                            <div
                                                class="schema blocked"
                                                data-intruder
                                            >
                                                <svg
                                                    class="lines"
                                                    viewBox="0 0 560 340"
                                                    aria-hidden="true"
                                                >
                                                    <path
                                                        class="wire"
                                                        d="M140 100 C196 100 196 170 252 170"
                                                    />
                                                    <path
                                                        class="wire"
                                                        d="M140 170 H252"
                                                    />
                                                    {/* The unknown worker sends its run like the
                                                    others; it is stopped on the way, a cross
                                                    appears and its link turns red. */}
                                                    <path
                                                        class="wire intruder"
                                                        d="M140 240 C196 240 196 170 252 170"
                                                    />
                                                    <path
                                                        class="jet"
                                                        d="M140 240 C196 240 196 170 252 170"
                                                        data-jet
                                                    />
                                                    <path
                                                        class="cut"
                                                        d="M192.5 201.5 l7 7 M199.5 201.5 l-7 7"
                                                    />
                                                    <path
                                                        class="wire"
                                                        d="M308 170 C354 170 354 112 400 112"
                                                    />
                                                    <path
                                                        class="wire"
                                                        d="M308 170 C354 170 354 228 400 228"
                                                    />
                                                    <g class="flows">
                                                        <path d="M140 100 C196 100 196 170 252 170 H308 C354 170 354 112 400 112" />
                                                        <path d="M140 170 H308 C354 170 354 228 400 228" />
                                                    </g>
                                                </svg>
                                                <p
                                                    class="workers"
                                                    data-handshake
                                                >
                                                    {WORKERS.map(
                                                        (worker, idx) => (
                                                            <span
                                                                class:list={[
                                                                    "worker",
                                                                    worker.ok
                                                                        ? "ok"
                                                                        : "refused",
                                                                ]}
                                                                data-worker={
                                                                    worker.ok
                                                                        ? "ok"
                                                                        : "refused"
                                                                }
                                                                style={`top: ${100 + idx * 70}px`}
                                                            >
                                                                <span class="state" />
                                                                {worker.name}
                                                            </span>
                                                        ),
                                                    )}
                                                </p>
                                                <span class="hub">
                                                    <img
                                                        src={kestraMark.src}
                                                        alt=""
                                                        width="28"
                                                        height="28"
                                                    />
                                                </span>
                                                <span class="hub-label">
                                                    Kestra
                                                </span>
                                                {(
                                                    [
                                                        "repository",
                                                        "queue",
                                                    ] as const
                                                ).map((kind, col) => (
                                                    <div
                                                        class:list={[
                                                            "lane",
                                                            kind,
                                                        ]}
                                                        data-column={kind}
                                                    >
                                                        <div class="bar">
                                                            <p class="lane-title">
                                                                {kind ===
                                                                "repository"
                                                                    ? "Repository"
                                                                    : "Queue"}
                                                            </p>
                                                            {BACKENDS[kind].map(
                                                                (backend) => (
                                                                    <span
                                                                        class:list={[
                                                                            "choice",
                                                                            {
                                                                                on:
                                                                                    backend.id ===
                                                                                    SETUPS[0][
                                                                                        col
                                                                                    ],
                                                                            },
                                                                        ]}
                                                                        data-option={
                                                                            backend.id
                                                                        }
                                                                    >
                                                                        <span class="logo">
                                                                            {icons[
                                                                                backend
                                                                                    .id
                                                                            ] ? (
                                                                                <img
                                                                                    src={
                                                                                        icons[
                                                                                            backend
                                                                                                .id
                                                                                        ]
                                                                                    }
                                                                                    alt=""
                                                                                />
                                                                            ) : (
                                                                                <Icon
                                                                                    name="mdi:language-java"
                                                                                    class="java"
                                                                                />
                                                                            )}
                                                                        </span>
                                                                        {
                                                                            backend.name
                                                                        }
                                                                    </span>
                                                                ),
                                                            )}
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </div>
                            <div class="copy">
                                <h3>{feature.title}</h3>
                                <p class="text">{feature.text}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    // A lifted black, a shade apart from the AI block above, so the two
    // read as one dark run with a step between them. It stays dark in both
    // themes.
    .enterprise {
        --bg: #0d0d10;
        --rule-color: rgba(255, 255, 255, 0.08);
        --rule: 1px solid var(--rule-color);
        --text: #ffffff;
        --muted: #9a9aa8;
        --faint: #5c5c68;

        position: relative;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);

        // The rule between the AI block and this one, as faint as the
        // grid's.
        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: var(--rule-color);
            pointer-events: none;
        }
    }

    // The hairline grid, in white on black: rails on both sides, on the AI
    // block's lines, and full-width rules around the four cells.
    .grid {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);
    }

    // The title and copy on the left, the two ways on the right.
    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem 3rem;
        padding: 8.5rem var(--inset) 4rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--text);

            // The lead-in in grey, so Kestra Enterprise stands out, as in
            // the AI block's title.
            span {
                color: #a9a9b8;
            }

            em {
                font-style: normal;
                color: var(--text);
            }
        }

        p {
            max-width: 44rem;
            margin: 1.25rem 0 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.6);
            text-wrap: pretty;
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    // Four cells, two by two, between full-width rules: in each, the
    // glimpse of the product above its promise.
    .features {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
        border-block: var(--rule);

        &::before,
        &::after {
            content: "";
            position: absolute;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--rule-color);
            pointer-events: none;
        }

        &::before {
            top: -1px;
        }

        &::after {
            bottom: -1px;
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
        }

        > li {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            padding: 0 0 clamp(3rem, 5vw, 4rem) var(--inset);
            overflow: hidden;
            transition: background-color 0.3s ease;

            &:nth-child(even) {
                border-left: var(--rule);
            }

            &:nth-child(n + 3) {
                border-top: var(--rule);
            }

            &:hover {
                background: rgba(255, 255, 255, 0.015);
            }

            @include media-breakpoint-down(md) {
                &:nth-child(even) {
                    border-left: 0;
                }

                & + li {
                    border-top: var(--rule);
                }
            }
        }

        h3 {
            margin: 0 0 0.5rem;
            font-size: 1.125rem;
            font-weight: 500;
            line-height: 1.35;
            color: var(--text);
        }

        .text {
            max-width: 30rem;
            margin: 0;
            font-size: 1rem;
            line-height: 1.6;
            color: var(--muted);
        }
    }

    .copy {
        padding-right: var(--inset);
    }

    // The glimpse's stage, above the copy.
    .stage {
        padding-top: clamp(2.5rem, 4vw, 3.5rem);
    }

    .glimpse {
        // Fits the cell, short of its right rule, as the copy does, and
        // all four are the same height.
        display: flex;
        flex-direction: column;
        width: calc(100% - var(--inset));
        height: 23.5rem;
        overflow: hidden;

        // On a phone, one card per row: each as tall as its content.
