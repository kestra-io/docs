---
import { Icon } from "astro-icon/components"
import { API_URL } from "astro:env/client"
import kestraMark from "./assets/ai/kestra-logo-mark-on-dark.svg"

// The layers Enterprise adds on the open-source core, bottom up, for the
// head's visual.
const LAYERS = [
    { name: "Open source", note: "the core" },
    { name: "Security", note: "SSO · RBAC · secrets" },
    { name: "Governance", note: "audit logs · approvals" },
    { name: "Reliability", note: "worker groups · backup" },
]

// The backdrop's squares, after the 2.0 page: a ring of twelve on a grid
// of 7 by 5, drawn here rather than from its raster, one ring cut by each
// side of the section. A few are lit a little brighter.
const RING = [
    [2, 0],
    [3, 0],
    [4, 0],
    [1, 1],
    [5, 1],
    [0, 2],
    [6, 2],
    [1, 3],
    [5, 3],
    [2, 4],
    [3, 4],
    [4, 4],
]
const LIT = [3, 8]

// Four reasons, each under a glimpse of the product that proves it.
const FEATURES = [
    {
        id: "access",
        title: "Give every team secure access.",
        text: "Share one platform with isolated workflows, credentials, and execution environments.",
    },
    {
        id: "reliability",
        title: "Keep critical workflows running reliably.",
        text: "Support business continuity with worker groups, backup and restore, maintenance mode, and SLA-backed support.",
    },
    {
        id: "governance",
        title: "Verifiable governance",
        text: "Keep track of who ran each workflow, with which permissions, and approval chains with SSO, RBAC, audit logs, policies, and approval gates.",
    },
    {
        id: "scale",
        title: "Built for your scale and your network.",
        text: "Pick the backend that fits your load and scale. Make sure that only trusted workers can connect, wherever they run.",
    },
]

// The Infrastructure tenant, open on its namespaces and a flow.
const ROOT = "acme"
const NAMESPACES = [
    "acme.cloud",
    "acme.kubernetes",
    "acme.network",
    "acme.monitoring",
]
const FLOW = { parent: "acme.kubernetes", id: "scale_cluster" }
// The namespace the admin removes in the story.
const DELETED = "acme.network"
// Three roles: one edits the flow, one runs it, one deletes a namespace.
const PEOPLE = [
    { id: "launcher", name: "Launcher", icon: "mdi:play-circle-outline" },
    { id: "editor", name: "Editor", icon: "mdi:pencil" },
    { id: "admin", name: "Admin", icon: "mdi:shield-account-outline" },
]

// One execution, task by task, on a shared timeline (0 to 100). Halfway
// through post_ledger its worker goes down; a second attempt runs on
// another worker and the execution still ends in success.
const RUN = [
    { id: "extract", start: 0, end: 22, worker: "worker-1" },
    { id: "reconcile", start: 22, end: 44, worker: "worker-2" },
    { id: "post_ledger", start: 44, end: 60, worker: "worker-2", fails: true },
    { id: "retry", start: 62, end: 82, worker: "worker-3", retry: true },
    { id: "report", start: 82, end: 100, worker: "worker-1" },
]

// The audit log as the product lists it: what changed, how, by whom,
// one detail of it, and when. The first five show; the script streams the
// others in on top, newest first.
const AUDIT = [
    {
        type: "Execution",
        action: "Resumed",
        actor: "m.chen",
        detail: "approval:deploy_prod",
        age: 40,
    },
    {
        type: "Execution",
        action: "Created",
        actor: "s.roy",
        detail: "flowId:deploy_prod",
        age: 260,
    },
    {
        type: "Flow",
        action: "Updated",
        actor: "j.kim",
        detail: "revision:7",
        age: 900,
    },
    {
        type: "Role",
        action: "Created",
        actor: "admin",
        detail: "id:finance_viewer",
        age: 3600,
    },
    {
        type: "User",
        action: "Login",
        actor: "j.kim",
        detail: "resource:USER",
        age: 7400,
    },
    {
        type: "Secret",
        action: "Updated",
        actor: "m.chen",
        detail: "key:DB_PASSWORD",
        age: 0,
    },
    {
        type: "Namespace",
        action: "Updated",
        actor: "admin",
        detail: "id:acme.finance",
        age: 0,
    },
    {
        type: "Flow",
        action: "Created",
        actor: "agent-01",
        detail: "id:sync_crm",
        age: 0,
    },
    {
        type: "Binding",
        action: "Created",
        actor: "admin",
        detail: "role:editor",
        age: 0,
    },
]
// Each action with its icon, after the product's status tags.
const ACTION_ICONS: Record<string, string> = {
    Created: "mdi:plus-circle-outline",
    Updated: "mdi:pencil-outline",
    Resumed: "mdi:play-circle-outline",
    Login: "mdi:login",
}
const ago = (seconds: number) =>
    seconds < 60
        ? "just now"
        : seconds < 3600
          ? `${Math.round(seconds / 60)} min ago`
          : `${Math.round(seconds / 3600)} hours ago`

// The backends to pick from, each with its plugin's icon, fetched at
// build. JDBC alone is open source; Enterprise adds the rest. The script
// switches between a few setups.
const BACKENDS = {
    repository: [
        { id: "jdbc", name: "JDBC" },
        { id: "elasticsearch", name: "Elasticsearch", plugin: "elasticsearch" },
    ],
    queue: [
        { id: "jdbc", name: "JDBC" },
        { id: "redis", name: "Redis", plugin: "redis" },
        { id: "rabbitmq", name: "RabbitMQ", plugin: "amqp" },
        { id: "kafka", name: "Kafka", plugin: "kafka" },
    ],
}
const SETUPS = [
    ["elasticsearch", "kafka"],
    ["jdbc", "redis"],
    ["elasticsearch", "rabbitmq"],
    ["jdbc", "jdbc"],
]
const icons = Object.fromEntries(
    await Promise.all(
        [...BACKENDS.repository, ...BACKENDS.queue]
            .filter((backend) => backend.plugin)
            .map(async (backend) => {
                try {
                    const response = await fetch(
                        `${API_URL}/plugins/icons/io.kestra.plugin.${backend.plugin}`,
                    )
                    if (!response.ok) return [backend.id, null]
                    const svg = Buffer.from(await response.arrayBuffer())
                    return [
                        backend.id,
                        `data:image/svg+xml;base64,${svg.toString("base64")}`,
                    ]
                } catch {
                    return [backend.id, null]
                }
            }),
    ),
) as Record<string, string | null>

// As on the 2.0 page: workers prove who they are before they join.
const WORKERS = [
    { name: "onprem-01", ok: true },
    { name: "euwest-02", ok: true },
    { name: "unknown", ok: false },
]
---

{
    /* Kestra Enterprise, on black after the AI block, on the page's hairline
    grid: the head with its two ways on, then four cells, each a glimpse of
    the product, drawn in lines and fading out, over its promise. */
}
<section
    class="enterprise surface-dark"
    aria-labelledby="enterprise"
    data-header-dark
>
    {
        ["left", "right"].map((side) => (
            <svg
                class:list={["squares", side]}
                viewBox="0 0 500 352"
                aria-hidden="true"
            >
                {RING.map(([col, row], idx) => (
                    <rect
                        class:list={{ lit: LIT.includes(idx) }}
                        x={col * 74 + 0.5}
                        y={row * 74 + 0.5}
                        width="55"
                        height="55"
                        rx="3"
                        style={`--d: ${(side === "left" ? col : 6 - col) * 0.45}s`}
                    />
                ))}
            </svg>
        ))
    }
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <div>
                    <h2 id="enterprise">
                        <span>Achieve more with</span>{" "}
                        <em>Kestra Enterprise.</em>
                    </h2>
                    <p>
                        Kestra Enterprise gives you the security, governance and
                        SLA-backed support to run orchestration across your
                        whole organization. Run it self-hosted, in your cloud or
                        air-gapped.
                    </p>
                    <div class="actions">
                        <a href="/enterprise" class="btn-solid">
                            Explore Enterprise
                        </a>
                        <a href="/demo" class="btn-ghost">Book a demo</a>
                    </div>
                </div>
                {
                    /* Kestra Enterprise as layers on the open-source core,
                    in glass, seen from above: each layer a promise of the
                    cells below, Kestra on top. */
                }
                <div class="layers" aria-hidden="true" data-layers>
                    <div class="tower">
                        {
                            LAYERS.map((_, idx) => (
                                <div
                                    class:list={["plate", { core: idx === 0 }]}
                                    style={`--i: ${idx}`}
                                    data-plate
                                >
                                    <span class="handle tl" />
                                    <span class="handle tr" />
                                    <span class="handle br" />
                                    <span class="handle bl" />
                                </div>
                            ))
                        }
                        <div
                            class="plate top"
                            style={`--i: ${LAYERS.length}`}
                            data-plate
                        >
                            <img
                                src={kestraMark.src}
                                alt=""
                                width="96"
                                height="96"
                            />
                            <span class="handle tl"></span>
                            <span class="handle tr"></span>
                            <span class="handle br"></span>
                            <span class="handle bl"></span>
                        </div>
                    </div>
                    {
                        LAYERS.map((layer) => (
                            <span class="label" data-label>
                                <strong>{layer.name}</strong>
                                {layer.note}
                            </span>
                        ))
                    }
                    <span class="label" data-label>
                        <strong>Kestra Enterprise</strong>
                        all of it, in one platform
                    </span>
                </div>
            </header>

            <ul class="features">
                {
                    FEATURES.map((feature) => (
                        <li>
                            <div class="stage" aria-hidden="true">
                                <div
                                    class="glimpse free"
                                    data-card={feature.id}
                                >
                                    {feature.id === "access" && (
                                        <div
                                            class="glimpse-body tenant"
                                            data-tenants
                                        >
                                            <p class="tenant-label">
                                                <Icon name="mdi:server-network" />
                                                Tenant
                                                <span class="pill">
                                                    <span class="dot" />
                                                    Infrastructure
                                                </span>
                                            </p>
                                            <ul class="ns-tree">
                                                <li>
                                                    <span data-row={ROOT}>
                                                        <Icon
                                                            name="mdi:folder-open-outline"
                                                            class="folder"
                                                        />
                                                        {ROOT}
                                                    </span>
                                                    <ul>
                                                        {NAMESPACES.map(
                                                            (namespace) => (
                                                                <li
                                                                    class:list={{
                                                                        doomed:
                                                                            namespace ===
                                                                            DELETED,
                                                                    }}
                                                                >
                                                                    <span
                                                                        data-row={
                                                                            namespace
                                                                        }
                                                                    >
                                                                        <Icon
                                                                            name="mdi:folder-open-outline"
                                                                            class="folder"
                                                                        />
                                                                        {
                                                                            namespace
                                                                        }
                                                                        {namespace ===
                                                                            DELETED && (
                                                                            <span
                                                                                class="row-state"
                                                                                data-row-state
                                                                            >
                                                                                <span class="pill bad deleted">
                                                                                    <Icon name="mdi:delete-outline" />
                                                                                    Deleted
                                                                                </span>
                                                                            </span>
                                                                        )}
                                                                    </span>
                                                                    {namespace ===
                                                                        FLOW.parent && (
                                                                        <ul>
                                                                            <li>
                                                                                <span data-row="flow">
                                                                                    <Icon name="mdi:file-tree-outline" />
                                                                                    {
                                                                                        FLOW.id
                                                                                    }
                                                                                    <span
                                                                                        class="row-state"
                                                                                        data-row-state
                                                                                    >
                                                                                        <span class="pill editing">
                                                                                            <Icon name="mdi:pencil" />
                                                                                            Editing
                                                                                        </span>
                                                                                        <span class="pill run running">
                                                                                            <Icon
                                                                                                name="mdi:loading"
                                                                                                class="spin"
                                                                                            />
                                                                                            Running
                                                                                        </span>
                                                                                        <span class="pill ok success">
                                                                                            <Icon name="mdi:check-circle-outline" />
                                                                                            Success
                                                                                        </span>
                                                                                    </span>
                                                                                </span>
                                                                            </li>
                                                                        </ul>
                                                                    )}
                                                                </li>
                                                            ),
                                                        )}
                                                    </ul>
                                                </li>
                                            </ul>
                                            {PEOPLE.map((person) => (
                                                <span
                                                    class:list={[
                                                        "cursor",
                                                        person.id,
                                                    ]}
                                                    data-person={person.id}
                                                >
                                                    <svg viewBox="0 0 10 10">
                                                        <path d="M0 0 L10 4 L5.5 5.5 L4 10 Z" />
                                                    </svg>
                                                    <span class="who">
                                                        <Icon
                                                            name={person.icon}
                                                        />
                                                        {person.name}
                                                    </span>
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                    {feature.id === "reliability" && (
                                        <div
                                            class="glimpse-body timeline"
                                            data-routing
                                        >
                                            {/* Drawn at its end, success
                                            after the retry; the script
                                            plays it from the start. */}
                                            <p class="run-head">
                                                <Icon name="mdi:file-tree-outline" />
                                                <strong>close_books</strong>
                                                <span
                                                    class="run-tag is-success"
                                                    data-run-state
                                                >
                                                    <Icon
                                                        name="mdi:check-circle-outline"
                                                        class="done"
                                                    />
                                                    <Icon
                                                        name="mdi:loading"
                                                        class="spin"
                                                    />
                                                    <span data-run-time>
                                                        Success
                                                    </span>
                                                </span>
                                            </p>
                                            <div class="rows">
                                                {RUN.map((step) => (
                                                    <p
                                                        class:list={[
                                                            "row",
                                                            {
                                                                retry: step.retry,
                                                                failed: step.fails,
                                                            },
                                                        ]}
                                                        data-step={step.id}
                                                    >
                                                        <span class="name">
                                                            {step.retry
                                                                ? "↳ attempt 2"
                                                                : step.id}
                                                        </span>
                                                        <span class="track">
                                                            <span
                                                                class:list={[
                                                                    "attempt",
                                                                    "go",
                                                                    step.fails
                                                                        ? "broken"
                                                                        : "done",
                                                                ]}
                                                                style={`left: ${step.start}%; width: ${step.end - step.start}%; --ms: ${(step.end - step.start) * 45}ms`}
                                                            >
                                                                {step.worker}
                                                            </span>
                                                            {step.fails && (
                                                                <span
                                                                    class="down"
                                                                    style={`left: ${step.end}%`}
                                                                >
                                                                    <Icon name="mdi:close-circle-outline" />
                                                                    {
                                                                        step.worker
                                                                    }{" "}
                                                                    down
                                                                </span>
                                                            )}
                                                        </span>
                                                    </p>
                                                ))}
                                            </div>
                                            <p class="status ok" data-status>
                                                <span class="live" />
                                                <span data-status-text>
                                                    Success · 0 executions lost
                                                </span>
                                            </p>
                                        </div>
                                    )}
                                    {feature.id === "governance" && (
                                        <div
                                            class="glimpse-body notes"
                                            data-audit
                                        >
                                            <div class="stack" data-stack>
                                                {AUDIT.slice(0, 3).map(
                                                    (line) => (
                                                        <div
                                                            class="note"
                                                            data-age={line.age}
                                                        >
                                                            <p class="note-top">
                                                                <span class="pill">
                                                                    {line.type}
                                                                </span>
                                                                <span
                                                                    class:list={[
                                                                        "state",
                                                                        line.action.toLowerCase(),
                                                                    ]}
                                                                >
                                                                    <Icon
                                                                        name={
                                                                            ACTION_ICONS[
                                                                                line
                                                                                    .action
                                                                            ]
                                                                        }
                                                                    />
                                                                    {
                                                                        line.action
                                                                    }
                                                                </span>
                                                                <span class="date">
                                                                    {ago(
                                                                        line.age,
                                                                    )}
                                                                </span>
                                                            </p>
                                                            <p class="note-main">
                                                                <strong>
                                                                    {line.actor}
                                                                </strong>
                                                                <span class="tag">
                                                                    {
                                                                        line.detail
                                                                    }
                                                                </span>
                                                            </p>
                                                        </div>
                                                    ),
                                                )}
                                            </div>
                                            <template data-pool>
                                                {AUDIT.slice(3).map((line) => (
                                                    <div
                                                        class="note"
                                                        data-age={line.age}
                                                    >
                                                        <p class="note-top">
                                                            <span class="pill">
                                                                {line.type}
                                                            </span>
                                                            <span
                                                                class:list={[
                                                                    "state",
                                                                    line.action.toLowerCase(),
                                                                ]}
                                                            >
                                                                <Icon
                                                                    name={
                                                                        ACTION_ICONS[
                                                                            line
                                                                                .action
                                                                        ]
                                                                    }
                                                                />
                                                                {line.action}
                                                            </span>
                                                            <span class="date">
                                                                {ago(line.age)}
                                                            </span>
                                                        </p>
                                                        <p class="note-main">
                                                            <strong>
                                                                {line.actor}
                                                            </strong>
                                                            <span class="tag">
                                                                {line.detail}
                                                            </span>
                                                        </p>
                                                    </div>
                                                ))}
                                            </template>
                                            <p class="stream">
                                                <span class="live" />
                                                Streaming to Splunk & Syslog
                                                over TLS
                                                <span class="count">
                                                    <span data-exported>
                                                        1,284
                                                    </span>{" "}
                                                    events
                                                </span>
                                            </p>
                                        </div>
                                    )}
                                    {feature.id === "scale" && (
                                        <div
                                            class="glimpse-body schema-body"
                                            data-backends
                                            data-setups={JSON.stringify(SETUPS)}
                                        >
                                            <div
                                                class="schema blocked"
                                                data-intruder
                                            >
                                                <svg
                                                    class="lines"
                                                    viewBox="0 0 560 340"
                                                    aria-hidden="true"
                                                >
                                                    <path
                                                        class="wire"
                                                        d="M140 100 C196 100 196 170 252 170"
                                                    />
                                                    <path
                                                        class="wire"
                                                        d="M140 170 H252"
                                                    />
                                                    {/* The unknown worker sends its run like the
                                                    others; it is stopped on the way, a cross
                                                    appears and its link turns red. */}
                                                    <path
                                                        class="wire intruder"
                                                        d="M140 240 C196 240 196 170 252 170"
                                                    />
                                                    <path
                                                        class="jet"
                                                        d="M140 240 C196 240 196 170 252 170"
                                                        data-jet
                                                    />
                                                    <path
                                                        class="cut"
                                                        d="M192.5 201.5 l7 7 M199.5 201.5 l-7 7"
                                                    />
                                                    <path
                                                        class="wire"
                                                        d="M308 170 C354 170 354 112 400 112"
                                                    />
                                                    <path
                                                        class="wire"
                                                        d="M308 170 C354 170 354 228 400 228"
                                                    />
                                                    <g class="flows">
                                                        <path d="M140 100 C196 100 196 170 252 170 H308 C354 170 354 112 400 112" />
                                                        <path d="M140 170 H308 C354 170 354 228 400 228" />
                                                    </g>
                                                </svg>
                                                <p
                                                    class="workers"
                                                    data-handshake
                                                >
                                                    {WORKERS.map(
                                                        (worker, idx) => (
                                                            <span
                                                                class:list={[
                                                                    "worker",
                                                                    worker.ok
                                                                        ? "ok"
                                                                        : "refused",
                                                                ]}
                                                                data-worker={
                                                                    worker.ok
                                                                        ? "ok"
                                                                        : "refused"
                                                                }
                                                                style={`top: ${100 + idx * 70}px`}
                                                            >
                                                                <span class="state" />
                                                                {worker.name}
                                                            </span>
                                                        ),
                                                    )}
                                                </p>
                                                <span class="hub">
                                                    <img
                                                        src={kestraMark.src}
                                                        alt=""
                                                        width="28"
                                                        height="28"
                                                    />
                                                </span>
                                                <span class="hub-label">
                                                    Kestra
                                                </span>
                                                {(
                                                    [
                                                        "repository",
                                                        "queue",
                                                    ] as const
                                                ).map((kind, col) => (
                                                    <div
                                                        class:list={[
                                                            "lane",
                                                            kind,
                                                        ]}
                                                        data-column={kind}
                                                    >
                                                        <div class="bar">
                                                            <p class="lane-title">
                                                                {kind ===
                                                                "repository"
                                                                    ? "Repository"
                                                                    : "Queue"}
                                                            </p>
                                                            {BACKENDS[kind].map(
                                                                (backend) => (
                                                                    <span
                                                                        class:list={[
                                                                            "choice",
                                                                            {
                                                                                on:
                                                                                    backend.id ===
                                                                                    SETUPS[0][
                                                                                        col
                                                                                    ],
                                                                            },
                                                                        ]}
                                                                        data-option={
                                                                            backend.id
                                                                        }
                                                                    >
                                                                        <span class="logo">
                                                                            {icons[
                                                                                backend
                                                                                    .id
                                                                            ] ? (
                                                                                <img
                                                                                    src={
                                                                                        icons[
                                                                                            backend
                                                                                                .id
                                                                                        ]
                                                                                    }
                                                                                    alt=""
                                                                                />
                                                                            ) : (
                                                                                <Icon
                                                                                    name="mdi:language-java"
                                                                                    class="java"
                                                                                />
                                                                            )}
                                                                        </span>
                                                                        {
                                                                            backend.name
                                                                        }
                                                                    </span>
                                                                ),
                                                            )}
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </div>
                            <div class="copy">
                                <h3>{feature.title}</h3>
                                <p class="text">{feature.text}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    // A lifted black, a shade apart from the AI block above, so the two
    // read as one dark run with a step between them. It stays dark in both
    // themes.
    .enterprise {
        --bg: #0d0d10;
        --rule-color: rgba(255, 255, 255, 0.08);
        --rule: 1px solid var(--rule-color);
        --text: #ffffff;
        --muted: #9a9aa8;
        --faint: #5c5c68;
        // The states, in the colours of the product's status tags
        // (KsExecutionStatus), on every glimpse.
        --created: #8b98ff;
        --success: #5ee3ae;
        --running: #9d78ff;
        --warning: #f28c5c;
        --danger: #ff6b6b;
        --neutral: #b9b9c6;

        position: relative;
        overflow: hidden;
        // As on the 2.0 page: black, easing to a blue-grey at the foot.
        background: linear-gradient(180deg, #000000 30%, #17181e 100%);
        color: var(--text);

        > .container-xl {
            position: relative;
            z-index: 1;
        }

        // The rule between the AI block and this one, as faint as the
        // grid's.
        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: var(--rule-color);
            pointer-events: none;
        }
    }

    // The 2.0 page's squares, a ring at each side of the section's foot,
    // cut by its edges: pale fills with a lighter outline, lighting up in a
    // slow wave across each ring.
    .squares {
        position: absolute;
        width: 520px;
        pointer-events: none;

        &.left {
            bottom: -96px;
            left: -100px;
        }

        &.right {
            right: -260px;
            bottom: 140px;
        }

        // On narrower screens the rings sit further out, in the margins,
        // clear of the cells' pictures.
        @media (max-width: 1700px) {
            &.left {
                left: -200px;
            }

            &.right {
                right: -380px;
            }
        }

        rect {
            fill: rgba(196, 200, 255, 0.05);
            stroke: rgba(196, 200, 255, 0.16);
            stroke-width: 1;
            animation: glint 9s ease-in-out var(--d) infinite;

            &.lit {
                fill: rgba(196, 200, 255, 0.08);
                stroke: rgba(196, 200, 255, 0.4);
            }
        }

        @include media-breakpoint-down(lg) {
            display: none;
        }
    }

    @keyframes glint {
        0%,
        100% {
            opacity: 0.6;
        }

        20% {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .squares rect {
            animation: none;
        }
    }

    // The hairline grid, in white on black: rails on both sides, on the AI
    // block's lines, and full-width rules around the four cells.
    .grid {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);
        // An empty closing row between the rails, so the last cells' copy
        // does not sit on the section's edge.
        padding-bottom: clamp(3rem, 5vw, 4.5rem);
    }

    // The title and copy on the left, the two ways on the right.
    // The title, copy and two ways on the left, the layers on the right.
    .head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
        align-items: center;
        gap: 2rem 3rem;
        padding: 6.5rem var(--inset) 4.5rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: minmax(0, 1fr);
        }

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--text);

            // The lead-in in grey, so Kestra Enterprise stands out, as in
            // the AI block's title.
            span {
                color: #a9a9b8;
            }

            em {
                font-style: normal;
                color: var(--text);
            }
        }

        p {
            max-width: 40rem;
            margin: 1.25rem 0 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.6);
            text-wrap: pretty;
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    // The layers: glass plates stacked over the core, seen from above.
    // Pointing at one picks it and shows its label; left alone, they are
    // picked in turn, bottom up.
    .layers {
        --gap: 3rem;

        position: relative;
        display: grid;
        place-items: center start;
        height: 24rem;
        padding-left: 3rem;

        @include media-breakpoint-down(lg) {
            display: none;
        }
    }

    .tower {
        position: relative;
        // The stack drawn centred on the copy beside it: the plates rise
        // from the tower's box, so it sits lower.
        top: 2.1rem;
        width: 13rem;
        height: 13rem;
        margin-top: 6rem;
        transform: rotateX(58deg) rotateZ(-42deg);
        transform-style: preserve-3d;
    }

    .plate {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 1.25rem;
        background:
            linear-gradient(
                135deg,
                rgba(255, 255, 255, 0.1),
                rgba(255, 255, 255, 0.02) 60%
            ),
            rgba(20, 20, 24, 0.55);
        box-shadow:
            inset 0 0 0 1px rgba(255, 255, 255, 0.03),
            0 30px 50px -20px rgba(0, 0, 0, 0.8);
        transform: translateZ(calc(var(--i) * var(--gap)));
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);

        // Picked, as in a design tool: a bright edge with a handle at each
        // corner, the layer lifted a little.
        &::after {
            content: "";
            position: absolute;
            inset: -1px;
            border: 1.5px solid rgba(255, 255, 255, 0.85);
            border-radius: inherit;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .handle {
            position: absolute;
            width: 9px;
            height: 9px;
            margin: -4.5px;
            border: 1.5px solid rgba(255, 255, 255, 0.85);
            border-radius: 50%;
            background: #0d0d10;
            opacity: 0;
            transition: opacity 0.3s ease;

            &.tl {
                top: 0;
                left: 0;
            }

            &.tr {
                top: 0;
                right: 0;
            }

            &.br {
                right: 0;
                bottom: 0;
            }

            &.bl {
                bottom: 0;
                left: 0;
            }
        }

        &:global(.active) {
            transform: translateZ(calc(var(--i) * var(--gap) + 0.75rem));

            &::after,
            .handle {
                opacity: 1;
            }
        }

        // The core: a plain grid, the base the others stand on.
        &.core {
            border-style: dashed;
            border-color: rgba(255, 255, 255, 0.12);
            background:
                linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 0) 0
                    0 / 1.625rem 1.625rem,
                linear-gradient(
                        90deg,
                        rgba(255, 255, 255, 0.05) 1px,
                        transparent 0
                    )
                    0 0 / 1.625rem 1.625rem,
                rgba(14, 14, 17, 0.7);
        }

        // Kestra on top, lit from within.
        &.top {
            border-color: rgba(255, 255, 255, 0.3);
            background:
                radial-gradient(
                    circle at 50% 50%,
                    rgba(255, 255, 255, 0.14),
                    transparent 65%
                ),
                linear-gradient(135deg, #2a2a31, #151519);
            box-shadow:
                inset 0 0 0 1px rgba(255, 255, 255, 0.06),
                0 0 60px rgba(255, 255, 255, 0.08),
                0 30px 50px -20px rgba(0, 0, 0, 0.8);

            img {
                width: 6.5rem;
                height: 6.5rem;
                // Upright again, so the mark reads.
                transform: rotateZ(42deg);
            }
        }
    }

    // Each label flat, on one line, out from its plate's right corner,
    // where the script sets it; shown only while its layer is picked.
    .label {
        position: absolute;
        top: 0;
        left: 0;
        display: flex;
        gap: 0.5rem;
        padding-left: 2.25rem;
        font-size: 0.8125rem;
        white-space: nowrap;
        color: var(--muted);
        opacity: 0;
        transform: translateY(-50%);
        transition: opacity 0.2s ease;

        // The leader from the corner.
        &::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 1.75rem;
            height: 1px;
            background: rgba(255, 255, 255, 0.22);
        }

        strong {
            font-weight: 500;
            color: #ededf1;
        }

        &:global(.placed.active) {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .plate {
            transition: none;
        }
    }

    // Four cells, two by two, between full-width rules: in each, the
    // glimpse of the product above its promise.
    .features {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
        // A rule above the cells only: under them, the closing row runs
        // straight to the section's edge.
        border-top: var(--rule);

        &::before {
            content: "";
            position: absolute;
            top: -1px;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--rule-color);
            pointer-events: none;
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
        }

        > li {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            padding: 0 0 clamp(3.5rem, 5.5vw, 4.75rem) var(--inset);
            overflow: hidden;
            transition: background-color 0.3s ease;

            &:nth-child(even) {
                border-left: var(--rule);
            }

            &:nth-child(n + 3) {
                border-top: var(--rule);
            }

            &:hover {
                background: rgba(255, 255, 255, 0.015);
            }

            @include media-breakpoint-down(md) {
                &:nth-child(even) {
                    border-left: 0;
                }

                & + li {
                    border-top: var(--rule);
                }
            }
        }

        h3 {
            margin: 0 0 0.5rem;
            font-size: 1.375rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            line-height: 1.35;
            color: var(--text);
        }

        .text {
            max-width: 30rem;
            margin: 0;
            font-size: 1rem;
            line-height: 1.6;
            color: var(--muted);
        }
    }

    .copy {
        padding-right: var(--inset);
    }

    // The glimpse's stage, above the copy.
    .stage {
        padding-top: clamp(2.5rem, 4vw, 3.5rem);
    }

    .glimpse {
        // Fits the cell, short of its right rule, as the copy does, and
        // all four are the same height.
        display: flex;
        flex-direction: column;
        width: calc(100% - var(--inset));
        height: 23.5rem;
        overflow: hidden;

        // On a phone, one card per row: each as tall as its content.
        @include media-breakpoint-down(md) {
            height: auto;
            min-height: 25rem;
        }
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 0.75rem;
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.035) 0%,
            rgba(255, 255, 255, 0.012) 60%
        );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.05),
            0 30px 60px -30px rgba(0, 0, 0, 0.9);
        font-size: 0.9375rem;
        color: #c9c9d2;

        p {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
        }

        :global(svg) {
            flex: none;
            width: 1rem;
            height: 1rem;
            color: var(--faint);
        }

        :global(.spin) {
            animation: spin 1s linear infinite;
        }
    }

    // The content runs the card's full width.
    .glimpse-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.125rem 1.25rem 1.5rem;
    }

    // Labels and states as the product tags them: filled, small corners,
    // no edge, colour only for a state.
    .pill,
    .tag {
        display: inline-flex;
        align-items: center;
        gap: 0.3125rem;
        padding: 0.125rem 0.5rem;
        border-radius: 0.375rem;
        background: rgba(255, 255, 255, 0.07);
        font-size: 0.75rem;
        font-weight: 500;
        line-height: 1.5;
        white-space: nowrap;
        color: #c9c9d2;

        :global(svg) {
            width: 0.875rem;
            height: 0.875rem;
            color: currentColor;
        }

        .dot {
            width: 0.375rem;
            height: 0.375rem;
            border-radius: 50%;
            background: currentColor;
        }
    }

    .tag {
        padding-inline: 0.4375rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        color: var(--muted);
    }

    .pill {
        transition:
            color 0.3s ease,
            background-color 0.3s ease;

        &.ok {
            background: color-mix(in srgb, var(--success) 14%, transparent);
            color: var(--success);
        }

        &.bad {
            background: color-mix(in srgb, var(--danger) 14%, transparent);
            color: var(--danger);
        }

        &.run {
            background: color-mix(in srgb, var(--running) 14%, transparent);
            color: var(--running);
        }

        &.wait {
            background: color-mix(in srgb, var(--warning) 14%, transparent);
            color: var(--warning);
        }
    }

    // The tenant: its tree, and the people at work in it.
    // It fills the card, so the editor's spot at the foot holds while a
    // row folds away.
    .tenant {
        position: relative;
        flex: 1;
        gap: 1.25rem;
    }

    // The tenant named over its tree, with its kind.
    .tenant-label {
        font-size: 0.875rem;
        color: var(--muted);

        :global(svg) {
            width: 1.125rem;
            height: 1.125rem;
            color: var(--muted);
        }

        // The tenant's kind at the far right.
        .pill {
            margin-left: auto;
        }
    }

    // A row's state as the story goes: the flow edited, run and done, the
    // namespace deleted. One pill at a time, set by the script; none at
    // rest.
    .row-state {
        display: grid;
        margin-left: auto;

        .pill {
            grid-area: 1 / 1;
            justify-self: end;
            opacity: 0;
            transform: translateY(2px);
            transition:
                opacity 0.3s ease,
                transform 0.3s ease;
        }

        &[data-state="editing"] .editing,
        &[data-state="running"] .running,
        &[data-state="success"] .success,
        &[data-state="deleted"] .deleted {
            opacity: 1;
            transform: none;
        }
    }

    // Hairline branches, as in the illustration.
    // Drawn large, straight on the section: the tree is the picture.
    .ns-tree {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.9375rem;
        color: var(--muted);

        // Namespaces are folders, in the product's violet.
        :global(.folder) {
            color: #b48cff;
        }

        ul {
            margin: 0 0 0 0.4375rem;
            padding: 0;
            list-style: none;
        }

        // The root has no branch into it.
        > li {
            padding-left: 0;

            &::before {
                display: none;
            }
        }

        li {
            position: relative;
            padding-left: 0.875rem;

            // The namespace the admin deletes folds away, and back.
            &.doomed {
                max-height: 2.25rem;
                overflow: hidden;
                transition:
                    max-height 0.5s ease,
                    opacity 0.4s ease;

                &:global(.removed) {
                    max-height: 0;
                    opacity: 0;
                }
            }

            // The branch to this item, from the line on its left.
            &::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 0.625rem;
                height: 1rem;
                border-left: 1px solid rgba(255, 255, 255, 0.14);
                border-bottom: 1px solid rgba(255, 255, 255, 0.14);
            }

            // The line goes on down to the next sibling.
            &:not(:last-child)::after {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                border-left: 1px solid rgba(255, 255, 255, 0.14);
            }
        }

        // A row lights up, in the person's colour, while they are on it.
        [data-row] {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            margin-left: -0.375rem;
            padding: 0 0.375rem;
            border: 1px solid transparent;
            border-radius: 0.375rem;
            line-height: 2rem;
            transition:
                background-color 0.4s ease,
                border-color 0.4s ease,
                color 0.4s ease;

            // Struck through once deleted, until the story starts again.
            &:global(.gone) {
                text-decoration: line-through;
                opacity: 0.55;
            }

            &:global(.hot) {
                border-color: rgba(var(--tone), 0.25);
                background: rgba(var(--tone), 0.06);
                color: rgb(var(--tone));

                :global(svg) {
                    color: currentColor;
                }
            }
        }

        :global(svg) {
            width: 0.9375rem;
            height: 0.9375rem;
        }
    }

    // A pointer with its person's chip, each in their own colour. The
    // script glides them from row to row; without it they rest where they
    // are placed here.
    .cursor {
        --tone: 240, 140, 190;

        position: absolute;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.125rem;
        transition:
            left 1.1s cubic-bezier(0.65, 0, 0.35, 1),
            top 1.1s cubic-bezier(0.65, 0, 0.35, 1),
            opacity 0.5s ease;

        :global(.placing) & {
            transition: none;
        }

        &:global(.idle) {
            opacity: 0.3;
        }

        svg {
            width: 0.75rem;
            height: 0.75rem;
            fill: rgb(var(--tone));
        }

        &.launcher {
            top: 1.25rem;
            left: 45%;
        }

        &.editor {
            --tone: 120, 214, 170;

            bottom: 0.5rem;
            left: 6%;
        }

        &.admin {
            --tone: 140, 196, 255;

            top: 3.5rem;
            left: 72%;
        }
    }

    .who {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-left: 0.5rem;
        padding: 0.0625rem 0.4375rem;
        border: 1px solid rgba(var(--tone), 0.45);
        border-radius: 0.375rem;
        background: rgba(20, 20, 24, 0.6);
        backdrop-filter: blur(4px);
        font-size: 0.8125rem;
        font-weight: 500;
        white-space: nowrap;
        color: rgb(var(--tone));

        :global(svg) {
            width: 0.8125rem;
            height: 0.8125rem;
            color: currentColor;
        }
    }

    // One execution as a timeline, each task a bar under the last. A
    // worker goes down halfway through a task: its bar breaks in red, a
    // second attempt starts on another worker under it, and the run still
    // ends in success.
    .timeline {
        gap: 1.25rem;
        width: 100%;
        max-width: 34rem;
        margin-inline: auto;
    }

    .run-head {
        font-size: 0.875rem;
        color: var(--muted);

        strong {
            font-weight: 400;
        }
    }

    // The execution's state as the UI tags it: a spinner while it runs, a
    // check once it succeeds.
    .run-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: auto;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 500;
        transition:
            color 0.3s ease,
            background-color 0.3s ease;

        :global(svg) {
            width: 14px;
            height: 14px;
            color: currentColor;
        }

        :global(.done),
        :global(.spin) {
            display: none;
        }

        &:global(.is-running) {
            background: color-mix(in srgb, var(--running) 14%, transparent);
            color: var(--running);

            :global(.spin) {
                display: block;
            }
        }

        &:global(.is-success) {
            background: color-mix(in srgb, var(--success) 18%, transparent);
            color: var(--success);

            :global(.done) {
                display: block;
            }
        }
    }

    .rows {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .row {
        gap: 0.75rem;
        font-size: 0.8125rem;

        .name {
            flex: none;
            width: 6.5rem;
            color: #c9c9d2;
        }

        &.retry .name {
            color: var(--muted);
        }
    }

    .track {
        position: relative;
        display: block;
        flex: 1;
        height: 1.375rem;
        // The timeline's hairline.
        background: linear-gradient(
                rgba(255, 255, 255, 0.06),
                rgba(255, 255, 255, 0.06)
            )
            0 50% / 100% 1px no-repeat;
    }

    // A task's bar: it draws itself over the task's time, then turns green
    // once done, or red where its worker went down.
    .attempt {
        position: absolute;
        top: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding-left: 0.375rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.1);
        font-size: 0.6875rem;
        white-space: nowrap;
        color: #c9c9d2;
        clip-path: inset(0 100% 0 0);
        transition:
            clip-path var(--ms) linear,
            background-color 0.3s ease,
            border-color 0.3s ease;

        &:global(.go) {
            clip-path: inset(0);
        }

        &:global(.done) {
            border-color: color-mix(in srgb, var(--success) 50%, transparent);
            background: color-mix(in srgb, var(--success) 16%, transparent);
            color: #e6e6ea;
        }

        &:global(.broken) {
            border-color: color-mix(in srgb, var(--danger) 55%, transparent);
            background: color-mix(in srgb, var(--danger) 14%, transparent);
        }
    }

    // Where the worker went down, after the broken bar.
    .down {
        position: absolute;
        top: 50%;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-left: 0.5rem;
        font-size: 0.75rem;
        white-space: nowrap;
        color: var(--danger);
        opacity: 0;
        transform: translateY(-50%);
        transition: opacity 0.3s ease;

        :global(svg) {
            width: 0.8125rem;
            height: 0.8125rem;
            color: currentColor;
        }
    }

    .row:global(.failed) .down {
        opacity: 1;
    }

    // The run's outcome under it; amber while a task is retried, green
    // once the run succeeds.
    .status {
        font-size: 0.8125rem;
        color: var(--muted);
        transition: color 0.3s ease;

        .live {
            background: var(--faint);
        }

        &:global(.warn) {
            color: var(--warning);

            .live {
                background: var(--warning);

                &::after {
                    border-color: var(--warning);
                }
            }
        }

        &:global(.ok) {
            color: var(--success);

            .live {
                background: var(--success);
            }
        }
    }

    // Each glimpse on its own soft panel, so it reads as a picture of the
    // product, apart from the cell's title and copy.
    .glimpse.free {
        border-color: rgba(255, 255, 255, 0.055);
        background:
            radial-gradient(
                120% 90% at 50% 0%,
                rgba(255, 255, 255, 0.03),
                transparent 70%
            ),
            rgba(255, 255, 255, 0.007);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);

        .glimpse-body {
            justify-content: center;
            padding: 1.5rem 1.75rem;
        }
    }

    // The audit log as a stack of events, as notifications: the newest in
    // front, the ones before it fading behind. A new one drops in on top.
    .notes {
        align-items: center;
        gap: 2.5rem;
    }

    .stack {
        position: relative;
        width: min(100%, 32rem);
        height: 6.5rem;
    }

    .note {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.875rem 1rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        background: #17171b;
        box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.9);
        transform-origin: bottom center;
        transition:
            transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.7s ease;

        &:nth-child(1) {
            z-index: 3;
        }

        > * {
            transition: opacity 0.4s ease;
        }

        // Behind, only the cards' edges show, not what they say.
        &:nth-child(n + 2) > * {
            opacity: 0;
        }

        &:nth-child(2) {
            z-index: 2;
            opacity: 0.7;
            transform: translateY(0.625rem) scale(0.95);
        }

        &:nth-child(3) {
            z-index: 1;
            opacity: 0.35;
            transform: translateY(1.25rem) scale(0.9);
        }

        &:nth-child(n + 4) {
            opacity: 0;
            transform: translateY(2.5rem) scale(0.85);
        }

        // Where a new event starts, above the stack.
        &:global(.enter) {
            opacity: 0;
            transform: translateY(-1rem);
            transition: none;
        }

        p {
            gap: 0.5rem;
            font-size: 0.875rem;
        }
    }

    .note-top {
        // The action as a status tag: created in its blue with a plus,
        // resumed running, the others neutral.
        .state {
            --tone: var(--neutral);

            display: inline-flex;
            align-items: center;
            gap: 0.3125rem;
            padding: 0.125rem 0.5rem;
            border-radius: 0.375rem;
            background: color-mix(in srgb, var(--tone) 16%, transparent);
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--tone);

            :global(svg) {
                width: 0.875rem;
                height: 0.875rem;
                color: currentColor;
            }

            &.created {
                --tone: var(--created);
            }

            &.resumed {
                --tone: var(--running);
            }
        }

        .date {
            margin-left: auto;
            font-size: 0.8125rem;
            color: var(--faint);
        }
    }

    .note-main strong {
        font-weight: 500;
        color: #ffffff;
    }

    .stream {
        font-size: 0.875rem;
        color: var(--muted);

        .count {
            margin-left: 0.75rem;
            font-variant-numeric: tabular-nums;
            color: var(--faint);
        }
    }

    // The log's live dot.
    .live {
        position: relative;
        width: 0.4375rem;
        height: 0.4375rem;
        border-radius: 50%;
        background: var(--success);

        &::after {
            content: "";
            position: absolute;
            inset: -0.25rem;
            border-radius: 50%;
            border: 1px solid var(--success);
            opacity: 0;
            animation: ping 2s ease-out infinite;
        }
    }

    // The backend as a schema, after the 2.0 page: the workers on the left
    // connect to Kestra over mTLS (the unknown one's link breaks on the
    // way), and Kestra runs on the repository and queue picked on the
    // right. Drawn on a fixed 560 by 340 box, in the AI block's nodes.
    .schema-body {
        align-items: center;
    }

    .schema {
        position: relative;
        width: 35rem;
        height: 21.25rem;
        flex: none;
        font-size: 0.875rem;

        @include media-breakpoint-down(xl) {
            zoom: 0.8;
        }

        // Drawn smaller on a phone, so it all still shows.
        @include media-breakpoint-down(md) {
            zoom: 0.55;
        }
    }

    .schema > .lines {
        position: absolute;
        inset: 0;
        width: 560px;
        height: 340px;
        overflow: visible;
        fill: none;

        .wire {
            stroke: rgba(255, 255, 255, 0.16);
            stroke-width: 1;

            &.intruder {
                transition: stroke 0.3s ease;
            }
        }

        // The unknown worker's run, sent by the script; it stops halfway.
        .jet {
            stroke: rgba(255, 255, 255, 0.7);
            stroke-width: 1.25;
            stroke-linecap: round;
            stroke-dasharray: 14 400;
            stroke-dashoffset: 14;
            opacity: 0;
        }

        // The small red cross where it is stopped.
        .cut {
            stroke: var(--danger);
            stroke-width: 1.5;
            stroke-linecap: round;
            opacity: 0;
            transform: scale(0.4);
            transform-box: fill-box;
            transform-origin: center;
            transition:
                opacity 0.2s ease,
                transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        // Runs travelling along the wires.
        .flows path {
            stroke: rgba(255, 255, 255, 0.7);
            stroke-width: 1.25;
            stroke-linecap: round;
            stroke-dasharray: 14 640;
            animation: flow 3.2s linear infinite;

            & + path {
                animation-delay: -1.6s;
            }
        }
    }

    // Once stopped: the link dashed in red, and the cross.
    .schema:global(.blocked) {
        .lines .intruder {
            stroke: color-mix(in srgb, var(--danger) 55%, transparent);
            stroke-dasharray: 3 3;
        }

        .lines .cut {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes flow {
        from {
            stroke-dashoffset: 654;
        }

        to {
            stroke-dashoffset: 0;
        }
    }

    .workers {
        display: contents;
    }

    // A node, as in the AI block: a dark fill, a hairline edge, small
    // corners.
    .worker,
    .bar {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        background: #141418;
    }

    .worker {
        position: absolute;
        left: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        width: 140px;
        height: 40px;
        margin-top: -20px;
        padding: 0 0.75rem;
        font-size: 0.875rem;
        white-space: nowrap;
        color: #e6e6ea;

        .state {
            width: 0.4375rem;
            height: 0.4375rem;
            border-radius: 50%;
            background: var(--success);
            transition: background-color 0.3s ease;
        }

        &.refused {
            border-color: color-mix(in srgb, var(--danger) 30%, transparent);
            color: var(--muted);

            .state {
                background: var(--danger);
            }
        }

        // While it is checked: a grey, pulsing dot.
        &:global(.checking) {
            border-color: rgba(255, 255, 255, 0.1);

            .state {
                background: var(--faint);
                animation: pulse 0.9s ease-in-out infinite;
            }
        }

        &:global(.shake) {
            animation: shake 0.45s ease;
        }
    }

    // Kestra in the middle, on its black tile.
    .hub {
        position: absolute;
        top: 142px;
        left: 252px;
        display: grid;
        place-items: center;
        width: 56px;
        height: 56px;
        border-radius: 10px;
        background: #141418;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
        // Lights up as each run comes in, on the runs' own clock.
        animation: hub-in 3.2s linear infinite;
    }

    // The runs' clock: the first reaches Kestra at 21% and its repository
    // at 48%; the second, half a turn behind, Kestra at 67% and its queue
    // at 94%.
    @keyframes hub-in {
        0%,
        16%,
        30%,
        62%,
        76%,
        100% {
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
        }

        21%,
        67% {
            box-shadow:
                0 0 0 1px rgba(255, 255, 255, 0.5),
                0 0 24px 2px rgba(255, 255, 255, 0.12);
        }
    }

    @keyframes lane-in {
        0%,
        12%,
        100% {
            border-color: rgba(255, 255, 255, 0.1);
        }

        4% {
            border-color: rgba(255, 255, 255, 0.4);
        }
    }

    .hub-label {
        position: absolute;
        top: 208px;
        left: 240px;
        width: 80px;
        text-align: center;
        font-size: 0.8125rem;
        color: var(--muted);
    }

    // A lane: one node, its name at the top and the backend in use under
    // it, the others waiting their turn.
    .lane {
        position: absolute;
        left: 400px;
        width: 160px;

        // The repository's node tops out with the first worker, the
        // queue's bottoms out with the last.
        &.repository {
            top: 80px;
        }

        &.queue {
            top: 196px;
        }
    }

    // The lane's name, small, in the top of its node.
    .lane .lane-title {
        position: absolute;
        top: 8px;
        left: 0.625rem;
        font-size: 0.75rem;
        line-height: 1;
        color: var(--faint);
    }

    .bar {
        position: relative;
        height: 64px;
        animation: lane-in 3.2s linear infinite;

        .repository & {
            animation-delay: calc(-3.2s + 0.44 * 3.2s);
        }

        .queue & {
            animation-delay: calc(-3.2s + 0.9 * 3.2s);
        }
    }

    .choice {
        position: absolute;
        top: 40px;
        left: 0.625rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #ffffff;
        opacity: 0;
        transform: translateY(calc(-50% + 6px));
        transition:
            opacity 0.4s ease,
            transform 0.4s ease;

        &.on,
        &:global(.on) {
            opacity: 1;
            transform: translateY(-50%);
        }

        // The logo straight on the node, no tile behind it.
        .logo {
            display: grid;
            place-items: center;
            width: 1.375rem;
            height: 1.375rem;
        }

        img {
            width: 1.375rem;
            height: 1.375rem;
            object-fit: contain;
        }

        // Kafka's mark is black: drawn in white on the dark node.
        &[data-option="kafka"] img {
            filter: invert(1);
        }

        :global(.java) {
            width: 1.125rem;
            height: 1.125rem;
            color: #e76f00;
        }
    }

    @keyframes pulse {
        50% {
            opacity: 0.3;
        }
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes ping {
        0% {
            opacity: 0.6;
            transform: scale(0.6);
        }

        100% {
            opacity: 0;
            transform: scale(1.6);
        }
    }

    @keyframes shake {
        0%,
        100% {
            transform: none;
        }

        25% {
            transform: translateX(-3px);
        }

        50% {
            transform: translateX(3px);
        }

        75% {
            transform: translateX(-2px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .glimpse :global(.spin),
        .live::after,
        .lines .flows path,
        .hub,
        .bar {
            animation: none;
        }
    }
</style>

<script>
    const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches

    // Runs `start` while the element is on screen and `stop` when it
    // leaves.
    function whileVisible(el: Element, start: () => void, stop: () => void) {
        new IntersectionObserver(([entry]) =>
            entry.isIntersecting ? start() : stop(),
        ).observe(el)
    }

    // A little story in the tenant, on a loop: the editor edits the flow,
    // the launcher runs it and it succeeds, then the admin deletes a
    // namespace. The row each of them works on lights up in their colour.
    function playTenants() {
        const stage = document.querySelector<HTMLElement>("[data-tenants]")
        if (!stage || reduced()) return
        const row = (name: string) =>
            stage.querySelector<HTMLElement>(`[data-row="${name}"]`)
        const person = (name: string) =>
            stage.querySelector<HTMLElement>(`[data-person="${name}"]`)
        const launcher = person("launcher")
        const editor = person("editor")
        const admin = person("admin")
        const flow = row("flow")
        const doomed = row("acme.network")
        if (!launcher || !editor || !admin || !flow || !doomed) return

        const at = new Map<HTMLElement, [HTMLElement, number]>()
        let lit: HTMLElement | undefined
        let timers: number[] = []

        // Onto a row, at a point across the stage, in the stage's own
        // pixels even when it is scaled. "foot" parks them under the rows.
        const go = (who: HTMLElement, name: string, lane: number) => {
            const target = name === "foot" ? stage : row(name)
            if (!target) return
            at.set(who, [target, lane])
            const box = stage.getBoundingClientRect()
            const rect = target.getBoundingClientRect()
            const scale = box.width / stage.offsetWidth || 1
            const width = stage.offsetWidth
            const x = Math.min(width * lane, width - who.offsetWidth)
            const y =
                target === stage
                    ? stage.offsetHeight - who.offsetHeight - 12
                    : (rect.top - box.top + rect.height * 0.55) / scale
            who.style.left = `${x}px`
            who.style.top = `${y}px`
            who.style.bottom = "auto"
        }

        // The row under someone lights up in their colour, or in red for
        // a deletion.
        const light = (who?: HTMLElement, tone?: string) => {
            lit?.classList.remove("hot")
            lit = who ? at.get(who)?.[0] : undefined
            if (!who || !lit || lit === stage) return
            lit.style.setProperty(
                "--tone",
                tone ?? getComputedStyle(who).getPropertyValue("--tone"),
            )
            lit.classList.add("hot")
        }

        const show = (target: HTMLElement, name = "") => {
            const state = target.querySelector<HTMLElement>("[data-row-state]")
            if (state) state.dataset.state = name
        }

        const rest = () => {
            go(launcher, "acme", 0.45)
            go(admin, "acme", 0.74)
            go(editor, "foot", 0.04)
        }

        // The one at work stands out; the others wait, dimmed.
        const people = [launcher, editor, admin]
        const focus = (who?: HTMLElement) =>
            people.forEach((person) =>
                person.classList.toggle("idle", !!who && person !== who),
            )

        const reset = () => {
            rest()
            focus()
            light()
            show(flow)
            show(doomed)
            doomed.classList.remove("gone")
            doomed.parentElement?.classList.remove("removed")
        }

        const STORY: [number, () => void][] = [
            [0, () => (focus(editor), go(editor, "flow", 0.5))],
            [1100, () => (light(editor), show(flow, "editing"))],
            [
                3200,
                () => (
                    focus(launcher),
                    go(editor, "foot", 0.04),
                    go(launcher, "flow", 0.5)
                ),
            ],
            [4300, () => (light(launcher), show(flow, "running"))],
            [6100, () => show(flow, "success")],
            [
                7800,
                () => (
                    focus(admin),
                    go(launcher, "acme", 0.45),
                    light(),
                    show(flow),
                    go(admin, "acme.network", 0.58)
                ),
            ],
            [
                8900,
                () => (
                    light(admin, "255, 122, 138"),
                    show(doomed, "deleted"),
                    doomed.classList.add("gone")
                ),
            ],
            // The row goes, the admin leaves, and it is back next turn.
            [
                10000,
                () => (light(), doomed.parentElement?.classList.add("removed")),
            ],
            [10700, () => go(admin, "acme", 0.74)],
            [12600, reset],
        ]
        const LOOP = 14400

        const play = () => {
            timers = STORY.map(([delay, beat]) =>
                window.setTimeout(beat, delay),
            )
            timers.push(window.setTimeout(play, LOOP))
        }

        // Everyone at rest at once, before the story starts.
        const snap = (move: () => void) => {
            stage.classList.add("placing")
            move()
            stage.getBoundingClientRect()
            stage.classList.remove("placing")
        }
        snap(rest)

        whileVisible(
            stage,
            () => (reset(), play()),
            () => (timers.forEach(window.clearTimeout), (timers = [])),
        )
        window.addEventListener("resize", () =>
            snap(() =>
                at.forEach(([target, lane], who) =>
                    go(who, target.dataset.row ?? "foot", lane),
                ),
            ),
        )
    }

    // The run plays from the start: each task draws its bar on a worker
    // and turns green. On post_ledger the worker goes down: the bar breaks
    // in red, a second attempt runs on another worker, and the run ends in
    // success with nothing lost. Then it starts over. It holds while off
    // screen.
    function playRouting() {
        const card = document.querySelector<HTMLElement>("[data-routing]")
        if (!card || reduced()) return
        const state = card.querySelector<HTMLElement>("[data-run-state]")
        const status = card.querySelector<HTMLElement>("[data-status]")
        const statusText = card.querySelector<HTMLElement>("[data-status-text]")
        const rows = [...card.querySelectorAll<HTMLElement>("[data-step]")]
        const bar = (row: HTMLElement) =>
            row.querySelector<HTMLElement>(".attempt")!

        let visible = false
        let waiters: (() => void)[] = []
        whileVisible(
            card,
            () => {
                visible = true
                waiters.splice(0).forEach((go) => go())
            },
            () => (visible = false),
        )
        const wait = async (ms: number) => {
            await new Promise((done) => setTimeout(done, ms))
            if (!visible) await new Promise<void>((go) => waiters.push(go))
        }

        const say = (text: string, tone = "") => {
            if (statusText) statusText.textContent = text
            status?.classList.toggle("warn", tone === "warn")
            status?.classList.toggle("ok", tone === "ok")
        }
        // Running while it goes, Success once it has.
        const time = card.querySelector<HTMLElement>("[data-run-time]")
        const total = time?.textContent ?? ""
        const setState = (running: boolean) => {
            state?.classList.toggle("is-running", running)
            state?.classList.toggle("is-success", !running)
            if (time) time.textContent = running ? "Running" : total
        }

        const reset = () => {
            rows.forEach((row) => {
                row.classList.remove("failed")
                bar(row).classList.remove("go", "done", "broken")
            })
            setState(true)
            say("Running on 3 workers")
        }

        const loop = async () => {
            for (;;) {
                // Back to the start without drawing back.
                rows.forEach((row) => (bar(row).style.transition = "none"))
                reset()
                void card.offsetWidth
                rows.forEach((row) => (bar(row).style.transition = ""))
                await wait(900)

                for (const row of rows) {
                    const step = bar(row)
                    step.classList.add("go")
                    const ms = parseFloat(step.style.getPropertyValue("--ms"))
                    if (row.dataset.step === "post_ledger") {
                        await wait(ms)
                        step.classList.add("broken")
                        row.classList.add("failed")
                        say(
                            "worker-2 down · retrying post_ledger on worker-3",
                            "warn",
                        )
                        await wait(1200)
                        continue
                    }
                    await wait(ms)
                    step.classList.add("done")
                    await wait(150)
                }

                setState(false)
                say("Success · 0 executions lost", "ok")
                await wait(3600)
            }
        }
        loop()
    }

    // The audit log as a stack: every few seconds a new event drops in on
    // top, the others move back and fade, the last one goes, and each event
    // is counted as it streams out to the SIEM.
    function playAudit() {
        const card = document.querySelector<HTMLElement>("[data-audit]")
        if (!card || reduced()) return
        const stack = card.querySelector<HTMLElement>("[data-stack]")
        const pool = card.querySelector<HTMLTemplateElement>("[data-pool]")
        const exported = card.querySelector<HTMLElement>("[data-exported]")
        if (!stack || !pool) return
        const queue = [...pool.content.querySelectorAll<HTMLElement>(".note")]
        let total = 1284
        let timer = 0

        const ago = (seconds: number) =>
            seconds < 60
                ? "just now"
                : seconds < 3600
                  ? `${Math.round(seconds / 60)} min ago`
                  : `${Math.round(seconds / 3600)} hours ago`

        const step = () => {
            stack.querySelectorAll<HTMLElement>(".note").forEach((note) => {
                const age = Number(note.dataset.age) + 150
                note.dataset.age = String(age)
                const date = note.querySelector(".date")
                if (date) date.textContent = ago(age)
            })
            const next = queue.shift()
            if (!next) return
            const note = next.cloneNode(true) as HTMLElement
            note.dataset.age = "0"
            const date = note.querySelector(".date")
            if (date) date.textContent = "just now"
            note.classList.add("enter")
            stack.insertBefore(note, stack.firstChild)
            void note.offsetWidth
            note.classList.remove("enter")
            // The one that leaves goes back to the end of the queue.
            const last = stack.children[4] as HTMLElement | undefined
            if (last)
                window.setTimeout(() => (last.remove(), queue.push(last)), 700)
            total++
            if (exported) exported.textContent = total.toLocaleString("en-US")
        }

        whileVisible(
            card,
            () => (timer = window.setInterval(step, 3000)),
            () => window.clearInterval(timer),
        )
    }

    // Each lane changes backend on its own, never both at once: each
    // switches as a run reaches it, every other run. The runs keep the
    // CSS clock of 3.2s, the repository's arriving at 48% of it and the
    // queue's at 94%.
    function playBackends() {
        const card = document.querySelector<HTMLElement>("[data-backends]")
        if (!card || reduced()) return
        const setups = JSON.parse(card.dataset.setups ?? "[]") as string[][]
        const columns = [...card.querySelectorAll<HTMLElement>("[data-column]")]
        const CLOCK = 3200
        const ARRIVALS = [0.48, 0.94]
        const turns = [0, 0]
        let timers: number[] = []

        const show = (col: number) => {
            turns[col] = (turns[col] + 1) % setups.length
            columns[col]
                .querySelectorAll<HTMLElement>("[data-option]")
                .forEach((option) =>
                    option.classList.toggle(
                        "on",
                        option.dataset.option === setups[turns[col]][col],
                    ),
                )
        }

        const start = () => {
            const now = Number(document.timeline.currentTime ?? 0)
            timers = ARRIVALS.flatMap((arrival, col) => {
                // Wait for this lane's next run, then every other one.
                const wait =
                    (((arrival * CLOCK - (now % CLOCK)) % CLOCK) + CLOCK) %
                    CLOCK
                let interval = 0
                const first = window.setTimeout(() => {
                    show(col)
                    interval = window.setInterval(() => show(col), 2 * CLOCK)
                    timers.push(interval)
                }, wait + CLOCK)
                return [first]
            })
        }

        whileVisible(card, start, () => {
            timers.forEach(
                (id) => (window.clearTimeout(id), window.clearInterval(id)),
            )
            timers = []
        })
    }

    // Workers shaking hands, one after the other: the trusted ones get in,
    // the unknown one is refused.
    function playHandshake() {
        const strip = document.querySelector<HTMLElement>("[data-handshake]")
        if (!strip || reduced()) return
        const workers = [
            ...strip.querySelectorAll<HTMLElement>('[data-worker="ok"]'),
        ]
        let timers: number[] = []

        const play = () => {
            workers.forEach((worker) => worker.classList.add("checking"))
            timers = workers.map((worker, idx) =>
                window.setTimeout(
                    () => {
                        worker.classList.remove("checking")
                    },
                    900 + idx * 1100,
                ),
            )
            timers.push(window.setTimeout(play, 12000))
        }

        whileVisible(strip, play, () => {
            timers.forEach(window.clearTimeout)
            timers = []
        })
    }

    // The unknown worker sends a run like the others; it is stopped
    // halfway, a cross appears, its link turns red and it shakes. Then it
    // tries again.
    function playIntruder() {
        const schema = document.querySelector<HTMLElement>("[data-intruder]")
        if (!schema || reduced()) return
        const jet = schema.querySelector<SVGPathElement>("[data-jet]")
        const worker = schema.querySelector<HTMLElement>(
            '[data-worker="refused"]',
        )
        if (!jet || !worker) return
        let timers: number[] = []

        const attempt = () => {
            schema.classList.remove("blocked")
            worker.classList.add("checking")
            timers = [
                window.setTimeout(() => {
                    const run = jet.animate(
                        [
                            { strokeDashoffset: 14, opacity: 1 },
                            { strokeDashoffset: -55, opacity: 1 },
                        ],
                        { duration: 900, easing: "ease-out", fill: "forwards" },
                    )
                    run.finished.then(() => {
                        schema.classList.add("blocked")
                        worker.classList.remove("checking", "shake")
                        void worker.offsetWidth
                        worker.classList.add("shake")
                        jet.animate([{ opacity: 1 }, { opacity: 0 }], {
                            duration: 400,
                            fill: "forwards",
                        })
                    })
                }, 1200),
                window.setTimeout(attempt, 6400),
            ]
        }

        whileVisible(schema, attempt, () => {
            timers.forEach(window.clearTimeout)
            timers = []
            schema.classList.add("blocked")
            worker.classList.remove("checking")
        })
    }

    // The head's layers: each label set flat out from its plate's right
    // corner, read from where the 3D puts the plate.
    function placeLabels() {
        const box = document.querySelector<HTMLElement>("[data-layers]")
        if (!box) return
        const plates = [...box.querySelectorAll<HTMLElement>("[data-plate]")]
        const labels = [...box.querySelectorAll<HTMLElement>("[data-label]")]
        // A label's line starts at its plate's right-hand handle, read
        // where the 3D puts it with the plate lifted.
        const place = (idx: number) => {
            const label = labels[idx]
            const handles = [...plates[idx].querySelectorAll(".handle")]
            if (!label || !handles.length) return
            const origin = box.getBoundingClientRect()
            const right = handles
                .map((handle) => handle.getBoundingClientRect())
                .reduce((a, b) => (b.right > a.right ? b : a))
            label.style.left = `${right.right - origin.left}px`
            label.style.top = `${right.top + right.height / 2 - origin.top}px`
            label.classList.add("placed")
        }
        new ResizeObserver(() => {
            const idx = plates.findIndex((plate) =>
                plate.classList.contains("active"),
            )
            if (idx >= 0) place(idx)
        }).observe(box)

        // One layer picked at a time: by the pointer, or in turn.
        const pick = (idx: number) => {
            const plate = plates[idx]
            if (plate.classList.contains("active")) return
            // Read where its handle will be once lifted, lifting it for a
            // moment without the transition, so the label shows at once.
            plates.forEach((other) => other.classList.remove("active"))
            plate.style.transition = "none"
            plate.classList.add("active")
            place(idx)
            plate.classList.remove("active")
            void plate.offsetWidth
            plate.style.transition = ""
            plates.forEach((plate, i) =>
                plate.classList.toggle("active", i === idx),
            )
            labels.forEach((label, i) =>
                label.classList.toggle("active", i === idx),
            )
        }
        let turn = 0
        let timer = 0
        const cycle = () => {
            window.clearInterval(timer)
            if (reduced()) return pick(plates.length - 1)
            pick(turn)
            timer = window.setInterval(() => {
                turn = (turn + 1) % plates.length
                pick(turn)
            }, 2600)
        }
        plates.forEach((plate, idx) => {
            plate.addEventListener("pointerenter", () => {
                window.clearInterval(timer)
                turn = idx
                pick(idx)
            })
        })
        box.addEventListener("pointerleave", cycle)
        whileVisible(box, cycle, () => window.clearInterval(timer))
    }

    placeLabels()
    playTenants()
    playRouting()
    playAudit()
    playBackends()
    playHandshake()
    playIntruder()
</script>
