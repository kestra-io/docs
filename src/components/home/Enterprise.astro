---
import { Icon } from "astro-icon/components"

// Four reasons, each under a glimpse of the product that proves it.
const FEATURES = [
    {
        id: "access",
        title: "Give every team secure access.",
        text: "Share one platform with isolated workflows, credentials, and execution environments.",
    },
    {
        id: "reliability",
        title: "Keep critical workflows running reliably.",
        text: "Support business continuity with worker groups, backup and restore, maintenance mode, and SLA-backed support.",
    },
    {
        id: "governance",
        title: "Verifiable governance",
        text: "Keep track of who ran each workflow, with which permissions, and approval chains with SSO, RBAC, audit logs, policies, and approval gates.",
    },
    {
        id: "scale",
        title: "Built for your scale and your network.",
        text: "Pick the backend that fits your load and scale. Make sure that only trusted workers can connect, wherever they run.",
    },
]

// The page each glimpse would sit on in Kestra.
const PAGES: Record<string, string> = {
    access: "Tenant",
    reliability: "Worker groups",
    governance: "Audit logs",
    scale: "Workers",
}

// The Infrastructure tenant, open on its namespaces and a flow.
const ROOT = "acme"
const NAMESPACES = [
    "acme.cloud",
    "acme.kubernetes",
    "acme.network",
    "acme.monitoring",
]
const FLOW = { parent: "acme.kubernetes", id: "scale_cluster" }
// The namespace the admin removes in the story.
const DELETED = "acme.network"
// Three roles: one edits the flow, one runs it, one deletes a namespace.
const PEOPLE = [
    { id: "launcher", name: "Launcher", icon: "mdi:play-circle-outline" },
    { id: "editor", name: "Editor", icon: "mdi:pencil" },
    { id: "admin", name: "Admin", icon: "mdi:shield-account-outline" },
]

// The queues the worker group serves, with the slots in use.
const QUEUES = [
    { name: "ml-training", mode: "Elastic 25%", used: 8, slots: 10 },
    { name: "Default", mode: "Shared", used: 4, slots: 24 },
]

// The audit log as the product lists it: what changed, how, by whom,
// one detail of it, and when. The first five show; the script streams the
// others in on top, newest first.
const AUDIT = [
    {
        type: "Execution",
        action: "Resumed",
        actor: "m.chen",
        detail: "approval:deploy_prod",
        age: 40,
    },
    {
        type: "Execution",
        action: "Created",
        actor: "s.roy",
        detail: "flowId:deploy_prod",
        age: 260,
    },
    {
        type: "Flow",
        action: "Updated",
        actor: "j.kim",
        detail: "revision:7",
        age: 900,
    },
    {
        type: "Role",
        action: "Created",
        actor: "admin",
        detail: "id:finance_viewer",
        age: 3600,
    },
    {
        type: "User",
        action: "Login",
        actor: "j.kim",
        detail: "resource:USER",
        age: 7400,
    },
    {
        type: "Secret",
        action: "Updated",
        actor: "m.chen",
        detail: "key:DB_PASSWORD",
        age: 0,
    },
    {
        type: "Namespace",
        action: "Updated",
        actor: "admin",
        detail: "id:acme.finance",
        age: 0,
    },
    {
        type: "Flow",
        action: "Created",
        actor: "agent-01",
        detail: "id:sync_crm",
        age: 0,
    },
    {
        type: "Binding",
        action: "Created",
        actor: "admin",
        detail: "role:editor",
        age: 0,
    },
]
const ago = (seconds: number) =>
    seconds < 60
        ? "just now"
        : seconds < 3600
          ? `${Math.round(seconds / 60)} min ago`
          : `${Math.round(seconds / 3600)} hours ago`

// As on the 2.0 page: workers prove who they are before they join.
const WORKERS = [
    { name: "worker-onprem-01", ok: true, tps: 12.4 },
    { name: "worker-euwest-02", ok: true, tps: 8.1 },
    { name: "unknown", ok: false, note: "Untrusted certificate" },
]
---

{
    /* Kestra Enterprise, on black after the AI block, on the page's hairline
    grid: the head with its two ways on, then four cells, each a glimpse of
    the product, drawn in lines and fading out, over its promise. */
}
<section
    class="enterprise surface-dark"
    aria-labelledby="enterprise"
    data-header-dark
>
    <div class="container-xl">
        <div class="grid">
            <header class="head">
                <div>
                    <h2 id="enterprise">
                        <span>Achieve more with</span>{" "}
                        <em>Kestra Enterprise.</em>
                    </h2>
                    <p>
                        Kestra Enterprise gives you the security, governance and
                        SLA-backed support to run orchestration across your
                        whole organization. Run it self-hosted, in your cloud or
                        air-gapped.
                    </p>
                </div>
                <div class="actions">
                    <a href="/enterprise" class="btn-solid">
                        Explore Enterprise
                    </a>
                    <a href="/demo" class="btn-ghost">Book a demo</a>
                </div>
            </header>

            <ul class="features">
                {
                    FEATURES.map((feature) => (
                        <li>
                            <div class="stage" aria-hidden="true">
                                <div class="glimpse" data-card={feature.id}>
                                    <p class="glimpse-head">
                                        {PAGES[feature.id]}
                                        {feature.id === "access" && (
                                            <span class="pill">
                                                <span class="dot" />
                                                Infrastructure
                                            </span>
                                        )}
                                    </p>
                                    {feature.id === "access" && (
                                        <div
                                            class="glimpse-body tenant"
                                            data-tenants
                                        >
                                            <ul class="ns-tree">
                                                <li>
                                                    <span data-row={ROOT}>
                                                        <Icon name="mdi:dots-grid" />
                                                        {ROOT}
                                                    </span>
                                                    <ul>
                                                        {NAMESPACES.map(
                                                            (namespace) => (
                                                                <li
                                                                    class:list={{
                                                                        doomed:
                                                                            namespace ===
                                                                            DELETED,
                                                                    }}
                                                                >
                                                                    <span
                                                                        data-row={
                                                                            namespace
                                                                        }
                                                                    >
                                                                        <Icon name="mdi:dots-grid" />
                                                                        {
                                                                            namespace
                                                                        }
                                                                        {namespace ===
                                                                            DELETED && (
                                                                            <span
                                                                                class="row-state"
                                                                                data-row-state
                                                                            >
                                                                                <span class="pill bad deleted">
                                                                                    <Icon name="mdi:delete-outline" />
                                                                                    Deleted
                                                                                </span>
                                                                            </span>
                                                                        )}
                                                                    </span>
                                                                    {namespace ===
                                                                        FLOW.parent && (
                                                                        <ul>
                                                                            <li>
                                                                                <span data-row="flow">
                                                                                    <Icon name="mdi:file-tree-outline" />
                                                                                    {
                                                                                        FLOW.id
                                                                                    }
                                                                                    <span
                                                                                        class="row-state"
                                                                                        data-row-state
                                                                                    >
                                                                                        <span class="pill editing">
                                                                                            <Icon name="mdi:pencil" />
                                                                                            Editing
                                                                                        </span>
                                                                                        <span class="pill run running">
                                                                                            <Icon
                                                                                                name="mdi:loading"
                                                                                                class="spin"
                                                                                            />
                                                                                            Running
                                                                                        </span>
                                                                                        <span class="pill ok success">
                                                                                            <Icon name="mdi:check-circle-outline" />
                                                                                            Success
                                                                                        </span>
                                                                                    </span>
                                                                                </span>
                                                                            </li>
                                                                        </ul>
                                                                    )}
                                                                </li>
                                                            ),
                                                        )}
                                                    </ul>
                                                </li>
                                            </ul>
                                            {PEOPLE.map((person) => (
                                                <span
                                                    class:list={[
                                                        "cursor",
                                                        person.id,
                                                    ]}
                                                    data-person={person.id}
                                                >
                                                    <svg viewBox="0 0 10 10">
                                                        <path d="M0 0 L10 4 L5.5 5.5 L4 10 Z" />
                                                    </svg>
                                                    <span class="who">
                                                        <Icon
                                                            name={person.icon}
                                                        />
                                                        {person.name}
                                                    </span>
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                    {feature.id === "reliability" && (
                                        <div
                                            class="glimpse-body routing"
                                            data-routing
                                        >
                                            <p class="group">
                                                <strong>gpu-a100</strong>
                                                <span class="tag">
                                                    Reserved
                                                </span>
                                                <span class="pill ok">
                                                    <span class="dot" />
                                                    Online
                                                </span>
                                            </p>
                                            <p class="stats">
                                                <span>
                                                    <b>8</b> workers online
                                                </span>
                                                <span>
                                                    <b data-tps>0.8</b> tasks/s
                                                </span>
                                            </p>
                                            {QUEUES.map((queue) => (
                                                <div
                                                    class="queue"
                                                    data-queue
                                                    data-slots={queue.slots}
                                                >
                                                    <p>
                                                        {queue.name}
                                                        <span class="tag">
                                                            {queue.mode}
                                                        </span>
                                                        <span class="ratio">
                                                            <span data-used>
                                                                {queue.used}
                                                            </span>
                                                            {` / ${queue.slots}`}
                                                        </span>
                                                    </p>
                                                    <span
                                                        class="meter"
                                                        style={`--fill: ${queue.used / queue.slots}`}
                                                    />
                                                </div>
                                            ))}
                                            <dl class="facts">
                                                <dt>Backup</dt>
                                                <dd data-backup>
                                                    <Icon
                                                        name="mdi:check-circle-outline"
                                                        class="done"
                                                    />
                                                    <Icon
                                                        name="mdi:loading"
                                                        class="spin"
                                                    />
                                                    <span data-backup-text>
                                                        Last successful 3m ago
                                                    </span>
                                                </dd>
                                                <dt>Maintenance mode</dt>
                                                <dd>
                                                    <span class="switch" />
                                                    Off
                                                </dd>
                                                <dt>SLA target</dt>
                                                <dd>99.99%</dd>
                                            </dl>
                                        </div>
                                    )}
                                    {feature.id === "governance" && (
                                        <div
                                            class="glimpse-body audit"
                                            data-audit
                                        >
                                            <p class="entry labels">
                                                <span>Resource</span>
                                                <span>Action</span>
                                                <span>Actor</span>
                                                <span>Details</span>
                                                <span>Date</span>
                                            </p>
                                            <div class="entries" data-entries>
                                                {AUDIT.slice(0, 5).map(
                                                    (line) => (
                                                        <p
                                                            class="entry"
                                                            data-age={line.age}
                                                        >
                                                            <span class="type">
                                                                {line.type}
                                                            </span>
                                                            <span class="action">
                                                                {line.action}
                                                            </span>
                                                            <strong class="actor">
                                                                {line.actor}
                                                            </strong>
                                                            <span class="detail">
                                                                <span class="tag">
                                                                    {
                                                                        line.detail
                                                                    }
                                                                </span>
                                                            </span>
                                                            <span class="date">
                                                                {ago(line.age)}
                                                            </span>
                                                        </p>
                                                    ),
                                                )}
                                            </div>
                                            <template data-pool>
                                                {AUDIT.slice(5).map((line) => (
                                                    <p
                                                        class="entry"
                                                        data-age="0"
                                                    >
                                                        <span class="type">
                                                            {line.type}
                                                        </span>
                                                        <span class="action">
                                                            {line.action}
                                                        </span>
                                                        <strong class="actor">
                                                            {line.actor}
                                                        </strong>
                                                        <span class="detail">
                                                            <span class="tag">
                                                                {line.detail}
                                                            </span>
                                                        </span>
                                                        <span class="date">
                                                            just now
                                                        </span>
                                                    </p>
                                                ))}
                                            </template>
                                            <p class="stream">
                                                <span class="live" />
                                                Streaming to Splunk & Syslog
                                                over TLS
                                                <span class="count">
                                                    <span data-exported>
                                                        1,284
                                                    </span>{" "}
                                                    events
                                                </span>
                                            </p>
                                        </div>
                                    )}
                                    {feature.id === "scale" && (
                                        <div
                                            class="glimpse-body handshake"
                                            data-handshake
                                        >
                                            <p class="labels">
                                                <span>Worker</span>
                                                <span class="tps">
                                                    Throughput
                                                </span>
                                                <span class="status">
                                                    Status
                                                </span>
                                            </p>
                                            {WORKERS.map((worker) => (
                                                <p
                                                    class:list={[
                                                        "worker",
                                                        { refused: !worker.ok },
                                                    ]}
                                                    data-worker={
                                                        worker.ok
                                                            ? "ok"
                                                            : "refused"
                                                    }
                                                >
                                                    <Icon
                                                        name={
                                                            worker.ok
                                                                ? "mdi:server-outline"
                                                                : "mdi:alert-outline"
                                                        }
                                                    />
                                                    <span class="name">
                                                        {worker.name}
                                                        {worker.note && (
                                                            <small>
                                                                {worker.note}
                                                            </small>
                                                        )}
                                                    </span>
                                                    {worker.ok && (
                                                        <span class="tps">
                                                            <span
                                                                data-worker-tps
                                                            >
                                                                {worker.tps?.toFixed(
                                                                    1,
                                                                )}
                                                            </span>
                                                            k tasks/s
                                                        </span>
                                                    )}
                                                    <span
                                                        class:list={[
                                                            "pill",
                                                            worker.ok
                                                                ? "ok"
                                                                : "bad",
                                                        ]}
                                                        data-verdict
                                                    >
                                                        {worker.ok
                                                            ? "Verified"
                                                            : "Refused"}
                                                    </span>
                                                </p>
                                            ))}
                                            <dl class="facts">
                                                <dt>Tunnel</dt>
                                                <dd>
                                                    <Icon
                                                        name="mdi:shield-check-outline"
                                                        class="secure"
                                                    />
                                                    mTLS active
                                                </dd>
                                                <dt>Backends</dt>
                                                <dd>PostgreSQL · Kafka</dd>
                                                <dt>Throughput</dt>
                                                <dd>
                                                    <b data-total>20.5k</b>{" "}
                                                    tasks/s
                                                </dd>
                                            </dl>
                                        </div>
                                    )}
                                </div>
                            </div>
                            <div class="copy">
                                <h3>{feature.title}</h3>
                                <p class="text">{feature.text}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    // A lifted black, a shade apart from the AI block above, so the two
    // read as one dark run with a step between them. It stays dark in both
    // themes.
    .enterprise {
        --bg: #0d0d10;
        --rule-color: rgba(255, 255, 255, 0.08);
        --rule: 1px solid var(--rule-color);
        --text: #ffffff;
        --muted: #9a9aa8;
        --faint: #5c5c68;

        position: relative;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);

        // The rule between the AI block and this one, brighter in the
        // middle, like the edge of polished metal catching the light.
        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(
                90deg,
                var(--rule-color) 0%,
                rgba(255, 255, 255, 0.4) 50%,
                var(--rule-color) 100%
            );
            pointer-events: none;
        }
    }

    // The hairline grid, in white on black: rails on both sides, on the AI
    // block's lines, and full-width rules around the four cells.
    .grid {
        --inset: clamp(1.5rem, 4vw, 3.5rem);

        position: relative;
        border-left: var(--rule);
        border-right: var(--rule);
    }

    // The title and copy on the left, the two ways on the right.
    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem 3rem;
        padding: 8.5rem var(--inset) 4rem;

        @include media-breakpoint-down(md) {
            padding-block: 4.5rem 3rem;
        }

        h2 {
            margin: 0;
            font-size: clamp(2rem, 3.6vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: var(--text);

            // The lead-in in grey, so Kestra Enterprise stands out, as in
            // the AI block's title.
            span {
                color: #a9a9b8;
            }

            // The name in brushed silver.
            em {
                font-style: normal;
                background: linear-gradient(
                    180deg,
                    #ffffff 0%,
                    #e4e4ec 45%,
                    #9d9daf 100%
                );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }
        }

        p {
            max-width: 44rem;
            margin: 1.25rem 0 0;
            font-size: 1.125rem;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.6);
            text-wrap: pretty;
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    // Four cells, two by two, between full-width rules: in each, the
    // glimpse of the product above its promise.
    .features {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
        border-block: var(--rule);

        &::before,
        &::after {
            content: "";
            position: absolute;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--rule-color);
            pointer-events: none;
        }

        &::before {
            top: -1px;
        }

        &::after {
            bottom: -1px;
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: minmax(0, 1fr);
        }

        > li {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            padding: 0 0 clamp(3rem, 5vw, 4rem) var(--inset);
            overflow: hidden;
            transition: background-color 0.3s ease;

            &:nth-child(even) {
                border-left: var(--rule);
            }

            &:nth-child(n + 3) {
                border-top: var(--rule);
            }

            &:hover {
                background: rgba(255, 255, 255, 0.015);
            }

            @include media-breakpoint-down(md) {
                &:nth-child(even) {
                    border-left: 0;
                }

                & + li {
                    border-top: var(--rule);
                }
            }
        }

        h3 {
            margin: 0 0 0.5rem;
            font-size: 1.125rem;
            font-weight: 500;
            line-height: 1.35;
            color: var(--text);
        }

        .text {
            max-width: 30rem;
            margin: 0;
            font-size: 1rem;
            line-height: 1.6;
            color: var(--muted);
        }
    }

    .copy {
        padding-right: var(--inset);
    }

    // The glimpse's stage, above the copy.
    .stage {
        padding-top: clamp(2.5rem, 4vw, 3.5rem);
    }

    .glimpse {
        // Fits the cell, short of its right rule, as the copy does, and
        // all four are the same height.
        display: flex;
        flex-direction: column;
        width: calc(100% - var(--inset));
        height: 23.5rem;
        overflow: hidden;

        // A little taller on a phone, where some lines wrap.
        @include media-breakpoint-down(md) {
            height: 25rem;
        }
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 0.75rem;
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.035) 0%,
            rgba(255, 255, 255, 0.012) 60%
        );
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.05),
            0 30px 60px -30px rgba(0, 0, 0, 0.9);
        font-size: 0.9375rem;
        color: #c9c9d2;

        p {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
        }

        :global(svg) {
            flex: none;
            width: 1rem;
            height: 1rem;
            color: var(--faint);
        }

        :global(.spin) {
            animation: spin 1s linear infinite;
        }
    }

    .glimpse-head {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 1rem;
        color: #ededf1;

        .pill {
            margin-left: 0.5rem;
        }
    }

    // The content runs the card's full width.
    .glimpse-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.125rem 1.25rem 1.5rem;
    }

    // Labels and states in thin pills, colour only in the state's text.
    .pill,
    .tag {
        display: inline-flex;
        align-items: center;
        gap: 0.3125rem;
        padding: 0.0625rem 0.5rem;
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.03);
        font-size: 0.8125rem;
        font-weight: 500;
        line-height: 1.5;
        white-space: nowrap;
        color: #c9c9d2;

        :global(svg) {
            width: 0.875rem;
            height: 0.875rem;
            color: currentColor;
        }

        .dot {
            width: 0.375rem;
            height: 0.375rem;
            border-radius: 50%;
            background: currentColor;
        }
    }

    .tag {
        padding-inline: 0.4375rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        color: var(--muted);
    }

    .pill {
        transition:
            color 0.3s ease,
            border-color 0.3s ease;

        &.ok {
            color: #4cc38a;
        }

        &.bad {
            color: #ff7a8a;
        }

        &.run {
            color: #b796ff;
        }

        &.wait {
            color: #e8b45a;
        }
    }

    // The tenant: its tree, and the people at work in it.
    // It fills the card, so the editor's spot at the foot holds while a
    // row folds away.
    .tenant {
        position: relative;
        flex: 1;
    }

    // A row's state as the story goes: the flow edited, run and done, the
    // namespace deleted. One pill at a time, set by the script; none at
    // rest.
    .row-state {
        display: grid;
        margin-left: auto;

        .pill {
            grid-area: 1 / 1;
            justify-self: end;
            opacity: 0;
            transform: translateY(2px);
            transition:
                opacity 0.3s ease,
                transform 0.3s ease;
        }

        &[data-state="editing"] .editing,
        &[data-state="running"] .running,
        &[data-state="success"] .success,
        &[data-state="deleted"] .deleted {
            opacity: 1;
            transform: none;
        }
    }

    // Hairline branches, as in the illustration.
    .ns-tree {
        margin: 0;
        padding: 0;
        list-style: none;
        color: var(--muted);

        ul {
            margin: 0 0 0 0.4375rem;
            padding: 0;
            list-style: none;
        }

        // The root has no branch into it.
        > li {
            padding-left: 0;

            &::before {
                display: none;
            }
        }

        li {
            position: relative;
            padding-left: 0.875rem;

            // The namespace the admin deletes folds away, and back.
            &.doomed {
                max-height: 2.25rem;
                overflow: hidden;
                transition:
                    max-height 0.5s ease,
                    opacity 0.4s ease;

                &:global(.removed) {
                    max-height: 0;
                    opacity: 0;
                }
            }

            // The branch to this item, from the line on its left.
            &::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 0.625rem;
                height: 1.0625rem;
                border-left: 1px solid rgba(255, 255, 255, 0.14);
                border-bottom: 1px solid rgba(255, 255, 255, 0.14);
            }

            // The line goes on down to the next sibling.
            &:not(:last-child)::after {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                border-left: 1px solid rgba(255, 255, 255, 0.14);
            }
        }

        // A row lights up, in the person's colour, while they are on it.
        [data-row] {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            margin-left: -0.375rem;
            padding: 0 0.375rem;
            border: 1px solid transparent;
            border-radius: 0.375rem;
            line-height: 2.125rem;
            transition:
                background-color 0.4s ease,
                border-color 0.4s ease,
                color 0.4s ease;

            // Struck through once deleted, until the story starts again.
            &:global(.gone) {
                text-decoration: line-through;
                opacity: 0.55;
            }

            &:global(.hot) {
                border-color: rgba(var(--tone), 0.25);
                background: rgba(var(--tone), 0.06);
                color: rgb(var(--tone));

                :global(svg) {
                    color: currentColor;
                }
            }
        }

        :global(svg) {
            width: 0.875rem;
            height: 0.875rem;
        }
    }

    // A pointer with its person's chip, each in their own colour. The
    // script glides them from row to row; without it they rest where they
    // are placed here.
    .cursor {
        --tone: 240, 140, 190;

        position: absolute;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.125rem;
        transition:
            left 1.1s cubic-bezier(0.65, 0, 0.35, 1),
            top 1.1s cubic-bezier(0.65, 0, 0.35, 1);

        :global(.placing) & {
            transition: none;
        }

        svg {
            width: 0.75rem;
            height: 0.75rem;
            fill: rgb(var(--tone));
        }

        &.launcher {
            top: 1.25rem;
            left: 45%;
        }

        &.editor {
            --tone: 120, 214, 170;

            bottom: 0.5rem;
            left: 6%;
        }

        &.admin {
            --tone: 140, 196, 255;

            top: 3.5rem;
            left: 72%;
        }
    }

    .who {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-left: 0.5rem;
        padding: 0.0625rem 0.4375rem;
        border: 1px solid rgba(var(--tone), 0.45);
        border-radius: 0.375rem;
        background: rgba(20, 20, 24, 0.6);
        backdrop-filter: blur(4px);
        font-size: 0.8125rem;
        font-weight: 500;
        white-space: nowrap;
        color: rgb(var(--tone));

        :global(svg) {
            width: 0.8125rem;
            height: 0.8125rem;
            color: currentColor;
        }
    }

    // A worker group as the product shows it: its name and label, the
    // workers online, each queue it serves with its live capacity meter,
    // then its continuity settings.
    .routing {
        .group {
            strong {
                font-weight: 500;
                color: #ffffff;
            }

            .pill {
                margin-left: auto;
            }
        }

        .stats {
            gap: 1.25rem;
            color: var(--muted);

            b {
                margin-right: 0.125rem;
                font-size: 1.125rem;
                font-weight: 500;
                font-variant-numeric: tabular-nums;
                color: #ffffff;
            }
        }

        .queue {
            display: flex;
            flex-direction: column;
            gap: 0.375rem;

            p {
                color: #e6e6ea;
            }
        }

        .ratio {
            margin-left: auto;
            font-size: 0.875rem;
            font-variant-numeric: tabular-nums;
            color: var(--muted);
        }

        // Segments over the green-to-red scale; what is free is dimmed,
        // and the dim part slides as the load moves.
        .meter {
            position: relative;
            display: block;
            height: 0.4375rem;
            background: linear-gradient(90deg, #5fb98a, #d9a96b 55%, #e8846f);
            -webkit-mask: repeating-linear-gradient(
                90deg,
                #000 0 3px,
                transparent 3px 5px
            );
            mask: repeating-linear-gradient(
                90deg,
                #000 0 3px,
                transparent 3px 5px
            );

            &::after {
                content: "";
                position: absolute;
                top: 0;
                right: 0;
                bottom: 0;
                width: calc((1 - var(--fill)) * 100%);
                background: rgba(28, 28, 33, 0.8);
                transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
            }
        }
    }

    // Settings and figures as a two-column list under a hairline.
    .facts {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1.5rem;
        // Held at the card's foot, under the rows.
        margin: auto 0 0;
        padding-top: 0.875rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 0.875rem;

        dt {
            font-weight: 400;
            color: var(--muted);
        }

        dd {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            margin: 0;
            color: #e6e6ea;

            b {
                font-weight: 500;
                font-variant-numeric: tabular-nums;
            }
        }

        :global(.done),
        :global(.secure) {
            color: #4cc38a;
        }

        // The backup's check, or its spinner while it runs.
        [data-backup] :global(.spin) {
            display: none;
        }

        [data-backup]:global(.busy) {
            :global(.spin) {
                display: block;
            }

            :global(.done) {
                display: none;
            }
        }
    }

    // A switch, off.
    .switch {
        position: relative;
        width: 1.75rem;
        height: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 1rem;

        &::after {
            content: "";
            position: absolute;
            top: 0.125rem;
            left: 0.125rem;
            width: 0.625rem;
            height: 0.625rem;
            border-radius: 50%;
            background: var(--muted);
        }
    }

    // The audit log as a table: column labels, then rows of what
    // changed, by whom and when. New rows slide in on top.
    .audit {
        gap: 0;

        .entry {
            display: grid;
            grid-template-columns: 5.25rem 4.25rem 4.5rem minmax(0, 1fr) 5.5rem;
            align-items: center;
            gap: 0.75rem;
            height: 2.375rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            font-size: 0.875rem;
            white-space: nowrap;
        }

        .labels {
            height: 1.75rem;
            border-color: rgba(255, 255, 255, 0.06);
            font-size: 0.75rem;
            color: var(--faint);
        }

        .entries {
            height: calc(5 * 2.375rem);
            overflow: hidden;
        }

        // A new row opens its space and fades in.
        .entry:global(.arriving) {
            animation: arrive 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .type {
            color: #e6e6ea;
        }

        .action {
            color: var(--muted);
        }

        .actor {
            overflow: hidden;
            font-weight: 500;
            text-overflow: ellipsis;
            color: #ffffff;
        }

        .detail {
            overflow: hidden;
            min-width: 0;
        }

        .date {
            text-align: right;
            font-variant-numeric: tabular-nums;
            color: var(--faint);
        }

        .stream {
            margin-top: auto;
            padding-top: 0.875rem;
            font-size: 0.875rem;
            color: var(--muted);
        }

        .count {
            margin-left: auto;
            font-variant-numeric: tabular-nums;
            color: var(--faint);
        }
    }

    @keyframes arrive {
        from {
            height: 0;
            opacity: 0;
        }

        to {
            height: 2.375rem;
            opacity: 1;
        }
    }

    // The log's live dot.
    .live {
        position: relative;
        width: 0.4375rem;
        height: 0.4375rem;
        border-radius: 50%;
        background: #4cc38a;

        &::after {
            content: "";
            position: absolute;
            inset: -0.25rem;
            border-radius: 50%;
            border: 1px solid #4cc38a;
            opacity: 0;
            animation: ping 2s ease-out infinite;
        }
    }

    // Workers shaking hands: each is checked, the trusted ones get in with
    // their live throughput, the unknown one is turned back.
    .handshake {
        gap: 0;

        // Column labels, as on the audit log.
        .labels {
            gap: 0.625rem;
            height: 1.75rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            font-size: 0.75rem;
            color: var(--faint);

            .tps {
                font-size: inherit;
                color: inherit;
            }

            .status {
                min-width: 5.5rem;
                text-align: center;
            }
        }

        // Rows like the audit log's, one worker each.
        .worker {
            gap: 0.625rem;
            min-height: 2.875rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            color: #e6e6ea;
            transition: opacity 0.4s ease;

            &.refused {
                color: var(--muted);

                :global(svg) {
                    color: #ff7a8a;
                }
            }

            &:global(.shake) .pill {
                animation: shake 0.45s ease;
            }
        }

        .name {
            display: flex;
            flex-direction: column;
            line-height: 1.3;

            small {
                font-size: 0.75rem;
                color: var(--faint);
            }
        }

        .tps {
            margin-left: auto;
            font-size: 0.875rem;
            font-variant-numeric: tabular-nums;
            color: var(--muted);
        }

        .pill {
            min-width: 5.5rem;
            justify-content: center;
        }

        .refused .pill {
            margin-left: auto;
        }

        // While a worker is checked: a neutral pill and no figures yet.
        [data-worker]:global(.checking) {
            .pill {
                color: var(--muted);
            }

            .tps {
                opacity: 0.3;
            }
        }
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes ping {
        0% {
            opacity: 0.6;
            transform: scale(0.6);
        }

        100% {
            opacity: 0;
            transform: scale(1.6);
        }
    }

    @keyframes shake {
        0%,
        100% {
            transform: none;
        }

        25% {
            transform: translateX(-3px);
        }

        50% {
            transform: translateX(3px);
        }

        75% {
            transform: translateX(-2px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .glimpse :global(.spin),
        .live::after {
            animation: none;
        }
    }
</style>

<script>
    const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches

    // Runs `start` while the element is on screen and `stop` when it
    // leaves.
    function whileVisible(el: Element, start: () => void, stop: () => void) {
        new IntersectionObserver(([entry]) =>
            entry.isIntersecting ? start() : stop(),
        ).observe(el)
    }

    // A little story in the tenant, on a loop: the editor edits the flow,
    // the launcher runs it and it succeeds, then the admin deletes a
    // namespace. The row each of them works on lights up in their colour.
    function playTenants() {
        const stage = document.querySelector<HTMLElement>("[data-tenants]")
        if (!stage || reduced()) return
        const row = (name: string) =>
            stage.querySelector<HTMLElement>(`[data-row="${name}"]`)
        const person = (name: string) =>
            stage.querySelector<HTMLElement>(`[data-person="${name}"]`)
        const launcher = person("launcher")
        const editor = person("editor")
        const admin = person("admin")
        const flow = row("flow")
        const doomed = row("acme.network")
        if (!launcher || !editor || !admin || !flow || !doomed) return

        const at = new Map<HTMLElement, [HTMLElement, number]>()
        let lit: HTMLElement | undefined
        let timers: number[] = []

        // Onto a row, at a point across the stage, in the stage's own
        // pixels even when it is scaled. "foot" parks them under the rows.
        const go = (who: HTMLElement, name: string, lane: number) => {
            const target = name === "foot" ? stage : row(name)
            if (!target) return
            at.set(who, [target, lane])
            const box = stage.getBoundingClientRect()
            const rect = target.getBoundingClientRect()
            const scale = box.width / stage.offsetWidth || 1
            const width = stage.offsetWidth
            const x = Math.min(width * lane, width - who.offsetWidth)
            const y =
                target === stage
                    ? stage.offsetHeight - who.offsetHeight - 12
                    : (rect.top - box.top + rect.height * 0.55) / scale
            who.style.left = `${x}px`
            who.style.top = `${y}px`
            who.style.bottom = "auto"
        }

        // The row under someone lights up in their colour, or in red for
        // a deletion.
        const light = (who?: HTMLElement, tone?: string) => {
            lit?.classList.remove("hot")
            lit = who ? at.get(who)?.[0] : undefined
            if (!who || !lit || lit === stage) return
            lit.style.setProperty(
                "--tone",
                tone ?? getComputedStyle(who).getPropertyValue("--tone"),
            )
            lit.classList.add("hot")
        }

        const show = (target: HTMLElement, name = "") => {
            const state = target.querySelector<HTMLElement>("[data-row-state]")
            if (state) state.dataset.state = name
        }

        const rest = () => {
            go(launcher, "acme", 0.45)
            go(admin, "acme.cloud", 0.72)
            go(editor, "foot", 0.04)
        }

        const reset = () => {
            rest()
            light()
            show(flow)
            show(doomed)
            doomed.classList.remove("gone")
            doomed.parentElement?.classList.remove("removed")
        }

        const STORY: [number, () => void][] = [
            [0, () => go(editor, "flow", 0.5)],
            [1100, () => (light(editor), show(flow, "editing"))],
            [3200, () => (go(editor, "foot", 0.04), go(launcher, "flow", 0.5))],
            [4300, () => (light(launcher), show(flow, "running"))],
            [6100, () => show(flow, "success")],
            [
                7800,
                () => (
                    go(launcher, "acme", 0.45),
                    light(),
                    show(flow),
                    go(admin, "acme.network", 0.58)
                ),
            ],
            [
                8900,
                () => (
                    light(admin, "255, 122, 138"),
                    show(doomed, "deleted"),
                    doomed.classList.add("gone")
                ),
            ],
            // The row goes, the admin leaves, and it is back next turn.
            [
                10000,
                () => (light(), doomed.parentElement?.classList.add("removed")),
            ],
            [10700, () => go(admin, "acme.cloud", 0.72)],
            [12600, reset],
        ]
        const LOOP = 14400

        const play = () => {
            timers = STORY.map(([delay, beat]) =>
                window.setTimeout(beat, delay),
            )
            timers.push(window.setTimeout(play, LOOP))
        }

        // Everyone at rest at once, before the story starts.
        const snap = (move: () => void) => {
            stage.classList.add("placing")
            move()
            stage.getBoundingClientRect()
            stage.classList.remove("placing")
        }
        snap(rest)

        whileVisible(
            stage,
            () => (reset(), play()),
            () => (timers.forEach(window.clearTimeout), (timers = [])),
        )
        window.addEventListener("resize", () =>
            snap(() =>
                at.forEach(([target, lane], who) =>
                    go(who, target.dataset.row ?? "foot", lane),
                ),
            ),
        )
    }

    // The worker group at work: the load on each queue and the tasks per
    // second move, and now and then a backup runs and completes.
    function playRouting() {
        const card = document.querySelector<HTMLElement>("[data-routing]")
        if (!card || reduced()) return
        const tps = card.querySelector<HTMLElement>("[data-tps]")
        const queues = [...card.querySelectorAll<HTMLElement>("[data-queue]")]
        const backup = card.querySelector<HTMLElement>("[data-backup]")
        const backupText = card.querySelector<HTMLElement>("[data-backup-text]")
        let tick = 0
        let timer = 0

        const step = () => {
            tick++
            queues.forEach((queue) => {
                const slots = Number(queue.dataset.slots)
                const used = queue.querySelector<HTMLElement>("[data-used]")
                const meter = queue.querySelector<HTMLElement>(".meter")
                if (!used || !meter) return
                const now = Number(used.textContent)
                const next = Math.max(
                    Math.round(slots * 0.15),
                    Math.min(slots, now + Math.round(Math.random() * 2 - 1)),
                )
                used.textContent = String(next)
                meter.style.setProperty("--fill", String(next / slots))
            })
            if (tps) tps.textContent = (0.6 + Math.random() * 0.7).toFixed(1)
            // A backup every so often: running, then done just now.
            if (backup && backupText && tick % 8 === 0) {
                backup.classList.add("busy")
                backupText.textContent = "Backing up…"
                window.setTimeout(() => {
                    backup.classList.remove("busy")
                    backupText.textContent = "Last successful just now"
                }, 2400)
            }
        }

        whileVisible(
            card,
            () => (timer = window.setInterval(step, 1500)),
            () => window.clearInterval(timer),
        )
    }

    // The audit log streams: a new event slides in on top every few
    // seconds, the oldest drops off the foot, every row's date ages, and
    // each event is counted as it goes out to the SIEM.
    function playAudit() {
        const card = document.querySelector<HTMLElement>("[data-audit]")
        if (!card || reduced()) return
        const list = card.querySelector<HTMLElement>("[data-entries]")
        const pool = card.querySelector<HTMLTemplateElement>("[data-pool]")
        const exported = card.querySelector<HTMLElement>("[data-exported]")
        if (!list || !pool) return
        // The waiting events, and the ones that dropped off, in turn.
        const queue = [...pool.content.querySelectorAll<HTMLElement>(".entry")]
        let total = 1284
        let timer = 0

        const ago = (seconds: number) =>
            seconds < 60
                ? "just now"
                : seconds < 3600
                  ? `${Math.round(seconds / 60)} min ago`
                  : `${Math.round(seconds / 3600)} hours ago`

        const step = () => {
            // Time moves on for the rows already there.
            list.querySelectorAll<HTMLElement>(".entry").forEach((row) => {
                const age = Number(row.dataset.age) + 150
                row.dataset.age = String(age)
                const date = row.querySelector(".date")
                if (date) date.textContent = ago(age)
            })
            const next = queue.shift()
            if (!next) return
            const row = next.cloneNode(true) as HTMLElement
            row.dataset.age = "0"
            row.querySelector(".date")!.textContent = "just now"
            row.classList.add("arriving")
            list.prepend(row)
            const last = list.lastElementChild as HTMLElement | null
            if (last && list.children.length > 5) {
                last.remove()
                queue.push(last)
            }
            total++
            if (exported) exported.textContent = total.toLocaleString("en-US")
        }

        whileVisible(
            card,
            () => (timer = window.setInterval(step, 2600)),
            () => window.clearInterval(timer),
        )
    }

    // Workers shaking hands, one after the other: the trusted ones are
    // verified and start to carry tasks, the unknown one is refused. Their
    // throughput then moves, and the total with it.
    function playHandshake() {
        const card = document.querySelector<HTMLElement>("[data-handshake]")
        if (!card || reduced()) return
        const workers = [...card.querySelectorAll<HTMLElement>("[data-worker]")]
        const total = card.querySelector<HTMLElement>("[data-total]")
        let timers: number[] = []
        let ticker = 0

        const verdict = (worker: HTMLElement) =>
            worker.querySelector<HTMLElement>("[data-verdict]")

        const sum = () => {
            if (!total) return
            const values = [
                ...card.querySelectorAll<HTMLElement>("[data-worker-tps]"),
            ]
                .filter((el) => !el.closest(".checking"))
                .map((el) => Number(el.textContent))
            total.textContent = `${values.reduce((a, b) => a + b, 0).toFixed(1)}k`
        }

        const play = () => {
            workers.forEach((worker) => {
                worker.classList.add("checking")
                const pill = verdict(worker)
                if (pill) pill.textContent = "Verifying…"
            })
            sum()
            timers = workers.map((worker, idx) =>
                window.setTimeout(
                    () => {
                        const ok = worker.dataset.worker === "ok"
                        const pill = verdict(worker)
                        worker.classList.remove("checking")
                        if (pill) pill.textContent = ok ? "Verified" : "Refused"
                        if (!ok) {
                            worker.classList.remove("shake")
                            void worker.offsetWidth
                            worker.classList.add("shake")
                        }
                        sum()
                    },
                    900 + idx * 1100,
                ),
            )
            timers.push(window.setTimeout(play, 16000))
        }

        const tick = () => {
            card.querySelectorAll<HTMLElement>("[data-worker-tps]").forEach(
                (el) => {
                    if (el.closest(".checking")) return
                    const now = Number(el.textContent)
                    el.textContent = Math.max(
                        4,
                        now + (Math.random() - 0.5) * 0.8,
                    ).toFixed(1)
                },
            )
            sum()
        }

        whileVisible(
            card,
            () => (play(), (ticker = window.setInterval(tick, 1300))),
            () => (
                timers.forEach(window.clearTimeout),
                (timers = []),
                window.clearInterval(ticker)
            ),
        )
    }

    playTenants()
    playRouting()
    playAudit()
    playHandshake()
</script>
