---
import { Image } from "astro:assets"
import nicolas from "./assets/investors/nicolas-dessaigne.png"
import olivier from "./assets/investors/olivier-pomel.png"
import tristan from "./assets/investors/tristan-handy.png"
import michel from "./assets/investors/michel-tricot.png"
import frederic from "./assets/investors/frederic-plais.png"
import clement from "./assets/investors/clement-delangue.png"
import bertrand from "./assets/investors/bertrand-diard.png"
import pierre from "./assets/investors/pierre-burgy.png"
import stijn from "./assets/investors/stijn-christiaens.png"
import rtpGlobal from "~/assets/teams/rtpglobal.svg?raw"
import alven from "~/assets/teams/alven-new.svg?raw"
import isai from "~/assets/teams/isai-new.svg?raw"
import axeleo from "~/assets/teams/axeleo-new.svg?raw"
import bpifrance from "~/assets/teams/bpifrance.svg?raw"
import hautsDeFrance from "~/assets/teams/hauts-de-france.svg?raw"
import bnpParibas from "~/assets/teams/bnp-paribas.svg?raw"
import cic from "~/assets/teams/cic.svg?raw"
import caisseEpargne from "~/assets/teams/caisse-epargne.svg?raw"

// `height` sets a logo's own height when its drawing needs more than the row's.
type Backer = { name: string; svg: string; href?: string; height?: number }

const INVESTORS: Backer[] = [
    { name: "RTP Global", svg: rtpGlobal, href: "https://rtp.vc" },
    { name: "Alven", svg: alven, href: "https://www.alven.co" },
    { name: "Isai", svg: isai, href: "https://isai.vc" },
    { name: "Axeleo Capital", svg: axeleo, href: "https://www.axc.vc" },
]

const FOUNDERS = [
    {
        name: "Olivier Pomel",
        role: "Co-founder and CEO, Datadog",
        photo: olivier,
    },
    {
        name: "Clément Delangue",
        role: "Co-founder and CEO, Hugging Face",
        photo: clement,
    },
    { name: "Nicolas Dessaigne", role: "Co-founder, Algolia", photo: nicolas },
    {
        name: "Tristan Handy",
        role: "Founder and CEO, dbt Labs",
        photo: tristan,
    },
    {
        name: "Michel Tricot",
        role: "Co-founder and CEO, Airbyte",
        photo: michel,
    },
    { name: "Bertrand Diard", role: "Co-founder, Talend", photo: bertrand },
    {
        name: "Frédéric Plais",
        role: "Co-founder, Platform.sh",
        photo: frederic,
    },
    { name: "Pierre Burgy", role: "Co-founder and CEO, Strapi", photo: pierre },
    { name: "Stijn Christiaens", role: "Co-founder, Collibra", photo: stijn },
]

const PUBLIC: Backer[] = [
    { name: "Bpifrance", svg: bpifrance },
    { name: "Région Hauts-de-France", svg: hautsDeFrance, height: 44 },
    { name: "BNP Paribas", svg: bnpParibas },
    { name: "CIC", svg: cic },
    { name: "Caisse d'Épargne", svg: caisseEpargne },
]
---

<section class="backers">
    <div class="container">
        <div class="grid">
            <header>
                <h2>Backed by investors and<br />infrastructure founders.</h2>
            </header>

            <ul class="investors">
                {
                    INVESTORS.map((b) => (
                        <li>
                            <a
                                href={b.href}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="logo" set:html={b.svg} />
                                <span class="visually-hidden">{b.name}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="more">
            <span class="label">Angel investors</span>
            <ul class="founders" aria-label="Founders who invested in Kestra">
                {
                    FOUNDERS.map((f) => (
                        <li>
                            <Image
                                src={f.photo}
                                alt=""
                                width={56}
                                height={56}
                                densities={[1, 2]}
                            />
                            <span>
                                <strong>{f.name}</strong>
                                {f.role}
                            </span>
                        </li>
                    ))
                }
            </ul>

            <span class="label">With the support of</span>
            <ul class="public" aria-label="Public and banking partners">
                {
                    PUBLIC.map((b) => (
                        <li title={b.name}>
                            <span
                                class="logo"
                                style={b.height && `height: ${b.height}px`}
                                set:html={b.svg}
                            />
                            <span class="visually-hidden">{b.name}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    // No top padding: the grid meets the section above; the angels and the
    // partners follow it in open rows.
    .backers {
        background: var(--ks-background-body);
    }

    // One grid of hairlines holds the whole section: a frame, a band per
    // row, and a cell per logo.
    // The horizontal rules run on to the edges of the screen; the frame
    // stays at the width of the content.
    .grid {
        --line: var(--ks-border-primary);
        --rule: 1px solid var(--line);

        // The frame sits outside the content edge, so the title inside it
        // lines up with the titles of the other sections.
        --inset: 3rem;

        position: relative;
        margin-inline: calc(var(--inset) * -1);
        border-left: var(--rule);
        border-right: var(--rule);

        // Phones: the frame reaches the screen's edges.
        @include media-breakpoint-down(md) {
            --inset: 1.25rem;
        }

        > * {
            position: relative;
        }

        > *::before {
            content: "";
            position: absolute;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--line);
            pointer-events: none;
        }

        > *::before {
            top: 0;
        }
    }

    // The title, the angels and the partners share the content's left edge.
    header {
        padding: 4rem var(--inset);

        @include media-breakpoint-down(md) {
            padding-block: 3rem;
        }
    }

    h2 {
        @include title;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
    }

    li {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
    }

    .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #131316;

        :global(svg) {
            width: 100%;
            height: 100%;
        }

        // The logo files are drawn for light backgrounds: on the dark theme
        // they turn into light monochrome marks.
        :global(html.dark) & {
            filter: grayscale(1) invert(1);
        }
    }

    .investors {
        grid-template-columns: repeat(4, minmax(0, 1fr));

        li + li {
            border-left: var(--rule);
        }

        @include media-breakpoint-down(md) {
            grid-template-columns: repeat(2, minmax(0, 1fr));

            li:nth-child(3) {
                border-left: 0;
            }

            li:nth-child(n + 3) {
                border-top: var(--rule);
            }
        }

        a {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 180px;
            text-decoration: none;
            color: inherit;
            transition: background 0.2s ease;

            &:hover {
                background: var(--ks-background-secondary);
            }

            @include media-breakpoint-down(md) {
                height: 140px;
            }
        }

        .logo {
            width: 60%;
            max-width: 160px;
            height: 64px;
        }
    }

    // Under the grid, the angels and the partners sit in open rows,
    // without cells, so the lead investors stay the one framed level.
    .investors::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: -100vw;
        right: -100vw;
        height: 1px;
        background: var(--line);
        pointer-events: none;
    }

    .more {
        padding: 4rem 0 6rem;

        @include media-breakpoint-down(md) {
            padding: 3rem 0 4.5rem;
        }
    }

    .label {
        @include eyebrow;
        margin-bottom: 1.5rem;
        color: var(--ks-content-tertiary);
    }

    .founders {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.75rem 2rem;
        margin-bottom: 4rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.25rem;
            margin-bottom: 3rem;
        }

        li {
            justify-content: flex-start;
            gap: 1rem;
        }

        :global(img) {
            flex-shrink: 0;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            filter: grayscale(1);
            transition: filter 0.3s ease;
        }

        li:hover :global(img) {
            filter: none;
        }

        span {
            display: flex;
            flex-direction: column;
            font-size: $font-size-sm;
            line-height: 1.4;
            color: var(--ks-content-tertiary);
        }

        strong {
            font-size: $font-size-base;
            font-weight: 600;
            color: var(--ks-content-primary);
        }
    }

    // One quiet line of grey marks, all at the same height.
    .public {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem 3rem;

        li {
            justify-content: flex-start;
        }

        .logo {
            height: 28px;
            filter: grayscale(1);
            opacity: 0.6;

            :global(svg) {
                width: auto;
            }

            :global(html.dark) & {
                filter: grayscale(1) invert(1);
            }
        }
    }
</style>
