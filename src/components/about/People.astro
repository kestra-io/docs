<section class="people">
    <PixelEdges left="cluster" right="wide" />
    <div class="container">
        <header>
            <h2>Leadership.</h2>
        </header>

        <ul class="strip" data-leaders tabindex="0" aria-label="Leadership">
            {
                LEADERS.map((l) => (
                    <li>
                        <figure>
                            <Image
                                src={l.photo}
                                alt={l.name}
                                widths={[480, 720, 960]}
                                sizes="(min-width: 1200px) 250px, (min-width: 768px) 33vw, 50vw"
                            />
                        </figure>
                        <h3>{l.name}</h3>
                        <span class="role">{l.role}</span>
                        <div class="links">
                            {l.links.map((link) => (
                                <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${l.name} on ${link.label}`}
                                    title={link.label}
                                >
                                    <Icon name={link.icon} />
                                </a>
                            ))}
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<script>
    function init() {
        document
            .querySelectorAll<HTMLElement>("[data-leaders]:not([data-ready])")
            .forEach((strip) => {
                strip.dataset.ready = "true"

                let drag: { x: number; left: number; moved: boolean } | null =
                    null
                strip.addEventListener("pointerdown", (e) => {
                    if (e.pointerType !== "mouse") return
                    drag = {
                        x: e.clientX,
                        left: strip.scrollLeft,
                        moved: false,
                    }
                })
                strip.addEventListener("pointermove", (e) => {
                    if (!drag) return
                    const dx = e.clientX - drag.x
                    if (!drag.moved && Math.abs(dx) > 4) {
                        drag.moved = true
                        strip.classList.add("dragging")
                        strip.setPointerCapture(e.pointerId)
                    }
                    if (drag.moved) strip.scrollLeft = drag.left - dx
                })
                const release = () => {
                    drag = null
                    setTimeout(() => strip.classList.remove("dragging"))
                }
                strip.addEventListener("pointerup", release)
                strip.addEventListener("pointercancel", release)
                strip.addEventListener(
                    "click",
                    (e) => {
                        if (strip.classList.contains("dragging")) {
                            e.preventDefault()
                            e.stopPropagation()
                        }
                    },
                    true,
                )

                strip.addEventListener("keydown", (e) => {
                    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return
                    e.preventDefault()
                    const step = strip.querySelector("li")!.clientWidth + 24
                    strip.scrollBy({
                        left: e.key === "ArrowRight" ? step : -step,
                        behavior: "smooth",
                    })
                })
            })
    }
    document.addEventListener("astro:page-load", init)
    init()
</script>

<style lang="scss">
    @use "./style/section" as *;

    .people {
        @include section;
        position: relative;
        border-top: 1px solid var(--ks-border-primary);
        background: var(--ks-background-body);
    }

    header {
        margin-bottom: 3.5rem;

        @include media-breakpoint-down(md) {
            margin-bottom: 2.5rem;
        }
    }

    h2 {
        @include title;
    }

    .strip {
        --bleed: calc((100vw - 100%) / 2);

        list-style: none;
        display: flex;
        gap: 1.5rem;
        margin: 0 calc(var(--bleed) * -1);
        padding: 0 var(--bleed);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        cursor: grab;
        user-select: none;
        outline: none;

        &::-webkit-scrollbar {
            display: none;
        }

        &.dragging {
            cursor: grabbing;
        }

        &:focus-visible {
            box-shadow: inset 0 0 0 2px var(--ks-content-color-highlight);
        }

        @include media-breakpoint-down(md) {
            gap: 1rem;
        }

        li {
            flex: none;
            width: clamp(200px, 18vw, 260px);

            @include media-breakpoint-down(md) {
                width: 42vw;
            }
        }

        :global(img) {
            pointer-events: none;
        }
    }

    figure {
        position: relative;
        margin: 0 0 1rem;
        overflow: hidden;
        aspect-ratio: 4 / 5;
        background: var(--ks-background-tertiary);

        :global(img) {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 20%;
            transition: transform 0.6s ease;
        }
    }

    li:hover figure :global(img) {
        transform: scale(1.03);
    }

    h3 {
        margin: 0;
        font-size: $font-size-lg;
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .role {
        display: block;
        margin-top: 0.25rem;
        font-family: var(--bs-font-monospace);
        font-size: $font-size-sm;
        color: var(--ks-content-tertiary);
    }

    .links {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .links a {
        display: inline-flex;
        color: var(--ks-content-secondary);
        transition: color 0.2s ease;

        &:hover {
            color: var(--ks-content-primary);
        }

        :global(svg) {
            width: 1.375rem;
            height: 1.375rem;
        }
    }
</style>
