---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import manu from "./assets/manu.jpg"
import ludo from "./assets/ludo.jpg"

const LEADERS = [
    {
        name: "Emmanuel Darras",
        role: "Co-founder and CEO",
        bio: "Previously co-founded and ran a 500-person game studio for two decades before starting Kestra.",
        links: [
            {
                icon: "mdi:linkedin",
                label: "LinkedIn",
                href: "https://www.linkedin.com/in/emmanuel-darras",
            },
        ],
        photo: manu,
    },
    {
        name: "Ludovic Dehon",
        role: "Co-founder and CTO",
        bio: "Wrote the first version of Kestra, designed the engine and leads engineering.",
        links: [
            {
                icon: "mdi:linkedin",
                label: "LinkedIn",
                href: "https://www.linkedin.com/in/ludovic-dehon/",
            },
            {
                icon: "mdi:github",
                label: "GitHub",
                href: "https://github.com/tchiotludo",
            },
        ],
        photo: ludo,
    },
]
---

<section class="people">
    <div class="container">
        <header>
            <span class="eyebrow">Leadership</span>
            <h2>Who is behind it.</h2>
        </header>

        <ul>
            {
                LEADERS.map((l) => (
                    <li>
                        <figure>
                            <Image
                                src={l.photo}
                                alt={l.name}
                                widths={[480, 720, 960]}
                                sizes="(min-width: 992px) 320px, 50vw"
                            />
                        </figure>
                        <h3>{l.name}</h3>
                        <span class="role">{l.role}</span>
                        <p>{l.bio}</p>
                        <div class="links">
                            {l.links.map((link) => (
                                <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${l.name} on ${link.label}`}
                                    title={link.label}
                                >
                                    <Icon name={link.icon} />
                                </a>
                            ))}
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .people {
        @include section;
        border-top: 1px solid var(--ks-border-primary);
        background: var(--ks-background-body);

        .container {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 2.5rem 4rem;

            @include media-breakpoint-down(lg) {
                grid-template-columns: 1fr;
            }
        }
    }

    .eyebrow {
        @include eyebrow;
    }

    h2 {
        @include title;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;

        @include media-breakpoint-down(sm) {
            gap: 1rem;
        }
    }

    // The square is the dot of the Kestra wordmark.
    figure {
        position: relative;
        margin: 0 0 1rem;
        overflow: hidden;
        aspect-ratio: 4 / 5;
        background: var(--ks-background-tertiary);

        &::before {
            content: "";
            position: absolute;
            z-index: 1;
            top: 0;
            left: 0;
            width: 10px;
            height: 10px;
            background: #fe0071;
        }

        :global(img) {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 20%;
            transition: transform 0.6s ease;
        }
    }

    li:hover figure :global(img) {
        transform: scale(1.03);
    }

    h3 {
        margin: 0;
        font-size: $font-size-xl;
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .role {
        display: block;
        margin-top: 0.25rem;
        font-family: var(--bs-font-monospace);
        font-size: $font-size-sm;
        color: var(--ks-content-tertiary);
    }

    p {
        margin: 0.75rem 0;
        font-size: $font-size-sm;
        line-height: 1.6;
        color: var(--ks-content-secondary);
    }

    .links {
        display: flex;
        gap: 0.5rem;
    }

    .links a {
        display: inline-flex;
        color: var(--ks-content-secondary);
        transition: color 0.2s ease;

        &:hover {
            color: var(--ks-content-primary);
        }

        :global(svg) {
            width: 1.375rem;
            height: 1.375rem;
        }
    }
</style>
