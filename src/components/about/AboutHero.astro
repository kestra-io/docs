---
import { Icon } from "astro-icon/components"
import AsciiMark from "./AsciiMark.astro"
import PixelEdges from "./PixelEdges.astro"
---

<section
    class="hero surface-dark"
    aria-labelledby="about-hero"
    data-header-dark
>
    <div class="mesh" aria-hidden="true">
        <span class="light violet"></span>
        <span class="light lavender"></span>
        <span class="light graphite"></span>
    </div>
    <PixelEdges left="tall" right="wide" />
    <div class="container">
        <div class="content">
            <h1 id="about-hero">
                <span class="product">
                    About Kestra
                    <span class="visually-hidden">:</span>
                </span>
                <span class="claim">
                    Kestra is the unified orchestration platform<span
                        class="brand-dot"
                        aria-hidden="true"></span><span class="visually-hidden"
                        >.</span
                    >
                </span>
            </h1>
            <p class="intro">
                Kestra orchestrates data pipelines, infrastructure automation,
                IT operations, business processes and the AI agents that now act
                across all of them, from one control plane. Teams describe what
                should run, when, and what happens when it fails, in one
                declarative file. The tasks themselves can be written in any
                language and call any system.
            </p>
            <div class="actions">
                <a href="/careers" class="btn-solid">
                    We are hiring <Icon name="mdi:chevron-right" />
                </a>
                <a
                    href="/resources/whitepapers/unified-orchestration"
                    class="btn-ghost">Read the whitepaper</a
                >
            </div>
        </div>

        <div class="illustration">
            <AsciiMark />
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/assets/styles/hero" as *;

    .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin-top: -67px;
        padding: calc(67px + 4rem) 0 4rem;
        color: #ffffff;
        background: #050506;

        @include hero-size(tall);

        @include media-breakpoint-down(md) {
            padding: calc(67px + 3rem) 0 3.5rem;
        }

        border-bottom: 1px solid var(--ks-border-primary);

        .container {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 4rem;
            align-items: center;

            @include media-breakpoint-down(lg) {
                grid-template-columns: 1fr;
            }
        }

        :global(.pixel-edges .edge) {
            background: rgba(190, 176, 255, 0.16);
        }
    }

    .mesh {
        position: absolute;
        z-index: -1;
        inset: 0;
        pointer-events: none;

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.55'/></svg>");
            opacity: 0.22;
            mix-blend-mode: overlay;
        }

        &::before {
            content: "";
            position: absolute;
            z-index: 1;
            inset: 0;
            background: radial-gradient(
                    circle,
                    rgba(255, 255, 255, 0.5) 0.6px,
                    transparent 1px
                )
                0 0 / 4px 4px;
            opacity: 0.12;
            mask: radial-gradient(
                ellipse 70% 80% at 50% 50%,
                rgba(0, 0, 0, 0.25),
                #000
            );
            mix-blend-mode: overlay;
        }
    }

    .light {
        position: absolute;
        border-radius: 50%;
        filter: blur(40px);
        animation: glow-drift 28s ease-in-out infinite alternate;

        &.violet {
            top: -30%;
            right: -14%;
            width: 78%;
            height: 135%;
            background: radial-gradient(
                closest-side,
                rgba(84, 66, 255, 0.3),
                rgba(72, 84, 255, 0.08) 55%,
                transparent
            );

            @include media-breakpoint-down(lg) {
                top: 28%;
                right: -20%;
                width: 140%;
                height: 85%;
            }
        }

        &.lavender {
            top: -25%;
            left: -5%;
            width: 55%;
            height: 80%;
            background: radial-gradient(
                closest-side,
                rgba(205, 182, 251, 0.09),
                rgba(205, 182, 251, 0.02) 55%,
                transparent
            );
            animation-duration: 34s;
            animation-delay: -12s;
        }

        &.graphite {
            left: -20%;
            bottom: -45%;
            width: 75%;
            height: 115%;
            background: radial-gradient(
                closest-side,
                rgba(120, 118, 135, 0.1),
                rgba(120, 118, 135, 0.02) 55%,
                transparent
            );
            animation-duration: 40s;
            animation-delay: -20s;
        }

        @media (prefers-reduced-motion: reduce) {
            animation: none;
        }
    }

    @keyframes glow-drift {
        0% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(5%, 4%) scale(1.06);
        }

        100% {
            transform: translate(-3%, 6%) scale(0.96);
        }
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 4.6vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.04;
        color: #ffffff;
        text-wrap: balance;
    }

    .product {
        display: block;
        width: fit-content;
        background: linear-gradient(
                90deg,
                #ffffff 0%,
                #e4dcff 25%,
                #a996ff 50%,
                #e4dcff 75%,
                #ffffff 100%
            )
            0 0 / 200% 100% repeat-x;
        background-clip: text;
        text-transform: uppercase;
        color: transparent;
    }

    .claim {
        display: block;
        margin-top: 0.4em;
        font-size: 0.5em;
        font-weight: 500;
        letter-spacing: -0.01em;

        @include media-breakpoint-down(md) {
            font-size: 0.62em;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .product {
            animation: hero-sheen 8s linear infinite;
        }
    }

    @keyframes hero-sheen {
        to {
            background-position-x: 200%;
        }
    }

    .brand-dot {
        display: inline-block;
        width: 0.15em;
        height: 0.15em;
        margin-left: 0.05em;
        background: #fe0071;
    }

    .intro {
        max-width: 640px;
        margin: 1.5rem 0 0;
        font-size: 1.1875rem;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.86);
        text-wrap: pretty;

        @include media-breakpoint-down(md) {
            font-size: $font-size-md;
            line-height: 1.6;
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2.25rem;

        @include media-breakpoint-down(md) {
            margin-top: 2rem;

            > :global(*) {
                flex: 1 1 100%;
                justify-content: center;
                text-align: center;
            }
        }
    }

    .illustration {
        display: flex;
        justify-content: center;
        translate: 0 -2.5rem;

        @include media-breakpoint-down(lg) {
            display: none;
        }
    }
</style>
