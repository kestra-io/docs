---
import Link from "~/components/common/Link.astro"
import AsciiMark from "./AsciiMark.astro"
import HeroFlows from "./HeroFlows.astro"
---

<section class="hero">
    <HeroFlows />
    <div class="container">
        <div class="content">
            <span class="eyebrow">About Kestra</span>
            <h1>
                Kestra is the unified<br />orchestration platform<span
                    class="dot">.</span
                >
            </h1>
            <div class="cols">
                <p>
                    Kestra runs data pipelines, infrastructure automation, IT
                    operations, business processes and the AI agents that now
                    act across all of them, from one control plane. Teams
                    describe what should run, when, and what happens when it
                    fails, in one declarative language, in any programming
                    language, against any system.
                </p>
                <p>
                    We are Kestra Technologies, the company that builds and
                    supports the platform. The engine is open source and
                    developed in public. We are headquartered in the United
                    States and France, with teams across North America and
                    Europe, and customers running Kestra in production on every
                    continent.
                </p>
            </div>
            <div class="actions">
                <Link href="/careers" class="btn btn-primary"
                    >We are hiring</Link
                >
                <a href="/contact-us" class="btn btn-secondary">Contact us</a>
            </div>
        </div>

        <div class="illustration">
            <AsciiMark />
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/assets/styles/color-palette" as *;
    @use "./style/section" as *;

    .hero {
        position: relative;
        overflow: hidden;
        padding: 7rem 0 8rem;
        color: #fff;
        background: #111114;

        @include media-breakpoint-down(md) {
            padding: 4rem 0 5rem;
        }

        .container {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 4rem;
            align-items: center;

            @include media-breakpoint-down(lg) {
                grid-template-columns: 1fr;
            }
        }
    }

    .eyebrow {
        @include eyebrow;
        color: $base-primary-300;
    }

    h1 {
        margin: 0 0 2.5rem;
        font-size: clamp(2.75rem, 6vw, 5rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.02;
        color: inherit;
        text-wrap: balance;

        .dot {
            margin-left: -0.08em;
            color: #fe0071;
        }
    }

    .cols {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem;

        @include media-breakpoint-down(md) {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        p {
            margin: 0;
            font-size: $font-size-md;
            line-height: 1.65;
            color: rgba(255, 255, 255, 0.72);
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2.5rem;

        .btn-secondary {
            --ks-content-primary: #fff;
            --ks-background-button-secondary: transparent;
            --ks-content-btn-secondary-hover: #{$base-grey-800};
            --ks-background-button-secondary-hover: #fff;
            border-color: rgba(255, 255, 255, 0.7);
        }
    }

    .illustration {
        display: flex;
        justify-content: center;

        @include media-breakpoint-down(lg) {
            display: none;
        }
    }
</style>
