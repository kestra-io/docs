---
import Link from "~/components/common/Link.astro"
import AsciiMark from "./AsciiMark.astro"
import HeroFlows from "./HeroFlows.astro"
---

<section class="hero">
    <HeroFlows />
    <div class="container">
        <div class="content">
            <span class="eyebrow">About Kestra</span>
            <h1>
                Kestra is the unified<br />orchestration platform<span
                    class="brand-dot"
                    aria-hidden="true"></span><span class="visually-hidden"
                    >.</span
                >
            </h1>
            <p class="intro">
                Kestra orchestrates data pipelines, infrastructure automation,
                IT operations, business processes and the AI agents that now act
                across all of them, from one control plane. Teams describe what
                should run, when, and what happens when it fails, in one
                declarative file. The tasks themselves can be written in any
                language and call any system.
            </p>
            <div class="actions">
                <Link href="/careers" class="btn btn-primary"
                    >We are hiring</Link
                >
                <a
                    href="/resources/whitepapers/unified-orchestration"
                    class="btn btn-secondary">Read the whitepaper</a
                >
            </div>
        </div>

        <div class="illustration">
            <AsciiMark />
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/assets/styles/color-palette" as *;
    @use "./style/section" as *;

    .hero {
        position: relative;
        overflow: hidden;
        padding: 7rem 0 8rem;
        color: #fff;
        background: #111114;

        @include media-breakpoint-down(md) {
            padding: 4rem 0 5rem;
        }

        .container {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 4rem;
            align-items: center;

            @include media-breakpoint-down(lg) {
                grid-template-columns: 1fr;
            }
        }
    }

    .eyebrow {
        @include eyebrow;
        color: $base-primary-300;
    }

    h1 {
        margin: 0 0 2.5rem;
        font-size: clamp(2.75rem, 6vw, 5rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.02;
        color: inherit;
        text-wrap: balance;

        // The square dot of the Kestra wordmark.
        .brand-dot {
            display: inline-block;
            width: 0.15em;
            height: 0.15em;
            margin-left: 0.05em;
            background: #fe0071;
        }
    }

    .intro {
        max-width: 640px;
        margin: 0;
        font-size: $font-size-lg;
        line-height: 1.65;
        color: rgba(255, 255, 255, 0.72);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2.5rem;

        .btn-secondary {
            --ks-content-primary: #fff;
            --ks-background-button-secondary: transparent;
            --ks-content-btn-secondary-hover: #{$base-grey-800};
            --ks-background-button-secondary-hover: #fff;
            border-color: rgba(255, 255, 255, 0.7);
        }
    }

    .illustration {
        display: flex;
        justify-content: center;

        @include media-breakpoint-down(lg) {
            display: none;
        }
    }
</style>
