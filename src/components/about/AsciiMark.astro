---
// The Kestra mark drawn as flows on a dark field. Every row of every
// diamond is a flow: a trigger, pipes and tasks, and an end. Executions run
// along them from a to b, light the pipe and finish with a check; the
// pointer triggers the flows it passes over. Each diamond keeps its color.
---

<div class="ascii-mark" data-ascii-mark>
    <canvas
        role="img"
        aria-label="The Kestra logo drawn as flows running from trigger to end"
    ></canvas>
</div>

<script>
    import markUrl from "~/assets/landing/partners/kestra-mark.svg?url"

    const COLS = 44
    const TRIGGER = "●"
    const PIPE = "─"
    const TASK = "◇"
    const END = "■"
    const SUCCESS = "✓"
    const HOLD = 700 // ms the finished flow stays lit

    type Cell = {
        x: number
        y: number
        r: number
        g: number
        b: number
        a: number
    }

    type Lane = {
        cells: Cell[]
        speed: number // cells per ms
        start: number
        rest: number
    }

    // Contiguous runs of a row inside one diamond become one flow.
    function lanes(cells: Cell[]): Lane[] {
        const rows = new Map<number, Cell[]>()
        for (const c of cells) {
            if (c.a < 0.35) continue
            if (!rows.has(c.y)) rows.set(c.y, [])
            rows.get(c.y)!.push(c)
        }
        const out: Lane[] = []
        for (const row of rows.values()) {
            row.sort((a, b) => a.x - b.x)
            let run: Cell[] = []
            const flush = () => {
                if (run.length >= 3)
                    out.push({
                        cells: run,
                        speed: 0.012 + Math.random() * 0.012,
                        start: -Math.random() * 4000,
                        rest: 400 + Math.random() * 2600,
                    })
                run = []
            }
            for (const c of row) {
                if (run.length && c.x !== run[run.length - 1].x + 1) flush()
                run.push(c)
            }
            flush()
        }
        return out
    }

    // Rasterize the SVG to one pixel per character and keep the covered cells.
    async function sample(): Promise<Cell[]> {
        const img = new Image()
        img.src = markUrl
        await img.decode()
        // Find the drawing's bounds first, so the mark fills the grid.
        const probe = document.createElement("canvas")
        probe.width = probe.height = 256
        const pctx = probe.getContext("2d", { willReadFrequently: true })!
        pctx.drawImage(img, 0, 0, 256, 256)
        const px = pctx.getImageData(0, 0, 256, 256).data
        let x0 = 256,
            y0 = 256,
            x1 = 0,
            y1 = 0
        for (let i = 3; i < px.length; i += 4) {
            if (px[i] < 8) continue
            const p = (i - 3) / 4
            const x = p % 256
            const y = (p / 256) | 0
            x0 = Math.min(x0, x)
            y0 = Math.min(y0, y)
            x1 = Math.max(x1, x)
            y1 = Math.max(y1, y)
        }
        const side = Math.max(x1 - x0, y1 - y0) * 1.06
        const cx = (x0 + x1) / 2
        const cy = (y0 + y1) / 2
        const k = img.naturalWidth / 256

        const off = document.createElement("canvas")
        off.width = COLS
        off.height = COLS
        const octx = off.getContext("2d", { willReadFrequently: true })!
        octx.drawImage(
            img,
            (cx - side / 2) * k,
            (cy - side / 2) * k,
            side * k,
            side * k,
            0,
            0,
            COLS,
            COLS,
        )
        const data = octx.getImageData(0, 0, COLS, COLS).data
        const cells: Cell[] = []
        for (let y = 0; y < COLS; y++) {
            for (let x = 0; x < COLS; x++) {
                const i = (y * COLS + x) * 4
                const a = data[i + 3] / 255
                if (a < 0.08) continue
                cells.push({
                    x,
                    y,
                    r: data[i],
                    g: data[i + 1],
                    b: data[i + 2],
                    a,
                })
            }
        }
        return cells
    }

    // Runs on every page arrival: the site swaps pages client side, so
    // a module script alone would only wire the first visit.
    function init() {
        document
            .querySelectorAll<HTMLElement>(
                "[data-ascii-mark]:not([data-ready])",
            )
            .forEach(async (root) => {
                root.dataset.ready = "true"
                const canvas = root.querySelector("canvas")!
                const ctx = canvas.getContext("2d")!
                const reduced = matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches
                const flows = lanes(await sample())
                const font = getComputedStyle(root).fontFamily

                let size = 0
                let dpr = 1
                const resize = () => {
                    dpr = Math.min(2, devicePixelRatio || 1)
                    size = canvas.clientWidth
                    canvas.width = size * dpr
                    canvas.height = size * dpr
                }
                new ResizeObserver(resize).observe(canvas)
                resize()

                // Pointing at a flow that is resting starts it right away.
                let pointer: { x: number; y: number } | null = null
                canvas.addEventListener("pointermove", (e) => {
                    const rect = canvas.getBoundingClientRect()
                    pointer = {
                        x: ((e.clientX - rect.left) / rect.width) * COLS,
                        y: ((e.clientY - rect.top) / rect.height) * COLS,
                    }
                })
                canvas.addEventListener("pointerleave", () => (pointer = null))

                const glyphOf = (i: number, n: number, done: boolean) => {
                    if (i === 0) return TRIGGER
                    if (i === n - 1) return done ? SUCCESS : END
                    return i % 6 === 3 ? TASK : PIPE
                }

                const draw = (time: number) => {
                    if (!size) return
                    const W = size * dpr
                    const cell = W / COLS
                    ctx.clearRect(0, 0, W, W)
                    ctx.font = `600 ${cell * 1.05}px ${font}`
                    ctx.textAlign = "center"
                    ctx.textBaseline = "middle"

                    for (const lane of flows) {
                        const n = lane.cells.length
                        const run = n / lane.speed
                        let t = time - lane.start

                        // Resting flows under the pointer run again at once.
                        const resting = t > run + HOLD
                        if (
                            pointer &&
                            resting &&
                            Math.abs(pointer.y - (lane.cells[0].y + 0.5)) <
                                1.5 &&
                            pointer.x >= lane.cells[0].x - 1 &&
                            pointer.x <= lane.cells[n - 1].x + 2
                        ) {
                            lane.start = time
                            t = 0
                        } else if (t > run + HOLD + lane.rest) {
                            lane.start = time
                            lane.rest = 400 + Math.random() * 2600
                            t = 0
                        }

                        const head = reduced ? -1 : t * lane.speed
                        const done = !reduced && t >= run && t < run + HOLD
                        const fade = done ? 1 - (t - run) / HOLD : 0

                        lane.cells.forEach((c, i) => {
                            // Idle pipe, the trail behind an execution, its head,
                            // and the whole flow glowing as it completes.
                            let alpha = 0.28
                            let lift = 0
                            if (done) {
                                alpha = 0.28 + 0.72 * fade
                                lift = 0.35 * fade
                            } else if (head >= 0 && i <= head && t < run) {
                                const behind = head - i
                                alpha = 0.5 + 0.5 * Math.exp(-behind / 5)
                                lift =
                                    behind < 1 ? 1 : 0.4 * Math.exp(-behind / 3)
                            }
                            const r = Math.round(c.r + (255 - c.r) * lift)
                            const g = Math.round(c.g + (255 - c.g) * lift)
                            const b = Math.round(c.b + (255 - c.b) * lift)
                            ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`
                            const glyph = glyphOf(i, n, done)
                            const cx = (c.x + 0.5) * cell
                            const cy = (c.y + 0.5) * cell
                            // Pipes are drawn as strokes so they join from cell to
                            // cell; nodes get a stub on each side that reaches them.
                            const thick = Math.max(1, cell * 0.1)
                            if (glyph === PIPE) {
                                ctx.fillRect(
                                    c.x * cell,
                                    cy - thick / 2,
                                    cell,
                                    thick,
                                )
                                return
                            }
                            const gap = cell * 0.32
                            if (i > 0)
                                ctx.fillRect(
                                    c.x * cell,
                                    cy - thick / 2,
                                    cell / 2 - gap,
                                    thick,
                                )
                            if (i < n - 1)
                                ctx.fillRect(
                                    cx + gap,
                                    cy - thick / 2,
                                    cell / 2 - gap,
                                    thick,
                                )
                            ctx.fillText(glyph, cx, cy)
                        })
                    }
                }

                if (reduced) {
                    draw(0)
                    new ResizeObserver(() => draw(0)).observe(canvas)
                    return
                }

                let running = false
                const loop = (time: number) => {
                    if (!running || !canvas.isConnected) return
                    draw(time)
                    requestAnimationFrame(loop)
                }
                new IntersectionObserver(([entry]) => {
                    const was = running
                    running = entry.isIntersecting
                    if (running && !was) requestAnimationFrame(loop)
                }).observe(canvas)
            })
    }
    document.addEventListener("astro:page-load", init)
    init()
</script>

<style lang="scss">
    .ascii-mark {
        width: 100%;
        max-width: 480px;
        font-family: var(--bs-font-monospace);

        canvas {
            display: block;
            width: 100%;
            aspect-ratio: 1;
        }
    }
</style>
