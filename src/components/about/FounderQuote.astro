---
import { Image } from "astro:assets"
import manu from "./assets/manu.jpg"
---

<section class="founder-quote">
    <div class="container">
        <figure>
            <blockquote>
                <p>
                    Every decade, one coordination problem grows large enough to
                    become its own category. Today, that problem is
                    orchestrating everything a company runs: infrastructure,
                    data, AI, business processes. We started building Kestra
                    before anyone gave it a name, and we kept going. Now
                    engineers at some of the world's largest companies trust it
                    with their business-critical operations. Our goal is to lead
                    this market.
                </p>
            </blockquote>
            <figcaption>
                <span class="avatar">
                    <Image src={manu} alt="" width={112} densities={[1, 2]} />
                </span>
                <span>
                    <strong>Emmanuel Darras</strong>
                    Co-founder and CEO
                </span>
            </figcaption>
        </figure>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .founder-quote {
        padding-bottom: 7.5rem;
        background: var(--ks-background-body);

        @include media-breakpoint-down(md) {
            padding-bottom: 4.5rem;
        }
    }

    figure {
        --line: var(--ks-border-primary);
        --inset: 3rem;

        position: relative;
        margin: 0 calc(var(--inset) * -1);
        border-left: 1px solid var(--line);
        border-right: 1px solid var(--line);

        @include media-breakpoint-down(md) {
            --inset: 1.5rem;
        }

        > * {
            position: relative;
        }

        > *::before,
        > :last-child::after {
            content: "";
            position: absolute;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--line);
            pointer-events: none;
        }

        > *::before {
            top: 0;
        }

        > :last-child::after {
            bottom: 0;
        }
    }

    blockquote {
        margin: 0;
        padding: 4rem var(--inset);

        @include media-breakpoint-down(md) {
            padding-block: 3rem;
        }

        p {
            position: relative;
            margin: 0;
            font-size: clamp(1.5rem, 2.6vw, 2.25rem);
            font-weight: 500;
            letter-spacing: -0.015em;
            line-height: 1.35;
            max-width: 880px;
            text-wrap: pretty;
            color: var(--ks-content-primary);

            &::before {
                content: "\201C";
                position: absolute;
                right: 100%;
                padding-right: 0.08em;
                color: var(--ks-content-link);
            }

            &::after {
                content: "\201D";
            }
        }
    }

    figcaption {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem var(--inset);

        .avatar {
            flex-shrink: 0;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            overflow: hidden;

            :global(img) {
                display: block;
                width: 100%;
                height: auto;
                transform: scale(1.8);
                transform-origin: 50% 20%;
            }
        }

        span:not(.avatar) {
            display: flex;
            flex-direction: column;
            font-size: $font-size-sm;
            line-height: 1.4;
            color: var(--ks-content-tertiary);
        }

        strong {
            font-size: $font-size-base;
            font-weight: 600;
            color: var(--ks-content-primary);
        }
    }
</style>
