---
import { Icon } from "astro-icon/components"
import PixelGrid from "~/components/common/PixelGrid.astro"

const LINKS = [
    {
        label: "GitHub",
        href: "https://github.com/kestra-io/kestra",
        icon: "mdi:github",
    },
    { label: "Slack community", href: "/slack", icon: "mdi:slack" },
    {
        label: "Contributing guide",
        href: "/docs/contribute-to-kestra/contributing",
        icon: "mdi:source-branch",
    },
    { label: "Kestra Hacktober", href: "/hacktober", icon: "mdi:pumpkin" },
    {
        label: "Kestra Academy",
        href: "https://academy.kestra.io",
        icon: "mdi:school-outline",
    },
]
---

<section class="open-source">
    <PixelGrid
        rows={48}
        mask="radial-gradient(ellipse 34% 40% at 50% 52%, transparent 30%, #000 100%)"
    />

    <div class="container">
        <div class="panel">
            <h2>Open source since<br />the first commit.</h2>
            <p>
                The engine, the plugins and the roadmap are public. Thousands of
                engineers run Kestra, open issues, send pull requests and answer
                each other on Slack every month.
            </p>
            <ul>
                {
                    LINKS.map((l) => (
                        <li>
                            <a href={l.href}>
                                <Icon name={l.icon} />
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/assets/styles/color-palette" as *;
    @use "./style/section" as *;

    .open-source {
        @include section;
        position: relative;
        overflow: hidden;
        color: #fff;
        text-align: center;
        background: #111114;

        .container {
            position: relative;
        }
    }

    .panel {
        max-width: 1120px;
        margin: 0 auto;
        padding: 4.5rem 3rem;

        @include media-breakpoint-down(md) {
            padding: 3rem 1.25rem;
        }
    }

    h2 {
        @include title;
        color: inherit;
    }

    p {
        @include lead;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
        color: rgba(255, 255, 255, 0.85);
    }

    ul {
        list-style: none;
        margin: 2.5rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem 2rem;
    }

    a {
        @include text-link;
        --ks-content-primary: #fff;
        --ks-border-secondary: rgba(255, 255, 255, 0.4);
        --ks-content-link: #{$base-primary-200};
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;

        :global(svg) {
            width: 1.125rem;
            height: 1.125rem;
            color: rgba(255, 255, 255, 0.6);
        }
    }
</style>
