---
const PRINCIPLES = [
    {
        title: "Declarative",
        text: "A workflow is a document you can read, review, version and promote, not a program only its author understands.",
    },
    {
        title: "Open",
        text: "The engine is Apache 2.0, the plugins are public, and the roadmap is argued in GitHub issues. Leaving is as easy as exporting a file.",
    },
    {
        title: "Language-agnostic",
        text: "Python, SQL, shell, Java, Terraform, dbt, an API call. Kestra runs what your teams already write, where they already run it.",
    },
    {
        title: "Runs anywhere",
        text: "Cloud, on-premises, air-gapped. Workers connect outbound, so compute stays where your data and your rules require.",
    },
    {
        title: "Governed by default",
        text: "Access control, audit, approvals and policies are part of the platform, because a workflow or an agent acting without them is a liability.",
    },
]
---

<section class="principles">
    <div class="container">
        <header>
            <div>
                <span class="eyebrow">What we believe</span>
                <h2>Principles we build to.</h2>
            </div>
            <p>
                Five principles decide how Kestra is designed, what we say no
                to, and how we work with the people who run it.
            </p>
        </header>
        <ol>
            {
                PRINCIPLES.map((p, i) => (
                    <li>
                        <span class="index">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                        <h3>{p.title}</h3>
                        <p>{p.text}</p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .principles {
        @include section;
        border-top: 1px solid var(--ks-border-primary);
        border-bottom: 1px solid var(--ks-border-primary);
        background: var(--ks-background-secondary);
    }

    header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1.5rem 4rem;
        margin-bottom: 4rem;

        p {
            @include lead;
            max-width: 420px;
            margin: 0;
        }
    }

    .eyebrow {
        @include eyebrow;
    }

    h2 {
        @include title;
    }

    // Five columns read side by side, split by hairlines; they stack on
    // smaller screens.
    ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        border-top: 1px solid var(--ks-border-secondary);

        @include media-breakpoint-down(lg) {
            grid-template-columns: 1fr;
        }
    }

    li {
        padding: 2rem 1.5rem 0;

        &:first-child {
            padding-left: 0;
        }

        & + li {
            border-left: 1px solid var(--ks-border-secondary);
        }

        @include media-breakpoint-down(lg) {
            display: grid;
            grid-template-columns: 4rem minmax(0, 1fr);
            gap: 0.25rem 1rem;
            padding: 1.5rem 0;

            & + li {
                border-left: 0;
                border-top: 1px solid var(--ks-border-secondary);
            }

            .index {
                grid-row: span 2;
            }
        }
    }

    .index {
        display: block;
        margin-bottom: 2.5rem;
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--ks-content-color-highlight);

        @include media-breakpoint-down(lg) {
            margin: 0;
            font-size: 2rem;
        }
    }

    h3 {
        margin: 0 0 0.75rem;
        font-size: $font-size-lg;
        font-weight: 600;
    }

    li p {
        margin: 0;
        font-size: $font-size-sm;
        line-height: 1.6;
        color: var(--ks-content-secondary);
    }
</style>
