---
import PixelEdges from "./PixelEdges.astro"
import CustomerGrid from "./CustomerGrid.astro"
---

<section class="customers">
    <PixelEdges left="wide" right="cluster" />
    <div class="container">
        <header>
            <span class="eyebrow">In production at</span>
            <h2>The workloads that<br />cannot fail.</h2>
            <p>
                Banks, telecoms, retailers, manufacturers and public
                administrations run their critical workflows on Kestra, on one
                platform, with the audit trail their regulators ask for.
            </p>
        </header>
        <CustomerGrid />
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .customers {
        @include section;
        position: relative;
        border-top: 1px solid var(--ks-border-primary);
        background: var(--ks-background-body);
    }

    header {
        max-width: 760px;
        margin: 0 auto 3.5rem;
        text-align: center;

        p {
            @include lead;
        }
    }

    .eyebrow {
        @include eyebrow;
    }

    h2 {
        @include title;
    }
</style>
