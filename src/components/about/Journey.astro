---
import PixelEdges from "./PixelEdges.astro"
const MILESTONES = [
    {
        year: "2019",
        text: "Kestra starts as a solo project to replace Airflow at Leroy Merlin France, where it runs in production.",
    },
    {
        year: "2022",
        text: 'The <a href="/blogs/2022-02-01-kestra-opensource">first public release</a>. The repository passes 1,000 GitHub stars two months later.',
    },
    {
        year: "2023",
        text: 'A <a href="/blogs/2023-10-05-announcing-kestra-funding-to-build-the-universal-open-source-orchestrator">pre-seed round</a>, the first hires and the first enterprise customers.',
    },
    {
        year: "2024",
        text: 'A <a href="/blogs/2024-09-23-kestra-raises-8m-seed">seed round</a>. The project passes 10,000 GitHub stars in October.',
    },
    {
        year: "2025",
        text: '<a href="/blogs/release-1-0">Kestra 1.0</a> ships with AI agents and the first <a href="/blogs/introducing-lts">long-term support</a> release. 20,000 GitHub stars.',
    },
    {
        year: "2026",
        text: 'A <a href="/blogs/kestra-series-a">Series A</a> led by RTP Global, then <a href="/two-zero">Kestra 2.0</a> and its rebuilt engine. 30,000 GitHub stars.',
    },
]
---

<section class="journey">
    <PixelEdges />
    <div class="container">
        <h2>Our journey.</h2>
        <ol>
            {
                MILESTONES.map((m) => (
                    <li>
                        <span class="year">{m.year}</span>
                        <p set:html={m.text} />
                    </li>
                ))
            }
        </ol>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .journey {
        @include section;
        position: relative;
        background: var(--ks-background-body);
    }

    h2 {
        @include title;
    }

    ol {
        list-style: none;
        margin: 3rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: 1fr;
        }
    }

    li {
        padding: 1.5rem 1.5rem 2rem;
        border-radius: 8px;
        background: var(--ks-background-secondary);

        @include media-breakpoint-down(md) {
            padding: 1.25rem 1.25rem 1.5rem;
        }
    }

    .year {
        display: block;
        margin-bottom: 1rem;
        font-size: $font-size-xl;

        @include media-breakpoint-down(md) {
            margin-bottom: 0.5rem;
        }
        font-weight: 600;
        color: var(--ks-content-primary);
    }

    p {
        margin: 0;
        font-size: $font-size-md;
        line-height: 1.6;
        color: var(--ks-content-secondary);

        :global(a) {
            @include text-link;
        }
    }
</style>
