---
const ITEMS = [
    {
        title: "Open source engine",
        text: "Apache 2.0, public issue tracker, public release notes, dependencies you can audit.",
    },
    {
        title: "SOC 2 and GDPR",
        text: "Independently audited controls, with reports available on request.",
        href: "/security",
        cta: "Security overview",
    },
    {
        title: "Self-hosted and air-gapped",
        text: "Your network, your keys, no outbound connection required. Public administrations run it this way.",
    },
    {
        title: "Responsible disclosure",
        text: "Security issues are handled privately through GitHub security advisories.",
        href: "https://github.com/kestra-io/kestra/security",
        cta: "Report a vulnerability",
    },
]
---

<section class="trust">
    <div class="container">
        <header>
            <div>
                <span class="eyebrow">Trust and security</span>
                <h2>Built to be audited.</h2>
            </div>
            <p class="intro">How Kestra is built, run and audited.</p>
        </header>
        <ul>
            {
                ITEMS.map((item) => (
                    <li>
                        <div class="tile" aria-hidden="true" />
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                        {item.href && <a href={item.href}>{item.cta}</a>}
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .trust {
        @include section;
        border-top: 1px solid var(--ks-border-primary);
        background: var(--ks-background-secondary);
    }

    header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem 4rem;
        margin-bottom: 3.5rem;

        .intro {
            @include lead;
            max-width: 360px;
            margin-top: 2.25rem;
            font-size: $font-size-md;

            @include media-breakpoint-down(md) {
                margin-top: 0;
            }
        }
    }

    .eyebrow {
        @include eyebrow;
    }

    h2 {
        @include title;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 2rem 1rem;
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: 1fr;
        }
    }

    // Placeholder blocks until the illustrations are designed.
    .tile {
        aspect-ratio: 1;
        margin-bottom: 1.25rem;
        border-radius: 8px;
        background: #111114;

        :global(html.dark) & {
            background: var(--ks-border-primary);
        }
    }

    h3 {
        margin: 0 0 0.375rem;
        font-size: $font-size-lg;
        font-weight: 600;
    }

    li p {
        margin: 0 0 0.75rem;
        font-size: $font-size-sm;
        line-height: 1.6;
        color: var(--ks-content-secondary);
    }

    a {
        @include text-link;
        font-size: $font-size-sm;
    }
</style>
