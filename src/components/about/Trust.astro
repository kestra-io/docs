---
import PixelEdges from "./PixelEdges.astro"
import { Image } from "astro:assets"
import HairlineFigure from "~/components/partners/HairlineFigure.astro"
import SectionHead from "~/components/home/SectionHead.astro"
import Rails from "~/components/platform/Rails.astro"
import soc2Img from "~/components/layout/assets/soc2.png"
import gdprImg from "~/components/layout/assets/gdpr.svg"

const ITEMS = [
    {
        title: "Open source engine",
        text: "Apache 2.0, public issue tracker, public release notes, dependencies you can audit.",
        figure: "opensource" as const,
    },
    {
        title: "SOC 2 and GDPR",
        text: "Independently audited controls, with reports available on request.",
        href: "/security",
        cta: "Security overview",
        figure: "padlock" as const,
        badges: true,
    },
    {
        title: "Self-hosted and air-gapped",
        text: "Your network, your keys, no outbound connection required. Public administrations run it this way.",
        figure: "servers" as const,
    },
    {
        title: "Responsible disclosure",
        text: "Security issues are handled privately through GitHub security advisories.",
        href: "https://github.com/kestra-io/kestra/security",
        cta: "Report a vulnerability",
        figure: "patch" as const,
    },
]
---

<section class="trust surface-dark" aria-labelledby="trust-h" data-header-dark>
    <PixelEdges left="wide" right="tall" />
    <Rails dark bottom="none">
        <SectionHead id="trust-h" eyebrow="Trust and security" align="start">
            Built to be <span>audited.</span>
            <Fragment slot="lead">
                What you can check yourself, and what auditors have checked for
                you.
            </Fragment>
        </SectionHead>

        <ul class="items">
            {
                ITEMS.map((item) => (
                    <li>
                        <HairlineFigure name={item.figure} dark="var(--card)" />
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                        {(item.href || item.badges) && (
                            <div class="actions">
                                {item.href && (
                                    <a href={item.href}>{item.cta}</a>
                                )}
                                {item.badges && (
                                    <span class="badges">
                                        <Image
                                            src={soc2Img}
                                            alt="SOC 2"
                                            height="28"
                                        />
                                        <Image
                                            src={gdprImg}
                                            alt="GDPR"
                                            height="28"
                                        />
                                    </span>
                                )}
                            </div>
                        )}
                    </li>
                ))
            }
        </ul>
    </Rails>
</section>

<style lang="scss">
    @use "/src/components/platform/style/platform" as *;

    .trust {
        --rule: 1px solid var(--band-line);
        --muted: #9a9aa8;
        --bg: #0d0d10;
        --lift: #141419;

        position: relative;
        border-block: var(--rule);
        background: linear-gradient(180deg, #000000 0, var(--bg) 18rem);
        color: #ffffff;

        @include band-lines;

        :global(.section-head h2) {
            color: #ffffff;
        }

        :global(.section-head h2 span) {
            color: #a9a9b8;
        }

        :global(.section-head .lead) {
            color: var(--muted);
        }

        :global(.rails) {
            padding-bottom: clamp(3rem, 6vw, 5rem);
        }
    }

    .items {
        position: relative;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 0 calc(-1 * var(--inset));
        padding: 0;
        border-block: var(--rule);
        list-style: none;

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: minmax(0, 1fr);
        }

        &::before,
        &::after {
            content: "";
            position: absolute;
            left: -100vw;
            right: -100vw;
            height: 1px;
            background: var(--band-line);
            pointer-events: none;

            @include media-breakpoint-down(xl) {
                display: none;
            }
        }

        &::before {
            top: -1px;
        }

        &::after {
            bottom: -1px;
        }

        > li {
            --card: var(--bg);

            display: flex;
            flex-direction: column;
            padding: 1.5rem 1.75rem 3rem;
            background: var(--card);
            transition: background-color 0.3s ease;

            &:hover {
                --card: var(--lift);
            }

            & + li {
                border-left: var(--rule);
            }

            @include media-breakpoint-down(lg) {
                &:nth-child(3) {
                    border-left: 0;
                }

                &:nth-child(n + 3) {
                    border-top: var(--rule);
                }
            }

            @include media-breakpoint-down(sm) {
                padding: 1rem 1rem 1.5rem 2rem;

                & + li {
                    border-left: 0;
                    border-top: var(--rule);
                }
            }

            :global(.hairline-figure) {
                max-width: 15rem;

                @include media-breakpoint-down(sm) {
                    max-width: 9rem;
                }
            }

            :global(.hairline-figure[data-hairline-theme="dark"]) {
                --hairline-edge: #a5a3b6;
                --hairline-mid: #6a6879;
                --hairline-lo: #45434f;
            }
        }

        h3 {
            margin: 0.5rem 0;
            font-size: clamp(1rem, 3.5vw, 1.25rem);
            font-weight: 600;
            line-height: 1.3;
            color: #ffffff;
        }

        p {
            margin: 0;
            font-size: 0.9375rem;
            line-height: 1.55;
            color: var(--muted);
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1rem;
        margin-top: 1rem;
    }

    a {
        font-size: 0.9375rem;
        font-weight: 600;
        color: #ffffff;
        text-decoration: underline;
        text-decoration-color: rgba(255, 255, 255, 0.35);
        text-underline-offset: 0.2em;
        transition: text-decoration-color 0.2s ease;

        &:hover {
            text-decoration-color: #ffffff;
        }
    }

    .badges {
        display: inline-flex;
        gap: 0.375rem;

        :global(img) {
            width: auto;
            height: 28px;
        }
    }
</style>
