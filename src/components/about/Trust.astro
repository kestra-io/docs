---
import PixelEdges from "./PixelEdges.astro"
import { Image } from "astro:assets"
import HairlineFigure from "~/components/partners/HairlineFigure.astro"
import soc2Img from "~/components/layout/assets/soc2.png"
import gdprImg from "~/components/layout/assets/gdpr.svg"

// `figure` names the Hairline figure drawn in the tile, when it has one;
// `badges` shows the certification badges next to the link.
const ITEMS = [
    {
        title: "Open source engine",
        text: "Apache 2.0, public issue tracker, public release notes, dependencies you can audit.",
        figure: "opensource" as const,
    },
    {
        title: "SOC 2 and GDPR",
        text: "Independently audited controls, with reports available on request.",
        href: "/security",
        cta: "Security overview",
        figure: "padlock" as const,
        badges: true,
    },
    {
        title: "Self-hosted and air-gapped",
        text: "Your network, your keys, no outbound connection required. Public administrations run it this way.",
        figure: "servers" as const,
    },
    {
        title: "Responsible disclosure",
        text: "Security issues are handled privately through GitHub security advisories.",
        href: "https://github.com/kestra-io/kestra/security",
        cta: "Report a vulnerability",
        figure: "patch" as const,
    },
]
---

<section class="trust">
    <PixelEdges left="wide" right="tall" />
    <div class="container">
        <header>
            <div>
                <span class="eyebrow">Trust and security</span>
                <h2>Built to be audited.</h2>
            </div>
            <p class="intro">How Kestra is built, run and audited.</p>
        </header>
        <ul>
            {
                ITEMS.map((item) => (
                    <li>
                        <div class="tile">
                            {item.figure && (
                                <HairlineFigure
                                    name={item.figure}
                                    dark="var(--tile-bg)"
                                />
                            )}
                        </div>
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                        <div class="actions">
                            {item.href && <a href={item.href}>{item.cta}</a>}
                            {item.badges && (
                                <span class="badges">
                                    <Image
                                        src={soc2Img}
                                        alt="SOC 2"
                                        height="28"
                                    />
                                    <Image
                                        src={gdprImg}
                                        alt="GDPR"
                                        height="28"
                                    />
                                </span>
                            )}
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .trust {
        @include section;
        position: relative;
        border-top: 1px solid var(--ks-border-primary);
        background: var(--ks-background-secondary);
    }

    header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem 4rem;
        margin-bottom: 3.5rem;

        .intro {
            @include lead;
            max-width: 360px;
            margin-top: 2.25rem;
            font-size: $font-size-md;

            @include media-breakpoint-down(md) {
                margin-top: 0;
            }
        }
    }

    .eyebrow {
        @include eyebrow;
    }

    h2 {
        @include title;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 2rem 1rem;
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: 1fr;
        }
    }

    // A dark tile holding each item's Hairline figure.
    .tile {
        aspect-ratio: 1;

        // Squares get too tall at full width on phones.
        @include media-breakpoint-down(sm) {
            aspect-ratio: 2 / 1;
        }

        --tile-bg: #111114;

        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
        border-radius: 8px;
        background: var(--tile-bg);

        :global(html.dark) & {
            --tile-bg: var(--ks-border-primary);
        }
    }

    h3 {
        margin: 0 0 0.375rem;
        font-size: $font-size-lg;
        font-weight: 600;
    }

    li p {
        margin: 0 0 0.75rem;
        font-size: $font-size-sm;
        line-height: 1.6;
        color: var(--ks-content-secondary);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1rem;
    }

    a {
        @include text-link;
        font-size: $font-size-sm;
    }

    .badges {
        display: inline-flex;
        gap: 0.375rem;

        :global(img) {
            width: auto;
            height: 28px;
        }
    }
</style>
