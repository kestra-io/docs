---
const ITEMS = [
    {
        title: "Open source engine",
        text: "Apache 2.0, public issue tracker, public release notes, dependencies you can audit.",
        tone: "violet",
        // a branch merging back into the main line
        art: `<circle cx="40" cy="30" r="7"/><circle cx="40" cy="90" r="7"/><circle cx="82" cy="52" r="7"/>
            <path d="M40 37v46"/><path d="M82 59c0 16-14 20-36 26"/>
            <path d="M22 20l-10 10 10 10"/><path d="M98 80l10 10-10 10"/>`,
    },
    {
        title: "SOC 2 and GDPR",
        text: "Independently audited controls, with reports available on request.",
        href: "/security",
        cta: "Security overview",
        tone: "pink",
        // a shield with a check
        art: `<path d="M60 14l36 13v26c0 25-15 42-36 53-21-11-36-28-36-53V27z"/>
            <path d="M44 60l11 11 22-24"/>`,
    },
    {
        title: "Self-hosted and air-gapped",
        text: "Your network, your keys, no outbound connection required. Public administrations run it this way.",
        tone: "blue",
        // a server rack, cut off from the outside
        art: `<rect x="30" y="34" width="44" height="18" rx="3"/><rect x="30" y="56" width="44" height="18" rx="3"/>
            <rect x="30" y="78" width="44" height="18" rx="3"/>
            <path d="M38 43h4M38 65h4M38 87h4"/><path d="M74 43h18"/><path d="M98 43h10"/>
            <path d="M92 36l6 14"/>`,
    },
    {
        title: "Responsible disclosure",
        text: "Security issues are handled privately through GitHub security advisories.",
        href: "https://github.com/kestra-io/kestra/security",
        cta: "Report a vulnerability",
        tone: "green",
        // a padlock
        art: `<rect x="32" y="52" width="56" height="46" rx="6"/><path d="M44 52V40a16 16 0 0132 0v12"/>
            <circle cx="60" cy="72" r="5"/><path d="M60 77v9"/>`,
    },
]
---

<section class="trust">
    <div class="container">
        <header>
            <div>
                <span class="eyebrow">Trust and security</span>
                <h2>Built to be audited.</h2>
            </div>
            <p class="lead">How Kestra is built, run and audited.</p>
        </header>
        <ul>
            {
                ITEMS.map((item) => (
                    <li>
                        <div class:list={["tile", item.tone]}>
                            <svg
                                viewBox="0 0 120 120"
                                aria-hidden="true"
                                set:html={item.art}
                            />
                        </div>
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                        {item.href && <a href={item.href}>{item.cta}</a>}
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style lang="scss">
    @use "./style/section" as *;

    .trust {
        @include section;
        border-top: 1px solid var(--ks-border-primary);
        background: var(--ks-background-secondary);
    }

    header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem 4rem;
        margin-bottom: 3.5rem;

        .lead {
            @include lead;
            max-width: 360px;
            margin-top: 2.25rem;
            font-size: $font-size-md;

            @include media-breakpoint-down(md) {
                margin-top: 0;
            }
        }
    }

    .eyebrow {
        @include eyebrow;
    }

    h2 {
        @include title;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;

        @include media-breakpoint-down(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 2rem 1rem;
        }

        @include media-breakpoint-down(sm) {
            grid-template-columns: 1fr;
        }
    }

    // Soft color fields, each holding one line drawing; small squares mark
    // the corners, as on the team photos.
    .tile {
        --mark: rgba(255, 255, 255, 0.7);

        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
        margin-bottom: 1.25rem;
        background:
            linear-gradient(var(--mark), var(--mark)) top left / 6px 6px
                no-repeat,
            linear-gradient(var(--mark), var(--mark)) top right / 6px 6px
                no-repeat,
            linear-gradient(var(--mark), var(--mark)) bottom left / 6px 6px
                no-repeat,
            linear-gradient(var(--mark), var(--mark)) bottom right / 6px 6px
                no-repeat,
            var(--wash);

        &.violet {
            --wash: linear-gradient(155deg, #cbbcff 0%, #7b47ff 100%);
        }

        &.pink {
            --wash: linear-gradient(155deg, #ffc6da 0%, #ec4f8a 100%);
        }

        &.blue {
            --wash: linear-gradient(155deg, #c3d6ff 0%, #4a6ee0 100%);
        }

        &.green {
            --wash: linear-gradient(155deg, #bff0df 0%, #26a383 100%);
        }

        svg {
            width: 52%;
            height: auto;
            fill: none;
            stroke: #fff;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.4s ease;
        }
    }

    li:hover .tile svg {
        transform: translateY(-4px) scale(1.04);
    }

    h3 {
        margin: 0 0 0.375rem;
        font-size: $font-size-lg;
        font-weight: 600;
    }

    li p {
        margin: 0 0 0.75rem;
        font-size: $font-size-sm;
        line-height: 1.6;
        color: var(--ks-content-secondary);
    }

    a {
        @include text-link;
        font-size: $font-size-sm;
    }
</style>
