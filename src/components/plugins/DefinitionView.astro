---
import PluginsMarkdownRender from "./PluginsMarkdownRender.vue"
import PluginDocsFrame from "./PluginDocsFrame.astro"

interface Props {
    schema: any
    pluginType: string
    pluginArtifactCoordinate?: string
}

const { schema, pluginType, pluginArtifactCoordinate } = Astro.props
---

<PluginDocsFrame>
    <PluginsMarkdownRender
        {schema}
        {pluginType}
        {pluginArtifactCoordinate}
        client:idle
    />
</PluginDocsFrame>