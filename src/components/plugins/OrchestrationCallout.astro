---
import type { PluginOrchestrationLink } from "~/utils/orchestrationLink"

interface Props {
    links: PluginOrchestrationLink[]
}

const { links } = Astro.props
---

{
    links.length > 0 && (
        <aside class="orchestration-callout" aria-label="Orchestration guides">
            <ul>
                {links.map((link) => (
                    <li>
                        <a href={`/orchestration/${link.slug}`}>
                            Orchestrate {link.toolName} with Kestra →
                        </a>
                    </li>
                ))}
            </ul>
        </aside>
    )
}

<style lang="scss">
    .orchestration-callout {
        margin: 1rem 0 1.5rem;
        padding: 0.5rem 1rem;
        border: 1px solid var(--ks-border-primary);
        border-left: 3px solid var(--ks-content-color-highlight);
        border-radius: 0.5rem;
        background: var(--ks-background-secondary);

        ul {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        a {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--ks-content-link);
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }
    }
</style>
