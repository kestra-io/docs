---
import { WEBINAR_HREF_EU, WEBINAR_HREF_US } from "./assistant/links"

// The Americas session is November 5 at 11 AM PT; the banner stays up until
// the end of that day in PT (PST, UTC-8), then hides itself client-side.
const endsAt = Date.UTC(2026, 10, 6, 8)
---

<aside class="webinar-banner" aria-label="Webinar">
    <p>
        <strong>Live webinar:</strong> Moving off VMware? Start with the orchestrator.
        <span class="sessions">
            <a href={WEBINAR_HREF_EU} target="_blank" rel="noopener"
                >Wed Nov 4, 2 PM CET</a
            >
            <a href={WEBINAR_HREF_US} target="_blank" rel="noopener"
                >Thu Nov 5, 11 AM PT</a
            >
        </span>
    </p>
</aside>
<script is:inline define:vars={{ endsAt }}>
    if (Date.now() >= endsAt)
        document.currentScript.previousElementSibling.remove()
</script>

<style lang="scss">
    @use "/src/assets/styles/variable" as *;

    .webinar-banner {
        background: #631bff;
        color: $white;
        padding: 0.625rem 1.5rem;
        text-align: center;

        p {
            margin: 0;
            font-size: 0.875rem;
            line-height: 1.5;
        }

        strong {
            font-weight: 600;
        }

        .sessions {
            display: inline-flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.25rem 1rem;
            margin-left: 0.75rem;
        }

        a {
            color: $white;
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 3px;

            &:hover {
                color: rgba($white, 0.85);
            }
        }

        @include media-breakpoint-down(md) {
            .sessions {
                display: flex;
                margin: 0.25rem 0 0;
            }
        }
    }
</style>
