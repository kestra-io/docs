---
import { Code } from "astro-expressive-code/components"
import SectionTitle from "~/components/security/SectionTitle.astro"

const STEPS = [
    {
        title: "Export",
        text: "A vRO administrator exports a .package from the Orchestrator client. If vRA starts your workflows, export the vRA content as well, so the brief can see what triggers them. Put both in one folder. Only the vRO package is required.",
        code: `my-estate/
├─ my-estate.package
└─ my-estate.vra-ng`,
        lang: "text",
    },
    {
        title: "Run",
        text: "One command. It shows the model it will use, which you can change or switch off, and asks four questions about how your estate works, such as where settings and secrets come from. Then it analyzes every workflow and writes the brief. It tells you the cost before anything is billed.",
        code: `$ kestra-migrate vra run ./my-estate

Before the analysis, 4 questions about your estate.`,
        lang: "bash",
    },
    {
        title: "Read the brief, then sharpen it",
        text: "The brief opens in your browser, with every assumption the tool made listed in it. To make it sharper, run the same command again: it asks the few questions that change the brief most, and you can skip any of them or stop and carry on later. Your answers are kept in answers.yaml.",
        code: `$ kestra-migrate vra run ./my-estate

To sharpen the brief: 5 questions (about 2 minutes), the ones that change it most first.`,
        lang: "bash",
    },
]
---

<section class="process">
    <div class="container">
        <SectionTitle title="How it works">
            It takes three steps, all on your machine.
        </SectionTitle>

        <ol class="list-unstyled">
            {
                STEPS.map((step, i) => (
                    <li>
                        <div>
                            <span class="step">{i + 1}</span>
                            <h3>{step.title}</h3>
                            <p>{step.text}</p>
                        </div>
                        <Code
                            code={step.code}
                            lang={step.lang}
                            frame="none"
                            class="dark"
                        />
                    </li>
                ))
            }
        </ol>
    </div>
</section>

<style lang="scss">
    @use "/src/components/vra-migration-guide/shared" as *;

    .process {
        @include squared-grid-backdrop;
        @include assistant-section(var(--ks-background-secondary));
    }

    .container {
        @include guide-container;
    }

    ol {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        margin: 1rem 0 0;

        @include media-breakpoint-up(xl) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    li {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
        @include calc-card;
        box-shadow: $calc-shadow-surface;

        > div {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .step {
            padding: 0.125rem 0.5rem;
            border-radius: 6px;
            background: color-mix(
                in srgb,
                var(--blue-300) 10%,
                var(--ks-background-body)
            );
            font-size: $font-size-sm;
            font-weight: 600;
            line-height: 1.25rem;
            color: var(--blue-400);

            :global(html.dark) & {
                color: var(--blue-300);
            }
        }

        h3 {
            margin: 0;
            font-size: $font-size-2xl;
            line-height: 2.375rem;
        }

        p {
            margin: 0;
        }
    }

    // `:root` outranks Expressive Code's `:root:not(.dark) .expressive-code.dark`,
    // so these dark blocks keep this box in light mode too.
    :global(:root) li :global(.expressive-code.dark) {
        --ec-codeBg: #{$dark-bg-input};
        --ec-frm-edBg: #{$dark-bg-input};
        --ec-brdCol: transparent;
        --ec-brdRad: #{$border-radius-lg};
        --ec-codeFontSize: #{$font-size-xs};
        --ec-codeLineHt: 1.5rem;
        // `class="dark"` opts out of markdown.scss's code-block defaults, so
        // the font, flat frame and "Copied!" colour are restated here.
        --ec-codeFontFml: var(--font-family-jetbrains-mono);
        --ec-frm-frameBoxShdCssVal: none;
        --ec-frm-tooltipSuccessBg: var(--ks-background-button-primary);
        min-height: 105px;

        :global(pre) {
            margin: 0;
        }

        :global(pre[data-language])::before {
            display: none;
        }
    }
</style>
