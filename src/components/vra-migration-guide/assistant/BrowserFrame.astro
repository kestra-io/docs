---
interface Props {
    path: string
}

const { path } = Astro.props
---

<div class="browser-frame">
    <div class="tab-bar" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="path">{path}</span>
    </div>
    <div class="viewport">
        <slot />
    </div>
</div>

<style lang="scss">
    .browser-frame {
        overflow: hidden;
        border: 1px solid $dark-border-strong;
        border-radius: $border-radius-lg;
        background: $black;
        box-shadow: 0 8px 24px rgba($black, 0.65);

        .tab-bar {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #424242;
        }

        .dots {
            display: flex;
            gap: 0.375rem;

            i {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: $dark-raised;
            }
        }

        .path {
            font-size: $font-size-xs;
            line-height: 1rem;
            color: $dark-text-secondary;
        }

        .viewport :global(img) {
            display: block;
            width: 100%;
            height: auto;
        }
    }
</style>
