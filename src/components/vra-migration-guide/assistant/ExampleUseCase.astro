---
import { Image } from "astro:assets"
import answers from "../assets/assistant-brief-answers.png"
import translation from "../assets/assistant-brief-translation.png"
import waves from "../assets/assistant-brief-waves.png"
import workflow from "../assets/assistant-brief-workflow.png"
import TabGroup from "~/components/common/TabGroup.astro"
import TabPanel from "~/components/common/TabPanel.astro"
import BrowserFrame from "./BrowserFrame.astro"

interface Props {
    downloadHref: string
}

const { downloadHref } = Astro.props

const PARTS = [
    {
        title: "vRA",
        text: "A Service Broker catalog item with a 13-field request form, a cloud template that creates the machines and their network, and five event subscriptions.",
    },
    {
        title: "vRO",
        text: "Four workflows (create, add machine, remove machine, delete), with 39 actions, four configuration elements and three resource elements behind them.",
    },
    {
        title: "Targets",
        text: "An F5 BIG-IP or an Avi load balancer, picked on the request form, and vCenter through the cloud template.",
    },
]

const TABS = [
    {
        label: "Your answers",
        title: "Open questions, answered",
        text: "Open questions in plain words, with suggested answers.",
        image: answers,
        alt: "The answers.yaml file the Migration Assistant writes: open questions about the non-production vCenter, Avi and F5 endpoints, then suggested answers for the vRO plugin list, how flows call Avi, how they sign in and whether they check its certificate.",
        // The file is drawn with its own window bar, so no browser frame.
        frame: false,
    },
    {
        label: "Translation",
        title: "How each part maps to Kestra",
        text: "Each part of the service, what it becomes in Kestra, and whether it converts directly or needs a redesign. Shown after the open questions were answered.",
        callouts: [
            "Every element has a path to Kestra",
            "Direct converts one for one",
            "Redesign is where vRA itself goes away",
        ],
        image: translation,
        alt: "The brief's recommendation to convert: 59 of 59 elements have a path to Kestra and 47 are ready now, with a table of each vRA and vRO part, what it becomes in Kestra, and whether it converts directly or needs a redesign.",
        markers: [
            { left: 14.4, top: 18.9 },
            { left: 80, top: 49.8 },
            { left: 80, top: 74.4 },
        ],
    },
    {
        label: "Waves",
        title: "Two waves",
        text: "Two waves, with what each one needs before it starts.",
        image: waves,
        alt: "The two waves in the brief: Wave 1 holds the four load-balancer workflows with all 30 entry criteria met, and Wave 2 replaces vRA's app, flow and resources, starting once Wave 1 is migrated and verified, with 15 of 16 criteria met.",
    },
    {
        label: "One Workflow",
        title: "One workflow up close",
        text: "What one workflow does, what starts it and what it touches.",
        image: workflow,
        alt: "The brief's page for the LB - Create Load Balancer workflow: a Convert verdict with readiness amber and spec confidence high, a flowchart of its items, and the model-written purpose and decisions.",
    },
]
const SELECTED = 1
const GROUP = "assistant-example"
---

<section class="example surface-dark">
    <div class="container">
        <div class="intro-row">
            <div class="intro">
                <p class="eyebrow">Example</p>
                <h2>A self-service load balancer</h2>
                <p>
                    A load balancer ordered from the vRA catalog that stays in
                    sync as machines come and go. The brief recommended
                    converting rather than rebuilding. It mapped F5 to Kestra's
                    F5 plugin and Avi to HTTP tasks on Avi's REST API, and
                    proposed two waves.
                </p>
            </div>
            <ul class="parts">
                {
                    PARTS.map((part) => (
                        <li>
                            <h3>{part.title}</h3>
                            <p>{part.text}</p>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="tabs-panel">
            <TabGroup
                id={GROUP}
                label="The brief for the load balancer"
                variant="stages"
                surface="dark"
                flush
                selected={SELECTED}
                tabs={TABS.map((tab, i) => ({
                    label: `${i + 1}. ${tab.label}`,
                }))}
            >
                {
                    TABS.map((tab, i) => (
                        <TabPanel
                            group={GROUP}
                            index={i + 1}
                            selected={SELECTED}
                        >
                            <div class="panel">
                                <div class="copy">
                                    <h3>{tab.title}</h3>
                                    <p>{tab.text}</p>
                                    {tab.callouts && (
                                        <ol class="callouts">
                                            {tab.callouts.map((callout) => (
                                                <li>{callout}</li>
                                            ))}
                                        </ol>
                                    )}
                                </div>
                                <div class="shot">
                                    {tab.frame === false ? (
                                        <Image
                                            src={tab.image}
                                            alt={tab.alt}
                                            widths={[720, 1080, 1440]}
                                            sizes="(min-width: 1200px) 723px, 90vw"
                                        />
                                    ) : (
                                        <BrowserFrame path="kestra-assessment / index.html">
                                            <div class="marked">
                                                <Image
                                                    src={tab.image}
                                                    alt={tab.alt}
                                                    widths={[720, 1080, 1440]}
                                                    sizes="(min-width: 1200px) 723px, 90vw"
                                                />
                                                {tab.markers?.map((m, n) => (
                                                    <span
                                                        class="marker"
                                                        aria-hidden="true"
                                                        style={{
                                                            left: `${m.left}%`,
                                                            top: `${m.top}%`,
                                                        }}
                                                    >
                                                        {n + 1}
                                                    </span>
                                                ))}
                                            </div>
                                        </BrowserFrame>
                                    )}
                                </div>
                            </div>
                        </TabPanel>
                    ))
                }
            </TabGroup>
        </div>

        <div class="download">
            <p>
                The vRO package and vRA export are free to download, so you can
                run the Migration Assistant on them before you run it on your
                own.
            </p>
            <a class="btn btn-secondary btn-lg" href={downloadHref} download
                >Download the use case files</a
            >
        </div>
    </div>
</section>

<style lang="scss">
    @use "/src/components/vra-migration-guide/shared" as *;

    @mixin marker-pill {
        flex-shrink: 0;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background: $dark-accent;
        font-size: $font-size-sm;
        font-weight: 600;
        line-height: 1.25rem;
        color: $white;
    }

    .example {
        @include assistant-section($dark-section-bg, $white, $dark-raised);
    }

    .container {
        @include guide-container;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    p {
        margin: 0;
    }

    .intro-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;

        @include media-breakpoint-up(xl) {
            grid-template-columns: minmax(0, 472px) minmax(0, 1fr);
            padding-inline: 2rem;
        }
    }

    .intro {
        display: flex;
        flex-direction: column;
        gap: 1rem;

        > p:last-child {
            font-size: $font-size-lg;
            line-height: 1.75rem;
        }
    }

    .eyebrow {
        font-size: $font-size-lg;
        font-weight: 700;
        line-height: 1.75rem;
        color: $dark-link;
    }

    h2 {
        margin: 0;
        font-size: clamp(2.25rem, 4vw, 3rem);
        font-weight: 600;
        line-height: 1.04;
        letter-spacing: -0.015em;
        color: $white;
    }

    .parts {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;

        @include media-breakpoint-up(md) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        li {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 2rem;
            border: 1px solid $dark-raised;
            border-radius: $border-radius-lg;
            background: $dark-raised;
            box-shadow: 0 8px 12px rgba($black, 0.65);
        }

        h3 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 600;
            line-height: 1.75rem;
            color: $white;
        }

        p {
            font-size: 1rem;
            line-height: 1.5rem;
        }
    }

    .tabs-panel {
        overflow: hidden;
        padding: 2rem;
        border: 1px solid $dark-raised;
        border-radius: 1rem;
        background: $dark-bg-input;

        @include media-breakpoint-down(md) {
            padding: 1rem;
        }
    }

    .panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;

        @include media-breakpoint-up(xl) {
            grid-template-columns: minmax(0, 1fr) minmax(0, 723px);
        }
    }

    .copy {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        color: $white;

        @include media-breakpoint-up(xl) {
            padding: 2rem 0 2rem 2rem;
        }

        h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
            line-height: 1.75rem;
            letter-spacing: -0.005em;
            color: $white;
        }

        > p {
            font-size: 1rem;
            line-height: 1.5rem;
        }
    }

    .callouts {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
        counter-reset: callout;

        li {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            font-size: 1rem;
            line-height: 1.5rem;
            counter-increment: callout;

            &::before {
                content: counter(callout);
                @include marker-pill;
            }
        }
    }

    .marked {
        position: relative;
    }

    .marker {
        position: absolute;
        @include marker-pill;
    }

    .download {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem 2rem;
        padding: 1rem 2rem;
        border: 1px solid $dark-raised;
        border-radius: $border-radius-lg;
        background: $dark-raised;
        box-shadow: 0 8px 12px rgba($black, 0.65);

        @include media-breakpoint-up(lg) {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }

        p {
            max-width: 49rem;
            font-size: $font-size-lg;
            line-height: 1.75rem;
        }

        .btn {
            flex-shrink: 0;
            --ks-border-button-secondary: #{$dark-text-secondary};
        }
    }
</style>
