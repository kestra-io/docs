---
import { DOWNLOAD_DIALOG_TARGET, HELP_DIALOG_TARGET } from "../download"

interface Props {
    kind: "talk" | "pdf" | "calc" | "assistant" | "github" | "help"
    label?: string
    variant?: "primary" | "secondary"
}

const { kind, label, variant = "primary" } = Astro.props
---

{
    kind === "talk" && (
        <p class="guide-cta">
            <a class={`btn btn-${variant}`} href="/demo">
                {label ?? "Talk to our team"}
            </a>
        </p>
    )
}
{
    kind === "calc" && (
        <p class="guide-cta">
            <a
                class={`btn btn-${variant}`}
                href="/resources/migration/vra/payback"
            >
                {label ?? "Work out your payback"}
            </a>
        </p>
    )
}
{
    kind === "assistant" && (
        <p class="guide-cta">
            <a
                class={`btn btn-${variant}`}
                href="/resources/migration/vra/assistant"
            >
                {label ?? "Get the Kestra Migration Assistant for vRA"}
            </a>
        </p>
    )
}
{
    kind === "pdf" && (
        <p class="guide-cta">
            <button
                type="button"
                class={`btn btn-${variant}`}
                data-modal-target={DOWNLOAD_DIALOG_TARGET}
            >
                {label ?? "Download the PDF"}
            </button>
        </p>
    )
}

{
    kind === "github" && (
        <p class="guide-cta">
            <a
                class={`btn btn-${variant}`}
                href="https://github.com/kestra-io/migration-assistant"
                target="_blank"
                rel="noopener"
            >
                {label ?? "View on GitHub"}
            </a>
        </p>
    )
}
{
    kind === "help" && (
        <p class="guide-cta">
            <button
                type="button"
                class={`btn btn-${variant}`}
                data-modal-target={HELP_DIALOG_TARGET}
            >
                {label ?? "Need help running it?"}
            </button>
        </p>
    )
}

<style lang="scss">
    .guide-cta {
        margin: 1.25rem 0;
    }
</style>
