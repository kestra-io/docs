---
interface Props {
    label: string
    /** Large line shown under the label (lesson) */
    statement?: string
    variant?: "lesson" | "note" | "aside"
}

const { label, statement, variant = "note" } = Astro.props
---

<aside class={`guide-callout ${variant}`}>
    <p class="label">{label}</p>
    {statement && <p class="statement">{statement}</p>}
    <slot />
</aside>

<style lang="scss">
    .guide-callout {
        margin: 1.5rem 0;
        padding: 1.1rem 1.25rem;
        border: 1px solid var(--ks-border-secondary);
        border-left: 3px solid var(--ks-content-link);
        border-radius: $border-radius-lg;
        background: var(--ks-background-secondary);

        > :global(:last-child) {
            margin-bottom: 0;
        }

        &.aside {
            border-left-color: var(--ks-border-secondary);
        }
    }

    .label {
        margin: 0 0 0.4rem;
        font-size: $font-size-xs;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ks-content-link);
    }

    .statement {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--ks-content-primary);
    }
</style>
