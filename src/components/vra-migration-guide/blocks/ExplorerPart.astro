---
import Verdict, { type VerdictKind } from "./Verdict.astro"

interface Props {
    index: number
    label: string
    title: string
    verdicts: VerdictKind[]
}

const { index, label, title, verdicts } = Astro.props
const id = `vra-part-${index}`
const open = index === 1
---

<button
    type="button"
    class="part-button"
    id={`${id}-button`}
    style={`--row: ${index}`}
    aria-expanded={open ? "true" : "false"}
    aria-controls={`${id}-panel`}
>
    <small>{label}</small>
    <span>{title}</span>
</button>
<div
    class="part-panel"
    id={`${id}-panel`}
    role="region"
    aria-labelledby={`${id}-button`}
    hidden={!open}
>
    <div class="part-tabs" role="tablist" aria-label={title}>
        <button
            type="button"
            role="tab"
            data-part-tab="what"
            id={`${id}-tab-what`}
            aria-controls={`${id}-what`}
            aria-selected="true"
        >
            What this is
        </button>
        <button
            type="button"
            role="tab"
            data-part-tab="do"
            id={`${id}-tab-do`}
            aria-controls={`${id}-do`}
            aria-selected="false"
            tabindex="-1"
        >
            What to do with it
        </button>
    </div>
    <div
        class="part-view"
        role="tabpanel"
        id={`${id}-what`}
        aria-labelledby={`${id}-tab-what`}
        data-part-view="what"
    >
        <slot name="what" />
    </div>
    <div
        class="part-view"
        role="tabpanel"
        id={`${id}-do`}
        aria-labelledby={`${id}-tab-do`}
        data-part-view="do"
        hidden
    >
        <p class="verdicts">
            <span class="verdicts-label">The verdict</span>
            {verdicts.map((kind) => <Verdict kind={kind} />)}
        </p>
        <slot name="do" />
    </div>
</div>

<style lang="scss">
    .part-button {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1rem;
        padding: 0.75rem 1rem;
        border: 0;
        border-bottom: 1px solid var(--ks-border-secondary);
        background: var(--ks-background-body);
        color: var(--ks-content-secondary);
        text-align: left;
        font-size: $font-size-sm;

        @include media-breakpoint-up(md) {
            grid-column: 1;
            grid-row: var(--row);
            border-right: 1px solid var(--ks-border-secondary);
        }

        small {
            font-size: $font-size-xs;
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        span {
            font-weight: 600;
        }

        &[aria-expanded="true"] {
            background: var(--ks-background-secondary);
            color: var(--ks-content-primary);

            small {
                color: var(--ks-content-link);
            }
        }

        &:focus-visible {
            outline: 2px solid var(--ks-content-link);
            outline-offset: -2px;
        }
    }

    .part-panel {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--ks-border-secondary);
        font-size: $font-size-sm;

        @include media-breakpoint-up(md) {
            grid-column: 2;
            grid-row: 1 / -1;
            border-bottom: 0;
        }
    }

    .part-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;

        [role="tab"] {
            padding: 0.35rem 0.8rem;
            border: 1px solid var(--ks-border-secondary);
            border-radius: 999px;
            background: transparent;
            color: var(--ks-content-secondary);
            font-size: $font-size-sm;

            &[aria-selected="true"] {
                border-color: var(--ks-content-link);
                color: var(--ks-content-primary);
                font-weight: 600;
            }

            &:focus-visible {
                outline: 2px solid var(--ks-content-link);
                outline-offset: 2px;
            }
        }
    }

    .part-view > :global(:last-child) {
        margin-bottom: 0;
    }

    .verdicts {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
    }

    .verdicts-label {
        margin-right: 0.25rem;
        font-size: $font-size-xs;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ks-content-secondary);
    }
</style>
