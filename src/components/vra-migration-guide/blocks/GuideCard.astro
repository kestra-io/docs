---
interface Props {
    kicker?: string
    title?: string
    /** Heading level of the title: 3 under a chapter, 4 under a section. */
    level?: 3 | 4
}

const { kicker, title, level = 3 } = Astro.props
const Title = `h${level}` as const
---

<div class="guide-card">
    {kicker && <p class="kicker">{kicker}</p>}
    {title && <Title class="title">{title}</Title>}
    <slot />
</div>

<style lang="scss">
    @use "/src/components/vra-migration-guide/shared" as *;
    .guide-card {
        padding: 2rem;
        border: 1px solid var(--ks-border-secondary);
        border-radius: $border-radius-lg;
        background: var(--ks-background-primary);
        box-shadow: $box-shadow-sm;
        line-height: 1.5rem;
        color: var(--ks-content-secondary);

        > :global(:last-child) {
            margin-bottom: 0;
        }

        // Outranks the global `.bd-content p`, which would paint the body
        // primary.
        :global(p) {
            color: inherit;
        }

        :global(blockquote) {
            @include guide-quote(":global(p)");
            padding: 1rem;
            border: 0;

            :global(em) {
                font-weight: 500;
            }
        }
    }

    .kicker {
        margin: 0 0 0.75rem;
        font-size: $font-size-lg;
        font-weight: 600;
        line-height: 1.5rem;
        font-variant-numeric: tabular-nums;
        color: var(--ks-icon-color);
    }

    .title {
        margin: 0 0 0.75rem;
        font-size: 1.25rem;
        line-height: 1.75rem;
        letter-spacing: -0.01em;
        text-wrap: balance;
    }
</style>
