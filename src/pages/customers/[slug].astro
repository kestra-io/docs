---
import type { GetStaticPaths } from "astro"
import { getCollection, type CollectionEntry } from "astro:content"
import StoryDetail from "~/components/stories/StoryDetail.vue"
import SeeHow from "~/components/common/SeeHow.astro"
import Layout from "~/components/layout.astro"
import {
    collectionContentDigest,
    entryCacheKey,
    layoutDigest,
} from "~/utils/incrementalCacheKey"
import { relatedEntries, toSlug, toStory, toStoryCard } from "~/utils/stories"

interface Props {
    entry: CollectionEntry<"customerStories">
    related: {
        results: Story[]
        total: number
    }
}

export const getStaticPaths = (async () => {
    const allEntries = await getCollection("customerStories")

    // Related stories embed sibling bodies, so the whole collection keys a page.
    const scope = [collectionContentDigest(allEntries), await layoutDigest()]

    return allEntries.map((entry) => ({
        cacheKey: entryCacheKey(entry, ...scope),
        params: { slug: toSlug(entry) },
        props: {
            entry,
            related: {
                results: relatedEntries(entry, allEntries, 3).map(toStoryCard),
                total: allEntries.length,
            },
        },
    }))
}) satisfies GetStaticPaths

const { entry, related } = Astro.props

const story = toStory(entry)
const ctaCopy =
    entry.data.cta ??
    "Open source, self-hosted or cloud. Start with a blueprint and be in production today."
---

<Layout title={story.metaTitle} description={story.metaDescription}>
    <div class="main">
        <StoryDetail
            client:load
            slug={story.id}
            {story}
            content={story.content}
            {related}
        >
            <SeeHow
                slot="change"
                cta={{ text: "Try Kestra free", href: "/docs/quickstart" }}
            >
                <Fragment slot="title"
                    >See what you can build with Kestra.</Fragment
                >
                {ctaCopy}
                <a slot="footer" href="/customers" class="btn btn-secondary"
                    >Read more customer stories</a
                >
            </SeeHow>
        </StoryDetail>
    </div>
</Layout>

<style lang="scss">
    .main {
        overflow: clip;
    }
</style>
