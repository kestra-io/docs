---
import Layout from "~/components/layout.astro"
import PageShell from "~/components/home/PageShell.astro"
import ReplaceLegacy from "~/components/home/ReplaceLegacy.astro"
import Customers, { type Story } from "~/components/home/Customers.astro"
import { flat } from "~/components/home/flatLogo"
import EnterpriseShowcase from "~/components/enterprise/EnterpriseShowcase.astro"
import InfraHero from "~/components/infrastructure/InfraHero.astro"
import InfraMock from "~/components/infrastructure/InfraMock.astro"
import InfraMigration from "~/components/infrastructure/InfraMigration.astro"
import InfraClosing from "~/components/infrastructure/InfraClosing.astro"
import manufacturerPhoto from "~/components/enterprise/assets/manufacturer.jpg"
import dataportPhoto from "~/components/enterprise/assets/dataport.jpg"
import amdocsPhoto from "~/contents/customer-stories/amdocs-delivers-integration-environments-as-a-service-with-kestra/hero.jpeg"
import dataport from "~/assets/companies/dataport.svg?raw"
import amdocs from "~/components/home/assets/companies/amdocs.svg?raw"

const title = "Kestra for Infrastructure"
const description =
    "Kestra for Infrastructure turns your infrastructure as code into a governed service catalog for platform engineering teams."

const JOBS = [
    {
        icon: "mdi:file-search-outline",
        title: "Know what ran, what broke and why",
        text: "Kestra for Infrastructure runs every Terraform, Ansible and PowerCLI step as one execution with one record. When something fails, you trace it in one place instead of four consoles, and the failure opens a case with an owner.",
    },
    {
        icon: "mdi:timer-sand",
        title: "Give your platform team its time back",
        text: "Teams request what they need from a service catalog, and the request closes itself when the work is done. Nobody carries a ticket forward by hand, and approvals only stop the requests that need them.",
    },
    {
        icon: "mdi:account-clock-outline",
        title: "Stop paying for forgotten environments",
        text: "Every resource gets an owner and a lease, so idle environments are retired by a cleanup flow before they turn into line items. And no per-node licence grows with every server you automate.",
    },
    {
        icon: "mdi:robot-outline",
        title: "Run AI agents safely",
        text: "AI agents request through the same governed catalog as people, over MCP. Approvals, RBAC, SSO and an audit trail cover every action, self-hosted or air-gapped, and agents never hold credentials.",
    },
]

const PANELS = [
    {
        id: "requests" as const,
        tab: "Requests",
        icon: "mdi:file-document-outline",
        title: "Requests instead of tickets",
        intro: "Turn the infrastructure as code you already have into catalog items with a simple form. Developers, ops teams and AI agents pick what they need, and the request runs straight away instead of waiting in a queue.",
        points: [
            "Forms built on your own code, with defaults and guardrails your team sets",
            "Sign-offs only where you want them, such as production or high-cost requests",
            "One catalog for people and AI agents over MCP, under the same RBAC",
        ],
    },
    {
        id: "deployments" as const,
        tab: "Deployments",
        icon: "mdi:server-outline",
        title: "Know what exists and who owns it",
        intro: "Every request becomes a deployment you can see and act on. Teams find what they own in one place, and platform engineers stop chasing spreadsheets to work out what is still in use.",
        points: [
            "A status, an owner and a lease on every deployment",
            "Extend a lease or retire a resource from the same view",
            "Expired leases trigger a cleanup flow automatically",
        ],
    },
    {
        id: "cases" as const,
        tab: "Cases",
        icon: "mdi:alert-outline",
        title: "Failures become cases",
        intro: "When a run fails, Kestra for Infrastructure opens a case with the execution attached: inputs, logs and the step that broke. Someone owns the fix from the start, and the requester can follow progress without chasing anyone.",
        points: [
            "An assignee and an SLA on every case",
            "Linked to your ServiceNow or Jira ticket",
            "Full context for the fix, with no digging through four consoles",
        ],
    },
    {
        id: "assets" as const,
        tab: "Assets",
        icon: "mdi:layers-outline",
        title: "A live map of your resources",
        intro: "Every resource Kestra for Infrastructure creates is recorded as an asset, so your inventory updates itself instead of drifting from reality. Before you change or retire something, you can see what depends on it.",
        points: [
            "Owner, status and lineage for every VM, database and network",
            "Dependencies visible before you change or retire anything",
            "One inventory across clouds and hypervisors",
        ],
    },
]

const STORIES: Story[] = [
    {
        company: "Amdocs",
        photo: amdocsPhoto,
        story: "Amdocs",
        logo: flat(amdocs),
        height: 22,
        industry: "Telecom",
        stat: "Days → hours",
        label: "environment delivery time",
        more: [
            { stat: "Test-ready", label: "environments on delivery" },
            { stat: "2 months", label: "from evaluation to production" },
        ],
        quote: "From a technical point of view, Kestra sits at the first place.",
        author: "Alex Lernerman, DevOps Engineer, Amdocs",
    },
    {
        company: "Dataport",
        photo: dataportPhoto,
        story: "Dataport",
        logo: flat(dataport),
        height: 26,
        industry: "Public sector",
        stat: "3 weeks",
        label: "to validate compliance",
        more: [
            { stat: "1", label: "control plane for private-cloud automation" },
            { stat: "0", label: "external dependencies, fully self-hosted" },
        ],
        quote: "Kestra gives us a modern orchestration platform we can run ourselves without compromising on governance.",
        author: "Platform Architect, Dataport",
    },
    {
        company: "Fortune 500",
        photo: manufacturerPhoto,
        story: "Fortune 500 Company",
        industry: "Heavy industry",
        stat: "−90%",
        label: "in licensing cost vs Aria Automation",
        more: [{ stat: "30×", label: "faster time to deliver" }],
        quote: "We eliminated the high cost and risk of VMware vRA. What used to take 6 months now takes 6 days with Kestra!",
        author: "Principal Hosting",
    },
]
---

<Layout {title} {description} headerClean headerClear headerOverDark>
    <PageShell>
        <InfraHero />
        <InfraMigration />
        <Customers stories={STORIES} foot={false} placeholder={false}>
            <Fragment slot="title">
                Infrastructure teams that made the move
                <span>
                    What platform teams in industry, the public sector and
                    telecom say after moving their infrastructure automation to
                    Kestra.
                </span>
            </Fragment>
        </Customers>
        <ReplaceLegacy id="as-code" items={JOBS} ctas={[]}>
            <Fragment slot="title">
                Ditch disparate glue scripts with Kestra for Infrastructure
            </Fragment>
            <Fragment slot="lead">
                Cron jobs, CI pipelines and ticket queues each work on their
                own. Together, they hide what ran, slow every request, leave
                nobody accountable and give AI agents no safe way in.
            </Fragment>
        </ReplaceLegacy>
        <EnterpriseShowcase
            id="infra-showcase"
            label="Product areas"
            panels={PANELS}
        >
            <Fragment slot="title">
                One service catalog for IT automation
            </Fragment>
            <Fragment slot="lead">
                Keep the flexibility of your own Terraform, Ansible and PowerCLI
                code, on any cloud or hypervisor. Teams request from one
                catalog, and Kestra for Infrastructure tracks every resource
                from request to retirement.
            </Fragment>
            {PANELS.map((panel) => (
                <InfraMock slot={panel.id} view={panel.id} />
            ))}
        </EnterpriseShowcase>
        <InfraClosing />
    </PageShell>
</Layout>
