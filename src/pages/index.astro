---
import Layout from "~/components/layout.astro"
import SchemaSoftwareApplication from "~/components/common/SchemaSoftwareApplication.astro"
import Hero from "~/components/home/Hero.astro"
import ControlPlane from "~/components/home/ControlPlane.astro"
import AiGovernance from "~/components/home/AiGovernance.astro"
import HowItWorks from "~/components/home/HowItWorks.astro"
import ReplaceLegacy from "~/components/home/ReplaceLegacy.astro"
import RunKestra from "~/components/home/RunKestra.astro"
import Customers from "~/components/home/Customers.astro"
import Community from "~/components/home/Community.astro"
---

<Layout>
    <Fragment slot="head">
        <SchemaSoftwareApplication url="https://kestra.io" />
    </Fragment>
    <div class="home-page">
        <Hero />
        <ControlPlane />
        <AiGovernance />
        <HowItWorks />
        <ReplaceLegacy />
        <RunKestra />
        <Customers />
        <Community />
    </div>
</Layout>

<script>
    // Ask Header.vue for a quieter menu on this page, and drop the
    // request when navigating away.
    function requestCleanHeader() {
        if (!document.querySelector(".home-page")) return
        document.body.setAttribute("data-header-clean", "")
        document.addEventListener(
            "astro:before-swap",
            () => document.body.removeAttribute("data-header-clean"),
            { once: true },
        )
    }

    document.addEventListener("astro:page-load", requestCleanHeader)
    requestCleanHeader()
</script>

<style lang="scss">
    .home-page {
        overflow: clip;

        // Same width as the About us page.
        :global(.container) {
            @include media-breakpoint-up(xxl) {
                max-width: 1320px;
            }

            // A comfortable gutter on phones.
            @include media-breakpoint-down(md) {
                padding-left: 1.25rem;
                padding-right: 1.25rem;
            }
        }
    }
</style>
