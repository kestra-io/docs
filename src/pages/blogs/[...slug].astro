---
import { render, getCollection, type CollectionEntry } from "astro:content"
import { entryCacheKey, layoutDigest } from "~/utils/incrementalCacheKey"
import {
    fetchTotalPluginsCount,
    pluginCountScope,
} from "~/utils/plugins/pluginCount"
import { getImage, Image } from "astro:assets"
import Layout from "~/components/layout.astro"
import SubscribeToNewsletter from "~/components/layout/SubscribeToNewsletter.vue"
import BlogDetails from "~/components/blogs/BlogDetails.vue"
import BlogToc from "~/components/blogs/BlogToc.vue"
import BlogSocials from "~/components/blogs/BlogSocials.vue"
import BlogMobileHeader from "~/components/blogs/BlogMobileHeader.vue"
import TeamsImages from "~/utils/teamsImages"
import TwoColumnStickyLayout from "~/components/layouts/TwoColumnStickyLayout.vue"
import Mesh from "~/components/layout/Mesh.vue"
import Breadcrumb from "~/components/layout/Breadcrumb.vue"
import LivePluginCount from "~/components/content/LivePluginCount.astro"

export async function getStaticPaths() {
    const blogsPages = await getCollection("blogs")
    const scope = [await layoutDigest()]
    const totalPlugins = await fetchTotalPluginsCount()
    return blogsPages.map((post) => ({
        params: { slug: post.id.toLowerCase() },
        props: post,
        cacheKey: entryCacheKey(
            post,
            ...scope,
            ...pluginCountScope(totalPlugins, post.body),
        ),
    }))
}

type Props = CollectionEntry<"blogs">
const post = Astro.props
const { Content, headings } = await render(post)
const page = post.data

const links = headings.map((h) => ({
    text: h.text,
    id: h.slug,
    depth: h.depth,
}))

const editUrl = `https://github.com/kestra-io/docs/edit/main/src/contents/blogs/${post.id}/index.md`

const title = page.title ?? "Insights & News on Data Orchestration"
const metaTitle = page.metaTitle ?? title
const description =
    page.description ??
    "Explore the Kestra Blog for the latest articles, insights, product updates & engineering deep dives."
const { image, date, author, authors, lang = "en", languages = [] } = page

const staticImage = image
    ? await getImage({ src: image, format: "webp" })
    : null

// Same fallback as useBlogAuthors: an empty `authors` list defers to `author`.
const allAuthors = authors?.length ? authors : author ? [author] : []

// Transforms are recorded per page and replayed when the page is restored by the
// incremental build; a raw ImageMetadata src is not. 96px is 2x the rendered 48px.
const Avatars = Object.fromEntries(
    await Promise.all(
        allAuthors.map(async (a) => {
            const key = `${a.image}-sm.png`
            const original = TeamsImages[key]
            if (!original) return [key, undefined]
            const { src, attributes } = await getImage({
                src: original,
                width: 96,
            })
            return [
                key,
                { src, width: attributes.width, height: attributes.height },
            ]
        }),
    ),
)

const buildAuthor = (a: {
    name: string
    linkedin?: string | null
    medium?: string | null
}) => {
    const sameAs = [a.linkedin, a.medium].filter(Boolean)
    return {
        "@type": "Person",
        name: a.name,
        ...(sameAs.length > 0
            ? { sameAs: sameAs.length === 1 ? sameAs[0] : sameAs }
            : {}),
    }
}

const jsonLinkedData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.href,
    },
    headline: title,
    image: [staticImage ? `${Astro.url.origin}${staticImage.src}` : null],
    datePublished: date,
    ...(allAuthors.length > 0
        ? {
              author:
                  allAuthors.length === 1
                      ? buildAuthor(allAuthors[0])
                      : allAuthors.map(buildAuthor),
          }
        : {}),
    publisher: {
        "@type": "Organization",
        name: "Kestra",
        logo: { "@type": "ImageObject", url: "https://kestra.io/logo.svg" },
    },
    description: description,
}
---

<Layout
    title={metaTitle}
    breadcrumbTitle={title}
    description={description}
    image={staticImage?.src}
    canonical={page.canonical}
    lang={lang}
>
    {/* Direct child of Layout: Astro only honours `slot` on direct children,
        so inside <section> these tags rendered in the body, not <head>. */}
    <Fragment slot="head">
        <meta property="og:type" content="article" />
        <meta
            property="article:published_time"
            content={new Date(date).toISOString()}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLinkedData)}
        />
        {
            languages.map((l) => (
                <link
                    rel="alternate"
                    hreflang={l.code}
                    href={new URL(l.href, Astro.url.origin).href}
                />
            ))
        }
        {
            page.schema && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(page.schema)}
                />
            )
        }
    </Fragment>
    <section>
        <div class="hero-blog">
            <Mesh client:visible>
                <div
                    class="row d-flex justify-content-between align-items-center header-content"
                >
                    <div class="header-left">
                        <Breadcrumb
                            items={[
                                { label: "Home", href: "/" },
                                { label: "Blog", href: "/blogs" },
                                { label: title, href: "" },
                            ]}
                        />
                        {
                            languages.length > 1 && (
                                <ul class="lang-switch" aria-label="Language">
                                    {languages.map((l) => (
                                        <li>
                                            <a
                                                href={l.href}
                                                hreflang={l.code}
                                                lang={l.code}
                                                aria-current={
                                                    l.code === lang
                                                        ? "true"
                                                        : undefined
                                                }
                                            >
                                                {l.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )
                        }
                        <h1 class="header-title">{page.title}</h1>
                    </div>
                    {
                        page.image && (
                            <div class="header-image-container">
                                <Image
                                    class="header-image"
                                    src={page.image}
                                    alt={page.title}
                                    width={590}
                                    height={332}
                                />
                            </div>
                        )
                    }
                    <BlogMobileHeader blog={post} avatars={Avatars} />
                </div>
            </Mesh>
        </div>
        <TwoColumnStickyLayout>
            <div slot="sidebar" class="blog-sidebar">
                <BlogDetails blog={post} avatars={Avatars} />
                <BlogToc client:load links={links} />
                <div class="socials-desktop">
                    <BlogSocials
                        client:load
                        post={{ editUrl, title, url: Astro.url.href }}
                    />
                </div>
            </div>
            <div class="bd-content">
                <LivePluginCount body={post.body}>
                    <Content />
                </LivePluginCount>
            </div>
            <div class="socials-mobile">
                <BlogSocials
                    client:load
                    post={{ editUrl, title, url: Astro.url.href }}
                />
            </div>
        </TwoColumnStickyLayout>
        <SubscribeToNewsletter client:visible />
    </section>
</Layout>

<style lang="scss">
    .hero-blog :global(.mesh) {
        @include media-breakpoint-down(md) {
            padding-bottom: 1rem;
        }
    }

    .blog-sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        @include media-breakpoint-down(lg) {
            gap: 1rem;
        }
    }
    .header-content {
        gap: 44px;
        @include media-breakpoint-down(lg) {
            gap: 1.5rem;
        }
    }

    .header-left {
        max-width: 546px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;

        :global(.breadcrumb-item.active span) {
            display: block;
            max-width: 40ch;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }

    .header-title {
        margin: 0;
    }

    .lang-switch {
        display: flex;
        width: fit-content;
        margin: 0;
        padding: 0.1875rem;
        list-style: none;
        border: 1px solid var(--ks-border-primary);
        border-radius: 999px;
        background: var(--ks-background-primary);
        font-size: $font-size-sm;

        a {
            display: block;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            color: var(--ks-content-secondary);
            font-weight: 600;
            text-decoration: none;

            &:hover {
                color: var(--ks-content-primary);
            }

            &[aria-current="true"] {
                background: var(--ks-content-link);
                color: #fff;
            }
        }
    }

    .header-image-container {
        @include media-breakpoint-up(xl) {
            max-width: 589px;
            max-height: 331px;
        }
        width: 100%;
        height: auto;
        border-radius: 8px;
        overflow: hidden;
    }

    .header-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
        display: block;
    }

    .socials-desktop {
        @include media-breakpoint-down(md) {
            display: none;
        }
    }

    .socials-mobile {
        display: none;
        @include media-breakpoint-down(md) {
            display: block;
            margin-top: 4rem;
        }
    }

    // Figures written as raw HTML in posts: a Markdown image (so it still goes
    // through the image pipeline) wrapped in <figure> with a <figcaption>.
    .bd-content :global(figure) {
        margin: 0 0 1.5rem;

        :global(p) {
            margin: 0;
        }

        :global(img) {
            display: block;
            margin: 0 auto;
        }
    }

    .bd-content :global(figcaption) {
        margin-top: 0.5rem;
        text-align: center;
        font-size: 0.875em;
        font-style: italic;
        color: var(--ks-content-secondary);
    }

    // Clickable video poster: the image links to the webinar at a timestamp,
    // with a play icon and the clip length on top.
    .bd-content :global(figure.video-poster > a) {
        position: relative;
        display: block;
        border-radius: 8px;
        overflow: hidden;

        // The image is only a link target here, so it must not open the zoom.
        :global(img) {
            pointer-events: none;
        }
    }

    // Reuses the external-link icon pseudo-element as the hover darkening.
    .bd-content :global(figure.video-poster > a::after) {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        width: auto;
        height: auto;
        margin: 0;
        -webkit-mask: none;
        mask: none;
        background-color: rgba(0, 0, 0, 0);
        transition: background-color 0.2s ease;
    }

    .bd-content :global(figure.video-poster > a:hover::after),
    .bd-content :global(figure.video-poster > a:focus-visible::after) {
        background-color: rgba(0, 0, 0, 0.25);
    }

    .bd-content :global(.video-poster-play) {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 2;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background-color: rgba(10, 11, 13, 0.75);
        transform: translate(-50%, -50%);
        transition: transform 0.2s ease;

        &::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 54%;
            width: 22px;
            height: 24px;
            background-color: #fff;
            clip-path: polygon(0 0, 100% 50%, 0 100%);
            transform: translate(-50%, -50%);
        }

        @include media-breakpoint-down(md) {
            width: 48px;
            height: 48px;

            &::before {
                width: 16px;
                height: 18px;
            }
        }
    }

    .bd-content :global(figure.video-poster > a:hover .video-poster-play) {
        transform: translate(-50%, -50%) scale(1.08);
    }

    .bd-content :global(.video-poster-duration) {
        position: absolute;
        right: 0.75rem;
        bottom: 0.75rem;
        z-index: 2;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background-color: rgba(10, 11, 13, 0.8);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.5;
        font-variant-numeric: tabular-nums;
    }

    .bd-content :global(.key-takeaways) {
        margin: 0 0 1.5rem;
        padding-left: 20px;
        border-left: 3px solid var(--ks-border-active);

        :global(ul) {
            margin-bottom: 0;
        }
    }

    .bd-content :global(.key-takeaways-label) {
        margin-bottom: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ks-content-secondary);
    }

    .bd-content :global(.pull-quote-attribution) {
        margin-top: 0.5rem;
        font-size: 0.875em;
        color: var(--ks-content-secondary);
    }
</style>
