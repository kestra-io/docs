---
import { getEntry, render } from "astro:content"
import Layout from "~/components/layout.astro"
import CardGrid from "~/components/card/CardGrid.astro"
import SeeHow from "~/components/common/SeeHow.astro"
import Faq from "~/components/common/Faq.vue"
import BlogToc from "~/components/blogs/BlogToc.vue"
import BlogSocials from "~/components/blogs/BlogSocials.vue"
import ResourceDetails from "~/components/resources/ResourceDetails.vue"
import SimilarResources from "~/components/resources/SimilarResources.astro"
import TwoColumnStickyLayout from "~/components/layouts/TwoColumnStickyLayout.vue"
import Hero from "~/components/infrastructure-orchestration-whitepaper/Hero.astro"
import AuthorCard from "~/components/unified-orchestration-whitepaper/AuthorCard.astro"
import Link from "~/components/common/Link.astro"
import LivePluginCount from "~/components/content/LivePluginCount.astro"

import shapesImage from "~/components/airflow-2-eol-whitepaper/assets/cta-shapes.png"

const PDF_HREF = "https://hs.kestra.io/hubfs/kestra-infra-orchestration-whitepaper.pdf"
const READ_HREF = "#executive-summary"

const post = await getEntry("resources", "infrastructure-orchestration-whitepaper")
if (!post) throw new Error("resources/infrastructure-orchestration-whitepaper entry missing")
const { Content, headings } = await render(post)
const page = post.data

const title = page.metaTitle ?? page.title
const description = page.metaDescription ?? page.description

const editUrl = `https://github.com/kestra-io/docs/edit/main/src/contents/resources/${post.id}/index.md`

const tocLinks = headings
    .filter((h) => h.depth === 2)
    .map((h) => ({ text: h.text, id: h.slug, depth: h.depth }))

const jsonLinkedData = {
    "@context": "https://schema.org",
    "@type": "Article",
    mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
    headline: title,
    image: [`${Astro.url.origin}/og-image.png`],
    author: {
        "@type": "Person",
        name: "Kai Waehner",
        jobTitle: "Global Field CTO",
        worksFor: { "@id": "https://kestra.io/#organization" },
        sameAs: [
            "https://www.kai-waehner.de",
            "https://www.linkedin.com/in/kaiwaehner",
        ],
    },
    ...(page.date ? { datePublished: page.date } : {}),
    ...(page.lastUpdated ? { dateModified: page.lastUpdated } : {}),
    publisher: {
        "@type": "Organization",
        "@id": "https://kestra.io/#organization",
        name: "Kestra",
        logo: { "@type": "ImageObject", url: "https://kestra.io/logo.svg" },
    },
    description,
}

const faqItems = page.faq ?? []
const faqSchema =
    faqItems.length > 0
        ? {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              mainEntity: faqItems.map((item) => ({
                  "@type": "Question",
                  name: item.question,
                  acceptedAnswer: { "@type": "Answer", text: item.answer },
              })),
          }
        : null

const WHO_ITEMS = [
    {
        title: "<span class='persona-tag persona-tag--purple'>Platform and infrastructure automation leads</span>",
        description:
            "You run Terraform, Ansible, and a patch platform, and the chain between them lives in scripts and in people. You want one control plane above the tools you already trust, and a way to retire the glue without rewriting what works.",
    },
    {
        title: "<span class='persona-tag persona-tag--blue'>Heads of infrastructure and operations</span>",
        description:
            "Every node the AI buildout adds moves a license meter, the next renewal may reprice the stack, and auditors now ask for proof that each change ran as approved. You want to know which costs you can stop growing, and what evidence one control plane gives you.",
    },
    {
        title: "<span class='persona-tag persona-tag--green'>Enterprise architects</span>",
        description:
            "You own the target architecture. You need a clear boundary between the tools that execute work and the layer that coordinates it, and a way to test which platforms can carry data, application, and agent workloads later.",
    },
]
---

<Layout {title} {description}>
    <Fragment slot="head">
        <meta property="og:type" content="article" />
        {
            page.date && (
                <meta
                    property="article:published_time"
                    content={new Date(page.date).toISOString()}
                />
            )
        }
        {
            page.lastUpdated && (
                <meta
                    property="article:modified_time"
                    content={new Date(page.lastUpdated).toISOString()}
                />
            )
        }
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLinkedData)}
        />
        {
            page.schema && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(page.schema)}
                />
            )
        }
        {
            faqSchema && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(faqSchema)}
                />
            )
        }
    </Fragment>

    <Hero pdfHref={PDF_HREF} readHref={READ_HREF} />
    <CardGrid title="Who this is for" items={WHO_ITEMS} />

    <section class="whitepaper-content">
        {/* Static, as on blog and resource pages: hydrating it re-renders the
            article and drops the click-to-enlarge handlers on its images. */}
        <TwoColumnStickyLayout>
            <div slot="sidebar" class="whitepaper-sidebar">
                <ResourceDetails resource={post as any} />
                <BlogToc client:load links={tocLinks} />
                <div class="socials-desktop">
                    <BlogSocials
                        client:load
                        post={{ editUrl, title, url: Astro.url.href }}
                    />
                </div>
            </div>
            <div class="bd-content">
                <LivePluginCount body={post.body}>
                    <Content />
                </LivePluginCount>
            </div>
        </TwoColumnStickyLayout>
    </section>

    <AuthorCard />

    {
        faqItems.length > 0 && (
            <div class="whitepaper-faq">
                <Faq
                    title="Frequently asked questions"
                    items={faqItems}
                    client:visible
                />
            </div>
        )
    }

    <SimilarResources currentId={post.id} tag={page.tag} />

    <SeeHow
        imgSrc={shapesImage}
        cta={{
            text: "Download the PDF",
            href: PDF_HREF,
            download: true,
        }}
    >
        <Fragment slot="title">Start with one chain</Fragment>
        Take the paper with you, or start with the chain that already hurts: a
        patch wave, a provisioning request, a server commissioning run. The open
        source edition is the fastest way to run it as one governed workflow.
        <Fragment slot="footer">
            <Link href="/docs/quickstart" class="btn btn-secondary">
                Get Started
            </Link>
            <Link href="/demo" class="btn btn-secondary">Book a Demo</Link>
        </Fragment>
    </SeeHow>
</Layout>

<style lang="scss">
    .whitepaper-content {
        padding: 3rem 0;
    }

    .whitepaper-sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        @include media-breakpoint-down(lg) {
            gap: 1rem;
        }
    }

    .socials-desktop {
        @include media-breakpoint-down(md) {
            display: none;
        }
    }

    // This paper opens directly on its Executive summary heading, so this
    // rule matches nothing today. It stays so that a lead-in paragraph added
    // above that heading, such as a one-line definition of infrastructure
    // orchestration, is set larger than body copy without becoming a heading
    // and landing in the table of contents.
    .whitepaper-content :global(.bd-content > p:first-child) {
        font-size: 1.25rem;
        line-height: 1.55;
        font-weight: 500;
        color: var(--ks-content-primary);
        margin-bottom: 2rem;

        @include media-breakpoint-up(md) {
            font-size: 1.375rem;
        }
    }

    // The paper's sidebar is an info alert in the entry. The site's alert
    // style zeroes paragraph margins, which suits one-line notes but packs
    // these five paragraphs into one block, so the box gets a small label,
    // a title and normal paragraph spacing here.
    .whitepaper-content :global(.bd-content .doc-alert) {
        margin: 2rem 0;
        padding: 1.5rem 1.5rem 1.5rem 3.5rem;

        :global(p + p) {
            margin-top: 1rem;
        }

        :global(p:first-child) {
            font-size: $font-size-xs;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        :global(p:nth-child(2)) {
            margin-top: 0.25rem;
            font-size: 1.125rem;
        }
    }

    .whitepaper-faq :global(section.faq) {
        background: var(--ks-background-secondary);
    }

    :global(.persona-tag) {
        display: inline-flex;
        font-size: $font-size-sm;
        font-weight: 600;
        padding: 0.375rem 0.75rem;
        border-radius: 999px;
        line-height: 1;
    }

    :global(.persona-tag--green) {
        background-color: rgba(34, 197, 94, 0.12);
        color: #16a34a;

        :global(html.dark) & {
            color: #4ade80;
        }
    }

    :global(.persona-tag--blue) {
        background-color: rgba(59, 130, 246, 0.12);
        color: #2563eb;

        :global(html.dark) & {
            color: #60a5fa;
        }
    }

    :global(.persona-tag--purple) {
        background-color: rgba(159, 79, 237, 0.12);
        color: #7c3aed;

        :global(html.dark) & {
            color: #c084fc;
        }
    }
</style>
