---
import { getEntry, render } from "astro:content"
import Layout from "~/components/layout.astro"
import SeeHow from "~/components/common/SeeHow.astro"
import Faq from "~/components/common/Faq.vue"
import BlogToc from "~/components/blogs/BlogToc.vue"
import BlogSocials from "~/components/blogs/BlogSocials.vue"
import ResourceDetails from "~/components/resources/ResourceDetails.vue"
import SimilarResources from "~/components/resources/SimilarResources.astro"
import TwoColumnStickyLayout from "~/components/layouts/TwoColumnStickyLayout.vue"
import WhitepaperHero from "~/components/whitepaper/WhitepaperHero.astro"
import WhoItsFor from "~/components/whitepaper/WhoItsFor.astro"
import AuthorBlock from "~/components/whitepaper/AuthorBlock.astro"
import Link from "~/components/common/Link.astro"
import LivePluginCount from "~/components/content/LivePluginCount.astro"

import bookMockup from "~/components/unified-orchestration-whitepaper/assets/book-mockup.png"
import shapesImage from "~/components/airflow-2-eol-whitepaper/assets/cta-shapes.png"

const PDF_HREF = "/unified-orchestration-whitepaper-kestra.pdf"

const post = await getEntry("resources", "unified-orchestration-whitepaper")
if (!post)
    throw new Error("resources/unified-orchestration-whitepaper entry missing")
const { Content, headings } = await render(post)
const page = post.data

const title = page.metaTitle ?? page.title
const description = page.metaDescription ?? page.description

const editUrl = `https://github.com/kestra-io/docs/edit/main/src/contents/resources/${post.id}/index.md`

const tocLinks = headings
    .filter((h) => h.depth === 2)
    .map((h) => ({ text: h.text, id: h.slug, depth: h.depth }))

const jsonLinkedData = {
    "@context": "https://schema.org",
    "@type": "Article",
    mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
    headline: title,
    image: [`${Astro.url.origin}/og-image.png`],
    author: {
        "@type": "Person",
        name: "Kai Waehner",
        jobTitle: "Global Field CTO",
        worksFor: { "@id": "https://kestra.io/#organization" },
        sameAs: [
            "https://www.kai-waehner.de",
            "https://www.linkedin.com/in/kaiwaehner",
        ],
    },
    ...(page.date ? { datePublished: page.date } : {}),
    ...(page.lastUpdated ? { dateModified: page.lastUpdated } : {}),
    publisher: {
        "@type": "Organization",
        "@id": "https://kestra.io/#organization",
        name: "Kestra",
        logo: { "@type": "ImageObject", url: "https://kestra.io/logo.svg" },
    },
    description,
}

const faqItems = page.faq ?? []
const faqSchema =
    faqItems.length > 0
        ? {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              mainEntity: faqItems.map((item) => ({
                  "@type": "Question",
                  name: item.question,
                  acceptedAnswer: { "@type": "Answer", text: item.answer },
              })),
          }
        : null

const INSIDE = [
    "Why orchestration fragmented into four tool categories, and why agentic AI is not a fifth one",
    "What Gartner's SOAP and BOAT and Forrester's Adaptive Process Orchestration each got right about the convergence",
    "The seven requirements a platform has to meet before it earns the word unified",
    "The difference between orchestrating agents and agentic orchestration, and why an enterprise needs both",
]

const PERSONAS = [
    {
        tag: "Enterprise architects",
        text: "You own the map. You need a boundary between the layer that moves data and the layer that decides what happens next, and a test for which platforms actually span all four domains.",
    },
    {
        tag: "Platform and data engineering leaders",
        text: "You run one domain today and inherit the handoffs to the other three. You want the consolidation path that does not require ripping out the tools already in production.",
    },
    {
        tag: "CTOs and CIOs",
        text: "You are being asked to put agents into production. You need to know what governs their actions across data, infrastructure, applications and business processes before that happens.",
    },
]
---

<Layout {title} {description}>
    <Fragment slot="head">
        <meta property="og:type" content="article" />
        {
            page.date && (
                <meta
                    property="article:published_time"
                    content={new Date(page.date).toISOString()}
                />
            )
        }
        {
            page.lastUpdated && (
                <meta
                    property="article:modified_time"
                    content={new Date(page.lastUpdated).toISOString()}
                />
            )
        }
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLinkedData)}
        />
        {
            page.schema && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(page.schema)}
                />
            )
        }
        {
            faqSchema && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(faqSchema)}
                />
            )
        }
    </Fragment>

    <WhitepaperHero pdfHref={PDF_HREF} book={bookMockup} inside={INSIDE}>
        <Fragment slot="title">
            Unified Orchestration and Agentic AI: <span class="highlight"
                >One Control Plane</span
            > for Enterprise-Grade Automation
        </Fragment>
        Enterprise automation is fragmented across four domains: data, infrastructure,
        applications, and business processes. AI agents now act across all four. This
        paper defines what it takes to govern them on a single control plane.
    </WhitepaperHero>
    <WhoItsFor personas={PERSONAS} />

    <section class="whitepaper-content">
        {
            /* Static, as on blog and resource pages: hydrating it re-renders the
            article and drops the click-to-enlarge handlers on its images. */
        }
        <TwoColumnStickyLayout>
            <div slot="sidebar" class="whitepaper-sidebar">
                <ResourceDetails resource={post as any} />
                <BlogToc client:load links={tocLinks} />
                <div class="socials-desktop">
                    <BlogSocials
                        client:load
                        post={{ editUrl, title, url: Astro.url.href }}
                    />
                </div>
            </div>
            <div class="bd-content">
                <LivePluginCount body={post.body}>
                    <Content />
                </LivePluginCount>
            </div>
        </TwoColumnStickyLayout>
    </section>

    <AuthorBlock />

    {
        faqItems.length > 0 && (
            <div class="whitepaper-faq">
                <Faq
                    title="Frequently asked questions"
                    items={faqItems}
                    client:visible
                />
            </div>
        )
    }

    <SimilarResources currentId={post.id} tag={page.tag} />

    <SeeHow
        imgSrc={shapesImage}
        cta={{
            text: "Download the PDF",
            href: PDF_HREF,
            download: true,
        }}
    >
        <Fragment slot="title">Start with one workflow</Fragment>
        Take the paper with you, or skip straight to the engine: the open source edition
        runs in production, and the path from four silos to one platform starts with
        a single flow.
        <Fragment slot="footer">
            <Link href="/docs/quickstart" class="btn btn-secondary">
                Get Started
            </Link>
            <Link href="/demo" class="btn btn-secondary">Book a Demo</Link>
        </Fragment>
    </SeeHow>
</Layout>

<style lang="scss">
    @use "/src/components/whitepaper/page" as *;

    @include whitepaper-content;

    .whitepaper-sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        @include media-breakpoint-down(lg) {
            gap: 1rem;
        }
    }

    .socials-desktop {
        @include media-breakpoint-down(md) {
            display: none;
        }
    }

    // The article opens on the definition of unified orchestration. It is set
    // larger than body copy so it reads as the statement it is, without
    // becoming a heading and landing in the table of contents.
    .whitepaper-content :global(.bd-content > p:first-child) {
        font-size: 1.25rem;
        line-height: 1.55;
        font-weight: 500;
        color: var(--ks-content-primary);
        margin-bottom: 2rem;

        @include media-breakpoint-up(md) {
            font-size: 1.375rem;
        }
    }

    .whitepaper-faq :global(section.faq) {
        background: var(--ks-background-secondary);
    }
</style>
