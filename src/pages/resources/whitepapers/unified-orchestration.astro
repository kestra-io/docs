---
import { getEntry, render } from "astro:content"
import Layout from "~/components/layout.astro"
import CardGrid from "~/components/card/CardGrid.astro"
import SeeHow from "~/components/common/SeeHow.astro"
import Faq from "~/components/common/Faq.vue"
import BlogToc from "~/components/blogs/BlogToc.vue"
import BlogSocials from "~/components/blogs/BlogSocials.vue"
import ResourceDetails from "~/components/resources/ResourceDetails.vue"
import SimilarResources from "~/components/resources/SimilarResources.astro"
import TwoColumnStickyLayout from "~/components/layouts/TwoColumnStickyLayout.vue"
import Hero from "~/components/unified-orchestration-whitepaper/Hero.astro"
import Link from "~/components/common/Link.astro"

import shapesImage from "~/components/airflow-2-eol-whitepaper/assets/cta-shapes.png"

const PDF_HREF = "/unified-orchestration-whitepaper.pdf"
const READ_HREF = "#executive-summary"

const post = await getEntry("resources", "unified-orchestration")
if (!post) throw new Error("resources/unified-orchestration entry missing")
const { Content, headings } = await render(post)
const page = post.data

const title = page.metaTitle ?? page.title
const description = page.metaDescription ?? page.description

const editUrl = `https://github.com/kestra-io/docs/edit/main/src/contents/resources/${post.id}/index.md`

const tocLinks = headings
    .filter((h) => h.depth === 2)
    .map((h) => ({ text: h.text, id: h.slug, depth: h.depth }))

const jsonLinkedData = {
    "@context": "https://schema.org",
    "@type": "Article",
    mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
    headline: title,
    image: [`${Astro.url.origin}/og-image.png`],
    author: {
        "@type": "Person",
        name: "Kai Waehner",
        jobTitle: "Global Field CTO",
        worksFor: { "@id": "https://kestra.io/#organization" },
        sameAs: [
            "https://www.kai-waehner.de",
            "https://www.linkedin.com/in/kaiwaehner",
        ],
    },
    ...(page.date ? { datePublished: page.date } : {}),
    ...(page.lastUpdated ? { dateModified: page.lastUpdated } : {}),
    publisher: {
        "@type": "Organization",
        "@id": "https://kestra.io/#organization",
        name: "Kestra",
        logo: { "@type": "ImageObject", url: "https://kestra.io/logo.svg" },
    },
    description,
}

const faqItems = page.faq ?? []
const faqSchema =
    faqItems.length > 0
        ? {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              mainEntity: faqItems.map((item) => ({
                  "@type": "Question",
                  name: item.question,
                  acceptedAnswer: { "@type": "Answer", text: item.answer },
              })),
          }
        : null

const WHO_ITEMS = [
    {
        title: "<span class='persona-tag persona-tag--purple'>Enterprise architects</span>",
        description:
            "You own the map. You need a boundary between the layer that moves data and the layer that decides what happens next, and a test for which platforms actually span all four domains.",
    },
    {
        title: "<span class='persona-tag persona-tag--blue'>Platform and data engineering leaders</span>",
        description:
            "You run one domain today and inherit the handoffs to the other three. You want the consolidation path that does not require ripping out the tools already in production.",
    },
    {
        title: "<span class='persona-tag persona-tag--green'>CTOs and CIOs</span>",
        description:
            "You are being asked to put agents into production. You need to know what governs their actions across data, infrastructure, applications and business processes before that happens.",
    },
]
---

<Layout {title} {description}>
    <Fragment slot="head">
        <meta property="og:type" content="article" />
        {
            page.date && (
                <meta
                    property="article:published_time"
                    content={new Date(page.date).toISOString()}
                />
            )
        }
        {
            page.lastUpdated && (
                <meta
                    property="article:modified_time"
                    content={new Date(page.lastUpdated).toISOString()}
                />
            )
        }
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLinkedData)}
        />
        {
            page.schema && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(page.schema)}
                />
            )
        }
        {
            faqSchema && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(faqSchema)}
                />
            )
        }
    </Fragment>

    <Hero pdfHref={PDF_HREF} readHref={READ_HREF} />
    <CardGrid title="Who this is for" items={WHO_ITEMS} />

    <section class="whitepaper-content">
        <TwoColumnStickyLayout client:load>
            <div slot="sidebar" class="whitepaper-sidebar">
                <ResourceDetails resource={post as any} />
                <BlogToc client:load links={tocLinks} />
                <div class="socials-desktop">
                    <BlogSocials
                        client:load
                        post={{ editUrl, title, url: Astro.url.href }}
                    />
                </div>
            </div>
            <div class="bd-content">
                <Content />
            </div>
        </TwoColumnStickyLayout>
    </section>

    {
        faqItems.length > 0 && (
            <div class="whitepaper-faq">
                <Faq
                    title="Frequently asked questions"
                    items={faqItems}
                    client:visible
                />
            </div>
        )
    }

    <SimilarResources currentId={post.id} tag={page.tag} />

    <SeeHow
        imgSrc={shapesImage}
        cta={{
            text: "Download the PDF",
            href: PDF_HREF,
            download: true,
        }}
    >
        <Fragment slot="title">Start with one workflow</Fragment>
        Take the paper with you, or skip straight to the engine: the open source
        edition runs in production, and the path from four silos to one platform
        starts with a single flow.
        <Fragment slot="footer">
            <Link href="/docs/quickstart" class="btn btn-secondary">
                Get Started
            </Link>
            <Link href="/demo" class="btn btn-secondary">Book a Demo</Link>
        </Fragment>
    </SeeHow>
</Layout>

<style lang="scss">
    .whitepaper-content {
        padding: 3rem 0;
    }

    .whitepaper-sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        @include media-breakpoint-down(lg) {
            gap: 1rem;
        }
    }

    .socials-desktop {
        @include media-breakpoint-down(md) {
            display: none;
        }
    }

    .whitepaper-faq :global(section.faq) {
        background: var(--ks-background-secondary);
    }

    :global(.persona-tag) {
        display: inline-flex;
        font-size: $font-size-sm;
        font-weight: 600;
        padding: 0.375rem 0.75rem;
        border-radius: 999px;
        line-height: 1;
    }

    :global(.persona-tag--green) {
        background-color: rgba(34, 197, 94, 0.12);
        color: #16a34a;

        :global(html.dark) & {
            color: #4ade80;
        }
    }

    :global(.persona-tag--blue) {
        background-color: rgba(59, 130, 246, 0.12);
        color: #2563eb;

        :global(html.dark) & {
            color: #60a5fa;
        }
    }

    :global(.persona-tag--purple) {
        background-color: rgba(159, 79, 237, 0.12);
        color: #7c3aed;

        :global(html.dark) & {
            color: #c084fc;
        }
    }
</style>
