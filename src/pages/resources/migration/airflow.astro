---
import { getEntry } from "astro:content"
import { Image } from "astro:assets"
import Layout from "~/components/layout.astro"
import SchemaFAQ from "~/components/common/SchemaFAQ.astro"
import PageShell from "~/components/home/PageShell.astro"
import ReplaceLegacy from "~/components/home/ReplaceLegacy.astro"
import HowItWorks from "~/components/home/HowItWorks.astro"
import ControlPlane from "~/components/home/ControlPlane.astro"
import RunKestra from "~/components/home/RunKestra.astro"
import Enterprise from "~/components/home/Enterprise.astro"
import BuyerQuestions from "~/components/enterprise/BuyerQuestions.astro"
import MigrationTable from "~/components/migration/MigrationTable.astro"
import airflowLogo from "~/components/versus/assets/airflow.svg?raw"
import kestraLogo from "~/assets/logo-black.svg?raw"
import HowToChoose from "~/components/pricing/HowToChoose.astro"
import AfCompare from "~/components/airflow-migration-guide/AfCompare.astro"
import AfStep from "~/components/airflow-migration-guide/AfStep.astro"
import MigrationHero from "~/components/migration/MigrationHero.astro"
import AfHeroVisual from "~/components/airflow-migration-guide/AfHeroVisual.astro"
import AfScene from "~/components/airflow-migration-guide/AfScene.astro"
import bookMockup from "~/components/airflow-2-eol-whitepaper/assets/book-mockup.png"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"
import {
    HERO,
    HOW,
    LEAVE,
    MAPPING,
    OPERATORS,
    PITFALLS,
    PLAYBOOK_DOMAINS,
    STEPS,
    runEditions,
    COMPARE_ROWS,
} from "~/components/airflow-migration-guide/guide"

const post = await getEntry("resources", "airflow-migration-guide")
if (!post) throw new Error("resources/airflow-migration-guide entry missing")
const page = post.data
const totalPlugins = await fetchTotalPluginsCount()

const description = page.metaDescription ?? page.description
const faqItems = page.faq ?? []
const pageUrl = Astro.url.href.split("#")[0]
const WHITEPAPER_URL = "/resources/airflow-2-eol-whitepaper"

const twoColumns = (groups: typeof MAPPING | typeof OPERATORS) =>
    groups.map((group) => ({
        ...group,
        rows: group.rows.map((row) => ({ ...row, cells: row.cells.slice(0, 2) })),
    }))

const KESTRA_LOGO = kestraLogo.replaceAll('fill="#26282d"', 'fill="currentColor"')
const BRANDS = [
    { label: "Airflow", logo: airflowLogo },
    { label: "Kestra", logo: KESTRA_LOGO },
]

const REFERENCE = [
    {
        id: "af-ref-concepts",
        label: "Concepts",
        columns: BRANDS,
        widths: ["38%"],
        groups: twoColumns(MAPPING),
    },
    {
        id: "af-ref-operators",
        label: "Operators",
        columns: BRANDS,
        widths: ["38%"],
        groups: twoColumns(OPERATORS),
    },
    {
        id: "af-ref-pitfalls",
        label: "Pitfalls",
        columns: ["In the translated flow", "What to do"],
        widths: ["38%"],
        groups: PITFALLS,
    },
]

const jsonLinkedData = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    headline: page.title,
    image: [`${Astro.url.origin}/og-image.png`],
    author: { "@id": "https://kestra.io/#organization" },
    ...(page.date ? { datePublished: page.date } : {}),
    ...(page.lastUpdated ? { dateModified: page.lastUpdated } : {}),
    publisher: {
        "@type": "Organization",
        "@id": "https://kestra.io/#organization",
        name: "Kestra",
        logo: { "@type": "ImageObject", url: "https://kestra.io/logo.svg" },
    },
    description,
    proficiencyLevel: "Expert",
    dependencies: "Apache Airflow, Kestra",
}

const howToData = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Migrate from Airflow to Kestra in three steps",
    description: HERO.lead,
    step: STEPS.map((step, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: step.title,
        text: step.text,
        url: `${pageUrl}#af-playbook-title`,
    })),
}
---

<Layout
    title={page.metaTitle ?? page.title}
    {description}
    breadcrumbTitle={page.title}
    headerClean
    headerClear
    headerOverDark
>
    <Fragment slot="head">
        <meta property="og:type" content="article" />
        {page.date && (
            <meta
                property="article:published_time"
                content={new Date(page.date).toISOString()}
            />
        )}
        {page.lastUpdated && (
            <meta
                property="article:modified_time"
                content={new Date(page.lastUpdated).toISOString()}
            />
        )}
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLinkedData)}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(howToData)}
        />
        <SchemaFAQ items={faqItems} />
    </Fragment>
    <PageShell>
        <MigrationHero
            id="af-hero-title"
            title={HERO.title}
            lead={HERO.lead}
            ctas={HERO.ctas}
        >
            <AfHeroVisual />
        </MigrationHero>
        <ReplaceLegacy id="af-leave-title" items={LEAVE} ctas={[]}>
            <Fragment slot="title">
                Why teams leave Airflow
            </Fragment>
            <figure slot="after" class="quote">
                <svg viewBox="0 0 46 40" class="glyph" aria-hidden="true">
                    <path
                        d="M0 0v20.742h11.843c-.161 2.37-.822 6.365-3.33 9.113C6.543 32.01 3.757 33.06 0 33.06V40c5.683 0 10.228-1.823 13.513-5.417 4.062-4.446 5.244-10.484 5.422-13.835V0H0Z"
                    ></path>
                    <path
                        d="M27.06 0v20.742h11.842c-.161 2.37-.821 6.365-3.33 9.113-1.97 2.155-4.756 3.205-8.512 3.205V40c5.682 0 10.227-1.823 13.512-5.417 4.063-4.446 5.245-10.484 5.422-13.835V0H27.06Z"
                    ></path>
                </svg>
                <blockquote>
                    Apache Airflow is complex and has been challenging to
                    manage, with significant operational overhead.
                </blockquote>
                <figcaption>
                    Senior engineering manager,{" "}
                    <a href="/stories/apple">Apple's ML team</a>
                </figcaption>
            </figure>
        </ReplaceLegacy>
        <HowToChoose
            headingId="af-compare-choose"
            title="Airflow vs Kestra"
            columns={["Airflow", "Kestra"]}
            rows={COMPARE_ROWS(totalPlugins)}
        />
        <HowItWorks
            headingId={HOW.headingId}
            title={HOW.title}
            lead=""
            steps={HOW.steps}
            foot={HOW.foot}
        >
            <AfScene slot="scene-0" kind="translate" />
            <AfScene slot="scene-1" kind="backfill" />
            <AfScene slot="scene-2" kind="compare" />
        </HowItWorks>
        <AfCompare />
        <ControlPlane
            headingId="af-playbook-title"
            title="Migration plan"
            lead=""
            domains={PLAYBOOK_DOMAINS}
            bridge={false}
        >
            {PLAYBOOK_DOMAINS.map((domain, i) => (
                <AfStep slot={`visual-${domain.id}`} {...STEPS[i].visual} />
            ))}
        </ControlPlane>
        <Enterprise
            headingId="af-whitepaper-title"
            features={[]}
            layers={false}
        >
            <Fragment slot="title">
                <span>Before you move,</span> <em>read the whitepaper.</em>
            </Fragment>
            <Fragment slot="lead">
                Where the Airflow model works against growing teams, how
                declarative orchestration compares, and a decision tree for
                when to move.
            </Fragment>
            <Fragment slot="actions">
                <a href={WHITEPAPER_URL} class="btn-solid">
                    Read the whitepaper
                </a>
                <a href="/demo" class="btn-ghost">
                    Talk to a migration engineer
                </a>
            </Fragment>
            <Image
                slot="visual"
                src={bookMockup}
                alt="Cover of the Kestra Airflow whitepaper"
                class="book"
                width={1024}
            />
        </Enterprise>
        <MigrationTable
            id="af-map-title"
            title="Airflow to Kestra mapping"
            tabs={REFERENCE}
        />
        <RunKestra
            title="Where to run the flows"
            lead="The same flows run on all three editions."
            editions={runEditions()}
            compare={{ label: "Compare editions", href: "/pricing" }}
        />
        <BuyerQuestions title="Questions from Airflow teams" items={faqItems} />
    </PageShell>
</Layout>

<style lang="scss">

    .quote {
        --surface: #f0f0fd;
        --glyph: #4f6df7;

        display: grid;
        justify-items: start;
        gap: 1.5rem;
        margin: 0;
        padding: 3rem var(--inset);
        background: var(--surface);

        :global(html.dark) & {
            --surface: #1c1b2e;
            --glyph: #a796ff;
        }

        .glyph {
            width: 1.75rem;
            height: 1.5rem;
            fill: var(--glyph);
            transform: scaleX(-1);
        }

        blockquote {
            max-width: 46rem;
            margin: 0;
            font-size: clamp(1.25rem, 2vw, 1.5rem);
            font-weight: 500;
            line-height: 1.4;
            color: var(--ks-content-primary);
        }

        figcaption {
            font-size: 0.9375rem;
            color: var(--ks-content-tertiary);

            a {
                color: var(--ks-content-link);
            }
        }
    }

    :global(.book) {
        width: min(100%, 32rem);
        height: auto;
    }
</style>
