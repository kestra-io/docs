---
import { getEntry } from "astro:content"
import Layout from "~/components/layout.astro"
import SchemaFAQ from "~/components/common/SchemaFAQ.astro"
import PageShell from "~/components/home/PageShell.astro"
import BuyerQuestions from "~/components/enterprise/BuyerQuestions.astro"
import MigrationHero from "~/components/migration/MigrationHero.astro"
import MigrationHeroCli from "~/components/migration/MigrationHeroCli.astro"
import pipedreamMark from "~/components/pipedream-migration-guide/assets/pipedream.png"
import PdCompare from "~/components/pipedream-migration-guide/PdCompare.astro"
import ControlPlane from "~/components/home/ControlPlane.astro"
import PdDates from "~/components/pipedream-migration-guide/PdDates.astro"
import MigrationTable from "~/components/migration/MigrationTable.astro"
import RunKestra from "~/components/home/RunKestra.astro"
import {
    CHANGES,
    HERO_CLI,
    MAPPING_GROUPS,
    STEP_DOMAINS,
    runEditions,
} from "~/components/pipedream-migration-guide/guide"

const post = await getEntry("resources", "pipedream-migration-guide")
if (!post) throw new Error("resources/pipedream-migration-guide entry missing")
const page = post.data

const description = page.metaDescription ?? page.description
const faqItems = page.faq ?? []

const jsonLinkedData = {
    "@context": "https://schema.org",
    "@type": "Article",
    mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
    headline: page.title,
    image: [`${Astro.url.origin}/og-image.png`],
    author: { "@id": "https://kestra.io/#organization" },
    ...(page.date ? { datePublished: page.date } : {}),
    ...(page.lastUpdated ? { dateModified: page.lastUpdated } : {}),
    publisher: {
        "@type": "Organization",
        "@id": "https://kestra.io/#organization",
        name: "Kestra",
        logo: { "@type": "ImageObject", url: "https://kestra.io/logo.svg" },
    },
    description,
}
---

<Layout
    title={page.metaTitle ?? page.title}
    {description}
    breadcrumbTitle={page.title}
    headerClean
    headerClear
    headerOverDark
>
    <Fragment slot="head">
        <meta property="og:type" content="article" />
        {page.date && (
            <meta
                property="article:published_time"
                content={new Date(page.date).toISOString()}
            />
        )}
        {page.lastUpdated && (
            <meta
                property="article:modified_time"
                content={new Date(page.lastUpdated).toISOString()}
            />
        )}
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLinkedData)}
        />
        <SchemaFAQ items={faqItems} />
    </Fragment>
    <PageShell>
        <MigrationHero
            id="pd-hero-title"
            title="Migrate Pipedream workflows to Kestra"
            lead="Pipedream Workflows shuts down on March 31, 2027. Export the JSON, convert it to Kestra YAML with your coding agent, and repoint each webhook."
            ctas={[
                { label: "Request Kestra Cloud access", href: "/cloud", solid: true },
                { label: "Talk to our team", href: "/demo" },
            ]}
        >
            <MigrationHeroCli
                label="A Pipedream workflow converted to a Kestra flow from the command line"
                script={HERO_CLI}
                from={{ logo: pipedreamMark.src, label: "invoice-intake" }}
                to={{ label: "finance.invoice_intake" }}
            />
        </MigrationHero>
        <PdDates />
        <MigrationTable
            id="pd-changes-title"
            title={CHANGES.title}
            lead={CHANGES.lead}
            columns={CHANGES.columns}
            widths={["14%", "43%"]}
            groups={[{ title: "", icon: "", rows: CHANGES.rows.map((cells) => ({ cells })) }]}
        />
        <PdCompare />
        <ControlPlane
            headingId="pd-steps-title"
            title="From export to cutover"
            lead=""
            domains={STEP_DOMAINS}
            bridge={false}
        />
        <MigrationTable
            id="pd-map-title"
            title="Pipedream to Kestra mapping"
            lead="Every Pipedream construct, the Kestra feature that replaces it, and what you write in the flow YAML."
            columns={["Pipedream", "Kestra", "In the flow YAML"]}
            widths={["30%", "32%"]}
            groups={MAPPING_GROUPS}
        />
        <RunKestra
            title="Where to run the flows"
            lead="The same YAML runs on all three editions."
            editions={runEditions()}
            compare={{ label: "Compare editions", href: "/pricing" }}
        />
        <BuyerQuestions
            title="Questions from Pipedream teams"
            items={faqItems}
        />
    </PageShell>
</Layout>
