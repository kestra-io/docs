---
import { getCollection, type CollectionEntry } from "astro:content"
import {
    collectionMetadataDigest,
    entryCacheKey,
    layoutDigest,
} from "~/utils/incrementalCacheKey"
import ResourceArticle from "~/components/resources/ResourceArticle.astro"

export async function getStaticPaths() {
    const all = await getCollection("resources")
    // The similar-resources list is built from every entry's metadata.
    const scope = [collectionMetadataDigest(all), await layoutDigest()]
    return all
        .filter((post) => !post.data.href)
        .map((post) => ({
            params: {
                category: post.data.tag,
                topic: post.id.toLowerCase(),
            },
            props: { post },
            cacheKey: entryCacheKey(post, ...scope),
        }))
}

type Props = { post: CollectionEntry<"resources"> }
const { post } = Astro.props
---

<ResourceArticle post={post} />
