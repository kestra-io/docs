---
import Layout from "~/components/layout.astro"
import SchemaSoftwareApplication from "~/components/common/SchemaSoftwareApplication.astro"
import SchemaFAQ from "~/components/common/SchemaFAQ.astro"
import PageShell from "~/components/home/PageShell.astro"
import Enterprise from "~/components/home/Enterprise.astro"
import AiGovernance from "~/components/home/AiGovernance.astro"
import ReplaceLegacy from "~/components/home/ReplaceLegacy.astro"
import Customers, { type Story } from "~/components/home/Customers.astro"
import { flat } from "~/components/home/flatLogo"
import filaPhoto from "~/components/home/assets/customers/fila.jpg"
import fila from "~/assets/companies/fila.svg?raw"
import dataport from "~/assets/companies/dataport.svg?raw"
import creditAgricole from "~/contents/customer-stories/scaling-secure-infrastructure-at-credit-agricole-with-kestra/logo.svg?raw"
import EnterpriseHero from "~/components/enterprise/EnterpriseHero.astro"
import AgentControls from "~/components/enterprise/AgentControls.astro"
import EnterpriseShowcase from "~/components/enterprise/EnterpriseShowcase.astro"
import SupportPlans from "~/components/enterprise/SupportPlans.astro"
import BuyerQuestions from "~/components/enterprise/BuyerQuestions.astro"

const title = "Kestra Enterprise"
const description =
    "Kestra Enterprise gives your teams the security, governance, and operational capabilities to automate workflows across your organization."

const FEATURES = [
    {
        id: "access" as const,
        kicker: "Multi-tenancy",
        title: "Give every team secure access.",
        text: "Share one platform with isolated workflows, credentials, and execution environments. Namespaces, multi-tenancy, and role-based permissions control access, protect secrets, and isolate failures.",
    },
    {
        id: "reliability" as const,
        kicker: "SLA-backed support",
        title: "Keep critical workflows running reliably.",
        text: "Support business continuity with worker groups, backup and restore, maintenance mode, and SLA-backed support.",
    },
    {
        id: "governance" as const,
        kicker: "Audit and compliance",
        title: "Verifiable governance",
        text: "Show auditors who ran each workflow, with which permissions, and approval chains with SSO, RBAC, audit logs, policies, and approval gates.",
    },
    {
        id: "scale" as const,
        kicker: "Scalable architecture",
        title: "Built for your scale and your network.",
        text: "Pick the backend that fits your load: Postgres to start, then Redis, RabbitMQ or Kafka as volume grows. Mutual TLS between the controller and workers means only trusted workers can connect, wherever they run.",
    },
]

const DEPLOYMENTS = [
    {
        icon: "mdi:server-outline",
        title: "Self-hosted",
        text: "Kubernetes or VMs in your data center or your cloud account. The reference deployment for regulated industries.",
    },
    {
        icon: "mdi:shield-lock-outline",
        title: "Air-gapped",
        text: "No outbound connection required. Plugins and updates delivered offline.",
    },
    {
        icon: "mdi:lan",
        title: "Hybrid",
        text: "Control plane in one place; worker groups for the systems: on-prem, in each cloud, at the edge.",
    },
    {
        icon: "mdi:cloud-outline",
        title: "Kestra Cloud",
        text: "The same Kestra, run by us. For teams who would rather build flows than operate a platform.",
    },
]

const STORIES: Story[] = [
    {
        company: "FILA",
        photo: filaPhoto,
        story: "Fila",
        logo: flat(fila),
        height: 21,
        stat: "2.5M",
        label: "executions a month across 2,000+ workflows, ERP, PLM and supply chain in 70+ countries.",
        quote: "Instead of spending days fixing issues, we now have full visibility and control.",
        author: "John Kim, IT Lead",
    },
    {
        company: "Crédit Agricole",
        story: "Crédit Agricole",
        logo: flat(creditAgricole),
        height: 32,
        stat: "7 teams",
        label: "unified on 100+ managed clusters.",
        quote: "Secure, scalable, and manageable by all our teams.",
        author: "Julien Legrand, Data Product Owner",
    },
    {
        company: "Dataport",
        logo: flat(dataport),
        height: 26,
        stat: "3 weeks",
        label: "to validate compliance for German public administration, self-hosted, no external SaaS dependency.",
    },
    {
        company: "Fortune 500 manufacturer",
        stat: "90%",
        label: 'lower licensing costs after <a href="/resources/migration/vra">replacing</a> VMware Aria Automation with Kestra Enterprise.',
    },
]

const INCLUDED = [
    {
        list: [
            "Kestra Enterprise engine and all Enterprise plugins",
            "Unlimited executions, flows, tasks, apps and assets",
            "Multi-tenant, SSO, RBAC, audit logs, secrets, policies",
            "Worker groups, task runners, high-availability queue",
        ],
    },
    {
        list: [
            "Standard support with SLA; Premium and Platinum available",
            "Customer Success program (Platinum)",
            "Self-hosted, hybrid or air-gapped deployment",
            "Annual subscription sized to the project",
        ],
    },
]

const FAQ = [
    {
        question: "What is the difference between open source and Enterprise?",
        answer: "The engine, the YAML, the plugins and the execution model are identical. Enterprise adds the organization (multi-tenant, namespaces, worker groups, environments), the control (SSO, RBAC, secrets, audit, policies) and the experience (Apps, Copilot on any LLM, approvals), plus a commercial license and support with SLA. A flow moves between editions without changes.",
    },
    {
        question: "Enterprise or Kestra Cloud?",
        answer: "Same features, different operator. Enterprise is self-hosted: your Kubernetes, your network, your air gap. Kestra Cloud is managed by Kestra, usage-based, for teams who would rather not run it. The decision is deployment location and who operates, not features.",
    },
    {
        question: "How is it priced?",
        answer: "An annual subscription per instance, sized to your project: instances, environments, worker groups and support level. Executions, flows, tasks, apps and assets are unlimited.",
    },
    {
        question: "Can we run it fully air-gapped?",
        answer: "Yes. Several public administrations and industrial sites run Kestra Enterprise with no outbound connection. Plugins and updates are delivered offline.",
    },
    {
        question: "How long does a proof of concept take?",
        answer: "Most teams evaluate on open source first, so the proof of concept is about organization and governance rather than the engine. A guided trial on your use case typically runs a few weeks. [Confirm with field engineering.]",
    },
]
---

<Layout {title} {description}>
    <Fragment slot="head">
        <SchemaSoftwareApplication
            id="https://kestra.io/#enterprise-edition"
            name="Kestra Enterprise Edition"
            description="Kestra Enterprise is a workflow orchestration platform for engineering teams running mission-critical operations at scale. Built-in governance, enterprise security, SSO, RBAC, audit logs, and horizontal scalability. Self-hosted or managed."
            url="https://kestra.io/enterprise"
            isVariantOf="https://kestra.io/#software"
        />
        <SchemaFAQ items={FAQ} />
    </Fragment>
    <PageShell>
        <EnterpriseHero />
        <Enterprise features={FEATURES} layers={false} actions={false}>
            <Fragment slot="title">
                When open source is not enough, achieve more with Enterprise.
            </Fragment>
            <Fragment slot="lead">
                Keep the same engine, YAML, and plugins while adding more ways
                to organize teams and control access.
            </Fragment>
        </Enterprise>
        <AiGovernance eyebrow="Agentic AI" bridge={false} foot={false}>
            <Fragment slot="title">
                Your AI agents answer to the same governance as your teams.
            </Fragment>
            <Fragment slot="lead">
                Agents, MCP and the Copilot are open source. Enterprise controls
                what they can do: which workflows they can call, who can
                approve, and a record of every action.
            </Fragment>
            <AgentControls slot="cards" />
        </AiGovernance>
        <ReplaceLegacy
            id="where-kestra-runs"
            items={DEPLOYMENTS}
            ctas={[
                {
                    label: "Learn more",
                    href: "https://hs.kestra.io/hubfs/kestra-deployment-options-enterprise-edition.pdf",
                    external: true,
                },
            ]}
        >
            <Fragment slot="title">Where Kestra Runs</Fragment>
            <Fragment slot="lead">
                Run Kestra Enterprise in any environment you choose: your data
                center, your cloud accounts, across network zones, or fully
                air-gapped.
            </Fragment>
        </ReplaceLegacy>
        <EnterpriseShowcase />
        <Customers stories={STORIES} foot={false} placeholder={false}>
            <Fragment slot="title">What Customers Say</Fragment>
        </Customers>
        <SupportPlans />
        <ReplaceLegacy
            id="what-is-included"
            tone="muted"
            items={INCLUDED}
            ctas={[
                { label: "Book a demo", href: "/demo", solid: true },
                { label: "Compare editions", href: "/pricing#compare" },
            ]}
        >
            <Fragment slot="title">What is included</Fragment>
        </ReplaceLegacy>
        <BuyerQuestions items={FAQ} />
    </PageShell>
</Layout>
