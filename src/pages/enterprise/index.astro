---
import Layout from "~/components/layout.astro"
import SchemaSoftwareApplication from "~/components/common/SchemaSoftwareApplication.astro"
import SchemaFAQ from "~/components/common/SchemaFAQ.astro"
import PageShell from "~/components/home/PageShell.astro"
import AiGovernance from "~/components/home/AiGovernance.astro"
import Customers, { type Story } from "~/components/home/Customers.astro"
import { flat } from "~/components/home/flatLogo"
import filaPhoto from "~/components/home/assets/customers/fila.jpg"
import creditAgricolePhoto from "~/components/enterprise/assets/credit-agricole.jpg"
import dataportPhoto from "~/components/enterprise/assets/dataport.jpg"
import manufacturerPhoto from "~/components/enterprise/assets/manufacturer.jpg"
import fila from "~/assets/companies/fila.svg?raw"
import dataport from "~/assets/companies/dataport.svg?raw"
import creditAgricole from "~/contents/customer-stories/scaling-secure-infrastructure-at-credit-agricole-with-kestra/logo.svg?raw"
import EnterpriseHero from "~/components/enterprise/EnterpriseHero.astro"
import CustomerLogos from "~/components/enterprise/CustomerLogos.astro"
import Deployments from "~/components/enterprise/Deployments.astro"
import Enterprise from "~/components/home/Enterprise.astro"
import AgentZones from "~/components/enterprise/AgentZones.astro"
import AgentControls from "~/components/enterprise/AgentControls.astro"
import EnterpriseShowcase from "~/components/enterprise/EnterpriseShowcase.astro"
import Included from "~/components/enterprise/Included.astro"
import SupportPlans from "~/components/enterprise/SupportPlans.astro"
import BuyerQuestions from "~/components/enterprise/BuyerQuestions.astro"

const title = "Kestra Enterprise"
const description =
    "Kestra Enterprise gives your teams the security, governance, and operational capabilities to automate workflows across your organization."

const FEATURES = [
    {
        id: "access" as const,
        title: "Give every team secure access.",
        text: "Share one platform with isolated workflows, credentials, and execution environments. Namespaces, multi-tenancy, and role-based permissions control access, protect secrets, and isolate failures.",
    },
    {
        id: "reliability" as const,
        title: "Keep critical workflows running reliably.",
        text: "Workflows keep running through outages and upgrades, with worker groups, backup and restore, and maintenance mode.",
    },
    {
        id: "governance" as const,
        title: "Answer every audit question.",
        text: "Show auditors who ran each workflow, with which permissions and whose approval, through SSO, RBAC, audit logs, policies, and approval gates.",
    },
    {
        id: "scale" as const,
        title: "Scale on the backend you choose, inside your network.",
        text: "Pick the backend that fits your load: Postgres to start, then Redis, RabbitMQ or Kafka as volume grows. Mutual TLS between the controller and workers means only trusted workers can connect, wherever they run.",
    },
]

const STORIES: Story[] = [
    {
        company: "FILA",
        photo: filaPhoto,
        story: "Fila",
        logo: flat(fila),
        height: 21,
        stat: "2.5M",
        label: "executions a month across 2,000+ workflows, ERP, PLM and supply chain in 70+ countries.",
        quote: "Instead of spending days fixing issues, we now have full visibility and control.",
        author: "John Kim, IT Lead",
    },
    {
        company: "Crédit Agricole",
        photo: creditAgricolePhoto,
        story: "Crédit Agricole",
        logo: flat(creditAgricole),
        height: 32,
        stat: "7 teams",
        label: "unified on 100+ managed clusters.",
        quote: "Secure, scalable, and manageable by all our teams.",
        author: "Julien Legrand, Data Product Owner",
    },
    {
        company: "Dataport",
        photo: dataportPhoto,
        logo: flat(dataport),
        height: 26,
        stat: "3 weeks",
        label: "to validate compliance for German public administration, self-hosted, no external SaaS dependency.",
        quote: "Kestra gives us a modern orchestration platform we can run ourselves without compromising on governance.",
        author: "Platform Architect",
    },
    {
        company: "Fortune 500 manufacturer",
        photo: manufacturerPhoto,
        stat: "90%",
        label: 'lower licensing costs after <a href="/resources/migration/vra">replacing</a> VMware Aria Automation with Kestra Enterprise.',
        quote: "We eliminated the high cost and risk of VMware vRA. What used to take 6 months now takes 6 days with Kestra.",
        author: "Principal Hosting",
    },
]

const INCLUDED = [
    {
        icon: "mdi:puzzle-outline",
        text: "Kestra Enterprise engine and all Enterprise plugins",
    },
    {
        icon: "mdi:infinity",
        text: "Unlimited executions, flows, tasks, apps and assets",
    },
    {
        icon: "mdi:shield-lock-outline",
        text: "Multi-tenant, SSO, RBAC, audit logs, secrets, policies",
    },
    {
        icon: "mdi:server-network",
        text: "Worker groups, task runners, high-availability queue",
    },
    {
        icon: "mdi:lifebuoy",
        text: "Standard support with SLA; Premium and Platinum available",
    },
    {
        icon: "mdi:account-star-outline",
        text: "Customer Success program (Platinum)",
    },
    {
        icon: "mdi:cloud-lock-outline",
        text: "Self-hosted, hybrid or air-gapped deployment",
    },
    {
        icon: "mdi:calendar-check-outline",
        text: "Annual subscription sized to the project",
    },
]

const FAQ = [
    {
        question: "What is the difference between open source and Enterprise?",
        answer: "The engine, the YAML, the plugins and the execution model are identical. Enterprise adds three things. Organization: multi-tenancy, namespaces, worker groups and environments. Control: SSO, RBAC, secrets, audit logs and policies. Experience: Apps, approvals and Copilot on any LLM. It comes with a commercial license and support with SLA. A flow moves between editions without changes.",
    },
    {
        question: "Enterprise or Kestra Cloud?",
        answer: "Enterprise is self-hosted: your Kubernetes, your network, your air gap, with the full Enterprise feature set. Kestra Cloud is managed by Kestra and usage-based. It includes a selection of Enterprise features. The pricing page lists what each one includes.",
    },
    {
        question: "How is it priced?",
        answer: "An annual subscription per instance, sized to your project: instances, environments, worker groups and support level. Executions, flows, tasks, apps and assets are unlimited.",
    },
    {
        question: "Can we run it fully air-gapped?",
        answer: "Yes. Several public administrations and industrial sites run Kestra Enterprise with no outbound connection. Plugins and updates are delivered offline.",
    },
    {
        question: "How long does a proof of concept take?",
        answer: "Most teams evaluate on open source first, so the proof of concept is about organization and governance rather than the engine. A guided trial runs on your own use case.",
    },
]
---

<Layout {title} {description}>
    <Fragment slot="head">
        <SchemaSoftwareApplication
            id="https://kestra.io/#enterprise-edition"
            name="Kestra Enterprise Edition"
            description="Kestra Enterprise adds SSO, RBAC, audit logs, multi-tenancy, worker groups and SLA-backed support to the open source Kestra orchestration platform. Self-hosted, hybrid or air-gapped."
            url="https://kestra.io/enterprise"
            isVariantOf="https://kestra.io/#software"
        />
        <SchemaFAQ items={FAQ} />
    </Fragment>
    <PageShell>
        <EnterpriseHero />
        <CustomerLogos />
        <Enterprise features={FEATURES} layers={false} actions={false} light>
            <Fragment slot="title">
                Same engine, ready for the whole organization.
            </Fragment>
            <Fragment slot="lead">
                Kestra Enterprise runs the same engine, YAML and plugins as
                Kestra Core, and adds what many teams on one platform need:
                isolation, access control, audit and support with SLA.
            </Fragment>
        </Enterprise>
        <AiGovernance bridge={false} foot={false}>
            <Fragment slot="title">
                Your AI agents answer to the same governance as your teams.
            </Fragment>
            <Fragment slot="lead">
                Agents, MCP and the Copilot are open source. Enterprise controls
                what they can do: which workflows they can call, which model
                they run on, including one you host on-prem, who can approve,
                and a record of every action.
            </Fragment>
            <AgentZones slot="figure" />
            <AgentControls slot="after" />
        </AiGovernance>
        <Deployments />
        <EnterpriseShowcase />
        <Customers stories={STORIES} foot={false} placeholder={false}>
            <Fragment slot="title">Enterprise in production</Fragment>
        </Customers>
        <SupportPlans />
        <Included items={INCLUDED} />
        <BuyerQuestions items={FAQ} />
    </PageShell>
</Layout>
