---
export const prerender = false

import { $fetchApiCached } from "~/utils/fetch"
import type { Plugin } from "~/utils/plugins/plugin"
import { prunePluginsForCards } from "~/utils/plugins/pruneForClient"
import { buildPluginUrlIndex } from "~/utils/plugins/canonicalUrl"
import { buildFamilyIndex, findFamilySiblings, type ArtifactsResponse } from "~/utils/plugins/pluginFamily"
import { formatPluginName } from "~/utils/plugins/pluginUtils"
import { slugify } from "~/utils/slugify"

import Layout from "~/components/layout.astro"
import Breadcrumb from "~/components/layout/Breadcrumb.vue"
import PluginLayout from "~/components/plugins/PluginLayout.astro"
import OneHeader from "~/components/plugins/OneHeader.astro"
import PluginCard from "~/components/plugins/PluginCard.vue"

// Multi-artifact plugin groups (Debezium, JDBC, Scripts, ...) ship one
// unrelated top-level plugin per sub-technology instead of a single plugin
// with subgroups, so there is no natural "/plugins/plugin-debezium" page for
// them. This route (reached only via an internal Astro.rewrite from
// [...slug].astro, never a real URL) synthesizes one by grouping siblings
// detected in pluginFamily.ts from real release metadata.
// See https://github.com/kestra-io/kestra-ee/issues/1923
const familyName = Astro.params.name ?? ""

const rawPlugins = await $fetchApiCached<Plugin[]>("/plugins/subgroups")
const rawPluginsData = await $fetchApiCached("/plugins/pluginsInformation")
const familyIndex = buildFamilyIndex(
    await $fetchApiCached<ArtifactsResponse>("/plugins/artifacts"),
)

const siblings = findFamilySiblings(rawPlugins, familyName, familyIndex)

if (siblings.length === 0) {
    return new Response(null, { status: 404, statusText: "Not found" })
}

const displayName = formatPluginName(familyName)

const cardPlugins = prunePluginsForCards(
    siblings,
    rawPluginsData.byPlugin,
    buildPluginUrlIndex(rawPlugins),
).map((p) => ({
    ...p,
    slug: slugify(p.title),
    elementCounts: p.elementCounts ?? 0,
    blueprints: p.blueprints ?? 0,
}))

const title = `${displayName} plugins`
const description = `Browse all ${siblings.length} ${displayName} plugins available in Kestra.`
---

<Layout {title} {description} canonical={`/plugins/${familyName}`}>
    <PluginLayout>
        <nav slot="sidebar" class="family-nav" aria-label={`${displayName} plugins`}>
            <p class="family-nav__label">Plugins</p>
            <ul>
                {
                    cardPlugins.map((p) => (
                        <li>
                            <a href={`#${p.slug}`}>{p.title}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div class="bd-title">
            <Breadcrumb
                items={[
                    { label: "Plugins", href: "/plugins" },
                    { label: displayName, href: "" },
                ]}
            />
            <OneHeader headingTitle={title} headingDescription={description} />
        </div>
        <div class="family-grid">
            {
                cardPlugins.map((p) => (
                    <div id={p.slug} class="family-grid__item">
                        <PluginCard plugin={p} />
                    </div>
                ))
            }
        </div>
    </PluginLayout>
</Layout>

<style lang="scss">
    .family-nav {
        font-size: $font-size-sm;

        &__label {
            font-weight: 700;
            color: var(--ks-content-primary);
            margin-bottom: 0.5rem;
        }

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        a {
            display: block;
            padding: 0.25rem 0;
            color: var(--ks-content-secondary);

            &:hover {
                color: var(--ks-content-link);
            }
        }
    }

    .family-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
        margin-top: 2rem;

        &__item {
            scroll-margin-top: 6rem;
        }
    }
</style>
