---
// TEMPORARY (test branch): rung B. Rung A plus the rendered markdown body,
// which is what pulls the content pipeline into the graph.
import { getCollection, render } from "astro:content"
import { entryCacheKey } from "~/utils/incrementalCacheKey"

export async function getStaticPaths() {
    const docs = (await getCollection("docs")).slice(0, 20)
    return docs.map((doc) => ({
        params: { id: doc.id.replace(/\//g, "-") },
        props: doc,
        cacheKey: entryCacheKey(doc),
    }))
}
const doc = Astro.props
const { Content } = await render(doc)
---

<html lang="en">
    <head><title>{doc.data.title ?? doc.id}</title></head>
    <body><Content /></body>
</html>
