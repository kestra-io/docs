---
import Layout from "~/components/layout.astro"
import PartnerProfile from "~/components/partners/PartnerProfile.astro"

const title =
    "Conapi & Kestra: Practical Integration Patterns for the Enterprise"
const description =
    "The Conapi team delivers the plumbing without the pain, enabling simple integration between Kestra workflows, JMS architectures, and Gravitee API management"

const about =
    'Conapi specializes in connecting legacy systems with modern tools. They ensure production-ready integration without a complete "rip-and-replace" of existing infrastructure, acting as the bridge between API management, messaging systems, and workflow automation.'

const facts = [
    { label: "Headquarters", value: "Vienna, Austria (DACH Region)" },
    {
        label: "Kestra expertise",
        value: "System Integration, API Management, Messaging (JMS)",
    },
    {
        label: "Profile",
        value: "Conapi is an integration-focused consultancy and Gravitee partner.",
    },
]

const quote = {
    text: "Our clients need to connect legacy systems to modern automation without throwing everything away. This integration protects existing infrastructure while enriching APIs with Kestra data. It's the practical bridge enterprises actually need.",
    author: "Stefan Fritz",
    role: "CEO, Conapi",
}

const expertise = [
    {
        icon: "mdi:bridge",
        title: "Pragmatic approach",
        text: "Conapi connects existing enterprise landscapes with modern requirements without unnecessary complexity. The focus is on integration that works in production: bridging what you have with what you need, instead of replacing systems that still deliver value.",
    },
    {
        icon: "mdi:message-arrow-right-outline",
        title: "Native JMS support",
        text: "Conapi contributed the official JMS plugin to Kestra's open source ecosystem. Flows can start when a message lands on a queue, and produce or consume messages along the way, so Kestra plugs into existing ESBs and event-driven architectures.",
    },
    {
        icon: "mdi:api",
        title: "API management and orchestration",
        text: "As a partner of both Kestra and Gravitee, Conapi runs Kestra flows straight from the API layer for real-time cases such as dynamic pricing. Long-running workflows go through queues with correlation IDs, so APIs stay responsive.",
    },
    {
        icon: "mdi:swap-horizontal",
        title: "From ESB to event-driven",
        text: "Conapi helps manufacturing and ERP-heavy organizations move from legacy monoliths to event-driven architectures. Multi-step approvals and complex order processing run in Kestra, while existing Enterprise Service Bus investments keep their value.",
    },
]
---

<Layout {title} {description} breadcrumbTitle="Conapi">
    <PartnerProfile
        name="Conapi"
        tagline={description}
        {about}
        expertiseTitle="Conapi: 20+ Years of Integration Expertise"
        expertise={expertise}
        quote={quote}
        facts={facts}
        contact={{
            text: "Contact Conapi",
            href: "https://conapi.at/?utm_source=kestra&utm_medium=referral&utm_campaign=partners#contact",
        }}
        plugins={["plugin-jms"]}
        closing={{
            title: "Contact Conapi",
            text: "Ready to bridge your legacy systems with modern orchestration? Conapi's experts are here to assist you.",
        }}
        website="https://conapi.at/?utm_source=kestra&utm_medium=referral&utm_campaign=partners"
    />
</Layout>
