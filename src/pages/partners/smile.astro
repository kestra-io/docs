---
import Layout from "~/components/layout.astro"
import PartnerProfile from "~/components/partners/PartnerProfile.astro"

const title = "Smile & Kestra: Open Data and AI Platforms, Orchestrated"
const description =
    "Smile, the European digital services group, builds open data and AI platforms for its customers, with Kestra orchestrating pipelines, models and agents."

const facts = [
    { label: "Headquarters", value: "Asnières-sur-Seine, France" },
    {
        label: "Kestra expertise",
        value: "Data and AI platform orchestration",
    },
    {
        label: "Profile",
        value: "1,500 people in 9 countries, 200+ data and AI experts, 30+ years of digital projects",
    },
]

const quote = {
    text: "Orchestration has become the core of modern IT and data architectures. By partnering with Kestra, we give our customers an open source, event-driven and declarative solution that automates complex workflows in a few lines of YAML, with full observability.",
    author: "Jamel Ben Amar",
    role: "CTO, Smile Group (translated from French)",
}

const expertise = [
    {
        icon: "mdi:sitemap-outline",
        title: "Open data and AI platforms",
        text: "Smile designs open, hybrid architectures built on open source Modern Data Stack standards, so customers stay independent of any single vendor. Kestra is the orchestrator in that stack: open source, self-hosted, and one place to trigger, monitor and rerun every job.",
    },
    {
        icon: "mdi:database-arrow-right-outline",
        title: "ETL and ELT pipelines",
        text: "Batch or event-driven pipelines declared in YAML: extract the day's sales from PostgreSQL, clean them in Python with Pandas, load them into BigQuery or Snowflake, notify the team in Slack or Microsoft Teams, and monitor the whole run with Prometheus and Grafana.",
    },
    {
        icon: "mdi:brain",
        title: "Machine learning lifecycle",
        text: "Data preparation, training, validation, deployment and monitoring of models run as one Kestra flow, with each step written in the language the team already uses: Python, R, Java, Go or Node.js.",
    },
    {
        icon: "mdi:robot-outline",
        title: "AI agents in business workflows",
        text: "Smile's agent offer puts agents inside business workflows, where they read from systems and act under supervised autonomy. Kestra runs those agents as steps of a flow, next to the deterministic tasks, with logs, retries and approval steps around them.",
    },
    {
        icon: "mdi:factory",
        title: "Industrialized delivery",
        text: "Smile's two Data & AI Factories take 30+ projects a year from proof of concept to production. Flows are versioned in Git and follow the same review and deployment cycle, so each new use case reuses the same foundation.",
    },
]
---

<Layout {title} {description} breadcrumbTitle="Smile">
    <PartnerProfile
        languages={[
            { code: "en", label: "English", href: "/partners/smile" },
            { code: "fr", label: "Français", href: "/partners/smile/fr" },
        ]}
        languageNote="Smile works with customers in France and across Europe."
        name="Smile"
        tagline="Smile builds open data and AI platforms for its customers, with Kestra orchestrating pipelines, models and agents."
        about="For more than 30 years, Smile has delivered digital projects across five practices: AI & Data, Customer eXperience, Business Apps, Cloud Transformation & Management, and Industrial & Product Systems. The group brings together Smile, Neopixl, SensioLabs, UX-Republic, Alter Way, Synotis and creativestyle. Its AI & Data practice focuses on digital autonomy: open, independent stacks that customers control, where Kestra fits as the open source orchestrator."
        expertiseTitle="Smile: data and AI expertise, orchestrated with Kestra"
        expertise={expertise}
        quote={quote}
        facts={facts}
        contact={{
            text: "Contact Smile",
            href: "https://smile.eu/en/contact?utm_source=kestra&utm_medium=referral&utm_campaign=partners",
        }}
        closing={{
            title: "Contact Smile",
            text: "Want to build or modernize a data and AI platform with Kestra? Smile's Data & AI teams can help.",
        }}
        website="https://smile.eu/en/expertises/ai-data?utm_source=kestra&utm_medium=referral&utm_campaign=partners"
    />
</Layout>
