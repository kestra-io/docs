---
import Layout from "~/components/layout.astro"
import PartnerProfile from "~/components/partners/PartnerProfile.astro"

const title = "Ashisuto & Kestra: Strategic Partner in Japan"
const description =
    "The Ashisuto team is your trusted bridge to Kestra in the Japanese market — connecting your business needs with Kestra's engineering expertise."

const facts = [
    { label: "Headquarters", value: "Tokyo, Japan" },
    {
        label: "Kestra expertise",
        value: "Strategic Advisory, Enterprise Adoption, Local Support",
    },
    {
        label: "Profile",
        value: "Ashisuto is a leading Japanese bridge partner connecting enterprises with Kestra.",
    },
]

const quote = {
    text: "Our collaboration with Kestra enables us to bring the stability and operational ease that Japan's top-tier enterprises require. As a bridge between Kestra's world-class engineering team and local business needs, we ensure that enterprises can adopt a solution that is efficient in development, reliable in large-scale execution, and backed by responsive, coordinated support. We are committed to establishing a standard of excellence for data orchestration in the Japanese market.",
    author: "Hideki Itaki",
    role: "Director, Innovation & Marketing Co-Creation Lab at Ashisuto",
}

const expertise = [
    {
        icon: "mdi:clipboard-search-outline",
        title: "Assessment and strategy",
        text: "Ashisuto reviews your current infrastructure and pain points, often dissatisfaction with legacy tools or complex open source alternatives. Together with Kestra's engineering team, it builds a plan focused on reliability, observability and governance.",
    },
    {
        icon: "mdi:rocket-launch-outline",
        title: "Proof of concept in 4 to 6 weeks",
        text: "A packaged proof of concept with success metrics agreed upfront, such as reduced mean time to recovery and fewer operating hours. Compatibility recipes help migrate existing pipelines, with Ashisuto as your local point of contact.",
    },
    {
        icon: "mdi:translate",
        title: "Local support in Japanese",
        text: "Ashisuto is your contact in Japanese and bridges language and cultural gaps with Kestra's global support team. Whether you scale, add sources like Snowflake or Databricks, or need 24/7 assurance, requests reach the right people fast.",
    },
    {
        icon: "mdi:office-building-outline",
        title: "Built for Japanese enterprises",
        text: "Kestra's offering adapted to the Japanese market, with JPY pricing, annual contracts and local procurement norms. Ashisuto works with automotive, manufacturing, finance and digital native companies adopting Kestra at enterprise scale.",
    },
]
---

<Layout {title} {description} breadcrumbTitle="Ashisuto">
    <PartnerProfile
        name="Ashisuto"
        tagline={description}
        about="Ashisuto brings deep market knowledge and strategic advisory expertise to help Japanese enterprises adopt Kestra. As a bridge between your organization and Kestra's global team, Ashisuto helps you navigate the transition from complex legacy systems to modern, event-driven architectures — whether it's shifting from batch processing to real-time, or optimizing Infrastructure as Code (IaC) and Kubernetes environments."
        expertiseTitle="Ashisuto: Leading Japanese bridge partner connecting enterprises with Kestra"
        expertise={expertise}
        quote={quote}
        facts={facts}
        contact={{
            text: "Contact Ashisuto",
            href: "https://www.ashisuto.co.jp/contact/?utm_source=kestra&utm_medium=referral&utm_campaign=partners",
        }}
        closing={{
            title: "Contact Ashisuto",
            text: "Ready to adopt Kestra at enterprise scale in Japan? Ashisuto's team is here to bridge your business needs with Kestra's engineering expertise.",
        }}
    />
</Layout>

<style is:global>
    html.dark {
        --ashisuto-brand: #ffffff;
    }
</style>
