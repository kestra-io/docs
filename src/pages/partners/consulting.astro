---
import Layout from "~/components/layout.astro"
import Quotes from "~/components/common/Quotes.vue"
import Intro from "~/components/partners/Intro.astro"
import Benefits from "~/components/partners/Benefits.astro"
import PartnerDirectory from "~/components/partners/PartnerDirectory.vue"
import PartnerCta from "~/components/partners/PartnerCta.astro"
import { PARTNERS } from "~/components/partners/partners"
import ConapiLogo from "~/assets/landing/partners/conapi-logo-small.svg?raw"
import AshisutoLogo from "~/assets/landing/partners/ashisuto-logo.svg?raw"

const title =
    "Kestra Consulting Partners: Consulting Firms and Systems Integrators"
const description =
    "Search the consulting firms and systems integrators who sell, implement and support Kestra, by country and service. Or join the program."

const partners = PARTNERS.filter((p) => p.type === "Consulting").map((p) => ({
    name: p.name,
    logo: p.logo.src,
    kind: p.kind,
    country: p.country,
    region: p.region,
    description: p.description,
    services: p.services,
    href: p.href,
}))

const FILTERS: { key: "kind" | "region" | "services"; label: string }[] = [
    { key: "kind", label: "Partner type" },
    { key: "region", label: "Region" },
    { key: "services", label: "Services" },
]

const BENEFITS = [
    {
        title: "A Kestra Cloud tenant",
        text: "Your own tenant with Enterprise features, issued with the welcome kit, for training, demos and labs. Services partners can request a self-hosted Enterprise licence.",
    },
    {
        title: "Enablement",
        text: "Academy access for your team, the sales playbook and program guide, Solutions Engineering sessions, and a shared Slack channel with your Kestra contact.",
    },
    {
        title: "A listing customers use",
        text: "Once certified, your firm appears in the directory above with the certified badge, searchable by country and service.",
    },
    {
        title: "Introductions and co-marketing",
        text: "Introductions to opportunities in your region and specialty, a joint announcement, content and events.",
    },
]

const QUOTES = [
    {
        quote: "Our clients need to connect legacy systems to modern automation without throwing everything away. This integration protects existing infrastructure while enriching APIs with Kestra data. It's the practical path to modernization our customers have been asking for.",
        author: "Stefan Fritz - CEO, Conapi",
        smallLogoSvg: ConapiLogo,
    },
    {
        quote: "Our collaboration with Kestra enables us to bring the stability and operational ease that Japan's top-tier enterprises require. As a bridge between Kestra's world-class engineering team and local business needs, we help organizations adopt Kestra with confidence.",
        author: "Hideki Itaki - Director, Innovation & Marketing Co-Creation Lab at Ashisuto",
        smallLogoSvg: AshisutoLogo,
    },
]
---

<Layout {title} {description} breadcrumbTitle="Consulting Partners">
    <Intro
        title="Find a consulting partner"
        text="Partners who demo, deliver, operate and sell Kestra for their clients. Search by country and service, or join the program as a Solution, Services or Reseller partner."
        ctaText="Become a consulting partner"
        ctaHref="/partners/apply?track=consulting"
    />
    <PartnerDirectory
        client:load
        id="directory"
        partners={partners}
        filters={FILTERS}
        searchPlaceholder="Search by name, country or service"
    />
    <Benefits
        title="What partners get"
        intro="Registered partners get the tools to learn and demo Kestra. Certified partners are listed here and introduced to customers."
        benefits={BENEFITS}
    />
    <Quotes quotes={QUOTES} />
    <PartnerCta track="consulting" />
</Layout>
