---
import Layout from "~/components/layout.astro"
import PartnersLists from "~/components/partners/PartnersLists.vue"
import PartnerCta from "~/components/partners/PartnerCta.astro"
import { listPartners } from "~/components/partners/partners"

const title = "Find a Kestra Partner: Consulting and Technology Partners"
const description =
    "Search every Kestra partner, consulting firms, systems integrators and technology platforms, by track, region and service."

const partners = listPartners()

const FILTERS: {
    key: "type" | "kind" | "region" | "services"
    label: string
}[] = [
    { key: "type", label: "Track" },
    { key: "kind", label: "Category" },
    { key: "region", label: "Region" },
    { key: "services", label: "Services" },
]
---

<Layout {title} {description} breadcrumbTitle="Find a partner">
    <PartnersLists
        client:load
        partners={partners}
        filters={FILTERS}
        title="Find a partner"
        subtitle="Services partners help you implement Kestra. Technology partners make sure it works with the rest of your stack."
        searchPlaceholder="Search by name, country or service"
        defaultSelected={{ type: ["Consulting"] }}
        helpText="Need help finding a partner?"
        helpCtaText="Contact us"
        helpHref="/partners/contact"
    />
    <PartnerCta />
</Layout>
