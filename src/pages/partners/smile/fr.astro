---
import Layout from "~/components/layout.astro"
import PartnerProfile from "~/components/partners/PartnerProfile.astro"

const title = "Smile & Kestra : plateformes Data et IA ouvertes, orchestrées"
const description =
    "Smile, groupe européen de services numériques, construit des plateformes Data et IA ouvertes pour ses clients, avec Kestra pour orchestrer pipelines, modèles et agents."

const facts = [
    { label: "Siège", value: "Asnières-sur-Seine, France" },
    {
        label: "Expertise Kestra",
        value: "Orchestration de plateformes Data et IA",
    },
    {
        label: "Profil",
        value: "1 500 collaborateurs dans 9 pays, plus de 200 experts Data et IA, plus de 30 ans de projets numériques",
    },
]

const quote = {
    text: "L'orchestration est devenue le cœur réacteur des architectures IT et Data modernes. En devenant partenaire de Kestra, nous mettons à disposition de nos clients une solution open-source, événementielle et déclarative qui permet d'automatiser des workflows complexes en quelques lignes de YAML, tout en garantissant une observabilité totale.",
    author: "Jamel Ben Amar",
    role: "CTO, Groupe Smile",
}

const expertise = [
    {
        icon: "mdi:sitemap-outline",
        title: "Plateformes Data et IA ouvertes",
        text: "Smile conçoit des architectures ouvertes et hybrides, fondées sur les standards open source de la Modern Data Stack, pour que ses clients ne dépendent d'aucun éditeur. Kestra y tient le rôle d'orchestrateur : open source, auto-hébergé, et un seul endroit pour déclencher, superviser et relancer chaque traitement.",
    },
    {
        icon: "mdi:database-arrow-right-outline",
        title: "Pipelines ETL et ELT",
        text: "Des pipelines batch ou événementiels déclarés en YAML : extraire les ventes du jour depuis PostgreSQL, les nettoyer en Python avec Pandas, les charger dans BigQuery ou Snowflake, prévenir l'équipe dans Slack ou Microsoft Teams, et suivre l'exécution avec Prometheus et Grafana.",
    },
    {
        icon: "mdi:brain",
        title: "Cycle de vie du machine learning",
        text: "Préparation des données, entraînement, validation, déploiement et supervision des modèles s'enchaînent dans un même flow Kestra, chaque étape écrite dans le langage que l'équipe utilise déjà : Python, R, Java, Go ou Node.js.",
    },
    {
        icon: "mdi:robot-outline",
        title: "Agents IA dans les processus métier",
        text: "L'offre agents de Smile place des agents au cœur des processus métier, où ils lisent les systèmes et agissent en autonomie supervisée. Kestra exécute ces agents comme des étapes d'un flow, à côté des tâches classiques, avec logs, relances et étapes de validation.",
    },
    {
        icon: "mdi:factory",
        title: "Industrialisation du delivery",
        text: "Les deux Data & AI Factories de Smile mènent plus de 30 projets par an du POC à la production. Les flows sont versionnés dans Git et suivent le même cycle de revue et de déploiement, si bien que chaque nouveau cas d'usage repose sur le même socle.",
    },
]
---

<Layout
    {title}
    {description}
    lang="fr"
    breadcrumbTitle="Smile"
    canonical="/partners/smile"
    noindex
>
    <PartnerProfile
        lang="fr"
        languages={[
            { code: "en", label: "English", href: "/partners/smile" },
            { code: "fr", label: "Français", href: "/partners/smile/fr" },
        ]}
        languageNote="Smile accompagne ses clients en France et en Europe."
        name="Smile"
        tagline="Smile construit des plateformes Data et IA ouvertes pour ses clients, avec Kestra pour orchestrer pipelines, modèles et agents."
        about="Depuis plus de 30 ans, Smile accompagne les entreprises sur cinq domaines : IA & Data, Customer eXperience, Business Apps, Cloud Transformation & Management et Industrial & Product Systems. Le groupe réunit Smile, Neopixl, SensioLabs, UX-Republic, Alter Way, Synotis et creativestyle. Son offre IA & Data met l'accent sur l'autonomie numérique : des stacks ouvertes et indépendantes que les clients maîtrisent, dans lesquelles Kestra trouve sa place comme orchestrateur open source."
        expertiseTitle="Smile : l'expertise Data et IA, orchestrée avec Kestra"
        expertise={expertise}
        quote={quote}
        facts={facts}
        contact={{
            text: "Contacter Smile",
            href: "https://smile.eu/fr/contact?utm_source=kestra&utm_medium=referral&utm_campaign=partners",
        }}
        closing={{
            title: "Contacter Smile",
            text: "Vous voulez construire ou moderniser une plateforme Data et IA avec Kestra ? Les équipes Data & IA de Smile vous accompagnent.",
        }}
        website="https://smile.eu/fr/expertises/ai-data?utm_source=kestra&utm_medium=referral&utm_campaign=partners"
    />
</Layout>
