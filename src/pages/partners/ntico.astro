---
import Layout from "~/components/layout.astro"
import PartnerProfile from "~/components/partners/PartnerProfile.astro"

const title =
    "Ntico & Kestra: Your Partner for Data Orchestration and ETL Solutions"
const description =
    "The Ntico team is ready to support you in your data orchestration and ETL projects with Kestra."

const facts = [
    { label: "Headquarters", value: "Villeneuve d'Ascq, France" },
    { label: "Kestra expertise", value: "Data Orchestration" },
    {
        label: "Profile",
        value: "Ntico is a Digital Services Company that supports you in digital transformation",
    },
]

const quote = {
    text: "Kestra is an efficient solution for processing all types of data streams. Efficient in development with a clear UI, a comprehensive DevOps process, and an impressive number of plugins that allow it to adapt to all of our clients' technical contexts.",
    author: "Emmanuel Santerne",
    role: "Partner at Ntico",
}

const expertise = [
    {
        icon: "mdi:clipboard-search-outline",
        title: "Assessment and strategy",
        text: "Ntico starts with a thorough review of your data infrastructure: existing workflows, tools and integration points. The result is a plan aligned with your business goals, so the move to Kestra improves orchestration and ETL without disruption.",
    },
    {
        icon: "mdi:database-arrow-right-outline",
        title: "Implementation and migration",
        text: "Ntico runs the whole implementation, from configuring your Kestra environment to migrating existing ETL pipelines. Their experts handle the complexity so your data processes keep running and your teams can focus on using the data.",
    },
    {
        icon: "mdi:cog-refresh-outline",
        title: "Data engineering and modernization",
        text: "With long experience in data engineering, Ntico redesigns and optimizes your data workflows to make the most of Kestra. Services range from pipeline creation to advanced data processing, for a robust infrastructure that lasts.",
    },
    {
        icon: "mdi:lifebuoy",
        title: "Ongoing support",
        text: "After go-live, Ntico keeps optimizing your Kestra workflows. Whether you scale operations, add data sources or refine ETL processes, their support keeps your environment in step with the business, adapted to your technical context and budget.",
    },
]
---

<Layout {title} {description} breadcrumbTitle="Ntico">
    <PartnerProfile
        name="Ntico"
        tagline={description}
        about="For businesses looking to enhance their data workflows, Ntico brings specialized expertise in implementing Kestra. They delivers tailored solutions that simplify data management, optimize ETL processes, and ensure seamless integration with your existing systems."
        expertiseTitle="Ntico: Expertise in Data Orchestration and ETL with Kestra"
        expertise={expertise}
        quote={quote}
        facts={facts}
        contact={{
            text: "Contact Ntico",
            href: "https://www.ntico.com/contactez-nous/",
        }}
        closing={{
            title: "Contact Ntico",
            text: "Ready to enhance your data orchestration and ETL processes with Kestra? Ntico’s experts are here to assist you.",
        }}
        website="https://www.ntico.com/"
    />
</Layout>
