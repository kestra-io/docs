---
import Layout from "~/components/layout.astro"
import Hero from "~/components/community/Hero.astro"
import AmbassadorPerks from "~/components/community/AmbassadorPerks.astro"
import Contributors from "~/components/community/Contributors.vue"
import CommunityGrid from "~/components/community/CommunityGrid.vue"
import Guidelines from "~/components/community/Guidelines.vue"
import type { Contributor, GitHubMetrics } from "~/components/community/types"
import {
    hourlySeed,
    orderContributors,
} from "~/components/community/contributors"
import { $fetchApiCachedOptional } from "~/utils/fetch"
import { loadGithubRepoStats } from "~/utils/githubRepoStats"
import { NO_RANDOM_ORDER } from "astro:env/client"

export const prerender = false

const title = "Kestra Community: Slack, GitHub & Ambassador Program"
const description =
    "Join the Kestra open-source community: get help on Slack, contribute on GitHub, and apply to the Ambassador Program to share what you build with Kestra."

const AMBASSADOR_PROGRAM_URL = "https://forms.gle/1vdgjHLFWbfQADxG6"
const CONTRIBUTORS_SHOWN = 27

// The HTML waits on both calls, so a slow API must not stall the page.
const apiTimeout = { signal: AbortSignal.timeout(3000) }
const [metrics, contributors, repoStats] = await Promise.all([
    $fetchApiCachedOptional<GitHubMetrics>(
        "/communities/github/metrics",
        apiTimeout,
    ),
    $fetchApiCachedOptional<Contributor[]>(
        "/communities/github/contributors",
        apiTimeout,
    ),
    loadGithubRepoStats(Astro.locals),
])

const seed = NO_RANDOM_ORDER ? undefined : hourlySeed()
const rankedContributors = orderContributors(contributors ?? [], seed)
const topContributors = rankedContributors.slice(0, CONTRIBUTORS_SHOWN)
const totalContributors = rankedContributors.length

const stats = metrics && {
    ...metrics,
    stars: repoStats?.stargazers || metrics.stars,
    contributors: contributors ? totalContributors : metrics.contributors,
}
---

<Layout
    title={title}
    description={description}
    breadcrumbTitle="Community"
    headerTheme="darkHeader"
    headerBg="#111114"
>
    <div>
        <Hero ambassadorHref={AMBASSADOR_PROGRAM_URL} />
        <AmbassadorPerks href={AMBASSADOR_PROGRAM_URL} />
        {stats && <CommunityGrid metrics={stats} />}
        {
            topContributors.length > 0 && (
                <Contributors
                    client:idle
                    initial={topContributors}
                    total={totalContributors}
                    seed={seed}
                />
            )
        }
        <Guidelines client:load />
    </div>
</Layout>
