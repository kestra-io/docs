---
import Layout from "~/components/layout.astro"
import AboutHero from "~/components/about/AboutHero.astro"
import WhyWeExist from "~/components/about/WhyWeExist.astro"
import Numbers from "~/components/about/Numbers.astro"
import Customers from "~/components/about/Customers.astro"
import Principles from "~/components/about/Principles.astro"
import OpenSource from "~/components/about/OpenSource.astro"
import Journey from "~/components/about/Journey.astro"
import People from "~/components/about/People.astro"
import Life from "~/components/about/Life.astro"
import TeamGlobe from "~/components/about/TeamGlobe.astro"
import Trust from "~/components/about/Trust.astro"
import Backers from "~/components/about/Backers.astro"
import Contact from "~/components/about/Contact.astro"
import PartnerCta from "~/components/partners/PartnerCta.astro"
import careersPhoto from "~/components/about/assets/team-35.jpg"

const title = "About Kestra Technologies: Founders, Team & Investors"
const description =
    "Kestra Technologies builds Kestra, the open-source unified orchestration platform. Founded in 2021 by Emmanuel Darras and Ludovic Dehon, backed by RTP Global."
---

<Layout {title} {description} headerTheme="darkHeader" headerBg="#111114">
    <div class="about-us">
        <AboutHero />
        <WhyWeExist />
        <Numbers />
        <Customers />
        <Principles />
        <OpenSource />
        <Journey />
        <People />
        <TeamGlobe />
        <Life />
        <Trust />
        <Backers />
        <Contact />
        <PartnerCta
            custom={{
                title: "Work on the control plane",
                text: "Engineering, field and go-to-market roles, remote across North America and Europe. We hire people who love open source and want to build infrastructure the world runs on.",
                cta: "See open roles",
                href: "/careers",
                image: careersPhoto,
            }}
        />
    </div>
</Layout>

<style lang="scss">
    .about-us {
        overflow-x: clip;
        background: var(--ks-background-body);

        // The dark theme has no lighter border token; the page's hairlines
        // use a gray halfway between it and the background.
        :global(html.dark) & {
            --ks-border-primary: #2c2b31;
        }

        :global(.container) {
            @include media-breakpoint-up(xxl) {
                max-width: 1320px;
            }
        }
    }
</style>
