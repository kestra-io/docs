---
import LpLayout from "~/components/lp/LpLayout.astro"

import Hero from "~/components/lp/shared/Hero.astro"
import Platform from "~/components/lp/shared/Platform.astro"
import Migration from "~/components/lp/shared/Migration.astro"
import Features from "~/components/lp/shared/Features.astro"
import Stack from "~/components/lp/shared/Stack.astro"
import UseCases from "~/components/lp/shared/UseCases.astro"
import Faq from "~/components/lp/shared/Faq.astro"
import ClosingBanner from "~/components/lp/shared/ClosingBanner.astro"
import Translation from "~/components/lp/shared/Translation.astro"
import Proof from "~/components/lp/shared/Proof.astro"
import Conversion from "~/components/lp/pipedream-migration/Conversion.astro"
import CloudForm from "~/components/cloud/Form.vue"

import { pipedreamMigrationContent as content } from "~/components/lp/pipedream-migration/pipedreamMigrationContent"

const routePath = "/lp/pipedream-migration"

const cloudForm = { pageUri: routePath, submitLabel: "Request trial access" }
---

<LpLayout
    title={content.title}
    description={content.description}
    header={{ cta: content.trialCta }}
>
    <Hero {routePath} {...content.hero}>
        <Fragment slot="title">
            Move off <span class="grad grad-a">Pipedream</span>{" "}
            before <span class="grad grad-b">March 31</span>.
        </Fragment>
        <Fragment slot="lead">
            Pipedream Workflows stops on March 31, 2027 and deletes all
            data, credentials included, by April 30. Kestra Cloud runs the
            logic of your Node.js, Python and Bash steps as is. You hold the
            credentials, and there is nothing to host.<br />
            <strong
                >Fully managed today, open source underneath, so you are not
                locked in again.</strong
            >
        </Fragment>
        <Fragment slot="form-sub">
            14 days free, no credit card. Tell us what you run on Pipedream
            and we set up your instance.
        </Fragment>
        {
            /* Wrapped: a slot attribute on a hydrated island reaches the client as a stray attribute. */
        }
        <Fragment slot="form">
            <CloudForm variant="plain" {...cloudForm} client:idle />
        </Fragment>
    </Hero>
    <Platform {...content.platform} />
    <Migration {...content.migration} />
    <Translation {...content.translation} />
    <Conversion />
    <Features {...content.features} />
    <Stack {...content.stack} />
    <Proof {...content.proof} />
    <UseCases {routePath} {...content.useCases}>
        <Fragment slot="form">
            <CloudForm variant="plain" {...cloudForm} client:visible />
        </Fragment>
    </UseCases>
    <Faq {...content.faq} />
    <ClosingBanner {...content.closingBanner} />
</LpLayout>
