---
import LpLayout from "~/components/lp/LpLayout.astro"
import Hero from "~/components/lp/shared/Hero.astro"
import CloudForm from "~/components/cloud/Form.vue"
import PageShell from "~/components/home/PageShell.astro"
import BuyerQuestions from "~/components/enterprise/BuyerQuestions.astro"
import PdCompare from "~/components/pipedream-migration-guide/PdCompare.astro"
import ControlPlane from "~/components/home/ControlPlane.astro"
import RunKestra from "~/components/home/RunKestra.astro"
import PdDates from "~/components/pipedream-migration-guide/PdDates.astro"
import PdMapping from "~/components/pipedream-migration-guide/PdMapping.astro"
import {
    STEP_DOMAINS,
    runEditions,
} from "~/components/pipedream-migration-guide/guide"

import { pipedreamMigrationContent as content } from "~/components/lp/pipedream-migration/pipedreamMigrationContent"

const routePath = "/lp/pipedream-migration"

const cloudForm = { pageUri: routePath, submitLabel: "Request trial access" }
---

<LpLayout
    title={content.title}
    description={content.description}
    header={{ cta: content.trialCta }}
>
    <Hero {routePath} {...content.hero}>
        <Fragment slot="title">Migrate Pipedream workflows to Kestra</Fragment>
        <Fragment slot="lead">
            Pipedream Workflows shuts down on March 31, 2027 and deletes its
            data on April 30. Export the JSON, convert it to Kestra YAML with
            your coding agent, and repoint each webhook.
        </Fragment>
        <Fragment slot="form-sub">
            14 days free, no credit card. Tell us what you run on Pipedream and
            we set up your instance.
        </Fragment>
        <Fragment slot="form">
            <div id="contact-sales" class="form-anchor">
                <CloudForm variant="plain" {...cloudForm} client:idle />
            </div>
        </Fragment>
    </Hero>
    <PageShell>
        <PdDates />
        <PdCompare />
        <ControlPlane
            headingId="pd-steps-title"
            title="From export to cutover"
            lead=""
            domains={STEP_DOMAINS}
            bridge={false}
        />
        <PdMapping />
        <RunKestra
            title="Where to run the flows"
            lead="The same YAML runs on all three editions."
            editions={runEditions("#contact-sales")}
            compare={{ label: "Compare editions", href: "/pricing" }}
        />
        <BuyerQuestions
            title="Questions from Pipedream teams"
            items={content.faq}
        />
    </PageShell>
</LpLayout>

<style lang="scss">
    .form-anchor {
        display: contents;
    }
</style>
