---
/**
 * Google Ads landing page — variant 2 (ad group: data orchestration).
 *
 * Same nine lines as variant 1 with a different content import: everything the
 * page renders lives in the template and the content object.
 */
import LpLayout from "~/components/lp/LpLayout.astro"
import LpTemplate from "~/components/lp/LpTemplate.astro"
import variant from "~/contents/lp/data-orchestration"
---

<LpLayout
    title={variant.meta.title}
    description={variant.meta.description}
    ogTitle={variant.meta.ogTitle}
    variant={variant.slug}
    canonicalPath={`/lp/${variant.slug}`}
    headerCta
>
    <LpTemplate variant={variant} />
</LpLayout>
