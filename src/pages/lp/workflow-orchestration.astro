---
import Layout from "~/components/layout.astro"

import LpHeader from "~/components/lp/workflow-orchestration/LpHeader.astro"
import LpFooter from "~/components/lp/workflow-orchestration/LpFooter.astro"
import Hero from "~/components/lp/workflow-orchestration/Hero.astro"
import Platform from "~/components/lp/workflow-orchestration/Platform.astro"
import Features from "~/components/lp/workflow-orchestration/Features.astro"
import Stack from "~/components/lp/workflow-orchestration/Stack.astro"
import Roi from "~/components/lp/workflow-orchestration/Roi.astro"
import Trusted from "~/components/lp/workflow-orchestration/Trusted.astro"
import Migration from "~/components/lp/workflow-orchestration/Migration.astro"
import UseCases from "~/components/lp/workflow-orchestration/UseCases.astro"
import Faq from "~/components/lp/workflow-orchestration/Faq.astro"
import ClosingBanner from "~/components/lp/workflow-orchestration/ClosingBanner.astro"

const title = "Unified Workflow Orchestration Platform for the AI era"
const description =
    "Build, run, and govern every workflow across data, infrastructure, apps, and business processes. Any language, on your own infrastructure."

/** HubSpot records this as the page the lead converted on. */
const routePath = "/lp/workflow-orchestration"

const faqItems = [
    {
        question:
            "Can we run it fully self-hosted, on-prem, or air-gapped, with our data never leaving our network?",
        answer: "Yes — self-hosted is a first-class deployment. Workers run inside your VPC or on-prem, so data stays in your environment.",
    },
    {
        question:
            "Does it support SSO/SAML, RBAC, audit logs, and multi-tenant isolation?",
        answer: 'Yes. The Enterprise Edition adds SSO (SAML and OIDC) with SCIM provisioning, fine-grained role-based access control, full audit logs, and tenant-level isolation so teams share one deployment without seeing each other\'s workloads. See the <a href="/docs/enterprise">Enterprise documentation</a> for the full list.',
    },
    {
        question: "Do we need Kubernetes?",
        answer: 'No. Kestra runs from a single Docker container on one VM, and scales out to worker groups and high availability when you need it. Kubernetes and Helm are supported but never required — see <a href="/docs/installation">the installation guides</a>.',
    },
    {
        question: "How do we avoid lock-in?",
        answer: 'Workflows are plain YAML stored in Git, and your scripts stay in whatever language they were written in. The core is open source under Apache 2.0, so you can keep running it yourself, and everything is reachable over a documented <a href="/docs/api-reference">REST API</a>.',
    },
    {
        question:
            "Can one platform run data, infra, and business workflows — or do we end up with two orchestrators?",
        answer: "One platform. The same engine schedules data pipelines, infrastructure jobs, AI workloads, and business processes, with namespaces to keep each team's workflows separate and 1,800+ plugins covering the systems they each depend on.",
    },
    {
        question: "How is Kestra priced?",
        answer: 'The open-source edition is free with no execution limits. Enterprise Edition and Cloud are priced per deployment based on your scale and support needs — see <a href="/pricing">pricing</a> or talk to us for a quote.',
    },
]
---

<Layout {title} {description} noindex bareChrome>
    <div class="lp-workflow-orchestration">
        <LpHeader />
        <Hero {routePath} />
        <Platform />
        <Features />
        <Stack />
        <Roi />
        <Trusted />
        <Migration />
        <UseCases {routePath} />
        <Faq items={faqItems} />
        <ClosingBanner />
        <LpFooter />
    </div>
</Layout>

<style lang="scss">
    /* An ad landing page has to look identical for every visitor, so this page
     * pins literal values instead of the theme-aware --ks-* tokens (which all
     * shift in dark mode) — the same approach the homepage takes with --hp-*.
     * The values below that DO have a token are the light-theme value of it;
     * the rest come from the newer Figma set that the palette doesn't carry
     * yet. Swap them for --ks-* once that set lands in _color-palette.scss. */
    .lp-workflow-orchestration {
        --lp-purple: #631bff; /* --ks-content-color-highlight */
        --lp-purple-light: #f1efff; /* --ks-background-purple-light */
        --lp-purple-rail: #cdc5ff; /* --ks-background-purple-hover */
        --lp-shadow-light: #3952f21a; /* --ks-shadows-light */

        /* Figma-only, no palette equivalent yet. */
        --lp-bg-dark: #111115;
        /* Figma's `border-focus`. The design reaches for it wherever #631bff
         * would go muddy: ticks on the dark ground, the Stack rules. */
        --lp-purple-mid: #9869f7;
        /* Figma's `content-secondary`, distinct from `text-secondary` above —
         * the design uses this one for body copy inside white cards. */
        --lp-content-on-card: #3b3a41;
        /* Only the open FAQ answer panel uses this; every other light section in
         * the design is flat white. */
        --lp-bg-base: #f7f7f8;
        --lp-content-primary: #08090a;
        --lp-content-secondary: #5f5f7c;
        --lp-content-muted: #7e7e9b;
        --lp-content-dark-secondary: #adadbf;
        --lp-border: #d0d0da;
        --lp-border-subtle: #e9e9ee;

        background-color: #ffffff;
    }
</style>
