---
import LpLayout from "~/components/lp/LpLayout.astro"
import Hero from "~/components/lp/shared/Hero.astro"
import Platform from "~/components/lp/shared/Platform.astro"
import Features from "~/components/lp/shared/Features.astro"
import Stack from "~/components/lp/shared/Stack.astro"
import Roi from "~/components/lp/workflow-orchestration/Roi.astro"
import Trusted from "~/components/lp/workflow-orchestration/Trusted.astro"
import Migration from "~/components/lp/shared/Migration.astro"
import UseCases from "~/components/lp/shared/UseCases.astro"
import Faq from "~/components/lp/shared/Faq.astro"
import ClosingBanner from "~/components/lp/shared/ClosingBanner.astro"

import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"
import { getWorkflowOrchestrationContent } from "~/components/lp/workflow-orchestration/workflowOrchestrationContent"

const routePath = "/lp/workflow-orchestration"

const content = getWorkflowOrchestrationContent(await fetchTotalPluginsCount())
---

<LpLayout title={content.title} description={content.description}>
    <Hero {routePath} {...content.hero}>
        <Fragment slot="title">
            Unified <span class="grad grad-a">Workflow</span>{" "}
            <span class="grad grad-b">Orchestration</span> Platform for <br
                class="wrap"
            />the AI era.
        </Fragment>
        <Fragment slot="lead">
            Build, run, and govern every workflow across data, infrastructure,
            agent, and business processes.<br />
            <strong>Any language, on your own infrastructure.</strong>
        </Fragment>
        <Fragment slot="form-sub">
            Your Architecture is Unique.<br />
            Your Challenges are Specific.
        </Fragment>
    </Hero>
    <Platform {...content.platform} />
    <Migration {...content.migration} />
    <Features {...content.features} />
    <Stack {...content.stack} />
    <Trusted />
    <UseCases {routePath} {...content.useCases} />
    <Roi />
    <Faq {...content.faq} />
    <ClosingBanner {...content.closingBanner} />
</LpLayout>
