---
import Layout from "~/components/layout.astro"

import LpHeader from "~/components/lp/workflow-orchestration/LpHeader.astro"
import LpFooter from "~/components/lp/workflow-orchestration/LpFooter.astro"
import Hero from "~/components/lp/workflow-orchestration/Hero.astro"
import Platform from "~/components/lp/workflow-orchestration/Platform.astro"
import Migration from "~/components/lp/workflow-orchestration/Migration.astro"
import Features from "~/components/lp/workflow-orchestration/Features.astro"
import Stack from "~/components/lp/workflow-orchestration/Stack.astro"
import UseCases from "~/components/lp/workflow-orchestration/UseCases.astro"
import Faq from "~/components/lp/workflow-orchestration/Faq.astro"
import ClosingBanner from "~/components/lp/workflow-orchestration/ClosingBanner.astro"
import Translation from "~/components/lp/vra-migration/Translation.astro"
import Proof from "~/components/lp/vra-migration/Proof.astro"
import Payback from "~/components/lp/vra-migration/Payback.astro"
import Assistant from "~/components/lp/vra-migration/Assistant.astro"

import SelfServiceIcon from "~/components/lp/vra-migration/assets/automate-self-service.svg"
import DayTwoIcon from "~/components/lp/vra-migration/assets/automate-day-2.svg"
import DecommissioningIcon from "~/components/lp/vra-migration/assets/automate-decommissioning.svg"
import IntegrationsIcon from "~/components/lp/vra-migration/assets/automate-integrations.svg"

/* Paid traffic only: every ad group lands here and is told apart by its
 * utm_content. The organic page for the topic is the migration guide. */
const title = "Migrate off VMware vRA, Aria and VCF Automation"
const description =
    "Kestra replaces vRealize Automation (now Aria Automation and VCF Automation) and vRealize Orchestrator (vRO) with one governed orchestration platform on your own infrastructure. Keep your Terraform, Ansible and scripts."

/** HubSpot records this as the page the lead converted on. */
const routePath = "/lp/vra-migration"

/* Same HubSpot form as /lp/workflow-orchestration; only the button reads
 * differently. */
const formProps = { submitLabel: "Get my migration estimate" }

const reasons = [
    {
        kicker: "Pricing",
        title: "Since Broadcom's licensing changes, vRA ships only inside VMware Cloud Foundation.",
        body: "Priced per core on subscription, so the bill tracks your hypervisor footprint. Gartner expects renewals 200 to 500% higher.",
        icon: "mdi:cash-multiple",
    },
    {
        kicker: "Roadmap",
        title: "Your automation only reaches what VMware supports.",
        body: "And that list is shrinking: VCF Automation 9.1.1 disables native AWS, Azure and GCP endpoints by default.",
        icon: "mdi:map-marker-path",
    },
    {
        kicker: "Skills",
        title: "vRO JavaScript skills are rare.",
        body: "Every workflow change waits on the same few people. Kestra flows are YAML any engineer can read, with the logic in Python, PowerShell or Ansible.",
        icon: "mdi:account-group-outline",
    },
]

const stages = [
    {
        number: "01",
        title: "Assess",
        body: "The Migration Assistant reads your vRO and vRA exports and tells you what to retire, merge or convert.",
        wash: "radial-gradient(120% 150% at 92% -45%, rgba(99, 27, 255, 1) 0%, rgba(227, 24, 224, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
    {
        number: "02",
        title: "Prove",
        body: "A proof of concept on your own workflows, with your security team in the room.",
        wash: "radial-gradient(150% 170% at -20% 140%, rgba(99, 27, 255, 1) 0%, rgba(24, 227, 61, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
    {
        number: "03",
        title: "Migrate",
        body: "Move in waves by pattern. Both systems run side by side.",
        wash: "radial-gradient(130% 150% at -30% -30%, rgba(99, 27, 255, 1) 0%, rgba(24, 166, 227, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
    {
        number: "04",
        title: "Exit",
        body: "Switch off vRA wave by wave and end the licence at renewal.",
        wash: "radial-gradient(140% 160% at 110% 130%, rgba(99, 27, 255, 1) 0%, rgba(255, 168, 24, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
]

const automations = [
    {
        Glyph: SelfServiceIcon,
        title: "Self-service portal and VM provisioning",
        items: [
            "Request form in Kestra Apps or your ITSM portal",
            "Approval before the build",
            "VM build",
            "Post-install by server type and site",
        ],
    },
    {
        Glyph: DayTwoIcon,
        title: "Day-2 runbooks",
        items: ["Patching", "Snapshots", "Certificate rotation", "Resizing"],
    },
    {
        Glyph: DecommissioningIcon,
        title: "Decommissioning",
        items: [
            "Delete the VM",
            "Clean up AD, DNS and IPAM",
            "Close the ticket",
        ],
    },
    {
        Glyph: IntegrationsIcon,
        title: "Integrations",
        items: [
            "ServiceNow",
            "Infoblox",
            "Active Directory",
            "Microsoft Teams",
            "vCenter",
            "Terraform and Ansible",
        ],
    },
]

const ctaBullets = [
    {
        text: "We run the Migration Assistant on a sanitised export with you.",
        strong: true,
    },
    { text: "You get a wave plan.", strong: false },
    { text: "You get an exit plan timed to your renewal.", strong: false },
]

const faqItems = [
    {
        question:
            "Are vRealize Automation, Aria Automation and VCF Automation the same product?",
        answer: "Yes. VMware vRealize Automation (vRA) was renamed VMware Aria Automation, then VCF Automation in VMware Cloud Foundation 9. vRealize Orchestrator (vRO) became Aria Automation Orchestrator and now ships inside VCF Automation. The migration method is the same whichever name your version carries.",
    },
    {
        question: "Is Kestra a vRA alternative or a vRO replacement?",
        answer: "Both. Kestra replaces the vRO workflow engine with flows and subflows, and the vRA front end with Kestra Apps for the self-service catalog and Kestra Assets for the deployment inventory. If your catalog lives in ServiceNow or another ITSM portal, it can stay there and call Kestra.",
    },
    {
        question: "How is vRA priced since Broadcom?",
        answer: 'vRA is no longer sold on its own. It ships inside VMware Cloud Foundation, licensed per core on subscription, so the automation bill tracks the size of the hypervisor footprint rather than how much you automate. Gartner expects most VMware customers\' bills to grow by 200 to 500 percent at their next renewal, <a href="https://www.theregister.com/2024/08/26/vmware_explore_preview/" target="_blank" rel="noopener">as reported by The Register</a>. The calculator above sets that renewal against the cost of migrating.',
    },
    {
        question: "Do we have to leave vSphere?",
        answer: "No. Kestra runs with vSphere and VCF today, and with Nutanix, Proxmox or any hypervisor you move to.",
    },
    {
        question:
            "We run vSphere on-prem and workloads in AWS, Azure or GCP. Can one platform cover both?",
        answer: 'Yes. The same flows call vCenter on-prem and the AWS, Azure and GCP APIs, Terraform and Ansible, with one audit trail and one access model. That matters since VCF Automation 9.1.1 <a href="https://knowledge.broadcom.com/external/article/448993" target="_blank" rel="noopener">disables native public cloud endpoints by default</a>.',
    },
    {
        question: "Can vRA and Kestra run side by side?",
        answer: "Yes, for as long as each wave needs.",
    },
    {
        question: "Do our vRO workflows have to be rewritten?",
        answer: "Wrappers are called as they are; the rest is converted or rebuilt, and the Migration Assistant tells you which. Converted flows are tested against a simulated copy of your environment before they reach yours.",
    },
    {
        question:
            "Can it run fully self-hosted, on-prem, or air-gapped, with our data never leaving our network?",
        answer: "Yes. Self-hosted is a first-class deployment rather than a workaround. Workers run inside your VPC or on-prem, you bring your own secret manager, and Kestra holds no access to your data. Worker Groups let one control plane reach physically isolated networks, and licensing works offline so a fully air-gapped install is supported.",
    },
    {
        question: "How is Kestra priced?",
        answer: "Kestra does not price per execution. The model scales with how broadly the platform is deployed rather than how often your workflows run, so adding volume does not change the bill. Enterprise pricing depends on deployment scope and support tier, and we walk through it on the call.",
    },
    {
        question: "How long does a migration take?",
        answer: "It depends on the environment. The assessment gives you the wave plan and the dates. A Fortune 500 manufacturer replaced vRA and vRO in about twelve months, with both running side by side until each wave was verified.",
    },
    {
        question: "Do you help teams moving off vRA and vRO?",
        answer: 'Yes. The <a href="/resources/migration/vra">vRA migration guide</a> covers the method stage by stage, and the open-source <a href="/resources/migration/vra/assistant">Migration Assistant</a> reads your vRO package on your own machine and writes the migration brief.',
    },
    {
        question:
            "We already use Kestra. How do we assess our vRO workflows ourselves?",
        answer: 'Run the <a href="/resources/migration/vra/assistant">Kestra Migration Assistant for vRA</a>, a free, open-source command-line tool. It reads your vRO package, and optionally your vRA export, on your own machine, sends nothing to Kestra, and writes a brief: what each workflow does and what it calls, which Kestra plugins cover those systems, whether each element converts directly or needs a redesign, and a plan in waves. It can use a model you host, or none at all, so it also runs air-gapped. The conversion itself is then done in Kestra, starting from the brief.',
    },
]
---

<Layout {title} {description} noindex bareChrome forceTheme="light">
    <div class="lp-workflow-orchestration">
        <LpHeader showGithub={false} />
        <Hero
            {routePath}
            formTitle="Bring your vRA renewal quote."
            {formProps}
            companies={[
                "bundesagentur",
                "itzbund",
                "jpmorgan",
                "t-system",
                "amdocs",
                "fila",
                "bloomberg",
                "xiaomi",
                "apple",
            ]}
        >
            <Fragment slot="title">
                Migrate off <span class="grad grad-a">VMware vRA</span>{" "}
                and <span class="grad grad-b">vRO</span>, one wave at a time.
            </Fragment>
            <Fragment slot="lead">
                Kestra replaces vRealize Automation (now Aria Automation and VCF
                Automation) and vRealize Orchestrator (vRO) with one governed
                orchestration platform on your own infrastructure. Keep your
                Terraform, Ansible and scripts. Retire the vRA licence at
                renewal.<br />
                <strong
                    >Runs with vSphere today, and with Nutanix, Proxmox or
                    whatever you move to next.</strong
                >
            </Fragment>
            <Fragment slot="form-sub">
                We map your environment and estimate the migration in a 30-minute
                call.
            </Fragment>
        </Hero>
        <script is:inline>
            /* Echo the searched product and intent in the headline. The G_VRA
             * final URL suffix passes the keyword as utm_term; the term is only
             * matched against, never written, and without it the static
             * headline above stays. */
            ;(() => {
                const term = (
                    new URLSearchParams(location.search).get("utm_term") || ""
                ).toLowerCase()
                const h1 = document.querySelector(".lp-hero h1")
                if (!term || !h1) return
                const isVro = /orchestrator|\bvro\b/.test(term)
                const product = /aria/.test(term)
                    ? "Aria Automation"
                    : isVro
                      ? "vRO"
                      : /vcf|cloud foundation/.test(term)
                        ? "VCF Automation"
                        : /vrealize/.test(term)
                          ? "vRealize Automation"
                          : "VMware vRA"
                /* Clone a server-rendered span so the scoped gradient styles,
                 * keyed on Astro's data-astro-cid attribute, still apply. */
                const span = (variant, text) => {
                    const el = h1.querySelector(".grad").cloneNode(false)
                    el.className = `grad grad-${variant}`
                    el.textContent = text
                    return el.outerHTML
                }
                const a = (text) => span("a", text)
                const b = (text) => span("b", text)
                if (/pric|licens|cost|renewal/.test(term)) {
                    h1.innerHTML = `Retire the ${a(`${product} licence`)} at ${b("renewal")}, one workflow at a time.`
                } else if (/alternative|replacement/.test(term)) {
                    h1.innerHTML = `The ${a(product === "VMware vRA" ? "vRA and vRO" : product)} ${b("alternative")} on your own infrastructure.`
                } else if (/self.?service|portal/.test(term)) {
                    h1.innerHTML = `Replace the ${a("VMware")} ${b("self-service portal")}, one workflow at a time.`
                } else if (product !== "VMware vRA") {
                    h1.innerHTML = isVro
                        ? `Migrate off ${a("VMware")} ${b("vRO")}, one workflow at a time.`
                        : `Migrate off ${a(product)} and ${b("vRO")}, one workflow at a time.`
                }
            })()
        </script>
        <Platform
            heading="Why teams look for a vRA alternative"
            cards={reasons}
        />
        <Migration
            heading="Leave vRA in four stages, with vRA still running"
            sub="Kestra runs alongside vRA until each wave is verified."
            steps={stages}
        />
        <Translation />
        <Assistant />
        <Features />
        <Stack
            heading="What teams automate after vRA"
            sub="The VMware automation that ran in vRA and vRO, rebuilt as flows that also reach beyond vSphere."
            columns={automations}
            glyphSize={72}
        />
        <Proof />
        <UseCases
            {routePath}
            headingLines={["See it on your", "own vRO workflows"]}
            bullets={ctaBullets}
            {formProps}
        />
        <Payback />
        <Faq items={faqItems} />
        <ClosingBanner
            heading="Bring your vRA renewal quote"
            sub="We'll set the exit plan against your renewal date."
        />
        <LpFooter />
    </div>
</Layout>

<style lang="scss">
    /* Same pinned palette as /lp/workflow-orchestration: the wrapper class is
     * shared on purpose, so this page inherits its section components' tokens.
     * Keep the two lists identical. */
    .lp-workflow-orchestration {
        --lp-purple: #631bff;
        --lp-purple-light: #f1efff;
        --lp-purple-rail: #cdc5ff;
        --lp-shadow-light: #3952f21a;
        --lp-bg-dark: #111115;
        --lp-purple-mid: #9869f7;
        --lp-content-on-card: #3b3a41;
        --lp-bg-base: #f7f7f8;
        --lp-content-primary: #08090a;
        --lp-content-secondary: #5f5f7c;
        --lp-content-muted: #7e7e9b;
        --lp-content-dark-secondary: #adadbf;
        --lp-border: #d0d0da;
        --lp-border-subtle: #e9e9ee;

        background-color: #ffffff;
        overflow-x: clip;
    }

    :global(html) {
        --top-bar-height: 80px;
    }
</style>
