---
import LpLayout from "~/components/lp/LpLayout.astro"

import Hero from "~/components/lp/shared/Hero.astro"
import Platform from "~/components/lp/shared/Platform.astro"
import Migration from "~/components/lp/shared/Migration.astro"
import Features from "~/components/lp/shared/Features.astro"
import Stack from "~/components/lp/shared/Stack.astro"
import UseCases from "~/components/lp/shared/UseCases.astro"
import Faq from "~/components/lp/shared/Faq.astro"
import ClosingBanner from "~/components/lp/shared/ClosingBanner.astro"
import Translation from "~/components/lp/shared/Translation.astro"
import Proof from "~/components/lp/shared/Proof.astro"
import Payback from "~/components/lp/vra-migration/Payback.astro"
import Assistant from "~/components/lp/vra-migration/Assistant.astro"
import HeroActions from "~/components/lp/vra-migration/HeroActions.astro"
import GuideOffer from "~/components/lp/vra-migration/GuideOffer.astro"
import WebinarBanner from "~/components/vra-migration-guide/WebinarBanner.astro"

import { vraMigrationContent as content } from "~/components/lp/vra-migration/vraMigrationContent"

const routePath = "/lp/vra-migration"

/* The call form lower on the page (#contact-sales): same HubSpot form as
 * /lp/workflow-orchestration; only the button reads differently. */
const formProps = { submitLabel: "Get my migration estimate" }
---

<LpLayout title={content.title} description={content.description}>
    <Hero {routePath} {...content.hero}>
        <Fragment slot="title">
            Migrate off <span class="grad grad-a">VMware vRA</span>{" "}
            and <span class="grad grad-b">vRO</span>, one wave at a time.
        </Fragment>
        <Fragment slot="lead">
            Kestra replaces vRealize Automation (now Aria Automation and VCF
            Automation) and vRealize Orchestrator (vRO) with one governed
            orchestration platform on your own infrastructure.<br />
            Keep your Terraform, Ansible and scripts. Retire the vRA licence at
            renewal.<br />
            <strong
                >Runs with vSphere today, and with Nutanix, Proxmox or
                whatever you move to next.</strong
            >
        </Fragment>
        <Fragment slot="form-sub">
            We map your environment and estimate the migration in a
            30-minute call.
        </Fragment>
        <HeroActions slot="form" {routePath} {formProps} />
    </Hero>
    <WebinarBanner />
    <script is:inline>
        /* Echo the searched product and intent in the headline. The G_VRA
         * final URL suffix passes the keyword as utm_term; the term is only
         * matched against, never written, and without it the static
         * headline above stays. */
        ;(() => {
            const term = (
                new URLSearchParams(location.search).get("utm_term") || ""
            ).toLowerCase()
            const h1 = document.querySelector(".lp-hero h1")
            if (!term || !h1) return
            const isProductSearch =
                /vra|vro|aria|vrealize|orchestrator|automation/.test(term)
            const isVro = /orchestrator|\bvro\b/.test(term)
            const product = /aria/.test(term)
                ? "Aria Automation"
                : isVro
                  ? "vRO"
                  : /vcf|cloud foundation/.test(term)
                    ? "VCF Automation"
                    : /vrealize/.test(term)
                      ? "vRealize Automation"
                      : "VMware vRA"
            /* Clone a server-rendered span so the scoped gradient styles,
             * keyed on Astro's data-astro-cid attribute, still apply. */
            const span = (variant, text) => {
                const el = h1.querySelector(".grad").cloneNode(false)
                el.className = `grad grad-${variant}`
                el.textContent = text
                return el.outerHTML
            }
            const a = (text) => span("a", text)
            const b = (text) => span("b", text)
            /* Broad VMware searches (no product named) get the
             * orchestrator-first pitch instead of a vRA headline. */
            if (
                !isProductSearch &&
                /vmware|vcf|cloud foundation|vsphere|vvf|broadcom|esxi/.test(
                    term,
                )
            ) {
                h1.innerHTML = `Moving off ${a("VMware")}? Start with the ${b("orchestrator")}.`
                /* Keep the server-rendered bold line, as the static lead has it. */
                const lead = document.querySelector(".lp-hero .lead-copy")
                const strong = lead?.querySelector("strong")
                if (lead)
                    lead.replaceChildren(
                        "Your vRO workflows are what tie you to vSphere. Replace them with Kestra first, and change the hypervisor when you're ready.",
                        ...(strong
                            ? [document.createElement("br"), strong]
                            : []),
                    )
            } else if (
                isProductSearch &&
                /pric|licens|cost|renewal/.test(term)
            ) {
                h1.innerHTML = `Retire the ${a(`${product} licence`)} at ${b("renewal")}, one workflow at a time.`
            } else if (/alternative|replacement/.test(term)) {
                h1.innerHTML = `The ${a(product === "VMware vRA" ? "vRA and vRO" : product)} ${b("alternative")} on your own infrastructure.`
            } else if (/self.?service|portal/.test(term)) {
                h1.innerHTML = `Replace the ${a("VMware")} ${b("self-service portal")}, one workflow at a time.`
            } else if (product !== "VMware vRA") {
                h1.innerHTML = isVro
                    ? `Migrate off ${a("VMware")} ${b("vRO")}, one workflow at a time.`
                    : `Migrate off ${a(product)} and ${b("vRO")}, one workflow at a time.`
            }
        })()
    </script>
    <Migration {...content.migration} />
    <section class="demo-video">
        <div class="head" data-usal="fade-u delay-50 duration-500 ease-out">
            <h2>See it in 8 minutes</h2>
            <p>
                Kestra runs the whole VM lifecycle on vSphere: it builds the
                VM, waits for the patch approval in ServiceNow, and keeps
                every system up to date. Only the vCenter steps are tied to
                VMware, so you can move to another hypervisor later without
                rebuilding the rest.
            </p>
        </div>
        <div class="player">
            <div class="video-container">
                <iframe
                    src="https://www.youtube.com/embed/brZo-5NdP2E"
                    title="Kestra replacing vRA: the VM lifecycle on vSphere"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen></iframe>
            </div>
        </div>
    </section>
    <Platform {...content.platform} />
    <Translation {...content.translation} />
    <Proof {...content.proof} />
    <GuideOffer />
    <Assistant />
    <Features {...content.features} />
    <Stack {...content.stack} />
    <UseCases {routePath} {...content.useCases} {formProps} />
    <Payback />
    <Faq {...content.faq} />
    <ClosingBanner {...content.closingBanner} />
</LpLayout>

<style lang="scss">
    @use "/src/components/lp/shared/lp" as *;

    /* Same head as the four stages section above it, which already supplies
     * the top padding. */
    .demo-video {
        padding: 0 1rem 5rem;
        background-color: #ffffff;

        .head {
            @include lp-section-head;

            h2 {
                margin: 0 0 2rem;
                @include lp-heading;
            }

            p {
                margin: 0;
                @include lp-lead;
            }
        }

        /* The capped wrapper keeps the global .video-container ratio, whose
         * padding is a percentage of its parent's width. */
        .player {
            @include lp-container(900px);
            border-radius: 10px;
            overflow: hidden;
        }
    }
</style>
