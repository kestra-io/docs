---
import Layout from "~/components/layout.astro"

import LpHeader from "~/components/lp/workflow-orchestration/LpHeader.astro"
import LpFooter from "~/components/lp/workflow-orchestration/LpFooter.astro"
import Hero from "~/components/lp/workflow-orchestration/Hero.astro"
import Platform from "~/components/lp/workflow-orchestration/Platform.astro"
import Migration from "~/components/lp/workflow-orchestration/Migration.astro"
import Features from "~/components/lp/workflow-orchestration/Features.astro"
import Stack from "~/components/lp/workflow-orchestration/Stack.astro"
import UseCases from "~/components/lp/workflow-orchestration/UseCases.astro"
import Faq from "~/components/lp/workflow-orchestration/Faq.astro"
import ClosingBanner from "~/components/lp/workflow-orchestration/ClosingBanner.astro"
import Translation from "~/components/lp/vra-migration/Translation.astro"
import Proof from "~/components/lp/vra-migration/Proof.astro"
import Payback from "~/components/lp/vra-migration/Payback.astro"

import SelfServiceIcon from "~/components/lp/vra-migration/assets/automate-self-service.svg"
import DayTwoIcon from "~/components/lp/vra-migration/assets/automate-day-2.svg"
import DecommissioningIcon from "~/components/lp/vra-migration/assets/automate-decommissioning.svg"
import IntegrationsIcon from "~/components/lp/vra-migration/assets/automate-integrations.svg"

/* Paid traffic only: every ad group lands here and is told apart by its
 * utm_content. The organic page for the topic is the migration guide. */
const title = "Migrate off VMware vRA and vRO"
const description =
    "Kestra replaces vRealize Automation (Aria Automation) and vRO with one governed orchestration platform on your own infrastructure. Keep your Terraform, Ansible and scripts."

/** HubSpot records this as the page the lead converted on. */
const routePath = "/lp/vra-migration"

/* Both forms ask the same two qualifying questions. The HubSpot contact
 * properties named here must exist before the page takes traffic. */
const formProps = {
    submitLabel: "Get my migration estimate",
    extraFields: [
        {
            type: "select",
            name: "vro-workflows",
            property: "vro_workflow_count",
            placeholder: "Number of vRO workflows",
            options: ["Under 100", "100–500", "500–2,000", "2,000+"],
            required: true,
        },
        {
            type: "month-year",
            name: "vra-renewal",
            property: "vra_renewal_date",
            monthPlaceholder: "Renewal month",
            yearPlaceholder: "Renewal year",
            years: [2026, 2027, 2028, 2029, 2030],
        },
    ],
}

const reasons = [
    {
        kicker: "Pricing",
        title: "vRA now ships inside VMware Cloud Foundation, priced per core.",
        body: "Per-core subscriptions mean renewals land at several times the old bill.",
        icon: "mdi:cash-multiple",
    },
    {
        kicker: "Roadmap",
        title: "Your automation only reaches what VMware supports.",
        body: "And that list is shrinking.",
        icon: "mdi:map-marker-path",
    },
    {
        kicker: "Skills",
        title: "vRO JavaScript skills are rare.",
        body: "Every workflow change goes through the same few people.",
        icon: "mdi:account-group-outline",
    },
]

const stages = [
    {
        number: "01",
        title: "Assess",
        body: "The Migration Assistant reads your vRO and vRA exports and tells you what to retire, merge or convert.",
        wash: "radial-gradient(120% 150% at 92% -45%, rgba(99, 27, 255, 1) 0%, rgba(227, 24, 224, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
    {
        number: "02",
        title: "Prove",
        body: "A proof of concept on your own workflows, with your security team in the room.",
        wash: "radial-gradient(150% 170% at -20% 140%, rgba(99, 27, 255, 1) 0%, rgba(24, 227, 61, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
    {
        number: "03",
        title: "Migrate",
        body: "Move in waves by pattern. Both systems run side by side.",
        wash: "radial-gradient(130% 150% at -30% -30%, rgba(99, 27, 255, 1) 0%, rgba(24, 166, 227, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
    {
        number: "04",
        title: "Exit",
        body: "Switch off vRA wave by wave and end the licence at renewal.",
        wash: "radial-gradient(140% 160% at 110% 130%, rgba(99, 27, 255, 1) 0%, rgba(255, 168, 24, 0.73) 28%, rgba(72, 19, 184, 0.3) 70%, rgba(59, 16, 153, 0) 100%)",
    },
]

const automations = [
    {
        Glyph: SelfServiceIcon,
        title: "Self-service provisioning",
        items: [
            "Catalog form for the request",
            "VM build",
            "Post-install by server type and site",
        ],
    },
    {
        Glyph: DayTwoIcon,
        title: "Day-2 operations",
        items: ["Patching", "Snapshots", "Certificate rotation", "Resizing"],
    },
    {
        Glyph: DecommissioningIcon,
        title: "Decommissioning",
        items: [
            "Delete the VM",
            "Clean up AD, DNS and IPAM",
            "Close the ticket",
        ],
    },
    {
        Glyph: IntegrationsIcon,
        title: "Integrations",
        items: [
            "ServiceNow",
            "Infoblox",
            "Active Directory",
            "Microsoft Teams",
            "vCenter",
        ],
    },
]

const ctaBullets = [
    {
        text: "We run the Migration Assistant on a sanitised export with you.",
        strong: true,
    },
    { text: "You get a wave plan.", strong: false },
    { text: "You get an exit plan timed to your renewal.", strong: false },
]

const faqItems = [
    {
        question: "Do we have to leave vSphere?",
        answer: "No. Kestra runs with vSphere and VCF today, and with any hypervisor you move to.",
    },
    {
        question: "Can vRA and Kestra run side by side?",
        answer: "Yes, for as long as each wave needs.",
    },
    {
        question: "Do our vRO workflows have to be rewritten?",
        answer: "Wrappers are called as they are; the rest is converted or rebuilt, and the Migration Assistant tells you which.",
    },
    {
        question:
            "Can it run fully self-hosted, on-prem, or air-gapped, with our data never leaving our network?",
        answer: "Yes. Self-hosted is a first-class deployment rather than a workaround. Workers run inside your VPC or on-prem, you bring your own secret manager, and Kestra holds no access to your data. Worker Groups let one control plane reach physically isolated networks, and licensing works offline so a fully air-gapped install is supported.",
    },
    {
        question: "How is Kestra priced?",
        answer: "Kestra does not price per execution. The model scales with how broadly the platform is deployed rather than how often your workflows run, so adding volume or agent steps does not change the bill. Enterprise pricing depends on deployment scope and support tier, and we walk through it on the call.",
    },
    {
        question: "How long does a migration take?",
        answer: "It depends on the estate. The assessment gives you the wave plan and the dates.",
    },
]
---

<Layout {title} {description} noindex bareChrome>
    <div class="lp-workflow-orchestration">
        <LpHeader showGithub={false} />
        <Hero
            {routePath}
            formTitle="Bring your vRA renewal quote."
            {formProps}
            companies={[
                "bundesagentur",
                "itzbund",
                "jpmorgan",
                "t-system",
                "amdocs",
                "fila",
                "bloomberg",
                "xiaomi",
                "apple",
            ]}
        >
            <Fragment slot="title">
                Migrate off <span class="grad grad-a">VMware vRA</span>{" "}
                and <span class="grad grad-b">vRO</span>, one workflow at a
                time.
            </Fragment>
            <Fragment slot="lead">
                Kestra replaces vRealize Automation (Aria Automation) and vRO
                with one governed orchestration platform on your own
                infrastructure. Keep your Terraform, Ansible and scripts. Retire
                the vRA licence at renewal.<br />
                <strong
                    >Runs with vSphere today, and with whatever you move to
                    next.</strong
                >
            </Fragment>
            <Fragment slot="form-sub">
                We map your estate and estimate the migration in a 30-minute
                call.
            </Fragment>
        </Hero>
        <Platform heading="Why teams are leaving vRA" cards={reasons} />
        <Migration
            heading="Leave vRA in four stages, with vRA still running"
            sub="Kestra runs alongside vRA until each wave is verified."
            steps={stages}
        />
        <Translation />
        <Features />
        <Stack
            heading="What teams automate after vRA"
            sub={null}
            columns={automations}
        />
        <Proof />
        <UseCases
            {routePath}
            headingLines={["See it on your", "own vRO workflows"]}
            bullets={ctaBullets}
            {formProps}
        />
        <Payback calculatorHref="/resources/migration/vra/payback" />
        <Faq items={faqItems} />
        <ClosingBanner
            heading="Bring your vRA renewal quote"
            sub="We'll set the exit plan against your renewal date."
        />
        <LpFooter />
    </div>
</Layout>

<style lang="scss">
    /* Same pinned palette as /lp/workflow-orchestration: the wrapper class is
     * shared on purpose, so this page inherits its section components' tokens.
     * Keep the two lists identical. */
    .lp-workflow-orchestration {
        --lp-purple: #631bff;
        --lp-purple-light: #f1efff;
        --lp-purple-rail: #cdc5ff;
        --lp-shadow-light: #3952f21a;
        --lp-bg-dark: #111115;
        --lp-purple-mid: #9869f7;
        --lp-content-on-card: #3b3a41;
        --lp-bg-base: #f7f7f8;
        --lp-content-primary: #08090a;
        --lp-content-secondary: #5f5f7c;
        --lp-content-muted: #7e7e9b;
        --lp-content-dark-secondary: #adadbf;
        --lp-border: #d0d0da;
        --lp-border-subtle: #e9e9ee;

        background-color: #ffffff;
        overflow-x: clip;
    }

    :global(html) {
        --top-bar-height: 80px;
    }
</style>
