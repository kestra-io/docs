---
import Layout from "~/components/layout.astro"
import TopologyMock from "~/components/home/TopologyMock.astro"
import pixelCluster from "~/components/about/assets/patterns/cluster.svg?url"

import LpHeader from "~/components/lp/workflow-orchestration/LpHeader.astro"
import LpFooter from "~/components/lp/workflow-orchestration/LpFooter.astro"
import Hero from "~/components/lp/workflow-orchestration/Hero.astro"
import Platform from "~/components/lp/workflow-orchestration/Platform.astro"
import UseCases from "~/components/lp/workflow-orchestration/UseCases.astro"
import Faq from "~/components/lp/workflow-orchestration/Faq.astro"
import ClosingBanner from "~/components/lp/workflow-orchestration/ClosingBanner.astro"
import Translation from "~/components/lp/vra-migration/Translation.astro"

import { Icon } from "astro-icon/components"
import { fetchTotalPluginsCount } from "~/utils/plugins/pluginCount"

const title = "Infrastructure automation, as code | Kestra"
const description =
    "Kestra is an open-source orchestrator for Terraform, Ansible, OpenTofu and scripts: one YAML file per workflow, versioned in Git, with triggers, approvals, retries and logs. Self-host it with one command."

const routePath = "/lp/automate-infra"

const formProps = { submitLabel: "Book a 30-minute call" }

const totalPlugins = await fetchTotalPluginsCount()

const topology = {
    label: "Kestra topology of the provision_vm flow running: request form, owner approval, Terraform apply, Ansible config and CMDB update run one after the other",
    nodes: [
        {
            id: "request_form",
            type: "core.trigger.Webhook",
            plugin: "core.trigger.Webhook",
            fallback: "mdi:webhook",
            x: 0,
            y: 0,
            status: "success" as const,
            duration: "0.4s",
            seconds: 0.4,
        },
        {
            id: "owner_approval",
            type: "core.flow.Pause",
            plugin: "core.flow.Pause",
            fallback: "mdi:pause-circle-outline",
            x: 0,
            y: 140,
            status: "success" as const,
            duration: "2m 31s",
            seconds: 151,
        },
        {
            id: "terraform_apply",
            type: "terraform.cli.TerraformCLI",
            plugin: "terraform.cli.TerraformCLI",
            fallback: "mdi:terraform",
            runner: "kubernetes",
            x: 310,
            y: 0,
            status: "success" as const,
            duration: "3m 05s",
            seconds: 185,
            artifacts: 1,
        },
        {
            id: "ansible_config",
            type: "ansible.cli.AnsibleCLI",
            plugin: "ansible.cli.AnsibleCLI",
            fallback: "mdi:ansible",
            x: 310,
            y: 140,
            status: "running" as const,
            duration: "1m 12s",
            seconds: 72,
        },
        {
            id: "update_cmdb",
            type: "servicenow.Post",
            plugin: "servicenow.Post",
            fallback: "mdi:database-sync-outline",
            x: 620,
            y: 0,
            status: "created" as const,
            duration: "0.8s",
            seconds: 0.8,
        },
    ],
}

const reasons = [
    {
        kicker: "In Git",
        title: "One YAML file per workflow.",
        body: "Review a change in a pull request and roll it back like any other code. The editor in the UI writes the same YAML.",
        icon: "mdi:file-code-outline",
    },
    {
        kicker: "No rewrite",
        title: "Every tool keeps its job.",
        body: "Your playbooks, modules and scripts run as they are, each in its own container. Kestra runs the order between them.",
        icon: "mdi:console",
    },
    {
        kicker: "Around every step",
        title: "Triggers, approvals, retries and logs.",
        body: "A schedule, a webhook or a Git push starts a flow. A failed step retries, a pause waits for approval, and every run keeps its logs.",
        icon: "mdi:state-machine",
    },
]

const plugins = [
    { name: "Terraform", cls: "terraform", slug: "plugin-terraform" },
    { name: "OpenTofu", cls: "opentofu", slug: "plugin-opentofu" },
    { name: "Ansible", cls: "ansible", slug: "plugin-ansible" },
    { name: "Proxmox", cls: "proxmox", slug: "plugin-proxmox" },
    { name: "Kubernetes", cls: "kubernetes", slug: "plugin-kubernetes" },
    { name: "Helm", cls: "helm", slug: "plugin-helm" },
    { name: "Argo CD", cls: "argocd", slug: "plugin-argocd" },
    { name: "Docker", cls: "docker", slug: "plugin-docker" },
    { name: "AWS", cls: "aws", slug: "plugin-aws" },
    { name: "Azure", cls: "azure", slug: "plugin-azure" },
    { name: "Google Cloud", cls: "gcp", slug: "plugin-gcp" },
    { name: "ServiceNow", cls: "servicenow", slug: "plugin-servicenow" },
    { name: "Git", cls: "git", slug: "plugin-git" },
    {
        name: "Scripts",
        cls: "scripts.shell",
        slug: "plugin-scripts",
    },
    { name: "Slack", cls: "notifications.slack", slug: "plugin-notifications" },
]

const rows = [
    {
        from: "Cron jobs and systemd timers on scattered hosts",
        to: "Schedule triggers that run the same scripts, with logs and alerts in one place",
    },
    {
        from: "Ansible playbooks run from a laptop, Semaphore or AWX",
        to: "Ansible tasks with the same playbooks and inventories",
    },
    {
        from: "Terraform or OpenTofu applied from a laptop or a CI job",
        to: "Terraform and OpenTofu tasks on your existing modules and state backend",
    },
    {
        from: "Rundeck or Jenkins jobs stored in a database",
        to: "Flows stored as YAML files in Git",
    },
]

const editions: {
    feature: string
    oss: string | boolean
    ee: string | boolean
}[] = [
    { feature: "Engine, UI and API", oss: true, ee: true },
    { feature: "Every open-source plugin", oss: true, ee: true },
    { feature: "Schedules, webhooks and event triggers", oss: true, ee: true },
    {
        feature: "Retries, error handlers and approval pauses",
        oss: true,
        ee: true,
    },
    { feature: "Flows synced to and from Git", oss: true, ee: true },
    {
        feature: "Users",
        oss: "One shared login",
        ee: "SSO, SCIM and role-based access",
    },
    {
        feature: "Secrets",
        oss: "Environment variables",
        ee: "Vault, AWS, Azure, Google Cloud and more",
    },
    { feature: "Audit logs of every action", oss: false, ee: true },
    { feature: "Self-service forms (Apps)", oss: false, ee: true },
    { feature: "Worker groups in isolated networks", oss: false, ee: true },
    { feature: "Support", oss: "Community Slack", ee: "SLAs" },
]

const migrationSteps = [
    {
        title: "Read your vRO package",
        body: "The open-source Migration Assistant runs on your machine, sends nothing to Kestra, and lists what each workflow calls and which plugins cover it.",
    },
    {
        title: "Map each piece",
        body: "A catalog item becomes a flow with inputs, a vRO action a task or a script, an approval policy a pause, a day-2 action a triggered flow.",
    },
    {
        title: "Run both",
        body: "New requests go through Kestra while vRA drains. The same vSphere, the same scripts underneath.",
    },
    {
        title: "Switch off at renewal",
        body: "Once the last catalog item runs in Kestra, vRA is not renewed.",
    },
]

const ctaBullets = [
    {
        text: "We go through the requests and runbooks your team handles today.",
        strong: true,
    },
    {
        text: "See them run with individual logins, access per team, approvals and an audit trail.",
        strong: false,
    },
    {
        text: "Requests come in through forms, and the platform team approves them before anything runs.",
        strong: false,
    },
]

const faqItems = [
    {
        question: "Is Kestra really open source?",
        answer: "Yes. The engine, the UI and the open-source plugins are Apache 2.0 and on GitHub, and the open-source edition runs in production on its own. The Enterprise Edition adds what a shared, multi-team instance needs: individual logins, access control, secret managers and audit logs.",
    },
    {
        question: "How much memory does it need?",
        answer: "Kestra runs on the JVM and needs at least 2 vCPUs and 4 GiB of memory. A single standalone server with Postgres is enough for a homelab or a small team, and server roles split apart when you need to scale.",
    },
    {
        question: "Does it need root and the Docker socket?",
        answer: "Only for the quickstart. Script tasks run in containers by default, which is why the one-liner mounts the Docker socket and runs as root. You can run tasks as plain processes with the Process task runner instead, or deploy with rootless Podman.",
    },
    {
        question: "How does the open-source edition handle secrets?",
        answer: "As base64-encoded environment variables prefixed with SECRET_, read in flows with the secret() function, so values never sit in the YAML. Vault, AWS, Azure, Google Cloud and other secret managers connect in the Enterprise Edition.",
    },
    {
        question: "Kestra, Semaphore, AWX or Rundeck?",
        answer: "Semaphore and AWX put a UI on running playbooks, and Rundeck runs jobs and runbooks. Kestra chains the steps around them: take a Proxmox snapshot, run the playbook, call a webhook, post to Slack, all in one versioned YAML file. You can also call your existing jobs from a flow and move them across later.",
    },
    {
        question: "What does it cost?",
        answer: "The open-source edition is free. The Enterprise Edition is not priced per execution: the price depends on how broadly it is deployed and the support tier, and we walk through it on the call.",
    },
]
---

<Layout {title} {description} noindex bareChrome forceTheme="light">
    <div class="lp-workflow-orchestration">
        <LpHeader />
        <Hero {routePath} formTitle="Try it on your own infrastructure">
            <Fragment slot="title">
                Your <span class="grad grad-a">Terraform</span>, Ansible and
                scripts, in <span class="grad grad-b">one workflow</span>.
            </Fragment>
            <Fragment slot="lead">
                Each tool already automates its own step. Kestra runs the chain
                between them: one YAML file in Git, with triggers, approvals,
                retries and a log of every run.<br />
                <strong
                    >Open source, self-hosted, and your first flow runs in
                    minutes.</strong
                >
            </Fragment>
            <Fragment slot="form-sub">
                Free and open source. Runs on a laptop, a single VM or
                Kubernetes.
            </Fragment>
            <div slot="form" class="start">
                <a class="btn-start" href="/docs/quickstart">Get started free</a
                >
                <a class="btn-call" href="#contact-sales">
                    Bringing it to work? Book a call
                </a>
                <p class="proof">
                    <a href="https://github.com/kestra-io/kestra"
                        >30,000+ GitHub stars</a
                    > · Apache 2.0
                </p>
            </div>
        </Hero>
        <section class="example">
            <div class="inner">
                <div class="copy">
                    <h2>Request, approve, provision, configure</h2>
                    <p>
                        A request comes in with a hostname. The owner approves
                        it, Terraform creates the VM and your playbook
                        configures it. If a step fails, the run stops there with
                        its logs, and you restart it from that step.
                    </p>
                    <p class="note">
                        Each node is a task in one YAML file, versioned in Git.
                    </p>
                </div>
                <div class="visual" style={`--pixels: url("${pixelCluster}")`}>
                    <span class="pixels" aria-hidden="true"></span>
                    <TopologyMock {...topology} />
                </div>
            </div>
        </section>
        <Platform heading="How it fits your tools" cards={reasons} />
        <section class="plugins">
            <h2>Plugs into your stack</h2>
            <p class="sub">
                {totalPlugins}+ open-source plugins, installed the first time a
                flow uses them.
            </p>
            <ul>
                {
                    plugins.map((plugin) => (
                        <li>
                            <a href={`/plugins/${plugin.slug}`}>
                                <img
                                    src={`/icons/io.kestra.plugin.${plugin.cls}.svg`}
                                    alt=""
                                    width="36"
                                    height="36"
                                    loading="lazy"
                                />
                                <span>{plugin.name}</span>
                            </a>
                        </li>
                    ))
                }
                <li>
                    <a class="all" href="/plugins">
                        <span>All {totalPlugins}+ plugins</span>
                    </a>
                </li>
            </ul>
        </section>
        <Translation
            heading="What your current setup becomes"
            sub="Nothing is rewritten up front. Each piece moves when you are ready."
            fromLabel="Today"
            {rows}
        />
        <section class="vmware">
            <div class="inner">
                <div class="why">
                    <p class="eyebrow">Using VMware Cloud Foundation?</p>
                    <h2>
                        Move your vRA and vRO workflows out of the Broadcom
                        lock-in
                    </h2>
                    <p>
                        vRA and vRO are no longer sold on their own. They ship
                        inside VMware Cloud Foundation, licensed per core, so
                        the automation bill follows the size of the hypervisor
                        footprint, not how much you automate. The workflows
                        built on them do not move by themselves.
                    </p>
                </div>
                <div class="how">
                    <ol>
                        {
                            migrationSteps.map((step) => (
                                <li>
                                    <strong>{step.title}</strong>
                                    <span>{step.body}</span>
                                </li>
                            ))
                        }
                    </ol>
                    <div class="links">
                        <a class="btn-start" href="/resources/migration/vra"
                            >Read the vRA migration guide</a
                        >
                        <a
                            class="btn-ghost"
                            href="/resources/migration/vra/assistant"
                            >Get the Migration Assistant</a
                        >
                    </div>
                </div>
            </div>
            <a class="proof-card" href="/stories/fortune-500-company">
                <span class="figures">
                    <span><strong>−90%</strong> licensing cost</span>
                    <span><strong>30×</strong> faster delivery</span>
                </span>
                <span class="who"
                    >A Fortune 500 industrial manufacturer replaced Aria
                    Automation with Kestra.</span
                >
                <span class="more">Read the story →</span>
            </a>
        </section>
        <section class="editions">
            <h2>Start free. Add Enterprise when the team needs it.</h2>
            <p class="sub">
                The same flows run on both editions, so nothing is rewritten
                when you move.
            </p>
            <div class="table" role="table">
                <div class="row head" role="row">
                    <span role="columnheader"></span>
                    <span role="columnheader" class="col-oss"
                        >Open source<small>Free</small></span
                    >
                    <span role="columnheader"
                        >Enterprise<small>On a call</small></span
                    >
                </div>
                {
                    editions.map((row) => (
                        <div class="row" role="row">
                            <span role="rowheader">{row.feature}</span>
                            {[row.oss, row.ee].map((value, idx) => (
                                <span
                                    role="cell"
                                    class:list={[{ "col-oss": idx === 0 }]}
                                >
                                    {value === true ? (
                                        <Icon
                                            name="mdi:check"
                                            class="yes"
                                            aria-label="Included"
                                        />
                                    ) : value === false ? (
                                        <span
                                            class="no"
                                            aria-label="Not included"
                                        >
                                            –
                                        </span>
                                    ) : (
                                        value
                                    )}
                                </span>
                            ))}
                        </div>
                    ))
                }
            </div>
            <div class="editions-cta">
                <a class="btn-start" href="/docs/quickstart">Get started free</a
                >
                <a class="btn-call" href="#contact-sales"
                    >Talk to us about Enterprise</a
                >
            </div>
        </section>
        <UseCases
            {routePath}
            headingLines={["Bringing it", "to work?"]}
            bullets={ctaBullets}
            {formProps}
        />
        <Faq items={faqItems} />
        <ClosingBanner
            heading="Run your first infra flow"
            sub="Free, open source and self-hosted. One command, then your first flow."
            cta={{ text: "Read the quickstart", href: "/docs/quickstart" }}
            reassurance="Apache 2.0, self-hosted on your own machines."
        />
        <LpFooter />
    </div>
</Layout>

<style lang="scss">
    .lp-workflow-orchestration {
        --lp-purple: #631bff;
        --lp-purple-light: #f1efff;
        --lp-purple-rail: #cdc5ff;
        --lp-shadow-light: #3952f21a;
        --lp-bg-dark: #111115;
        --lp-purple-mid: #9869f7;
        --lp-content-on-card: #3b3a41;
        --lp-bg-base: #f7f7f8;
        --lp-content-primary: #08090a;
        --lp-content-secondary: #5f5f7c;
        --lp-content-muted: #7e7e9b;
        --lp-content-dark-secondary: #adadbf;
        --lp-border: #d0d0da;
        --lp-border-subtle: #e9e9ee;

        background-color: #ffffff;
        overflow-x: clip;
    }

    :global(html) {
        --top-bar-height: 80px;
    }

    .start {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding-top: 1.25rem;
    }

    .btn-start,
    .btn-call {
        display: block;
        min-height: 52px;
        padding: 0.875rem 1.75rem;
        border-radius: 8px;
        font-size: 1.125rem;
        font-weight: 700;
        line-height: 1.2;
        text-align: center;
        text-decoration: none;
    }

    .proof {
        margin: 0;
        padding-top: 0.25rem;
        color: var(--lp-content-secondary);
        font-size: $font-size-sm;
        font-weight: 600;
        text-align: center;
        a {
            color: inherit;
            text-decoration: none;
            &:hover {
                color: var(--lp-purple);
            }
        }
    }

    .btn-start {
        border: 1px solid var(--lp-purple);
        background-color: var(--lp-purple);
        color: #ffffff;
        &:hover {
            background-color: var(--lp-purple-mid);
            color: #ffffff;
        }
    }

    .btn-call {
        border: 1px solid var(--lp-purple);
        background-color: #ffffff;
        color: var(--lp-purple);
        &:hover {
            background-color: var(--lp-purple-light);
            color: var(--lp-purple);
        }
    }

    .example,
    .plugins,
    .editions {
        padding: 5rem 1rem;
    }

    .example {
        background-color: var(--lp-bg-base);

        .inner {
            display: grid;
            gap: 2.5rem;
            max-width: 1140px;
            margin-inline: auto;
            grid-template-columns: minmax(0, 1fr);

            .copy {
                max-width: 760px;
                margin-inline: auto;
                text-align: center;
            }
        }

        .visual {
            --tint: #e6c359;

            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
            height: 26rem;
            overflow: hidden;
            border: 1px solid var(--lp-border-subtle);
            border-radius: 12px;
            background:
                radial-gradient(
                    80% 90% at 100% 0%,
                    color-mix(in srgb, var(--tint) 20%, transparent),
                    transparent 70%
                ),
                color-mix(in srgb, var(--tint) 3%, #ffffff);
            @include media-breakpoint-down(md) {
                height: 18rem;
            }
        }

        .pixels {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            width: 96px;
            aspect-ratio: 194 / 168;
            background: var(--tint);
            mask: var(--pixels) no-repeat center / contain;
            opacity: 0.3;
            pointer-events: none;
        }

        .note {
            font-size: $font-size-base;
            color: var(--lp-content-muted);
        }

        p {
            color: var(--lp-content-secondary);
            font-size: 1.125rem;
            line-height: 1.5;
        }
    }

    .example h2,
    .plugins h2,
    .editions h2 {
        margin: 0 0 1.5rem;
        color: var(--lp-content-primary);
        font-size: 1.875rem;
        font-weight: 600;
        line-height: 1.0417;
        letter-spacing: -0.045rem;
        @include media-breakpoint-up(lg) {
            font-size: 3rem;
        }
    }

    .plugins,
    .editions {
        h2,
        .sub {
            max-width: 1140px;
            margin-inline: auto;
            text-align: center;
        }

        .sub {
            margin-bottom: 2.5rem;
            color: var(--lp-content-secondary);
            font-size: 1.125rem;
            line-height: 1.5;
        }
    }

    .plugins {
        background-color: #ffffff;

        ul {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            max-width: 1140px;
            margin: 0 auto;
            padding: 0;
            list-style: none;
            border-top: 1px solid var(--lp-border-subtle);
            border-left: 1px solid var(--lp-border-subtle);
            @include media-breakpoint-up(md) {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        li {
            border-right: 1px solid var(--lp-border-subtle);
            border-bottom: 1px solid var(--lp-border-subtle);
        }

        a {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            height: 100%;
            padding: 1.25rem 1.5rem;
            color: var(--lp-content-primary);
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s ease;
            &:hover {
                background-color: var(--lp-bg-base);
            }
        }

        img {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            object-fit: contain;
        }

        .all {
            color: var(--lp-purple);
        }
    }

    .vmware {
        padding: 5rem 1rem;
        background-color: var(--lp-bg-dark);
        color: #ffffff;

        .inner {
            display: grid;
            gap: 3rem;
            max-width: 1140px;
            margin-inline: auto;
            @include media-breakpoint-up(lg) {
                grid-template-columns: 1fr 1fr;
                gap: 4rem;
            }
        }

        .eyebrow {
            margin: 0 0 1rem;
            color: var(--lp-purple-mid);
            font-size: 1.125rem;
            font-weight: 600;
        }

        h2 {
            margin: 0 0 1.5rem;
            font-size: 1.875rem;
            font-weight: 600;
            line-height: 1.0417;
            letter-spacing: -0.045rem;
            @include media-breakpoint-up(lg) {
                font-size: 3rem;
            }
        }

        .why > p:not(.eyebrow) {
            color: var(--lp-content-dark-secondary);
            font-size: 1.125rem;
            line-height: 1.55;
        }

        /* Full width under both columns, so the pitch on the left keeps
         * its room and the proof closes the block. */
        .proof-card {
            display: flex;
            flex-direction: column;
            gap: 0.5rem 2rem;
            max-width: 1140px;
            margin: 3.5rem auto 0;
            padding: 1.5rem 1.75rem;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            color: var(--lp-content-dark-secondary);
            text-decoration: none;
            transition: border-color 0.2s ease;
            @include media-breakpoint-up(lg) {
                flex-direction: row;
                align-items: center;
            }
            &:hover {
                border-color: var(--lp-purple-mid);
            }
        }

        .figures {
            display: flex;
            flex-wrap: wrap;
            flex-shrink: 0;
            gap: 0.25rem 1.5rem;
            font-size: 1.5rem;
            color: #ffffff;

            strong {
                font-weight: 600;
            }
        }

        .who {
            flex: 1;
            font-size: $font-size-base;
            line-height: 1.5;
        }

        .more {
            flex-shrink: 0;
            color: #ffffff;
            font-weight: 600;
        }

        ol {
            margin: 0;
            padding: 0;
            list-style: none;
            counter-reset: step;
        }

        li {
            position: relative;
            padding: 0 0 1.75rem 3rem;
            counter-increment: step;

            &::before {
                content: counter(step);
                position: absolute;
                top: -0.125rem;
