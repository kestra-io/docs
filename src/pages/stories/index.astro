---
import { getCollection } from "astro:content"

import Layout from "~/components/layout.astro"
import SeeHow from "~/components/common/SeeHow.astro"
import StoriesList from "~/components/stories/StoriesList.vue"
import StoryGallery from "~/components/stories/StoryGallery.astro"
import {
    featuredEntries,
    HIGHLIGHTED_IDS,
    sortForGrid,
    toStoryCard,
} from "~/utils/stories"

const title = "Kestra Customer Stories"
const description =
    "See how engineering teams use Kestra to orchestrate everything — from real-time AI pipelines to enterprise-scale ERP integrations."

const allEntries = sortForGrid(await getCollection("customerStories"))

const stories = allEntries.map(toStoryCard)
const featuredStories = featuredEntries(allEntries).map(toStoryCard)
---

<Layout title={title} description={description} headerTheme="lightText">
    <StoryGallery featuredStories={featuredStories}>
        <StoriesList
            slot="stories"
            stories={stories}
            highlightedIds={HIGHLIGHTED_IDS}
            client:idle
        />
    </StoryGallery>
    <SeeHow cta={{ text: "Get Started", href: "/docs/quickstart" }}>
        <Fragment slot="title">Getting started with Kestra</Fragment>
        Start building with Kestra — Automate Everything Everywhere All at Once.
    </SeeHow>
</Layout>
