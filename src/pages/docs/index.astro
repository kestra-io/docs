---
import NavToc from "~/components/docs/NavToc.vue"
import LayoutDocs from "~/components/layouts/DocsLayout.astro"
import { buildDocsNavigation } from "~/utils/buildDocsNavigation"
import { getEntry, render } from "astro:content"
const doc = await getEntry("docs", "<index>")
if (!doc) {
    throw new Error("Index document not found")
}

const navigation = await buildDocsNavigation()

const { Content, headings } = await render(doc)

const editUrl = doc.filePath
    ? `https://github.com/kestra-io/docs/edit/main/${doc.filePath.replace(/.*\/content\//, "content/")}`
    : undefined
---

<LayoutDocs
    activeStem="/docs"
    isHomePage
    title={doc.data?.title}
    description={doc.data?.description}
    navigation={navigation}
>
    <h1 slot="title" class="py-0 title">{doc.data?.h1 ?? doc.data?.title}</h1>

    <Fragment slot="headings">
        <NavToc
            client:visible
            links={headings.map((heading) => ({
                id: heading.slug,
                text: heading.text,
                depth: heading.depth,
            }))}
            class="right-menu"
            {editUrl}
            markdownBody={doc.body}
            pagePath="/docs"
            pageTitle={doc.data?.title}
        />
    </Fragment>

    <div class="bd-content">
        <Content />
    </div>
</LayoutDocs>
