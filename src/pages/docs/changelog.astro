---
import Layout from "~/components/layout.astro"
import { fetchMajorReleases } from "~/utils/fetchChangelogVersions"
import { buildChangelogEntries } from "~/utils/changelog/parseRelease"
import ChangelogTimeline from "~/components/changelog/ChangelogTimeline.vue"

const title = "Release Notes"
const description = "Kestra Release Notes"

const releases = await fetchMajorReleases(150)
const entries = buildChangelogEntries(releases)
---

<Layout {title} {description} headerTheme="lightText">
    <ChangelogTimeline client:load {entries} />
</Layout>
