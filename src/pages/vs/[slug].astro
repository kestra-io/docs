---
import { getCollection, getEntry } from "astro:content"
import { entryCacheKey, layoutDigest } from "~/utils/incrementalCacheKey"
import VsLayout from "~/components/versus/VsLayout.astro"
import VsBody from "~/components/versus/VsBody.astro"
import Intro from "~/components/versus/Intro.astro"
import {
    fetchTotalPluginsCount,
    replaceTotalPluginsPlaceholder,
} from "~/utils/plugins/pluginCount"

const rawSvgModules = import.meta.glob<string>(
    "../../components/versus/assets/*.svg",
    { query: "?raw", import: "default", eager: true },
)

function getRawSvg(filename: string): string {
    const key = Object.keys(rawSvgModules).find((k) =>
        k.endsWith(`/${filename}.svg`),
    )
    return key ? rawSvgModules[key] : ""
}

export async function getStaticPaths() {
    const vsEntries = await getCollection("vs")
    // The page substitutes the live plugin count into the entry, so the count
    // is a build-time input of every cached page here.
    const scope = [await layoutDigest(), `p${await fetchTotalPluginsCount()}`]
    return vsEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
        cacheKey: entryCacheKey(entry, ...scope),
    }))
}

const { entry } = Astro.props
const totalPlugins = await fetchTotalPluginsCount()
const {
    title,
    description,
    competitorName,
    brandColor,
    shortDescription,
    intro,
    commonQuestions,
    secondaryCta,
    guideCta,
    proof,
    table,
    architecture,
    setup,
    pairs,
    compare,
    choose,
    faqTitle,
    logoFile,
    related,
} = replaceTotalPluginsPlaceholder(entry.data, totalPlugins)

const slug = entry.id
const competitorLogo = getRawSvg(logoFile ?? slug)
const competitorMonogram = getRawSvg(`${slug}-monograme`)

const vsEntries = await getCollection("vs")
const comparisons = (related?.comparisons ?? []).flatMap((id) => {
    const other = vsEntries.find((item) => item.id === id)
    return other
        ? [
              {
                  href: `/vs/${other.id}`,
                  name: other.data.competitorName,
                  monogram: getRawSvg(`${other.id}-monograme`),
              },
          ]
        : []
})
const alternativesEntry = related?.alternatives
    ? await getEntry("resources", related.alternatives)
    : undefined
const alternatives = alternativesEntry
    ? {
          href: `/resources/${alternativesEntry.data.tag}/${alternativesEntry.id}`,
          label: `See all ${competitorName} alternatives`,
      }
    : undefined
---

<VsLayout {title} {description} {commonQuestions}>
    <Intro
        {...intro}
        claim={shortDescription}
        competitor={{
            name: competitorName,
            color: brandColor.color,
            monogram: competitorMonogram,
        }}
        secondaryCta={secondaryCta}
    />
    <VsBody
        {competitorName}
        monogram={competitorMonogram}
        logo={competitorLogo}
        {proof}
        {table}
        {architecture}
        {setup}
        {pairs}
        {compare}
        {choose}
        guide={guideCta}
        {faqTitle}
        faq={commonQuestions}
        related={{ comparisons, alternatives }}
    />
</VsLayout>
