---
import type { ImageMetadata } from "astro"
import { getCollection } from "astro:content"
import { entryCacheKey, layoutDigest } from "~/utils/incrementalCacheKey"
import VsLayout from "~/components/versus/VsLayout.astro"
import VsBody from "~/components/versus/VsBody.astro"
import Intro from "~/components/versus/Intro.astro"
import Philosophy from "~/components/versus/Philosophy.astro"
import BusinessValue from "~/components/versus/BusinessValue.astro"
import SetupSpeed from "~/components/versus/SetupSpeed.astro"
import EaseOfUse from "~/components/versus/EaseOfUse.astro"
import VisualPreview from "~/components/versus/VisualPreview.astro"
import FeatureGrid from "~/components/versus/FeatureGrid.astro"
import VsTestimonial from "~/components/versus/VsTestimonial.astro"
import PlatformStrengths from "~/components/common/PlatformStrengths.astro"
import DecisionGuide from "~/components/versus/DecisionGuide.astro"
import SeeHow from "~/components/common/SeeHow.astro"
import CalloutCard from "~/components/common/CalloutCard.astro"
import Card from "~/components/common/CardPair.astro"
import MarkdownRenderer from "~/components/MarkdownRenderer.astro"
import Faq from "~/components/common/Faq.vue"
import data1 from "~/components/versus/assets/data-1.svg"
import data2 from "~/components/versus/assets/data-2.svg"
import data3 from "~/components/versus/assets/data-3.svg"
import kestraImg from "~/components/versus/assets/kestra-img.svg"
import {
    fetchTotalPluginsCount,
    replaceTotalPluginsPlaceholder,
} from "~/utils/plugins/pluginCount"

const rawSvgModules = import.meta.glob<string>(
    "../../components/versus/assets/*.svg",
    { query: "?raw", import: "default", eager: true },
)
const imgSvgModules = import.meta.glob<ImageMetadata>(
    "../../components/versus/assets/*-img.svg",
    { import: "default", eager: true },
)

function getRawSvg(filename: string): string {
    const key = Object.keys(rawSvgModules).find((k) =>
        k.endsWith(`/${filename}.svg`),
    )
    return key ? rawSvgModules[key] : ""
}

function getImgSvg(filename: string): ImageMetadata {
    const key = Object.keys(imgSvgModules).find((k) =>
        k.endsWith(`/${filename}-img.svg`),
    )
    return key ? imgSvgModules[key] : (kestraImg as ImageMetadata)
}

export async function getStaticPaths() {
    const vsEntries = await getCollection("vs")
    // The page substitutes the live plugin count into the entry, so the count
    // is a build-time input of every cached page here.
    const scope = [await layoutDigest(), `p${await fetchTotalPluginsCount()}`]
    return vsEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
        cacheKey: entryCacheKey(entry, ...scope),
    }))
}

const { entry } = Astro.props
const totalPlugins = await fetchTotalPluginsCount()

type VsData = typeof entry.data
type LegacyData = VsData &
    Required<
        Pick<
            VsData,
            | "philosophy"
            | "businessValue"
            | "setupSpeed"
            | "easeOfUse"
            | "visualPreview"
            | "featureGrid"
            | "testimonials"
            | "platformStrengths"
            | "decisionGuide"
        >
    >

const {
    title,
    shortDescription,
    competitorName,
    brandColor,
    intro,
    philosophy,
    businessValue,
    setupSpeed,
    easeOfUse,
    cardSection,
    visualPreview,
    featureGrid,
    testimonials,
    platformStrengths,
    decisionGuide,
    commonQuestions,
    seeHowTitle,
    seeHowBody,
    secondaryCta,
    guideCta,
    proof,
    table,
    architecture,
    setup,
    pairs,
    compare,
    choose,
    faqTitle,
    logoFile,
    imgFile,
} = replaceTotalPluginsPlaceholder(entry.data, totalPlugins) as LegacyData

const slug = entry.id
const logoFilename = logoFile ?? slug
const imgFilename = imgFile ?? slug

const competitorLogo = getRawSvg(logoFilename)
const competitorMonogram = getRawSvg(`${slug}-monograme`)
const competitorImg = getImgSvg(imgFilename)
---

<VsLayout {title} description={shortDescription} {commonQuestions}>
    <Intro
        {...intro}
        competitor={{
            name: competitorName,
            monogram: competitorMonogram,
        }}
        secondaryCta={secondaryCta}
    />
    {table && compare && choose ? (
        <VsBody
            {competitorName}
            monogram={competitorMonogram}
            logo={competitorLogo}
            {proof}
            {table}
            {architecture}
            {setup}
            {pairs}
            {compare}
            {choose}
            guide={guideCta}
            {faqTitle}
            faq={commonQuestions}
        />
    ) : (
        <Fragment>
        {guideCta && (
            <section class="vs-guide-cta">
                <div class="container">
                    <CalloutCard {...guideCta} />
                </div>
            </section>
        )}
        <Philosophy
            {...philosophy}
            competitor={{
                ...philosophy.competitor,
                logo: competitorLogo,
            }}
        />
        <BusinessValue
            {...businessValue}
            competitor={{
                ...businessValue.competitor,
                logo: competitorLogo,
            }}
        />
        <SetupSpeed
            {...setupSpeed}
            competitor={{
                ...setupSpeed.competitor,
                logo: competitorLogo,
            }}
        />
        <EaseOfUse
            {...easeOfUse}
            competitor={{
                ...easeOfUse.competitor,
                logo: competitorLogo,
            }}
        />
        {cardSection && (
            <section class="vs-card-section">
                <div class="container">
                    <h2 set:html={cardSection.title} />
                    <div class="comparison-box d-flex flex-column flex-lg-row">
                        {cardSection.cards.map((card) => (
                            <Card shadowColor={brandColor.color}>
                                <h5>{card.title}</h5>
                                <MarkdownRenderer
                                    class="vs-card-body"
                                    content={card.body}
                                />
                            </Card>
                        ))}
                    </div>
                </div>
            </section>
        )}
        <VisualPreview
            {...visualPreview}
            kestra={{
                ...visualPreview.kestra,
                linkImg: kestraImg,
            }}
            competitor={{
                ...visualPreview.competitor,
                logo: competitorLogo,
                linkImg: competitorImg,
            }}
        />
        <FeatureGrid
            featureGrid={{
                ...featureGrid,
                competitorLogo,
            }}
        />
        <VsTestimonial quotes={testimonials} />
        <PlatformStrengths
            {...platformStrengths}
            features={platformStrengths.features?.map((f: any, i: number) => ({
                ...f,
                image: { src: [data1, data2, data3][i] },
            }))}
        />
        <DecisionGuide
            {...decisionGuide}
            competitor={{
                ...decisionGuide.competitor,
                logo: competitorLogo,
            }}
        />
        <Faq items={commonQuestions} client:visible />
        <SeeHow>
            <Fragment slot="title">{seeHowTitle}</Fragment>
            {seeHowBody}
        </SeeHow>
        </Fragment>
    )}
</VsLayout>

<style lang="scss">
    .vs-guide-cta {
        padding: 2rem 0 0;
    }

    .vs-card-section {
        padding: $spacer * 4 0;
        background-color: var(--ks-background-body);

        @include media-breakpoint-down(lg) {
            padding: $spacer * 2 0.75rem;
        }

        .container {
            display: flex;
            flex-direction: column;
            gap: $rem-2;

            @include media-breakpoint-up(lg) {
                padding: 0;
            }
        }

        h2 {
            color: var(--ks-content-primary);
            @include media-breakpoint-up(lg) {
                font-size: $h2-font-size;
            }
        }

        h5 {
            color: var(--ks-content-primary);
        }

        .comparison-box {
            gap: $rem-2;
            width: 100%;
        }

        :global(.vs-card-body) {
            color: var(--ks-content-primary);
            font-size: $font-size-md;

            :global(p:last-child),
            :global(ul:last-child) {
                margin-bottom: 0;
            }
        }
    }
</style>
